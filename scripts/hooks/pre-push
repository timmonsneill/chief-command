#!/usr/bin/env sh
# pre-push — refuses to push commits the reviewers have not seen, and refuses to
# push a red test suite.
#
# scripts/mark-reviewed.sh writes HEAD into .git/.reviewers-ran-at-hash after the
# review pass. This hook allows a push only if every pushed commit IS the marked one
# or is an ancestor of it.
#
# Git hooks are advisory, not a security boundary: --no-verify walks past them. This
# is a tripwire for the failure mode that has actually happened here — an agent
# pushing before all reviewers reported (see docs/HANDOFF_2026-07-21.md). Real
# enforcement is GitHub branch protection, which is Neill's task.
set -e
ROOT=$(git rev-parse --show-toplevel)
MARKER="$(git rev-parse --git-common-dir)/.reviewers-ran-at-hash"

if [ "${SKIP_TESTS:-0}" != "1" ] && [ -x "$ROOT/.venv/bin/python" ]; then
  echo "→ pre-push: running the harness tests..."
  if ! (cd "$ROOT" && .venv/bin/python -m pytest harness/tests/ -q -p no:cacheprovider 2>&1 | tail -3); then
    echo "🛑 BLOCKED: tests failed. Fix them, then push."; exit 1
  fi
fi

[ -f "$MARKER" ] || { echo "🛑 BLOCKED: no reviewer marker. Run the reviewers, then ./scripts/mark-reviewed.sh"; exit 1; }
MARKED=$(cat "$MARKER")
ZERO=0000000000000000000000000000000000000000
saw=0
while read -r local_ref local_sha remote_ref remote_sha; do
  saw=1
  [ "$local_sha" = "$ZERO" ] && continue            # deleting a remote branch
  if [ "$local_sha" = "$MARKED" ] || git merge-base --is-ancestor "$local_sha" "$MARKED" 2>/dev/null; then
    continue
  fi
  echo "🛑 BLOCKED: $local_ref points at $local_sha but the reviewers last ran on $MARKED."
  echo "   Run the reviewers on this commit, then ./scripts/mark-reviewed.sh"
  exit 1
done
exit 0
