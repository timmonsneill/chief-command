*.db-shm
*.db-wal

# Live-DB backups taken before migrations — local state, same as the DB itself
harness/db/backups/

# Local tool state
.playwright-mcp/
openclaw-workspace-state.json

# OpenClaw agent workspace scaffolding (runtime state, dropped in repo root)
/SOUL.md
/IDENTITY.md
/USER.md
/HEARTBEAT.md
/TOOLS.md
