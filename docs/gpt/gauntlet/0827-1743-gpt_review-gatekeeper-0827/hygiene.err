    41	def _finished_job(c, *, families=("gpt", "grok"), seats_required=2, fams_required=2):
    42	    """A job that has genuinely been through the panel.
    43	
    44	    The builder is claude, so the default panel is gpt + grok: since migration 007 the
    45	    author's own family is allowed to review but does not count as a second opinion,
    46	    and a claude pass on a claude build would leave the floor of two unmet.
    47	    """
    48	    job = create_job(c, "the login form", builder_seat="reviewer")   # non-local builder
    49	    c.execute("UPDATE jobs SET required_reviews=?, required_review_families=? WHERE id=?",
    50	              (seats_required, fams_required, job))
    51	    set_status(c, job, "in_progress")
    52	    set_head_version(c, job, "v1")
    53	    set_status(c, job, "review")
    54	    by_family = {"claude": "reviewer", "gpt": "brain", "grok": "grok"}
    55	    for f in families:
    56	        record_verdict(c, job, by_family[f], verdict="pass", role="reviewer")
    57	    return job
    58	
