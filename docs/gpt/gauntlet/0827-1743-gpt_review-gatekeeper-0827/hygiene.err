   576	def token() -> str:
   577	    """The shared secret a caller must present. Created once, readable only by us.
   578	
   579	    Loopback is a NETWORK control, not an authorization one. Without a token, any local
   580	    process — and any web page the owner happens to open, since a POST with a plain
   581	    content type is a "simple request" that needs no browser preflight — could drive the
   582	    three most dangerous powers in the system by fetching 127.0.0.1. A page cannot read
   583	    this file, so it cannot present the token.
   584	    """
   585	    TOKEN_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   586	    if not TOKEN_PATH.exists() or not TOKEN_PATH.read_text().strip():
   587	        # O_EXCL + 0600 from the first byte — never a world-readable instant. An empty
   588	        # file counts as missing: `compare_digest("", "")` is True, so an empty token
   589	        # would have let a header-less request through. Fail closed, always.
   590	        fd = os.open(TOKEN_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
   591	        with os.fdopen(fd, "w") as f:
   592	            f.write(secrets.token_urlsafe(32))
   593	        os.chmod(TOKEN_PATH, 0o600)
   594	    value = TOKEN_PATH.read_text().strip()
   595	    if len(value) < 32:
   596	        raise RuntimeError("the gatekeeper token is missing or too short — refusing to serve")
   597	    return value
   598	
