   349	
   350	def _commit_holds_the_reviewed_work(commit: str, job_id: int, reviewed: str | None) -> bool:
   351	    """Is the text the panel reviewed present, unchanged, in this exact commit?"""
   352	    if reviewed is None:
   353	        return False
   354	    out = subprocess.run(["git", "show", f"{commit}:{REVIEWED_FILE.format(job_id=job_id)}"],
   355	                         cwd=REPO, capture_output=True, text=True)
   356	    return out.returncode == 0 and out.stdout == reviewed
