   319	
   320	def _plain(exc: Exception) -> str:
   321	    """A schema refusal, with the machine word taken off the front."""
   322	    return str(exc).replace("guard: ", "").strip() or "the record wouldn't accept it"
   323	
   324	
   325	def _branch_tip(branch: str) -> str | None:
   326	    """The commit a BRANCH points at — refs/heads/ so nothing else can be meant."""
   327	    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}"],
   328	                         cwd=REPO, capture_output=True, text=True)
   329	    return out.stdout.strip() or None if out.returncode == 0 else None
