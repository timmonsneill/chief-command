   392	def _abort_any_merge() -> None:
   393	    """Undo a half-finished merge — and ONLY a half-finished merge.
   394	
   395	    `git merge --abort` is `git reset --merge` underneath, which will discard the
   396	    owner's uncommitted work if no merge is actually in progress. Check first.
   397	    """
   398	    if (REPO / ".git" / "MERGE_HEAD").exists():
   399	        subprocess.run(["git", "merge", "--abort"], cwd=REPO, capture_output=True)
