   280	        # above and `git merge refs/heads/<branch>`, a builder could move the branch;
   281	        # merging by name would then merge whatever it points at now.
   282	        tip = _branch_tip(branch)
   283	        if tip is None or not _same_commit(tip, version):
   284	            raise _no("the code on that branch changed while the merge was being "
   285	                      "checked, so it needs checking again")
   286	        conn.execute("BEGIN IMMEDIATE")
   287	        try:
   288	            try:
   289	                set_status(conn, job_id, "shipped")
   290	            except (GuardViolation, sqlite3.IntegrityError) as exc:
   291	                conn.execute("ROLLBACK")
   292	                raise _no(_plain(exc)) from exc
   293	            commit = _git_merge(tip)
   294	            if commit is None:
   295	                conn.execute("ROLLBACK")          # the record never happened either
   296	                raise _no("the merge didn't go through cleanly — it needs a person")
   297	            conn.execute("COMMIT")
   298	        except BaseException:
   299	            # Never leave a transaction open on a connection somebody else will reuse.
   300	            if conn.in_transaction:
   301	                conn.execute("ROLLBACK")
   302	            raise
   303	
   304	    _note(conn, job_id,
   305	          f"Merged into the main line of code. Asked for by {_clean(asked_by)}.", kind="done")
   306	    _log(conn, "merge", f"job {job_id}", True,
   307	         f"{len(families)} model families signed off on {version}; merged {commit}",
   308	         asked_by, job_id)
   309	    return Receipt(verb="merge", subject=f"job {job_id}", reference=commit,
   310	                   detail=f"{len(families)} model families signed off on {version}")
   311	
   312	
   313	_MERGE_LOCK = threading.Lock()          # two merges racing share one git index
