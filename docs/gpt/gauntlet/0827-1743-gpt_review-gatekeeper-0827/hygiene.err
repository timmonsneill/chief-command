   135	# ---------------------------------------------------------------------------
   136	# The actual builders, one per provider. Add a provider = add a function.
   137	# ---------------------------------------------------------------------------
   138	def _ollama_build(seat_row, request: str, model: str) -> str:
   139	    """The free local coder actually writes the code."""
   140	    payload = json.dumps({"model": model, "prompt": request, "stream": False}).encode()
   141	    req = urllib.request.Request(
   142	        OLLAMA_URL, data=payload, headers={"Content-Type": "application/json"}
   143	    )
   144	    with urllib.request.urlopen(req, timeout=300) as r:
   145	        return json.loads(r.read())["response"].strip()
