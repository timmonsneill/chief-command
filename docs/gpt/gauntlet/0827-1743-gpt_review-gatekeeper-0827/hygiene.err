   408	def test_merge_refuses_when_the_branch_moved_after_review(conn, repo):
   409	    """Build v1, get it approved, push v2 to the same branch, ask to merge: v2 must NOT
   410	    go in. This is the check the verb exists for, and it had no test that reached it."""
   411	    job = create_job(conn, "the login form", builder_seat="reviewer")
   412	    conn.execute("UPDATE jobs SET required_reviews=2, required_review_families=2 WHERE id=?", (job,))
   413	    set_status(conn, job, "in_progress")
   414	    sha1 = _job_on_branch(conn, repo, job, "v1\n")
   415	    set_head_version(conn, job, sha1[:16])
   416	    set_status(conn, job, "review")
   417	    for s in ("brain", "grok"):
   418	        record_verdict(conn, job, s, verdict="pass", role="reviewer")
   419	    set_status(conn, job, "done")
   420	    # the builder pushes v2 to the same branch, record untouched
   421	    _git(repo, "checkout", "-q", f"job/{job}")
   422	    (repo / "work.txt").write_text("v2\n"); _git(repo, "add", "."); _git(repo, "commit", "-q", "-m", "v2")
   423	    _git(repo, "checkout", "-q", "main")
   424	
   425	    with pytest.raises(gatekeeper.Refused, match="isn't the code that was reviewed"):
   426	        gatekeeper.merge(conn, job)
   427	    assert not (repo / "work.txt").exists()
   428	    assert conn.execute("SELECT status FROM jobs WHERE id=?", (job,)).fetchone()["status"] == "done"
     1	"""The Grok reviewer runs over plain HTTP and never turns a broken call into a verdict.
     2	
     3	Grok came back onto the panel on 2026-08-27, the first third family with a working
     4	runner. Two things must stay true: a tool failure (no key, HTTP error, unreadable reply)
     5	is a SKIP, never a FAIL against the build — verdicts are permanent and bound to the
     6	version — and the runner only ever sends the bundle it was handed, nothing from disk.
     7	"""
     8	
     9	import io
    10	import json
    11	import sys
    12	import urllib.error
    13	from pathlib import Path
    14	
    15	import pytest
    16	
    17	sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    18	
    19	import gauntlet  # noqa: E402
    20	from dispatch import load_config  # noqa: E402
    21	
    22	
    23	class _Resp(io.BytesIO):
    24	    def __enter__(self): return self
    25	    def __exit__(self, *a): return False
    26	
    27	
    28	def _answering(text: str, seen: dict):
    29	    def fake(req, timeout):
    30	        seen["url"] = req.full_url
    31	        seen["headers"] = dict(req.header_items())
    32	        seen["body"] = json.loads(req.data.decode())
    33	        return _Resp(json.dumps(
    34	            {"choices": [{"message": {"content": text}}]}).encode())
    35	    return fake
    36	
    37	
    38	def test_a_pass_from_grok_is_read_as_a_pass(monkeypatch):
    39	    seen = {}
    40	    monkeypatch.setenv("XAI_API_KEY", "test-key")
    41	    monkeypatch.setattr(gauntlet.urllib.request, "urlopen", _answering("PASS looks right", seen))
    42	    verdict, why = gauntlet._xai_review("add two numbers", "def add(a,b): return a+b", "grok-4.5")
    43	    assert verdict == "pass"
    44	    assert seen["body"]["model"] == "grok-4.5"
    45	    assert seen["headers"]["Authorization"] == "Bearer test-key"
    46	    # The reviewer sees exactly the work it was handed — nothing from the checkout.
    47	    assert "def add(a,b)" in seen["body"]["messages"][0]["content"]
    48	
    49	
    50	def test_a_fail_from_grok_is_read_as_a_fail(monkeypatch):
    51	    monkeypatch.setenv("XAI_API_KEY", "test-key")
    52	    monkeypatch.setattr(gauntlet.urllib.request, "urlopen", _answering("FAIL it subtracts", {}))
    53	    assert gauntlet._xai_review("add", "def add(a,b): return a-b", "grok-4.5")[0] == "fail"
    54	
    55	
    56	def test_no_key_is_a_broken_tool_not_a_verdict(monkeypatch):
    57	    monkeypatch.delenv("XAI_API_KEY", raising=False)
    58	    with pytest.raises(gauntlet.ReviewerBroke):
    59	        gauntlet._xai_review("x", "y", "grok-4.5")
    60	
    61	
    62	def test_an_http_error_is_a_broken_tool_not_a_verdict(monkeypatch):
    63	    monkeypatch.setenv("XAI_API_KEY", "test-key")
    64	    def boom(req, timeout):
    65	        raise urllib.error.HTTPError(req.full_url, 429, "slow down", {}, io.BytesIO(b"rate limited"))
    66	    monkeypatch.setattr(gauntlet.urllib.request, "urlopen", boom)
    67	    with pytest.raises(gauntlet.ReviewerBroke):
    68	        gauntlet._xai_review("x", "y", "grok-4.5")
    69	
    70	
    71	def test_an_unreadable_reply_is_a_broken_tool_not_a_verdict(monkeypatch):
    72	    monkeypatch.setenv("XAI_API_KEY", "test-key")
    73	    monkeypatch.setattr(gauntlet.urllib.request, "urlopen",
    74	                        lambda req, timeout: _Resp(b'{"error": "nope"}'))
    75	    with pytest.raises(gauntlet.ReviewerBroke):
    76	        gauntlet._xai_review("x", "y", "grok-4.5")
    77	
