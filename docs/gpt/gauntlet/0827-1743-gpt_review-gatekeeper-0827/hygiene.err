   241	# ---------------------------------------------------------------------------
   242	# Fire-and-forget: start a worker in the background so the app stays responsive.
   243	# ---------------------------------------------------------------------------
   244	def start_in_background(job_id: int, *, cfg: dict[str, Any] | None = None) -> threading.Thread:
   245	    t = threading.Thread(
   246	        target=run_job, args=(job_id,), kwargs={"cfg": cfg},
   247	        name=f"job-{job_id}", daemon=True,
   248	    )
   249	    t.start()
   250	    return t
     1	"""The bridge: OpenClaw dispatches the work, the job store decides whether it may run.
     2	
     3	This is the piece that turns three separate things (a pinned OpenClaw, a job store,
     4	a seat config) into a system.
     5	
     6	Design decision worth stating, because it drives everything else:
     7	
     8	    THE JOB STORE IS THE SOURCE OF TRUTH, NOT A LISTENER.
     9	
    10	We record the job BEFORE we spawn it, and we refuse to spawn if the store says no
    11	(over budget, seat disabled). If we merely *observed* OpenClaw's events, work could
    12	run that was never recorded — and OpenClaw's subagent sessions auto-archive after
    13	~60 minutes and get soft-deleted, so anything we didn't write down is simply gone.
    14	Spec §7 wants "what did the overnight run do?" to be answerable. That only works if
    15	nothing can run without a row.
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	import json
    21	import subprocess
    22	import sys
    23	import tomllib
    24	from dataclasses import dataclass
    25	from pathlib import Path
    26	from typing import Any
    27	
    28	sys.path.insert(0, str(Path(__file__).resolve().parent))
    29	
    30	from db.jobs import (  # noqa: E402
    31	    Seat,
    32	    attach_run,
    33	    create_job,
    34	    over_budget,
    35	    seat,
    36	    set_status,
    37	    upsert_seat,
    38	)
    39	
    40	CONFIG = Path(__file__).resolve().parent / "config" / "seats.toml"
    41	
    42	
    43	class DispatchRefused(RuntimeError):
    44	    """The harness declined to dispatch. Budget, disabled seat, or a guard."""
    45	
    46	
    47	# ---------------------------------------------------------------------------
    48	# The REAL, in-process dispatch path (task #9).
    49	#
    50	# dispatch()/_spawn() below hand work to OpenClaw — the production path, for the
    51	# paid coding seats. This one runs the free LOCAL model directly, in a background
    52	# worker, so the whole spine can be exercised end-to-end today with no money and no
    53	# exposed keys. Same recording, same guards, same worktree isolation.
    54	# ---------------------------------------------------------------------------
    55	@dataclass
    56	class LocalDispatch:
    57	    job_id: int
    58	    seat_id: str
    59	    reused: bool          # True = a duplicate key matched an existing job
    60	    tier: str
    61	    tier_reason: str
    62	
    63	
    64	def dispatch_local(
    65	    conn,
    66	    request: str,
    67	    builder_seat: str,
    68	    *,
    69	    cfg: dict[str, Any] | None = None,
    70	    origin: str = "text",
    71	    dispatch_key: str | None = None,
    72	    start: bool = True,
    73	) -> LocalDispatch:
    74	    """Record a job and start a real local worker on it. Non-blocking.
    75	
    76	    Order is load-bearing: we check the seat and the budget, dedupe, THEN write the
    77	    row, THEN start the worker — the store is the source of truth, nothing runs
    78	    without a row. Duplicate protection: a repeated dispatch_key returns the job that
    79	    already exists instead of starting the work twice.
    80	
    81	    The review requirements come from the GAUNTLET CONFIG, never from the caller
    82	    (task #10). A caller that could say "one reviewer is enough" is the single-reviewer
    83	    door this task exists to close.
    84	    """
    85	    # create_job / over_budget / seat are already imported at module level — re-importing
    86	    # them here rebound them as LOCALS, which silently shadowed the module's own names.
    87	    # Anything that swapped them (a test, a future wrapper) was ignored inside this
    88	    # function while appearing to work everywhere else.
    89	    from tiering import tier_for_build
    90	    import executor
    91	
    92	    cfg = load_config() if cfg is None else cfg
    93	    roster, excluded = panel_roster(conn, cfg)
    94	    families = int(cfg.get("gauntlet", {}).get("min_model_families", 0))
    95	    builder_row = seat(conn, builder_seat)
    96	    _refuse_a_panel_that_cannot_hold(conn, roster, families,
    97	                                     builder_row["family"] if builder_row else None)
    98	
    99	    # Duplicate protection — a retry must not start the same work twice.
   100	    if dispatch_key:
   101	        existing = conn.execute(
   102	            "SELECT id, builder_seat, tier, tier_reason FROM jobs WHERE dispatch_key = ?",
   103	            (dispatch_key,),
   104	        ).fetchone()
   105	        if existing is not None:
   106	            return LocalDispatch(
   107	                job_id=existing["id"], seat_id=existing["builder_seat"],
   108	                reused=True, tier=existing["tier"] or "standard",
   109	                tier_reason=existing["tier_reason"] or "",
   110	            )
   111	
   112	    row = seat(conn, builder_seat)
   113	    if row is None:
   114	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   115	    if not row["enabled"]:
   116	        raise DispatchRefused(f"seat '{builder_seat}' is turned off")
   117	    if over_budget(conn, builder_seat):
   118	        raise DispatchRefused(f"seat '{builder_seat}' is over its budget for today")
   119	
   120	    call = tier_for_build(request)
   121	
   122	    # ONE transaction for the whole record of this dispatch. A job must never exist,
   123	    # even for an instant, without its review requirements stamped on — in autocommit
   124	    # that gap is a real row with a zero floor. The excluded-reviewer notes go in here
   125	    # too: if writing them fails, the right outcome is no job at all, not a committed
   126	    # job whose panel quietly shrank without saying so.
   127	    #
   128	    # BEGIN IMMEDIATE, not BEGIN: this reads before it writes, and a deferred
   129	    # transaction that upgrades to a write after another connection has committed fails
   130	    # instantly with a snapshot error that the busy-timeout does NOT retry.
   131	    conn.execute("BEGIN IMMEDIATE")
   132	    try:
   133	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   134	        conn.execute(
   135	            "UPDATE jobs SET required_reviews = ?, required_review_families = ?, "
   136	            "tier = ?, tier_reason = ?, dispatch_key = ?, branch = ? WHERE id = ?",
   137	            (len(roster), families, call.tier, call.reason, dispatch_key,
   138	             f"job/{job_id}", job_id),
   139	        )
   140	        # No silent caps: a reviewer left out of the panel is written down on the job.
   141	        # (A roster name that isn't a seat at all has no row to hang an event on —
   142	        # sync_seats refuses that config outright, the earlier and louder place.)
   143	        for seat_id, why in excluded.items():
   144	            row = seat(conn, seat_id)
   145	            if row is None:
   146	                continue
   147	            conn.execute(
   148	                "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   149	                "VALUES (?,?,?,?,?,?,?)",
   150	                (job_id, seat_id, seat_id, row["model"], row["family"], "skipped",
   151	                 f"not on the panel: {why}"),
   152	            )
   153	        conn.execute("COMMIT")
   154	    except Exception as exc:
   155	        conn.execute("ROLLBACK")
   156	        # Anything that goes wrong here is a refusal to dispatch, not a mystery 500 —
   157	        # and above all not a committed job with no worker coming for it.
   158	        raise DispatchRefused(f"could not record the job: {exc}") from exc
   159	    set_status(conn, job_id, "in_progress")
   160	
   161	    if start:
   162	        executor.start_in_background(job_id, cfg=cfg)
   163	
   164	    return LocalDispatch(
   165	        job_id=job_id, seat_id=builder_seat, reused=False,
   166	        tier=call.tier, tier_reason=call.reason,
   167	    )
   168	
   169	
   170	# ---------------------------------------------------------------------------
   171	# Config
   172	# ---------------------------------------------------------------------------
   173	def load_config(path: Path = CONFIG) -> dict[str, Any]:
   174	    # seats.toml uses // comments for readability; TOML has no //, so strip them before
   175	    # parsing. Must be string-aware: value strings hold `https://…` and `base_url` lines
   176	    # end in `"…"  // note` — cutting at the first // blindly would eat the URL. So we
   177	    # only strip a // that sits OUTSIDE a quoted string.
   178	    raw = "\n".join(_strip_slash_comment(line) for line in path.read_text().splitlines())
   179	    return tomllib.loads(raw)
   180	
   181	
   182	def _strip_slash_comment(line: str) -> str:
   183	    """Drop an inline/full-line `//` comment, ignoring `//` inside quotes."""
   184	    quote = ""
   185	    for i in range(len(line) - 1):
   186	        ch = line[i]
   187	        if quote:
   188	            if ch == quote:
   189	                quote = ""
   190	        elif ch in "\"'":
   191	            quote = ch
   192	        elif ch == "/" and line[i + 1] == "/":
   193	            return line[:i].rstrip()
   194	    return line
   195	
   196	
   197	def unresolved_reviewers(cfg: dict[str, Any]) -> list[str]:
   198	    """Gauntlet reviewers that don't name a real seat. Empty == all resolve.
   199	
   200	    A roster entry pointing at a seat that doesn't exist (the old `grinder_paid`) is a
   201	    silent trap: `over_budget` treats the unknown seat as uncapped, the pre-check says
   202	    "fine," then the verdict write rejects it. Catch it at startup instead.
   203	    """
   204	    seats = cfg.get("seats", {})
   205	    return [r for r in cfg.get("gauntlet", {}).get("reviewers", []) if r not in seats]
   206	
   207	
   208	def panel_roster(conn, cfg: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
   209	    """Who can actually sit on the panel right now — and who can't, and why.
   210	
   211	    A roster entry is only real if the seat exists, is switched on, and we have a way to
   212	    RUN it on this machine. A seat whose provider has no runner, or whose key is absent, is excluded; the
   213	    codex seat needs its login. Counting those as panel members would produce a required
   214	    panel that can never report, which fails closed but useless — every job parked
   215	    forever. Counting them silently would be worse: a panel that shrank without saying
   216	    so reads exactly like a full one.
   217	
   218	    So: exclude them, name them, and let the FAMILY FLOOR (which cannot be lowered) be
   219	    the thing that decides whether what's left is enough.
   220	    """
   221	    import gauntlet
   222	
   223	    roster: list[str] = []
   224	    excluded: dict[str, str] = {}
   225	    for seat_id in cfg.get("gauntlet", {}).get("reviewers", []):
   226	        row = seat(conn, seat_id)
   227	        if row is None:
   228	            excluded[seat_id] = "that reviewer isn't set up on this machine"
   229	        elif not row["enabled"]:
   230	            excluded[seat_id] = "that reviewer is turned off"
   231	        elif not gauntlet.has_runner(row["provider"]):
   232	            excluded[seat_id] = "we have no way to run that reviewer yet"
   233	        else:
   234	            roster.append(seat_id)
   235	    return roster, excluded
   236	
   237	
   238	def _refuse_a_panel_that_cannot_hold(conn, roster: list[str], floor: int,
   239	                                     builder_family: str | None = None) -> None:
   240	    """Refuse to dispatch work the panel could never certify.
   241	
   242	    Fail CLOSED, but say so at DISPATCH — when it is one legible refusal — rather than
   243	    at review time, where it becomes a job that parks forever and looks like a bug.
   244	    """
   245	    if floor < 1:
   246	        raise DispatchRefused(
   247	            "the review panel isn't configured (it needs at least one model family) "
   248	            "— refusing to start work that nothing would check"
   249	        )
   250	    # Counted the way the database counts (migration 007): the author's own family is
   251	    # not a second opinion. Counting it here admitted jobs the record then parked.
   252	    families = {seat(conn, s)["family"] for s in roster} - {builder_family}
   253	    if len(families) < floor:
   254	        raise DispatchRefused(
   255	            f"only {len(families)} model family/families can review right now and "
   256	            f"{floor} are required — refusing to start work that could never be checked"
   257	        )
   258	
   259	
   260	def sync_seats(conn, cfg: dict[str, Any]) -> None:
   261	    """Push the config's seats into the store, so guards can reason about them.
   262	
   263	    Refuses a config whose gauntlet names a seat that doesn't exist, or a seat missing a
   264	    family — both would blow up later, mid-panel, where it's far harder to see.
   265	    """
   266	    missing = unresolved_reviewers(cfg)
   267	    if missing:
   268	        raise DispatchRefused(f"gauntlet names seats that don't exist: {missing}")
   269	    for seat_id, s in cfg.get("seats", {}).items():
   270	        if "family" not in s:
   271	            raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
   272	    for seat_id, s in cfg.get("seats", {}).items():
   273	        upsert_seat(conn, Seat(
   274	            id=seat_id,
   275	            provider=s["provider"],
   276	            model=s["model"],
   277	            family=s["family"],
   278	            tier=s["tier"],
   279	            daily_cap_cents=s.get("daily_cap_cents"),
   280	            build_cap_cents=s.get("build_cap_cents"),
   281	            review_cap_cents=s.get("review_cap_cents"),
   282	            enabled=not s.get("disabled", False),
   283	            notes=s.get("notes", ""),
   284	        ))
   285	
   286	
   287	# ---------------------------------------------------------------------------
   288	# Dispatch
   289	# ---------------------------------------------------------------------------
   290	@dataclass
   291	class Dispatch:
   292	    job_id: int
   293	    run_id: str | None
   294	    seat_id: str
   295	
   296	
   297	def dispatch(
   298	    conn,
   299	    request: str,
   300	    builder_seat: str,
   301	    cfg: dict[str, Any],
   302	    origin: str = "text",
   303	    blocking: bool = False,
   304	) -> Dispatch:
   305	    """Record the job, then spawn it on OpenClaw. In that order, always.
   306	
   307	    Non-blocking by default — this is what lets the mouth stay responsive. OpenClaw's
   308	    sessions_spawn returns a run id immediately, so the voice head can say "on it" and
   309	    keep talking while the work grinds. A blocking dispatch here would reintroduce
   310	    exactly the latency wound that killed v1.
   311	    """
   312	    row = seat(conn, builder_seat)
   313	    if row is None:
   314	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   315	    if not row["enabled"]:
   316	        raise DispatchRefused(f"seat '{builder_seat}' is disabled")
   317	
   318	    # OpenClaw core has NO per-agent budget of any kind. If we don't check here,
   319	    # nothing does.
   320	    if over_budget(conn, builder_seat):
   321	        raise DispatchRefused(
   322	            f"seat '{builder_seat}' is over its daily cap — refusing to dispatch"
   323	        )
   324	
   325	    # SAME roster question dispatch_local asks. This path used to count the raw config
   326	    # list, so a job here was stamped as needing 3 reviewers when only 2 could ever run —
   327	    # and then parked forever with nothing to explain it, instead of one legible refusal
   328	    # at the door. Both entrances, one rule.
   329	    gauntlet = cfg.get("gauntlet", {})
   330	    roster, excluded = panel_roster(conn, cfg)
   331	    required = len(roster)
   332	    families = int(gauntlet.get("min_model_families", 0))
   333	    _refuse_a_panel_that_cannot_hold(conn, roster, families, row["family"])
   334	
   335	    # One transaction: the job must never exist for even a moment without its review
   336	    # requirements stamped on (autocommit would otherwise leave a floor-0 gap).
   337	    # IMMEDIATE because this reads before it writes — see dispatch_local.
   338	    conn.execute("BEGIN IMMEDIATE")
   339	    try:
   340	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   341	        conn.execute(
   342	            "UPDATE jobs SET required_reviews = ?, required_review_families = ? WHERE id = ?",
   343	            (required, families, job_id),
   344	        )
   345	        conn.execute("COMMIT")
   346	    except Exception:
   347	        conn.execute("ROLLBACK")
   348	        raise
   349	
   350	    run_id = _spawn(row, request, blocking=blocking)
   351	    attach_run(conn, job_id, run_id=run_id or "", branch=f"job/{job_id}")
   352	    set_status(conn, job_id, "in_progress")
   353	
   354	    return Dispatch(job_id=job_id, run_id=run_id, seat_id=builder_seat)
   355	
   356	
   357	def _spawn(seat_row, request: str, blocking: bool) -> str | None:
   358	    """Hand the work to OpenClaw.
   359	
   360	    `openclaw agent` runs one turn via the Gateway. The model is chosen per-spawn,
   361	    which is what lets a single orchestrator turn fan out across several families.
   362	    """
   363	    cmd = [
   364	        "openclaw", "agent",
   365	        "--model", f"{seat_row['provider']}/{seat_row['model']}",
   366	        "--message", request,
   367	    ]
   368	    if not blocking:
   369	        cmd.append("--detach")
   370	
   371	    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
   372	    if proc.returncode != 0:
   373	        raise DispatchRefused(f"openclaw refused the spawn: {proc.stderr.strip()[:300]}")
   374	
   375	    # The gateway echoes a run id; fall back to the raw stdout if the shape changes.
   376	    try:
   377	        return json.loads(proc.stdout).get("runId")
   378	    except (json.JSONDecodeError, AttributeError):
   379	        return proc.stdout.strip()[:80] or None
   380	
   381	
   382	# ---------------------------------------------------------------------------
   383	# The gauntlet (spec §6)
   384	# ---------------------------------------------------------------------------
   385	def run_gauntlet(conn, job_id: int, cfg: dict[str, Any]) -> dict[str, Any]:
   386	    """Fan the finished work out to the reviewer panel, in parallel, same bundle.
   387	
   388	    This used to return a list of reviewer NAMES and launch nobody — the gauntlet was a
   389	    plan, not a thing that ran (task #10). It now runs the panel and returns what
   390	    actually happened: who reviewed, which families, what they said, and — if the job
   391	    stayed parked — why, in plain words.
   392	
   393	    The model-diversity rule (§6) still isn't asserted here; it's RECORDED. Every
   394	    verdict snapshots the reviewing seat's family, and the schema refuses to complete a
   395	    job without enough distinct families passing THIS version. So "two different minds
   396	    looked at this" is a fact you can query, not a promise this function made.
   397	    """
   398	    import gauntlet as gauntlet_mod
   399	
   400	    return gauntlet_mod.run_gauntlet_for_job(conn, job_id, cfg).as_dict()
   401	
   402	
   403	def ship(conn, job_id: int, owner_confirmed: bool = False) -> None:
   404	    """DO NOT CALL. Shipping belongs to the gatekeeper now (task #11).
   405	
   406	    This function is the reason #11 exists: it was one import away from any agent, and
   407	    it did the thing because it was called. `gatekeeper.merge()` does the same job and
   408	    re-reads the record instead of trusting the caller.
   409	
   410	    Kept as a refusal rather than deleted, so that anything still reaching for the old
   411	    power gets a legible answer instead of an ImportError somebody "fixes" by
   412	    reimplementing it locally.
   413	    """
   414	    raise DispatchRefused(
   415	        "shipping is the gatekeeper's job now — ask it to merge (gatekeeper.merge), "
   416	        "which checks the panel, the version and the families itself"
   417	    )
   418	
   419	
   420	# The original ship() implementation used to sit here, renamed. That was the mistake the
     1	"""The review panel (spec §6, task #10) — several different minds check the same work,
     2	at the same time, against one frozen version.
     3	
     4	Before this file, dispatch ran ONE reviewer. That is enough to close the loop and it is
     5	not the design: the property this project exists to guarantee is that *a different mind*
     6	looked, because different model families miss different bugs. One reviewer cannot
     7	provide it, and a panel of three seats that all run on the same model provides it no
     8	better — which is why the floor counts FAMILIES, not seats.
     9	
    10	Four things are load-bearing here:
    11	
    12	  1. ONE FROZEN BUNDLE. Every reviewer is handed the identical version string and the
    13	     identical code. Nothing re-reads the job row mid-panel. Two verdicts must never
    14	     bind to two different versions of "the same" work.
    15	
    16	  2. NOTHING IS ASSUMED — only recorded. A family counts when a verdict from that
    17	     family is on the record for THIS version. A reviewer that was skipped, capped out,
    18	     or crashed contributes nothing, and the panel says so out loud (see `runs`).
    19	
    20	  3. FAIL CLOSED. Too few families, any failure, any unanswered escalation → the job
    21	     stays parked. The panel never lowers the bar to reach a conclusion, and it never
    22	     forces a status past the database guards. It feeds them.
    23	
    24	  4. THE DATABASE IS THE BOUNDARY, NOT THIS FILE. Everything below is also enforced in
    25	     schema.sql as triggers. If this module were wrong, or replaced by something
    26	     careless, the guards would still refuse. That is deliberate: Python decides what to
    27	     TRY; the schema decides what is ALLOWED.
    28	
    29	Threads, not async: each reviewer is a subprocess call that blocks for tens of seconds,
    30	and each thread opens its OWN sqlite connection (connections are not shareable across
    31	threads).
    32	"""
    33	
    34	from __future__ import annotations
    35	
    36	import json
    37	import os
    38	import subprocess
    39	import threading
    40	import urllib.error
    41	import urllib.request
    42	from dataclasses import dataclass, field
    43	from pathlib import Path
    44	from typing import Any, Callable
    45	
    46	from db.jobs import (
    47	    GuardViolation,
    48	    connect,
    49	    over_budget,
    50	    record_verdict,
    51	    seat,
    52	    set_status,
    53	)
    54	
    55	DB_PATH = Path(__file__).resolve().parent / "db" / "chief.db"
    56	
    57	REVIEW_TIMEOUT_S = 300          # a reviewer that hasn't answered by now has hung
    58	JOIN_GRACE_S = 30               # how long past its own timeout we wait for a thread
    59	DEFAULT_ESTIMATE_CENTS = 5      # what we reserve for a metered review before calling
    60	
    61	
    62	# ---------------------------------------------------------------------------
    63	# The reviewers themselves. One function per provider — adding a family to the
    64	# panel is adding a function here and a seat in seats.toml. Nothing else.
    65	# ---------------------------------------------------------------------------
    66	REVIEW_PROMPT = (
    67	    "You are reviewing another model's work. Judge it on whether it actually does what "
    68	    "was asked, and whether it is correct.\n"
    69	    "Reply with EXACTLY one line, nothing else:\n"
    70	    "  PASS <one-line reason>   — it is correct and does what was asked\n"
    71	    "  FAIL <one-line reason>   — it is wrong, incomplete, or unsafe\n\n"
    72	    "The task was: {request}\n\nThe work:\n{code}"
    73	)
    74	
    75	
    76	MAX_CODE_CHARS = 200_000        # past this the CLI's argument list won't hold it
    77	
    78	
    79	def _parse_verdict(out: str) -> tuple[str, str]:
    80	    """Pull the verdict line out of a CLI's output.
    81	
    82	    Read from the END. The prompt we send contains the literal words "PASS <one-line
    83	    reason>" and "FAIL <one-line reason>", and CLIs echo their input — codex puts that
    84	    echo on stderr today, but taking the FIRST match would turn any release that moves
    85	    it to stdout into an automatic pass on every review. Reading backwards makes the
    86	    model's actual answer, which comes last, the one that counts.
    87	
    88	    Deliberately biased toward FAIL: a reviewer whose answer we cannot read has not
    89	    passed anything. Silence is not approval.
    90	    """
    91	    for line in reversed(out.splitlines()):
    92	        stripped = line.strip()
    93	        if stripped.upper().startswith("PASS"):
    94	            return "pass", stripped[:280]
    95	        if stripped.upper().startswith("FAIL"):
    96	            return "fail", stripped[:280]
    97	    return "fail", ("the reviewer did not answer in the required form: "
    98	                    + out.strip()[:200]) if out.strip() else "the reviewer said nothing"
    99	
   100	
   101	class ReviewerBroke(RuntimeError):
   102	    """The reviewer never rendered a judgement — the TOOL failed, not the work.
   103	
   104	    This distinction is the whole reason the class exists. A CLI that exits non-zero
   105	    (expired login, rate limit, renamed model) still prints something to stdout, and
   106	    that something contains no verdict line — so treating output as an answer records a
   107	    FAIL against the build. Verdicts are permanent and bound to the version, so an
   108	    infrastructure hiccup would condemn good work forever, and tell Neill a reviewer
   109	    "found a problem" when nothing reviewed anything. A broken reviewer is a SKIP.
   110	    """
   111	
   112	
   113	def _run_cli(cmd: list[str]) -> tuple[str, str]:
   114	    proc = subprocess.run(
   115	        cmd, capture_output=True, text=True, timeout=REVIEW_TIMEOUT_S,
   116	        stdin=subprocess.DEVNULL,
   117	    )
   118	    if proc.returncode != 0:
   119	        raise ReviewerBroke(
   120	            f"{cmd[0]} exited {proc.returncode}: "
   121	            f"{(proc.stderr or proc.stdout).strip()[:200]}"
   122	        )
   123	    return _parse_verdict(proc.stdout)
   124	
   125	
   126	def _prompt(request: str, code: str) -> str:
   127	    if len(code) > MAX_CODE_CHARS:
   128	        # Say so in the prompt itself. A reviewer that silently judged 20% of the work
   129	        # would be worse than one that didn't run.
   130	        code = (code[:MAX_CODE_CHARS]
   131	                + f"\n\n[TRUNCATED — {len(code) - MAX_CODE_CHARS} more characters were "
   132	                  "not shown. If you cannot judge the whole thing, answer FAIL.]")
   133	    return REVIEW_PROMPT.format(request=request, code=code)
   134	
   135	
   136	def _claude_review(request: str, code: str, model: str) -> tuple[str, str]:
   137	    return _run_cli(["claude", "-p", "--model", model, _prompt(request, code)])
   138	
   139	
   140	def _codex_review(request: str, code: str, model: str) -> tuple[str, str]:
   141	    """The GPT-family reviewer, through the codex CLI.
   142	
   143	    `--skip-git-repo-check` because the reviewer reads the work it was handed; it is not
   144	    operating on a checkout, and requiring one would tie the panel to where it runs.
   145	    """
   146	    return _run_cli(["codex", "exec", "--skip-git-repo-check", "--model", model,
   147	                     _prompt(request, code)])
   148	
   149	
   150	XAI_CHAT_URL = "https://api.x.ai/v1/chat/completions"
   151	XAI_KEY_VAR = "XAI_API_KEY"
   152	MAX_REPLY_BYTES = 1_000_000     # a verdict is one line; anything bigger is not a reply
   153	
   154	
   155	def _xai_review(request: str, code: str, model: str) -> tuple[str, str]:
   156	    """The Grok-family reviewer, straight over HTTP.
   157	
   158	    No CLI here on purpose: Grok's CLI has been alleged to upload whole checkouts, and
   159	    the reviewer must only ever see the bundle it is handed. Plain urllib rather than an
   160	    SDK so the seat adds no dependency — the API is OpenAI-shaped and one POST is all a
   161	    review needs. The key comes from the environment the server loads (~/.chief/env),
   162	    never from the repo. A missing key is the TOOL failing, so it is a skip, never a
   163	    verdict — same rule as a CLI exiting non-zero.
   164	    """
   165	    key = os.environ.get(XAI_KEY_VAR, "").strip()
   166	    if not key:
   167	        raise ReviewerBroke(f"{XAI_KEY_VAR} is not set in this environment")
   168	    body = json.dumps({
   169	        "model": model,
   170	        "temperature": 0,
   171	        "messages": [{"role": "user", "content": _prompt(request, code)}],
   172	    }).encode()
   173	    req = urllib.request.Request(
   174	        XAI_CHAT_URL, data=body, method="POST",
   175	        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
   176	    )
   177	    try:
   178	        with urllib.request.urlopen(req, timeout=REVIEW_TIMEOUT_S) as resp:
   179	            payload = json.loads(resp.read(MAX_REPLY_BYTES).decode("utf-8", "replace"))
   180	    except urllib.error.HTTPError as exc:
   181	        raise ReviewerBroke(
   182	            f"xai answered {exc.code}: {exc.read().decode(errors='replace')[:200]}"
   183	        ) from exc
   184	    except (urllib.error.URLError, TimeoutError, OSError) as exc:
   185	        raise ReviewerBroke(f"xai unreachable: {str(exc)[:200]}") from exc
   186	    except ValueError as exc:                       # not JSON
   187	        raise ReviewerBroke(f"xai reply was not readable: {str(exc)[:200]}") from exc
   188	    try:
   189	        choice = payload["choices"][0]
   190	        text = choice["message"]["content"] or ""
   191	    except (KeyError, IndexError, TypeError) as exc:
   192	        raise ReviewerBroke(f"xai reply had no message: {str(payload)[:200]}") from exc
   193	    # An empty answer, or one cut off before the verdict line, is the TOOL failing.
   194	    # Left to _parse_verdict it would become a permanent FAIL against this version.
   195	    if not text.strip():
   196	        raise ReviewerBroke("xai answered with no text")
   197	    if choice.get("finish_reason") not in (None, "stop"):
   198	        raise ReviewerBroke(f"xai stopped early: {choice.get('finish_reason')}")
   199	    return _parse_verdict(text)
   200	
   201	
   202	REVIEWERS: dict[str, Callable[[str, str, str], tuple[str, str]]] = {
   203	    "claude-cli": _claude_review,
   204	    "codex": _codex_review,
   205	    "xai": _xai_review,
   206	}
   207	
   208	# Can the runner actually run HERE, now? A runner that exists but has no key would be
   209	# counted onto every new job's panel and then skip — parking the job forever with
   210	# "3 required, 2 reported". Better one legible exclusion at the door.
   211	_READY: dict[str, Callable[[], bool]] = {
   212	    "xai": lambda: bool(os.environ.get(XAI_KEY_VAR, "").strip()),
   213	}
   214	
   215	
   216	def has_runner(provider: str) -> bool:
   217	    return provider in REVIEWERS and _READY.get(provider, lambda: True)()
   218	
   219	
   220	# ---------------------------------------------------------------------------
   221	# What came back
   222	# ---------------------------------------------------------------------------
   223	@dataclass
   224	class ReviewerRun:
   225	    """One seat's participation — including the ones that did NOT participate.
   226	
   227	    A skipped reviewer is part of the result, never an omission. "No silent caps": a
   228	    panel that quietly shrank reads as a full panel to anyone looking at the verdicts.
   229	    """
   230	    seat_id: str
   231	    family: str = ""
   232	    verdict: str | None = None      # pass | fail | needs_human | None if it never ran
   233	    summary: str = ""
   234	    skipped: str = ""               # why it didn't run, in plain words
   235	
   236	    @property
   237	    def ran(self) -> bool:
   238	        return self.verdict is not None
   239	
   240	
   241	@dataclass
   242	class PanelResult:
   243	    job_id: int
   244	    version: str
   245	    required_families: int
   246	    runs: list[ReviewerRun] = field(default_factory=list)
   247	    certified: bool = False         # did the job actually reach 'done'
   248	    parked_reason: str = ""         # if not, why — in plain words
   249	
   250	    builder_family: str = ""        # the author is not a second opinion (migration 007)
   251	
   252	    @property
   253	    def families_passed(self) -> set[str]:
   254	        """Counted the way the database counts: minds OTHER than the author's."""
   255	        return {r.family for r in self.runs
   256	                if r.verdict == "pass" and r.family != self.builder_family}
   257	
   258	    @property
   259	    def failed(self) -> list[ReviewerRun]:
   260	        return [r for r in self.runs if r.verdict == "fail"]
   261	
   262	    def as_dict(self) -> dict[str, Any]:
   263	        return {
   264	            "job_id": self.job_id,
   265	            "version": self.version,
   266	            "required_families": self.required_families,
   267	            "families_passed": sorted(self.families_passed),
   268	            "certified": self.certified,
   269	            "parked_reason": self.parked_reason,
   270	            "runs": [
   271	                {"seat": r.seat_id, "family": r.family, "verdict": r.verdict,
   272	                 "summary": r.summary, "skipped": r.skipped}
   273	                for r in self.runs
   274	            ],
   275	        }
   276	
   277	    def spoken(self) -> str:
   278	        """One sentence for the voice. No seat names, no jargon."""
   279	        n = len([r for r in self.runs if r.ran])
   280	        minds = len(self.families_passed)
   281	        if self.certified:
   282	            return f"{n} different models checked it and it passed. Ready for you."
   283	        if self.failed:
   284	            return "It was checked and sent back — one of the reviewers found a problem."
   285	        return f"Only {minds} of the {self.required_families} required models could check it, so it's waiting."
   286	
   287	
   288	# ---------------------------------------------------------------------------
   289	# The panel
   290	# ---------------------------------------------------------------------------
   291	def _event(conn, job_id: int, seat_row, kind: str, detail: str) -> None:
   292	    conn.execute(
   293	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   294	        "VALUES (?, ?, ?, ?, ?, ?, ?)",
   295	        (job_id, seat_row["id"], seat_row["id"], seat_row["model"],
   296	         seat_row["family"], kind, detail),
   297	    )
   298	
   299	
   300	def _reserve_review_budget(conn, seat_id: str, job_id: int, cents: int) -> bool:
   301	    """Take the money BEFORE the call, not after.
   302	
   303	    Sol: "refusing to RECORD a charge doesn't unspend it." Two reviewers reserving at
   304	    once both hit the ledger, and the ledger's own cap trigger refuses the one that
   305	    would breach — so the race resolves in the database, not in a Python check that
   306	    both threads passed a moment earlier. Uncapped seats reserve nothing.
   307	    """
   308	    row = seat(conn, seat_id)
   309	    if row is None:
   310	        return True
   311	    # ALWAYS go through the ledger, even for a seat with no daily cap. Skipping the write
   312	    # when daily_cap_cents was NULL meant the MONTHLY budget and the per-role review
   313	    # ration never saw those calls at all — and today's two working reviewers are both
   314	    # uncapped, so that was every review in production. A flat-rate seat records 0 and
   315	    # still shows up in the account of what ran.
   316	    if row["tier"] != "metered":
   317	        cents = 0
   318	    # ASK, don't take. Spending is the gatekeeper's power (task #11) — the panel is a
   319	    # caller like any other, and gets no special path to the money because it happens
   320	    # to live in the same process.
   321	    import gatekeeper
   322	    try:
   323	        gatekeeper.spend(conn, seat_id, cents, job_id=job_id, role="review",
   324	                         asked_by="the review panel")
   325	        return True
   326	    except gatekeeper.Refused:
   327	        return False
   328	
   329	
   330	def _review_one(
   331	    job_id: int,
   332	    seat_id: str,
   333	    request: str,
   334	    code: str,
   335	    version: str,
   336	    cfg: dict[str, Any],
   337	    out: ReviewerRun,
   338	    db_path: Path,
   339	    decided: threading.Event,
   340	) -> None:
   341	    """One reviewer, in its own thread, on its own connection. Never raises.
   342	
   343	    The outer try/except is not belt-and-braces. ANY escape from this function kills the
   344	    thread with the run left blank — neither a verdict nor a stated reason — and a
   345	    reviewer that is neither counted nor excused is precisely the silent shrink this
   346	    panel exists to prevent. So every exit lands in `out`.
   347	    """
   348	    conn = None
   349	    try:
   350	        conn = connect(db_path)
   351	        row = seat(conn, seat_id)
   352	        if row is None:
   353	            out.skipped = "that reviewer isn't set up"
   354	            return
   355	        out.family = row["family"]
   356	        if not row["enabled"]:
   357	            out.skipped = "that reviewer is turned off"
   358	            _event(conn, job_id, row, "skipped", out.skipped)
   359	            return
   360	        runner = REVIEWERS.get(row["provider"])
   361	        if runner is None:
   362	            out.skipped = "we can't run that reviewer on this machine yet"
   363	            _event(conn, job_id, row, "skipped", out.skipped)
   364	            return
   365	        if over_budget(conn, seat_id):
   366	            out.skipped = "that reviewer is out of budget for today"
   367	            _event(conn, job_id, row, "skipped", out.skipped)
   368	            return
   369	
   370	        estimate = int(
   371	            cfg.get("seats", {}).get(seat_id, {}).get(
   372	                "review_estimate_cents", DEFAULT_ESTIMATE_CENTS)
   373	        )
   374	        # Already reviewed this exact version? Then this is a re-run, and repeating it
   375	        # would spend the money twice and stack duplicate verdicts on the record.
   376	        already = conn.execute(
   377	            "SELECT verdict, summary FROM verdicts WHERE job_id=? AND reviewer_seat=? "
   378	            "AND reviewed_version IS ? ORDER BY id DESC LIMIT 1",
   379	            (job_id, seat_id, version),
   380	        ).fetchone()
   381	        if already is not None:
   382	            out.verdict, out.summary = already["verdict"], already["summary"] or ""
   383	            return
   384	
   385	        if not _reserve_review_budget(conn, seat_id, job_id, estimate):
   386	            out.skipped = "that reviewer is out of budget for today"
   387	            _event(conn, job_id, row, "skipped", out.skipped)
   388	            return
   389	
   390	        _event(conn, job_id, row, "thinking", "Checking the work.")
   391	        try:
   392	            verdict, summary = runner(request, code, row["model"])
   393	        except subprocess.TimeoutExpired:
   394	            out.skipped = "that reviewer took too long and was stopped"
   395	            _event(conn, job_id, row, "error", out.skipped)
   396	            return
   397	        except ReviewerBroke as exc:
   398	            # The TOOL failed, not the work. Never a verdict — see ReviewerBroke.
   399	            out.skipped = "that reviewer couldn't run"
   400	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:160]}")
   401	            return
   402	        except Exception as exc:                      # noqa: BLE001 — a dead reviewer
   403	            out.skipped = "that reviewer couldn't finish"   # is a skip, never a pass
   404	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:120]}")
   405	            return
   406	
   407	        # The panel has already decided and moved on without us. Recording now would
   408	        # land a verdict on a job that was called finished a moment ago — and if it were
   409	        # a FAIL, the completion guards could no longer act on it, because they only fire
   410	        # on the way INTO done. A late answer is a non-answer.
   411	        if decided.is_set():
   412	            out.skipped = "that reviewer answered after the panel had already decided"
   413	            _event(conn, job_id, row, "skipped", out.skipped)
   414	            return
   415	
   416	        # reviewed_version is passed EXPLICITLY, never defaulted. The default reads the
   417	        # job's current head — which is only correct if nothing moved, and the whole
   418	        # point of the frozen bundle is not to depend on that being true.
   419	        try:
   420	            record_verdict(conn, job_id, seat_id, verdict=verdict,
   421	                           summary=summary, role="reviewer", reviewed_version=version)
   422	        except GuardViolation as exc:
   423	            out.skipped = "the record refused that verdict"
   424	            _event(conn, job_id, row, "error", str(exc)[:160])
   425	            return
   426	
   427	        out.summary = summary
   428	        out.verdict = verdict          # set LAST: `verdict` is what marks the run as real
   429	        _event(conn, job_id, row, "verdict",
   430	               "Passed the check." if verdict == "pass" else "Sent it back with notes.")
   431	    except Exception as exc:                          # noqa: BLE001
   432	        out.skipped = out.skipped or f"that reviewer couldn't finish: {str(exc)[:120]}"
   433	    finally:
   434	        if conn is not None:
   435	            conn.close()
   436	
   437	
   438	def run_panel(
   439	    conn,
   440	    job_id: int,
   441	    request: str,
   442	    code: str,
   443	    version: str,
   444	    cfg: dict[str, Any],
   445	    *,
   446	    roster: list[str] | None = None,
   447	    db_path: Path | None = None,
   448	) -> PanelResult:
   449	    """Run the whole panel in parallel against one frozen bundle, then decide.
   450	
   451	    `conn` is the caller's connection, used only for the final decision. Each reviewer
   452	    gets its own. Returns what actually happened — including who didn't run and why.
   453	    """
   454	    import dispatch                      # local: dispatch imports this module
   455	
   456	    gauntlet = cfg.get("gauntlet", {})
   457	    # Ask the SAME question dispatch asked when it stamped the panel size on the job:
   458	    # who can actually sit? Falling back to the raw config list would put the panel and
   459	    # the job's own requirements at odds — the job needing 2 seats while the panel tried
   460	    # 3, one of which cannot run.
   461	    roster = roster if roster is not None else dispatch.panel_roster(conn, cfg)[0]
   462	    floor = int(gauntlet.get("min_model_families", 0))
   463	    db_path = db_path or DB_PATH
   464	
   465	    built_by = conn.execute("SELECT builder_family FROM jobs WHERE id = ?",
   466	                            (job_id,)).fetchone()
   467	    result = PanelResult(job_id=job_id, version=version, required_families=floor,
   468	                         builder_family=(built_by["builder_family"] if built_by else "") or "")
   469	
   470	    # A floor of zero is not "no requirement" — it is an UNCONFIGURED panel, and
   471	    # `0 < 0` is False, so every later check would wave it through and certify work
   472	    # nobody looked at. dispatch refuses this at the door; refuse it here too, because
   473	    # this function is reachable from anywhere and must not depend on its caller having
   474	    # been careful. Same for an empty roster: nobody to ask is not everybody agreeing.
   475	    if floor < 1 or not roster:
   476	        result.parked_reason = (
   477	            "no review panel is configured for this job — nothing would have checked it"
   478	        )
   479	        return result
   480	
   481	    result.runs = [ReviewerRun(seat_id=s) for s in roster]
   482	    decided = threading.Event()
   483	
   484	    threads = [
   485	        threading.Thread(
   486	            target=_review_one,
   487	            args=(job_id, run.seat_id, request, code, version, cfg, run, db_path,
   488	                  decided),
   489	            name=f"review-{job_id}-{run.seat_id}", daemon=True,
   490	        )
   491	        for run in result.runs
   492	    ]
   493	    for t in threads:
   494	        t.start()
   495	    for t in threads:
   496	        t.join(timeout=REVIEW_TIMEOUT_S + JOIN_GRACE_S)
   497	
   498	    # Close the door BEFORE reading any results. A reviewer still running has not
   499	    # answered, and must not be able to answer into a decision already made — the
   500	    # completion guards only fire on the way INTO done, so a late objection could never
   501	    # stop anything. It is recorded as not having participated, which is the truth.
   502	    decided.set()
   503	    for t, run in zip(threads, result.runs):
   504	        if t.is_alive() and not run.ran:
   505	            run.skipped = run.skipped or "that reviewer never answered"
   506	
   507	    # ── The decision. Every branch below ends in "leave it parked" except one. ──
   508	    if result.failed:
   509	        result.parked_reason = "a reviewer failed this version"
   510	        return result
   511	
   512	    families = result.families_passed
   513	    if len(families) < floor:
   514	        ran = len([r for r in result.runs if r.ran])
   515	        result.parked_reason = (
   516	            f"only {len(families)} model famil{'y' if len(families) == 1 else 'ies'} "
   517	            f"reviewed this ({ran} of {len(result.runs)} reviewers ran); "
   518	            f"{floor} are required"
   519	        )
   520	        return result
   521	
   522	    try:
   523	        set_status(conn, job_id, "done",
   524	                   spoken_summary=f"Checked by {len(families)} different models. Ready for you.")
   525	        result.certified = True
   526	    except GuardViolation as exc:
   527	        # Another gate still holds (panel size, an unanswered escalation, an old
   528	        # objection). Park honestly rather than argue with the boundary.
   529	        result.parked_reason = str(exc).replace("guard: ", "")
   530	
   531	    if result.certified:
   532	        _reconcile(conn, result)
   533	    if not result.certified:
   534	        # Say why it stopped, in the record, in plain words. A job parked with no stated
   535	        # reason is indistinguishable from a job nobody looked at.
   536	        conn.execute("UPDATE jobs SET spoken_summary = ? WHERE id = ?",
   537	                     (result.spoken(), job_id))
   538	    return result
   539	
   540	
   541	def _reconcile(conn, result: PanelResult) -> None:
   542	    """Last look: did an objection land while we were deciding?
   543	
   544	    The `decided` flag narrows that window; it cannot close it, because a straggler can
   545	    pass the check and be writing as the main thread commits. So after certifying we ask
   546	    the record — not our own bookkeeping — whether a failure exists against this version,
   547	    and un-certify if one does. Status can move back out of 'done'; the guards only
   548	    police the way in. A job wrongly parked costs a re-run. A job wrongly called finished
   549	    is the thing this project exists to prevent.
   550	    """
   551	    late = conn.execute(
   552	        "SELECT reviewer_seat FROM verdicts WHERE job_id=? AND verdict='fail' "
   553	        "AND reviewed_version IS ?", (result.job_id, result.version),
   554	    ).fetchone()
   555	    if late is None:
   556	        return
   557	    set_status(conn, result.job_id, "review",
   558	               spoken_summary="Sent back — a reviewer found a problem.")
   559	    result.certified = False
   560	    result.parked_reason = "a reviewer failed this version (it answered late)"
   561	
   562	
   563	def run_gauntlet_for_job(conn, job_id: int, cfg: dict[str, Any], *,
   564	                         db_path: Path | None = None) -> PanelResult:
   565	    """Run the panel for a job that is already parked at review.
   566	
   567	    Reads the frozen bundle off the job row ONCE — the request, the output that was put
   568	    forward, and the version it was recorded under — and hands that same snapshot to
   569	    everyone.
   570	    """
   571	    job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   572	    if job is None:
   573	        raise ValueError(f"no such job: {job_id}")
   574	    if not job["head_version"]:
   575	        # Nothing was put forward, so there is nothing to bind a verdict to. A verdict
   576	        # with no version condemns or approves we-don't-know-what.
   577	        return PanelResult(job_id=job_id, version="", required_families=0,
   578	                           parked_reason="no finished version to review")
   579	    return run_panel(conn, job_id, job["request"], job["result"] or "",
   580	                     job["head_version"], cfg, db_path=db_path)

