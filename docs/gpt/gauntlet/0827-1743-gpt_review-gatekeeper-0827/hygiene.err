 # ── #10 — the allow-list let command-shaped QUESTIONS through ────────────
  1038	-- ===========================================================================
  1039	-- GUARD 9 — spend caps are enforced by the DATABASE, not by good manners.
  1040	--
  1041	-- ⚠️ Sol #8: "Spend caps do not structurally prevent runaway cost." They were a
  1042	-- Python check before dispatch — a classic race (two dispatches both pass the check
  1043	-- before either records spend), and a direct write skipped them entirely. Now the
  1044	-- ledger itself refuses the entry that would breach the cap.
  1045	-- ===========================================================================
  1046	CREATE TRIGGER IF NOT EXISTS guard_no_negative_spend
  1047	BEFORE INSERT ON usage
  1048	WHEN NEW.cost_cents < 0
  1049	BEGIN
  1050	    SELECT RAISE(ABORT, 'guard: spend cannot be negative — no unwinding the meter');
  1051	END;
  1052	
  1053	CREATE TRIGGER IF NOT EXISTS guard_daily_cap_is_hard
  1054	BEFORE INSERT ON usage
  1055	BEGIN
  1056	    SELECT RAISE(ABORT, 'guard: this seat is over its daily cap')
  1057	    WHERE (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1058	      AND (
  1059	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1060	         WHERE seat_id = NEW.seat_id AND day = date('now')
  1061	      ) + NEW.cost_cents
  1062	      > (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id);
  1063	END;
  1064	
  1065	-- Ration the EXPENSIVE work separately. A seat can be generous on reviewing and
  1066	-- stingy on building — which is exactly how you want a metered seat to behave when
  1067	-- you already pay flat-rate for two better builders.
  1068	CREATE TRIGGER IF NOT EXISTS guard_build_cap_is_hard
  1069	BEFORE INSERT ON usage
  1070	WHEN NEW.role = 'build'
  1071	BEGIN
  1072	    SELECT RAISE(ABORT, 'guard: this seat has used up its building budget for today — it can still review')
  1073	    WHERE (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1074	      AND (
  1075	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1076	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role = 'build'
  1077	      ) + NEW.cost_cents
  1078	      > (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id);
  1079	END;
  1080	
  1081	CREATE TRIGGER IF NOT EXISTS guard_review_cap_is_hard
  1082	BEFORE INSERT ON usage
  1083	WHEN NEW.role IN ('review', 'test')
  1084	BEGIN
  1085	    SELECT RAISE(ABORT, 'guard: this seat is over its reviewing budget for today')
  1086	    WHERE (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1087	      AND (
  1088	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1089	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role IN ('review','test')
  1090	      ) + NEW.cost_cents
  1091	      > (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id);
  1092	END;
  1093	
  1094	-- Keep updated_at honest.
  1095	CREATE TRIGGER IF NOT EXISTS jobs_touch_updated_at
  1096	AFTER UPDATE ON jobs
  1097	FOR EACH ROW
  1098	BEGIN
  1099	    UPDATE jobs SET updated_at = datetime('now') WHERE id = NEW.id;
  1100	END;

