    96	
    97	def test_an_empty_or_cut_off_answer_is_a_broken_tool_not_a_verdict(monkeypatch):
    98	    """A 200 with no text (reasoning models sometimes answer in a field we don't read)
    99	    or one cut off by a length limit must NOT become a permanent FAIL on the version."""
   100	    monkeypatch.setenv("XAI_API_KEY", "test-key")
   101	    monkeypatch.setattr(gauntlet.urllib.request, "urlopen", lambda req, timeout: _Resp(
   102	        json.dumps({"choices": [{"message": {"content": ""}, "finish_reason": "stop"}]}).encode()))
   103	    with pytest.raises(gauntlet.ReviewerBroke):
   104	        gauntlet._xai_review("x", "y", "grok-4.5")
   105	    monkeypatch.setattr(gauntlet.urllib.request, "urlopen", lambda req, timeout: _Resp(
   106	        json.dumps({"choices": [{"message": {"content": "I think"}, "finish_reason": "length"}]}).encode()))
   107	    with pytest.raises(gauntlet.ReviewerBroke):
   108	        gauntlet._xai_review("x", "y", "grok-4.5")
   109	    monkeypatch.setattr(gauntlet.urllib.request, "urlopen", lambda req, timeout: _Resp(b"<html>"))
   110	    with pytest.raises(gauntlet.ReviewerBroke):
   111	        gauntlet._xai_review("x", "y", "grok-4.5")

