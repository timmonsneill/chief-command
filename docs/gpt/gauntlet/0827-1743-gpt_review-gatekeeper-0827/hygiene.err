     1	"""The review panel (spec §6, task #10) — several different minds check the same work,
     2	at the same time, against one frozen version.
     3	
     4	Before this file, dispatch ran ONE reviewer. That is enough to close the loop and it is
     5	not the design: the property this project exists to guarantee is that *a different mind*
     6	looked, because different model families miss different bugs. One reviewer cannot
     7	provide it, and a panel of three seats that all run on the same model provides it no
     8	better — which is why the floor counts FAMILIES, not seats.
     9	
    10	Four things are load-bearing here:
    11	
    12	  1. ONE FROZEN BUNDLE. Every reviewer is handed the identical version string and the
    13	     identical code. Nothing re-reads the job row mid-panel. Two verdicts must never
    14	     bind to two different versions of "the same" work.
    15	
    16	  2. NOTHING IS ASSUMED — only recorded. A family counts when a verdict from that
    17	     family is on the record for THIS version. A reviewer that was skipped, capped out,
    18	     or crashed contributes nothing, and the panel says so out loud (see `runs`).
    19	
    20	  3. FAIL CLOSED. Too few families, any failure, any unanswered escalation → the job
    21	     stays parked. The panel never lowers the bar to reach a conclusion, and it never
    22	     forces a status past the database guards. It feeds them.
    23	
    24	  4. THE DATABASE IS THE BOUNDARY, NOT THIS FILE. Everything below is also enforced in
    25	     schema.sql as triggers. If this module were wrong, or replaced by something
    26	     careless, the guards would still refuse. That is deliberate: Python decides what to
    27	     TRY; the schema decides what is ALLOWED.
    28	
    29	Threads, not async: each reviewer is a subprocess call that blocks for tens of seconds,
    30	and each thread opens its OWN sqlite connection (connections are not shareable across
    31	threads).
    32	"""
    33	
    34	from __future__ import annotations
    35	
    36	import subprocess
    37	import threading
    38	from dataclasses import dataclass, field
    39	from pathlib import Path
    40	from typing import Any, Callable
    41	
    42	from db.jobs import (
    43	    GuardViolation,
    44	    connect,
    45	    over_budget,
    46	    record_usage,
    47	    record_verdict,
    48	    seat,
    49	    set_status,
    50	)
    51	
    52	DB_PATH = Path(__file__).resolve().parent / "db" / "chief.db"
    53	
    54	REVIEW_TIMEOUT_S = 300          # a reviewer that hasn't answered by now has hung
    55	JOIN_GRACE_S = 30               # how long past its own timeout we wait for a thread
    56	DEFAULT_ESTIMATE_CENTS = 5      # what we reserve for a metered review before calling
    57	
    58	
    59	# ---------------------------------------------------------------------------
    60	# The reviewers themselves. One function per provider — adding a family to the
    61	# panel is adding a function here and a seat in seats.toml. Nothing else.
    62	# ---------------------------------------------------------------------------
    63	REVIEW_PROMPT = (
    64	    "You are reviewing another model's work. Judge it on whether it actually does what "
    65	    "was asked, and whether it is correct.\n"
    66	    "Reply with EXACTLY one line, nothing else:\n"
    67	    "  PASS <one-line reason>   — it is correct and does what was asked\n"
    68	    "  FAIL <one-line reason>   — it is wrong, incomplete, or unsafe\n\n"
    69	    "The task was: {request}\n\nThe work:\n{code}"
    70	)
    71	
    72	
    73	MAX_CODE_CHARS = 200_000        # past this the CLI's argument list won't hold it
    74	
    75	
    76	def _parse_verdict(out: str) -> tuple[str, str]:
    77	    """Pull the verdict line out of a CLI's output.
    78	
    79	    Read from the END. The prompt we send contains the literal words "PASS <one-line
    80	    reason>" and "FAIL <one-line reason>", and CLIs echo their input — codex puts that
    81	    echo on stderr today, but taking the FIRST match would turn any release that moves
    82	    it to stdout into an automatic pass on every review. Reading backwards makes the
    83	    model's actual answer, which comes last, the one that counts.
    84	
    85	    Deliberately biased toward FAIL: a reviewer whose answer we cannot read has not
    86	    passed anything. Silence is not approval.
    87	    """
    88	    for line in reversed(out.splitlines()):
    89	        stripped = line.strip()
    90	        if stripped.upper().startswith("PASS"):
    91	            return "pass", stripped[:280]
    92	        if stripped.upper().startswith("FAIL"):
    93	            return "fail", stripped[:280]
    94	    return "fail", ("the reviewer did not answer in the required form: "
    95	                    + out.strip()[:200]) if out.strip() else "the reviewer said nothing"
    96	
    97	
    98	class ReviewerBroke(RuntimeError):
    99	    """The reviewer never rendered a judgement — the TOOL failed, not the work.
   100	
   101	    This distinction is the whole reason the class exists. A CLI that exits non-zero
   102	    (expired login, rate limit, renamed model) still prints something to stdout, and
   103	    that something contains no verdict line — so treating output as an answer records a
   104	    FAIL against the build. Verdicts are permanent and bound to the version, so an
   105	    infrastructure hiccup would condemn good work forever, and tell Neill a reviewer
   106	    "found a problem" when nothing reviewed anything. A broken reviewer is a SKIP.
   107	    """
   108	
   109	
   110	def _run_cli(cmd: list[str]) -> tuple[str, str]:
   111	    proc = subprocess.run(
   112	        cmd, capture_output=True, text=True, timeout=REVIEW_TIMEOUT_S,
   113	        stdin=subprocess.DEVNULL,
   114	    )
   115	    if proc.returncode != 0:
   116	        raise ReviewerBroke(
   117	            f"{cmd[0]} exited {proc.returncode}: "
   118	            f"{(proc.stderr or proc.stdout).strip()[:200]}"
   119	        )
   120	    return _parse_verdict(proc.stdout)
   121	
   122	
   123	def _prompt(request: str, code: str) -> str:
   124	    if len(code) > MAX_CODE_CHARS:
   125	        # Say so in the prompt itself. A reviewer that silently judged 20% of the work
   126	        # would be worse than one that didn't run.
   127	        code = (code[:MAX_CODE_CHARS]
   128	                + f"\n\n[TRUNCATED — {len(code) - MAX_CODE_CHARS} more characters were "
   129	                  "not shown. If you cannot judge the whole thing, answer FAIL.]")
   130	    return REVIEW_PROMPT.format(request=request, code=code)
   131	
   132	
   133	def _claude_review(request: str, code: str, model: str) -> tuple[str, str]:
   134	    return _run_cli(["claude", "-p", "--model", model, _prompt(request, code)])
   135	
   136	
   137	def _codex_review(request: str, code: str, model: str) -> tuple[str, str]:
   138	    """The GPT-family reviewer, through the codex CLI.
   139	
   140	    `--skip-git-repo-check` because the reviewer reads the work it was handed; it is not
   141	    operating on a checkout, and requiring one would tie the panel to where it runs.
   142	    """
   143	    return _run_cli(["codex", "exec", "--skip-git-repo-check", "--model", model,
   144	                     _prompt(request, code)])
   145	
   146	
   147	REVIEWERS: dict[str, Callable[[str, str, str], tuple[str, str]]] = {
   148	    "claude-cli": _claude_review,
   149	    "codex": _codex_review,
   150	    # xai / xai-api land here once the key is rotated — see seats.toml.
   151	}
   152	
   153	
   154	def has_runner(provider: str) -> bool:
   155	    return provider in REVIEWERS
   156	
   157	
   158	# ---------------------------------------------------------------------------
   159	# What came back
   160	# ---------------------------------------------------------------------------
   161	@dataclass
   162	class ReviewerRun:
   163	    """One seat's participation — including the ones that did NOT participate.
   164	
   165	    A skipped reviewer is part of the result, never an omission. "No silent caps": a
   166	    panel that quietly shrank reads as a full panel to anyone looking at the verdicts.
   167	    """
   168	    seat_id: str
   169	    family: str = ""
   170	    verdict: str | None = None      # pass | fail | needs_human | None if it never ran
   171	    summary: str = ""
   172	    skipped: str = ""               # why it didn't run, in plain words
   173	
   174	    @property
   175	    def ran(self) -> bool:
   176	        return self.verdict is not None
   177	
   178	
   179	@dataclass
   180	class PanelResult:

