   152	
   153	# Reviewing lives in gauntlet.py (task #10). This module builds; that one judges.
   154	# It used to hold a single hard-wired Claude reviewer, which was enough to close the
   155	# loop and was never the design — one reviewer cannot show that a DIFFERENT MIND looked.
   156	
   157	
   158	# ---------------------------------------------------------------------------
   159	# The run loop — everything above, in order, for one job.
   160	# ---------------------------------------------------------------------------
   161	def run_job(job_id: int, *, cfg: dict[str, Any] | None = None) -> dict[str, Any]:
   162	    """Take one recorded job and actually do it. Safe to call in a thread.
   163	
   164	    Opens its own database connection (sqlite + threads). WAL mode lets this write
   165	    while the web server reads. Never raises to the caller — a worker that dies must
   166	    leave a legible 'failed' row, not a stack trace nobody sees.
   167	    """
   168	    conn = connect(DB_PATH)
   169	    try:
   170	        job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   171	        if job is None:
   172	            return {"job_id": job_id, "status": "missing"}
   173	        seat_row = seat(conn, job["builder_seat"])
   174	        if seat_row is None:
   175	            set_status(conn, job_id, "failed", error=f"unknown seat {job['builder_seat']}")
   176	            return {"job_id": job_id, "status": "failed"}
   177	
   178	        builder = _BUILDERS.get(seat_row["provider"])
   179	        if builder is None:
   180	            # A provider we don't have a local runner for (codex/xai/claude-cli builds
   181	            # go through OpenClaw, not this in-process worker). Say so plainly.
   182	            set_status(conn, job_id, "failed",
   183	                       error=f"no in-process builder for provider '{seat_row['provider']}' "
   184	                             "— this seat dispatches through OpenClaw")
   185	            _event(conn, job_id, seat_row, "error",
   186	                   "This worker only runs the local model directly.")
   187	            return {"job_id": job_id, "status": "failed"}
   188	
   189	        # 1. Isolate.
   190	        wt, wt_note = _make_worktree(job_id, job["branch"] or f"job/{job_id}")
   191	        conn.execute("UPDATE jobs SET worktree = ? WHERE id = ?", (str(wt), job_id))
   192	        _event(conn, job_id, seat_row, "dispatched", f"Working in its own copy ({wt_note}).")
   193	
   194	        # 2. Build.
   195	        model = job["tier"] and _model_for(seat_row, job["tier"]) or seat_row["model"]
   196	        _event(conn, job_id, seat_row, "thinking", "Working out how to do it.")
   197	        try:
   198	            result = builder(seat_row, job["request"], model)
   199	        except Exception as exc:  # network, model, timeout — all land here
   200	            set_status(conn, job_id, "failed", error=f"builder error: {exc}")
   201	            _event(conn, job_id, seat_row, "error", "The worker hit a problem.")
   202	            return {"job_id": job_id, "status": "failed"}
   203	
   204	        # 3. Land the output in the isolated copy, and version it.
   205	        out_dir = wt / OUTPUT_DIRNAME
   206	        out_dir.mkdir(parents=True, exist_ok=True)
   207	        (out_dir / f"job_{job_id}.txt").write_text(result)
   208	        branch = job["branch"] or f"job/{job_id}"
   209	        version = _commit_in_worktree(wt, job_id, branch, job["request"]) or _version_of(result)
   210	        set_head_version(conn, job_id, version)
   211	        _event(conn, job_id, seat_row, "write",
   212	               f"Wrote {len(result)} characters of work.", target=str(out_dir))
   213	
   214	        # 4. Park for review. The guards will hold it here until a real reviewer passes
   215	        #    THIS version — we never force it past them.
   216	        set_status(conn, job_id, "review", result=result)
   217	
   218	        # 5. Hand the frozen bundle to the review panel — several families at once,
   219	        #    all bound to THIS version. The panel decides nothing the database wouldn't;
   220	        #    it produces the verdicts the guards ask for. Without a config there is no
   221	        #    panel, and the job simply stays parked (the safe outcome, not a shortcut).
   222	        if cfg is not None:
   223	            import gauntlet
   224	            gauntlet.run_panel(conn, job_id, job["request"], result, version, cfg,
   225	                               db_path=DB_PATH)
   226	
   227	        final = conn.execute("SELECT status FROM jobs WHERE id = ?", (job_id,)).fetchone()["status"]
   228	        return {"job_id": job_id, "status": final, "version": version}
   229	    finally:
   230	        conn.close()
   231	
   232	
   233	def _model_for(seat_row, tier: str) -> str:
   234	    try:
   235	        from tiering import resolve_model
   236	        return resolve_model(seat_row, tier)[0]
   237	    except Exception:
   238	        return seat_row["model"]
