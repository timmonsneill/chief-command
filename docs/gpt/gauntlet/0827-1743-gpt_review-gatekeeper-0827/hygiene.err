   601	    """Run the gatekeeper as its own process.
   602	
   603	    LOOPBACK ONLY, and not a choice to revisit casually: the tailnet is other devices,
   604	    and the whole point of this process is that reaching it is harder than reaching the
   605	    agents, not easier. Standard library only — the thing holding the dangerous powers
   606	    should have the smallest possible surface.
   607	    """
   608	    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
   609	
   610	    expected = token()
   611	
   612	    class Handler(BaseHTTPRequestHandler):
   613	        protocol_version = "HTTP/1.1"
   614	
   615	        def _reply(self, code: int, answer: dict) -> None:
   616	            payload = json.dumps(answer).encode()
   617	            self.send_response(code)
   618	            self.send_header("Content-Type", "application/json")
   619	            self.send_header("Content-Length", str(len(payload)))
   620	            self.end_headers()
   621	            self.wfile.write(payload)
   622	
   623	        def do_POST(self):                                    # noqa: N802
   624	            try:
   625	                # Host check first: it is what stops DNS rebinding, where a page the
   626	                # owner is looking at resolves an attacker's domain to 127.0.0.1 and
   627	                # then talks to us with the browser's blessing.
   628	                host_header = (self.headers.get("Host") or "").split(":")[0]
   629	                if host_header not in ("127.0.0.1", "localhost", "[::1]"):
   630	                    return self._reply(403, {"ok": False, "error": "not for you"})
   631	                if not expected or not secrets.compare_digest(
   632	                        self.headers.get("X-Chief-Token") or "", expected):
   633	                    return self._reply(403, {"ok": False, "error": "not for you"})
   634	
   635	                length = int(self.headers.get("Content-Length") or 0)
   636	                if length < 0 or length > MAX_BODY_BYTES:
   637	                    return self._reply(413, {"ok": False, "error": "that request is too big"})
   638	                raw = self.rfile.read(length) if length else b"{}"
   639	                try:
   640	                    body = json.loads(raw or b"{}")
   641	                except json.JSONDecodeError:
   642	                    body = {}
   643	                if not isinstance(body, dict):
   644	                    body = {}
   645	
   646	                answer = handle(body)
   647	                self._reply(200 if answer.get("ok") else 403, answer)
