    80	    cfg = load_config()
    81	    grok = cfg["seats"]["grok"]
    82	    assert not grok.get("disabled", False), "grok is still switched off in seats.toml"
    83	    # The runner calls the paid API with a key. Labelling the seat 'subscription' made
