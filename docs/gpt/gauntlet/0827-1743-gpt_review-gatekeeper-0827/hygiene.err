   359	def _repo_is_ready() -> bool:
   360	    """On the branch we merge into, with nothing half-done in the folder.
   361	
   362	    Merging into a detached HEAD orphans the result; merging over the owner's own
   363	    uncommitted work risks losing it when a failed merge is aborted.
   364	    """
   365	    head = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
   366	                          cwd=REPO, capture_output=True, text=True)
   367	    if head.returncode != 0 or head.stdout.strip() != MERGE_INTO:
   368	        return False
   369	    dirty = subprocess.run(["git", "status", "--porcelain"],
   370	                           cwd=REPO, capture_output=True, text=True)
   371	    return dirty.returncode == 0 and not dirty.stdout.strip()
   372	
   373	
   374	def _git_merge(commit: str) -> str | None:
   375	    """Merge one exact commit. Takes a SHA, not a ref, on purpose."""
   376	    try:
   377	        proc = subprocess.run(["git", "merge", "--no-ff", "--no-edit", commit],
   378	                              cwd=REPO, capture_output=True, text=True, timeout=120)
   379	    except subprocess.TimeoutExpired:
   380	        _abort_any_merge()
   381	        return None
   382	    if proc.returncode != 0:
   383	        # Leave nothing half-merged behind. A conflicted tree that nobody is looking at
   384	        # is worse than a refusal.
   385	        _abort_any_merge()
   386	        return None
   387	    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=REPO,
   388	                          capture_output=True, text=True)
   389	    return head.stdout.strip()[:12] or None
