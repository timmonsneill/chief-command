    90	def test_without_a_key_grok_is_excluded_at_the_door_not_parked_forever(monkeypatch):
    91	    """A runner that exists but cannot run would be stamped onto every new job's panel
    92	    and then skip — 3 required, 2 reported, parked with no way out."""
    93	    monkeypatch.delenv("XAI_API_KEY", raising=False)
    94	    assert not gauntlet.has_runner("xai")
