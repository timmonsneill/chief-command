   174	def _approve(conn, action, *, reversible=1, recovery="restore the earlier version",
   175	             read_back="I'm about to put the new website live for everyone."):
   176	    conn.execute(
   177	        "INSERT INTO approvals (capability, action, read_back, reversible, recovery, "
   178	        "expires_at) VALUES ('deploy', ?, ?, ?, ?, datetime('now','+10 minutes'))",
   179	        (action, read_back, reversible, recovery),
   180	    )
   181	    rid = conn.execute("SELECT last_insert_rowid() AS id").fetchone()["id"]
   182	    conn.execute("UPDATE approvals SET granted_at = datetime('now') WHERE id = ?", (rid,))
   183	    return rid
   184	
   185	
   186	def test_deploy_goes_through_on_a_live_owner_approval(conn):
   187	    _approve(conn, "the website")
   188	    r = gatekeeper.deploy(conn, "the website")
   189	    assert r.verb == "deploy"
