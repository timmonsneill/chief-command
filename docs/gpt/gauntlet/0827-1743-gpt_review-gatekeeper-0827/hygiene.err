   447	
   448	def run_panel(
   449	    conn,
   450	    job_id: int,
   451	    request: str,
   452	    code: str,
   453	    version: str,
   454	    cfg: dict[str, Any],
   455	    *,
   456	    roster: list[str] | None = None,
   457	    db_path: Path | None = None,
   458	) -> PanelResult:
   459	    """Run the whole panel in parallel against one frozen bundle, then decide.
   460	
   461	    `conn` is the caller's connection, used only for the final decision. Each reviewer
   462	    gets its own. Returns what actually happened — including who didn't run and why.
   463	    """
   464	    import dispatch                      # local: dispatch imports this module
   465	
   466	    gauntlet = cfg.get("gauntlet", {})
   467	    # Ask the SAME question dispatch asked when it stamped the panel size on the job:
   468	    # who can actually sit? Falling back to the raw config list would put the panel and
   469	    # the job's own requirements at odds — the job needing 2 seats while the panel tried
   470	    # 3, one of which cannot run.
   471	    roster = roster if roster is not None else dispatch.panel_roster(conn, cfg)[0]
   472	    floor = int(gauntlet.get("min_model_families", 0))
   473	    db_path = db_path or DB_PATH
   474	
   475	    built_by = conn.execute("SELECT builder_family FROM jobs WHERE id = ?",
   476	                            (job_id,)).fetchone()
   477	    result = PanelResult(job_id=job_id, version=version, required_families=floor,
   478	                         builder_family=(built_by["builder_family"] if built_by else "") or "")
   479	
   480	    # A floor of zero is not "no requirement" — it is an UNCONFIGURED panel, and
   481	    # `0 < 0` is False, so every later check would wave it through and certify work
   482	    # nobody looked at. dispatch refuses this at the door; refuse it here too, because
   483	    # this function is reachable from anywhere and must not depend on its caller having
   484	    # been careful. Same for an empty roster: nobody to ask is not everybody agreeing.
   485	    if floor < 1 or not roster:
   486	        result.parked_reason = (
   487	            "no review panel is configured for this job — nothing would have checked it"
   488	        )
   489	        return result
   490	
   491	    result.runs = [ReviewerRun(seat_id=s) for s in roster]
   492	    decided = threading.Event()
   493	
   494	    threads = [
   495	        threading.Thread(
   496	            target=_review_one,
   497	            args=(job_id, run.seat_id, request, code, version, cfg, run, db_path,
   498	                  decided),
   499	            name=f"review-{job_id}-{run.seat_id}", daemon=True,
   500	        )
   501	        for run in result.runs
   502	    ]
   503	    for t in threads:
   504	        t.start()
   505	    for t in threads:
   506	        t.join(timeout=REVIEW_TIMEOUT_S + JOIN_GRACE_S)
   507	
   508	    # Close the door BEFORE reading any results. A reviewer still running has not
   509	    # answered, and must not be able to answer into a decision already made — the
   510	    # completion guards only fire on the way INTO done, so a late objection could never
   511	    # stop anything. It is recorded as not having participated, which is the truth.
   512	    decided.set()
   513	    for t, run in zip(threads, result.runs):
   514	        if t.is_alive() and not run.ran:
   515	            run.skipped = run.skipped or "that reviewer never answered"
   516	
   517	    # ── The decision. Every branch below ends in "leave it parked" except one. ──
   518	    if result.failed:
   519	        result.parked_reason = "a reviewer failed this version"
   520	        return result
   521	
   522	    families = result.families_passed
   523	    if len(families) < floor:
   524	        ran = len([r for r in result.runs if r.ran])
   525	        result.parked_reason = (
   526	            f"only {len(families)} model famil{'y' if len(families) == 1 else 'ies'} "
   527	            f"reviewed this ({ran} of {len(result.runs)} reviewers ran); "
   528	            f"{floor} are required"
   529	        )
   530	        return result
   531	
   532	    try:
   533	        set_status(conn, job_id, "done",
   534	                   spoken_summary=f"Checked by {len(families)} different models. Ready for you.")
   535	        result.certified = True
   536	    except GuardViolation as exc:
   537	        # Another gate still holds (panel size, an unanswered escalation, an old
   538	        # objection). Park honestly rather than argue with the boundary.
   539	        result.parked_reason = str(exc).replace("guard: ", "")
   540	
   541	    if result.certified:
   542	        _reconcile(conn, result)
   543	    if not result.certified:
   544	        # Say why it stopped, in the record, in plain words. A job parked with no stated
   545	        # reason is indistinguishable from a job nobody looked at.
   546	        conn.execute("UPDATE jobs SET spoken_summary = ? WHERE id = ?",
   547	                     (result.spoken(), job_id))
   548	    return result
   549	
   550	
   551	def _reconcile(conn, result: PanelResult) -> None:
   552	    """Last look: did an objection land while we were deciding?
   553	
   554	    The `decided` flag narrows that window; it cannot close it, because a straggler can
   555	    pass the check and be writing as the main thread commits. So after certifying we ask
   556	    the record — not our own bookkeeping — whether a failure exists against this version,
   557	    and un-certify if one does. Status can move back out of 'done'; the guards only
   558	    police the way in. A job wrongly parked costs a re-run. A job wrongly called finished
   559	    is the thing this project exists to prevent.
   560	    """
   561	    late = conn.execute(
   562	        "SELECT reviewer_seat FROM verdicts WHERE job_id=? AND verdict='fail' "
   563	        "AND reviewed_version IS ?", (result.job_id, result.version),
   564	    ).fetchone()
   565	    if late is None:
   566	        return
   567	    set_status(conn, result.job_id, "review",
   568	               spoken_summary="Sent back — a reviewer found a problem.")
   569	    result.certified = False
   570	    result.parked_reason = "a reviewer failed this version (it answered late)"
