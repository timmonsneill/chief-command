   216	    task_name     TEXT,
   217	    origin        TEXT NOT NULL DEFAULT 'text'
   218	                  CHECK (origin IN ('text', 'voice', 'cron', 'relay')),  -- 'relay' = Jess (§10)
   219	
   220	    -- 'build'    → produces code. Ground truth = a screenshot (Playwright drove it).
   221	    -- 'research' → produces an ANSWER. Ground truth = a source (someone can go read it).
   222	    -- Same principle, different evidence. A researcher that can't cite is a researcher
   223	    -- that might be confabulating — and a confident wrong answer is worse than no answer,
   224	    -- because you act on it.
   225	    kind          TEXT NOT NULL DEFAULT 'build' CHECK (kind IN ('build', 'research')),
   226	
   227	    project_id    TEXT REFERENCES projects(id) ON DELETE SET NULL,
   228	
   229	    -- Which tier this job actually ran at, and WHY. The 'why' matters: if we're
   230	    -- burning heavy tier on boilerplate, this column is how we find out.
   231	    tier          TEXT NOT NULL DEFAULT 'standard'
   232	                  CHECK (tier IN ('light', 'standard', 'heavy')),
   233	    tier_reason   TEXT,
   234	
   235	    builder_seat  TEXT NOT NULL REFERENCES seats(id),
   236	    -- SNAPSHOTTED AT CREATION. Sol (cross-family review, 2026-07-13) found that
   237	    -- guards read the builder's tier/family LIVE from `seats`, so re-tiering a local
   238	    -- seat to 'subscription' retroactively legitimized its old unreviewed work.
   239	    -- Freeze it here. What a seat is TODAY cannot change what it WAS.
   240	    builder_tier   TEXT NOT NULL DEFAULT 'local'
   241	                   CHECK (builder_tier IN ('local','subscription','metered')),
   242	    builder_family TEXT NOT NULL DEFAULT 'unknown',
   243	    run_id        TEXT,                      -- OpenClaw sessions_spawn run id
   244	    session_key   TEXT,                      -- agent:<id>:subagent:<uuid>
   245	
   246	    -- Git as audit trail (§7). Worktree-per-job, main untouched until merged.
   247	    branch        TEXT,
   248	    worktree      TEXT,
   249	
   250	    -- THE VERSION UNDER REVIEW (Sol build gate 3, 2026-07-20). The exact content
   251	    -- hash the builder is putting forward — a git commit id. Reviews bind to this:
   252	    -- a verdict only counts toward completion while its reviewed_version matches.
   253	    -- The moment the builder changes the code, this changes, and every earlier
   254	    -- approval silently stops counting. Sol called the alternative the most
   255	    -- dangerous flaw in the system: "believable green checks on code nobody
   256	    -- reviewed." The gatekeeper's job at push time is to verify the code leaving
   257	    -- the building IS this hash — the DB proves the chain, git proves the content.
   258	    head_version  TEXT,
   259	
   260	    -- 'done'    = the gauntlet passed. The machine is satisfied.
   261	    -- 'shipped' = NEILL said it works on his device. Only he can move this.
   262	    -- These are NOT the same thing, and conflating them is how agents launder
   263	    -- confidence. From Chief's memory, learned the hard way:
   264	    --     "Chief must NEVER say 'shipped' unless Neill has confirmed it works on
   265	    --      his device. 'Shipped' is reserved for Neill-confirmed-working."
   266	    -- That rule now lives here instead of in a prompt.
   267	    status        TEXT NOT NULL DEFAULT 'todo'
   268	                  CHECK (status IN ('todo', 'in_progress', 'review', 'done',
   269	                                    'shipped', 'failed', 'cancelled')),
   270	    -- Set ONLY by the owner, through mark_shipped(). No agent has a path to this.
   271	    owner_confirmed_at TEXT,
   272	
   273	    -- How many passing reviews this job needs before it may complete. Set at
   274	    -- dispatch from the gauntlet config. Also from Chief's memory:
   275	    --     "Full set, always. No 'minimum,' no 'pick two,' no 'optional depending
   276	    --      on scope.'"
   277	    required_reviews INTEGER NOT NULL DEFAULT 0,
   278	
   279	    -- How many DISTINCT model families must have a passing review before done. This is
   280	    -- the floor "full set, always" doesn't itself guarantee: a full panel could still be
   281	    -- one family wearing three hats. Set at dispatch from the gauntlet's
   282	    -- min_model_families. Snapshotted and un-lowerable, like required_reviews. (task #10)
   283	    required_review_families INTEGER NOT NULL DEFAULT 0,
   284	
   285	    result        TEXT,                      -- final summary / diff ref
   286	    error         TEXT,
   287	
   288	    -- Voice wants a spoken-length answer; the text log keeps the detail (§5.3).
   289	    spoken_summary TEXT,
   290	
   291	    attempts      INTEGER NOT NULL DEFAULT 0,
   292	    parent_job_id INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   293	
   294	    -- DUPLICATE PROTECTION. A retry — a double-tap, a dropped connection, the voice
   295	    -- re-sending — must not start the same work twice. The caller stamps a key; a
   296	    -- second dispatch with the same key returns the existing job instead of spawning
   297	    -- a new one. NULL = no key given (nothing to dedupe against). The unique index
   298	    -- below lets many NULLs coexist but forbids two rows sharing a real key.
   299	    dispatch_key  TEXT
   300	);
   301	
   302	CREATE INDEX IF NOT EXISTS idx_jobs_status  ON jobs(status);
   303	CREATE INDEX IF NOT EXISTS idx_jobs_created ON jobs(created_at);
   304	CREATE INDEX IF NOT EXISTS idx_jobs_run     ON jobs(run_id);
   305	CREATE UNIQUE INDEX IF NOT EXISTS idx_jobs_dispatch_key ON jobs(dispatch_key)
   306	    WHERE dispatch_key IS NOT NULL;
   307	
   308	-- ---------------------------------------------------------------------------
   309	-- Verdicts: the gauntlet's output (§6). One row per reviewer per job.
   310	-- reviewer_tier is denormalized at write time so a later seat re-tiering cannot
   311	-- retroactively validate a job that was never properly reviewed.
   312	-- ---------------------------------------------------------------------------
   313	CREATE TABLE IF NOT EXISTS verdicts (
   314	    id            INTEGER PRIMARY KEY,
   315	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   316	    reviewer_seat TEXT NOT NULL REFERENCES seats(id),
   317	    reviewer_tier TEXT NOT NULL CHECK (reviewer_tier IN ('local', 'subscription', 'metered')),
   318	    -- 'reviewer' reads the diff and judges. 'tester' DRIVES THE APP (Playwright) and
   319	    -- judges what it observed. The tester guards below apply only to the latter.
   320	    -- 'reviewer' reads the diff and judges it.
   321	    -- 'tester'   DROVE the running app (Playwright) and judges what it observed.
   322	    -- 'verifier' FACT-CHECKS a research answer against its sources.
   323	    role          TEXT NOT NULL DEFAULT 'reviewer'
   324	                  CHECK (role IN ('reviewer', 'tester', 'verifier')),
   325	    -- model family is snapshotted here so §6's "at least two families" rule is
   326	    -- auditable, and so the no-self-family-testing guard has something to check.
   327	    model_family  TEXT NOT NULL,
   328	    -- WHAT, exactly, did this reviewer look at? Snapshotted at write time. A verdict
   329	    -- whose version no longer matches the job's head_version is history, not
   330	    -- approval — it stops counting the moment the code moves on. This is the other
   331	    -- half of the review-to-version chain.
   332	    reviewed_version TEXT,
   333	    verdict       TEXT NOT NULL CHECK (verdict IN ('pass', 'fail', 'needs_human')),
   334	    severity      TEXT CHECK (severity IN ('p0', 'p1', 'p2', 'p3')),
   335	    summary       TEXT,
   336	    detail        TEXT,
   337	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   338	);
   339	
   340	CREATE INDEX IF NOT EXISTS idx_verdicts_job ON verdicts(job_id);
   341	
   342	-- ═══════════════════════════════════════════════════════════════════════════════
   343	-- CAPABILITIES — what an agent is PHYSICALLY ALLOWED to do.
   344	--
   345	-- This exists because Sol reviewed the architecture and demolished the previous
   346	-- safety story. The plan had been: the voice can act fast, and Chief watches and
   347	-- kills anything dumb. Sol's verdict:
   348	--
   349	--     "'Builders take minutes' measures how long they take to FINISH. What matters
   350	--      is how long they take to do their FIRST DAMAGING THING. That can be seconds.
   351	--      Chief and the builder would be RACING. There is no guarantee Chief wins."
   352	--
   353	--     "A fast supervisor is still only a fast witness if the builder can act first."
   354	--
   355	--     "A smarter model is not a security boundary."
   356	--
   357	-- He's right, and it's the difference between a bank with a vault and a bank with an
   358	-- attentive guard. You do not stop a robbery by watching carefully.
   359	--
   360	-- SO: agents get NO dangerous powers. Not "Chief will stop them" — THEY CANNOT.
   361	-- Reading code, writing code in their own worktree, running tests: always fine, and
   362	-- that's 95% of the work. Everything that touches the real world is denied by
   363	-- default and needs a signed, single-use permission slip for that exact act.
   364	-- ═══════════════════════════════════════════════════════════════════════════════
   365	CREATE TABLE IF NOT EXISTS capabilities (
   366	    seat_id       TEXT NOT NULL REFERENCES seats(id) ON DELETE CASCADE,
   367	    capability    TEXT NOT NULL CHECK (capability IN (
   368	                      -- SAFE. Granted to every builder. This is the actual job.
   369	                      'read_code', 'write_worktree', 'run_tests', 'open_pr',
   370	                      -- DANGEROUS. Denied to everyone by default. Each needs a
   371	                      -- fresh, single-use approval naming the exact action.
   372	                      'touch_production', 'delete_data', 'run_migration',
   373	                      'deploy', 'merge_to_main', 'force_push',
   374	                      'read_secrets', 'send_external', 'spend_money'
   375	                  )),
   376	    PRIMARY KEY (seat_id, capability)
   377	);
   378	
   379	-- The safe set. Everything an agent needs to actually build software, and nothing
   380	-- that can hurt you. Note what ISN'T here — that's the whole point.
   900	          AND v.reviewed_version IS NEW.head_version
   901	          -- The AUTHOR is not a second opinion. Same-family review is allowed (it is a
   902	          -- weaker signal, not a forbidden one — see test_jobs.py) but it does not COUNT
   903	          -- toward diversity, or "two different minds" could include the one that wrote
   904	          -- it. (Migration 007.)
   905	          AND v.model_family <> NEW.builder_family
   906	    ) < MAX(NEW.required_review_families, 1);
   907	END;
   908	
   909	-- ---------------------------------------------------------------------------
   910	-- The gatekeeper's own log (task #11). events.job_id is NOT NULL, and a deploy is not
   911	-- necessarily about a job — so without this, a deploy's grants AND refusals had nowhere
   912	-- to go and were silently dropped. Append-only, like verdicts: a record, not a draft.
   913	-- ---------------------------------------------------------------------------
   914	CREATE TABLE IF NOT EXISTS gate_log (
   915	    id          INTEGER PRIMARY KEY,
   916	    verb        TEXT NOT NULL,
   917	    subject     TEXT NOT NULL,
   918	    granted     INTEGER NOT NULL CHECK (granted IN (0,1)),
   919	    detail      TEXT NOT NULL,
   920	    asked_by    TEXT NOT NULL,
   921	    job_id      INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   922	    created_at  TEXT NOT NULL DEFAULT (datetime('now'))
   923	);
   924	
   925	CREATE TRIGGER IF NOT EXISTS guard_gate_log_is_append_only
   926	BEFORE UPDATE ON gate_log
   927	BEGIN
   928	    SELECT RAISE(ABORT, 'guard: the gatekeeper log is a record, not a draft');
   929	END;
   930	
   931	CREATE TRIGGER IF NOT EXISTS guard_gate_log_cannot_be_deleted
   932	BEFORE DELETE ON gate_log
   933	BEGIN
   934	    SELECT RAISE(ABORT, 'guard: the gatekeeper log cannot be deleted');
   935	END;
   936	
   937	-- ═══════════════════════════════════════════════════════════════════════════
   938	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   939	--
   940	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
   941	-- serious failure satisfied it. A reviewer could scream that the thing was broken and
   942	-- be outvoted by colleagues who hadn't noticed.
   943	--
   944	-- That is the opposite of what a gauntlet is FOR. One reviewer finding a real bug is
   945	-- the whole point — it isn't a democracy, it's a set of independent smoke detectors.
   946	-- Any one of them going off stops the job.
   947	-- ═══════════════════════════════════════════════════════════════════════════
   948	CREATE TRIGGER IF NOT EXISTS guard_a_failing_review_stops_it
   949	BEFORE UPDATE OF status ON jobs
   950	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   951	BEGIN
   952	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
   953	    WHERE EXISTS (
   954	        SELECT 1 FROM verdicts v
   955	        WHERE v.job_id = NEW.id AND v.verdict = 'fail'
   956	          -- gate 3: a fail condemns the VERSION it reviewed, not the job forever.
   957	          -- A fail with no version condemned we-don't-know-what: it blocks
   958	          -- everything. Same if the job itself is unversioned. Fail-closed.
   959	          AND (NEW.head_version IS NULL
   960	               OR v.reviewed_version IS NULL
   961	               OR v.reviewed_version = NEW.head_version)
   962	    );
   963	END;
   964	
   965	-- Sol, round 2, #6: an objection raised AFTER 'done' could still be outrun, because
   966	-- the escalation guard only fired on the transition INTO done — not on done -> shipped.
   967	CREATE TRIGGER IF NOT EXISTS guard_late_escalation_still_blocks_shipping
   968	BEFORE UPDATE OF status ON jobs
   969	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   970	BEGIN
   971	    SELECT RAISE(ABORT, 'guard: someone raised an objection — it has to be answered first')
   972	    WHERE EXISTS (
   973	        SELECT 1 FROM verdicts v
   974	        WHERE v.job_id = NEW.id
   975	          AND (v.verdict = 'needs_human'  -- an unanswered question blocks, always
   976	               -- gate 3: a fail blocks the version it condemned (fail-closed when
   977	               -- either side is unversioned)
   978	               OR (v.verdict = 'fail'
   979	                   AND (NEW.head_version IS NULL
   980	                        OR v.reviewed_version IS NULL
   981	                        OR v.reviewed_version = NEW.head_version)))
   982	    );
   983	END;
   984	
   985	-- Sol, round 2, #4: evidence could be an EMPTY STRING. A path of '' satisfied
   986	-- "COALESCE(path, value) IS NOT NULL" perfectly well.
   987	CREATE TRIGGER IF NOT EXISTS guard_evidence_cannot_be_empty
   988	BEFORE INSERT ON artifacts
   989	WHEN TRIM(COALESCE(NEW.path, NEW.value, '')) = ''
   990	BEGIN
   991	    SELECT RAISE(ABORT, 'guard: evidence with nothing in it is not evidence');
   992	END;
   993	
   994	-- ===========================================================================
   995	-- GUARD 6 — nothing ships without a passing cross-family tester.
   996	-- ===========================================================================
   997	CREATE TRIGGER IF NOT EXISTS guard_ship_requires_a_passing_tester
   998	BEFORE UPDATE OF status ON jobs
   999	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
  1000	BEGIN
  1001	    SELECT RAISE(ABORT, 'guard: nothing ships without a passing cross-family tester on the record')
  1002	    WHERE OLD.status <> 'done'
  1003	       OR NOT EXISTS (
  1004	           SELECT 1 FROM verdicts v
  1005	           WHERE v.job_id = NEW.id AND v.role = 'tester' AND v.verdict = 'pass'
  1006	             -- gate 3: the tester must have driven THIS version of the app
  1007	             AND v.reviewed_version IS NEW.head_version
  1008	       );
  1009	END;
  1010	
  1011	-- ===========================================================================
  1012	-- GUARD 7 — a researcher must show you where it got that.
  1013	-- ===========================================================================
  1014	CREATE TRIGGER IF NOT EXISTS guard_research_must_cite_sources
  1015	BEFORE UPDATE OF status ON jobs
  1016	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
  1017	     AND NEW.kind = 'research'
  1018	BEGIN
  1019	    SELECT RAISE(ABORT, 'guard: a research answer must cite sources — no source, no answer')
  1020	    WHERE NOT EXISTS (
  1021	        SELECT 1 FROM artifacts a
  1022	        WHERE a.job_id = NEW.id AND a.kind IN ('source', 'quote')
  1023	          AND COALESCE(a.path, a.value) IS NOT NULL
  1024	    );
  1025	END;
  1026	
  1027	-- ===========================================================================
  1028	-- GUARD 8 — a model family may not fact-check its own research.
  1029	-- ===========================================================================
  1030	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_verifying
  1031	BEFORE INSERT ON verdicts
  1032	WHEN NEW.role = 'verifier'
  1033	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
  1034	BEGIN
  1035	    SELECT RAISE(ABORT, 'guard: a model family may not fact-check its own research');
  1036	END;
  1037	
  1038	-- ===========================================================================
  1039	-- GUARD 9 — spend caps are enforced by the DATABASE, not by good manners.
  1040	--
418:    granted_by    TEXT NOT NULL DEFAULT 'owner' CHECK (granted_by = 'owner'),
419:    granted_at    TEXT,
420:    expires_at    TEXT NOT NULL,            -- short. Minutes, not hours.
421:    used_at       TEXT,                     -- single use. Once spent, it's spent.
432:CREATE VIEW IF NOT EXISTS live_approvals AS
434: WHERE granted_at IS NOT NULL
435:   AND used_at    IS NULL
437:   AND expires_at > datetime('now')
440:-- An approval may never be BORN granted. (Sol, round 3 — verified 2026-07-14.)
442:-- Every approval guard fired on UPDATE OF granted_at only — the exact "born done" hole
444:-- exploit: an INSERT with granted_at already set, reversible=0 and no recovery plan sailed
445:-- straight into the live_approvals view. An approval must be born ungranted and become
446:-- granted through an UPDATE, where the read-back and recovery guards below actually fire.
447:CREATE TRIGGER IF NOT EXISTS guard_no_approval_is_born_granted
449:WHEN NEW.granted_at IS NOT NULL
451:    SELECT RAISE(ABORT, 'guard: an approval cannot be created already granted — it must be granted through a read-back');
454:-- An approval cannot be granted without something having been read back.
456:BEFORE UPDATE OF granted_at ON approvals
