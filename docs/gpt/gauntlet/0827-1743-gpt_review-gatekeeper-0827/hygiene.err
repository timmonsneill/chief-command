    61	
    62	def _commit_in_worktree(wt: Path, job_id: int, branch: str, summary: str) -> str | None:
    63	    """Commit the job's output on its own branch and return the commit id.
    64	
    65	    This is what makes the gatekeeper's merge possible at all: it refuses unless the
    66	    branch tip IS the reviewed version, and a version has to be a commit for that to be
    67	    provable. If anything here fails, the caller falls back to a content hash — the job
    68	    is still reviewable, it just can never be merged by the gatekeeper, which is the
    69	    honest outcome for work that isn't in git.
    70	    """
    71	    env = {**os.environ,
    72	           "GIT_AUTHOR_NAME": "chief-worker", "GIT_AUTHOR_EMAIL": "worker@chief.local",
    73	           "GIT_COMMITTER_NAME": "chief-worker", "GIT_COMMITTER_EMAIL": "worker@chief.local"}
    74	    def git(*args):
    75	        return subprocess.run(["git", *args], cwd=wt, capture_output=True, text=True,
    76	                              timeout=60, env=env)
    77	    if git("rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
    78	        return None
    79	    if git("checkout", "-B", branch).returncode != 0:
    80	        return None
    81	    if git("add", "-A", OUTPUT_DIRNAME).returncode != 0:
    82	        return None
    83	    if git("commit", "-q", "-m", f"job {job_id}: {summary[:60]}").returncode != 0:
    84	        return None
    85	    sha = git("rev-parse", "HEAD").stdout.strip()
    86	    return sha[:16] if len(sha) >= 16 else None
    87	
    88	
    89	def _version_of(text: str) -> str:
    90	    """The exact content being put forward, as a short hash. This is what the whole
    91	    review-to-version chain binds to: change the output, change the version, and every
    92	    earlier approval silently stops counting (schema.sql, gate 3)."""
    93	    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]
    94	
    95	
    96	# ---------------------------------------------------------------------------
    97	# Worktree isolation — a builder never touches the live project.
    98	# ---------------------------------------------------------------------------
    99	def _make_worktree(job_id: int, branch: str) -> tuple[Path | None, str]:
   100	    """Give this job its own private copy of the repo. Returns (path, note).
   101	
   102	    If git worktrees aren't usable for any reason, fall back to a plain isolated
   103	    directory and SAY SO — a silent fallback that quietly drops isolation would be
   104	    exactly the kind of unspoken gap this project keeps getting bitten by.
   105	    """
   106	    WORKTREES.mkdir(exist_ok=True)
   107	    dest = WORKTREES / f"job-{job_id}"
   108	    if dest.exists():
   109	        return dest, "reused"
   110	    try:
   111	        subprocess.run(
   112	            ["git", "worktree", "add", "--detach", str(dest)],
   113	            cwd=HARNESS.parent, capture_output=True, text=True, timeout=60, check=True,
   114	        )
   115	        return dest, "worktree"
   116	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   117	        # Isolation still holds (separate dir, outside the repo tree) — it just isn't a
   118	        # git worktree, so we record that honestly.
   119	        dest.mkdir(parents=True, exist_ok=True)
   120	        detail = getattr(exc, "stderr", "") or str(exc)
   121	        return dest, f"plain-dir ({str(detail)[:60].strip()})"
   122	
   123	
   124	def cleanup_worktree(job_id: int) -> None:
   125	    """Remove a job's worktree once its work is merged or abandoned."""
   126	    dest = WORKTREES / f"job-{job_id}"
   127	    if not dest.exists():
   128	        return
   129	    subprocess.run(["git", "worktree", "remove", "--force", str(dest)],
   130	                   cwd=HARNESS.parent, capture_output=True, text=True)
   131	    if dest.exists():
   132	        subprocess.run(["rm", "-rf", str(dest)], capture_output=True, text=True)
   133	
