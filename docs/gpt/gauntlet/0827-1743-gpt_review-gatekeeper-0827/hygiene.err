   480	def spend(conn, seat_id: str, cents: int, *, job_id: int | None = None,
   481	          role: str = "build", asked_by: str = "unknown") -> Receipt:
   482	    """Reserve money BEFORE the provider is called, or refuse.
   483	
   484	    Sol: refusing to RECORD a charge doesn't unspend it. So the ledger is written first
   485	    and the call happens after. The daily and monthly caps live in the schema, which is
   486	    what makes this a reservation rather than a note — two agents reserving at the same
   487	    instant both hit the ledger, and the ledger refuses the one that breaches.
   488	
   489	    ⚠️ THERE IS NO RECONCILIATION YET. A reservation is an ESTIMATE, and if the real
   490	    call costs less, or never happens at all, the estimate stands against the cap
   529	    _log(conn, "spend", seat_id, True, f"{cents}c reserved for {role}", asked_by, job_id)
   530	    return Receipt(verb="spend", subject=seat_id, detail=f"{cents}c reserved for {role}",
   531	                   reference=str(ref))
   532	
   533	
   534	VERBS = {"merge": merge, "deploy": deploy, "spend": spend}
   535	
   536	
   537	# ---------------------------------------------------------------------------
   538	# The service — loopback only, and only these three verbs
   539	# ---------------------------------------------------------------------------
   540	def handle(request: dict[str, Any], *, db_path: Path | None = None) -> dict[str, Any]:
   541	    """One request in, one answer out. The whole surface area of the gatekeeper.
   542	
   543	    An unknown verb is refused without being examined further. This is the check that
   544	    keeps rule 1 true as the file grows.
   545	    """
   546	    verb = request.get("verb")
   547	    if verb not in VERBS:
   548	        return {"ok": False, "error": "the gatekeeper only does three things: "
   549	                                      "merge, deploy, spend"}
   550	
   551	    conn = connect(db_path or DB_PATH)
   552	    try:
   553	        asked_by = str(request.get("asked_by") or "unknown")
   554	        try:
   555	            if verb == "merge":
   556	                r = merge(conn, int(request["job_id"]), asked_by=asked_by)
   557	            elif verb == "deploy":
   558	                r = deploy(conn, str(request["target"]),
   559	                           job_id=_known_job(conn, request.get("job_id")), asked_by=asked_by)
   560	            else:
   561	                r = spend(conn, str(request["seat_id"]), int(request["cents"]),
   562	                          job_id=_known_job(conn, request.get("job_id")),
   563	                          role=str(request.get("role") or "build"), asked_by=asked_by)
   564	        except Refused as exc:
   565	            return {"ok": False, "error": str(exc)}
   566	        except (KeyError, ValueError, TypeError) as exc:
   567	            return {"ok": False, "error": f"that request didn't make sense: {exc}"}
   568	        except sqlite3.Error as exc:
   569	            return {"ok": False, "error": f"the record refused that: {_plain(exc)}"}
   570	        return {"ok": True, "verb": r.verb, "subject": r.subject,
   571	                "detail": r.detail, "reference": r.reference}
   572	    finally:
   573	        conn.close()
   574	
   575	
   576	def token() -> str:
   577	    """The shared secret a caller must present. Created once, readable only by us.
   578	
   579	    Loopback is a NETWORK control, not an authorization one. Without a token, any local
   580	    process — and any web page the owner happens to open, since a POST with a plain
   581	    content type is a "simple request" that needs no browser preflight — could drive the
   582	    three most dangerous powers in the system by fetching 127.0.0.1. A page cannot read
   583	    this file, so it cannot present the token.
   584	    """
   585	    TOKEN_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   586	    if not TOKEN_PATH.exists() or not TOKEN_PATH.read_text().strip():
   587	        # O_EXCL + 0600 from the first byte — never a world-readable instant. An empty
   588	        # file counts as missing: `compare_digest("", "")` is True, so an empty token
   589	        # would have let a header-less request through. Fail closed, always.
   590	        fd = os.open(TOKEN_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
   591	        with os.fdopen(fd, "w") as f:
   592	            f.write(secrets.token_urlsafe(32))
   593	        os.chmod(TOKEN_PATH, 0o600)
   594	    value = TOKEN_PATH.read_text().strip()
   595	    if len(value) < 32:
   596	        raise RuntimeError("the gatekeeper token is missing or too short — refusing to serve")
   597	    return value
   598	
   599	
   600	def serve(host: str = "127.0.0.1", port: int = 8788) -> None:
   601	    """Run the gatekeeper as its own process.
   602	
   603	    LOOPBACK ONLY, and not a choice to revisit casually: the tailnet is other devices,
   604	    and the whole point of this process is that reaching it is harder than reaching the
   605	    agents, not easier. Standard library only — the thing holding the dangerous powers
   606	    should have the smallest possible surface.
   607	    """
   608	    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
   609	
   610	    expected = token()
   611	
   612	    class Handler(BaseHTTPRequestHandler):
   613	        protocol_version = "HTTP/1.1"
   614	
   615	        def _reply(self, code: int, answer: dict) -> None:
   616	            payload = json.dumps(answer).encode()
   617	            self.send_response(code)
   618	            self.send_header("Content-Type", "application/json")
   619	            self.send_header("Content-Length", str(len(payload)))
   620	            self.end_headers()
   500	        )
   501	        for run in result.runs
   502	    ]
   503	    for t in threads:
   504	        t.start()
   505	    for t in threads:
   506	        t.join(timeout=REVIEW_TIMEOUT_S + JOIN_GRACE_S)
   507	
   508	    # Close the door BEFORE reading any results. A reviewer still running has not
   509	    # answered, and must not be able to answer into a decision already made — the
   510	    # completion guards only fire on the way INTO done, so a late objection could never
   511	    # stop anything. It is recorded as not having participated, which is the truth.
   512	    decided.set()
   513	    for t, run in zip(threads, result.runs):
   514	        if t.is_alive() and not run.ran:
   515	            run.skipped = run.skipped or "that reviewer never answered"
   516	
   517	    # ── The decision. Every branch below ends in "leave it parked" except one. ──
   518	    if result.failed:
   519	        result.parked_reason = "a reviewer failed this version"
   520	        return result
   521	
   522	    families = result.families_passed
   523	    if len(families) < floor:
   524	        ran = len([r for r in result.runs if r.ran])
   525	        result.parked_reason = (
   526	            f"only {len(families)} model famil{'y' if len(families) == 1 else 'ies'} "
   527	            f"reviewed this ({ran} of {len(result.runs)} reviewers ran); "
   528	            f"{floor} are required"
   529	        )
   530	        return result
   531	
   532	    try:
   533	        set_status(conn, job_id, "done",
   534	                   spoken_summary=f"Checked by {len(families)} different models. Ready for you.")
   535	        result.certified = True
   536	    except GuardViolation as exc:
   537	        # Another gate still holds (panel size, an unanswered escalation, an old
   538	        # objection). Park honestly rather than argue with the boundary.
   539	        result.parked_reason = str(exc).replace("guard: ", "")
   540	
   541	    if result.certified:
   542	        _reconcile(conn, result)
   543	    if not result.certified:
   544	        # Say why it stopped, in the record, in plain words. A job parked with no stated
   545	        # reason is indistinguishable from a job nobody looked at.
    15	#   * `--sandbox read-only` has been seen to edit files anyway (2026-07-31). So the
    16	#     working tree is checked after EVERY seat, and a dirty tree fails the run.
    17	#   * codex treats a non-tty stdin as more input and waits for EOF forever, which
    18	#     hangs unattended runs. Every call reads from /dev/null.
    19	set -uo pipefail
    20	BASE="${1:-origin/main}"
    21	BRANCH=$(git branch --show-current)
    22	if [ -z "$BRANCH" ] || [ "$BRANCH" = "main" ]; then
    23	  echo "Run this from your gpt/* work branch, not main." >&2; exit 1
    24	fi
    25	if ! command -v codex >/dev/null 2>&1; then
    26	  echo "codex CLI not found on PATH." >&2; exit 1
    27	fi
    28	if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    29	  echo "Working tree is not clean. Commit first — the gauntlet reviews commits." >&2; exit 1
    30	fi
    31	OUT="docs/gpt/gauntlet/$(date +%m%d-%H%M)-${BRANCH//\//_}"
    32	mkdir -p "$OUT"
    33	echo "Gauntlet: $BRANCH vs $BASE → $OUT/"
    34	
    35	COMMON="You are one seat of a multi-seat code review in this repo. Review ONLY the changes on branch $BRANCH relative to $BASE: start from 'git diff $BASE...HEAD' and read as much surrounding live code as you need to judge it (never review the diff blind). Read AGENTS.md first — its rules bind the code (seats not vendor names; no route around the database guards; text-first; no machine-specific paths); flag any drift as a finding. Run the tests with '.venv/bin/python -m pytest harness/tests/ -q' and report the count. Report ranked findings (CRITICAL/HIGH/MEDIUM/LOW), each with file:line and a CONCRETE failure scenario (inputs/state -> wrong outcome). Refute your own weak findings before reporting. End with an explicit verdict line: GO or NO-GO."
    36	
    37	FAILED=0
    38	run_seat() {
    39	  local name="$1" lens="$2"
    40	  echo "── seat: $name"
    41	  if codex exec -c model_reasoning_effort=high --sandbox read-only "$COMMON Your lens: $lens" \
    42	       </dev/null >"$OUT/$name.md" 2>"$OUT/$name.err"; then
    43	    echo "   done → $OUT/$name.md  (verdict: $(grep -oE '\b(NO-GO|GO)\b' "$OUT/$name.md" | tail -1 || echo 'none found'))"
    44	  else
    45	    echo "   FAILED — see $OUT/$name.err"; FAILED=1
    46	  fi
    47	  # A read-only reviewer that changed files is a broken reviewer, not a review.
    48	  local dirty
    49	  dirty=$(git status --porcelain --untracked-files=no || true)
    50	  if [ -n "$dirty" ]; then
    51	    echo "   ⚠ seat '$name' MODIFIED THE WORKING TREE despite read-only sandbox:" >&2
    52	    echo "$dirty" >&2
    53	    echo "   Reverting with 'git checkout -- .' and failing the run." >&2
    54	    git checkout -- . ; FAILED=1
    55	  fi
    56	}
    57	
    58	run_seat bughunter "RUNTIME BUGS — exception paths that leave a job half-written, sqlite transaction misuse, None handling, thread-safety in the review panel, off-by-one in the review floors, contracts drifting between gatekeeper.py and the schema triggers."
    59	run_seat security  "SECURITY — any way an agent can merge, deploy, or spend without the gatekeeper; shell/git injection via job fields; API keys reaching logs, events, or the database; SQL built from strings; a reviewer sending anything beyond the bundle it was handed; anything bound to a public interface instead of loopback/tailnet."
    60	run_seat wiring    "WIRING — is every change reachable end-to-end (config → seat sync → dispatch → worker → panel → record → dashboard)? Orphaned code, dead flags, built-but-never-called functions, a runner nothing routes to, a migration the live DB never got."
    61	run_seat hygiene   "HYGIENE + SPEC MATCH — hardcoded values that belong in seats.toml, provider names where a seat id belongs, stale comments contradicting new behaviour, dead code, test quality (would the new tests pass without the change?), and does the diff match the queue task's stated intent with no scope creep? Anything Neill will read must be plain English — flag filenames or jargon in spoken_summary / status strings."
    62	
    63	echo
    64	if [ "$FAILED" -ne 0 ]; then
    65	  echo "At least one seat FAILED or misbehaved. This run does not count. Fix and re-run."
    66	  exit 1
    67	fi
    68	echo "All seats done. Read the four reports in $OUT/."
    69	echo "Fix every CRITICAL and HIGH, commit, and RE-RUN this script until all seats say GO."
    70	echo "Then log the outcome (folder path + verdicts) in docs/gpt/GPT_WORKLOG.md."
    71	echo "REMINDER: this does NOT clear anything to merge. The harness's cross-family panel does that."
    12	## Feature Acceptance Checklist (rule 9)
    13	
    14	Each line: what exists, what it does, where it's reachable. Verified by driving it.
    15	
    16	| # | Item | Verified |
