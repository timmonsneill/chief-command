    20	    set_head_version, set_status, upsert_seat,
    21	)
    22	
    23	SEATS = [
    24	    Seat("grinder_local", "ollama", "qwen2.5-coder:7b", "qwen", "local"),
    25	    Seat("reviewer", "claude-cli", "claude-opus-4-8", "claude", "subscription"),
    26	    Seat("brain", "codex", "gpt-5.6-sol", "gpt", "subscription"),
    27	    Seat("brain2", "codex", "gpt-5.6-terra", "gpt", "subscription"),
    28	    Seat("grok", "xai", "grok-4.5", "grok", "metered", daily_cap_cents=100),
    29	]
