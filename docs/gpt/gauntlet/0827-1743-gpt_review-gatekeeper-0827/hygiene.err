   461	
   462	-- An irreversible act cannot be approved without a recovery plan.
   463	-- Sol: "'Kill' must never be presented as 'undo.'"
   464	CREATE TRIGGER IF NOT EXISTS guard_irreversible_needs_a_way_back
   465	BEFORE UPDATE OF granted_at ON approvals
   466	WHEN NEW.granted_at IS NOT NULL AND NEW.reversible = 0
   467	     AND TRIM(COALESCE(NEW.recovery, '')) = ''
   468	BEGIN
   469	    SELECT RAISE(ABORT, 'guard: this cannot be undone and has no way back — not without a recovery plan');
   470	END;
   471	
   472	-- Single use. A permission slip is spent when it is used.
   473	CREATE TRIGGER IF NOT EXISTS guard_an_approval_is_used_once
   474	BEFORE UPDATE OF used_at ON approvals
   475	WHEN OLD.used_at IS NOT NULL
   476	BEGIN
   477	    SELECT RAISE(ABORT, 'guard: that permission was already spent');
   478	END;
   479	
   480	-- ---------------------------------------------------------------------------
   481	-- Events: the live activity stream. What an agent is doing RIGHT NOW.
   482	--
   483	-- This is what makes the text channel feel like the Claude Code terminal — you
   484	-- watch Riggs read auth.py, edit routes.py, run pytest, and come back green.
   485	-- Without it the harness can only tell you a job "happened," which is useless
   486	-- while you're waiting and only mildly interesting afterward.
   487	--
   488	-- ONE STREAM, TWO RENDERINGS (this is the key design decision):
   489	--   VOICE reads jobs.spoken_summary — a sentence. "Riggs is on it, two minutes."
   490	--   TEXT  reads THIS table in full   — every tool call, every file, every result.
   491	-- Same truth, different verbosity. The voice can escalate into this table on
   492	-- request ("what's it actually doing?") — see [voice] in seats.toml.
   493	--
   494	-- Note `lane` and `model` are BOTH recorded. The lane (Riggs) carries the memory
   495	-- and the conventions; the model is whoever is sitting in that chair today. You
   496	-- must always be able to see which — otherwise you can't tell whether your auth
   497	-- module was built by your best coder or your cheapest one.
   498	-- ---------------------------------------------------------------------------
   499	CREATE TABLE IF NOT EXISTS events (
   500	    id            INTEGER PRIMARY KEY,
   501	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   502	    seat_id       TEXT NOT NULL REFERENCES seats(id),
   503	    lane          TEXT NOT NULL,             -- 'riggs' | 'finn' | 'nova' | 'forge' ...
   504	    model         TEXT NOT NULL,             -- who is actually in the chair right now
   505	    family        TEXT NOT NULL,
   506	    -- 'skipped' is load-bearing (task #10): the record needs a word for something that
   507	    -- did NOT happen. A reviewer that was capped out or couldn't run must leave a mark,
   508	    -- or a panel that quietly shrank looks identical to a full one. (Migration 006.)
   509	    kind          TEXT NOT NULL CHECK (kind IN (
   510	                      'dispatched', 'thinking', 'read', 'edit', 'write',
   511	                      'command', 'test_run', 'browse', 'verdict', 'done', 'error',
   512	                      'skipped'
   513	                  )),
   514	    target        TEXT,                      -- the file / command / URL it touched
   515	    detail        TEXT,                      -- one line, terminal-style
   516	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   517	);
   518	
   519	CREATE INDEX IF NOT EXISTS idx_events_job ON events(job_id, id);
   520	
   521	-- ---------------------------------------------------------------------------
   522	-- Artifacts: GROUND TRUTH. Captured by the harness, not reported by a model.
   523	--
   524	-- This is the anti-fabrication layer, and it exists for a specific reason:
   525	-- GPT-5.6-sol's own system card admits it fabricates results, and METR measured a
   526	-- cheating rate higher than any public model they'd evaluated. A tester that lies
   527	-- doesn't just fail — it silently disables the only quality gate in the fleet,
   528	-- because nothing checks the tester.
   529	--
   530	-- The defense is structural: Playwright drives the app like a real user and the
   531	-- HARNESS writes the screenshots, traces, console logs and network dumps to disk.
   532	-- The tester never asserts "I ran it and it worked" — it INTERPRETS artifacts it
   533	-- did not produce and cannot forge. You can't fabricate a screenshot.
   534	--
   535	-- Forge (the existing Claude Code integration tester) already worked this way by
   536	-- discipline: "If you didn't execute it and see it work, it's not tested."
   537	-- Here that stops being a personality trait and becomes a constraint.
   538	-- ---------------------------------------------------------------------------
   539	CREATE TABLE IF NOT EXISTS artifacts (
   540	    id            INTEGER PRIMARY KEY,
   541	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   542	    kind          TEXT NOT NULL CHECK (kind IN (
   543	                      -- build evidence: the harness drove the app and wrote these down
   544	                      'screenshot', 'trace', 'video', 'console_log',
   545	                      'network_log', 'dom_snapshot', 'exit_code', 'stdout', 'stderr',
   546	                      -- research evidence: a claim you can go and check yourself
   547	                      'source', 'quote'
   548	                  )),
   549	    path          TEXT,                      -- on-disk artifact
   550	    value         TEXT,                      -- inline (e.g. an exit code)
   551	    -- The flow this came from, e.g. "login -> dashboard -> dispatch a build"
   552	    flow          TEXT,
   553	    -- 'model' IS allowed here, but ONLY for research sources — a researcher must be
   554	    -- able to hand you a URL. It is still not allowed to invent a screenshot.
   555	    captured_by   TEXT NOT NULL DEFAULT 'harness'
   556	                  CHECK (captured_by IN ('harness', 'playwright', 'model')),
   557	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   558	);
   559	
   560	CREATE INDEX IF NOT EXISTS idx_artifacts_job ON artifacts(job_id);
   561	
   562	-- ---------------------------------------------------------------------------
   563	-- Usage: per-seat spend, so the caps in `seats` mean something.
   564	-- OpenClaw core has NO per-agent cost or token budget. This is ours.
   565	-- ---------------------------------------------------------------------------
   566	CREATE TABLE IF NOT EXISTS usage (
   567	    id            INTEGER PRIMARY KEY,
   568	    seat_id       TEXT NOT NULL REFERENCES seats(id),
   569	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   570	    -- What kind of work this spend was. Lets us ration building separately from
   571	    -- reviewing — the whole point of the per-role caps above.
   572	    role          TEXT NOT NULL DEFAULT 'build'
   573	                  CHECK (role IN ('build', 'review', 'test', 'research', 'voice')),
   574	    day           TEXT NOT NULL DEFAULT (date('now')),
   575	    input_tokens  INTEGER NOT NULL DEFAULT 0,
   576	    output_tokens INTEGER NOT NULL DEFAULT 0,
   577	    cost_cents    INTEGER NOT NULL DEFAULT 0,
   578	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   579	);
   580	
   581	CREATE INDEX IF NOT EXISTS idx_usage_seat_day ON usage(seat_id, day);
   582	CREATE INDEX IF NOT EXISTS idx_usage_month ON usage(day);
   583	
   584	-- ═══════════════════════════════════════════════════════════════════════════
   585	-- THE MONEY. Owner (2026-07-14): "$100/mo limit, notify me at $50."
   586	--
   587	-- TWO LAYERS, deliberately:
   588	--
   589	--   1. OpenAI's OWN monthly budget cap ($100), set in their dashboard. That is the
   590	--      REAL ceiling — it physically stops them serving requests, and no bug in this
   591	--      codebase can defeat it. It is also a terrible way to find out, because it
   592	--      cuts you off mid-sentence.
   593	--
   594	--   2. THIS. A softer, earlier layer that warns at $50 and refuses to spend past a
   595	--      budget we set ourselves — so we stop gracefully, say why, and never hit
   596	--      their wall at all.
   597	--
   598	-- Belt and braces. The dashboard cap is the thing that saves you if I'm wrong.
   599	-- ═══════════════════════════════════════════════════════════════════════════
   600	CREATE TABLE IF NOT EXISTS budget (
   601	    id              INTEGER PRIMARY KEY CHECK (id = 1),   -- exactly one row
   602	    monthly_cap_cents  INTEGER NOT NULL DEFAULT 10000,    -- $100
   603	    warn_at_cents      INTEGER NOT NULL DEFAULT 5000,     -- $50
   604	    warned_this_month  TEXT,                              -- 'YYYY-MM' so we warn once
   605	    updated_at         TEXT NOT NULL DEFAULT (datetime('now'))
   606	);
   607	
   608	INSERT OR IGNORE INTO budget (id, monthly_cap_cents, warn_at_cents) VALUES (1, 10000, 5000);
   609	
   610	-- The month's spend, all seats. This is the number that matters.
   611	CREATE VIEW IF NOT EXISTS month_spend AS
   612	SELECT
   613	    COALESCE(SUM(cost_cents), 0)                                   AS spent_cents,
   614	    (SELECT monthly_cap_cents FROM budget WHERE id = 1)            AS cap_cents,
   615	    (SELECT warn_at_cents     FROM budget WHERE id = 1)            AS warn_cents
   616	FROM usage
   617	WHERE strftime('%Y-%m', day) = strftime('%Y-%m', 'now');
   618	
   619	-- ═══════════════════════════════════════════════════════════════════════════
   620	-- GUARD 11 — the month's budget is hard. It refuses the entry that would breach it.
   621	--
   622	-- Same principle as every other guard here: this is not a policy an agent is asked
   623	-- to respect, it is a write that fails.
   624	-- ═══════════════════════════════════════════════════════════════════════════
   625	CREATE TRIGGER IF NOT EXISTS guard_monthly_budget_is_hard
   626	BEFORE INSERT ON usage
   627	BEGIN
   628	    SELECT RAISE(ABORT, 'guard: this would blow the monthly budget')
   629	    WHERE (SELECT spent_cents FROM month_spend) + NEW.cost_cents
   630	        > (SELECT monthly_cap_cents FROM budget WHERE id = 1);
   631	END;
   632	
   633	-- ===========================================================================
   634	-- THE GUARDS
   635	--
   636	-- ⚠️ REWRITTEN 2026-07-13 after a cross-family review. Sol (GPT) reviewed Claude's
   637	-- code and found NINE ways through. The headline: every guard fired on UPDATE of
   638	-- status, and NONE fired on INSERT — so a job could be BORN 'done'. Fences around
   639	-- the front door, no wall.
   640	--
   641	-- Sol's closing line, which is the one that mattered:
   642	--     "Those are application conventions, not the claimed structurally impossible
   643	--      guarantees."
   644	--
   645	-- He was right. Fixed below. Each guard now fires on BOTH insert and update, checks
   646	-- SNAPSHOTTED facts rather than live ones, and validates claims against `seats`
   647	-- instead of trusting whatever the writer put in the row.
   648	-- ===========================================================================
   649	
   650	-- A job may never be BORN finished. (Sol, round 1, #1 — the worst one.)
   651	CREATE TRIGGER IF NOT EXISTS guard_no_job_is_born_done
   652	BEFORE INSERT ON jobs
   653	WHEN NEW.status IN ('done', 'shipped')
   654	BEGIN
   655	    SELECT RAISE(ABORT, 'guard: a job cannot be created already finished — it must earn it');
   656	END;
   657	
   658	-- A job may not LIE ABOUT WHO BUILT IT AT BIRTH. (Sol, round 2, #1 — critical.)
   659	--
   660	-- I froze the builder's identity AFTER creation, so it couldn't be rewritten. But I
   661	-- never checked it AT creation. Sol: "A direct database write can label local work as
   662	-- subscription work, then complete it without the required higher-quality review. The
   663	-- identity is frozen only after creation; the initial lie is never caught."
   664	--
   665	-- Freezing a lie just makes it a permanent lie.
   666	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_must_be_real
   667	BEFORE INSERT ON jobs
   668	WHEN NEW.builder_tier   <> (SELECT tier   FROM seats WHERE id = NEW.builder_seat)
   669	  OR NEW.builder_family <> (SELECT family FROM seats WHERE id = NEW.builder_seat)
   670	BEGIN
   671	    SELECT RAISE(ABORT, 'guard: a job cannot misrepresent who built it');
   672	END;
   673	
   674	-- The builder's tier/family are snapshotted at creation and are then HISTORY.
   675	-- (Sol #5, #6 — re-tiering a seat rewrote the past.)
   676	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_is_frozen
   677	BEFORE UPDATE ON jobs
   678	WHEN OLD.builder_seat <> NEW.builder_seat
   679	  OR OLD.builder_tier <> NEW.builder_tier
   680	  OR OLD.builder_family <> NEW.builder_family
   681	BEGIN
   682	    SELECT RAISE(ABORT, 'guard: who built this cannot be rewritten after the fact');
   683	END;
   684	
   685	-- The panel size is fixed at dispatch. (Sol #7 — it could be set to zero later.)
   686	CREATE TRIGGER IF NOT EXISTS guard_panel_size_is_fixed
   687	BEFORE UPDATE OF required_reviews ON jobs
   688	WHEN OLD.required_reviews > 0 AND NEW.required_reviews < OLD.required_reviews
   689	BEGIN
   690	    SELECT RAISE(ABORT, 'guard: the panel cannot be shrunk after dispatch');
   691	END;
   692	
   693	-- A verdict, once written, is a fact. It cannot be edited into a pass.
   694	-- (Sol #2 — every verdict guard checked INSERT only, so you could rewrite the row.)
   695	CREATE TRIGGER IF NOT EXISTS guard_verdicts_are_append_only
   696	BEFORE UPDATE ON verdicts
   697	WHEN OLD.verdict <> NEW.verdict
   698	     AND NOT (OLD.verdict = 'needs_human' AND NEW.verdict IN ('pass','fail'))
   699	BEGIN
   700	    SELECT RAISE(ABORT, 'guard: a verdict cannot be rewritten — only an escalation may be answered');
     1	"""Durable job store for the Chief Command v2 harness.
     2	
     3	OpenClaw dispatches the work; this records it. Its subagent sessions auto-archive
     4	after ~60 minutes, so anything we want to answer later ("what did the overnight run
     5	do?", spec §7) has to live here.
     6	
     7	The two rules that must never quietly stop holding are enforced in schema.sql as
     8	triggers, not here — see guard_local_output_needs_review and
     9	guard_unresolved_escalation. This module will simply raise if you try to violate them.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import sqlite3
    15	from dataclasses import dataclass
    16	from pathlib import Path
    17	from typing import Any, Iterable, Optional
    18	
    19	DB_PATH = Path(__file__).resolve().parent / "chief.db"
    20	SCHEMA_PATH = Path(__file__).resolve().parent / "schema.sql"
    21	
    22	# Raised by the schema triggers. We surface it as something catchable.
    23	class GuardViolation(RuntimeError):
    24	    """A structural rule was violated (e.g. shipping unreviewed local output)."""
    25	
    26	
    27	@dataclass(frozen=True)
    28	class Seat:
    29	    id: str
    30	    provider: str
    31	    model: str
    32	    family: str  # gpt | claude | grok | qwen — what determines shared blind spots
    33	    tier: str  # local | subscription | metered
    34	    daily_cap_cents: Optional[int] = None   # hard ceiling across everything
    35	    build_cap_cents: Optional[int] = None   # ration the EXPENSIVE work
    36	    review_cap_cents: Optional[int] = None  # reviewing is cheap — be generous
    37	    # Three models per seat. NOTHING gets `heavy` by default — it has to be earned.
    38	    # Rate limits, not money, are the binding constraint on autonomous work, and you
    39	    # cannot buy your way out of a weekly cap.
    40	    model_light: Optional[str] = None
    41	    model_standard: Optional[str] = None
    42	    model_heavy: Optional[str] = None
    43	    enabled: bool = True
    44	    notes: str = ""
    45	
    46	
    47	def connect(db_path: Path | str = DB_PATH) -> sqlite3.Connection:
    48	    # timeout is stated rather than inherited from the stdlib default: the review panel
    49	    # writes verdicts from several threads at once, and how long a writer waits for the
    50	    # lock before giving up is a real property of this system, not a detail to leave to
    51	    # whatever the standard library happens to pick.
    52	    conn = sqlite3.connect(db_path, isolation_level=None,  # autocommit; we manage txns
    53	                           timeout=15.0)
    54	    conn.row_factory = sqlite3.Row
    55	    conn.execute("PRAGMA foreign_keys = ON")
    56	    conn.execute("PRAGMA busy_timeout = 15000")
    57	    return conn
    58	
    59	
    60	def init_db(conn: sqlite3.Connection) -> None:
    61	    """Build the schema on a FRESH database only.
    62	
    63	    This used to run schema.sql on EVERY call — including server startup against the LIVE
    64	    DB. That made editing schema.sql a silent live deploy: a new `CREATE TRIGGER IF NOT
    65	    EXISTS` installs on the next restart while `CREATE TABLE IF NOT EXISTS` stays a no-op,
    66	    so a trigger can land WITHOUT the column it references and jam every status change (it
    67	    did, 2026-07-20). An existing DB now advances ONLY through the numbered migrations in
    68	    db/migrations/, applied deliberately — never as a side effect of a restart.
    69	    """
    70	    initialized = conn.execute(
    71	        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'jobs'"
    72	    ).fetchone()
    73	    if initialized:
    74	        return
    75	    conn.executescript(SCHEMA_PATH.read_text())
    76	
    77	
    78	def _guarded(fn):
    79	    """Translate the schema's RAISE(ABORT, 'guard: ...') into GuardViolation."""
    80	
    81	    def wrapper(*args, **kwargs):
    82	        try:
    83	            return fn(*args, **kwargs)
    84	        except sqlite3.IntegrityError as exc:
    85	            if "guard:" in str(exc):
    86	                raise GuardViolation(str(exc)) from exc
    87	            raise
    88	
    89	    return wrapper
    90	
    91	
    92	# --------------------------------------------------------------------------
    93	# Seats
    94	# --------------------------------------------------------------------------
    95	def upsert_seat(conn: sqlite3.Connection, seat: Seat) -> None:
    96	    conn.execute(
    97	        """
    98	        INSERT INTO seats (id, provider, model, family, tier, daily_cap_cents,
    99	                           build_cap_cents, review_cap_cents,
   100	                           model_light, model_standard, model_heavy, enabled, notes)
   101	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
   102	        ON CONFLICT(id) DO UPDATE SET
   103	            provider = excluded.provider,
   104	            model = excluded.model,
   105	            family = excluded.family,
   106	            tier = excluded.tier,
   107	            daily_cap_cents = excluded.daily_cap_cents,
   108	            build_cap_cents = excluded.build_cap_cents,
   109	            review_cap_cents = excluded.review_cap_cents,
   110	            model_light = excluded.model_light,
   111	            model_standard = excluded.model_standard,
   112	            model_heavy = excluded.model_heavy,
   113	            enabled = excluded.enabled,
   114	            notes = excluded.notes
   115	        """,
   116	        (seat.id, seat.provider, seat.model, seat.family, seat.tier,
   117	         seat.daily_cap_cents, seat.build_cap_cents, seat.review_cap_cents,
   118	         seat.model_light, seat.model_standard, seat.model_heavy,
   119	         int(seat.enabled), seat.notes),
   120	    )
   121	
   122	
   123	def seat(conn: sqlite3.Connection, seat_id: str) -> sqlite3.Row | None:
   124	    return conn.execute("SELECT * FROM seats WHERE id = ?", (seat_id,)).fetchone()
   125	
   126	
   127	# --------------------------------------------------------------------------
   128	# Jobs
   129	# --------------------------------------------------------------------------
   130	def create_job(
   131	    conn: sqlite3.Connection,
   132	    request: str,
   133	    builder_seat: str,
   134	    origin: str = "text",
   135	    parent_job_id: Optional[int] = None,
   136	    task_name: Optional[str] = None,
   137	) -> int:
   138	    """task_name is the 2-4 word handle the voice will use ("the rate limiter").
   139	
   140	    The mouth coins it at dispatch. Without one the voice falls back to truncating
   141	    the request, which reads back the owner's own paragraph at him — exactly what a
   142	    colleague would never do.
   143	    """
   144	    row = seat(conn, builder_seat)
   145	    if row is None:
   146	        raise ValueError(f"unknown builder seat: {builder_seat}")
   147	
   148	    # Snapshot who built this, AT BUILD TIME. Sol's cross-family review found that
   149	    # reading the builder's tier live meant re-tiering a local seat retroactively
   150	    # legitimized its old unreviewed work. What a seat is today cannot change what
   151	    # it was. The schema then freezes these columns.
   152	    cur = conn.execute(
   153	        """
   154	        INSERT INTO jobs (request, builder_seat, builder_tier, builder_family,
   155	                          origin, parent_job_id, task_name)
   156	        VALUES (?, ?, ?, ?, ?, ?, ?)
   157	        """,
   158	        (request, builder_seat, row["tier"], row["family"],
   159	         origin, parent_job_id, task_name),
   160	    )
   161	    return int(cur.lastrowid)
   162	
   163	
   164	def claim_next_job(conn: sqlite3.Connection, builder_seat: str) -> sqlite3.Row | None:
   165	    """Atomically claim the oldest queued job for this seat.
   166	
   167	    Uses UPDATE...RETURNING against a subquery so two workers racing for the same
   168	    row cannot both win — SQLite serializes the write and only one claim lands.
   169	    Cribbed from clu's approach; it removes the need for any external lock.
   170	    """
   171	    row = conn.execute(
   172	        """
   173	        UPDATE jobs
   174	           SET status = 'in_progress',
   175	               started_at = datetime('now'),
   176	               attempts = attempts + 1
   177	         WHERE id = (
   178	             SELECT id FROM jobs
   179	              WHERE status = 'todo' AND builder_seat = ?
   180	              ORDER BY id
   181	              LIMIT 1
   182	         )
   183	        RETURNING *
   184	        """,
   185	        (builder_seat,),
   186	    ).fetchone()
   187	    return row
