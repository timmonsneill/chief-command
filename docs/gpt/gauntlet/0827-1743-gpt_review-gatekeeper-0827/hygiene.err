   402	# ---------------------------------------------------------------------------
   403	# DEPLOY — something reaches the world
   404	# ---------------------------------------------------------------------------
   405	def deploy(conn, target: str, *, job_id: int | None = None,
   406	           asked_by: str = "unknown") -> Receipt:
   407	    """Deploy — ONLY on a live, unused, read-back owner approval naming this target.
   408	
   409	    Decision D keeps Neill in the path for production deploys, and this is the only
   410	    place in the harness where an agent's request is not enough on its own. There is
   411	    deliberately no "the reviewers all agreed" route here: reviewers judge code, and a
   412	    deploy is a decision about the business.
   413	    """
   414	    target = _clean(target)
   415	    approval = conn.execute(
   416	        "SELECT * FROM live_approvals WHERE capability = 'deploy' AND action = ? "
   417	        "ORDER BY id DESC LIMIT 1", (target,),
   418	    ).fetchone()
   419	    if approval is None:
   420	        raise _refuse(conn, job_id,
   421	                      f"nothing has been approved for deploying {target} — "
   422	                      "that needs your say-so, tapped, not spoken",
   423	                      verb="deploy", subject=target, asked_by=asked_by)
   424	    # An approval granted about ONE job does not authorize the same words claimed under
   425	    # another. Without this, a yes given in the context of job 4 travels to job 99.
   426	    if approval["job_id"] is not None and approval["job_id"] != job_id:
   427	        raise _refuse(conn, job_id,
   428	                      "that approval was for a different piece of work",
   429	                      verb="deploy", subject=target, asked_by=asked_by)
   430	    if not approval["reversible"] and not (approval["recovery"] or "").strip():
   431	        raise _refuse(conn, job_id,
   432	                      "that deploy can't be undone and there's no written way back",
   433	                      verb="deploy", subject=target, asked_by=asked_by)
   434	
   435	    # No mechanism, no deploy — and above all no CONSUMED approval. Burning the owner's
   436	    # one-time yes on a verb that then does nothing would make him grant it twice for
   437	    # one deploy. The mechanism, when built, registers here and runs BEHIND the gate.
   438	    deployer = DEPLOYERS.get(target)
   439	    if deployer is None:
   440	        raise _refuse(conn, job_id,
   441	                      f"there's no way to deploy {target} built yet — your approval "
   442	                      "was not used up",
   443	                      verb="deploy", subject=target, asked_by=asked_by)
   444	
   445	    # Spend the approval FIRST. If the deploy dies halfway, the slip is still used —
   446	    # a retry must come back for a fresh yes rather than replay an old one. Two callers
   447	    # racing: SQLite serializes the writes and the single-use guard refuses the loser,
   448	    # which arrives here as a plain refusal rather than a crash.
   449	    try:
   450	        conn.execute("UPDATE approvals SET used_at = datetime('now') WHERE id = ?",
   451	                     (approval["id"],))
   452	    except sqlite3.IntegrityError as exc:
   453	        raise _refuse(conn, job_id, "that approval has already been used",
   454	                      verb="deploy", subject=target, asked_by=asked_by) from exc
   455	
   456	    try:
   457	        reference = str(deployer(target) or "")
   458	    except Exception as exc:  # noqa: BLE001 — a failed deploy is a refusal, said aloud
   459	        raise _refuse(conn, job_id, f"the deploy of {target} didn't go through: "
   460	                      f"{_clean(str(exc), 160)} — it needs a fresh approval to retry",
   461	                      verb="deploy", subject=target, asked_by=asked_by) from exc
   462	
   463	    detail = f"deployed {target} on your approval"
   464	    _note(conn, job_id, f"Deployed {target}, on your approval. "
   465	                        f"Asked for by {_clean(asked_by)}.", kind="done")
   466	    _log(conn, "deploy", target, True, detail, asked_by, job_id)
   467	    return Receipt(verb="deploy", subject=target, detail=detail,
   468	                   reference=reference or str(approval["id"]))
   469	
   470	
   471	# What actually performs a deploy, by target. EMPTY on purpose: nothing in the harness
   472	# can deploy anything yet. When something can, it registers here — behind the gate, so
   473	# that the owner's approval is the only thing that can start it.
   474	DEPLOYERS: dict[str, Callable[[str], str | None]] = {}
