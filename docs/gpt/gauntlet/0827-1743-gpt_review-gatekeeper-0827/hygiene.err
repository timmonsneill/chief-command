   325	def _branch_tip(branch: str) -> str | None:
   326	    """The commit a BRANCH points at — refs/heads/ so nothing else can be meant."""
   327	    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}"],
   328	                         cwd=REPO, capture_output=True, text=True)
   329	    return out.stdout.strip() or None if out.returncode == 0 else None
   330	
   331	
   332	def _same_commit(tip: str, version: str) -> bool:
   333	    """Is the reviewed version this exact commit?
   334	
   335	    `head_version` is a short id, so compare on the shorter length. A version that is
   336	    not a commit id at all (the local worker records a content hash) can never match,
   337	    which is correct: if we cannot prove the reviewed thing is this code, we do not
   338	    merge it.
   339	    """
   340	    version = (version or "").strip().lower()
   341	    tip = (tip or "").strip().lower()
   342	    if len(version) < 7 or not re.fullmatch(r"[0-9a-f]+", version):
   343	        return False
   344	    return tip.startswith(version)
