    74	def test_the_record_itself_refuses_a_panel_of_one_family(conn):
    75	    """Two seats signed off; both are the same underlying model. The seat count is met
    76	    and the thing the panel is FOR — a second opinion — never happened.
    77	
    78	    Note what this test proves: the job cannot even REACH 'done', so the gatekeeper is
    79	    never consulted. That is the right order — the wall first, the door second."""
    80	    job = _finished_job(conn, families=("gpt",), fams_required=2)
    81	    record_verdict(conn, job, "brain2", verdict="pass", role="reviewer")   # gpt again
    82	    with pytest.raises(Exception, match="fewer model families"):
    83	        set_status(conn, job, "done")
    84	
    85	
    86	def test_merge_counts_families_itself_and_does_not_assume_the_record_did(conn):
    87	    """Defence in depth. The floor is raised AFTER the job completed under a lower one —
    88	    the schema permits raising it, and the gatekeeper must re-check rather than trust
    89	    that whatever let this job through was asking the same question it is."""
    90	    job = _finished_job(conn, families=("gpt",), seats_required=1, fams_required=1)
    91	    set_status(conn, job, "done")
    92	    conn.execute("UPDATE jobs SET required_review_families=2 WHERE id=?", (job,))
    93	    with pytest.raises(gatekeeper.Refused, match="different kinds of model"):
    94	        gatekeeper.merge(conn, job)
    95	
    96	
    97	def test_merge_does_not_count_the_author_as_a_second_opinion(conn):
    98	    """Migration 007 for the door, not just the wall. The job completed honestly on a
    99	    floor of one (gpt reviewed a claude build); the floor is then raised to two and a
   100	    claude pass — the builder's own family — is added. The record already refuses this
   101	    at 'done'; the gatekeeper must reach the same answer on its own."""
   102	    job = _finished_job(conn, families=("gpt",), seats_required=1, fams_required=1)
   103	    record_verdict(conn, job, "reviewer", verdict="pass", role="reviewer")   # claude on claude
   104	    set_status(conn, job, "done")
   105	    conn.execute("UPDATE jobs SET required_review_families=2 WHERE id=?", (job,))
   106	    with pytest.raises(gatekeeper.Refused, match="different kinds of model"):
   107	        gatekeeper.merge(conn, job)
