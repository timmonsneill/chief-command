diff --git a/harness/config/seats.toml b/harness/config/seats.toml
index abbf123..da40d1b 100644
--- a/harness/config/seats.toml
+++ b/harness/config/seats.toml
@@ -186,75 +186,67 @@ notes = "Backend lane. Memory belongs to the LANE, not the model — swap the mo
 // Subscription primary, metered API key as fallback on the same seat. When the
 // mystery quota dies at 2am mid-build, the seat fails over to the key and KEEPS
 // GOING instead of stalling the run. Subscription economics, metered reliability.
 //
 // HARD CEILING: $30 sub + $30/mo API cap = $60/mo maximum, no surprises.
 // (daily_cap_cents 100 x ~30 days = ~$30/mo of fallback.)
 // ---------------------------------------------------------------------------
 // GROK BUILDS LESS THAN THE OTHERS — deliberately. Owner (2026-07-13):
 //     "it can review as much as it wants more or less, but shouldn't build as much
 //      as claude and chat"
 //
 // He's right, and the economics agree. Claude and OpenAI are FLAT-RATE — a build on
 // those seats costs nothing marginal, it's already bought. Grok is METERED, so every
 // build is real money leaving the account. And builds are the EXPENSIVE kind of work
 // (token-heavy) while reviews are CHEAP (read-heavy, ~1/10 the tokens).
 //
 //     BUILD on the seats you already pay for.
 //     REVIEW on the metered one, because reviewing is cheap.
 //
 // Which lands Grok exactly where it's most valuable anyway. Its worth was never being
 // the strongest coder — it isn't. It's being a DIFFERENT MIND that catches what Claude
 // and GPT both miss. And that job costs pennies.
 [seats.grok]
 provider = "xai"
 model = "grok-4.5"                          // NOT grok-build-0.1 (legacy, weak)
-tier = "subscription"                       // $30 SuperGrok, primary
-family = "grok"
+tier = "metered"                            // the runner calls the paid API with a key;
+family = "grok"                             // the SuperGrok sub covers the app, NOT this
 
-// OFF UNTIL THE LEAKED xAI KEY IS ROTATED (owner task). Turned off rather than left on
-// and failing: an enabled seat with no working key is counted as a panel member that
-// can never report, which parks every job forever and looks like a bug. The panel is
-// claude + gpt today — two families, which meets the floor. Flip this back the day the
-// key is rotated and grok is a third mind again.
+// Was OFF while the leaked xAI key was unrotated. Key rotated 2026-07-21; the runner
+// landed 2026-08-27 and the seat came back on the same day — a third mind on the panel.
+// If it must be turned off again, turn it OFF here rather than leaving it failing: an
+// enabled seat with no working key is a panel member that can never report. (A missing
+// key now excludes the seat at the door instead — see gauntlet.has_runner.)
 //
 // Owner decision, 2026-07-21: GROK DOES NOT TOUCH THE ARCH MEDICAL-RECORDS REPO. That
 // repo is out of scope entirely (Decision C); this line records the standing rule.
-disabled = true
+disabled = false
 worktree_isolated = true
 daily_cap_cents  = 100                      // $1/day = ~$30/mo HARD CEILING
