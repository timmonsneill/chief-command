    61	
    62	def _commit_in_worktree(wt: Path, job_id: int, branch: str, summary: str) -> str | None:
    63	    """Commit the job's output on its own branch and return the commit id.
    64	
    65	    This is what makes the gatekeeper's merge possible at all: it refuses unless the
    66	    branch tip IS the reviewed version, and a version has to be a commit for that to be
    67	    provable. If anything here fails, the caller falls back to a content hash — the job
    68	    is still reviewable, it just can never be merged by the gatekeeper, which is the
    69	    honest outcome for work that isn't in git.
    70	    """
    71	    env = {**os.environ,
    72	           "GIT_AUTHOR_NAME": "chief-worker", "GIT_AUTHOR_EMAIL": "worker@chief.local",
    73	           "GIT_COMMITTER_NAME": "chief-worker", "GIT_COMMITTER_EMAIL": "worker@chief.local"}
    74	    def git(*args):
    75	        return subprocess.run(["git", *args], cwd=wt, capture_output=True, text=True,
    76	                              timeout=60, env=env)
    77	    try:
    78	        if git("rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
    79	            return None
    80	        if git("checkout", "-B", branch).returncode != 0:
    81	            return None
    82	        if git("add", "-A", OUTPUT_DIRNAME).returncode != 0:
    83	            return None
    84	        if git("commit", "-q", "-m", f"job {job_id}: {summary[:60]}").returncode != 0:
    85	            return None
    86	        sha = git("rev-parse", "HEAD").stdout.strip()
    87	    except (subprocess.TimeoutExpired, OSError):
    88	        return None          # a hung git is "not in git", not a dead worker thread
    89	    return sha[:16] if len(sha) >= 16 else None
    90	
    91	
    92	def _version_of(text: str) -> str:
    93	    """The exact content being put forward, as a short hash. This is what the whole
    94	    review-to-version chain binds to: change the output, change the version, and every
    95	    earlier approval silently stops counting (schema.sql, gate 3)."""
    96	    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]
    97	
    98	
    99	# ---------------------------------------------------------------------------
   100	# Worktree isolation — a builder never touches the live project.
   101	# ---------------------------------------------------------------------------
   102	def _make_worktree(job_id: int, branch: str) -> tuple[Path | None, str]:
   103	    """Give this job its own private copy of the repo. Returns (path, note).
   104	
   105	    If git worktrees aren't usable for any reason, fall back to a plain isolated
   106	    directory and SAY SO — a silent fallback that quietly drops isolation would be
   107	    exactly the kind of unspoken gap this project keeps getting bitten by.
   108	    """
   109	    WORKTREES.mkdir(exist_ok=True)
   110	    dest = WORKTREES / f"job-{job_id}"
   111	    if dest.exists():
   112	        return dest, "reused"
   113	    try:
   114	        subprocess.run(
   115	            ["git", "worktree", "add", "--detach", str(dest)],
   116	            cwd=HARNESS.parent, capture_output=True, text=True, timeout=60, check=True,
   117	        )
   118	        return dest, "worktree"
   119	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   120	        # Isolation still holds (separate dir, outside the repo tree) — it just isn't a
   121	        # git worktree, so we record that honestly.
   122	        dest.mkdir(parents=True, exist_ok=True)
   123	        detail = getattr(exc, "stderr", "") or str(exc)
   124	        return dest, f"plain-dir ({str(detail)[:60].strip()})"
   125	
   126	
   127	def cleanup_worktree(job_id: int) -> None:
   128	    """Remove a job's worktree once its work is merged or abandoned."""
   129	    dest = WORKTREES / f"job-{job_id}"
   130	    if not dest.exists():
   131	        return
   132	    subprocess.run(["git", "worktree", "remove", "--force", str(dest)],
   133	                   cwd=HARNESS.parent, capture_output=True, text=True)
   134	    if dest.exists():
   135	        subprocess.run(["rm", "-rf", str(dest)], capture_output=True, text=True)
   136	
   137	
   138	# ---------------------------------------------------------------------------
   139	# The actual builders, one per provider. Add a provider = add a function.
   140	# ---------------------------------------------------------------------------
   141	def _ollama_build(seat_row, request: str, model: str) -> str:
   142	    """The free local coder actually writes the code."""
   143	    payload = json.dumps({"model": model, "prompt": request, "stream": False}).encode()
   144	    req = urllib.request.Request(
   145	        OLLAMA_URL, data=payload, headers={"Content-Type": "application/json"}
   146	    )
   147	    with urllib.request.urlopen(req, timeout=300) as r:
   148	        return json.loads(r.read())["response"].strip()
   149	
   150	
   151	_BUILDERS = {
   152	    "ollama": _ollama_build,
   153	}
   154	
   155	
   156	# Reviewing lives in gauntlet.py (task #10). This module builds; that one judges.
   157	# It used to hold a single hard-wired Claude reviewer, which was enough to close the
   158	# loop and was never the design — one reviewer cannot show that a DIFFERENT MIND looked.
   159	
   160	
   161	# ---------------------------------------------------------------------------
   162	# The run loop — everything above, in order, for one job.
   163	# ---------------------------------------------------------------------------
   164	def run_job(job_id: int, *, cfg: dict[str, Any] | None = None) -> dict[str, Any]:
   165	    """Take one recorded job and actually do it. Safe to call in a thread.
   166	
   167	    Opens its own database connection (sqlite + threads). WAL mode lets this write
   168	    while the web server reads. Never raises to the caller — a worker that dies must
   169	    leave a legible 'failed' row, not a stack trace nobody sees.
   170	    """
   171	    conn = connect(DB_PATH)
   172	    try:
   173	        job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   174	        if job is None:
   175	            return {"job_id": job_id, "status": "missing"}
   176	        seat_row = seat(conn, job["builder_seat"])
   177	        if seat_row is None:
   178	            set_status(conn, job_id, "failed", error=f"unknown seat {job['builder_seat']}")
   179	            return {"job_id": job_id, "status": "failed"}
   180	
   181	        builder = _BUILDERS.get(seat_row["provider"])
   182	        if builder is None:
   183	            # A provider we don't have a local runner for (codex/xai/claude-cli builds
   184	            # go through OpenClaw, not this in-process worker). Say so plainly.
   185	            set_status(conn, job_id, "failed",
   186	                       error=f"no in-process builder for provider '{seat_row['provider']}' "
   187	                             "— this seat dispatches through OpenClaw")
   188	            _event(conn, job_id, seat_row, "error",
   189	                   "This worker only runs the local model directly.")
   190	            return {"job_id": job_id, "status": "failed"}
   191	
   192	        # 1. Isolate.
   193	        wt, wt_note = _make_worktree(job_id, job["branch"] or f"job/{job_id}")
   194	        conn.execute("UPDATE jobs SET worktree = ? WHERE id = ?", (str(wt), job_id))
   195	        _event(conn, job_id, seat_row, "dispatched", f"Working in its own copy ({wt_note}).")
   196	
   197	        # 2. Build.
   198	        model = job["tier"] and _model_for(seat_row, job["tier"]) or seat_row["model"]
   199	        _event(conn, job_id, seat_row, "thinking", "Working out how to do it.")
   200	        try:
   201	            result = builder(seat_row, job["request"], model)
   202	        except Exception as exc:  # network, model, timeout — all land here
   203	            set_status(conn, job_id, "failed", error=f"builder error: {exc}")
   204	            _event(conn, job_id, seat_row, "error", "The worker hit a problem.")
   205	            return {"job_id": job_id, "status": "failed"}
   206	
   207	        # 3. Land the output in the isolated copy, and version it.
   208	        out_dir = wt / OUTPUT_DIRNAME
   209	        out_dir.mkdir(parents=True, exist_ok=True)
   210	        (out_dir / f"job_{job_id}.txt").write_text(result)
   211	        branch = job["branch"] or f"job/{job_id}"
   212	        version = _commit_in_worktree(wt, job_id, branch, job["request"]) or _version_of(result)
   213	        set_head_version(conn, job_id, version)
   214	        _event(conn, job_id, seat_row, "write",
   215	               f"Wrote {len(result)} characters of work.", target=str(out_dir))
   216	
   217	        # 4. Park for review. The guards will hold it here until a real reviewer passes
   218	        #    THIS version — we never force it past them.
   219	        set_status(conn, job_id, "review", result=result)
   220	
   221	        # 5. Hand the frozen bundle to the review panel — several families at once,
   222	        #    all bound to THIS version. The panel decides nothing the database wouldn't;
   223	        #    it produces the verdicts the guards ask for. Without a config there is no
   224	        #    panel, and the job simply stays parked (the safe outcome, not a shortcut).
   225	        if cfg is not None:
   226	            import gauntlet
   227	            gauntlet.run_panel(conn, job_id, job["request"], result, version, cfg,
   228	                               db_path=DB_PATH)
   229	
   230	        final = conn.execute("SELECT status FROM jobs WHERE id = ?", (job_id,)).fetchone()["status"]
   231	        return {"job_id": job_id, "status": final, "version": version}
   232	    finally:
   233	        conn.close()
   234	
   235	

