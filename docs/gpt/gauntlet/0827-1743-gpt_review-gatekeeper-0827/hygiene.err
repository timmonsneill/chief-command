     """Ollama reviewing Ollama is not a review. Two juniors are not a senior."""
     upsert_seat(conn, Seat("grinder2", "ollama", "qwen2.5-coder:7b", "qwen", "local"))
     job = create_job(conn, "write the tests", builder_seat="grinder")
