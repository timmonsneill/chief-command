     1	"""Durable job store for the Chief Command v2 harness.
     2	
     3	OpenClaw dispatches the work; this records it. Its subagent sessions auto-archive
     4	after ~60 minutes, so anything we want to answer later ("what did the overnight run
     5	do?", spec §7) has to live here.
     6	
     7	The two rules that must never quietly stop holding are enforced in schema.sql as
     8	triggers, not here — see guard_local_output_needs_review and
     9	guard_unresolved_escalation. This module will simply raise if you try to violate them.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import sqlite3
    15	from dataclasses import dataclass
    16	from pathlib import Path
    17	from typing import Any, Iterable, Optional
    18	
    19	DB_PATH = Path(__file__).resolve().parent / "chief.db"
    20	SCHEMA_PATH = Path(__file__).resolve().parent / "schema.sql"
    21	
    22	# Raised by the schema triggers. We surface it as something catchable.
    23	class GuardViolation(RuntimeError):
    24	    """A structural rule was violated (e.g. shipping unreviewed local output)."""
    25	
    26	
    27	@dataclass(frozen=True)
    28	class Seat:
    29	    id: str
    30	    provider: str
    31	    model: str
    32	    family: str  # gpt | claude | grok | qwen — what determines shared blind spots
    33	    tier: str  # local | subscription | metered
    34	    daily_cap_cents: Optional[int] = None   # hard ceiling across everything
    35	    build_cap_cents: Optional[int] = None   # ration the EXPENSIVE work
    36	    review_cap_cents: Optional[int] = None  # reviewing is cheap — be generous
    37	    # Three models per seat. NOTHING gets `heavy` by default — it has to be earned.
    38	    # Rate limits, not money, are the binding constraint on autonomous work, and you
    39	    # cannot buy your way out of a weekly cap.
    40	    model_light: Optional[str] = None
    41	    model_standard: Optional[str] = None
    42	    model_heavy: Optional[str] = None
    43	    enabled: bool = True
    44	    notes: str = ""
    45	
    46	
    47	def connect(db_path: Path | str = DB_PATH) -> sqlite3.Connection:
    48	    # timeout is stated rather than inherited from the stdlib default: the review panel
    49	    # writes verdicts from several threads at once, and how long a writer waits for the
    50	    # lock before giving up is a real property of this system, not a detail to leave to
    51	    # whatever the standard library happens to pick.
    52	    conn = sqlite3.connect(db_path, isolation_level=None,  # autocommit; we manage txns
    53	                           timeout=15.0)
    54	    conn.row_factory = sqlite3.Row
    55	    conn.execute("PRAGMA foreign_keys = ON")
    56	    conn.execute("PRAGMA busy_timeout = 15000")
    57	    return conn
    58	
    59	
    60	def init_db(conn: sqlite3.Connection) -> None:
    61	    """Build the schema on a FRESH database only.
    62	
    63	    This used to run schema.sql on EVERY call — including server startup against the LIVE
    64	    DB. That made editing schema.sql a silent live deploy: a new `CREATE TRIGGER IF NOT
    65	    EXISTS` installs on the next restart while `CREATE TABLE IF NOT EXISTS` stays a no-op,
    66	    so a trigger can land WITHOUT the column it references and jam every status change (it
    67	    did, 2026-07-20). An existing DB now advances ONLY through the numbered migrations in
    68	    db/migrations/, applied deliberately — never as a side effect of a restart.
    69	    """
    70	    initialized = conn.execute(
    71	        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'jobs'"
    72	    ).fetchone()
    73	    if initialized:
    74	        return
    75	    conn.executescript(SCHEMA_PATH.read_text())
    76	
    77	
    78	def _guarded(fn):
    79	    """Translate the schema's RAISE(ABORT, 'guard: ...') into GuardViolation."""
    80	
    81	    def wrapper(*args, **kwargs):
    82	        try:
    83	            return fn(*args, **kwargs)
    84	        except sqlite3.IntegrityError as exc:
    85	            if "guard:" in str(exc):
    86	                raise GuardViolation(str(exc)) from exc
    87	            raise
    88	
    89	    return wrapper
    90	
    91	
    92	# --------------------------------------------------------------------------
    93	# Seats
    94	# --------------------------------------------------------------------------
    95	def upsert_seat(conn: sqlite3.Connection, seat: Seat) -> None:
    96	    conn.execute(
    97	        """
    98	        INSERT INTO seats (id, provider, model, family, tier, daily_cap_cents,
    99	                           build_cap_cents, review_cap_cents,
   100	                           model_light, model_standard, model_heavy, enabled, notes)
   101	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
   102	        ON CONFLICT(id) DO UPDATE SET
   103	            provider = excluded.provider,
   104	            model = excluded.model,
   105	            family = excluded.family,
   106	            tier = excluded.tier,
   107	            daily_cap_cents = excluded.daily_cap_cents,
   108	            build_cap_cents = excluded.build_cap_cents,
   109	            review_cap_cents = excluded.review_cap_cents,
   110	            model_light = excluded.model_light,
   111	            model_standard = excluded.model_standard,
   112	            model_heavy = excluded.model_heavy,
   113	            enabled = excluded.enabled,
   114	            notes = excluded.notes
   115	        """,
   116	        (seat.id, seat.provider, seat.model, seat.family, seat.tier,
   117	         seat.daily_cap_cents, seat.build_cap_cents, seat.review_cap_cents,
   118	         seat.model_light, seat.model_standard, seat.model_heavy,
   119	         int(seat.enabled), seat.notes),
   120	    )
   121	
   122	
   123	def seat(conn: sqlite3.Connection, seat_id: str) -> sqlite3.Row | None:
   124	    return conn.execute("SELECT * FROM seats WHERE id = ?", (seat_id,)).fetchone()
   125	
   126	
   127	# --------------------------------------------------------------------------
   128	# Jobs
   129	# --------------------------------------------------------------------------
   130	def create_job(
   131	    conn: sqlite3.Connection,
   132	    request: str,
   133	    builder_seat: str,
   134	    origin: str = "text",
   135	    parent_job_id: Optional[int] = None,
   136	    task_name: Optional[str] = None,
   137	) -> int:
   138	    """task_name is the 2-4 word handle the voice will use ("the rate limiter").
   139	
   140	    The mouth coins it at dispatch. Without one the voice falls back to truncating
   141	    the request, which reads back the owner's own paragraph at him — exactly what a
   142	    colleague would never do.
   143	    """
   144	    row = seat(conn, builder_seat)
   145	    if row is None:
   146	        raise ValueError(f"unknown builder seat: {builder_seat}")
   147	
   148	    # Snapshot who built this, AT BUILD TIME. Sol's cross-family review found that
   149	    # reading the builder's tier live meant re-tiering a local seat retroactively
   150	    # legitimized its old unreviewed work. What a seat is today cannot change what
   151	    # it was. The schema then freezes these columns.
   152	    cur = conn.execute(
   153	        """
   154	        INSERT INTO jobs (request, builder_seat, builder_tier, builder_family,
   155	                          origin, parent_job_id, task_name)
   156	        VALUES (?, ?, ?, ?, ?, ?, ?)
   157	        """,
   158	        (request, builder_seat, row["tier"], row["family"],
   159	         origin, parent_job_id, task_name),
   160	    )
   161	    return int(cur.lastrowid)
   162	
   163	
   164	def claim_next_job(conn: sqlite3.Connection, builder_seat: str) -> sqlite3.Row | None:
   165	    """Atomically claim the oldest queued job for this seat.
   166	
   167	    Uses UPDATE...RETURNING against a subquery so two workers racing for the same
   168	    row cannot both win — SQLite serializes the write and only one claim lands.
   169	    Cribbed from clu's approach; it removes the need for any external lock.
   170	    """
   171	    row = conn.execute(
   172	        """
   173	        UPDATE jobs
   174	           SET status = 'in_progress',
   175	               started_at = datetime('now'),
   176	               attempts = attempts + 1
   177	         WHERE id = (
   178	             SELECT id FROM jobs
   179	              WHERE status = 'todo' AND builder_seat = ?
   180	              ORDER BY id
   181	              LIMIT 1
   182	         )
   183	        RETURNING *
   184	        """,
   185	        (builder_seat,),
   186	    ).fetchone()
   187	    return row
   188	
   189	
   190	def attach_run(
   191	    conn: sqlite3.Connection,
   192	    job_id: int,
   193	    run_id: str,
   194	    session_key: str | None = None,
   195	    branch: str | None = None,
   196	    worktree: str | None = None,
   197	) -> None:
   198	    """Record the OpenClaw spawn that is actually doing the work."""
   199	    conn.execute(
   200	        """
   201	        UPDATE jobs SET run_id = ?, session_key = ?, branch = ?, worktree = ?
   202	         WHERE id = ?
   203	        """,
   204	        (run_id, session_key, branch, worktree, job_id),
   205	    )
   206	
   207	
   208	@_guarded
   209	def set_head_version(conn: sqlite3.Connection, job_id: int, version: str) -> None:
   210	    """Record the exact version (git commit id) the builder is putting forward.
   211	
   212	    This is the pivot of the review-to-version chain: every completion guard only
   213	    counts verdicts whose reviewed_version matches this. Calling it again after the
   214	    builder iterates voids all earlier approvals by construction — nothing needs to
   215	    remember to revoke them. Frozen by the schema once the job is done.
   216	    """
   217	    if not version or not version.strip():
   218	        raise ValueError("a version must actually name a version")
   219	    conn.execute(
   220	        "UPDATE jobs SET head_version = ? WHERE id = ?", (version.strip(), job_id)
   221	    )
   222	
   223	
   224	@_guarded
   225	def set_status(
   226	    conn: sqlite3.Connection,
   227	    job_id: int,
   228	    status: str,
   229	    result: str | None = None,
   230	    error: str | None = None,
   231	    spoken_summary: str | None = None,
   232	) -> None:
   233	    """Move a job's status.
   234	
   235	    Moving to 'done' runs the schema guards. If the builder was a local seat and no
   236	    higher-tier reviewer has passed it, this raises GuardViolation — by design.
   237	    """
   238	    finished = status in ("done", "failed", "cancelled")
   239	    conn.execute(
   240	        """
   241	        UPDATE jobs
   242	           SET status = ?,
   243	               result = COALESCE(?, result),
   244	               error = COALESCE(?, error),
   245	               spoken_summary = COALESCE(?, spoken_summary),
   246	               finished_at = CASE WHEN ? THEN datetime('now') ELSE finished_at END
   247	         WHERE id = ?
   248	        """,
   249	        (status, result, error, spoken_summary, int(finished), job_id),
   250	    )
   251	
   252	
   253	def record_artifact(
   254	    conn: sqlite3.Connection,
   255	    job_id: int,
   256	    kind: str,
   257	    path: str | None = None,
   258	    value: str | None = None,
   259	    flow: str | None = None,
   260	    captured_by: str = "playwright",
   261	) -> int:
   262	    """Record GROUND TRUTH.
   263	
   264	    Two kinds, and they have different rules about who may write them:
   265	
   266	    EVIDENCE OF A BUILD (screenshot, trace, logs, exit codes) — only the harness or
   267	    Playwright. NEVER a model. A model cannot fabricate a screenshot, which is what
   268	    makes "I ran it and it worked" unsayable.
   269	
   270	    EVIDENCE OF A CLAIM (source, quote) — a model MAY write these, because a
   271	    researcher's whole job is to hand you a URL you can go and read yourself. The
   272	    check isn't "who wrote it down", it's "can someone else go and look?" — which is
   273	    why a different family has to read the sources cold (guard 8).
   274	    """
   275	    _MODEL_MAY_CITE = {"source", "quote"}
   276	    if captured_by == "model" and kind not in _MODEL_MAY_CITE:
   277	        raise ValueError(
   278	            f"a model may cite a source, but it may not produce a '{kind}' — "
   279	            "build evidence is captured by the harness, never claimed by a model"
   280	        )
   281	    if captured_by not in ("harness", "playwright", "model"):
   282	        raise ValueError(f"unknown artifact origin: {captured_by}")
   283	    cur = conn.execute(
   284	        """
   285	        INSERT INTO artifacts (job_id, kind, path, value, flow, captured_by)
   286	        VALUES (?, ?, ?, ?, ?, ?)
   287	        """,
   288	        (job_id, kind, path, value, flow, captured_by),
   289	    )
   290	    return int(cur.lastrowid)
   291	
   292	
   293	@_guarded
   294	def record_verdict(
   295	    conn: sqlite3.Connection,
   296	    job_id: int,
   297	    reviewer_seat: str,
   298	    verdict: str,
   299	    severity: str | None = None,
   300	    summary: str | None = None,
   301	    detail: str | None = None,
   302	    role: str = "reviewer",
   303	    reviewed_version: str | None = None,
   304	) -> int:
   305	    """Record one seat's verdict.
   306	
   307	    role='reviewer' reads the diff and judges it.
   308	    role='tester'   drove the app (Playwright) and judges what it observed. Two guards
   309	                    apply: it must cite captured artifacts, and its family must differ
   310	                    from the builder's — Playwright stops a tester fabricating what
   311	                    happened; only a different mind stops it rationalizing it.
   312	
   313	    reviewed_version is WHAT the reviewer looked at. The gauntlet runner pins the
   314	    version before handing work to a reviewer and must pass it explicitly. When
   315	    omitted, it defaults to the job's current head_version — correct only when
   316	    nothing moved between review and recording, which the runner must guarantee.
   317	    A verdict whose version stops matching the job simply stops counting.
   318	
   319	    tier and family are snapshotted from the seat at write time, so re-tiering or
   320	    re-pointing a seat later cannot retroactively legitimize a job.
   321	    """
   322	    row = seat(conn, reviewer_seat)
   323	    if row is None:
   324	        raise ValueError(f"unknown seat: {reviewer_seat}")
   325	
   326	    if reviewed_version is None:
   327	        job_row = conn.execute(
   328	            "SELECT head_version FROM jobs WHERE id = ?", (job_id,)
   329	        ).fetchone()
   330	        if job_row is not None:
   331	            reviewed_version = job_row["head_version"]
   332	
   333	    cur = conn.execute(
   334	        """
   335	        INSERT INTO verdicts
   336	            (job_id, reviewer_seat, reviewer_tier, role, model_family,
   337	             verdict, severity, summary, detail, reviewed_version)
   338	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
   339	        """,
   340	        (job_id, reviewer_seat, row["tier"], role, row["family"],
   341	         verdict, severity, summary, detail, reviewed_version),
   342	    )
   343	    return int(cur.lastrowid)
   344	
   345	
   346	def resolve_escalation(conn: sqlite3.Connection, verdict_id: int, verdict: str) -> None:
   347	    """Answer a needs_human verdict so the job can proceed (§6 human review queue)."""
   348	    if verdict not in ("pass", "fail"):
   349	        raise ValueError("an escalation resolves to 'pass' or 'fail'")
   350	    conn.execute("UPDATE verdicts SET verdict = ? WHERE id = ?", (verdict, verdict_id))
   351	
   352	
   353	# --------------------------------------------------------------------------
   354	# Reporting — this is what the voice layer reads back
   355	# --------------------------------------------------------------------------
   356	def overnight_report(conn: sqlite3.Connection, since: str = "-1 day") -> list[sqlite3.Row]:
   357	    """Answers spec §7's 'what did the overnight run do?'"""
   358	    return conn.execute(
   359	        """
   360	        SELECT * FROM job_report
   361	         WHERE created_at >= datetime('now', ?)
   362	         ORDER BY id
   363	        """,
   364	        (since,),
   365	    ).fetchall()
   366	
   367	
   368	def spend_today(conn: sqlite3.Connection, seat_id: str) -> int:
   369	    row = conn.execute(
   370	        "SELECT COALESCE(SUM(cost_cents), 0) AS c FROM usage WHERE seat_id = ? AND day = date('now')",
   371	        (seat_id,),
   372	    ).fetchone()
   373	    return int(row["c"])
   374	
   375	
   376	def over_budget(conn: sqlite3.Connection, seat_id: str) -> bool:
   377	    """True if this seat has hit its daily cap.
   378	
   379	    OpenClaw has no per-agent budget of any kind, so the harness must check this
   380	    before dispatching. Uncapped seats (daily_cap_cents IS NULL) never block.
   381	    """
   382	    row = seat(conn, seat_id)
   383	    if row is None or row["daily_cap_cents"] is None:
   384	        return False
   385	    return spend_today(conn, seat_id) >= int(row["daily_cap_cents"])
   386	
   387	
   388	@_guarded
   389	def record_usage(
   390	    conn: sqlite3.Connection,
   391	    seat_id: str,
   392	    cost_cents: int,
   393	    job_id: int | None = None,
   394	    input_tokens: int = 0,
   395	    output_tokens: int = 0,
   396	    role: str = "build",
   397	) -> None:
   398	    """Record spend. The DATABASE refuses an entry that would breach the daily cap.
   399	
   400	    This used to be a Python check before dispatch — which Sol correctly called a
   401	    race (two dispatches both pass the check before either records spend) and easily
   402	    bypassed by any direct write. The ledger itself now says no.
   403	    """
   404	    conn.execute(
   405	        """
   406	        INSERT INTO usage (seat_id, job_id, role, input_tokens, output_tokens, cost_cents)
   407	        VALUES (?, ?, ?, ?, ?, ?)
   408	        """,
   409	        (seat_id, job_id, role, input_tokens, output_tokens, cost_cents),
   410	    )
   411	
   412	
   413	def can_build(conn: sqlite3.Connection, seat_id: str) -> bool:
   414	    """Has this seat used up its BUILDING budget? (It may still be able to review.)"""
   415	    row = seat(conn, seat_id)
   416	    if row is None or row["build_cap_cents"] is None:
   417	        return True
   418	    spent = conn.execute(
   419	        "SELECT COALESCE(SUM(cost_cents),0) c FROM usage "
   420	        "WHERE seat_id=? AND day=date('now') AND role='build'", (seat_id,)
     1	-- Chief Command v2 — harness job store
     2	--
     3	-- This is the layer OpenClaw does NOT give us. Its subagent sessions auto-archive
     4	-- after ~60 minutes and get soft-deleted; that is session archival, not durable job
     5	-- history. Spec §7 wants "what did the overnight run do?" to be answerable. This is that.
     6	--
     7	-- Two rules are enforced STRUCTURALLY here rather than in a prompt, because rules that
     8	-- live in prompts quietly stop holding at 4am:
     9	--   1. Local-model output can never reach `done` without a higher-tier passing review
    10	--      (spec §4.3 / §9 — "enforce in the pipeline itself, not by convention").
    11	--   2. Per-seat spend caps (OpenClaw core has no per-agent budget of any kind).
    12	
    13	PRAGMA journal_mode = WAL;
    14	PRAGMA foreign_keys = ON;
    15	
    16	-- ---------------------------------------------------------------------------
    17	-- Seats: the named roles from spec §4. Providers are swappable behind these.
    18	-- ---------------------------------------------------------------------------
    19	CREATE TABLE IF NOT EXISTS seats (
    20	    id            TEXT PRIMARY KEY,          -- 'brain' | 'workhorse' | 'grinder_local' | 'reviewer' | 'tester' | 'mouth'
    21	    provider      TEXT NOT NULL,             -- 'codex' | 'xai' | 'ollama' | 'claude-cli' | ...
    22	    model         TEXT NOT NULL,
    23	    -- Model FAMILY, not provider. Two seats can share a family via different providers
    24	    -- (e.g. claude-cli and an Anthropic API key are both 'claude'). The gauntlet's
    25	    -- diversity rule and the no-self-testing guard both key off this, so it must be
    26	    -- the thing that actually determines shared blind spots.
    27	    family        TEXT NOT NULL,             -- 'gpt' | 'claude' | 'grok' | 'qwen'
    28	    -- tier drives the review guard below. 'local' output is never trusted on its own.
    29	    tier          TEXT NOT NULL CHECK (tier IN ('local', 'subscription', 'metered')),
    30	    -- ═══════════════════════════════════════════════════════════════════════
    31	    -- MODEL TIERS. Owner (2026-07-14):
    32	    --     "If we do highest model every time for every build, on autonomous work,
    33	    --      Claude and ChatGPT are gonna bottom out. I need us to build in model
    34	    --      tiering as well."
    35	    --
    36	    -- He's right, and it's the difference between a system that runs for a month and
    37	    -- one that dies on Thursday. Rate limits are the binding constraint on autonomous
    38	    -- work — NOT money (Claude and OpenAI are flat-rate). You cannot buy your way out
    39	    -- of a weekly cap. You can only spend it wisely.
    40	    --
    41	    -- So every seat carries THREE models, and the harness picks by what the work
    42	    -- actually deserves:
    43	    --
    44	    --   light     the cheap one. Boilerplate, scaffolding, small fixes, quick answers.
    45	    --   standard  the default. Most real work.
    46	    --   heavy     the top of the line. Reserved, and it has to be EARNED.
    47	    --
    48	    -- Nothing gets `heavy` by default. It's earned by: an explicit ask ("think hard"),
    49	    -- a risky area (auth, money, data), a repeat failure, or a major decision. See
    50	    -- tiering.py — the whole point is that the escalation is a rule, not a vibe.
    51	    -- ═══════════════════════════════════════════════════════════════════════
    52	    model_light    TEXT,     -- e.g. claude-haiku / gpt-5.6-luna
    53	    model_standard TEXT,     -- e.g. claude-sonnet / gpt-5.6-terra
    54	    model_heavy    TEXT,     -- e.g. claude-opus / gpt-5.6-sol  (EARNED, never default)
    55	    effort_light    TEXT DEFAULT 'low',
    56	    effort_standard TEXT DEFAULT 'medium',
    57	    effort_heavy    TEXT DEFAULT 'high',
    58	
    59	    -- CAPS ARE PER-ROLE, not just per-seat. Owner's call (2026-07-13):
    60	    --     "it can review as much as it wants more or less, but shouldn't build as
    61	    --      much as claude and chat"
    62	    --
    63	    -- The economics say the same thing. Claude and OpenAI are FLAT-RATE — a build on
    64	    -- those seats costs nothing marginal, it's already paid for. Grok is METERED, so
    65	    -- every build is real money. And builds are the expensive kind of work (token-heavy)
    66	    -- while reviews are cheap (read-heavy, ~1/10 the tokens).
    67	    --
    68	    -- So: BUILD on the seats you've already bought. REVIEW on the metered one, because
    69	    -- reviewing is cheap — and reviewing is what Grok is actually best at anyway. Its
    70	    -- value was never being the strongest coder. It's being a DIFFERENT MIND.
    71	    --
    72	    -- NULL = uncapped.
    73	    daily_cap_cents        INTEGER,   -- total across all roles (the hard ceiling)
    74	    build_cap_cents        INTEGER,   -- ration the expensive work
    75	    review_cap_cents       INTEGER,   -- reviewing is cheap; be generous
    76	    enabled       INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0, 1)),
    77	    notes         TEXT
    78	);
    79	
    80	-- ---------------------------------------------------------------------------
    81	-- Projects: the top-level thing work belongs to. Each has its OWN memory.
    82	--
    83	-- Owner: "ability to see a projects tab and each project has its own memory,
    84	-- timeline/planning."
    85	--
    86	-- This matters more than it looks. Memory that isn't scoped to a project leaks:
    87	-- lessons from the EMR bleed into the harness, conventions from one codebase get
    88	-- applied to another. Chief already keeps per-AGENT memory; this is per-PROJECT,
    89	-- and the two are different axes. Riggs knows how HE works; the project knows how
    90	-- IT works.
    91	-- ---------------------------------------------------------------------------
    92	CREATE TABLE IF NOT EXISTS projects (
    93	    id            TEXT PRIMARY KEY,          -- 'chief', 'arch', 'jess'
    94	    name          TEXT NOT NULL,
    95	    repo_path     TEXT,
    96	    description   TEXT,
    97	    -- Where this project's own memory lives. Loaded into context for any job on it.
    98	    memory_dir    TEXT,
    99	    color         TEXT,                      -- the UI reads this
   100	    archived      INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0,1)),
   101	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   102	);
   103	
   104	-- The REAL projects, seeded so Chief knows them on ANY machine (a fresh DB or the Mac
   105	-- Studio), not just wherever a row happened to be typed. Without this, `projects` is
   106	-- empty on a new box and Chief goes back to improvising what Neill is working on — the
   107	-- exact bug this seed exists to kill. OR IGNORE so it never clobbers live edits.
   108	--
   109	-- repo_path: Arch is deliberately NULL. Chief may read Arch's NOTES (memory), but the
   110	-- fleet must never be pointed at its code or its patient data (Decision C, PHI). Dispatch
   111	-- does not route by repo_path today; if it ever learns to, THAT is where the guard goes.
   112	--
   113	-- memory_dir is NOT seeded here on purpose: it's the one genuinely machine-specific value
   114	-- (where this box keeps the project's notes), so it's set as local config per machine —
   115	-- keeping this file hardware-agnostic (rule 4).
   116	INSERT OR IGNORE INTO projects (id, name, repo_path, description, color) VALUES
   117	  ('chief', 'Chief Command', '~/code-projects/chief-command',
   118	   'The thing you talk to. This.', '#2E9BFF'),
   119	  ('jess', 'Jess', '~/code-projects/personal-assist',
   120	   'Personal assistant. Connects to Chief over the tailnet later.', '#A78BFA'),
   121	  ('arch', 'Arch (Arch to Freedom EMR)', NULL,
   122	   'The records system for the addiction-recovery facility — staff, beds, roles, approvals, the voice assistant Archie. Voice-first. Held at arm''s length here on purpose: Chief can read its notes but the fleet does not touch its code or its patient data.',
   123	   '#22c55e');
   124	
   125	-- Project memory: facts that belong to the PROJECT, not to an agent and not to a job.
   126	-- "The API returns snake_case." "Never touch the billing table directly."
   127	CREATE TABLE IF NOT EXISTS project_memory (
   128	    id            INTEGER PRIMARY KEY,
   129	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
   130	    kind          TEXT NOT NULL DEFAULT 'lesson'
   131	                  CHECK (kind IN ('lesson', 'convention', 'constraint', 'decision', 'gotcha')),
   132	    fact          TEXT NOT NULL,
   133	    -- Where it came from, so a wrong lesson can be traced and killed.
   134	    learned_from  INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   135	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   136	);
   137	
   138	CREATE INDEX IF NOT EXISTS idx_pmem_project ON project_memory(project_id);
   139	
   140	-- The plan. What's coming, in order. This is the timeline the UI draws.
   141	CREATE TABLE IF NOT EXISTS plan_items (
   142	    id            INTEGER PRIMARY KEY,
   143	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
   144	    title         TEXT NOT NULL,
   145	    detail        TEXT,
   146	    phase         TEXT,                      -- 'phase 1', 'phase 2'…
   147	    status        TEXT NOT NULL DEFAULT 'planned'
   148	                  CHECK (status IN ('planned', 'active', 'blocked', 'done', 'dropped')),
   149	    blocked_on    TEXT,                      -- plain English. "waiting on Neill to log in"
   150	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   151	    position      INTEGER NOT NULL DEFAULT 0,
   152	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   153	);
   154	
   155	CREATE INDEX IF NOT EXISTS idx_plan_project ON plan_items(project_id, position);
   156	
   157	-- ---------------------------------------------------------------------------
   158	-- Todos: the checklist that belongs to a PROJECT, so it stops living in a
   159	-- terminal window and following nobody. Owner's annoyance, verbatim: "right now I
   160	-- have persistent todos that has to jump from window to window, which is annoying."
   161	--
   162	-- `owner_only` marks the items only Neill can do (rotate a key, flip a setting) —
   163	-- the ones the fleet must never quietly tick off on his behalf.
   164	-- ---------------------------------------------------------------------------
   165	CREATE TABLE IF NOT EXISTS todos (
   166	    id            INTEGER PRIMARY KEY,
   167	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
   168	    -- Sub-category WITHIN a project, so a project can hold several running lists
   169	    -- ("Security", "Build", "My tasks"). Owner: "ideally we can create a sub
   170	    -- category under each project as well." NULL / '' folds into a "General" list.
   171	    section       TEXT,
   172	    text          TEXT NOT NULL,
   173	    done          INTEGER NOT NULL DEFAULT 0 CHECK (done IN (0, 1)),
   174	    owner_only    INTEGER NOT NULL DEFAULT 0 CHECK (owner_only IN (0, 1)),
   175	    position      INTEGER NOT NULL DEFAULT 0,
   176	    created_at    TEXT NOT NULL DEFAULT (datetime('now')),
   177	    done_at       TEXT
   178	);
   179	
   180	CREATE INDEX IF NOT EXISTS idx_todos_project ON todos(project_id, section, position, id);
   181	
   182	-- ---------------------------------------------------------------------------
   183	-- Attachments: images and files Neill drops in — a screenshot of a bug, a mockup,
   184	-- a document — pinned to a project or a specific job. The bytes live on disk
   185	-- (gitignored); this row is how the UI finds them. captured_by is always the owner
   186	-- here; agent-produced evidence is the `artifacts` table, which has its own guards.
   187	-- ---------------------------------------------------------------------------
   188	CREATE TABLE IF NOT EXISTS attachments (
   189	    id            INTEGER PRIMARY KEY,
   190	    project_id    TEXT REFERENCES projects(id) ON DELETE SET NULL,
   191	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   192	    filename      TEXT NOT NULL,             -- the original name, for display
   193	    stored_path   TEXT NOT NULL,             -- where the bytes actually live
   194	    kind          TEXT NOT NULL CHECK (kind IN ('image', 'file')),
   195	    size_bytes    INTEGER,
   196	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   197	);
   198	
   199	CREATE INDEX IF NOT EXISTS idx_attachments_project ON attachments(project_id);
   200	CREATE INDEX IF NOT EXISTS idx_attachments_job ON attachments(job_id);
   201	
   202	-- ---------------------------------------------------------------------------
   203	-- Jobs: one row per dispatched unit of work. This is the audit trail.
   204	-- ---------------------------------------------------------------------------
   205	CREATE TABLE IF NOT EXISTS jobs (
   206	    id            INTEGER PRIMARY KEY,
   207	    created_at    TEXT NOT NULL DEFAULT (datetime('now')),
   208	    updated_at    TEXT NOT NULL DEFAULT (datetime('now')),
   209	    started_at    TEXT,
   210	    finished_at   TEXT,
   211	
   212	    request       TEXT NOT NULL,             -- what was asked, verbatim (§7)
   213	    -- A 2-4 word handle the mouth coins at dispatch: "the rate limiter".
   214	    -- The VOICE says this. The TEXT shows `request` in full. Echoing a man's own
   215	    -- paragraph back at him is not how a colleague talks.
   216	    task_name     TEXT,
   217	    origin        TEXT NOT NULL DEFAULT 'text'
   218	                  CHECK (origin IN ('text', 'voice', 'cron', 'relay')),  -- 'relay' = Jess (§10)
   219	
   220	    -- 'build'    → produces code. Ground truth = a screenshot (Playwright drove it).
   221	    -- 'research' → produces an ANSWER. Ground truth = a source (someone can go read it).
   222	    -- Same principle, different evidence. A researcher that can't cite is a researcher
   223	    -- that might be confabulating — and a confident wrong answer is worse than no answer,
   224	    -- because you act on it.
   225	    kind          TEXT NOT NULL DEFAULT 'build' CHECK (kind IN ('build', 'research')),
   226	
   227	    project_id    TEXT REFERENCES projects(id) ON DELETE SET NULL,
   228	
   229	    -- Which tier this job actually ran at, and WHY. The 'why' matters: if we're
   230	    -- burning heavy tier on boilerplate, this column is how we find out.
   231	    tier          TEXT NOT NULL DEFAULT 'standard'
   232	                  CHECK (tier IN ('light', 'standard', 'heavy')),
   233	    tier_reason   TEXT,
   234	
   235	    builder_seat  TEXT NOT NULL REFERENCES seats(id),
   236	    -- SNAPSHOTTED AT CREATION. Sol (cross-family review, 2026-07-13) found that
   237	    -- guards read the builder's tier/family LIVE from `seats`, so re-tiering a local
   238	    -- seat to 'subscription' retroactively legitimized its old unreviewed work.
   239	    -- Freeze it here. What a seat is TODAY cannot change what it WAS.
   240	    builder_tier   TEXT NOT NULL DEFAULT 'local'
   241	                   CHECK (builder_tier IN ('local','subscription','metered')),
   242	    builder_family TEXT NOT NULL DEFAULT 'unknown',
   243	    run_id        TEXT,                      -- OpenClaw sessions_spawn run id
   244	    session_key   TEXT,                      -- agent:<id>:subagent:<uuid>
   245	
   246	    -- Git as audit trail (§7). Worktree-per-job, main untouched until merged.
   247	    branch        TEXT,
   248	    worktree      TEXT,
   249	
   250	    -- THE VERSION UNDER REVIEW (Sol build gate 3, 2026-07-20). The exact content
   251	    -- hash the builder is putting forward — a git commit id. Reviews bind to this:
   252	    -- a verdict only counts toward completion while its reviewed_version matches.
   253	    -- The moment the builder changes the code, this changes, and every earlier
   254	    -- approval silently stops counting. Sol called the alternative the most
   255	    -- dangerous flaw in the system: "believable green checks on code nobody
   256	    -- reviewed." The gatekeeper's job at push time is to verify the code leaving
   257	    -- the building IS this hash — the DB proves the chain, git proves the content.
   258	    head_version  TEXT,
   259	
   260	    -- 'done'    = the gauntlet passed. The machine is satisfied.
   261	    -- 'shipped' = NEILL said it works on his device. Only he can move this.
   262	    -- These are NOT the same thing, and conflating them is how agents launder
   263	    -- confidence. From Chief's memory, learned the hard way:
   264	    --     "Chief must NEVER say 'shipped' unless Neill has confirmed it works on
   265	    --      his device. 'Shipped' is reserved for Neill-confirmed-working."
   266	    -- That rule now lives here instead of in a prompt.
   267	    status        TEXT NOT NULL DEFAULT 'todo'
   268	                  CHECK (status IN ('todo', 'in_progress', 'review', 'done',
   269	                                    'shipped', 'failed', 'cancelled')),
   270	    -- Set ONLY by the owner, through mark_shipped(). No agent has a path to this.
   271	    owner_confirmed_at TEXT,
   272	
   273	    -- How many passing reviews this job needs before it may complete. Set at
   274	    -- dispatch from the gauntlet config. Also from Chief's memory:
   275	    --     "Full set, always. No 'minimum,' no 'pick two,' no 'optional depending
   276	    --      on scope.'"
   277	    required_reviews INTEGER NOT NULL DEFAULT 0,
   278	
   279	    -- How many DISTINCT model families must have a passing review before done. This is
   280	    -- the floor "full set, always" doesn't itself guarantee: a full panel could still be
   281	    -- one family wearing three hats. Set at dispatch from the gauntlet's
   282	    -- min_model_families. Snapshotted and un-lowerable, like required_reviews. (task #10)
   283	    required_review_families INTEGER NOT NULL DEFAULT 0,
   284	
   285	    result        TEXT,                      -- final summary / diff ref
   286	    error         TEXT,
   287	
   288	    -- Voice wants a spoken-length answer; the text log keeps the detail (§5.3).
   289	    spoken_summary TEXT,
   290	
   291	    attempts      INTEGER NOT NULL DEFAULT 0,
   292	    parent_job_id INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   293	
   294	    -- DUPLICATE PROTECTION. A retry — a double-tap, a dropped connection, the voice
   295	    -- re-sending — must not start the same work twice. The caller stamps a key; a
   296	    -- second dispatch with the same key returns the existing job instead of spawning
   297	    -- a new one. NULL = no key given (nothing to dedupe against). The unique index
   298	    -- below lets many NULLs coexist but forbids two rows sharing a real key.
   299	    dispatch_key  TEXT
   300	);
   301	
   302	CREATE INDEX IF NOT EXISTS idx_jobs_status  ON jobs(status);
   303	CREATE INDEX IF NOT EXISTS idx_jobs_created ON jobs(created_at);
   304	CREATE INDEX IF NOT EXISTS idx_jobs_run     ON jobs(run_id);
   305	CREATE UNIQUE INDEX IF NOT EXISTS idx_jobs_dispatch_key ON jobs(dispatch_key)
   306	    WHERE dispatch_key IS NOT NULL;
   307	
   308	-- ---------------------------------------------------------------------------
   309	-- Verdicts: the gauntlet's output (§6). One row per reviewer per job.
   310	-- reviewer_tier is denormalized at write time so a later seat re-tiering cannot
   311	-- retroactively validate a job that was never properly reviewed.
   312	-- ---------------------------------------------------------------------------
   313	CREATE TABLE IF NOT EXISTS verdicts (
   314	    id            INTEGER PRIMARY KEY,
   315	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   316	    reviewer_seat TEXT NOT NULL REFERENCES seats(id),
   317	    reviewer_tier TEXT NOT NULL CHECK (reviewer_tier IN ('local', 'subscription', 'metered')),
   318	    -- 'reviewer' reads the diff and judges. 'tester' DRIVES THE APP (Playwright) and
   319	    -- judges what it observed. The tester guards below apply only to the latter.
   320	    -- 'reviewer' reads the diff and judges it.
   321	    -- 'tester'   DROVE the running app (Playwright) and judges what it observed.
   322	    -- 'verifier' FACT-CHECKS a research answer against its sources.
   323	    role          TEXT NOT NULL DEFAULT 'reviewer'
   324	                  CHECK (role IN ('reviewer', 'tester', 'verifier')),
   325	    -- model family is snapshotted here so §6's "at least two families" rule is
   326	    -- auditable, and so the no-self-family-testing guard has something to check.
   327	    model_family  TEXT NOT NULL,
   328	    -- WHAT, exactly, did this reviewer look at? Snapshotted at write time. A verdict
   329	    -- whose version no longer matches the job's head_version is history, not
   330	    -- approval — it stops counting the moment the code moves on. This is the other
   331	    -- half of the review-to-version chain.
   332	    reviewed_version TEXT,
   333	    verdict       TEXT NOT NULL CHECK (verdict IN ('pass', 'fail', 'needs_human')),
   334	    severity      TEXT CHECK (severity IN ('p0', 'p1', 'p2', 'p3')),
   335	    summary       TEXT,
   336	    detail        TEXT,
   337	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   338	);
   339	
   340	CREATE INDEX IF NOT EXISTS idx_verdicts_job ON verdicts(job_id);
   341	
   342	-- ═══════════════════════════════════════════════════════════════════════════════
   343	-- CAPABILITIES — what an agent is PHYSICALLY ALLOWED to do.
   344	--
   345	-- This exists because Sol reviewed the architecture and demolished the previous
   346	-- safety story. The plan had been: the voice can act fast, and Chief watches and
   347	-- kills anything dumb. Sol's verdict:
   348	--
   349	--     "'Builders take minutes' measures how long they take to FINISH. What matters
   350	--      is how long they take to do their FIRST DAMAGING THING. That can be seconds.
   351	--      Chief and the builder would be RACING. There is no guarantee Chief wins."
   352	--
   353	--     "A fast supervisor is still only a fast witness if the builder can act first."
   354	--
   355	--     "A smarter model is not a security boundary."
   356	--
   357	-- He's right, and it's the difference between a bank with a vault and a bank with an
   358	-- attentive guard. You do not stop a robbery by watching carefully.
   359	--
   360	-- SO: agents get NO dangerous powers. Not "Chief will stop them" — THEY CANNOT.
   361	-- Reading code, writing code in their own worktree, running tests: always fine, and
   362	-- that's 95% of the work. Everything that touches the real world is denied by
   363	-- default and needs a signed, single-use permission slip for that exact act.
   364	-- ═══════════════════════════════════════════════════════════════════════════════
   365	CREATE TABLE IF NOT EXISTS capabilities (
   366	    seat_id       TEXT NOT NULL REFERENCES seats(id) ON DELETE CASCADE,
   367	    capability    TEXT NOT NULL CHECK (capability IN (
   368	                      -- SAFE. Granted to every builder. This is the actual job.
   369	                      'read_code', 'write_worktree', 'run_tests', 'open_pr',
   370	                      -- DANGEROUS. Denied to everyone by default. Each needs a
   371	                      -- fresh, single-use approval naming the exact action.
   372	                      'touch_production', 'delete_data', 'run_migration',
   373	                      'deploy', 'merge_to_main', 'force_push',
   374	                      'read_secrets', 'send_external', 'spend_money'
   375	                  )),
   376	    PRIMARY KEY (seat_id, capability)
   377	);
   378	
   379	-- The safe set. Everything an agent needs to actually build software, and nothing
   380	-- that can hurt you. Note what ISN'T here — that's the whole point.
   381	CREATE VIEW IF NOT EXISTS safe_capabilities AS
   382	SELECT 'read_code' AS capability UNION ALL SELECT 'write_worktree'
   383	UNION ALL SELECT 'run_tests' UNION ALL SELECT 'open_pr';
   384	
   385	-- ═══════════════════════════════════════════════════════════════════════════════
   386	-- APPROVALS — a signed, single-use permission slip for ONE exact dangerous act.
   387	--
   388	-- Sol on why a "yes" cannot be trusted on its own:
   389	--
   390	--     Chief: "First make a backup, then remove the old accounts."
   391	--     Neill: "Yes — skip the first one."
   392	--
   393	--     "That LOOKS like a confirmation, but it changes the safe plan into a dangerous
   394	--      one. Sending it directly recreates the original classification problem."
   395	--
   396	-- So an approval is not a word. It is a ROW: a numbered, one-time permission for a
   397	-- specific action, with the consequence written out in plain English and READ BACK to
   398	-- Neill before he can agree. It expires the moment the plan changes.
   399	--
   400	--     "A bare 'yes' should never approve something that was not just read back
   401	--      exactly." — which also handles the fact that a car is a terrible place to be
   402	--      understood correctly.
   403	-- ═══════════════════════════════════════════════════════════════════════════════
   404	CREATE TABLE IF NOT EXISTS approvals (
   405	    id            INTEGER PRIMARY KEY,
   406	    job_id        INTEGER REFERENCES jobs(id) ON DELETE CASCADE,
   407	    capability    TEXT NOT NULL,            -- the ONE dangerous thing this permits
   408	    -- Exactly what will happen. Not a category — the actual act.
   409	    action        TEXT NOT NULL,            -- "delete 4,200 accounts inactive since 2024-01-01"
   410	    -- What Chief SAID OUT LOUD to Neill before he agreed. If this is empty, nothing
   411	    -- was read back, and a 'yes' means nothing.
   412	    read_back     TEXT NOT NULL,
   413	    -- Is this undoable, and how? Sol: "Anything irreversible needs a tested recovery
   414	    -- method BEFORE it starts."
   415	    reversible    INTEGER NOT NULL DEFAULT 0 CHECK (reversible IN (0,1)),
   416	    recovery      TEXT,                     -- "restore from the snapshot taken at 09:14"
   417	
   418	    granted_by    TEXT NOT NULL DEFAULT 'owner' CHECK (granted_by = 'owner'),
   419	    granted_at    TEXT,
   420	    expires_at    TEXT NOT NULL,            -- short. Minutes, not hours.
   421	    used_at       TEXT,                     -- single use. Once spent, it's spent.
   422	    revoked_at    TEXT,
   423	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   424	);
   425	
   426	CREATE INDEX IF NOT EXISTS idx_approvals_job ON approvals(job_id);
   427	
   428	-- ═══════════════════════════════════════════════════════════════════════════════
   429	-- GUARD 12 — a dangerous act needs a live, unused, read-back approval.
   430	-- No approval, no action. Not "Chief said it was fine" — a signed slip, or nothing.
   431	-- ═══════════════════════════════════════════════════════════════════════════════
   432	CREATE VIEW IF NOT EXISTS live_approvals AS
   433	SELECT * FROM approvals
   434	 WHERE granted_at IS NOT NULL
   435	   AND used_at    IS NULL
   436	   AND revoked_at IS NULL
   437	   AND expires_at > datetime('now')
   438	   AND TRIM(read_back) <> '';
   439	
   440	-- An approval may never be BORN granted. (Sol, round 3 — verified 2026-07-14.)
   441	--
   442	-- Every approval guard fired on UPDATE OF granted_at only — the exact "born done" hole
   443	-- Sol found on the jobs table in round 1, never applied here. Confirmed with a live
   444	-- exploit: an INSERT with granted_at already set, reversible=0 and no recovery plan sailed
   445	-- straight into the live_approvals view. An approval must be born ungranted and become
   446	-- granted through an UPDATE, where the read-back and recovery guards below actually fire.
   447	CREATE TRIGGER IF NOT EXISTS guard_no_approval_is_born_granted
   448	BEFORE INSERT ON approvals
   449	WHEN NEW.granted_at IS NOT NULL
   450	BEGIN
   451	    SELECT RAISE(ABORT, 'guard: an approval cannot be created already granted — it must be granted through a read-back');
   452	END;
   453	
   454	-- An approval cannot be granted without something having been read back.
   455	CREATE TRIGGER IF NOT EXISTS guard_no_approval_without_readback
   456	BEFORE UPDATE OF granted_at ON approvals
   457	WHEN NEW.granted_at IS NOT NULL AND TRIM(COALESCE(NEW.read_back, '')) = ''
   458	BEGIN
   459	    SELECT RAISE(ABORT, 'guard: nothing was read back to him — a yes to nothing is not a yes');
   460	END;
   461	
   462	-- An irreversible act cannot be approved without a recovery plan.
   463	-- Sol: "'Kill' must never be presented as 'undo.'"
   464	CREATE TRIGGER IF NOT EXISTS guard_irreversible_needs_a_way_back
   465	BEFORE UPDATE OF granted_at ON approvals
   466	WHEN NEW.granted_at IS NOT NULL AND NEW.reversible = 0
   467	     AND TRIM(COALESCE(NEW.recovery, '')) = ''
   468	BEGIN
   469	    SELECT RAISE(ABORT, 'guard: this cannot be undone and has no way back — not without a recovery plan');
   470	END;
   471	
   472	-- Single use. A permission slip is spent when it is used.
   473	CREATE TRIGGER IF NOT EXISTS guard_an_approval_is_used_once
   474	BEFORE UPDATE OF used_at ON approvals
   475	WHEN OLD.used_at IS NOT NULL
   476	BEGIN
   477	    SELECT RAISE(ABORT, 'guard: that permission was already spent');
   478	END;
   479	
   480	-- ---------------------------------------------------------------------------
   481	-- Events: the live activity stream. What an agent is doing RIGHT NOW.
   482	--
   483	-- This is what makes the text channel feel like the Claude Code terminal — you
   484	-- watch Riggs read auth.py, edit routes.py, run pytest, and come back green.
   485	-- Without it the harness can only tell you a job "happened," which is useless
   486	-- while you're waiting and only mildly interesting afterward.
   487	--
   488	-- ONE STREAM, TWO RENDERINGS (this is the key design decision):
   489	--   VOICE reads jobs.spoken_summary — a sentence. "Riggs is on it, two minutes."
   490	--   TEXT  reads THIS table in full   — every tool call, every file, every result.
   491	-- Same truth, different verbosity. The voice can escalate into this table on
   492	-- request ("what's it actually doing?") — see [voice] in seats.toml.
   493	--
   494	-- Note `lane` and `model` are BOTH recorded. The lane (Riggs) carries the memory
   495	-- and the conventions; the model is whoever is sitting in that chair today. You
   496	-- must always be able to see which — otherwise you can't tell whether your auth
   497	-- module was built by your best coder or your cheapest one.
   498	-- ---------------------------------------------------------------------------
   499	CREATE TABLE IF NOT EXISTS events (
   500	    id            INTEGER PRIMARY KEY,
   501	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   502	    seat_id       TEXT NOT NULL REFERENCES seats(id),
   503	    lane          TEXT NOT NULL,             -- 'riggs' | 'finn' | 'nova' | 'forge' ...
   504	    model         TEXT NOT NULL,             -- who is actually in the chair right now
   505	    family        TEXT NOT NULL,
   506	    -- 'skipped' is load-bearing (task #10): the record needs a word for something that
   507	    -- did NOT happen. A reviewer that was capped out or couldn't run must leave a mark,
   508	    -- or a panel that quietly shrank looks identical to a full one. (Migration 006.)
   509	    kind          TEXT NOT NULL CHECK (kind IN (
   510	                      'dispatched', 'thinking', 'read', 'edit', 'write',
   511	                      'command', 'test_run', 'browse', 'verdict', 'done', 'error',
   512	                      'skipped'
   513	                  )),
   514	    target        TEXT,                      -- the file / command / URL it touched
   515	    detail        TEXT,                      -- one line, terminal-style
   516	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   517	);
   518	
   519	CREATE INDEX IF NOT EXISTS idx_events_job ON events(job_id, id);
   520	
     1	-- Migration 007 — two holes under the whole review system (found by the cross-model
     2	-- review of task #10, reproduced live before fixing).
     3	--
     4	-- ── HOLE 1: a job with no requirements had no requirements to fail ──
     5	--
     6	-- required_reviews and required_review_families default to 0, and BOTH completion
     7	-- guards were written `WHEN NEW.required_* > 0`. So a job whose requirements were never
     8	-- stamped sailed to 'done' with zero verdicts — not by defeating a guard, but because
     9	-- no guard fired. The only thing setting those numbers was Python in dispatch(), which
    10	-- means gauntlet.py's claim that "the database is the boundary, not this file" was not
    11	-- true of the most basic question of all: did ANY review happen?
    12	--
    13	-- Reproduced: create_job -> in_progress -> review -> done, no verdicts, no complaint.
    14	--
    15	-- Now the floor is unconditional. Reaching 'done' requires at least one passing
    16	-- reviewer of the current version and at least one model family, whatever the row says
    17	-- about itself. A job that wants more still needs more.
    18	--
    19	-- ── HOLE 2: a model could be counted as its own second opinion ──
    20	--
    21	-- The family floor counted DISTINCT families among the passing reviewers — including
    22	-- the builder's own. So a gpt seat could build it, a gpt seat could pass it, and that
    23	-- gpt pass counted as one of the two required "different minds."
    24	--
    25	-- Note what is NOT being changed. test_jobs.py records a deliberate decision that a
    26	-- same-family reviewer is ALLOWED — it is a weaker signal, not a forbidden one, and
    27	-- banning it outright would deadlock the current setup (a claude-built job with only
    28	-- claude and gpt reviewers available could never clear a floor of two). That decision
    29	-- stands. What changes is that such a review no longer COUNTS toward diversity.
    30	--
    31	-- The floor now asks the question it was always meant to ask: how many minds OTHER
    32	-- THAN THE AUTHOR'S looked at this?
    33	
    34	BEGIN;
    35	
    36	DROP TRIGGER IF EXISTS guard_full_panel;
    37	CREATE TRIGGER guard_full_panel
    38	BEFORE UPDATE OF status ON jobs
    39	WHEN NEW.status = 'done' AND OLD.status <> 'done'
    40	BEGIN
    41	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
    42	    WHERE (
    43	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
    44	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
    45	          AND v.reviewed_version IS NEW.head_version
    46	    ) < MAX(NEW.required_reviews, 1);      -- never zero: unstamped is not unrequired
    47	END;
    48	
    49	-- An earlier draft of this migration banned same-family review outright. It ran against
    50	-- the live database before the deadlock was spotted, so drop it explicitly rather than
    51	-- assume it was never there.
    52	DROP TRIGGER IF EXISTS guard_no_self_family_reviewing;
    53	
    54	DROP TRIGGER IF EXISTS guard_family_floor;
    55	CREATE TRIGGER guard_family_floor
    56	BEFORE UPDATE OF status ON jobs
    57	WHEN NEW.status = 'done' AND OLD.status <> 'done'
    58	BEGIN
    59	    SELECT RAISE(ABORT, 'guard: fewer model families reviewed this than required')
    60	    WHERE (
    61	        SELECT COUNT(DISTINCT v.model_family) FROM verdicts v
    62	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
    63	          AND v.reviewed_version IS NEW.head_version
    64	          AND v.model_family <> NEW.builder_family   -- the author is not a second opinion
    65	    ) < MAX(NEW.required_review_families, 1);
    66	END;
    67	
    68	-- ── The gatekeeper's own log ──
    69	--
    70	-- Every note it writes today hangs off a JOB, and `events.job_id` is NOT NULL. A deploy
    71	-- isn't necessarily about a job, so both its grants AND its refusals were being dropped
    72	-- on the floor — for the one verb where "say it out loud" matters most. A gatekeeper
    73	-- whose refusals can vanish is indistinguishable from one that was never asked.
    74	CREATE TABLE IF NOT EXISTS gate_log (
    75	    id          INTEGER PRIMARY KEY,
    76	    verb        TEXT NOT NULL,
    77	    subject     TEXT NOT NULL,
    78	    granted     INTEGER NOT NULL CHECK (granted IN (0,1)),
    79	    detail      TEXT NOT NULL,
    80	    asked_by    TEXT NOT NULL,
    81	    job_id      INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
    82	    created_at  TEXT NOT NULL DEFAULT (datetime('now'))
    83	);
    84	
    85	-- The log is a record of what was asked and answered. Records are not retractable —
    86	-- same reasoning as verdicts.
    87	CREATE TRIGGER IF NOT EXISTS guard_gate_log_is_append_only
    88	BEFORE UPDATE ON gate_log
    89	BEGIN
    90	    SELECT RAISE(ABORT, 'guard: the gatekeeper log is a record, not a draft');
    91	END;
    92	
    93	CREATE TRIGGER IF NOT EXISTS guard_gate_log_cannot_be_deleted
    94	BEFORE DELETE ON gate_log
    95	BEGIN
    96	    SELECT RAISE(ABORT, 'guard: the gatekeeper log cannot be deleted');
    97	END;
    98	
    99	COMMIT;

