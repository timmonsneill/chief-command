    83	SPEND_ROLES = {"build", "review", "test", "research", "voice"}
    84	
    85	
    86	class Refused(RuntimeError):
    87	    """The gatekeeper said no. The message is in plain English, on purpose — it is
    88	    shown to Neill, and 'guard_family_floor violated' tells him nothing."""
    89	
    90	
    91	@dataclass
    92	class Receipt:
    93	    """Proof that the one thing happened, and what it was."""
    94	    verb: str
    95	    subject: str
    96	    detail: str = ""
    97	    reference: str = ""          # commit id, usage row, deploy id
    98	
    99	
   100	# ---------------------------------------------------------------------------
   101	# Saying no, out loud
   102	# ---------------------------------------------------------------------------
   103	def _clean(text: str, limit: int = 120) -> str:
   104	    """Make caller-supplied text safe to show Neill.
   105	
   106	    Everything written by `_note` is attributed to the gatekeeper — the one component he
   107	    is being told to trust — so an agent that can inject newlines into it can forge
   108	    gatekeeper-signed lines on his timeline. Strip the formatting, cap the length.
   109	    """
   110	    return re.sub(r"\s+", " ", str(text)).strip()[:limit]
   111	
   112	
   113	def _log(conn, verb: str, subject: str, granted: bool, detail: str,
   114	         asked_by: str = "unknown", job_id: int | None = None) -> None:
   115	    """The gatekeeper's own record, which does not depend on there being a job.
   116	
   117	    Deploys aren't necessarily about a job, and `events.job_id` is NOT NULL — so before
   118	    this existed, a deploy's grants AND its refusals were dropped on the floor, for the
   119	    one verb where saying it out loud matters most. Append-only by trigger.
   120	    """
   121	    conn.execute(
   122	        "INSERT INTO gate_log (verb, subject, granted, detail, asked_by, job_id) "
   123	        "VALUES (?,?,?,?,?,?)",
   124	        (verb, _clean(subject), int(granted), _clean(detail, 400),
   125	         _clean(asked_by, 60), job_id),
   126	    )
   127	
   128	
   129	def _note(conn, job_id: int | None, text: str, kind: str = "skipped") -> None:
   130	    """Write a refusal (or a grant) onto the job where a person will see it.
   131	
   132	    Refusals are 'skipped' events; a grant is 'done' — a merge showing up in the
   133	    activity stream as a skip was telling Neill the opposite of what happened."""
   134	    if job_id is None:
   135	        return
   136	    row = conn.execute(
   137	        "SELECT builder_seat FROM jobs WHERE id = ?", (job_id,)
   138	    ).fetchone()
   139	    if row is None:
   140	        return
   141	    s = seat(conn, row["builder_seat"])
   142	    if s is None:
   143	        return
   144	    conn.execute(
   145	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   146	        "VALUES (?,?,?,?,?,?,?)",
   147	        (job_id, s["id"], "gatekeeper", s["model"], s["family"], kind, text),
   148	    )
   149	
   150	
   151	def _refuse(conn, job_id: int | None, why: str = "", *, verb: str = "",
   152	            subject: str = "", asked_by: str = "unknown") -> Refused:
   153	    # A job id the record doesn't know must not reach gate_log: its foreign key would
   154	    # throw, and the refusal — the one thing rule 3 says must never vanish — would.
   155	    job_id = _known_job(conn, job_id)
   156	    _note(conn, job_id, f"The gatekeeper said no: {why}")
   157	    if verb:
   158	        _log(conn, verb, subject or str(job_id), False, why, asked_by, job_id)
   159	    return Refused(why)
   160	
   161	
   162	def _known_job(conn, job_id) -> int | None:
   163	    try:
   164	        job_id = int(job_id) if job_id is not None else None
   165	    except (TypeError, ValueError):
   166	        return None
   167	    return job_id if job_id is not None and _job_exists(conn, job_id) else None
   168	
   169	
   170	# ---------------------------------------------------------------------------
   171	# MERGE — code enters main
   172	# ---------------------------------------------------------------------------
   173	def merge(conn, job_id: int, *, asked_by: str = "unknown") -> Receipt:
   174	    """Merge a job's branch into main, if and only if the record earns it.
   175	
   176	    Every check below re-reads the database. None of them takes the asker's word for
   177	    anything — that is the entire difference between this and `dispatch.ship()`, which
   178	    did the thing because it was called.
   179	    """
   180	    def _no(why: str) -> Refused:
   181	        """One way out of this function, so no refusal can forget to write itself down."""
   182	        return _refuse(conn, job_id if _job_exists(conn, job_id) else None, why,
   183	                       verb="merge", subject=f"job {job_id}", asked_by=asked_by)
   184	
   185	    job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   186	    if job is None:
   187	        raise _no(f"there is no job {job_id}")
   188	
   189	    if job["status"] == "shipped":
   190	        raise _no("that work has already been merged once")
   191	    if job["status"] != "done":
   192	        raise _no("that work hasn't finished its checks yet, so there's nothing to merge")
   193	
   194	    version = job["head_version"]
   195	    if not version:
   196	        raise _no("nothing was actually put forward — there's no finished version to merge")
   197	
   198	    verdicts = conn.execute(
   199	        "SELECT reviewer_seat, model_family, verdict, role, reviewed_version "
   200	        "FROM verdicts WHERE job_id = ?", (job_id,)
   201	    ).fetchall()
   202	    current = [v for v in verdicts if v["reviewed_version"] == version]
   203	
   204	    # A failure on this version is fatal and is NOT outvoted. A failure on an unknown
   205	    # version is also fatal: it condemns we-don't-know-what, so it condemns everything.
   206	    for v in verdicts:
   207	        if v["verdict"] == "fail" and (
   208	                v["reviewed_version"] is None or v["reviewed_version"] == version):
   209	            raise _no("a reviewer turned this down and that stands")
   210	    if any(v["verdict"] == "needs_human" for v in verdicts):
   211	        raise _no("a reviewer asked for you to look at this first")
   212	
   213	    passed = [v for v in current if v["verdict"] == "pass" and v["role"] == "reviewer"]
   214	    seats = {v["reviewer_seat"] for v in passed}
   215	    # The author is not a second opinion (migration 007): a same-family pass is a
   216	    # legitimate review, it just does not count toward "different minds". The schema
   217	    # already refuses first; this keeps the gate honest even if it ever stops.
   218	    families = {v["model_family"] for v in passed
   219	                if v["model_family"] != job["builder_family"]}
   220	
   221	    # A job carrying NO requirements is not a job everyone approved — it is a job whose
   222	    # requirements were never stamped. `0 < 0` is False, so treating zero as "nothing
   223	    # required" would let a row created outside dispatch merge with no reviews at all.
   224	    need_seats = job["required_reviews"] or 0
   225	    need_families = job["required_review_families"] or 0
   226	    if need_seats < 1 or need_families < 1:
   227	        raise _no("that job never had any review requirements set, so there is "
   228	                      "nothing to have passed")
   229	    if len(seats) < need_seats:
   230	        raise _no(f"only {len(seats)} of the {need_seats} reviewers "
   231	                      "have signed off on this version")
   232	    if len(families) < need_families:
   233	        raise _no(f"only {len(families)} different kinds of model have checked this; "
   234	                      f"{need_families} are required")
   235	
   236	    branch = job["branch"] or ""
   237	    if not BRANCH_RE.match(branch):
   238	        raise _no("there's no finished branch of code to merge for that job")
   239	
   240	    tip = _branch_tip(branch)
   241	    if tip is None:
   242	        raise _no("there's no finished branch of code to merge for that job")
   243	
   244	    # ══════════════════════════════════════════════════════════════════════════
   245	    # THE CHECK THIS WHOLE VERB EXISTS FOR.
   246	    #
   247	    # Everything above verifies the RECORD. This verifies that the code about to enter
   248	    # main IS the code the record is about. Without it, a builder commits v1, the panel
   249	    # reviews v1, `head_version` freezes at v1 — and then the builder pushes v2 to the
   250	    # same branch and asks for a merge. Every check passes, and v2 goes in. The version
   251	    # freeze that protects the record would be helping the attacker.
   252	    #
   253	    # Reviews are of bytes, not of intentions. Merge the bytes that were reviewed.
   254	    # ══════════════════════════════════════════════════════════════════════════
   255	    if not _same_commit(tip, version):
   256	        raise _no("the code on that branch isn't the code that was reviewed — "
   257	                      "it has changed since, so it needs checking again")
   258	
   259	    if not _repo_is_ready():
   260	        raise _no("the project folder has unfinished changes in it, so it isn't "
   261	                      "safe to merge right now")
   262	
   263	    # ══════════════════════════════════════════════════════════════════════════
   264	    # ORDER IS THE POINT: the RECORD decides first, the irreversible act happens
   265	    # second. Merging and then asking produced "the code merged but the record wouldn't
   266	    # accept it" — an unreviewed merge with a polite note. The gatekeeper's own checks
   267	    # are a SUBSET of the schema's (it never checks for a passing tester), so the only
   268	    # safe order is to let the schema refuse before git is touched at all.
   269	    # ══════════════════════════════════════════════════════════════════════════
   270	    with _MERGE_LOCK:
   271	        # Re-resolve under the lock and merge the SHA, never the name. Between the check
   272	        # above and `git merge refs/heads/<branch>`, a builder could move the branch;
   273	        # merging by name would then merge whatever it points at now.
   274	        tip = _branch_tip(branch)
   275	        if tip is None or not _same_commit(tip, version):
   276	            raise _no("the code on that branch changed while the merge was being "
   277	                      "checked, so it needs checking again")
   278	        conn.execute("BEGIN IMMEDIATE")
   279	        try:
   280	            try:
   281	                set_status(conn, job_id, "shipped")
   282	            except (GuardViolation, sqlite3.IntegrityError) as exc:
   283	                conn.execute("ROLLBACK")
   284	                raise _no(_plain(exc)) from exc
   285	            commit = _git_merge(tip)
   286	            if commit is None:
   287	                conn.execute("ROLLBACK")          # the record never happened either
   288	                raise _no("the merge didn't go through cleanly — it needs a person")
   289	            conn.execute("COMMIT")
   290	        except BaseException:
   291	            # Never leave a transaction open on a connection somebody else will reuse.
   292	            if conn.in_transaction:
   293	                conn.execute("ROLLBACK")
   294	            raise
   295	
   296	    _note(conn, job_id,
   297	          f"Merged into the main line of code. Asked for by {_clean(asked_by)}.", kind="done")
   298	    _log(conn, "merge", f"job {job_id}", True,
   299	         f"{len(families)} model families signed off on {version}; merged {commit}",
   300	         asked_by, job_id)
   301	    return Receipt(verb="merge", subject=f"job {job_id}", reference=commit,
   302	                   detail=f"{len(families)} model families signed off on {version}")
   303	
   304	
   305	_MERGE_LOCK = threading.Lock()          # two merges racing share one git index
   306	
   307	
   308	def _job_exists(conn, job_id: int) -> bool:
   309	    return conn.execute("SELECT 1 FROM jobs WHERE id = ?", (job_id,)).fetchone() is not None
   310	
   311	
   312	def _plain(exc: Exception) -> str:
   313	    """A schema refusal, with the machine word taken off the front."""
   314	    return str(exc).replace("guard: ", "").strip() or "the record wouldn't accept it"
   315	
   316	
   317	def _branch_tip(branch: str) -> str | None:
   318	    """The commit a BRANCH points at — refs/heads/ so nothing else can be meant."""
   319	    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}"],
   320	                         cwd=REPO, capture_output=True, text=True)
   321	    return out.stdout.strip() or None if out.returncode == 0 else None
   322	
   323	
   324	def _same_commit(tip: str, version: str) -> bool:
   325	    """Is the reviewed version this exact commit?
   326	
   327	    `head_version` is a short id, so compare on the shorter length. A version that is
   328	    not a commit id at all (the local worker records a content hash) can never match,
   329	    which is correct: if we cannot prove the reviewed thing is this code, we do not
   330	    merge it.
   331	    """
   332	    version = (version or "").strip().lower()
   333	    tip = (tip or "").strip().lower()
   334	    if len(version) < 7 or not re.fullmatch(r"[0-9a-f]+", version):
   335	        return False
   336	    return tip.startswith(version)
   337	
   338	
   339	def _repo_is_ready() -> bool:
   340	    """On the branch we merge into, with nothing half-done in the folder.
   341	
   342	    Merging into a detached HEAD orphans the result; merging over the owner's own
   343	    uncommitted work risks losing it when a failed merge is aborted.
   344	    """
   345	    head = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
   346	                          cwd=REPO, capture_output=True, text=True)
   347	    if head.returncode != 0 or head.stdout.strip() != MERGE_INTO:
   348	        return False
   349	    dirty = subprocess.run(["git", "status", "--porcelain"],
   350	                           cwd=REPO, capture_output=True, text=True)
   351	    return dirty.returncode == 0 and not dirty.stdout.strip()
   352	
   353	
   354	def _git_merge(commit: str) -> str | None:
   355	    """Merge one exact commit. Takes a SHA, not a ref, on purpose."""
   356	    try:
   357	        proc = subprocess.run(["git", "merge", "--no-ff", "--no-edit", commit],
   358	                              cwd=REPO, capture_output=True, text=True, timeout=120)
   359	    except subprocess.TimeoutExpired:
   360	        _abort_any_merge()
   361	        return None
   362	    if proc.returncode != 0:
   363	        # Leave nothing half-merged behind. A conflicted tree that nobody is looking at
   364	        # is worse than a refusal.
   365	        _abort_any_merge()
   366	        return None
   367	    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=REPO,
   368	                          capture_output=True, text=True)
   369	    return head.stdout.strip()[:12] or None
   370	
   371	
   372	def _abort_any_merge() -> None:
   373	    """Undo a half-finished merge — and ONLY a half-finished merge.
   374	
   375	    `git merge --abort` is `git reset --merge` underneath, which will discard the
   376	    owner's uncommitted work if no merge is actually in progress. Check first.
   377	    """
   378	    if (REPO / ".git" / "MERGE_HEAD").exists():
   379	        subprocess.run(["git", "merge", "--abort"], cwd=REPO, capture_output=True)
   380	
   381	
   382	# ---------------------------------------------------------------------------
   383	# DEPLOY — something reaches the world
   384	# ---------------------------------------------------------------------------
   385	def deploy(conn, target: str, *, job_id: int | None = None,
   386	           asked_by: str = "unknown") -> Receipt:
   387	    """Deploy — ONLY on a live, unused, read-back owner approval naming this target.
   388	
   389	    Decision D keeps Neill in the path for production deploys, and this is the only
   390	    place in the harness where an agent's request is not enough on its own. There is
   391	    deliberately no "the reviewers all agreed" route here: reviewers judge code, and a
   392	    deploy is a decision about the business.
   393	    """
   394	    target = _clean(target)
   395	    approval = conn.execute(
   396	        "SELECT * FROM live_approvals WHERE capability = 'deploy' AND action = ? "
   397	        "ORDER BY id DESC LIMIT 1", (target,),
   398	    ).fetchone()
   399	    if approval is None:
   400	        raise _refuse(conn, job_id,
   401	                      f"nothing has been approved for deploying {target} — "
   402	                      "that needs your say-so, tapped, not spoken",
   403	                      verb="deploy", subject=target, asked_by=asked_by)
   404	    # An approval granted about ONE job does not authorize the same words claimed under
   405	    # another. Without this, a yes given in the context of job 4 travels to job 99.
   406	    if approval["job_id"] is not None and approval["job_id"] != job_id:
   407	        raise _refuse(conn, job_id,
   408	                      "that approval was for a different piece of work",
   409	                      verb="deploy", subject=target, asked_by=asked_by)
   410	    if not approval["reversible"] and not (approval["recovery"] or "").strip():
   411	        raise _refuse(conn, job_id,
   412	                      "that deploy can't be undone and there's no written way back",
   413	                      verb="deploy", subject=target, asked_by=asked_by)
   414	
   415	    # Spend the approval FIRST. If the deploy dies halfway, the slip is still used —
   416	    # a retry must come back for a fresh yes rather than replay an old one. Two callers
   417	    # racing: SQLite serializes the writes and the single-use guard refuses the loser,
   418	    # which arrives here as a plain refusal rather than a crash.
   419	    try:
   420	        conn.execute("UPDATE approvals SET used_at = datetime('now') WHERE id = ?",
   421	                     (approval["id"],))
   422	    except sqlite3.IntegrityError as exc:
   423	        raise _refuse(conn, job_id, "that approval has already been used",
   424	                      verb="deploy", subject=target, asked_by=asked_by) from exc
   425	
   426	    # ⚠️ HONEST RECEIPT. Nothing here deploys anything — the harness has no deploy
   427	    # mechanism yet, and this verb exists so that when one is built it is built BEHIND
   428	    # the gate rather than beside it. Saying "Deployed {target}" would have been the
   429	    # gatekeeper's own record lying about the one act it exists to control.
   430	    detail = ("cleared to deploy on your approval — note that the harness has no "
   431	              "deploy mechanism wired yet, so nothing was actually sent anywhere")
   432	    _note(conn, job_id, f"Cleared to deploy {target}, on your approval. "
   433	                        f"Asked for by {_clean(asked_by)}. Nothing was sent — "
   434	                        "there's no deploy button wired up yet.")
   435	    _log(conn, "deploy", target, True, detail, asked_by, job_id)
   436	    return Receipt(verb="deploy", subject=target, detail=detail,
   437	                   reference=str(approval["id"]))
   438	
   439	
   440	# ---------------------------------------------------------------------------
   441	# SPEND — real money leaves the account
   442	# ---------------------------------------------------------------------------
   443	def spend(conn, seat_id: str, cents: int, *, job_id: int | None = None,
   444	          role: str = "build", asked_by: str = "unknown") -> Receipt:
   445	    """Reserve money BEFORE the provider is called, or refuse.
   446	
   447	    Sol: refusing to RECORD a charge doesn't unspend it. So the ledger is written first
   448	    and the call happens after. The daily and monthly caps live in the schema, which is
   449	    what makes this a reservation rather than a note — two agents reserving at the same
   450	    instant both hit the ledger, and the ledger refuses the one that breaches.
   451	
   452	    ⚠️ THERE IS NO RECONCILIATION YET. A reservation is an ESTIMATE, and if the real
   453	    call costs less, or never happens at all, the estimate stands against the cap
   454	    permanently. That is deliberate for now (erring toward over-counting spend is the
   455	    safe direction) but it is not the same thing as accurate accounting, and this
   456	    docstring said otherwise until the cross-model review called it.
   457	    """
   458	    if cents < 0:
   459	        raise _refuse(conn, job_id, "a charge can't be negative",
   460	                      verb="spend", subject=seat_id, asked_by=asked_by)
   461	    # The caps are keyed BY ROLE, so a role nobody validated is a cap nobody enforces —
   462	    # 'research' would sail past both the build ration and the review ration.
   463	    if role not in SPEND_ROLES:
   464	        raise _refuse(conn, job_id, f"'{role}' isn't a kind of work money can be spent on",
   465	                      verb="spend", subject=seat_id, asked_by=asked_by)
   466	    row = seat(conn, seat_id)
   467	    if row is None:
   468	        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
   469	                      verb="spend", subject=seat_id, asked_by=asked_by)
   470	    if not row["enabled"]:
   471	        raise _refuse(conn, job_id, f"'{seat_id}' is switched off",
   472	                      verb="spend", subject=seat_id, asked_by=asked_by)
   473	
   474	    try:
   475	        record_usage(conn, seat_id, cents, job_id=job_id, role=role)
   476	    except (GuardViolation, sqlite3.IntegrityError) as exc:
   477	        raise _refuse(conn, job_id,
   478	                      "that would go past the spending limit for today",
   479	                      verb="spend", subject=seat_id, asked_by=asked_by) from exc
   480	
   481	    ref = conn.execute("SELECT last_insert_rowid() AS id").fetchone()["id"]
   482	    _log(conn, "spend", seat_id, True, f"{cents}c reserved for {role}", asked_by, job_id)
   483	    return Receipt(verb="spend", subject=seat_id, detail=f"{cents}c reserved for {role}",
   484	                   reference=str(ref))
   485	
   486	
   487	VERBS = {"merge": merge, "deploy": deploy, "spend": spend}
   488	
   489	
   490	# ---------------------------------------------------------------------------
   491	# The service — loopback only, and only these three verbs
   492	# ---------------------------------------------------------------------------
   493	def handle(request: dict[str, Any], *, db_path: Path | None = None) -> dict[str, Any]:
   494	    """One request in, one answer out. The whole surface area of the gatekeeper.
   495	
   496	    An unknown verb is refused without being examined further. This is the check that
   497	    keeps rule 1 true as the file grows.
   498	    """
   499	    verb = request.get("verb")
   500	    if verb not in VERBS:
   501	        return {"ok": False, "error": "the gatekeeper only does three things: "
   502	                                      "merge, deploy, spend"}
   503	
   504	    conn = connect(db_path or DB_PATH)
   505	    try:
   506	        asked_by = str(request.get("asked_by") or "unknown")
   507	        try:
   508	            if verb == "merge":
   509	                r = merge(conn, int(request["job_id"]), asked_by=asked_by)
   510	            elif verb == "deploy":
   511	                r = deploy(conn, str(request["target"]),
   512	                           job_id=_known_job(conn, request.get("job_id")), asked_by=asked_by)
   513	            else:
   514	                r = spend(conn, str(request["seat_id"]), int(request["cents"]),
   515	                          job_id=_known_job(conn, request.get("job_id")),
   516	                          role=str(request.get("role") or "build"), asked_by=asked_by)
   517	        except Refused as exc:
   518	            return {"ok": False, "error": str(exc)}
   519	        except (KeyError, ValueError, TypeError) as exc:
   520	            return {"ok": False, "error": f"that request didn't make sense: {exc}"}
   521	        except sqlite3.Error as exc:
   522	            return {"ok": False, "error": f"the record refused that: {_plain(exc)}"}
   523	        return {"ok": True, "verb": r.verb, "subject": r.subject,
   524	                "detail": r.detail, "reference": r.reference}
   525	    finally:
   526	        conn.close()
   527	
   528	
   529	def token() -> str:
   530	    """The shared secret a caller must present. Created once, readable only by us.
   531	
   532	    Loopback is a NETWORK control, not an authorization one. Without a token, any local
   533	    process — and any web page the owner happens to open, since a POST with a plain
   534	    content type is a "simple request" that needs no browser preflight — could drive the
   535	    three most dangerous powers in the system by fetching 127.0.0.1. A page cannot read
   536	    this file, so it cannot present the token.
   537	    """
   538	    TOKEN_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   539	    if not TOKEN_PATH.exists() or not TOKEN_PATH.read_text().strip():
   540	        # O_EXCL + 0600 from the first byte — never a world-readable instant. An empty
   541	        # file counts as missing: `compare_digest("", "")` is True, so an empty token
   542	        # would have let a header-less request through. Fail closed, always.
   543	        fd = os.open(TOKEN_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
   544	        with os.fdopen(fd, "w") as f:
   545	            f.write(secrets.token_urlsafe(32))
   546	        os.chmod(TOKEN_PATH, 0o600)
   547	    value = TOKEN_PATH.read_text().strip()
   548	    if len(value) < 32:
   549	        raise RuntimeError("the gatekeeper token is missing or too short — refusing to serve")
   550	    return value
   551	
   552	
   553	def serve(host: str = "127.0.0.1", port: int = 8788) -> None:
   554	    """Run the gatekeeper as its own process.
   555	
   556	    LOOPBACK ONLY, and not a choice to revisit casually: the tailnet is other devices,
   557	    and the whole point of this process is that reaching it is harder than reaching the
   558	    agents, not easier. Standard library only — the thing holding the dangerous powers
   559	    should have the smallest possible surface.
   560	    """
   561	    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
   562	
   563	    expected = token()
   564	
   565	    class Handler(BaseHTTPRequestHandler):
   566	        protocol_version = "HTTP/1.1"
   567	
   568	        def _reply(self, code: int, answer: dict) -> None:
   569	            payload = json.dumps(answer).encode()
   570	            self.send_response(code)
   571	            self.send_header("Content-Type", "application/json")
   572	            self.send_header("Content-Length", str(len(payload)))
   573	            self.end_headers()
   574	            self.wfile.write(payload)
   575	
   576	        def do_POST(self):                                    # noqa: N802
   577	            try:
   578	                # Host check first: it is what stops DNS rebinding, where a page the
   579	                # owner is looking at resolves an attacker's domain to 127.0.0.1 and
   580	                # then talks to us with the browser's blessing.
   581	                host_header = (self.headers.get("Host") or "").split(":")[0]
   582	                if host_header not in ("127.0.0.1", "localhost", "[::1]"):
   583	                    return self._reply(403, {"ok": False, "error": "not for you"})
   584	                if not expected or not secrets.compare_digest(
   585	                        self.headers.get("X-Chief-Token") or "", expected):
   586	                    return self._reply(403, {"ok": False, "error": "not for you"})
   587	
   588	                length = int(self.headers.get("Content-Length") or 0)
   589	                if length < 0 or length > MAX_BODY_BYTES:
   590	                    return self._reply(413, {"ok": False, "error": "that request is too big"})
   591	                raw = self.rfile.read(length) if length else b"{}"
   592	                try:
   593	                    body = json.loads(raw or b"{}")
   594	                except json.JSONDecodeError:
   595	                    body = {}
   596	                if not isinstance(body, dict):
   597	                    body = {}
   598	
   599	                answer = handle(body)
   600	                self._reply(200 if answer.get("ok") else 403, answer)
   601	            except Exception:                                  # noqa: BLE001
   602	                # The gatekeeper never dies of a bad request. Down means stopped, and
   603	                # stopped means every irreversible thing stops with it.
   604	                try:
   605	                    self._reply(400, {"ok": False, "error": "that request didn't make sense"})
   606	                except Exception:                              # noqa: BLE001
   607	                    pass
   608	
   609	        def log_message(self, *args):                          # quiet by default
   610	            pass
   611	
   612	    server = ThreadingHTTPServer((host, port), Handler)
   613	    server.daemon_threads = True
   614	    server.serve_forever()
   615	
   616	
   617	if __name__ == "__main__":
   618	    serve()

