diff --git a/harness/config/seats.toml b/harness/config/seats.toml
index abbf123..da40d1b 100644
--- a/harness/config/seats.toml
+++ b/harness/config/seats.toml
@@ -191,65 +191,57 @@ notes = "Backend lane. Memory belongs to the LANE, not the model — swap the mo
 // (daily_cap_cents 100 x ~30 days = ~$30/mo of fallback.)
 // ---------------------------------------------------------------------------
 // GROK BUILDS LESS THAN THE OTHERS — deliberately. Owner (2026-07-13):
 //     "it can review as much as it wants more or less, but shouldn't build as much
 //      as claude and chat"
 //
 // He's right, and the economics agree. Claude and OpenAI are FLAT-RATE — a build on
 // those seats costs nothing marginal, it's already bought. Grok is METERED, so every
 // build is real money leaving the account. And builds are the EXPENSIVE kind of work
 // (token-heavy) while reviews are CHEAP (read-heavy, ~1/10 the tokens).
 //
 //     BUILD on the seats you already pay for.
 //     REVIEW on the metered one, because reviewing is cheap.
 //
 // Which lands Grok exactly where it's most valuable anyway. Its worth was never being
 // the strongest coder — it isn't. It's being a DIFFERENT MIND that catches what Claude
 // and GPT both miss. And that job costs pennies.
 [seats.grok]
 provider = "xai"
 model = "grok-4.5"                          // NOT grok-build-0.1 (legacy, weak)
-tier = "subscription"                       // $30 SuperGrok, primary
-family = "grok"
+tier = "metered"                            // the runner calls the paid API with a key;
+family = "grok"                             // the SuperGrok sub covers the app, NOT this
 
-// OFF UNTIL THE LEAKED xAI KEY IS ROTATED (owner task). Turned off rather than left on
-// and failing: an enabled seat with no working key is counted as a panel member that
-// can never report, which parks every job forever and looks like a bug. The panel is
-// claude + gpt today — two families, which meets the floor. Flip this back the day the
-// key is rotated and grok is a third mind again.
+// Was OFF while the leaked xAI key was unrotated. Key rotated 2026-07-21; the runner
+// landed 2026-08-27 and the seat came back on the same day — a third mind on the panel.
+// If it must be turned off again, turn it OFF here rather than leaving it failing: an
+// enabled seat with no working key is a panel member that can never report. (A missing
+// key now excludes the seat at the door instead — see gauntlet.has_runner.)
 //
 // Owner decision, 2026-07-21: GROK DOES NOT TOUCH THE ARCH MEDICAL-RECORDS REPO. That
 // repo is out of scope entirely (Decision C); this line records the standing rule.
-disabled = true
+disabled = false
 worktree_isolated = true
 daily_cap_cents  = 100                      // $1/day = ~$30/mo HARD CEILING
 build_cap_cents  = 25                       // ~25c/day of building — a RATION
 review_cap_cents = 75                       // reviewing is cheap; let it look at everything
-notes = "Reviews freely. Builds sparingly. Sub primary, API fallback."
-
-  // Failover target. Same model, metered. This is what makes the hidden quota a
-  // speed bump instead of a dead stop.
-  [seats.grok.fallback]
-  provider = "xai-api"
-  auth = "XAI_API_KEY"
-  tier = "metered"
-  notes = "Engages when the sub 403s. Capped by daily_cap_cents above."
+notes = "Reviews freely. Builds sparingly. Metered API, capped by the record."
 
 // ---------------------------------------------------------------------------
 // FREE GRINDER — the local junior. Overnight scaffolding, boilerplate, first drafts.
 // Sized for 16 GB. A junior dev, and treated as one: guard 1 in schema.sql makes it
 // STRUCTURALLY IMPOSSIBLE for its output to reach `done` unreviewed.
 // ---------------------------------------------------------------------------
 [seats.grinder_local]
 provider = "ollama"
 model = "qwen2.5-coder:7b"
 tier = "local"
 family = "qwen"
 endpoint = "http://127.0.0.1:11434"
 notes = "Bump to qwen3-coder:30b on the Studio (§8 phase 5). One line."
 
 // ---------------------------------------------------------------------------
 // REVIEWER — escalation only. Highest judgment: architecture calls, contested
 // verdicts, the bug the local model looped on three times.
 //
 // Claude stays in the hierarchy HERE, deliberately. At escalation volume (a handful
 // of calls a day) it will not dent the Max rate limits that disqualify it from the
@@ -336,31 +328,31 @@ escalate_on = [
   "what's it doing", "tell me more", "details", "go deeper",
   "what happened", "walk me through it", "why",
 ]
 
 // Volunteer bad news; stay quiet about good news unless asked. Nobody wants a
 // running commentary on a build that's going fine.
 interrupt_me_on = ["failed", "needs_human", "over_budget", "guard_blocked"]
 stay_quiet_on   = ["thinking", "read", "edit"]
 
 // Spoken replies get truncated to this. The full text is always in the log.
 max_spoken_seconds = 12
 
 // ---------------------------------------------------------------------------
 // GAUNTLET (§6) — reviewers run in PARALLEL against one frozen bundle.
 // The model-family rule is recorded per-verdict in the DB, so it is AUDITABLE
 // rather than merely asserted. Different models miss different bugs.
 //
 // Four families available: gpt (brain), claude (reviewer), grok (grok),
 // qwen (grinder_local, the LOCAL builder — not a reviewer of its own work).
 //
-// The panel is HIGHER-TIER cross-family reviewers of a local build. Only the
-// claude-cli seat has a working runner today; brain needs the codex login and
-// grok needs the leaked xAI key rotated. Until a SECOND family can run, the
-// family-floor guard correctly PARKS jobs (it does not lower the bar) — see
-// migration 005. That is the safe failure, not a bug.
+// The panel is HIGHER-TIER cross-family reviewers of a local build. Three runners
+// exist today: claude-cli, codex (needs the codex login), and xai (needs XAI_API_KEY
+// in the environment). If fewer than two families can actually run, the family-floor
+// guard correctly PARKS jobs (it does not lower the bar) — see migration 005. That is
+// the safe failure, not a bug.
 // ---------------------------------------------------------------------------
 [gauntlet]
 reviewers = ["reviewer", "brain", "grok"]   // claude · gpt · grok — real seats, all resolve
 min_model_families = 2                      // §6 floor; we can reach 4
 escalate_to = "reviewer"                    // needs_human resolution seat
 escalate_to_human_on = ["needs_human"]      // ...or Neill's queue

