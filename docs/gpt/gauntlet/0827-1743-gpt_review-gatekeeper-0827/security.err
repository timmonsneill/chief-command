     1	#!/usr/bin/env sh
     2	# pre-push — refuses to push commits the reviewers have not seen, and refuses to
     3	# push a red test suite.
     4	#
     5	# scripts/mark-reviewed.sh writes HEAD into .git/.reviewers-ran-at-hash after the
     6	# review pass. This hook allows a push only if every pushed commit IS the marked one
     7	# or is an ancestor of it.
     8	#
     9	# Git hooks are advisory, not a security boundary: --no-verify walks past them. This
    10	# is a tripwire for the failure mode that has actually happened here — an agent
    11	# pushing before all reviewers reported (see docs/HANDOFF_2026-07-21.md). Real
    12	# enforcement is GitHub branch protection, which is Neill's task.
    13	set -e
    14	ROOT=$(git rev-parse --show-toplevel)
    15	MARKER="$(git rev-parse --git-common-dir)/.reviewers-ran-at-hash"
    16	
    17	if [ "${SKIP_TESTS:-0}" != "1" ] && [ -x "$ROOT/.venv/bin/python" ]; then
    18	  echo "→ pre-push: running the harness tests..."
    19	  if ! (cd "$ROOT" && .venv/bin/python -m pytest harness/tests/ -q -p no:cacheprovider 2>&1 | tail -3); then
    20	    echo "🛑 BLOCKED: tests failed. Fix them, then push."; exit 1
    21	  fi
    22	fi
    23	
    24	[ -f "$MARKER" ] || { echo "🛑 BLOCKED: no reviewer marker. Run the reviewers, then ./scripts/mark-reviewed.sh"; exit 1; }
    25	MARKED=$(cat "$MARKER")
    26	ZERO=0000000000000000000000000000000000000000
    27	saw=0
    28	while read -r local_ref local_sha remote_ref remote_sha; do
    29	  saw=1
    30	  [ "$local_sha" = "$ZERO" ] && continue            # deleting a remote branch
    31	  if [ "$local_sha" = "$MARKED" ] || git merge-base --is-ancestor "$local_sha" "$MARKED" 2>/dev/null; then
    32	    continue
    33	  fi
    34	  echo "🛑 BLOCKED: $local_ref points at $local_sha but the reviewers last ran on $MARKED."
    35	  echo "   Run the reviewers on this commit, then ./scripts/mark-reviewed.sh"
    36	  exit 1
    37	done
    38	exit 0
     1	#!/usr/bin/env sh
     2	# Record that the reviewers ran on the CURRENT commit. The pre-push hook reads this
     3	# and refuses to push anything the reviewers have not seen. New commits invalidate it.
     4	# Running this before the reviewers actually ran is lying to the gate — don't.
     5	set -e
     6	git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "Not in a git repo."; exit 1; }
     7	# --git-common-dir so linked worktrees share one marker.
     8	MARKER="$(git rev-parse --git-common-dir)/.reviewers-ran-at-hash"
     9	HEAD_SHA=$(git rev-parse HEAD)
    10	printf '%s\n' "$HEAD_SHA" > "$MARKER"
    11	echo "✓ Marked $HEAD_SHA as reviewed. Any new commit after this blocks push again."
