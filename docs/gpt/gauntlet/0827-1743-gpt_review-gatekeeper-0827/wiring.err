docs/sol/sol_out.txt:8885:/bin/zsh -lc ".venv/bin/python -c \"exec(compile('''import sqlite3\\nfrom pathlib import Path\\nc=sqlite3.connect(':memory:')\\nc.row_factory=sqlite3.Row\\nc.executescript(Path('harness/db/schema.sql').read_text())\\nseats=[('coal','ollama','qwen','qwen','local'),('gpt1','codex','terra','gpt','subscription'),('gpt2','codex','sol','gpt','subscription'),('grok','xai','grok','grok','metered')]\\nc.executemany('insert into seats(id,provider,model,family,tier) values(?,?,?,?,?)',seats)\\ndef job(seat,tier,fam,required=0):\\n cur=c.execute('insert into jobs(request,builder_seat,builder_tier,builder_family,required_reviews) values(?,?,?,?,?)',('x',seat,tier,fam,required)); return cur.lastrowid\\n# paid work can finish with zero reviews\\nj=job('gpt1','subscription','gpt'); c.execute(\\\"update jobs set status='done' where id=?\\\",(j,)); print('paid_zero_reviews',c.execute('select status from jobs where id=?',(j,)).fetchone()[0])\\n# two same-family reviewers satisfy a two-review panel\\nj=job('grok','metered','grok',2)\\nfor s in ('gpt1','gpt2'): c.execute(\\\"insert into verdicts(job_id,reviewer_seat,reviewer_tier,role,model_family,verdict) values(?,?,?,'reviewer','gpt','pass')\\\",(j,s,'subscription'))\\nc.execute(\\\"update jobs set status='done' where id=?\\\",(j,)); print('same_family_panel',c.execute('select status from jobs where id=?',(j,)).fetchone()[0])\\n# nonexistent path claimed as playwright evidence is accepted\\nj=job('gpt1','subscription','gpt'); c.execute(\\\"insert into artifacts(job_id,kind,path,captured_by) values(?,'screenshot','/does/not/exist.png','playwright')\\\",(j,)); c.execute(\\\"insert into verdicts(job_id,reviewer_seat,reviewer_tier,role,model_family,verdict) values(?,'grok','metered','tester','grok','pass')\\\",(j,)); print('fake_evidence_tester','accepted')\\n# failing verdict can be deleted\\nc.execute(\\\"insert into verdicts(job_id,reviewer_seat,reviewer_tier,role,model_family,verdict) values(?,'gpt1','subscription','reviewer','gpt','fail')\\\",(j,)); c.execute(\\\"delete from verdicts where job_id=? and verdict='fail'\\\",(j,)); print('deleted_failures',c.execute(\\\"select count(*) from verdicts where job_id=? and verdict='fail'\\\",(j,)).fetchone()[0])\\n# approval can be born granted without readback or recovery\\nc.execute(\\\"insert into approvals(capability,action,read_back,reversible,recovery,granted_at,expires_at) values('delete_data','delete everything','',0,NULL,datetime('now'),datetime('now','+5 minutes'))\\\"); print('born_granted_approval',c.execute('select count(*) from live_approvals').fetchone()[0])\\n''','<memory>','exec'))\"" in /Users/user/code-projects/chief-command
