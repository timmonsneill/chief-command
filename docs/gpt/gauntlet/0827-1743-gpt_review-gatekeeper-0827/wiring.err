   140	# ── Plain-English status. He should never see a machine word. ────────────────
   226	def _why_blocked(c, j) -> str | None:
   227	    """The single most useful string on the screen: what is this waiting for?"""
   228	    if j["status"] in ("shipped", "failed", "cancelled"):
   229	        return None
   230	
   231	    if any(v["verdict"] == "needs_human" for v in j["verdicts"]):
   232	        return "Someone needs to make a call on this — the reviewers disagreed."
   233	
   234	    if j["status"] == "done":
   235	        has_tester = any(v["role"] == "tester" and v["verdict"] == "pass" for v in j["verdicts"])
   236	        if not has_tester:
   237	            return "Nobody has actually opened it and used it yet."
   238	        return None
   239	
   240	    if j["status"] == "review":
   241	        if j["builder_tier"] == "local":
   242	            paid = any(v["reviewer_tier"] in ("subscription", "metered") and v["verdict"] == "pass"
   243	                       for v in j["verdicts"])
   244	            if not paid:
   245	                return "Coal wrote this. It can't go anywhere until a better model checks it."
   246	        if any(v["verdict"] == "fail" for v in j["verdicts"]):
   247	            return "A reviewer sent this back. It needs another go."
   248	        need = j["required_reviews"] or 0
   249	        got = len({v["reviewer_seat"] for v in j["verdicts"] if v["verdict"] == "pass"})
   250	        if need and got < need:
   251	            return f"Waiting on the others — {got} of {need} have looked at it."
   252	        # The seat count can be satisfied while the FAMILY floor isn't — three seats
   253	        # that are all the same underlying model is one mind in three hats. Say which
   254	        # wall it's actually behind, or the page reads "2 of 2 done" next to a job that
   255	        # is visibly not moving. (task #10)
   256	        need_fams = j["required_review_families"] or 0
   257	        fams = {v["model_family"] for v in j["verdicts"] if v["verdict"] == "pass"}
   258	        if need_fams and len(fams) < need_fams:
   259	            return (f"Only {len(fams)} of {need_fams} different models have checked it — "
   260	                    "it needs a second opinion from a different kind of model.")
   261	    return None
