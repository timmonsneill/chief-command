   163	            (s["id"],)
   164	        ).fetchone()["v"]
   165	        s["spent_today_cents"] = int(spent)
   166	        s["color"] = FAMILY_COLOR.get(s["family"], "#7E90A8")
   167	
   168	    jobs = []
   169	    for r in c.execute(
   170	        """SELECT j.*, s.model AS builder_model
   171	             FROM jobs j JOIN seats s ON s.id = j.builder_seat
   172	            ORDER BY j.id DESC LIMIT 40"""
   173	    ):
   174	        j = dict(r)
   175	        word, tone = STATUS_WORDS.get(j["status"], (j["status"], "waiting"))
   176	        j["status_word"] = word
   177	        j["tone"] = tone
   178	        j["color"] = FAMILY_COLOR.get(j["builder_family"], "#7E90A8")
   179	        j["verdicts"] = [dict(v) for v in c.execute(
   180	            "SELECT reviewer_seat, reviewer_tier, model_family, role, verdict, summary "
   181	            "FROM verdicts WHERE job_id=? ORDER BY id", (j["id"],)
   182	        )]
   183	        for v in j["verdicts"]:
   184	            v["color"] = FAMILY_COLOR.get(v["model_family"], "#7E90A8")
   185	        # ⚠️ Sol's review: "The web app explicitly leaks filenames, commands, model
   186	        # names, and jargon. The detailed work view displays raw event type, target,
   187	        # and detail. Those fields are DESIGNED to contain filenames, commands, web
   188	        # addresses, and machine output. The plain-English requirement is contradicted
   189	        # by the interface itself."
   190	        #
   191	        # He's right, and it broke the one promise that matters most. So the API now
   192	        # TRANSLATES events before they leave the server. The raw fields still exist in
   193	        # the database — they're what an engineer would need — but they never reach
   194	        # Neill's screen.
   195	        j["events"] = [_in_plain_english(dict(e)) for e in c.execute(
   196	            "SELECT kind, target, detail, lane, model FROM events WHERE job_id=? ORDER BY id",
   197	            (j["id"],)
   198	        )]
   199	        # Why is this stuck? In words he can act on.
   200	        j["blocked_because"] = _why_blocked(c, j)
   201	        jobs.append(j)
   202	
   203	    from db.planning import todos_for, attachments_for
   204	
   205	    projects = [dict(r) for r in c.execute("SELECT * FROM projects WHERE archived=0")]
   206	    for p in projects:
   207	        p["memory"] = [dict(m) for m in c.execute(
   208	            "SELECT kind, fact FROM project_memory WHERE project_id=? ORDER BY id DESC LIMIT 30",
   209	            (p["id"],)
   210	        )]
   211	        p["plan"] = [dict(x) for x in c.execute(
   212	            "SELECT * FROM plan_items WHERE project_id=? ORDER BY position, id", (p["id"],)
   213	        )]
   214	        p["todos"] = todos_for(c, p["id"])
   215	        p["todo_open"] = c.execute(
   216	            "SELECT COUNT(*) n FROM todos WHERE project_id=? AND done=0", (p["id"],)
   217	        ).fetchone()["n"]
   218	        p["attachments"] = attachments_for(c, p["id"])
   219	        p["job_count"] = c.execute(
   220	            "SELECT COUNT(*) n FROM jobs WHERE project_id=?", (p["id"],)
   221	        ).fetchone()["n"]
   222	
   223	    return {"seats": seats, "jobs": jobs, "projects": projects}
