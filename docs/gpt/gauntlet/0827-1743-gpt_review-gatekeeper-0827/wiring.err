    91	
    92	# ── The plain-English layer. He must never see a machine word. ───────────────
    93	#
    94	# Sol caught the UI leaking filenames and shell commands straight into the detail view.
    95	# This is the translation layer that stops it. The rule from AGENTS.md:
    96	#
    97	#     "If you cannot explain what you did without jargon, you do not yet understand
    98	#      what you did."
    99	
   100	_EVENT_ENGLISH = {
   101	    "dispatched": "Picked it up",
   102	    "read":       "Read through the existing code",
   103	    "thinking":   "Worked out how to do it",
   104	    "edit":       "Changed the code",
   105	    "write":      "Wrote new code",
   106	    "command":    "Ran something",
   107	    "test_run":   "Ran the tests",
   108	    "browse":     "Clicked through it like a user",
   109	    "verdict":    "Gave a verdict",
   110	    "done":       "Finished",
   111	    "error":      "Hit a problem",
   112	    # A reviewer that sat out MUST NOT read as one that worked. Without this line it
   113	    # fell through to the default "Worked on it" — the record was honest about the
   114	    # panel shrinking and the screen quietly contradicted it. (task #10)
   115	    "skipped":    "Sat this one out",
   116	}
   117	
   118	
   119	def _in_plain_english(e: dict) -> dict:
   120	    """Translate one line of machine activity into something a person can read.
   121	
   122	    NOTE the deliberate asymmetry: we keep the OUTCOME of a test run ("6 passed") but
   123	    drop the COMMAND that produced it ("pytest -q"). The outcome is a fact about the
   124	    work. The command is a fact about the tooling, and Neill doesn't use the tooling.
   125	    """
   126	    kind = e.get("kind", "")
   127	    what = _EVENT_ENGLISH.get(kind, "Worked on it")
   128	    out = {"what": what, "kind": kind}
   129	
   130	    detail = (e.get("detail") or "").strip()
   131	    # Keep a detail ONLY if it reads like a RESULT, not a machine artifact — and not if
   132	    # it's just restating the line it's attached to.
   133	    looks_technical = any(c in detail for c in ("/", "\\", ".py", ".ts", ".sql", "()", "--"))
   134	    is_redundant = detail.lower().strip(".") == what.lower().strip(".")
   135	    if detail and not looks_technical and not is_redundant:
   136	        out["note"] = detail
   137	    return out
