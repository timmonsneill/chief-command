   491	# The service — loopback only, and only these three verbs
   492	# ---------------------------------------------------------------------------
   493	def handle(request: dict[str, Any], *, db_path: Path | None = None) -> dict[str, Any]:
   494	    """One request in, one answer out. The whole surface area of the gatekeeper.
   495	
   496	    An unknown verb is refused without being examined further. This is the check that
   497	    keeps rule 1 true as the file grows.
   498	    """
   499	    verb = request.get("verb")
   500	    if verb not in VERBS:
   501	        return {"ok": False, "error": "the gatekeeper only does three things: "
   502	                                      "merge, deploy, spend"}
   503	
   504	    conn = connect(db_path or DB_PATH)
   505	    try:
   506	        asked_by = str(request.get("asked_by") or "unknown")
   507	        try:
   508	            if verb == "merge":
   509	                r = merge(conn, int(request["job_id"]), asked_by=asked_by)
   510	            elif verb == "deploy":
   511	                r = deploy(conn, str(request["target"]),
   512	                           job_id=_known_job(conn, request.get("job_id")), asked_by=asked_by)
   513	            else:
   514	                r = spend(conn, str(request["seat_id"]), int(request["cents"]),
   515	                          job_id=_known_job(conn, request.get("job_id")),
   516	                          role=str(request.get("role") or "build"), asked_by=asked_by)
   517	        except Refused as exc:
   518	            return {"ok": False, "error": str(exc)}
   519	        except (KeyError, ValueError, TypeError) as exc:
   520	            return {"ok": False, "error": f"that request didn't make sense: {exc}"}
   521	        except sqlite3.Error as exc:
   522	            return {"ok": False, "error": f"the record refused that: {_plain(exc)}"}
   523	        return {"ok": True, "verb": r.verb, "subject": r.subject,
   524	                "detail": r.detail, "reference": r.reference}
   525	    finally:
   526	        conn.close()
