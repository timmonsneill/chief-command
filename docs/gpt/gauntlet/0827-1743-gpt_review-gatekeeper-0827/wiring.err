   305	        return {"reply": answer, "holding": dig_in(), "seconds": round(secs, 1), "tier": "deep"}
   306	
   307	    if needs_the_brain(utterance):
   308	        answer, secs = think(utterance, context=_project_context(), tier=THINK_FAST)
   309	        return {"reply": answer, "holding": cover_the_gap(), "seconds": round(secs, 1), "tier": "think"}
   310	
   311	    return {"reply": _handle_directly(utterance), "tier": "instant", "seconds": 0}
   312	
   313	
   314	def _project_context() -> str:
   315	    """What Chief needs to know before answering: the REAL project list first (so it
   316	    stops improvising what Neill is working on), then loose facts we've gathered."""
   317	    from db.projects import projects_context
   318	
   319	    c = db()
   320	    parts = []
   321	    real = projects_context(c)
   322	    if real:
   323	        parts.append(real)
   324	    rows = c.execute("SELECT fact FROM project_memory ORDER BY id DESC LIMIT 12").fetchall()
   325	    facts = " ".join(r["fact"] for r in rows)
   326	    if facts:
   327	        parts.append(f"What we know about this project: {facts}")
   328	    return "\n\n".join(parts)
   329	
   330	
   331	def _handle_directly(u: str) -> str:
   332	    """The six things the mouth may answer alone. Everything else already went upstairs."""
   333	    c = db()
   334	    low = u.lower()
   335	
   336	    if any(w in low for w in ("overnight", "last night", "what ran", "what shipped", "what happened")):
   337	        rows = c.execute(
   338	            "SELECT status, COUNT(*) n FROM jobs WHERE created_at >= datetime('now','-1 day') "
   339	            "GROUP BY status"
   340	        ).fetchall()
   341	        if not rows:
   342	            return "Nothing ran overnight."
   343	        counts = {r["status"]: r["n"] for r in rows}
   344	        bits = []
   345	        if counts.get("shipped"): bits.append(f"{counts['shipped']} finished")
   346	        if counts.get("review"):  bits.append(f"{counts['review']} waiting on the others")
   347	        if counts.get("failed"):  bits.append(f"{counts['failed']} broke")
   348	        return (", ".join(bits) + ".") if bits else "Nothing finished overnight."
   349	
   350	    if any(w in low for w in ("status", "going", "doing", "update")):
   351	        row = c.execute(
   352	            "SELECT j.task_name, j.status, j.builder_seat FROM jobs j "
   353	            "WHERE j.status IN ('in_progress','review') ORDER BY j.id DESC LIMIT 1"
   354	        ).fetchone()
   355	        if not row:
   356	            return "Nothing's running right now."
   357	        who = row["builder_seat"].title()
   358	        thing = row["task_name"] or "it"
   359	        return (f"{who} is on {thing}." if row["status"] == "in_progress"
   360	                else f"{who} finished {thing}. The others are checking it.")
   361	
   362	    return "Got it."
   363	
   364	
   365	# ═══════════════════════════════════════════════════════════════════════════════
   366	# DISPATCH — where "putting someone on it" stops being a figure of speech.
   367	#
   368	# This starts a REAL worker. Today it runs the free local coder, so the whole loop
   369	# can be exercised with no money and no keys: you type a job, a real model builds it
   370	# in its own isolated copy of the code, and a stronger model checks it before it can
   371	# be called done. The paid coding seats will hang off this same path through OpenClaw.
   372	# ═══════════════════════════════════════════════════════════════════════════════
   373	def _pick_local_builder(c) -> str | None:
   374	    """The free local coder, whatever it's named in this database."""
   375	    row = c.execute(
   376	        "SELECT id FROM seats WHERE provider = 'ollama' AND enabled = 1 ORDER BY id LIMIT 1"
   377	    ).fetchone()
   378	    return row["id"] if row else None
   379	
   380	
   381	# Who reviews is NOT the server's decision any more (task #10). It used to hand-pick a
   382	# single Claude seat here, which quietly made "one reviewer" the real policy no matter
   383	# what the gauntlet config said. The panel now comes from the config, and the family
   384	# floor decides whether it's enough.
   385	
   386	
   387	@app.post("/api/dispatch")
   388	async def dispatch_endpoint(request: Request):
   389	    """Give the team a real job. Non-blocking: returns as soon as it's recorded and
   390	    the worker has started, so the page stays live while the work grinds."""
   391	    import dispatch as dispatch_mod
   392	
   393	    body = await request.json()
   394	    text = (body.get("text") or "").strip()
   395	    if not text:
   396	        return JSONResponse({"error": "Say what to build."}, status_code=400)
   397	    # The client stamps a nonce so a double-tap or a re-send can't start it twice.
   398	    nonce = (body.get("nonce") or "").strip() or None
   399	
   400	    c = db()
   401	    builder = _pick_local_builder(c)
   402	    if not builder:
   403	        return JSONResponse(
   404	            {"error": "The free local coder isn't available on this machine right now."},
   405	            status_code=503,
   406	        )
   407	    try:
   408	        d = dispatch_mod.dispatch_local(
   409	            c, text, builder, origin="text", dispatch_key=nonce,
   410	        )
   411	    except dispatch_mod.DispatchRefused as exc:
   412	        return JSONResponse({"error": str(exc)}, status_code=409)
   413	
   414	    who = builder.title()
   415	    if d.reused:
   416	        reply = f"Already on it — {who} picked that up a moment ago."
   417	    else:
   418	        reply = (f"{who} is on it. A panel of different models will check the work "
   419	                 "before it's called done.")
   420	    return {"job_id": d.job_id, "reused": d.reused, "reply": reply, "builder": builder}
   421	
   422	
   423	# ═══════════════════════════════════════════════════════════════════════════════
   424	# TODOS — the checklist that lives in the command center, grouped by project and by
   425	# the owner's own sections ("Now", "Later", "Post-launch"). No more jumping windows.
   426	# ═══════════════════════════════════════════════════════════════════════════════
   427	@app.post("/api/projects/{project_id}/todos")
   428	async def add_todo_endpoint(project_id: str, request: Request):
   429	    from db.planning import add_todo
   430	    body = await request.json()
   620	    (on error, or a fresh boot). That's the right call for a single owner talking; the
   621	    list rarely changes inside one drive.
   622	    """
   623	    global _chief_session
   624	    if _chief_session is None:
   625	        from chief_live import ChiefSession
   626	        from db.projects import projects_context
   627	        _chief_session = ChiefSession(extra_context=projects_context(db()))
   628	    return _chief_session
   629	
   630	
   631	@app.post("/api/voice/ask")
   632	async def voice_ask(request: Request):
   633	    """The mouth's ONE tool. Everything Neill says arrives here and goes to Chief.
   634	
   635	    The mouth decides nothing. It doesn't even decide whether something is worth
   636	    sending — because "is this worth sending?" is a judgment, and judgments are where
   637	    this leaked twice.
   638	    """
   639	    body = await request.json()
   640	    said = (body.get("said") or "").strip()
   641	    if not said:
   642	        return {"spoken": "I didn't catch that."}
   643	
   644	    from mouth import is_pushback
   645	    pushed_back = is_pushback(said)
   646	
   647	    # The fast path: the LIVE streaming session (metered API, but text is pennies, and
   648	    # it's the difference between a one-second "yeah" and an eight-second one). Falls
   649	    # back to the free-but-slow subprocess brain when there's no API key to think with.
   650	    if os.environ.get("OPENAI_API_KEY"):
   651	        async with _chief_lock:
   652	            session = _live_session()
   653	            try:
   654	                pieces: list[str] = []
   655	                async for sentence in session.say(said, deep=pushed_back):
   656	                    pieces.append(sentence)
   657	                answer = " ".join(pieces).strip()
   658	            except Exception:
   659	                # A wedged session must not wedge the conversation. Drop it; the next
   660	                # utterance rebuilds a clean one. We do NOT silently guess an answer.
   661	                global _chief_session
   662	                _chief_session = None
   663	                answer = ""
   664	        if answer:
   665	            from chief import _for_speech
   666	            out = {"spoken": _for_speech(answer), "full": answer,
   667	                   "model": _CHIEF_MODEL, "failed": False}
   668	        else:
   669	            out = {"spoken": "Something went wrong on my end. Nothing's started.",
   670	                   "full": "Chief returned nothing. No work was dispatched.",
   671	                   "model": _CHIEF_MODEL, "failed": True}
   672	    else:
   673	        # No live session to carry the thread, so the fallback must be handed BOTH the
   674	        # real project list AND what they were just talking about — otherwise it loses the
   675	        # per-turn continuity the streaming path keeps in session memory.
   676	        talking_about = (body.get("context") or "").strip()
   677	        context = "\n\n".join(p for p in (_project_context(), talking_about) if p)
   678	        out = ask_chief(said, context=context, pushed_back=pushed_back)
   679	
   680	    # Everything Chief says goes on the record, so the text channel always has the full
   681	    # version of anything he only half-heard in the car.
   682	    c = db()
   683	    c.execute(
   684	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   685	        "SELECT id, 'chief', 'chief', ?, 'gpt', 'thinking', ? FROM jobs ORDER BY id DESC LIMIT 1",
   686	        (out.get("model", _CHIEF_MODEL), out["full"][:500]),
   687	    )
   688	    return out
   689	
   690	
   691	@app.get("/voice", response_class=HTMLResponse)
   692	def voice_page():
   693	    return (Path(__file__).resolve().parent / "web" / "voice.html").read_text()
   694	
   695	
   696	@app.get("/", response_class=HTMLResponse)
   697	def index():
   698	    return (Path(__file__).resolve().parent / "web" / "index.html").read_text()
   699	
   700	
   701	# ---------------------------------------------------------------------------
   702	# PWA plumbing — lets Neill "install" the command center as a desktop/phone app
   703	# straight from the browser. No service worker on purpose: the app is useless
   704	# without its server anyway, and a stale offline cache showing yesterday's fleet
   705	# as if it were live would be a lie of exactly the kind this harness exists to
   706	# prevent.
   707	# ---------------------------------------------------------------------------
   708	_WEB = Path(__file__).resolve().parent / "web"
   709	
   710	
   711	@app.get("/manifest.json")
   712	def manifest():
   713	    return FileResponse(_WEB / "manifest.json", media_type="application/manifest+json")
   714	
   715	
   716	@app.get("/icon.svg")
   717	def icon_svg():
   718	    return FileResponse(_WEB / "icon.svg", media_type="image/svg+xml")
