   382	# ---------------------------------------------------------------------------
   383	# The gauntlet (spec §6)
   384	# ---------------------------------------------------------------------------
   385	def run_gauntlet(conn, job_id: int, cfg: dict[str, Any]) -> dict[str, Any]:
   386	    """Fan the finished work out to the reviewer panel, in parallel, same bundle.
   387	
   388	    This used to return a list of reviewer NAMES and launch nobody — the gauntlet was a
   389	    plan, not a thing that ran (task #10). It now runs the panel and returns what
   390	    actually happened: who reviewed, which families, what they said, and — if the job
   391	    stayed parked — why, in plain words.
   392	
   393	    The model-diversity rule (§6) still isn't asserted here; it's RECORDED. Every
   394	    verdict snapshots the reviewing seat's family, and the schema refuses to complete a
   395	    job without enough distinct families passing THIS version. So "two different minds
   396	    looked at this" is a fact you can query, not a promise this function made.
   397	    """
   398	    import gauntlet as gauntlet_mod
   399	
   400	    return gauntlet_mod.run_gauntlet_for_job(conn, job_id, cfg).as_dict()
