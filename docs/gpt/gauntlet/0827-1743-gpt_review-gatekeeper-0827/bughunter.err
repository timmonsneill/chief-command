   358	# MERGE, FOR REAL — against an actual git repo, the check the verb exists for
   359	# ═══════════════════════════════════════════════════════════════════════════════
   360	def _git(repo, *args):
   361	    import subprocess
   362	    env = {"GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t",
   363	           "GIT_COMMITTER_EMAIL": "t@t", "PATH": __import__("os").environ["PATH"],
   364	           "HOME": str(repo)}
   365	    out = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True, env=env)
   366	    assert out.returncode == 0, out.stderr
   367	    return out.stdout.strip()
   368	
   369	
   370	@pytest.fixture()
   371	def repo(tmp_path, monkeypatch):
   372	    r = tmp_path / "repo"; r.mkdir()
   373	    _git(r, "init", "-q", "-b", "main")
   374	    (r / "README").write_text("v0\n"); _git(r, "add", "."); _git(r, "commit", "-q", "-m", "root")
   375	    monkeypatch.setattr(gatekeeper, "REPO", r)
   376	    return r
   377	
   378	
   379	def _job_on_branch(conn, repo, job_id, content):
   380	    _git(repo, "checkout", "-q", "-b", f"job/{job_id}")
   381	    (repo / "work.txt").write_text(content); _git(repo, "add", "."); _git(repo, "commit", "-q", "-m", "work")
   382	    sha = _git(repo, "rev-parse", "HEAD")
   383	    _git(repo, "checkout", "-q", "main")
   384	    conn.execute("UPDATE jobs SET branch = ? WHERE id = ?", (f"job/{job_id}", job_id))
   385	    return sha
   386	
   387	
   388	def test_merge_goes_through_when_the_branch_tip_is_the_reviewed_version(conn, repo):
   389	    job = create_job(conn, "the login form", builder_seat="reviewer")
   390	    conn.execute("UPDATE jobs SET required_reviews=2, required_review_families=2 WHERE id=?", (job,))
   391	    set_status(conn, job, "in_progress")
   392	    sha = _job_on_branch(conn, repo, job, "reviewed bytes\n")
   393	    set_head_version(conn, job, sha[:16])                   # what the worker records
   394	    set_status(conn, job, "review")
   395	    for s in ("brain", "grok"):
   396	        record_verdict(conn, job, s, verdict="pass", role="reviewer")
   397	    set_status(conn, job, "done")
   398	    record_artifact(conn, job, "screenshot", path="/evidence/login.png", captured_by="playwright")
   399	    record_verdict(conn, job, "grok", verdict="pass", role="tester")
   400	
   401	    r = gatekeeper.merge(conn, job, asked_by="the panel")
   402	    assert r.verb == "merge"
   403	    assert conn.execute("SELECT status FROM jobs WHERE id=?", (job,)).fetchone()["status"] == "shipped"
   404	    assert (repo / "work.txt").read_text() == "reviewed bytes\n"      # it is on main
   405	    assert _gate_rows(conn)[-1]["granted"] == 1
   406	
   407	
   408	def test_merge_refuses_when_the_branch_moved_after_review(conn, repo):
   409	    """Build v1, get it approved, push v2 to the same branch, ask to merge: v2 must NOT
   410	    go in. This is the check the verb exists for, and it had no test that reached it."""
   411	    job = create_job(conn, "the login form", builder_seat="reviewer")
   412	    conn.execute("UPDATE jobs SET required_reviews=2, required_review_families=2 WHERE id=?", (job,))
   413	    set_status(conn, job, "in_progress")
   414	    sha1 = _job_on_branch(conn, repo, job, "v1\n")
   415	    set_head_version(conn, job, sha1[:16])
   416	    set_status(conn, job, "review")
   417	    for s in ("brain", "grok"):
   418	        record_verdict(conn, job, s, verdict="pass", role="reviewer")
   419	    set_status(conn, job, "done")
   420	    # the builder pushes v2 to the same branch, record untouched
   421	    _git(repo, "checkout", "-q", f"job/{job}")
   422	    (repo / "work.txt").write_text("v2\n"); _git(repo, "add", "."); _git(repo, "commit", "-q", "-m", "v2")
   423	    _git(repo, "checkout", "-q", "main")
   424	
   425	    with pytest.raises(gatekeeper.Refused, match="isn't the code that was reviewed"):
   426	        gatekeeper.merge(conn, job)
   427	    assert not (repo / "work.txt").exists()
   428	    assert conn.execute("SELECT status FROM jobs WHERE id=?", (job,)).fetchone()["status"] == "done"
   300	
   301	    The completion guards only fire on the way INTO done, so a late objection could
   302	    never stop anything — the job sat at 'done' with a recorded failure against it.
   303	    """
   304	    c, path = db
   305	    monkeypatch.setattr(gauntlet, "REVIEW_TIMEOUT_S", 0)   # forces the join to give up
   306	    monkeypatch.setattr(gauntlet, "JOIN_GRACE_S", 0)
   307	
   308	    def runner(request, code, model):
   309	        if model == "grok-4.5":
   310	            time.sleep(0.6)                                # answers after the decision
   311	            return "fail", "found a real problem"
   312	        return "pass", "ok"
   313	
   314	    _wire(monkeypatch, runner)
   315	    job = _parked_job(c, seats_required=2, families_required=2)
   316	    cfg = {"seats": {}, "gauntlet": {"reviewers": ["reviewer", "brain", "grok"],
   317	                                     "min_model_families": 2}}
   318	
   319	    r = gauntlet.run_gauntlet_for_job(c, job, cfg, db_path=path)
   320	    time.sleep(1.0)                                        # let the straggler finish
   321	
   322	    status = c.execute("SELECT status FROM jobs WHERE id=?", (job,)).fetchone()[0]
   323	    fails = c.execute("SELECT COUNT(*) FROM verdicts WHERE job_id=? AND verdict='fail'",
   324	                      (job,)).fetchone()[0]
   325	    assert not (status == "done" and fails), \
   326	        "a job is sitting at done with a recorded failure against it"
   327	    grok = [x for x in r.runs if x.seat_id == "grok"][0]
   328	    assert grok.skipped, "a reviewer that never answered must be recorded as such"
   329	
   330	
   331	def test_a_late_failure_un_certifies_the_job(db, monkeypatch):
   332	    """Belt to the flag's braces: if a fail lands anyway, the reconcile catches it."""
   333	    c, path = db
   334	    _wire(monkeypatch, _stub({"claude-opus-4-8": "pass", "gpt-5.6-sol": "pass"}))
   335	    job = _parked_job(c)
   336	
   337	    real_set_status = gauntlet.set_status
   338	
   339	    def sneak(conn, job_id, status, **kw):
   340	        real_set_status(conn, job_id, status, **kw)
   341	        if status == "done":                       # a straggler writes the instant we commit
   342	            conn.execute(
