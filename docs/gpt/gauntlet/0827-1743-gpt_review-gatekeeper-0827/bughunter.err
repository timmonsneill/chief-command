   120	    """
   121	    conn.execute(
   122	        "INSERT INTO gate_log (verb, subject, granted, detail, asked_by, job_id) "
   123	        "VALUES (?,?,?,?,?,?)",
   124	        (verb, _clean(subject), int(granted), _clean(detail, 400),
   125	         _clean(asked_by, 60), job_id),
   126	    )
