   349	
   350	    assert r.certified is False, "a late failure did not un-certify the job"
   351	    assert c.execute("SELECT status FROM jobs WHERE id=?", (job,)).fetchone()[0] == "review"
   352	
   353	
   354	def test_a_broken_reviewer_tool_is_not_a_failing_verdict(db, monkeypatch):
   355	    """An expired login or a renamed model must not condemn the BUILD.
   356	
   357	    Verdicts are permanent and version-bound, so recording a fail here would blame the
   358	    builder for an infrastructure fault and no rebuild could ever clear it.
   359	    """
   360	    c, path = db
   361	
   362	    def runner(request, code, model):
   363	        if model == "gpt-5.6-sol":
   364	            raise gauntlet.ReviewerBroke("codex exited 1: not logged in")
   365	        return "pass", "ok"
   366	
   367	    _wire(monkeypatch, runner)
   368	    job = _parked_job(c)
   369	
   370	    r = gauntlet.run_gauntlet_for_job(c, job, CFG, db_path=path)
   371	
   372	    assert r.failed == [], "a broken tool was recorded as a failing review"
   373	    fails = c.execute("SELECT COUNT(*) FROM verdicts WHERE job_id=? AND verdict='fail'",
   374	                      (job,)).fetchone()[0]
   375	    assert fails == 0
   376	    brain = [x for x in r.runs if x.seat_id == "brain"][0]
   377	    assert "couldn't run" in brain.skipped
   378	    assert r.certified is False
   379	
   380	
   381	def test_a_nonzero_exit_code_never_becomes_a_verdict(monkeypatch):
   382	    """The CLI printed a friendly error and exited 1 — that is not a review."""
   383	    class Proc:
   384	        returncode = 1
   385	        stdout = "There's an issue with the selected model. It may not exist."
   386	        stderr = ""
   387	    monkeypatch.setattr(gauntlet.subprocess, "run", lambda *a, **k: Proc())
   388	    with pytest.raises(gauntlet.ReviewerBroke):
   389	        gauntlet._run_cli(["claude", "-p", "whatever"])
   390	
   391	
   392	def test_the_verdict_is_read_from_the_end_not_the_start():
   393	    """Our own prompt contains the words PASS and FAIL. If a CLI ever echoes its input
   394	    to stdout, reading forwards would return an automatic pass on every review."""
   395	    echoed = gauntlet.REVIEW_PROMPT.format(request="r", code="c") + "\nFAIL it is broken"
   396	    assert gauntlet._parse_verdict(echoed) [0] == "fail"
   397	
   398	
   399	def test_a_reviewer_that_dies_before_running_is_still_accounted_for(db, monkeypatch):
   400	    """Anything escaping the worker used to kill the thread with the run left blank —
   401	    neither counted nor excused, and invisible in the result."""
   402	    c, path = db
   403	    _wire(monkeypatch, _stub({"claude-opus-4-8": "pass", "gpt-5.6-sol": "pass"}))
   404	    job = _parked_job(c)
   405	
   406	    real_event = gauntlet._event
   407	
   408	    def boom(conn, job_id, seat_row, kind, detail):
   409	        if seat_row["id"] == "brain" and kind == "thinking":
   410	            raise RuntimeError("the record blew up")
   411	        real_event(conn, job_id, seat_row, kind, detail)
   412	    monkeypatch.setattr(gauntlet, "_event", boom)
   413	
   414	    r = gauntlet.run_gauntlet_for_job(c, job, CFG, db_path=path)
   415	
   416	    brain = [x for x in r.runs if x.seat_id == "brain"][0]
   417	    assert brain.verdict is None and brain.skipped, \
   418	        "a reviewer that died left no trace in the panel result"
   419	    assert r.certified is False
   420	
   421	
   422	def test_the_panel_does_not_charge_twice_for_the_same_version(db, monkeypatch):
   423	    """Re-running the panel on a version it already judged must not re-spend or stack
   424	    duplicate verdicts on the record."""
   425	    c, path = db
   426	    calls = {"n": 0}
   427	
   428	    def runner(request, code, model):
