   127	# --------------------------------------------------------------------------
   128	# Jobs
   129	# --------------------------------------------------------------------------
   130	def create_job(
   131	    conn: sqlite3.Connection,
   132	    request: str,
   133	    builder_seat: str,
   134	    origin: str = "text",
   135	    parent_job_id: Optional[int] = None,
   136	    task_name: Optional[str] = None,
   137	) -> int:
   138	    """task_name is the 2-4 word handle the voice will use ("the rate limiter").
   139	
   140	    The mouth coins it at dispatch. Without one the voice falls back to truncating
   141	    the request, which reads back the owner's own paragraph at him — exactly what a
   142	    colleague would never do.
   143	    """
   144	    row = seat(conn, builder_seat)
   145	    if row is None:
   146	        raise ValueError(f"unknown builder seat: {builder_seat}")
   147	
   148	    # Snapshot who built this, AT BUILD TIME. Sol's cross-family review found that
   149	    # reading the builder's tier live meant re-tiering a local seat retroactively
   150	    # legitimized its old unreviewed work. What a seat is today cannot change what
   151	    # it was. The schema then freezes these columns.
   152	    cur = conn.execute(
   153	        """
   154	        INSERT INTO jobs (request, builder_seat, builder_tier, builder_family,
   155	                          origin, parent_job_id, task_name)
   156	        VALUES (?, ?, ?, ?, ?, ?, ?)
   157	        """,
   158	        (request, builder_seat, row["tier"], row["family"],
   159	         origin, parent_job_id, task_name),
   160	    )
   161	    return int(cur.lastrowid)
   162	
   163	
   164	def claim_next_job(conn: sqlite3.Connection, builder_seat: str) -> sqlite3.Row | None:
   165	    """Atomically claim the oldest queued job for this seat.
   166	
   167	    Uses UPDATE...RETURNING against a subquery so two workers racing for the same
   168	    row cannot both win — SQLite serializes the write and only one claim lands.
   169	    Cribbed from clu's approach; it removes the need for any external lock.
   170	    """
   171	    row = conn.execute(
   172	        """
   173	        UPDATE jobs
   174	           SET status = 'in_progress',
   175	               started_at = datetime('now'),
   176	               attempts = attempts + 1
   177	         WHERE id = (
   178	             SELECT id FROM jobs
   179	              WHERE status = 'todo' AND builder_seat = ?
   180	              ORDER BY id
   181	              LIMIT 1
   182	         )
   183	        RETURNING *
   184	        """,
   185	        (builder_seat,),
   186	    ).fetchone()
   187	    return row
   188	
   189	
   190	def attach_run(
   191	    conn: sqlite3.Connection,
   192	    job_id: int,
   193	    run_id: str,
   194	    session_key: str | None = None,
   195	    branch: str | None = None,
   196	    worktree: str | None = None,
   197	) -> None:
   198	    """Record the OpenClaw spawn that is actually doing the work."""
   199	    conn.execute(
   200	        """
   201	        UPDATE jobs SET run_id = ?, session_key = ?, branch = ?, worktree = ?
   202	         WHERE id = ?
   203	        """,
   204	        (run_id, session_key, branch, worktree, job_id),
   205	    )
   206	
   207	
   208	@_guarded
   209	def set_head_version(conn: sqlite3.Connection, job_id: int, version: str) -> None:
   210	    """Record the exact version (git commit id) the builder is putting forward.
   211	
   212	    This is the pivot of the review-to-version chain: every completion guard only
   213	    counts verdicts whose reviewed_version matches this. Calling it again after the
   214	    builder iterates voids all earlier approvals by construction — nothing needs to
   215	    remember to revoke them. Frozen by the schema once the job is done.
   216	    """
   217	    if not version or not version.strip():
   218	        raise ValueError("a version must actually name a version")
   219	    conn.execute(
   220	        "UPDATE jobs SET head_version = ? WHERE id = ?", (version.strip(), job_id)
   221	    )
   222	
   223	
   224	@_guarded
   225	def set_status(
   226	    conn: sqlite3.Connection,
   227	    job_id: int,
   228	    status: str,
   229	    result: str | None = None,
   230	    error: str | None = None,
   231	    spoken_summary: str | None = None,
   232	) -> None:
   233	    """Move a job's status.
   234	
   235	    Moving to 'done' runs the schema guards. If the builder was a local seat and no
   236	    higher-tier reviewer has passed it, this raises GuardViolation — by design.
   237	    """
   238	    finished = status in ("done", "failed", "cancelled")
   239	    conn.execute(
   240	        """
   241	        UPDATE jobs
   242	           SET status = ?,
   243	               result = COALESCE(?, result),
   244	               error = COALESCE(?, error),
   245	               spoken_summary = COALESCE(?, spoken_summary),
   246	               finished_at = CASE WHEN ? THEN datetime('now') ELSE finished_at END
   247	         WHERE id = ?
   248	        """,
   249	        (status, result, error, spoken_summary, int(finished), job_id),
   250	    )
   251	
   252	
   253	def record_artifact(
   254	    conn: sqlite3.Connection,
   255	    job_id: int,
   256	    kind: str,
   257	    path: str | None = None,
   258	    value: str | None = None,
   259	    flow: str | None = None,
   260	    captured_by: str = "playwright",
   261	) -> int:
   262	    """Record GROUND TRUTH.
   263	
   264	    Two kinds, and they have different rules about who may write them:
   265	
   266	    EVIDENCE OF A BUILD (screenshot, trace, logs, exit codes) — only the harness or
   267	    Playwright. NEVER a model. A model cannot fabricate a screenshot, which is what
   268	    makes "I ran it and it worked" unsayable.
   269	
   270	    EVIDENCE OF A CLAIM (source, quote) — a model MAY write these, because a
   271	    researcher's whole job is to hand you a URL you can go and read yourself. The
   272	    check isn't "who wrote it down", it's "can someone else go and look?" — which is
   273	    why a different family has to read the sources cold (guard 8).
   274	    """
   275	    _MODEL_MAY_CITE = {"source", "quote"}
   276	    if captured_by == "model" and kind not in _MODEL_MAY_CITE:
   277	        raise ValueError(
   278	            f"a model may cite a source, but it may not produce a '{kind}' — "
   279	            "build evidence is captured by the harness, never claimed by a model"
   280	        )
   281	    if captured_by not in ("harness", "playwright", "model"):
   282	        raise ValueError(f"unknown artifact origin: {captured_by}")
   283	    cur = conn.execute(
   284	        """
   285	        INSERT INTO artifacts (job_id, kind, path, value, flow, captured_by)
   286	        VALUES (?, ?, ?, ?, ?, ?)
   287	        """,
   288	        (job_id, kind, path, value, flow, captured_by),
   289	    )
   290	    return int(cur.lastrowid)
   291	
   292	
   293	@_guarded
   294	def record_verdict(
   295	    conn: sqlite3.Connection,
   296	    job_id: int,
   297	    reviewer_seat: str,
   298	    verdict: str,
   299	    severity: str | None = None,
   300	    summary: str | None = None,
   301	    detail: str | None = None,
   302	    role: str = "reviewer",
   303	    reviewed_version: str | None = None,
   304	) -> int:
   305	    """Record one seat's verdict.
   306	
   307	    role='reviewer' reads the diff and judges it.
   308	    role='tester'   drove the app (Playwright) and judges what it observed. Two guards
   309	                    apply: it must cite captured artifacts, and its family must differ
   310	                    from the builder's — Playwright stops a tester fabricating what
   311	                    happened; only a different mind stops it rationalizing it.
   312	
   313	    reviewed_version is WHAT the reviewer looked at. The gauntlet runner pins the
   314	    version before handing work to a reviewer and must pass it explicitly. When
   315	    omitted, it defaults to the job's current head_version — correct only when
   316	    nothing moved between review and recording, which the runner must guarantee.
   317	    A verdict whose version stops matching the job simply stops counting.
   318	
   319	    tier and family are snapshotted from the seat at write time, so re-tiering or
   320	    re-pointing a seat later cannot retroactively legitimize a job.
   321	    """
   322	    row = seat(conn, reviewer_seat)
   323	    if row is None:
   324	        raise ValueError(f"unknown seat: {reviewer_seat}")
   325	
   326	    if reviewed_version is None:
   327	        job_row = conn.execute(
   328	            "SELECT head_version FROM jobs WHERE id = ?", (job_id,)
   329	        ).fetchone()
   330	        if job_row is not None:
   331	            reviewed_version = job_row["head_version"]
   332	
   333	    cur = conn.execute(
   334	        """
   335	        INSERT INTO verdicts
   336	            (job_id, reviewer_seat, reviewer_tier, role, model_family,
   337	             verdict, severity, summary, detail, reviewed_version)
   338	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
   339	        """,
   340	        (job_id, reviewer_seat, row["tier"], role, row["family"],
   341	         verdict, severity, summary, detail, reviewed_version),
   342	    )
   343	    return int(cur.lastrowid)
   344	
   345	
   346	def resolve_escalation(conn: sqlite3.Connection, verdict_id: int, verdict: str) -> None:
   347	    """Answer a needs_human verdict so the job can proceed (§6 human review queue)."""
   348	    if verdict not in ("pass", "fail"):
   349	        raise ValueError("an escalation resolves to 'pass' or 'fail'")
   350	    conn.execute("UPDATE verdicts SET verdict = ? WHERE id = ?", (verdict, verdict_id))
   351	
