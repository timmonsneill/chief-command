   345	def test_an_empty_token_file_never_authorizes(tmp_path, monkeypatch):
   346	    """compare_digest('', '') is True. An empty token file used to let a header-less
   347	    request through — the exact CSRF the token exists to stop."""
   348	    path = tmp_path / "chief" / "gatekeeper.token"
   349	    monkeypatch.setattr(gatekeeper, "TOKEN_PATH", path)
   350	    first = gatekeeper.token()
   351	    assert len(first) >= 32
   352	    path.write_text("")                                     # truncated / disk-full
   353	    second = gatekeeper.token()
   354	    assert len(second) >= 32 and second != ""
