    53	def _event(conn, job_id: int, seat_row, kind: str, detail: str = "", target: str = "") -> None:
    54	    conn.execute(
    55	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, target, detail) "
    56	        "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
