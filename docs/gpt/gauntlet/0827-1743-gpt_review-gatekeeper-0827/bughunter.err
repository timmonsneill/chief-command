   937	-- ═══════════════════════════════════════════════════════════════════════════
   938	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   939	--
   940	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
   941	-- serious failure satisfied it. A reviewer could scream that the thing was broken and
   942	-- be outvoted by colleagues who hadn't noticed.
   943	--
   944	-- That is the opposite of what a gauntlet is FOR. One reviewer finding a real bug is
   945	-- the whole point — it isn't a democracy, it's a set of independent smoke detectors.
   946	-- Any one of them going off stops the job.
   947	-- ═══════════════════════════════════════════════════════════════════════════
   948	CREATE TRIGGER IF NOT EXISTS guard_a_failing_review_stops_it
   949	BEFORE UPDATE OF status ON jobs
   950	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   951	BEGIN
   952	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
   953	    WHERE EXISTS (
   954	        SELECT 1 FROM verdicts v
   955	        WHERE v.job_id = NEW.id AND v.verdict = 'fail'
   956	          -- gate 3: a fail condemns the VERSION it reviewed, not the job forever.
   957	          -- A fail with no version condemned we-don't-know-what: it blocks
   958	          -- everything. Same if the job itself is unversioned. Fail-closed.
   959	          AND (NEW.head_version IS NULL
   960	               OR v.reviewed_version IS NULL
   961	               OR v.reviewed_version = NEW.head_version)
   962	    );
   963	END;
   964	
   965	-- Sol, round 2, #6: an objection raised AFTER 'done' could still be outrun, because
   966	-- the escalation guard only fired on the transition INTO done — not on done -> shipped.
   967	CREATE TRIGGER IF NOT EXISTS guard_late_escalation_still_blocks_shipping
   968	BEFORE UPDATE OF status ON jobs
   969	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   970	BEGIN
   971	    SELECT RAISE(ABORT, 'guard: someone raised an objection — it has to be answered first')
   972	    WHERE EXISTS (
   973	        SELECT 1 FROM verdicts v
   974	        WHERE v.job_id = NEW.id
   975	          AND (v.verdict = 'needs_human'  -- an unanswered question blocks, always
   976	               -- gate 3: a fail blocks the version it condemned (fail-closed when
   977	               -- either side is unversioned)
   978	               OR (v.verdict = 'fail'
   979	                   AND (NEW.head_version IS NULL
   980	                        OR v.reviewed_version IS NULL
   981	                        OR v.reviewed_version = NEW.head_version)))
   982	    );
   983	END;
   984	
   985	-- Sol, round 2, #4: evidence could be an EMPTY STRING. A path of '' satisfied
   986	-- "COALESCE(path, value) IS NOT NULL" perfectly well.
   987	CREATE TRIGGER IF NOT EXISTS guard_evidence_cannot_be_empty
   988	BEFORE INSERT ON artifacts
   989	WHEN TRIM(COALESCE(NEW.path, NEW.value, '')) = ''
   990	BEGIN
   991	    SELECT RAISE(ABORT, 'guard: evidence with nothing in it is not evidence');
   992	END;
   993	
   994	-- ===========================================================================
   995	-- GUARD 6 — nothing ships without a passing cross-family tester.
   996	-- ===========================================================================
   997	CREATE TRIGGER IF NOT EXISTS guard_ship_requires_a_passing_tester
   998	BEFORE UPDATE OF status ON jobs
   999	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
  1000	BEGIN
  1001	    SELECT RAISE(ABORT, 'guard: nothing ships without a passing cross-family tester on the record')
  1002	    WHERE OLD.status <> 'done'
  1003	       OR NOT EXISTS (
  1004	           SELECT 1 FROM verdicts v
  1005	           WHERE v.job_id = NEW.id AND v.role = 'tester' AND v.verdict = 'pass'
  1006	             -- gate 3: the tester must have driven THIS version of the app
  1007	             AND v.reviewed_version IS NEW.head_version
  1008	       );
  1009	END;
  1010	
  1011	-- ===========================================================================
  1012	-- GUARD 7 — a researcher must show you where it got that.
  1013	-- ===========================================================================
  1014	CREATE TRIGGER IF NOT EXISTS guard_research_must_cite_sources
  1015	BEFORE UPDATE OF status ON jobs
  1016	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
  1017	     AND NEW.kind = 'research'
  1018	BEGIN
