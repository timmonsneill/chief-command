   112	
   113	def _log(conn, verb: str, subject: str, granted: bool, detail: str,
   114	         asked_by: str = "unknown", job_id: int | None = None) -> None:
   115	    """The gatekeeper's own record, which does not depend on there being a job.
   116	
   117	    Deploys aren't necessarily about a job, and `events.job_id` is NOT NULL — so before
   118	    this existed, a deploy's grants AND its refusals were dropped on the floor, for the
