   124	def cleanup_worktree(job_id: int) -> None:
   125	    """Remove a job's worktree once its work is merged or abandoned."""
   126	    dest = WORKTREES / f"job-{job_id}"
   127	    if not dest.exists():
   128	        return
   129	    subprocess.run(["git", "worktree", "remove", "--force", str(dest)],
   130	                   cwd=HARNESS.parent, capture_output=True, text=True)
   131	    if dest.exists():
   132	        subprocess.run(["rm", "-rf", str(dest)], capture_output=True, text=True)
