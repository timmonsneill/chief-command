   553	def serve(host: str = "127.0.0.1", port: int = 8788) -> None:
   554	    """Run the gatekeeper as its own process.
   555	
   556	    LOOPBACK ONLY, and not a choice to revisit casually: the tailnet is other devices,
   557	    and the whole point of this process is that reaching it is harder than reaching the
   558	    agents, not easier. Standard library only — the thing holding the dangerous powers
   559	    should have the smallest possible surface.
   560	    """
   561	    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
   562	
   563	    expected = token()
   564	
   565	    class Handler(BaseHTTPRequestHandler):
   566	        protocol_version = "HTTP/1.1"
   567	
   568	        def _reply(self, code: int, answer: dict) -> None:
   569	            payload = json.dumps(answer).encode()
   570	            self.send_response(code)
   571	            self.send_header("Content-Type", "application/json")
   572	            self.send_header("Content-Length", str(len(payload)))
   573	            self.end_headers()
   574	            self.wfile.write(payload)
   575	
   576	        def do_POST(self):                                    # noqa: N802
   577	            try:
   578	                # Host check first: it is what stops DNS rebinding, where a page the
   579	                # owner is looking at resolves an attacker's domain to 127.0.0.1 and
   580	                # then talks to us with the browser's blessing.
   581	                host_header = (self.headers.get("Host") or "").split(":")[0]
   582	                if host_header not in ("127.0.0.1", "localhost", "[::1]"):
   583	                    return self._reply(403, {"ok": False, "error": "not for you"})
   584	                if not expected or not secrets.compare_digest(
   585	                        self.headers.get("X-Chief-Token") or "", expected):
   586	                    return self._reply(403, {"ok": False, "error": "not for you"})
   587	
   588	                length = int(self.headers.get("Content-Length") or 0)
   589	                if length < 0 or length > MAX_BODY_BYTES:
   590	                    return self._reply(413, {"ok": False, "error": "that request is too big"})
   591	                raw = self.rfile.read(length) if length else b"{}"
   592	                try:
   593	                    body = json.loads(raw or b"{}")
   594	                except json.JSONDecodeError:
   595	                    body = {}
   596	                if not isinstance(body, dict):
   597	                    body = {}
   598	
   599	                answer = handle(body)
   600	                self._reply(200 if answer.get("ok") else 403, answer)
   601	            except Exception:                                  # noqa: BLE001
   602	                # The gatekeeper never dies of a bad request. Down means stopped, and
   603	                # stopped means every irreversible thing stops with it.
   604	                try:
   605	                    self._reply(400, {"ok": False, "error": "that request didn't make sense"})
   606	                except Exception:                              # noqa: BLE001
   607	                    pass
   608	
   609	        def log_message(self, *args):                          # quiet by default
   610	            pass
   611	
   612	    server = ThreadingHTTPServer((host, port), Handler)
   613	    server.daemon_threads = True
   614	    server.serve_forever()
   615	
   616	
   617	if __name__ == "__main__":
   618	    serve()
     1	-- Chief Command v2 — harness job store
     2	--
     3	-- This is the layer OpenClaw does NOT give us. Its subagent sessions auto-archive
     4	-- after ~60 minutes and get soft-deleted; that is session archival, not durable job
     5	-- history. Spec §7 wants "what did the overnight run do?" to be answerable. This is that.
     6	--
     7	-- Two rules are enforced STRUCTURALLY here rather than in a prompt, because rules that
     8	-- live in prompts quietly stop holding at 4am:
     9	--   1. Local-model output can never reach `done` without a higher-tier passing review
    10	--      (spec §4.3 / §9 — "enforce in the pipeline itself, not by convention").
    11	--   2. Per-seat spend caps (OpenClaw core has no per-agent budget of any kind).
    12	
    13	PRAGMA journal_mode = WAL;
    14	PRAGMA foreign_keys = ON;
    15	
    16	-- ---------------------------------------------------------------------------
    17	-- Seats: the named roles from spec §4. Providers are swappable behind these.
    18	-- ---------------------------------------------------------------------------
    19	CREATE TABLE IF NOT EXISTS seats (
    20	    id            TEXT PRIMARY KEY,          -- 'brain' | 'workhorse' | 'grinder_local' | 'reviewer' | 'tester' | 'mouth'
    21	    provider      TEXT NOT NULL,             -- 'codex' | 'xai' | 'ollama' | 'claude-cli' | ...
    22	    model         TEXT NOT NULL,
    23	    -- Model FAMILY, not provider. Two seats can share a family via different providers
    24	    -- (e.g. claude-cli and an Anthropic API key are both 'claude'). The gauntlet's
    25	    -- diversity rule and the no-self-testing guard both key off this, so it must be
    26	    -- the thing that actually determines shared blind spots.
    27	    family        TEXT NOT NULL,             -- 'gpt' | 'claude' | 'grok' | 'qwen'
    28	    -- tier drives the review guard below. 'local' output is never trusted on its own.
    29	    tier          TEXT NOT NULL CHECK (tier IN ('local', 'subscription', 'metered')),
    30	    -- ═══════════════════════════════════════════════════════════════════════
    31	    -- MODEL TIERS. Owner (2026-07-14):
    32	    --     "If we do highest model every time for every build, on autonomous work,
    33	    --      Claude and ChatGPT are gonna bottom out. I need us to build in model
    34	    --      tiering as well."
    35	    --
    36	    -- He's right, and it's the difference between a system that runs for a month and
    37	    -- one that dies on Thursday. Rate limits are the binding constraint on autonomous
    38	    -- work — NOT money (Claude and OpenAI are flat-rate). You cannot buy your way out
    39	    -- of a weekly cap. You can only spend it wisely.
    40	    --
    41	    -- So every seat carries THREE models, and the harness picks by what the work
    42	    -- actually deserves:
    43	    --
    44	    --   light     the cheap one. Boilerplate, scaffolding, small fixes, quick answers.
    45	    --   standard  the default. Most real work.
    46	    --   heavy     the top of the line. Reserved, and it has to be EARNED.
    47	    --
    48	    -- Nothing gets `heavy` by default. It's earned by: an explicit ask ("think hard"),
    49	    -- a risky area (auth, money, data), a repeat failure, or a major decision. See
    50	    -- tiering.py — the whole point is that the escalation is a rule, not a vibe.
    51	    -- ═══════════════════════════════════════════════════════════════════════
    52	    model_light    TEXT,     -- e.g. claude-haiku / gpt-5.6-luna
    53	    model_standard TEXT,     -- e.g. claude-sonnet / gpt-5.6-terra
    54	    model_heavy    TEXT,     -- e.g. claude-opus / gpt-5.6-sol  (EARNED, never default)
    55	    effort_light    TEXT DEFAULT 'low',
    56	    effort_standard TEXT DEFAULT 'medium',
    57	    effort_heavy    TEXT DEFAULT 'high',
    58	
    59	    -- CAPS ARE PER-ROLE, not just per-seat. Owner's call (2026-07-13):
    60	    --     "it can review as much as it wants more or less, but shouldn't build as
    61	    --      much as claude and chat"
    62	    --
    63	    -- The economics say the same thing. Claude and OpenAI are FLAT-RATE — a build on
    64	    -- those seats costs nothing marginal, it's already paid for. Grok is METERED, so
    65	    -- every build is real money. And builds are the expensive kind of work (token-heavy)
    66	    -- while reviews are cheap (read-heavy, ~1/10 the tokens).
    67	    --
    68	    -- So: BUILD on the seats you've already bought. REVIEW on the metered one, because
    69	    -- reviewing is cheap — and reviewing is what Grok is actually best at anyway. Its
    70	    -- value was never being the strongest coder. It's being a DIFFERENT MIND.
    71	    --
    72	    -- NULL = uncapped.
    73	    daily_cap_cents        INTEGER,   -- total across all roles (the hard ceiling)
    74	    build_cap_cents        INTEGER,   -- ration the expensive work
    75	    review_cap_cents       INTEGER,   -- reviewing is cheap; be generous
    76	    enabled       INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0, 1)),
    77	    notes         TEXT
    78	);
    79	
    80	-- ---------------------------------------------------------------------------
    81	-- Projects: the top-level thing work belongs to. Each has its OWN memory.
    82	--
    83	-- Owner: "ability to see a projects tab and each project has its own memory,
    84	-- timeline/planning."
    85	--
    86	-- This matters more than it looks. Memory that isn't scoped to a project leaks:
    87	-- lessons from the EMR bleed into the harness, conventions from one codebase get
    88	-- applied to another. Chief already keeps per-AGENT memory; this is per-PROJECT,
    89	-- and the two are different axes. Riggs knows how HE works; the project knows how
    90	-- IT works.
    91	-- ---------------------------------------------------------------------------
    92	CREATE TABLE IF NOT EXISTS projects (
    93	    id            TEXT PRIMARY KEY,          -- 'chief', 'arch', 'jess'
    94	    name          TEXT NOT NULL,
    95	    repo_path     TEXT,
    96	    description   TEXT,
    97	    -- Where this project's own memory lives. Loaded into context for any job on it.
    98	    memory_dir    TEXT,
    99	    color         TEXT,                      -- the UI reads this
   100	    archived      INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0,1)),
   101	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   102	);
   103	
   104	-- The REAL projects, seeded so Chief knows them on ANY machine (a fresh DB or the Mac
   105	-- Studio), not just wherever a row happened to be typed. Without this, `projects` is
   106	-- empty on a new box and Chief goes back to improvising what Neill is working on — the
   107	-- exact bug this seed exists to kill. OR IGNORE so it never clobbers live edits.
   108	--
   109	-- repo_path: Arch is deliberately NULL. Chief may read Arch's NOTES (memory), but the
   110	-- fleet must never be pointed at its code or its patient data (Decision C, PHI). Dispatch
   111	-- does not route by repo_path today; if it ever learns to, THAT is where the guard goes.
   112	--
   113	-- memory_dir is NOT seeded here on purpose: it's the one genuinely machine-specific value
   114	-- (where this box keeps the project's notes), so it's set as local config per machine —
   115	-- keeping this file hardware-agnostic (rule 4).
   116	INSERT OR IGNORE INTO projects (id, name, repo_path, description, color) VALUES
   117	  ('chief', 'Chief Command', '~/code-projects/chief-command',
   118	   'The thing you talk to. This.', '#2E9BFF'),
   119	  ('jess', 'Jess', '~/code-projects/personal-assist',
   120	   'Personal assistant. Connects to Chief over the tailnet later.', '#A78BFA'),
   121	  ('arch', 'Arch (Arch to Freedom EMR)', NULL,
   122	   'The records system for the addiction-recovery facility — staff, beds, roles, approvals, the voice assistant Archie. Voice-first. Held at arm''s length here on purpose: Chief can read its notes but the fleet does not touch its code or its patient data.',
   123	   '#22c55e');
   124	
   125	-- Project memory: facts that belong to the PROJECT, not to an agent and not to a job.
   126	-- "The API returns snake_case." "Never touch the billing table directly."
   127	CREATE TABLE IF NOT EXISTS project_memory (
   128	    id            INTEGER PRIMARY KEY,
   129	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
   130	    kind          TEXT NOT NULL DEFAULT 'lesson'
   131	                  CHECK (kind IN ('lesson', 'convention', 'constraint', 'decision', 'gotcha')),
   132	    fact          TEXT NOT NULL,
   133	    -- Where it came from, so a wrong lesson can be traced and killed.
   134	    learned_from  INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   135	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   136	);
   137	
   138	CREATE INDEX IF NOT EXISTS idx_pmem_project ON project_memory(project_id);
   139	
   140	-- The plan. What's coming, in order. This is the timeline the UI draws.
   141	CREATE TABLE IF NOT EXISTS plan_items (
   142	    id            INTEGER PRIMARY KEY,
   143	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
   144	    title         TEXT NOT NULL,
   145	    detail        TEXT,
   146	    phase         TEXT,                      -- 'phase 1', 'phase 2'…
   147	    status        TEXT NOT NULL DEFAULT 'planned'
   148	                  CHECK (status IN ('planned', 'active', 'blocked', 'done', 'dropped')),
   149	    blocked_on    TEXT,                      -- plain English. "waiting on Neill to log in"
   150	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   151	    position      INTEGER NOT NULL DEFAULT 0,
   152	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   153	);
   154	
   155	CREATE INDEX IF NOT EXISTS idx_plan_project ON plan_items(project_id, position);
   156	
   157	-- ---------------------------------------------------------------------------
   158	-- Todos: the checklist that belongs to a PROJECT, so it stops living in a
   159	-- terminal window and following nobody. Owner's annoyance, verbatim: "right now I
   160	-- have persistent todos that has to jump from window to window, which is annoying."
   161	--
   162	-- `owner_only` marks the items only Neill can do (rotate a key, flip a setting) —
   163	-- the ones the fleet must never quietly tick off on his behalf.
   164	-- ---------------------------------------------------------------------------
   165	CREATE TABLE IF NOT EXISTS todos (
   166	    id            INTEGER PRIMARY KEY,
   167	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
   168	    -- Sub-category WITHIN a project, so a project can hold several running lists
   169	    -- ("Security", "Build", "My tasks"). Owner: "ideally we can create a sub
   170	    -- category under each project as well." NULL / '' folds into a "General" list.
   171	    section       TEXT,
   172	    text          TEXT NOT NULL,
   173	    done          INTEGER NOT NULL DEFAULT 0 CHECK (done IN (0, 1)),
   174	    owner_only    INTEGER NOT NULL DEFAULT 0 CHECK (owner_only IN (0, 1)),
   175	    position      INTEGER NOT NULL DEFAULT 0,
   176	    created_at    TEXT NOT NULL DEFAULT (datetime('now')),
   177	    done_at       TEXT
   178	);
   179	
   180	CREATE INDEX IF NOT EXISTS idx_todos_project ON todos(project_id, section, position, id);
   181	
   182	-- ---------------------------------------------------------------------------
   183	-- Attachments: images and files Neill drops in — a screenshot of a bug, a mockup,
   184	-- a document — pinned to a project or a specific job. The bytes live on disk
   185	-- (gitignored); this row is how the UI finds them. captured_by is always the owner
   186	-- here; agent-produced evidence is the `artifacts` table, which has its own guards.
   187	-- ---------------------------------------------------------------------------
   188	CREATE TABLE IF NOT EXISTS attachments (
   189	    id            INTEGER PRIMARY KEY,
   190	    project_id    TEXT REFERENCES projects(id) ON DELETE SET NULL,
   191	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   192	    filename      TEXT NOT NULL,             -- the original name, for display
   193	    stored_path   TEXT NOT NULL,             -- where the bytes actually live
   194	    kind          TEXT NOT NULL CHECK (kind IN ('image', 'file')),
   195	    size_bytes    INTEGER,
   196	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   197	);
   198	
   199	CREATE INDEX IF NOT EXISTS idx_attachments_project ON attachments(project_id);
   200	CREATE INDEX IF NOT EXISTS idx_attachments_job ON attachments(job_id);
   201	
   202	-- ---------------------------------------------------------------------------
   203	-- Jobs: one row per dispatched unit of work. This is the audit trail.
   204	-- ---------------------------------------------------------------------------
   205	CREATE TABLE IF NOT EXISTS jobs (
   206	    id            INTEGER PRIMARY KEY,
   207	    created_at    TEXT NOT NULL DEFAULT (datetime('now')),
   208	    updated_at    TEXT NOT NULL DEFAULT (datetime('now')),
   209	    started_at    TEXT,
   210	    finished_at   TEXT,
   211	
   212	    request       TEXT NOT NULL,             -- what was asked, verbatim (§7)
   213	    -- A 2-4 word handle the mouth coins at dispatch: "the rate limiter".
   214	    -- The VOICE says this. The TEXT shows `request` in full. Echoing a man's own
   215	    -- paragraph back at him is not how a colleague talks.
   216	    task_name     TEXT,
   217	    origin        TEXT NOT NULL DEFAULT 'text'
   218	                  CHECK (origin IN ('text', 'voice', 'cron', 'relay')),  -- 'relay' = Jess (§10)
   219	
   220	    -- 'build'    → produces code. Ground truth = a screenshot (Playwright drove it).
   700	    SELECT RAISE(ABORT, 'guard: a verdict cannot be rewritten — only an escalation may be answered');
   701	END;
   702	
   703	CREATE TRIGGER IF NOT EXISTS guard_verdict_identity_is_frozen
   704	BEFORE UPDATE ON verdicts
   705	WHEN OLD.role <> NEW.role OR OLD.model_family <> NEW.model_family
   706	  OR OLD.reviewer_seat <> NEW.reviewer_seat OR OLD.reviewer_tier <> NEW.reviewer_tier
   707	BEGIN
   708	    SELECT RAISE(ABORT, 'guard: who reviewed this cannot be rewritten after the fact');
   709	END;
   710	
   711	-- ═══════════════════════════════════════════════════════════════════════════
   712	-- THE REVIEW-TO-VERSION CHAIN (Sol build gate 3, 2026-07-20).
   713	--
   714	-- Sol's most dangerous flaw: "approve version A, builder changes it to B, the old
   715	-- approval still counts — believable green checks on code nobody reviewed."
   716	--
   717	-- The fix is not another approval ceremony; it is arithmetic. A verdict carries the
   718	-- version it reviewed. A job carries the version it is putting forward. Completion
   719	-- guards only count verdicts whose versions MATCH — so moving the code voids the
   720	-- approvals by construction, nothing needs to remember to revoke anything. And a
   721	-- FAIL condemns the version it saw, not the job forever: fix the code, the version
   722	-- changes, the old fail becomes history. (A fail with no recorded version blocks
   723	-- everything — fail-closed, because it condemned we-don't-know-what.)
   724	-- ═══════════════════════════════════════════════════════════════════════════
   725	
   726	-- A versioned job accepts no unversioned verdicts. (Unversioned legacy jobs keep
   727	-- their old semantics; the gatekeeper will not push anything unversioned anyway.)
   728	CREATE TRIGGER IF NOT EXISTS guard_verdict_must_cite_what_it_reviewed
   729	BEFORE INSERT ON verdicts
   730	WHEN (SELECT head_version FROM jobs WHERE id = NEW.job_id) IS NOT NULL
   731	     AND TRIM(COALESCE(NEW.reviewed_version, '')) = ''
   732	BEGIN
   733	    SELECT RAISE(ABORT, 'guard: this job is versioned — a verdict must say which version it reviewed');
   734	END;
   735	
   736	-- A build cannot finish without declaring WHICH code is finished.
   737	CREATE TRIGGER IF NOT EXISTS guard_a_build_finishes_a_version
   738	BEFORE UPDATE OF status ON jobs
   739	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   740	     AND NEW.kind = 'build'
   741	     AND TRIM(COALESCE(NEW.head_version, '')) = ''
   742	BEGIN
   743	    SELECT RAISE(ABORT, 'guard: a build cannot finish without naming the exact version that is finished');
   744	END;
   745	
   746	-- Once finished, WHAT finished is history. Rewriting head_version after done would
   747	-- let approved-hash-A ship as hash-B while every record still looks green.
   748	CREATE TRIGGER IF NOT EXISTS guard_finished_version_is_frozen
   749	BEFORE UPDATE OF head_version ON jobs
   750	WHEN OLD.status IN ('done', 'shipped') AND OLD.head_version IS NOT NEW.head_version
   751	BEGIN
   752	    SELECT RAISE(ABORT, 'guard: what version finished cannot be rewritten after the fact');
   753	END;
   754	
   755	-- A verdict cannot be DELETED. (Sol, round 3 — verified 2026-07-14.)
   756	--
   757	-- "Append-only" was enforced only against UPDATE, so a failing review that couldn't be
   758	-- EDITED into a pass could simply be DELETED — after which guard_a_failing_review_stops_it
   759	-- (which asks "does a fail EXIST?") saw nothing and let the job complete. Confirmed with a
   760	-- live exploit: fail deleted, then done. A verdict is a fact; facts are not retractable.
   761	CREATE TRIGGER IF NOT EXISTS guard_verdicts_cannot_be_deleted
   762	BEFORE DELETE ON verdicts
   763	BEGIN
   764	    SELECT RAISE(ABORT, 'guard: a verdict is a fact on the record — it cannot be deleted');
   765	END;
   766	
   767	-- A reviewer cannot LIE about who it is. (Sol #4 — the DB took the row's word for it.)
   768	CREATE TRIGGER IF NOT EXISTS guard_reviewer_identity_must_be_real
   769	BEFORE INSERT ON verdicts
   770	WHEN NEW.reviewer_tier <> (SELECT tier FROM seats WHERE id = NEW.reviewer_seat)
   771	  OR NEW.model_family  <> (SELECT family FROM seats WHERE id = NEW.reviewer_seat)
   772	BEGIN
   773	    SELECT RAISE(ABORT, 'guard: a reviewer cannot misrepresent its own tier or family');
   774	END;
   775	
   776	-- Build evidence can only come from the harness. (Sol #9 — the DB accepted a
   777	-- model-captured screenshot; only the Python helper refused.)
   778	CREATE TRIGGER IF NOT EXISTS guard_models_cannot_forge_evidence
   779	BEFORE INSERT ON artifacts
   780	WHEN NEW.captured_by = 'model' AND NEW.kind NOT IN ('source', 'quote')
   781	BEGIN
   782	    SELECT RAISE(ABORT, 'guard: a model may cite a source but may not produce build evidence');
   783	END;
   784	
   785	-- ===========================================================================
   786	-- GUARD 1 — local output never ships unreviewed (§4.3, §9)
   787	-- Now reads the SNAPSHOT (builder_tier), not the live seat.
   788	-- ===========================================================================
   789	CREATE TRIGGER IF NOT EXISTS guard_local_output_needs_review
   790	BEFORE UPDATE OF status ON jobs
   791	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   792	     AND NEW.builder_tier = 'local'
   793	BEGIN
   794	    SELECT RAISE(ABORT, 'guard: local-built job requires a passing subscription-tier review before done')
   795	    WHERE NOT EXISTS (
   796	        SELECT 1 FROM verdicts v
   797	        WHERE v.job_id = NEW.id
   798	          AND v.reviewer_tier IN ('subscription', 'metered')
   799	          AND v.verdict = 'pass'
   800	          -- gate 3: a pass only counts for the version it actually reviewed
   801	          AND v.reviewed_version IS NEW.head_version
   802	    );
   803	END;
   804	
   805	-- ===========================================================================
   806	-- GUARD 2 — escalations must be answered, not outrun (§6)
   807	-- ===========================================================================
   808	CREATE TRIGGER IF NOT EXISTS guard_unresolved_escalation
   809	BEFORE UPDATE OF status ON jobs
   810	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   811	BEGIN
   812	    SELECT RAISE(ABORT, 'guard: job has an unresolved needs_human verdict')
   813	    WHERE EXISTS (
   814	        SELECT 1 FROM verdicts v WHERE v.job_id = NEW.id AND v.verdict = 'needs_human'
   815	    );
   816	END;
   817	
   818	-- ===========================================================================
   819	-- GUARD 3 — a tester's verdict must cite REAL BUILD EVIDENCE.
   820	--
   821	-- ⚠️ Sol #3: "The 'no screenshot, no verdict' claim is false." My original guard
   822	-- accepted ANY artifact — including a research source, or an empty row. So a tester
   823	-- could "pass" a job on the strength of a URL somebody pasted. Now it must be
   824	-- evidence the HARNESS captured by actually driving the app.
   825	-- ===========================================================================
   826	CREATE TRIGGER IF NOT EXISTS guard_tester_must_cite_artifacts
   827	BEFORE INSERT ON verdicts
   828	WHEN NEW.role = 'tester'
   829	BEGIN
   830	    SELECT RAISE(ABORT, 'guard: a tester verdict requires real captured evidence — no screenshot, no verdict')
   831	    WHERE NOT EXISTS (
   832	        SELECT 1 FROM artifacts a
   833	        WHERE a.job_id = NEW.job_id
   834	          AND a.kind IN ('screenshot', 'trace', 'video', 'dom_snapshot')
   835	          AND a.captured_by IN ('harness', 'playwright')
   836	          AND COALESCE(a.path, a.value) IS NOT NULL
   837	    );
   838	END;
   839	
   840	-- ===========================================================================
   841	-- GUARD 4 — a model family may not test its own work.
   842	-- Reads the snapshot, so re-pointing a seat later changes nothing.
   843	-- ===========================================================================
   844	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_testing
   845	BEFORE INSERT ON verdicts
   846	WHEN NEW.role = 'tester'
   847	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
   848	BEGIN
   849	    SELECT RAISE(ABORT, 'guard: a model family may not test its own build');
   850	END;
   851	
   852	-- ===========================================================================
   853	-- GUARD 5 — the full panel, always. DISTINCT reviewers.
   854	--
   855	-- ⚠️ Sol #7: "The full panel can be faked with duplicate passes." It counted ROWS.
   856	-- One reviewer could pass the same job six times. Now it counts distinct seats.
   857	-- ===========================================================================
   858	-- The floor is UNCONDITIONAL (migration 007). It used to fire only when
   859	-- required_reviews > 0 — so a job whose requirements were never stamped had no
   860	-- requirements to fail, and reached 'done' with zero verdicts. Unstamped is not
   861	-- unrequired.
   862	CREATE TRIGGER IF NOT EXISTS guard_full_panel
   863	BEFORE UPDATE OF status ON jobs
   864	WHEN NEW.status = 'done' AND OLD.status <> 'done'
   865	BEGIN
   866	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
   867	    WHERE (
   868	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
   869	        -- the panel could be "filled" by the wrong kinds of check entirely.
   870	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
   871	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   872	          -- gate 3: the panel must have reviewed THIS version, not an earlier one
   873	          AND v.reviewed_version IS NEW.head_version
   874	    ) < MAX(NEW.required_reviews, 1);
   875	END;
   876	
   877	-- ===========================================================================
   878	-- GUARD 5b — the family floor (task #10). "Full set, always" counts SEATS; it does
   879	-- not guarantee more than one MIND looked. Sol's #10 gate: min_model_families was
   880	-- enforced nowhere in the DB — the gauntlet's core property rested on Python. Now
   881	-- the DB refuses ->done without >= required_review_families DISTINCT passing families
   882	-- on this version. Fails closed: too few families -> parked (never lowers the bar).
   883	-- Snapshotted un-lowerable at dispatch (guard_family_floor_is_fixed).
   884	-- ===========================================================================
   885	CREATE TRIGGER IF NOT EXISTS guard_family_floor_is_fixed
   886	BEFORE UPDATE OF required_review_families ON jobs
   887	WHEN OLD.required_review_families > 0 AND NEW.required_review_families < OLD.required_review_families
   888	BEGIN
   889	    SELECT RAISE(ABORT, 'guard: the family floor cannot be lowered after dispatch');
   890	END;
   891	
   892	CREATE TRIGGER IF NOT EXISTS guard_family_floor
   893	BEFORE UPDATE OF status ON jobs
   894	WHEN NEW.status = 'done' AND OLD.status <> 'done'
   895	BEGIN
   896	    SELECT RAISE(ABORT, 'guard: fewer model families reviewed this than required')
   897	    WHERE (
   898	        SELECT COUNT(DISTINCT v.model_family) FROM verdicts v
   899	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   900	          AND v.reviewed_version IS NEW.head_version
   901	          -- The AUTHOR is not a second opinion. Same-family review is allowed (it is a
   902	          -- weaker signal, not a forbidden one — see test_jobs.py) but it does not COUNT
   903	          -- toward diversity, or "two different minds" could include the one that wrote
   904	          -- it. (Migration 007.)
   905	          AND v.model_family <> NEW.builder_family
   906	    ) < MAX(NEW.required_review_families, 1);
   907	END;
   908	
   909	-- ---------------------------------------------------------------------------
   910	-- The gatekeeper's own log (task #11). events.job_id is NOT NULL, and a deploy is not
   911	-- necessarily about a job — so without this, a deploy's grants AND refusals had nowhere
   912	-- to go and were silently dropped. Append-only, like verdicts: a record, not a draft.
   913	-- ---------------------------------------------------------------------------
   914	CREATE TABLE IF NOT EXISTS gate_log (
   915	    id          INTEGER PRIMARY KEY,
   916	    verb        TEXT NOT NULL,
   917	    subject     TEXT NOT NULL,
   918	    granted     INTEGER NOT NULL CHECK (granted IN (0,1)),
   919	    detail      TEXT NOT NULL,
   920	    asked_by    TEXT NOT NULL,
   921	    job_id      INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   922	    created_at  TEXT NOT NULL DEFAULT (datetime('now'))
   923	);
   924	
   925	CREATE TRIGGER IF NOT EXISTS guard_gate_log_is_append_only
   926	BEFORE UPDATE ON gate_log
   927	BEGIN
   928	    SELECT RAISE(ABORT, 'guard: the gatekeeper log is a record, not a draft');
   929	END;
   930	
   931	CREATE TRIGGER IF NOT EXISTS guard_gate_log_cannot_be_deleted
   932	BEFORE DELETE ON gate_log
   933	BEGIN
   934	    SELECT RAISE(ABORT, 'guard: the gatekeeper log cannot be deleted');
   935	END;
   936	
   937	-- ═══════════════════════════════════════════════════════════════════════════
   938	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   939	--
   940	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
     1	-- Migration 007 — two holes under the whole review system (found by the cross-model
     2	-- review of task #10, reproduced live before fixing).
     3	--
     4	-- ── HOLE 1: a job with no requirements had no requirements to fail ──
     5	--
     6	-- required_reviews and required_review_families default to 0, and BOTH completion
     7	-- guards were written `WHEN NEW.required_* > 0`. So a job whose requirements were never
     8	-- stamped sailed to 'done' with zero verdicts — not by defeating a guard, but because
     9	-- no guard fired. The only thing setting those numbers was Python in dispatch(), which
    10	-- means gauntlet.py's claim that "the database is the boundary, not this file" was not
    11	-- true of the most basic question of all: did ANY review happen?
    12	--
    13	-- Reproduced: create_job -> in_progress -> review -> done, no verdicts, no complaint.
    14	--
    15	-- Now the floor is unconditional. Reaching 'done' requires at least one passing
    16	-- reviewer of the current version and at least one model family, whatever the row says
    17	-- about itself. A job that wants more still needs more.
    18	--
    19	-- ── HOLE 2: a model could be counted as its own second opinion ──
    20	--
    21	-- The family floor counted DISTINCT families among the passing reviewers — including
    22	-- the builder's own. So a gpt seat could build it, a gpt seat could pass it, and that
    23	-- gpt pass counted as one of the two required "different minds."
    24	--
    25	-- Note what is NOT being changed. test_jobs.py records a deliberate decision that a
    26	-- same-family reviewer is ALLOWED — it is a weaker signal, not a forbidden one, and
    27	-- banning it outright would deadlock the current setup (a claude-built job with only
    28	-- claude and gpt reviewers available could never clear a floor of two). That decision
    29	-- stands. What changes is that such a review no longer COUNTS toward diversity.
    30	--
    31	-- The floor now asks the question it was always meant to ask: how many minds OTHER
    32	-- THAN THE AUTHOR'S looked at this?
    33	
    34	BEGIN;
    35	
    36	DROP TRIGGER IF EXISTS guard_full_panel;
    37	CREATE TRIGGER guard_full_panel
    38	BEFORE UPDATE OF status ON jobs
    39	WHEN NEW.status = 'done' AND OLD.status <> 'done'
    40	BEGIN
    41	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
    42	    WHERE (
    43	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
    44	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
    45	          AND v.reviewed_version IS NEW.head_version
    46	    ) < MAX(NEW.required_reviews, 1);      -- never zero: unstamped is not unrequired
    47	END;
    48	
    49	-- An earlier draft of this migration banned same-family review outright. It ran against
    50	-- the live database before the deadlock was spotted, so drop it explicitly rather than
    51	-- assume it was never there.
    52	DROP TRIGGER IF EXISTS guard_no_self_family_reviewing;
    53	
    54	DROP TRIGGER IF EXISTS guard_family_floor;
    55	CREATE TRIGGER guard_family_floor
    56	BEFORE UPDATE OF status ON jobs
    57	WHEN NEW.status = 'done' AND OLD.status <> 'done'
    58	BEGIN
    59	    SELECT RAISE(ABORT, 'guard: fewer model families reviewed this than required')
    60	    WHERE (
    61	        SELECT COUNT(DISTINCT v.model_family) FROM verdicts v
    62	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
    63	          AND v.reviewed_version IS NEW.head_version
    64	          AND v.model_family <> NEW.builder_family   -- the author is not a second opinion
    65	    ) < MAX(NEW.required_review_families, 1);
    66	END;
    67	
    68	-- ── The gatekeeper's own log ──
    69	--
    70	-- Every note it writes today hangs off a JOB, and `events.job_id` is NOT NULL. A deploy
    71	-- isn't necessarily about a job, so both its grants AND its refusals were being dropped
    72	-- on the floor — for the one verb where "say it out loud" matters most. A gatekeeper
    73	-- whose refusals can vanish is indistinguishable from one that was never asked.
    74	CREATE TABLE IF NOT EXISTS gate_log (
    75	    id          INTEGER PRIMARY KEY,
    76	    verb        TEXT NOT NULL,
    77	    subject     TEXT NOT NULL,
    78	    granted     INTEGER NOT NULL CHECK (granted IN (0,1)),
    79	    detail      TEXT NOT NULL,
    80	    asked_by    TEXT NOT NULL,
    81	    job_id      INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
    82	    created_at  TEXT NOT NULL DEFAULT (datetime('now'))
    83	);
    84	
    85	-- The log is a record of what was asked and answered. Records are not retractable —
    86	-- same reasoning as verdicts.
    87	CREATE TRIGGER IF NOT EXISTS guard_gate_log_is_append_only
    88	BEFORE UPDATE ON gate_log
    89	BEGIN
    90	    SELECT RAISE(ABORT, 'guard: the gatekeeper log is a record, not a draft');
    91	END;
    92	
    93	CREATE TRIGGER IF NOT EXISTS guard_gate_log_cannot_be_deleted
    94	BEFORE DELETE ON gate_log
    95	BEGIN
    96	    SELECT RAISE(ABORT, 'guard: the gatekeeper log cannot be deleted');
    97	END;
    98	
    99	COMMIT;

