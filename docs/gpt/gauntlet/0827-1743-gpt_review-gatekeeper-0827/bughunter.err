    97	def test_merge_does_not_count_the_author_as_a_second_opinion(conn):
    98	    """Migration 007 for the door, not just the wall. The job completed honestly on a
    99	    floor of one (gpt reviewed a claude build); the floor is then raised to two and a
   100	    claude pass — the builder's own family — is added. The record already refuses this
   101	    at 'done'; the gatekeeper must reach the same answer on its own."""
   102	    job = _finished_job(conn, families=("gpt",), seats_required=1, fams_required=1)
   103	    record_verdict(conn, job, "reviewer", verdict="pass", role="reviewer")   # claude on claude
   104	    set_status(conn, job, "done")
   105	    conn.execute("UPDATE jobs SET required_review_families=2 WHERE id=?", (job,))
   106	    with pytest.raises(gatekeeper.Refused, match="different kinds of model"):
   107	        gatekeeper.merge(conn, job)
