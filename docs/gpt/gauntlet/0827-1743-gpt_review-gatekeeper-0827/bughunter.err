   100	# ---------------------------------------------------------------------------
   101	# Saying no, out loud
   102	# ---------------------------------------------------------------------------
   103	def _clean(text: str, limit: int = 120) -> str:
   104	    """Make caller-supplied text safe to show Neill.
   105	
   106	    Everything written by `_note` is attributed to the gatekeeper — the one component he
   107	    is being told to trust — so an agent that can inject newlines into it can forge
   108	    gatekeeper-signed lines on his timeline. Strip the formatting, cap the length.
   109	    """
   110	    return re.sub(r"\s+", " ", str(text)).strip()[:limit]
