   438	
   439	    assert calls["n"] == first, "the panel re-reviewed a version it had already judged"
   440	    n = c.execute("SELECT COUNT(*) FROM verdicts WHERE job_id=?", (job,)).fetchone()[0]
   441	    assert n == 2, f"duplicate verdicts stacked on the record: {n}"
   442	
   443	
   444	def test_a_failed_dispatch_leaves_no_orphan_job(db, monkeypatch):
   445	    """A job committed without a worker coming for it sits at 'in_progress' forever and
   446	    looks like a hang. If the record can't be written whole, there is no job."""
   447	    c, _ = db
