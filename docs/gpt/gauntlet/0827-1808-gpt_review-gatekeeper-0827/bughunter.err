    63	def test_merge_refuses_work_that_never_finished(conn):
    64	    job = create_job(conn, "half a feature", builder_seat="reviewer")
    65	    with pytest.raises(gatekeeper.Refused, match="hasn't finished"):
    66	        gatekeeper.merge(conn, job)
    67	
    68	
    69	def test_merge_refuses_a_job_that_does_not_exist(conn):
    70	    with pytest.raises(gatekeeper.Refused, match="no job"):
    71	        gatekeeper.merge(conn, 9999)
