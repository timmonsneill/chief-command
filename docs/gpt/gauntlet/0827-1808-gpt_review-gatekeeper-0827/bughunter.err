   622	-- ═══════════════════════════════════════════════════════════════════════════
   623	-- GUARD 11 — the month's budget is hard. It refuses the entry that would breach it.
   624	--
   625	-- Same principle as every other guard here: this is not a policy an agent is asked
   626	-- to respect, it is a write that fails.
   627	-- ═══════════════════════════════════════════════════════════════════════════
   628	CREATE TRIGGER IF NOT EXISTS guard_monthly_budget_is_hard
   629	BEFORE INSERT ON usage
   630	BEGIN
   631	    SELECT RAISE(ABORT, 'guard: this would blow the monthly budget')
   632	    WHERE (SELECT spent_cents FROM month_spend) + NEW.cost_cents
   633	        > (SELECT monthly_cap_cents FROM budget WHERE id = 1);
   634	END;
   635	
   636	-- ===========================================================================
   637	-- THE GUARDS
   638	--
   639	-- ⚠️ REWRITTEN 2026-07-13 after a cross-family review. Sol (GPT) reviewed Claude's
   640	-- code and found NINE ways through. The headline: every guard fired on UPDATE of
   641	-- status, and NONE fired on INSERT — so a job could be BORN 'done'. Fences around
   642	-- the front door, no wall.
   643	--
   644	-- Sol's closing line, which is the one that mattered:
   645	--     "Those are application conventions, not the claimed structurally impossible
   646	--      guarantees."
   647	--
   648	-- He was right. Fixed below. Each guard now fires on BOTH insert and update, checks
   649	-- SNAPSHOTTED facts rather than live ones, and validates claims against `seats`
   650	-- instead of trusting whatever the writer put in the row.
   651	-- ===========================================================================
   652	
   653	-- A job may never be BORN finished. (Sol, round 1, #1 — the worst one.)
   654	CREATE TRIGGER IF NOT EXISTS guard_no_job_is_born_done
   655	BEFORE INSERT ON jobs
   656	WHEN NEW.status IN ('done', 'shipped')
   657	BEGIN
   658	    SELECT RAISE(ABORT, 'guard: a job cannot be created already finished — it must earn it');
   659	END;
   660	
   661	-- A job may not LIE ABOUT WHO BUILT IT AT BIRTH. (Sol, round 2, #1 — critical.)
   662	--
   663	-- I froze the builder's identity AFTER creation, so it couldn't be rewritten. But I
   664	-- never checked it AT creation. Sol: "A direct database write can label local work as
   665	-- subscription work, then complete it without the required higher-quality review. The
   666	-- identity is frozen only after creation; the initial lie is never caught."
   667	--
   668	-- Freezing a lie just makes it a permanent lie.
   669	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_must_be_real
   670	BEFORE INSERT ON jobs
   671	WHEN NEW.builder_tier   <> (SELECT tier   FROM seats WHERE id = NEW.builder_seat)
   672	  OR NEW.builder_family <> (SELECT family FROM seats WHERE id = NEW.builder_seat)
   673	BEGIN
   674	    SELECT RAISE(ABORT, 'guard: a job cannot misrepresent who built it');
   675	END;
   676	
   677	-- The builder's tier/family are snapshotted at creation and are then HISTORY.
   678	-- (Sol #5, #6 — re-tiering a seat rewrote the past.)
   679	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_is_frozen
   680	BEFORE UPDATE ON jobs
   681	WHEN OLD.builder_seat <> NEW.builder_seat
   682	  OR OLD.builder_tier <> NEW.builder_tier
   683	  OR OLD.builder_family <> NEW.builder_family
   684	BEGIN
   685	    SELECT RAISE(ABORT, 'guard: who built this cannot be rewritten after the fact');
   686	END;
   687	
   688	-- The panel size is fixed at dispatch. (Sol #7 — it could be set to zero later.)
   689	CREATE TRIGGER IF NOT EXISTS guard_panel_size_is_fixed
   690	BEFORE UPDATE OF required_reviews ON jobs
   691	WHEN OLD.required_reviews > 0 AND NEW.required_reviews < OLD.required_reviews
   692	BEGIN
   693	    SELECT RAISE(ABORT, 'guard: the panel cannot be shrunk after dispatch');
   694	END;
   695	
   696	-- A verdict, once written, is a fact. It cannot be edited into a pass.
   697	-- (Sol #2 — every verdict guard checked INSERT only, so you could rewrite the row.)
   698	CREATE TRIGGER IF NOT EXISTS guard_verdicts_are_append_only
   699	BEFORE UPDATE ON verdicts
   700	WHEN OLD.verdict <> NEW.verdict
   701	     AND NOT (OLD.verdict = 'needs_human' AND NEW.verdict IN ('pass','fail'))
   702	BEGIN
   703	    SELECT RAISE(ABORT, 'guard: a verdict cannot be rewritten — only an escalation may be answered');
   704	END;
   705	
   706	CREATE TRIGGER IF NOT EXISTS guard_verdict_identity_is_frozen
   707	BEFORE UPDATE ON verdicts
   708	WHEN OLD.role <> NEW.role OR OLD.model_family <> NEW.model_family
   709	  OR OLD.reviewer_seat <> NEW.reviewer_seat OR OLD.reviewer_tier <> NEW.reviewer_tier
   710	BEGIN
   711	    SELECT RAISE(ABORT, 'guard: who reviewed this cannot be rewritten after the fact');
   712	END;
   713	
   714	-- ═══════════════════════════════════════════════════════════════════════════
   715	-- THE REVIEW-TO-VERSION CHAIN (Sol build gate 3, 2026-07-20).
   716	--
   717	-- Sol's most dangerous flaw: "approve version A, builder changes it to B, the old
   718	-- approval still counts — believable green checks on code nobody reviewed."
   719	--
   720	-- The fix is not another approval ceremony; it is arithmetic. A verdict carries the
   721	-- version it reviewed. A job carries the version it is putting forward. Completion
   722	-- guards only count verdicts whose versions MATCH — so moving the code voids the
   723	-- approvals by construction, nothing needs to remember to revoke anything. And a
   724	-- FAIL condemns the version it saw, not the job forever: fix the code, the version
   725	-- changes, the old fail becomes history. (A fail with no recorded version blocks
   726	-- everything — fail-closed, because it condemned we-don't-know-what.)
   727	-- ═══════════════════════════════════════════════════════════════════════════
   728	
   729	-- A versioned job accepts no unversioned verdicts. (Unversioned legacy jobs keep
   730	-- their old semantics; the gatekeeper will not push anything unversioned anyway.)
   731	CREATE TRIGGER IF NOT EXISTS guard_verdict_must_cite_what_it_reviewed
   732	BEFORE INSERT ON verdicts
   733	WHEN (SELECT head_version FROM jobs WHERE id = NEW.job_id) IS NOT NULL
   734	     AND TRIM(COALESCE(NEW.reviewed_version, '')) = ''
   735	BEGIN
   736	    SELECT RAISE(ABORT, 'guard: this job is versioned — a verdict must say which version it reviewed');
   737	END;
   738	
   739	-- A build cannot finish without declaring WHICH code is finished.
   740	CREATE TRIGGER IF NOT EXISTS guard_a_build_finishes_a_version
   741	BEFORE UPDATE OF status ON jobs
   742	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   743	     AND NEW.kind = 'build'
   744	     AND TRIM(COALESCE(NEW.head_version, '')) = ''
   745	BEGIN
   746	    SELECT RAISE(ABORT, 'guard: a build cannot finish without naming the exact version that is finished');
   747	END;
   748	
   749	-- Once finished, WHAT finished is history. Rewriting head_version after done would
   750	-- let approved-hash-A ship as hash-B while every record still looks green.
   751	CREATE TRIGGER IF NOT EXISTS guard_finished_version_is_frozen
   752	BEFORE UPDATE OF head_version ON jobs
   753	WHEN OLD.status IN ('done', 'shipped') AND OLD.head_version IS NOT NEW.head_version
   754	BEGIN
   755	    SELECT RAISE(ABORT, 'guard: what version finished cannot be rewritten after the fact');
   756	END;
   757	
   758	-- A verdict cannot be DELETED. (Sol, round 3 — verified 2026-07-14.)
   759	--
   760	-- "Append-only" was enforced only against UPDATE, so a failing review that couldn't be
   761	-- EDITED into a pass could simply be DELETED — after which guard_a_failing_review_stops_it
   762	-- (which asks "does a fail EXIST?") saw nothing and let the job complete. Confirmed with a
   763	-- live exploit: fail deleted, then done. A verdict is a fact; facts are not retractable.
   764	CREATE TRIGGER IF NOT EXISTS guard_verdicts_cannot_be_deleted
   765	BEFORE DELETE ON verdicts
   766	BEGIN
   767	    SELECT RAISE(ABORT, 'guard: a verdict is a fact on the record — it cannot be deleted');
   768	END;
   769	
   770	-- A reviewer cannot LIE about who it is. (Sol #4 — the DB took the row's word for it.)
   771	CREATE TRIGGER IF NOT EXISTS guard_reviewer_identity_must_be_real
   772	BEFORE INSERT ON verdicts
   773	WHEN NEW.reviewer_tier <> (SELECT tier FROM seats WHERE id = NEW.reviewer_seat)
   774	  OR NEW.model_family  <> (SELECT family FROM seats WHERE id = NEW.reviewer_seat)
   775	BEGIN
   776	    SELECT RAISE(ABORT, 'guard: a reviewer cannot misrepresent its own tier or family');
   777	END;
   778	
   779	-- Build evidence can only come from the harness. (Sol #9 — the DB accepted a
   780	-- model-captured screenshot; only the Python helper refused.)
   781	CREATE TRIGGER IF NOT EXISTS guard_models_cannot_forge_evidence
   782	BEFORE INSERT ON artifacts
   783	WHEN NEW.captured_by = 'model' AND NEW.kind NOT IN ('source', 'quote')
   784	BEGIN
   785	    SELECT RAISE(ABORT, 'guard: a model may cite a source but may not produce build evidence');
   786	END;
   787	
   788	-- ===========================================================================
   789	-- GUARD 1 — local output never ships unreviewed (§4.3, §9)
   790	-- Now reads the SNAPSHOT (builder_tier), not the live seat.
   791	-- ===========================================================================
   792	CREATE TRIGGER IF NOT EXISTS guard_local_output_needs_review
   793	BEFORE UPDATE OF status ON jobs
   794	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   795	     AND NEW.builder_tier = 'local'
   796	BEGIN
   797	    SELECT RAISE(ABORT, 'guard: local-built job requires a passing subscription-tier review before done')
   798	    WHERE NOT EXISTS (
   799	        SELECT 1 FROM verdicts v
   800	        WHERE v.job_id = NEW.id
   801	          AND v.reviewer_tier IN ('subscription', 'metered')
   802	          AND v.verdict = 'pass'
   803	          -- gate 3: a pass only counts for the version it actually reviewed
   804	          AND v.reviewed_version IS NEW.head_version
   805	    );
   806	END;
   807	
   808	-- ===========================================================================
   809	-- GUARD 2 — escalations must be answered, not outrun (§6)
   810	-- ===========================================================================
   811	CREATE TRIGGER IF NOT EXISTS guard_unresolved_escalation
   812	BEFORE UPDATE OF status ON jobs
   813	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   814	BEGIN
   815	    SELECT RAISE(ABORT, 'guard: job has an unresolved needs_human verdict')
   816	    WHERE EXISTS (
   817	        SELECT 1 FROM verdicts v WHERE v.job_id = NEW.id AND v.verdict = 'needs_human'
   818	    );
   819	END;
   820	
   821	-- ===========================================================================
   822	-- GUARD 3 — a tester's verdict must cite REAL BUILD EVIDENCE.
   823	--
   824	-- ⚠️ Sol #3: "The 'no screenshot, no verdict' claim is false." My original guard
   825	-- accepted ANY artifact — including a research source, or an empty row. So a tester
   826	-- could "pass" a job on the strength of a URL somebody pasted. Now it must be
   827	-- evidence the HARNESS captured by actually driving the app.
   828	-- ===========================================================================
   829	CREATE TRIGGER IF NOT EXISTS guard_tester_must_cite_artifacts
   830	BEFORE INSERT ON verdicts
   831	WHEN NEW.role = 'tester'
   832	BEGIN
   833	    SELECT RAISE(ABORT, 'guard: a tester verdict requires real captured evidence — no screenshot, no verdict')
   834	    WHERE NOT EXISTS (
   835	        SELECT 1 FROM artifacts a
   836	        WHERE a.job_id = NEW.job_id
   837	          AND a.kind IN ('screenshot', 'trace', 'video', 'dom_snapshot')
   838	          AND a.captured_by IN ('harness', 'playwright')
   839	          AND COALESCE(a.path, a.value) IS NOT NULL
   840	    );
   841	END;
   842	
   843	-- ===========================================================================
   844	-- GUARD 4 — a model family may not test its own work.
   845	-- Reads the snapshot, so re-pointing a seat later changes nothing.
   846	-- ===========================================================================
   847	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_testing
   848	BEFORE INSERT ON verdicts
   849	WHEN NEW.role = 'tester'
   850	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
   851	BEGIN
   852	    SELECT RAISE(ABORT, 'guard: a model family may not test its own build');
   853	END;
   854	
   855	-- ===========================================================================
   856	-- GUARD 5 — the full panel, always. DISTINCT reviewers.
   857	--
   858	-- ⚠️ Sol #7: "The full panel can be faked with duplicate passes." It counted ROWS.
   859	-- One reviewer could pass the same job six times. Now it counts distinct seats.
   860	-- ===========================================================================
   861	-- The floor is UNCONDITIONAL (migration 007). It used to fire only when
   862	-- required_reviews > 0 — so a job whose requirements were never stamped had no
   863	-- requirements to fail, and reached 'done' with zero verdicts. Unstamped is not
   864	-- unrequired.
   865	CREATE TRIGGER IF NOT EXISTS guard_full_panel
   866	BEFORE UPDATE OF status ON jobs
   867	WHEN NEW.status = 'done' AND OLD.status <> 'done'
   868	BEGIN
   869	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
   870	    WHERE (
   871	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
   872	        -- the panel could be "filled" by the wrong kinds of check entirely.
   873	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
   874	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   875	          -- gate 3: the panel must have reviewed THIS version, not an earlier one
   876	          AND v.reviewed_version IS NEW.head_version
   877	    ) < MAX(NEW.required_reviews, 1);
   878	END;
   879	
   880	-- ===========================================================================
   881	-- GUARD 5b — the family floor (task #10). "Full set, always" counts SEATS; it does
   882	-- not guarantee more than one MIND looked. Sol's #10 gate: min_model_families was
   883	-- enforced nowhere in the DB — the gauntlet's core property rested on Python. Now
   884	-- the DB refuses ->done without >= required_review_families DISTINCT passing families
   885	-- on this version. Fails closed: too few families -> parked (never lowers the bar).
   886	-- Snapshotted un-lowerable at dispatch (guard_family_floor_is_fixed).
   887	-- ===========================================================================
   888	CREATE TRIGGER IF NOT EXISTS guard_family_floor_is_fixed
   889	BEFORE UPDATE OF required_review_families ON jobs
   890	WHEN OLD.required_review_families > 0 AND NEW.required_review_families < OLD.required_review_families
   891	BEGIN
   892	    SELECT RAISE(ABORT, 'guard: the family floor cannot be lowered after dispatch');
   893	END;
   894	
   895	CREATE TRIGGER IF NOT EXISTS guard_family_floor
   896	BEFORE UPDATE OF status ON jobs
   897	WHEN NEW.status = 'done' AND OLD.status <> 'done'
   898	BEGIN
   899	    SELECT RAISE(ABORT, 'guard: fewer model families reviewed this than required')
   900	    WHERE (
   901	        SELECT COUNT(DISTINCT v.model_family) FROM verdicts v
   902	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   903	          AND v.reviewed_version IS NEW.head_version
   904	          -- The AUTHOR is not a second opinion. Same-family review is allowed (it is a
   905	          -- weaker signal, not a forbidden one — see test_jobs.py) but it does not COUNT
   906	          -- toward diversity, or "two different minds" could include the one that wrote
   907	          -- it. (Migration 007.)
   908	          AND v.model_family <> NEW.builder_family
   909	    ) < MAX(NEW.required_review_families, 1);
   910	END;
   911	
   912	-- ---------------------------------------------------------------------------
   913	-- The gatekeeper's own log (task #11). events.job_id is NOT NULL, and a deploy is not
   914	-- necessarily about a job — so without this, a deploy's grants AND refusals had nowhere
   915	-- to go and were silently dropped. Append-only, like verdicts: a record, not a draft.
   916	-- ---------------------------------------------------------------------------
   917	CREATE TABLE IF NOT EXISTS gate_log (
   918	    id          INTEGER PRIMARY KEY,
   919	    verb        TEXT NOT NULL,
   920	    subject     TEXT NOT NULL,
   921	    granted     INTEGER NOT NULL CHECK (granted IN (0,1)),
   922	    detail      TEXT NOT NULL,
   923	    asked_by    TEXT NOT NULL,
   924	    job_id      INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   925	    created_at  TEXT NOT NULL DEFAULT (datetime('now'))
   926	);
   927	
   928	CREATE TRIGGER IF NOT EXISTS guard_gate_log_is_append_only
   929	BEFORE UPDATE ON gate_log
   930	BEGIN
   931	    SELECT RAISE(ABORT, 'guard: the gatekeeper log is a record, not a draft');
   932	END;
   933	
   934	CREATE TRIGGER IF NOT EXISTS guard_gate_log_cannot_be_deleted
   935	BEFORE DELETE ON gate_log
   936	BEGIN
   937	    SELECT RAISE(ABORT, 'guard: the gatekeeper log cannot be deleted');
   938	END;
   939	
   940	-- ═══════════════════════════════════════════════════════════════════════════
   941	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   942	--
   943	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
   944	-- serious failure satisfied it. A reviewer could scream that the thing was broken and
   945	-- be outvoted by colleagues who hadn't noticed.
   946	--
   947	-- That is the opposite of what a gauntlet is FOR. One reviewer finding a real bug is
   948	-- the whole point — it isn't a democracy, it's a set of independent smoke detectors.
   949	-- Any one of them going off stops the job.
   950	-- ═══════════════════════════════════════════════════════════════════════════
   951	CREATE TRIGGER IF NOT EXISTS guard_a_failing_review_stops_it
   952	BEFORE UPDATE OF status ON jobs
   953	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   954	BEGIN
   955	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
   956	    WHERE EXISTS (
   957	        SELECT 1 FROM verdicts v
   958	        WHERE v.job_id = NEW.id AND v.verdict = 'fail'
   959	          -- gate 3: a fail condemns the VERSION it reviewed, not the job forever.
   960	          -- A fail with no version condemned we-don't-know-what: it blocks
   961	          -- everything. Same if the job itself is unversioned. Fail-closed.
   962	          AND (NEW.head_version IS NULL
   963	               OR v.reviewed_version IS NULL
   964	               OR v.reviewed_version = NEW.head_version)
   965	    );
   966	END;
   967	
   968	-- Sol, round 2, #6: an objection raised AFTER 'done' could still be outrun, because
   969	-- the escalation guard only fired on the transition INTO done — not on done -> shipped.
   970	CREATE TRIGGER IF NOT EXISTS guard_late_escalation_still_blocks_shipping
   971	BEFORE UPDATE OF status ON jobs
   972	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   973	BEGIN
   974	    SELECT RAISE(ABORT, 'guard: someone raised an objection — it has to be answered first')
   975	    WHERE EXISTS (
   976	        SELECT 1 FROM verdicts v
   977	        WHERE v.job_id = NEW.id
   978	          AND (v.verdict = 'needs_human'  -- an unanswered question blocks, always
   979	               -- gate 3: a fail blocks the version it condemned (fail-closed when
   980	               -- either side is unversioned)
   981	               OR (v.verdict = 'fail'
   982	                   AND (NEW.head_version IS NULL
   983	                        OR v.reviewed_version IS NULL
   984	                        OR v.reviewed_version = NEW.head_version)))
   985	    );
   986	END;
   987	
   988	-- Sol, round 2, #4: evidence could be an EMPTY STRING. A path of '' satisfied
   989	-- "COALESCE(path, value) IS NOT NULL" perfectly well.
   990	CREATE TRIGGER IF NOT EXISTS guard_evidence_cannot_be_empty
   991	BEFORE INSERT ON artifacts
   992	WHEN TRIM(COALESCE(NEW.path, NEW.value, '')) = ''
   993	BEGIN
   994	    SELECT RAISE(ABORT, 'guard: evidence with nothing in it is not evidence');
   995	END;
   996	
   997	-- ===========================================================================
   998	-- GUARD 6 — nothing ships without a passing cross-family tester.
   999	-- ===========================================================================
  1000	CREATE TRIGGER IF NOT EXISTS guard_ship_requires_a_passing_tester
  1001	BEFORE UPDATE OF status ON jobs
  1002	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
  1003	BEGIN
  1004	    SELECT RAISE(ABORT, 'guard: nothing ships without a passing cross-family tester on the record')
  1005	    WHERE OLD.status <> 'done'
  1006	       OR NOT EXISTS (
  1007	           SELECT 1 FROM verdicts v
  1008	           WHERE v.job_id = NEW.id AND v.role = 'tester' AND v.verdict = 'pass'
  1009	             -- gate 3: the tester must have driven THIS version of the app
  1010	             AND v.reviewed_version IS NEW.head_version
  1011	       );
  1012	END;
  1013	
  1014	-- ===========================================================================
  1015	-- GUARD 7 — a researcher must show you where it got that.
  1016	-- ===========================================================================
  1017	CREATE TRIGGER IF NOT EXISTS guard_research_must_cite_sources
  1018	BEFORE UPDATE OF status ON jobs
  1019	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
  1020	     AND NEW.kind = 'research'
  1021	BEGIN
  1022	    SELECT RAISE(ABORT, 'guard: a research answer must cite sources — no source, no answer')
  1023	    WHERE NOT EXISTS (
  1024	        SELECT 1 FROM artifacts a
  1025	        WHERE a.job_id = NEW.id AND a.kind IN ('source', 'quote')
  1026	          AND COALESCE(a.path, a.value) IS NOT NULL
  1027	    );
  1028	END;
  1029	
  1030	-- ===========================================================================
  1031	-- GUARD 8 — a model family may not fact-check its own research.
  1032	-- ===========================================================================
  1033	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_verifying
  1034	BEFORE INSERT ON verdicts
  1035	WHEN NEW.role = 'verifier'
  1036	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
  1037	BEGIN
  1038	    SELECT RAISE(ABORT, 'guard: a model family may not fact-check its own research');
  1039	END;
  1040	
  1041	-- ===========================================================================
  1042	-- GUARD 9 — spend caps are enforced by the DATABASE, not by good manners.
  1043	--
  1044	-- ⚠️ Sol #8: "Spend caps do not structurally prevent runaway cost." They were a
  1045	-- Python check before dispatch — a classic race (two dispatches both pass the check
  1046	-- before either records spend), and a direct write skipped them entirely. Now the
  1047	-- ledger itself refuses the entry that would breach the cap.
  1048	-- ===========================================================================
  1049	CREATE TRIGGER IF NOT EXISTS guard_no_negative_spend
  1050	BEFORE INSERT ON usage
  1051	WHEN NEW.cost_cents < 0
  1052	BEGIN
  1053	    SELECT RAISE(ABORT, 'guard: spend cannot be negative — no unwinding the meter');
  1054	END;
  1055	
  1056	CREATE TRIGGER IF NOT EXISTS guard_daily_cap_is_hard
  1057	BEFORE INSERT ON usage
  1058	BEGIN
  1059	    SELECT RAISE(ABORT, 'guard: this seat is over its daily cap')
  1060	    WHERE (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1061	      AND (
  1062	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1063	         WHERE seat_id = NEW.seat_id AND day = date('now')
  1064	      ) + NEW.cost_cents
  1065	      > (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id);
  1066	END;
  1067	
  1068	-- Ration the EXPENSIVE work separately. A seat can be generous on reviewing and
  1069	-- stingy on building — which is exactly how you want a metered seat to behave when
  1070	-- you already pay flat-rate for two better builders.
  1071	CREATE TRIGGER IF NOT EXISTS guard_build_cap_is_hard
  1072	BEFORE INSERT ON usage
  1073	WHEN NEW.role = 'build'
  1074	BEGIN
  1075	    SELECT RAISE(ABORT, 'guard: this seat has used up its building budget for today — it can still review')
  1076	    WHERE (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1077	      AND (
  1078	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1079	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role = 'build'
  1080	      ) + NEW.cost_cents
  1081	      > (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id);
  1082	END;
  1083	
  1084	CREATE TRIGGER IF NOT EXISTS guard_review_cap_is_hard
  1085	BEFORE INSERT ON usage
  1086	WHEN NEW.role IN ('review', 'test')
  1087	BEGIN
  1088	    SELECT RAISE(ABORT, 'guard: this seat is over its reviewing budget for today')
  1089	    WHERE (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1090	      AND (
  1091	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1092	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role IN ('review','test')
  1093	      ) + NEW.cost_cents
  1094	      > (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id);
  1095	END;
  1096	
  1097	-- Keep updated_at honest.
  1098	CREATE TRIGGER IF NOT EXISTS jobs_touch_updated_at
  1099	AFTER UPDATE ON jobs
  1100	FOR EACH ROW
  1101	BEGIN
  1102	    UPDATE jobs SET updated_at = datetime('now') WHERE id = NEW.id;
  1103	END;
  1104	
  1105	-- ---------------------------------------------------------------------------
  1106	-- The §7 voice query: "what did the overnight run do?"
  1107	-- ---------------------------------------------------------------------------
  1108	CREATE VIEW IF NOT EXISTS job_report AS
  1109	SELECT
  1110	    j.id,
  1111	    j.created_at,
  1112	    j.finished_at,
  1113	    j.request,
  1114	    j.origin,
  1115	    j.builder_seat,
  1116	    s.provider   AS builder_provider,
  1117	    s.tier       AS builder_tier,
  1118	    j.status,
  1119	    j.branch,
  1120	    j.spoken_summary,
     1	"""Durable job store for the Chief Command v2 harness.
     2	
     3	OpenClaw dispatches the work; this records it. Its subagent sessions auto-archive
     4	after ~60 minutes, so anything we want to answer later ("what did the overnight run
     5	do?", spec §7) has to live here.
     6	
     7	The two rules that must never quietly stop holding are enforced in schema.sql as
     8	triggers, not here — see guard_local_output_needs_review and
     9	guard_unresolved_escalation. This module will simply raise if you try to violate them.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import sqlite3
    15	from dataclasses import dataclass
    16	from pathlib import Path
    17	from typing import Any, Iterable, Optional
    18	
    19	DB_PATH = Path(__file__).resolve().parent / "chief.db"
    20	SCHEMA_PATH = Path(__file__).resolve().parent / "schema.sql"
    21	
    22	# Raised by the schema triggers. We surface it as something catchable.
    23	class GuardViolation(RuntimeError):
    24	    """A structural rule was violated (e.g. shipping unreviewed local output)."""
    25	
    26	
    27	@dataclass(frozen=True)
    28	class Seat:
    29	    id: str
    30	    provider: str
    31	    model: str
    32	    family: str  # gpt | claude | grok | qwen — what determines shared blind spots
    33	    tier: str  # local | subscription | metered
    34	    daily_cap_cents: Optional[int] = None   # hard ceiling across everything
    35	    build_cap_cents: Optional[int] = None   # ration the EXPENSIVE work
    36	    review_cap_cents: Optional[int] = None  # reviewing is cheap — be generous
    37	    # Three models per seat. NOTHING gets `heavy` by default — it has to be earned.
    38	    # Rate limits, not money, are the binding constraint on autonomous work, and you
    39	    # cannot buy your way out of a weekly cap.
    40	    model_light: Optional[str] = None
    41	    model_standard: Optional[str] = None
    42	    model_heavy: Optional[str] = None
    43	    enabled: bool = True
    44	    notes: str = ""
    45	
    46	
    47	def connect(db_path: Path | str = DB_PATH) -> sqlite3.Connection:
    48	    # timeout is stated rather than inherited from the stdlib default: the review panel
    49	    # writes verdicts from several threads at once, and how long a writer waits for the
    50	    # lock before giving up is a real property of this system, not a detail to leave to
    51	    # whatever the standard library happens to pick.
    52	    conn = sqlite3.connect(db_path, isolation_level=None,  # autocommit; we manage txns
    53	                           timeout=15.0)
    54	    conn.row_factory = sqlite3.Row
    55	    conn.execute("PRAGMA foreign_keys = ON")
    56	    conn.execute("PRAGMA busy_timeout = 15000")
    57	    return conn
    58	
    59	
    60	def init_db(conn: sqlite3.Connection) -> None:
    61	    """Build the schema on a FRESH database only.
    62	
    63	    This used to run schema.sql on EVERY call — including server startup against the LIVE
    64	    DB. That made editing schema.sql a silent live deploy: a new `CREATE TRIGGER IF NOT
    65	    EXISTS` installs on the next restart while `CREATE TABLE IF NOT EXISTS` stays a no-op,
    66	    so a trigger can land WITHOUT the column it references and jam every status change (it
    67	    did, 2026-07-20). An existing DB now advances ONLY through the numbered migrations in
    68	    db/migrations/, applied deliberately — never as a side effect of a restart.
    69	    """
    70	    initialized = conn.execute(
    71	        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'jobs'"
    72	    ).fetchone()
    73	    if initialized:
    74	        return
    75	    conn.executescript(SCHEMA_PATH.read_text())
    76	
    77	
    78	def _guarded(fn):
    79	    """Translate the schema's RAISE(ABORT, 'guard: ...') into GuardViolation."""
    80	
    81	    def wrapper(*args, **kwargs):
    82	        try:
    83	            return fn(*args, **kwargs)
    84	        except sqlite3.IntegrityError as exc:
    85	            if "guard:" in str(exc):
    86	                raise GuardViolation(str(exc)) from exc
    87	            raise
    88	
    89	    return wrapper
    90	
    91	
    92	# --------------------------------------------------------------------------
    93	# Seats
    94	# --------------------------------------------------------------------------
    95	def upsert_seat(conn: sqlite3.Connection, seat: Seat) -> None:
    96	    conn.execute(
    97	        """
    98	        INSERT INTO seats (id, provider, model, family, tier, daily_cap_cents,
    99	                           build_cap_cents, review_cap_cents,
   100	                           model_light, model_standard, model_heavy, enabled, notes)
   101	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
   102	        ON CONFLICT(id) DO UPDATE SET
   103	            provider = excluded.provider,
   104	            model = excluded.model,
   105	            family = excluded.family,
   106	            tier = excluded.tier,
   107	            daily_cap_cents = excluded.daily_cap_cents,
   108	            build_cap_cents = excluded.build_cap_cents,
   109	            review_cap_cents = excluded.review_cap_cents,
   110	            model_light = excluded.model_light,
   111	            model_standard = excluded.model_standard,
   112	            model_heavy = excluded.model_heavy,
   113	            enabled = excluded.enabled,
   114	            notes = excluded.notes
   115	        """,
   116	        (seat.id, seat.provider, seat.model, seat.family, seat.tier,
   117	         seat.daily_cap_cents, seat.build_cap_cents, seat.review_cap_cents,
   118	         seat.model_light, seat.model_standard, seat.model_heavy,
   119	         int(seat.enabled), seat.notes),
   120	    )
   121	
   122	
   123	def seat(conn: sqlite3.Connection, seat_id: str) -> sqlite3.Row | None:
   124	    return conn.execute("SELECT * FROM seats WHERE id = ?", (seat_id,)).fetchone()
   125	
   126	
   127	# --------------------------------------------------------------------------
   128	# Jobs
   129	# --------------------------------------------------------------------------
   130	def create_job(
   131	    conn: sqlite3.Connection,
   132	    request: str,
   133	    builder_seat: str,
   134	    origin: str = "text",
   135	    parent_job_id: Optional[int] = None,
   136	    task_name: Optional[str] = None,
   137	) -> int:
   138	    """task_name is the 2-4 word handle the voice will use ("the rate limiter").
   139	
   140	    The mouth coins it at dispatch. Without one the voice falls back to truncating
   141	    the request, which reads back the owner's own paragraph at him — exactly what a
   142	    colleague would never do.
   143	    """
   144	    row = seat(conn, builder_seat)
   145	    if row is None:
   146	        raise ValueError(f"unknown builder seat: {builder_seat}")
   147	
   148	    # Snapshot who built this, AT BUILD TIME. Sol's cross-family review found that
   149	    # reading the builder's tier live meant re-tiering a local seat retroactively
   150	    # legitimized its old unreviewed work. What a seat is today cannot change what
