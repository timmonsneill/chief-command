++    # to live in the same process.
++    import gatekeeper
+     try:
+-        record_usage(conn, seat_id, cents, job_id=job_id, role="review")
++        gatekeeper.spend(conn, seat_id, cents, job_id=job_id, role="review",
++                         asked_by="the review panel")
+         return True
+-    except GuardViolation:
