++    # and then parked forever with nothing to explain it, instead of one legible refusal
++    # at the door. Both entrances, one rule.
+     gauntlet = cfg.get("gauntlet", {})
+-    required = len(gauntlet.get("reviewers", []))          # full set, always (seats)
