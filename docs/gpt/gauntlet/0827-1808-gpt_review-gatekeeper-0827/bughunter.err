     if row is None:
         raise DispatchRefused(f"unknown seat: {builder_seat}")
     if not row["enabled"]:
         raise DispatchRefused(f"seat '{builder_seat}' is disabled")
 
     # OpenClaw core has NO per-agent budget of any kind. If we don't check here,
     # nothing does.
