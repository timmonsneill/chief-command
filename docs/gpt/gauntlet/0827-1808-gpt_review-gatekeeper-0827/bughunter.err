    14	
    15	sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    16	
    17	import gatekeeper  # noqa: E402
    18	from db.jobs import (  # noqa: E402
    19	    Seat, connect, create_job, init_db, record_artifact, record_verdict,
    20	    set_head_version, set_status, upsert_seat,
    21	)
    22	
