   128	def test_merge_refuses_approvals_that_belong_to_an_older_version(conn):
   129	    """The reviews were real — of code that has since changed. This is the flaw Sol
   130	    called the most dangerous in the whole system: believable green ticks on code
   131	    nobody reviewed."""
   132	    job = _finished_job(conn)
   133	    set_status(conn, job, "done")
   134	    conn.execute("UPDATE jobs SET status='review' WHERE id=?", (job,))
   135	    set_head_version(conn, job, "v2")            # the builder moved the code
   136	    with pytest.raises(gatekeeper.Refused):
   137	        gatekeeper.merge(conn, job)
