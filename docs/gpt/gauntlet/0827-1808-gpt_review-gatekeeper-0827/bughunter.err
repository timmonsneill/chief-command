   330	def _review_one(
   331	    job_id: int,
   332	    seat_id: str,
   333	    request: str,
   334	    code: str,
   335	    version: str,
   336	    cfg: dict[str, Any],
   337	    out: ReviewerRun,
   338	    db_path: Path,
   339	    decided: threading.Event,
   340	) -> None:
   341	    """One reviewer, in its own thread, on its own connection. Never raises.
   342	
   343	    The outer try/except is not belt-and-braces. ANY escape from this function kills the
   344	    thread with the run left blank — neither a verdict nor a stated reason — and a
   345	    reviewer that is neither counted nor excused is precisely the silent shrink this
   346	    panel exists to prevent. So every exit lands in `out`.
   347	    """
   348	    conn = None
   349	    try:
   350	        conn = connect(db_path)
   351	        row = seat(conn, seat_id)
   352	        if row is None:
   353	            out.skipped = "that reviewer isn't set up"
   354	            return
   355	        out.family = row["family"]
   356	        if not row["enabled"]:
   357	            out.skipped = "that reviewer is turned off"
   358	            _event(conn, job_id, row, "skipped", out.skipped)
   359	            return
   360	        runner = REVIEWERS.get(row["provider"])
   361	        if runner is None:
   362	            out.skipped = "we can't run that reviewer on this machine yet"
   363	            _event(conn, job_id, row, "skipped", out.skipped)
   364	            return
   365	        if over_budget(conn, seat_id):
   366	            out.skipped = "that reviewer is out of budget for today"
   367	            _event(conn, job_id, row, "skipped", out.skipped)
   368	            return
   369	
   370	        estimate = int(
   371	            cfg.get("seats", {}).get(seat_id, {}).get(
   372	                "review_estimate_cents", DEFAULT_ESTIMATE_CENTS)
   373	        )
   374	        # Already reviewed this exact version? Then this is a re-run, and repeating it
   375	        # would spend the money twice and stack duplicate verdicts on the record.
   376	        already = conn.execute(
   377	            "SELECT verdict, summary FROM verdicts WHERE job_id=? AND reviewer_seat=? "
   378	            "AND reviewed_version IS ? ORDER BY id DESC LIMIT 1",
   379	            (job_id, seat_id, version),
   380	        ).fetchone()
   381	        if already is not None:
   382	            out.verdict, out.summary = already["verdict"], already["summary"] or ""
   383	            return
   384	
   385	        if not _reserve_review_budget(conn, seat_id, job_id, estimate):
   386	            out.skipped = "that reviewer is out of budget for today"
   387	            _event(conn, job_id, row, "skipped", out.skipped)
   388	            return
   389	
   390	        _event(conn, job_id, row, "thinking", "Checking the work.")
   391	        try:
   392	            verdict, summary = runner(request, code, row["model"])
   393	        except subprocess.TimeoutExpired:
   394	            out.skipped = "that reviewer took too long and was stopped"
   395	            _event(conn, job_id, row, "error", out.skipped)
   396	            return
   397	        except ReviewerBroke as exc:
   398	            # The TOOL failed, not the work. Never a verdict — see ReviewerBroke.
   399	            out.skipped = "that reviewer couldn't run"
   400	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:160]}")
   401	            return
   402	        except Exception as exc:                      # noqa: BLE001 — a dead reviewer
   403	            out.skipped = "that reviewer couldn't finish"   # is a skip, never a pass
   404	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:120]}")
   405	            return
   406	
   407	        # The panel has already decided and moved on without us. Recording now would
   408	        # land a verdict on a job that was called finished a moment ago — and if it were
   409	        # a FAIL, the completion guards could no longer act on it, because they only fire
   410	        # on the way INTO done. A late answer is a non-answer.
   411	        if decided.is_set():
   412	            out.skipped = "that reviewer answered after the panel had already decided"
   413	            _event(conn, job_id, row, "skipped", out.skipped)
   414	            return
   415	
   416	        # reviewed_version is passed EXPLICITLY, never defaulted. The default reads the
   417	        # job's current head — which is only correct if nothing moved, and the whole
   418	        # point of the frozen bundle is not to depend on that being true.
   419	        try:
   420	            record_verdict(conn, job_id, seat_id, verdict=verdict,
   421	                           summary=summary, role="reviewer", reviewed_version=version)
   422	        except GuardViolation as exc:
   423	            out.skipped = "the record refused that verdict"
   424	            _event(conn, job_id, row, "error", str(exc)[:160])
   425	            return
   426	
   427	        # The `decided` check above and this write are not one step: the panel can
   428	        # decide and certify in between. A FAIL that lands after 'done' must un-certify
   429	        # from THIS side too — the writer is the only one who knows it just happened.
   430	        if verdict == "fail" and decided.is_set():
   431	            status = conn.execute("SELECT status FROM jobs WHERE id = ?",
   432	                                  (job_id,)).fetchone()["status"]
   433	            if status == "done":
   434	                set_status(conn, job_id, "review",
   435	                           spoken_summary="Sent back — a reviewer found a problem.")
   436	            elif status == "shipped":
   437	                # Too late to un-merge. The one thing we can still do is refuse to be
   438	                # quiet about it: a merged objection is Neill's to see, not a footnote.
   439	                set_status(conn, job_id, "shipped",
   440	                           spoken_summary="⚠ A reviewer objected AFTER this was merged — "
   441	                                          "it needs your eyes.")
   442	                _event(conn, job_id, row, "error",
   443	                       "objection recorded after merge — needs a person")
   444	
   445	        out.summary = summary
   446	        out.verdict = verdict          # set LAST: `verdict` is what marks the run as real
   447	        _event(conn, job_id, row, "verdict",
   448	               "Passed the check." if verdict == "pass" else "Sent it back with notes.")
   449	    except Exception as exc:                          # noqa: BLE001
   450	        out.skipped = out.skipped or f"that reviewer couldn't finish: {str(exc)[:120]}"
   451	    finally:
   452	        if conn is not None:
   453	            conn.close()
   454	
   455	
   456	def run_panel(
   457	    conn,
   458	    job_id: int,
   459	    request: str,
   460	    code: str,
   461	    version: str,
   462	    cfg: dict[str, Any],
   463	    *,
   464	    roster: list[str] | None = None,
   465	    db_path: Path | None = None,
   466	) -> PanelResult:
   467	    """Run the whole panel in parallel against one frozen bundle, then decide.
   468	
   469	    `conn` is the caller's connection, used only for the final decision. Each reviewer
   470	    gets its own. Returns what actually happened — including who didn't run and why.
   471	    """
   472	    import dispatch                      # local: dispatch imports this module
   473	
   474	    gauntlet = cfg.get("gauntlet", {})
   475	    # Ask the SAME question dispatch asked when it stamped the panel size on the job:
   476	    # who can actually sit? Falling back to the raw config list would put the panel and
   477	    # the job's own requirements at odds — the job needing 2 seats while the panel tried
   478	    # 3, one of which cannot run.
   479	    roster = roster if roster is not None else dispatch.panel_roster(conn, cfg)[0]
   480	    floor = int(gauntlet.get("min_model_families", 0))
   481	    db_path = db_path or DB_PATH
   482	
   483	    built_by = conn.execute("SELECT builder_family FROM jobs WHERE id = ?",
   484	                            (job_id,)).fetchone()
   485	    result = PanelResult(job_id=job_id, version=version, required_families=floor,
   486	                         builder_family=(built_by["builder_family"] if built_by else "") or "")
   487	
   488	    # A floor of zero is not "no requirement" — it is an UNCONFIGURED panel, and
   489	    # `0 < 0` is False, so every later check would wave it through and certify work
   490	    # nobody looked at. dispatch refuses this at the door; refuse it here too, because
   491	    # this function is reachable from anywhere and must not depend on its caller having
   492	    # been careful. Same for an empty roster: nobody to ask is not everybody agreeing.
   493	    if floor < 1 or not roster:
   494	        result.parked_reason = (
   495	            "no review panel is configured for this job — nothing would have checked it"
   496	        )
   497	        return result
   498	
   499	    result.runs = [ReviewerRun(seat_id=s) for s in roster]
   500	    decided = threading.Event()
   501	
   502	    threads = [
   503	        threading.Thread(
   504	            target=_review_one,
   505	            args=(job_id, run.seat_id, request, code, version, cfg, run, db_path,
   506	                  decided),
   507	            name=f"review-{job_id}-{run.seat_id}", daemon=True,
   508	        )
   509	        for run in result.runs
   510	    ]
   511	    for t in threads:
   512	        t.start()
   513	    for t in threads:
   514	        t.join(timeout=REVIEW_TIMEOUT_S + JOIN_GRACE_S)
   515	
   516	    # Close the door BEFORE reading any results. A reviewer still running has not
   517	    # answered, and must not be able to answer into a decision already made — the
   518	    # completion guards only fire on the way INTO done, so a late objection could never
   519	    # stop anything. It is recorded as not having participated, which is the truth.
   520	    decided.set()
   521	    for t, run in zip(threads, result.runs):
   522	        if t.is_alive() and not run.ran:
   523	            run.skipped = run.skipped or "that reviewer never answered"
   524	
   525	    # ── The decision. Every branch below ends in "leave it parked" except one. ──
   526	    if result.failed:
   527	        result.parked_reason = "a reviewer failed this version"
   528	        return result
   529	
   530	    families = result.families_passed
   531	    if len(families) < floor:
   532	        ran = len([r for r in result.runs if r.ran])
   533	        result.parked_reason = (
   534	            f"only {len(families)} model famil{'y' if len(families) == 1 else 'ies'} "
   535	            f"reviewed this ({ran} of {len(result.runs)} reviewers ran); "
   536	            f"{floor} are required"
   537	        )
   538	        return result
   539	
   540	    try:
   541	        set_status(conn, job_id, "done",
   542	                   spoken_summary=f"Checked by {len(families)} different models. Ready for you.")
   543	        result.certified = True
   544	    except GuardViolation as exc:
   545	        # Another gate still holds (panel size, an unanswered escalation, an old
   546	        # objection). Park honestly rather than argue with the boundary.
   547	        result.parked_reason = str(exc).replace("guard: ", "")
   548	
   549	    if result.certified:
   550	        _reconcile(conn, result)
   551	    if not result.certified:
   552	        # Say why it stopped, in the record, in plain words. A job parked with no stated
   553	        # reason is indistinguishable from a job nobody looked at.
   554	        conn.execute("UPDATE jobs SET spoken_summary = ? WHERE id = ?",
   555	                     (result.spoken(), job_id))
   556	    return result
   557	
   558	
   559	def _reconcile(conn, result: PanelResult) -> None:
   560	    """Last look: did an objection land while we were deciding?
   561	
   562	    The `decided` flag narrows that window; it cannot close it, because a straggler can
   563	    pass the check and be writing as the main thread commits. So after certifying we ask
   564	    the record — not our own bookkeeping — whether a failure exists against this version,
   565	    and un-certify if one does. Status can move back out of 'done'; the guards only
   566	    police the way in. A job wrongly parked costs a re-run. A job wrongly called finished
   567	    is the thing this project exists to prevent.
   568	    """
   569	    late = conn.execute(
   570	        "SELECT reviewer_seat FROM verdicts WHERE job_id=? AND verdict='fail' "
   180	
   181	
   182	def _strip_slash_comment(line: str) -> str:
   183	    """Drop an inline/full-line `//` comment, ignoring `//` inside quotes."""
   184	    quote = ""
   185	    for i in range(len(line) - 1):
   186	        ch = line[i]
   187	        if quote:
   188	            if ch == quote:
   189	                quote = ""
   190	        elif ch in "\"'":
   191	            quote = ch
   192	        elif ch == "/" and line[i + 1] == "/":
   193	            return line[:i].rstrip()
   194	    return line
   195	
   196	
   197	def unresolved_reviewers(cfg: dict[str, Any]) -> list[str]:
   198	    """Gauntlet reviewers that don't name a real seat. Empty == all resolve.
   199	
   200	    A roster entry pointing at a seat that doesn't exist (the old `grinder_paid`) is a
   201	    silent trap: `over_budget` treats the unknown seat as uncapped, the pre-check says
   202	    "fine," then the verdict write rejects it. Catch it at startup instead.
   203	    """
   204	    seats = cfg.get("seats", {})
   205	    return [r for r in cfg.get("gauntlet", {}).get("reviewers", []) if r not in seats]
   206	
   207	
   208	def panel_roster(conn, cfg: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
   209	    """Who can actually sit on the panel right now — and who can't, and why.
   210	
   211	    A roster entry is only real if the seat exists, is switched on, and we have a way to
   212	    RUN it on this machine. A seat whose provider has no runner, or whose key is absent, is excluded; the
   213	    codex seat needs its login. Counting those as panel members would produce a required
   214	    panel that can never report, which fails closed but useless — every job parked
   215	    forever. Counting them silently would be worse: a panel that shrank without saying
   216	    so reads exactly like a full one.
   217	
   218	    So: exclude them, name them, and let the FAMILY FLOOR (which cannot be lowered) be
   219	    the thing that decides whether what's left is enough.
   220	    """
   221	    import gauntlet
   222	
   223	    roster: list[str] = []
   224	    excluded: dict[str, str] = {}
   225	    for seat_id in cfg.get("gauntlet", {}).get("reviewers", []):
   226	        row = seat(conn, seat_id)
   227	        if row is None:
   228	            excluded[seat_id] = "that reviewer isn't set up on this machine"
   229	        elif not row["enabled"]:
   230	            excluded[seat_id] = "that reviewer is turned off"
   231	        elif not gauntlet.has_runner(row["provider"]):
   232	            excluded[seat_id] = "we have no way to run that reviewer yet"
   233	        else:
   234	            roster.append(seat_id)
   235	    return roster, excluded
   236	
   237	
   238	def _refuse_a_panel_that_cannot_hold(conn, roster: list[str], floor: int,
   239	                                     builder_family: str | None = None) -> None:
   240	    """Refuse to dispatch work the panel could never certify.
   241	
   242	    Fail CLOSED, but say so at DISPATCH — when it is one legible refusal — rather than
   243	    at review time, where it becomes a job that parks forever and looks like a bug.
   244	    """
   245	    if floor < 1:
   246	        raise DispatchRefused(
   247	            "the review panel isn't configured (it needs at least one model family) "
   248	            "— refusing to start work that nothing would check"
   249	        )
   250	    # Counted the way the database counts (migration 007): the author's own family is
   251	    # not a second opinion. Counting it here admitted jobs the record then parked.
   252	    families = {seat(conn, s)["family"] for s in roster} - {builder_family}
   253	    if len(families) < floor:
   254	        raise DispatchRefused(
   255	            f"only {len(families)} model family/families can review right now and "
   256	            f"{floor} are required — refusing to start work that could never be checked"
   257	        )
   258	
   259	
   260	def sync_seats(conn, cfg: dict[str, Any]) -> None:
   261	    """Push the config's seats into the store, so guards can reason about them.
   262	
   263	    Refuses a config whose gauntlet names a seat that doesn't exist, or a seat missing a
   264	    family — both would blow up later, mid-panel, where it's far harder to see.
   265	    """
   266	    missing = unresolved_reviewers(cfg)
   267	    if missing:
   268	        raise DispatchRefused(f"gauntlet names seats that don't exist: {missing}")
   269	    for seat_id, s in cfg.get("seats", {}).items():
   270	        if "family" not in s:
   271	            raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
   272	    for seat_id, s in cfg.get("seats", {}).items():
   273	        upsert_seat(conn, Seat(
   274	            id=seat_id,
   275	            provider=s["provider"],
   276	            model=s["model"],
   277	            family=s["family"],
   278	            tier=s["tier"],
   279	            daily_cap_cents=s.get("daily_cap_cents"),
   280	            build_cap_cents=s.get("build_cap_cents"),
   281	            review_cap_cents=s.get("review_cap_cents"),
   282	            enabled=not s.get("disabled", False),
   283	            notes=s.get("notes", ""),
   284	        ))
   285	
   286	
   287	# ---------------------------------------------------------------------------
   288	# Dispatch
   289	# ---------------------------------------------------------------------------
   290	@dataclass
   291	class Dispatch:
   292	    job_id: int
   293	    run_id: str | None
   294	    seat_id: str
   295	
   296	
   297	def dispatch(
   298	    conn,
   299	    request: str,
   300	    builder_seat: str,
   301	    cfg: dict[str, Any],
   302	    origin: str = "text",
   303	    blocking: bool = False,
   304	) -> Dispatch:
   305	    """Record the job, then spawn it on OpenClaw. In that order, always.
   306	
   307	    Non-blocking by default — this is what lets the mouth stay responsive. OpenClaw's
   308	    sessions_spawn returns a run id immediately, so the voice head can say "on it" and
   309	    keep talking while the work grinds. A blocking dispatch here would reintroduce
   310	    exactly the latency wound that killed v1.
   311	    """
   312	    row = seat(conn, builder_seat)
   313	    if row is None:
   314	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   315	    if not row["enabled"]:
   316	        raise DispatchRefused(f"seat '{builder_seat}' is disabled")
   317	
   318	    # OpenClaw core has NO per-agent budget of any kind. If we don't check here,
   319	    # nothing does.
   320	    if over_budget(conn, builder_seat):
   321	        raise DispatchRefused(
   322	            f"seat '{builder_seat}' is over its daily cap — refusing to dispatch"
   323	        )
   324	
   325	    # SAME roster question dispatch_local asks. This path used to count the raw config
   326	    # list, so a job here was stamped as needing 3 reviewers when only 2 could ever run —
   327	    # and then parked forever with nothing to explain it, instead of one legible refusal
   328	    # at the door. Both entrances, one rule.
   329	    gauntlet = cfg.get("gauntlet", {})
   330	    roster, excluded = panel_roster(conn, cfg)
   331	    required = len(roster)
   332	    families = int(gauntlet.get("min_model_families", 0))
   333	    _refuse_a_panel_that_cannot_hold(conn, roster, families, row["family"])
   334	
   335	    # One transaction: the job must never exist for even a moment without its review
   336	    # requirements stamped on (autocommit would otherwise leave a floor-0 gap).
   337	    # IMMEDIATE because this reads before it writes — see dispatch_local.
   338	    conn.execute("BEGIN IMMEDIATE")
   339	    try:
   340	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   341	        conn.execute(
   342	            "UPDATE jobs SET required_reviews = ?, required_review_families = ? WHERE id = ?",
   343	            (required, families, job_id),
   344	        )
   345	        # No silent caps here either — same note dispatch_local writes.
   346	        for seat_id, why in excluded.items():
   347	            ex = seat(conn, seat_id)
   348	            if ex is None:
   349	                continue
   350	            conn.execute(
   351	                "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   352	                "VALUES (?,?,?,?,?,?,?)",
   353	                (job_id, seat_id, seat_id, ex["model"], ex["family"], "skipped",
   354	                 f"not on the panel: {why}"),
   355	            )
   356	        conn.execute("COMMIT")
   357	    except Exception:
   358	        conn.execute("ROLLBACK")
   359	        raise
   360	
   361	    run_id = _spawn(row, request, blocking=blocking)
   362	    attach_run(conn, job_id, run_id=run_id or "", branch=f"job/{job_id}")
   363	    set_status(conn, job_id, "in_progress")
   364	
   365	    return Dispatch(job_id=job_id, run_id=run_id, seat_id=builder_seat)
   366	
   367	
   368	def _spawn(seat_row, request: str, blocking: bool) -> str | None:
   369	    """Hand the work to OpenClaw.
   370	
   371	    `openclaw agent` runs one turn via the Gateway. The model is chosen per-spawn,
   372	    which is what lets a single orchestrator turn fan out across several families.
   373	    """
   374	    cmd = [
   375	        "openclaw", "agent",
   376	        "--model", f"{seat_row['provider']}/{seat_row['model']}",
   377	        "--message", request,
   378	    ]
   379	    if not blocking:
   380	        cmd.append("--detach")
   381	
   382	    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
   383	    if proc.returncode != 0:
   384	        raise DispatchRefused(f"openclaw refused the spawn: {proc.stderr.strip()[:300]}")
   385	
   386	    # The gateway echoes a run id; fall back to the raw stdout if the shape changes.
   387	    try:
   388	        return json.loads(proc.stdout).get("runId")
   389	    except (json.JSONDecodeError, AttributeError):
   390	        return proc.stdout.strip()[:80] or None
   391	
   392	
   393	# ---------------------------------------------------------------------------
   394	# The gauntlet (spec §6)
   395	# ---------------------------------------------------------------------------
   396	def run_gauntlet(conn, job_id: int, cfg: dict[str, Any]) -> dict[str, Any]:
   397	    """Fan the finished work out to the reviewer panel, in parallel, same bundle.
   398	
   399	    This used to return a list of reviewer NAMES and launch nobody — the gauntlet was a
   400	    plan, not a thing that ran (task #10). It now runs the panel and returns what
     1	"""The gatekeeper: the one holder of merge, deploy and spend (task #11).
     2	
     3	The tests that matter here are the refusals. A gatekeeper that grants correctly and
     4	refuses sloppily is not a gatekeeper — so most of what follows is an agent asking for
     5	something it hasn't earned, in every way we could think of.
     6	
     7	The recurring theme: the request is never believed. Every check re-reads the record.
     8	"""
     9	
    10	import sys
    11	from pathlib import Path
    12	
