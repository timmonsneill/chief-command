   371	def test_an_empty_token_file_never_authorizes(tmp_path, monkeypatch):
   372	    """compare_digest('', '') is True. An empty token file used to let a header-less
   373	    request through — the exact CSRF the token exists to stop."""
   374	    path = tmp_path / "chief" / "gatekeeper.token"
   375	    monkeypatch.setattr(gatekeeper, "TOKEN_PATH", path)
   376	    first = gatekeeper.token()
   377	    assert len(first) >= 32
   378	    path.write_text("")                                     # truncated / disk-full
   379	    second = gatekeeper.token()
   380	    assert len(second) >= 32 and second != ""
