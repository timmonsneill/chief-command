   383	# ═══════════════════════════════════════════════════════════════════════════════
   384	# MERGE, FOR REAL — against an actual git repo, the check the verb exists for
   385	# ═══════════════════════════════════════════════════════════════════════════════
   386	def _git(repo, *args):
   387	    import subprocess
   388	    env = {"GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t",
   389	           "GIT_COMMITTER_EMAIL": "t@t", "PATH": __import__("os").environ["PATH"],
   390	           "HOME": str(repo)}
   391	    out = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True, env=env)
   392	    assert out.returncode == 0, out.stderr
   393	    return out.stdout.strip()
   394	
   395	
   396	@pytest.fixture()
   397	def repo(tmp_path, monkeypatch):
   398	    r = tmp_path / "repo"; r.mkdir()
   399	    _git(r, "init", "-q", "-b", "main")
   400	    (r / "README").write_text("v0\n"); _git(r, "add", "."); _git(r, "commit", "-q", "-m", "root")
   401	    monkeypatch.setattr(gatekeeper, "REPO", r)
   402	    return r
   403	
   404	
   405	def _job_on_branch(conn, repo, job_id, content, *, reviewed=None):
   406	    """Commit `content` where the worker commits its output, and record `reviewed`
   407	    (default: the same text) as what the panel read."""
   408	    _git(repo, "checkout", "-q", "-b", f"job/{job_id}")
   409	    out = repo / "chief_output"; out.mkdir(exist_ok=True)
   410	    (out / f"job_{job_id}.txt").write_text(content)
   411	    _git(repo, "add", "."); _git(repo, "commit", "-q", "-m", "work")
   412	    sha = _git(repo, "rev-parse", "HEAD")
   413	    _git(repo, "checkout", "-q", "main")
   414	    conn.execute("UPDATE jobs SET branch = ?, result = ? WHERE id = ?",
   415	                 (f"job/{job_id}", content if reviewed is None else reviewed, job_id))
   416	    return sha
   417	
   418	
   419	def _reviewed_and_done(conn, repo, job_id, content, *, reviewed=None):
   420	    conn.execute("UPDATE jobs SET required_reviews=2, required_review_families=2 WHERE id=?", (job_id,))
   421	    set_status(conn, job_id, "in_progress")
   422	    sha = _job_on_branch(conn, repo, job_id, content, reviewed=reviewed)
   423	    set_head_version(conn, job_id, sha[:16])
   424	    set_status(conn, job_id, "review")
   425	    for s in ("brain", "grok"):
   426	        record_verdict(conn, job_id, s, verdict="pass", role="reviewer")
   427	    set_status(conn, job_id, "done")
   428	    record_artifact(conn, job_id, "screenshot", path="/evidence/login.png", captured_by="playwright")
   429	    record_verdict(conn, job_id, "grok", verdict="pass", role="tester")
   430	    return sha
   431	
   432	
   433	def test_merge_refuses_when_the_commit_does_not_hold_what_was_reviewed(conn, repo):
   434	    """The panel reads jobs.result; the version check only proves the branch is the
   435	    named commit. A worker could commit B and hand the reviewers A. Bytes must match."""
   436	    job = create_job(conn, "the login form", builder_seat="reviewer")
   437	    _reviewed_and_done(conn, repo, job, "malicious B\n", reviewed="benign A\n")
   438	    with pytest.raises(gatekeeper.Refused, match="isn't what the reviewers read"):
   439	        gatekeeper.merge(conn, job)
   440	    assert not (repo / "chief_output").exists()
   441	
