./docs/HANDOFF_2026-07-20.md:184:| `harness/config/seats.toml` | The seats. Gauntlet config lives here. |
     1	"""Chief Command — the web app. Served on the tailnet, reachable from the phone.
     2	
     3	This is what Neill actually opens. Everything else in the harness exists so that this
     4	can tell him the truth.
     5	
     6	Design rules, all downstream of one fact — HE CANNOT READ CODE:
     7	  - Plain English everywhere. No filenames in the summary views.
     8	  - Model family is the color. You should see a Claude build was tested by a Grok
     9	    before you read a single word.
    10	  - Blocked things are loud. A job stuck at a gate is the most important thing on
    11	    the screen, because it's the only thing that needs him.
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import json
    17	import os
    18	import subprocess
    19	import sys
    20	from pathlib import Path
    21	
    22	sys.path.insert(0, str(Path(__file__).resolve().parent))
    23	
    24	
    25	# ---------------------------------------------------------------------------
    26	# Keys live in ~/.chief/env (chmod 600, never in the repo). Load them here so the
    27	# server can mint voice tokens and reach the seats however it was launched. This
    28	# is the intended config path — the file, not a hardcode. Existing environment
    29	# values win, so a key set in the shell is never clobbered.
    30	# ---------------------------------------------------------------------------
    31	def _load_chief_env() -> None:
    32	    env_file = Path.home() / ".chief" / "env"
    33	    if not env_file.exists():
    34	        return
    35	    for line in env_file.read_text().splitlines():
    36	        line = line.strip()
    37	        if not line or line.startswith("#"):
    38	            continue
    39	        if line.startswith("export "):
    40	            line = line[len("export "):]
    41	        if "=" not in line:
    42	            continue
    43	        key, _, val = line.partition("=")
    44	        key, val = key.strip(), val.strip().strip('"').strip("'")
    45	        os.environ.setdefault(key, val)
    46	
    47	
    48	_load_chief_env()
    49	
    50	from fastapi import FastAPI, File, Form, Request, UploadFile
    51	from fastapi.responses import FileResponse, HTMLResponse, JSONResponse
    52	
    53	from db.jobs import connect, init_db, month_spend
    54	
    55	app = FastAPI(title="Chief Command")
    56	
    57	DB = Path(__file__).resolve().parent / "db" / "chief.db"
    58	
    59	FAMILY_COLOR = {"claude": "#FF8A3D", "gpt": "#00E5A0", "grok": "#B06CFF", "qwen": "#2E9BFF"}
    60	
    61	
    62	_SEATS_SYNCED = False
    63	
    64	
    65	def db():
    66	    c = connect(DB)
    67	    init_db(c)
    68	    _sync_seats_once(c)
    69	    return c
    70	
    71	
    72	def _sync_seats_once(c) -> None:
    73	    """Push seats.toml into the store on the first request after a restart.
    74	
    75	    This was never wired up, so the seat definitions only reached the live database when
    76	    somebody ran it by hand — meaning an edit to the config (a new reviewer, a seat
    77	    switched off) could sit there looking applied and do nothing. It also runs the
    78	    startup validation: a gauntlet naming a seat that doesn't exist, or a seat with no
    79	    model family, is refused loudly here instead of failing later, mid-panel.
    80	    """
    81	    global _SEATS_SYNCED
    82	    if _SEATS_SYNCED:
    83	        return
    84	    _SEATS_SYNCED = True          # set first: a broken config must not retry every request
    85	    try:
    86	        import dispatch
    87	        dispatch.sync_seats(c, dispatch.load_config())
    88	    except Exception as exc:      # noqa: BLE001 — the app must still serve the record
    89	        print(f"[chief] seat config was not applied: {exc}")
    90	
    91	
    92	# ── The plain-English layer. He must never see a machine word. ───────────────
    93	#
    94	# Sol caught the UI leaking filenames and shell commands straight into the detail view.
    95	# This is the translation layer that stops it. The rule from AGENTS.md:
    96	#
    97	#     "If you cannot explain what you did without jargon, you do not yet understand
    98	#      what you did."
    99	
   100	_EVENT_ENGLISH = {
   101	    "dispatched": "Picked it up",
   102	    "read":       "Read through the existing code",
   103	    "thinking":   "Worked out how to do it",
   104	    "edit":       "Changed the code",
   105	    "write":      "Wrote new code",
   106	    "command":    "Ran something",
   107	    "test_run":   "Ran the tests",
   108	    "browse":     "Clicked through it like a user",
   109	    "verdict":    "Gave a verdict",
   110	    "done":       "Finished",
   111	    "error":      "Hit a problem",
   112	    # A reviewer that sat out MUST NOT read as one that worked. Without this line it
   113	    # fell through to the default "Worked on it" — the record was honest about the
   114	    # panel shrinking and the screen quietly contradicted it. (task #10)
   115	    "skipped":    "Sat this one out",
   116	}
   117	
   118	
   119	def _in_plain_english(e: dict) -> dict:
   120	    """Translate one line of machine activity into something a person can read.
   121	
   122	    NOTE the deliberate asymmetry: we keep the OUTCOME of a test run ("6 passed") but
   123	    drop the COMMAND that produced it ("pytest -q"). The outcome is a fact about the
   124	    work. The command is a fact about the tooling, and Neill doesn't use the tooling.
   125	    """
   126	    kind = e.get("kind", "")
   127	    what = _EVENT_ENGLISH.get(kind, "Worked on it")
   128	    out = {"what": what, "kind": kind}
   129	
   130	    detail = (e.get("detail") or "").strip()
     1	// Chief Command v2 — seat definitions (spec §4)
     2	//
     3	// Providers sit behind NAMED ROLES so any of them can be swapped without touching
     4	// orchestration logic. Nothing else in the harness may reference a provider by name —
     5	// only by seat id. Vendor policy drift is risk #1 on this project (§9).
     6	//
     7	// Hardware (Phase 0 RAM check, §2): M2 Pro, 16 GB. BELOW the spec's 36 GB threshold,
     8	// so the free grinder is a 7B coder, not the hoped-for 30B.
     9	//
    10	// ===========================================================================
    11	// THE ORGANIZING PRINCIPLE
    12	//
    13	// Every seat answers ONE of two questions: "how fast does it talk?" or "how well
    14	// does it think?" Nothing is good at both, because thinking well MEANS taking time.
    15	// So we don't fight the tension — we seat around it:
    16	//
    17	//   MOUTH   fast, dumb, never blocks. Dispatches and narrates.
    18	//   BRAIN   slow, deep. A dispatch target you are never waiting on.
    19	//   WORKHORSE  the best autonomous coder we can buy. Volume + quality.
    20	//   GRINDERS   cheap parallel attempts. Output NEVER ships unreviewed (DB-enforced).
    21	//   REVIEWER   escalation, highest judgment. Optional and droppable.
    22	// ===========================================================================
    23	
    24	// ---------------------------------------------------------------------------
    25	// MOUTH — the Talker. What Neill actually talks to.
    26	//
    27	// Speech-to-speech: audio in, audio out, ONE model, native tool calling. This is
    28	// what deletes the Whisper + Kokoro + Pipecat-plumbing stack that killed v1.
    29	//
    30	// DECISION DEFERRED ON PURPOSE. Both candidates are GA, sub-second, and speak the
    31	// SAME wire protocol (xAI is OpenAI-Realtime-compatible — you change the base URL).
    32	// So: build against the OpenAI Realtime event schema, keep base_url in config, and
    33	// the other becomes a ONE-LINE swap. Do not marry either one.
    34	//
    35	// Price is a WASH — do not choose on it:
    36	//   grok-voice-think-fast-1.0  $3.00/hr flat  (~$0.05/min)
    37	//   gpt-realtime-2.1-mini      ~$0.04/min real-world once prompt caching kicks in
    38	//                              (and it will — a voice head resends the same system
    39	//                              prompt + tool defs every single turn)
    40	// The "Grok is 6x cheaper" claim compares against the FLAGSHIP gpt-realtime, not mini.
    41	//
    42	// Choose on tool-calling reliability instead. Grok wins on native MCP + session
    43	// resumption; OpenAI wins on configurable reasoning effort + a longer tool-calling
    44	// track record. Settle it with Spike C (bake-off), not with a blog post.
    45	// ---------------------------------------------------------------------------
    46	[seats.mouth]
    47	provider = "xai-realtime"
    48	model = "grok-voice-think-fast-1.0"
    49	base_url = "wss://api.x.ai/v1/realtime"     // swap to OpenAI's and it still works
    50	family = "grok"
    51	tier = "metered"
    52	turn_detection = "semantic_vad"             // NOT push-to-talk. Owner override.
    53	eagerness = "low"                           // a driver pauses mid-sentence to merge
    54	interrupt_response = true                   // barge-in
    55	
    56	// VOICE HAS ITS OWN BUDGET, separate from Grok-the-builder. Owner: "we need to do
    57	// more than $30 cap. that was for when we go over with grok stuff."
    58	// $3/hr, so 300c/day = ~1 hour of talking a day = ~$90/mo worst case.
    59	// Start here and tune once we see real usage — the meter only runs while you talk.
    60	daily_cap_cents = 300
    61	notes = "Fast + dumb BY DESIGN. Never blocks. Separate budget from [seats.grok]."
    62	
    63	// ---------------------------------------------------------------------------
    64	// BRAIN — deep reasoning, planning, decomposition, judging the gauntlet.
    65	// SLOW BY DESIGN and that is fine: it is a dispatch target, never a conversation
    66	// partner. Its ~13s time-to-first-token is invisible because you are never waiting.
    67	//
    68	// Ultra mode is literally an orchestrator: it decomposes the task and spawns
    69	// parallel subagents trained to coordinate MID-task rather than merge at the end.
    70	// That is the reviewer-gauntlet shape (§6), native.
    71	//   Terminal-Bench 2.1: 88.8% single-agent / 91.9% Ultra — SOTA for agentic work.
    72	// ---------------------------------------------------------------------------
    73	// ═══════════════════════════════════════════════════════════════════════════
    74	// MODEL TIERS — nothing gets the top model by default. Owner (2026-07-14):
    75	//     "If we do highest model every time for every build, on autonomous work, Claude
    76	//      and ChatGPT are gonna bottom out."
    77	//
    78	// THE KEY FACT: the binding constraint on autonomous work is RATE LIMITS, not money.
    79	// Claude and OpenAI are both flat-rate — you already paid. But you CANNOT BUY YOUR WAY
    80	// OUT OF A WEEKLY CAP. Every top-tier call spent on boilerplate is one you don't have
    81	// left for the thing that actually needed it.
    82	//
    83	// So the top tier is EARNED: you ask for it, the work is dangerous (auth/money/data),
    84	// it already failed twice, a reviewer flagged p0/p1, or it's a decision that's
    85	// expensive to reverse. Everything else runs light or standard. See tiering.py — the
    86	// escalation is a RULE, not a vibe, and every job records which tier it got AND WHY.
    87	// ═══════════════════════════════════════════════════════════════════════════
    88	
    89	[seats.brain]
    90	provider = "codex"
    91	model = "gpt-5.6-sol"
    92	tier = "subscription"
    93	family = "gpt"
    94	
