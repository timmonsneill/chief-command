 from __future__ import annotations
 
 import json
 import subprocess
 import sys
 import tomllib
 from dataclasses import dataclass
 from pathlib import Path
 from typing import Any
 
 sys.path.insert(0, str(Path(__file__).resolve().parent))
 
 from db.jobs import (  # noqa: E402
     Seat,
     attach_run,
     create_job,
     over_budget,
