         if "family" not in s:
             raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
     for seat_id, s in cfg.get("seats", {}).items():
         upsert_seat(conn, Seat(
             id=seat_id,
             provider=s["provider"],
             model=s["model"],
             family=s["family"],
             tier=s["tier"],
             daily_cap_cents=s.get("daily_cap_cents"),
