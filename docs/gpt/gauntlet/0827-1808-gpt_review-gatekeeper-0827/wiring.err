   427	@app.post("/api/projects/{project_id}/todos")
   428	async def add_todo_endpoint(project_id: str, request: Request):
   429	    from db.planning import add_todo
   430	    body = await request.json()
   431	    text = (body.get("text") or "").strip()
   432	    if not text:
   433	        return JSONResponse({"error": "Say what the todo is."}, status_code=400)
   434	    c = db()
   435	    if c.execute("SELECT 1 FROM projects WHERE id=?", (project_id,)).fetchone() is None:
   436	        return JSONResponse({"error": "No such project."}, status_code=404)
   437	    tid = add_todo(c, project_id, text,
   438	                   section=body.get("section"), owner_only=bool(body.get("owner_only")))
   439	    return {"id": tid}
