    40	
    41	def _finished_job(c, *, families=("gpt", "grok"), seats_required=2, fams_required=2):
    42	    """A job that has genuinely been through the panel.
    43	
    44	    The builder is claude, so the default panel is gpt + grok: since migration 007 the
    45	    author's own family is allowed to review but does not count as a second opinion,
    46	    and a claude pass on a claude build would leave the floor of two unmet.
    47	    """
    48	    job = create_job(c, "the login form", builder_seat="reviewer")   # non-local builder
    49	    c.execute("UPDATE jobs SET required_reviews=?, required_review_families=? WHERE id=?",
    50	              (seats_required, fams_required, job))
    51	    set_status(c, job, "in_progress")
    52	    set_head_version(c, job, "v1")
    53	    set_status(c, job, "review")
    54	    by_family = {"claude": "reviewer", "gpt": "brain", "grok": "grok"}
    55	    for f in families:
    56	        record_verdict(c, job, by_family[f], verdict="pass", role="reviewer")
    57	    return job
    58	
    59	
    60	# ═══════════════════════════════════════════════════════════════════════════════
    61	# MERGE
    62	# ═══════════════════════════════════════════════════════════════════════════════
    63	def test_merge_refuses_work_that_never_finished(conn):
    64	    job = create_job(conn, "half a feature", builder_seat="reviewer")
    65	    with pytest.raises(gatekeeper.Refused, match="hasn't finished"):
    66	        gatekeeper.merge(conn, job)
    67	
    68	
    69	def test_merge_refuses_a_job_that_does_not_exist(conn):
    70	    with pytest.raises(gatekeeper.Refused, match="no job"):
    71	        gatekeeper.merge(conn, 9999)
    72	
    73	
    74	def test_the_record_itself_refuses_a_panel_of_one_family(conn):
    75	    """Two seats signed off; both are the same underlying model. The seat count is met
    76	    and the thing the panel is FOR — a second opinion — never happened.
    77	
    78	    Note what this test proves: the job cannot even REACH 'done', so the gatekeeper is
    79	    never consulted. That is the right order — the wall first, the door second."""
    80	    job = _finished_job(conn, families=("gpt",), fams_required=2)
    81	    record_verdict(conn, job, "brain2", verdict="pass", role="reviewer")   # gpt again
    82	    with pytest.raises(Exception, match="fewer model families"):
    83	        set_status(conn, job, "done")
    84	
    85	
    86	def test_merge_counts_families_itself_and_does_not_assume_the_record_did(conn):
    87	    """Defence in depth. The floor is raised AFTER the job completed under a lower one —
    88	    the schema permits raising it, and the gatekeeper must re-check rather than trust
    89	    that whatever let this job through was asking the same question it is."""
    90	    job = _finished_job(conn, families=("gpt",), seats_required=1, fams_required=1)
    91	    set_status(conn, job, "done")
    92	    conn.execute("UPDATE jobs SET required_review_families=2 WHERE id=?", (job,))
    93	    with pytest.raises(gatekeeper.Refused, match="different kinds of model"):
    94	        gatekeeper.merge(conn, job)
    95	
    96	
    97	def test_merge_does_not_count_the_author_as_a_second_opinion(conn):
    98	    """Migration 007 for the door, not just the wall. The job completed honestly on a
    99	    floor of one (gpt reviewed a claude build); the floor is then raised to two and a
   100	    claude pass — the builder's own family — is added. The record already refuses this
   101	    at 'done'; the gatekeeper must reach the same answer on its own."""
   102	    job = _finished_job(conn, families=("gpt",), seats_required=1, fams_required=1)
   103	    record_verdict(conn, job, "reviewer", verdict="pass", role="reviewer")   # claude on claude
   104	    set_status(conn, job, "done")
   105	    conn.execute("UPDATE jobs SET required_review_families=2 WHERE id=?", (job,))
   106	    with pytest.raises(gatekeeper.Refused, match="different kinds of model"):
   107	        gatekeeper.merge(conn, job)
   108	
   109	
   110	def test_merge_refuses_when_a_reviewer_turned_it_down(conn):
   111	    """The objection lands AFTER the job completed — the completion guards fire on the
   112	    way into 'done' and cannot act on it, so the gatekeeper is the thing that must."""
   113	    job = _finished_job(conn)
   114	    set_status(conn, job, "done")
   115	    record_verdict(conn, job, "grok", verdict="fail", role="reviewer")
   116	    with pytest.raises(gatekeeper.Refused, match="turned this down"):
   117	        gatekeeper.merge(conn, job)
   118	
   119	
   120	def test_merge_refuses_when_a_reviewer_asked_for_a_person(conn):
   121	    job = _finished_job(conn)
   122	    set_status(conn, job, "done")
   123	    record_verdict(conn, job, "grok", verdict="needs_human", role="reviewer")
   124	    with pytest.raises(gatekeeper.Refused, match="look at this first"):
   125	        gatekeeper.merge(conn, job)
   126	
   127	
   128	def test_merge_refuses_approvals_that_belong_to_an_older_version(conn):
   129	    """The reviews were real — of code that has since changed. This is the flaw Sol
   130	    called the most dangerous in the whole system: believable green ticks on code
   131	    nobody reviewed."""
   132	    job = _finished_job(conn)
   133	    set_status(conn, job, "done")
   134	    conn.execute("UPDATE jobs SET status='review' WHERE id=?", (job,))
