350:+++ b/harness/gatekeeper.py
351:@@ -0,0 +1,673 @@
352:+"""The gatekeeper (task #11) — the one holder of the irreversible powers.
353:+
354:+Everything else in this harness can be wrong and the worst case is wasted work. These
355:+three things cannot be taken back:
356:+
357:+    merge    code enters main
358:+    deploy   something reaches the world
359:+    spend    real money leaves the account
360:+
361:+Until now any agent could do all three directly: `dispatch.ship()` was an import away,
362:+and spend was recorded by whoever was spending. The schema guards are real, but they
363:+stop *mistakes*, not *reach* — an agent that wanted to ship unreviewed work never needed
364:+to defeat a trigger, because it could write its own approval or its own passing verdict.
365:+
366:+Sol's line, which is the whole task:
367:+
368:+    "The database cannot be the jailer if the prisoner can rewrite the jail."
369:+
370:+So this is not another guard. It is a separation of powers. Agents *ask*; the gatekeeper
371:+checks the record itself, does exactly the one thing, and refuses everything else.
372:+
373:+FOUR RULES, and the design is mostly just these:
374:+
375:+  1. THREE VERBS. Not "run this for me". A gatekeeper that can be asked to run an
376:+     arbitrary command is a shell with extra steps, and every hole in it is a hole in
377:+     everything. There is no generic verb here, and adding one would end the point of
378:+     the file.
379:+
380:+  2. IT NEVER BELIEVES THE ASKER. Every claim in a request is ignored except the job id
381:+     and the target. The gatekeeper re-reads the panel, the versions, the families and
382:+     the approvals from the database itself. An agent under prompt injection can ask for
383:+     anything it likes; the answer depends on the record, not on the asking.
384:+
385:+  3. REFUSALS ARE LOUD. Every refusal is written to the job in plain English. A silent
386:+     refusal is indistinguishable from a thing that was never attempted — which is how
387:+     you end up debugging "why didn't it deploy" for an hour.
388:+
389:+  4. NO FALLBACK. If the gatekeeper is unreachable, irreversible things do not happen.
390:+     A fallback to the old direct path would BE the bypass. Down means stopped.
391:+
392:+⚠️ WHAT THIS FILE DOES NOT YET DO. Right now every agent still runs as the same user and
393:+can open the database file directly, so a determined process could bypass this module
394:+entirely. The service is the door; the file permissions are the wall, and the wall is
395:+still owner's work (see docs/gatekeeper-task11-spec.md). Until that lands, this raises
396:+the floor from "anyone can do anything" to "the normal path is the checked one" — real,
397:+but not yet a boundary. That distinction is stated here rather than glossed, because a
398:+gatekeeper everyone believes in but that doesn't hold is worse than none.
399:+"""
400:+
401:+from __future__ import annotations
402:+
403:+import json
404:+import os
405:+import re
406:+import secrets
407:+import sqlite3
408:+import subprocess
409:+import threading
410:+from dataclasses import dataclass
411:+from pathlib import Path
412:+from typing import Any, Callable
413:+
414:+from db.jobs import GuardViolation, connect, record_usage, seat, set_status
415:+
416:+HARNESS = Path(__file__).resolve().parent
417:+REPO = HARNESS.parent
418:+DB_PATH = HARNESS / "db" / "chief.db"
419:+
420:+TOKEN_PATH = Path.home() / ".chief" / "gatekeeper.token"
421:+MAX_BODY_BYTES = 64 * 1024
422:+MERGE_INTO = "main"
423:+
424:+# A branch name we are willing to merge. Deliberately narrow: `jobs.branch` is written
425:+# by the same code an agent controls, and `git rev-parse --verify` accepts REVISION
426:+# EXPRESSIONS, not just branches — `:/some message` resolves to a commit by searching
427:+# commit messages. A permissive check here turns "merge the branch for job 17" into
428:+# "merge any commit in the repository."
429:+BRANCH_RE = re.compile(r"^job/\d+\Z")
430:+
431:+# What money can be spent ON. The daily caps in the schema are keyed by role, so a role
432:+# nobody validated is a cap nobody enforces — 'research' would sail past both the build
433:+# ration and the review ration.
434:+SPEND_ROLES = {"build", "review", "test", "research", "voice"}
435:+
436:+
437:+class Refused(RuntimeError):
438:+    """The gatekeeper said no. The message is in plain English, on purpose — it is
439:+    shown to Neill, and 'guard_family_floor violated' tells him nothing."""
440:+
441:+
442:+@dataclass
443:+class Receipt:
444:+    """Proof that the one thing happened, and what it was."""
445:+    verb: str
446:+    subject: str
447:+    detail: str = ""
448:+    reference: str = ""          # commit id, usage row, deploy id
449:+
450:+
451:+# ---------------------------------------------------------------------------
452:+# Saying no, out loud
453:+# ---------------------------------------------------------------------------
454:+def _clean(text: str, limit: int = 120) -> str:
455:+    """Make caller-supplied text safe to show Neill.
456:+
457:+    Everything written by `_note` is attributed to the gatekeeper — the one component he
458:+    is being told to trust — so an agent that can inject newlines into it can forge
459:+    gatekeeper-signed lines on his timeline. Strip the formatting, cap the length.
460:+    """
461:+    return re.sub(r"\s+", " ", str(text)).strip()[:limit]
462:+
463:+
464:+def _log(conn, verb: str, subject: str, granted: bool, detail: str,
465:+         asked_by: str = "unknown", job_id: int | None = None) -> None:
466:+    """The gatekeeper's own record, which does not depend on there being a job.
467:+
468:+    Deploys aren't necessarily about a job, and `events.job_id` is NOT NULL — so before
469:+    this existed, a deploy's grants AND its refusals were dropped on the floor, for the
470:+    one verb where saying it out loud matters most. Append-only by trigger.
471:+    """
472:+    conn.execute(
473:+        "INSERT INTO gate_log (verb, subject, granted, detail, asked_by, job_id) "
474:+        "VALUES (?,?,?,?,?,?)",
475:+        (verb, _clean(subject), int(granted), _clean(detail, 400),
476:+         _clean(asked_by, 60), job_id),
477:+    )
478:+
479:+
480:+def _note(conn, job_id: int | None, text: str, kind: str = "skipped") -> None:
481:+    """Write a refusal (or a grant) onto the job where a person will see it.
482:+
483:+    Refusals are 'skipped' events; a grant is 'done' — a merge showing up in the
484:+    activity stream as a skip was telling Neill the opposite of what happened."""
485:+    if job_id is None:
486:+        return
487:+    row = conn.execute(
488:+        "SELECT builder_seat FROM jobs WHERE id = ?", (job_id,)
489:+    ).fetchone()
490:+    if row is None:
491:+        return
492:+    s = seat(conn, row["builder_seat"])
493:+    if s is None:
494:+        return
495:+    conn.execute(
496:+        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
497:+        "VALUES (?,?,?,?,?,?,?)",
498:+        (job_id, s["id"], "gatekeeper", s["model"], s["family"], kind, text),
499:+    )
500:+
501:+
502:+def _refuse(conn, job_id: int | None, why: str = "", *, verb: str = "",
503:+            subject: str = "", asked_by: str = "unknown") -> Refused:
504:+    # A job id the record doesn't know must not reach gate_log: its foreign key would
505:+    # throw, and the refusal — the one thing rule 3 says must never vanish — would.
506:+    job_id = _known_job(conn, job_id)
507:+    _note(conn, job_id, f"The gatekeeper said no: {why}")
508:+    if verb:
509:+        _log(conn, verb, subject or str(job_id), False, why, asked_by, job_id)
510:+    return Refused(why)
511:+
512:+
513:+def _known_job(conn, job_id) -> int | None:
514:+    try:
515:+        job_id = int(job_id) if job_id is not None else None
516:+    except (TypeError, ValueError):
517:+        return None
518:+    return job_id if job_id is not None and _job_exists(conn, job_id) else None
519:+
520:+
521:+# ---------------------------------------------------------------------------
522:+# MERGE — code enters main
523:+# ---------------------------------------------------------------------------
524:+def merge(conn, job_id: int, *, asked_by: str = "unknown") -> Receipt:
525:+    """Merge a job's branch into main, if and only if the record earns it.
526:+
527:+    Every check below re-reads the database. None of them takes the asker's word for
528:+    anything — that is the entire difference between this and `dispatch.ship()`, which
529:+    did the thing because it was called.
530:+    """
531:+    def _no(why: str) -> Refused:
532:+        """One way out of this function, so no refusal can forget to write itself down."""
533:+        return _refuse(conn, job_id if _job_exists(conn, job_id) else None, why,
534:+                       verb="merge", subject=f"job {job_id}", asked_by=asked_by)
535:+
536:+    job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
537:+    if job is None:
538:+        raise _no(f"there is no job {job_id}")
539:+
540:+    if job["status"] == "shipped":
541:+        raise _no("that work has already been merged once")
542:+    if job["status"] != "done":
543:+        raise _no("that work hasn't finished its checks yet, so there's nothing to merge")
544:+
545:+    version = job["head_version"]
546:+    if not version:
547:+        raise _no("nothing was actually put forward — there's no finished version to merge")
548:+
549:+    verdicts = conn.execute(
550:+        "SELECT reviewer_seat, model_family, verdict, role, reviewed_version "
551:+        "FROM verdicts WHERE job_id = ?", (job_id,)
552:+    ).fetchall()
553:+    current = [v for v in verdicts if v["reviewed_version"] == version]
554:+
555:+    # A failure on this version is fatal and is NOT outvoted. A failure on an unknown
556:+    # version is also fatal: it condemns we-don't-know-what, so it condemns everything.
557:+    for v in verdicts:
558:+        if v["verdict"] == "fail" and (
559:+                v["reviewed_version"] is None or v["reviewed_version"] == version):
560:+            raise _no("a reviewer turned this down and that stands")
561:+    if any(v["verdict"] == "needs_human" for v in verdicts):
562:+        raise _no("a reviewer asked for you to look at this first")
563:+
564:+    passed = [v for v in current if v["verdict"] == "pass" and v["role"] == "reviewer"]
565:+    seats = {v["reviewer_seat"] for v in passed}
566:+    # The author is not a second opinion (migration 007): a same-family pass is a
567:+    # legitimate review, it just does not count toward "different minds". The schema
568:+    # already refuses first; this keeps the gate honest even if it ever stops.
569:+    families = {v["model_family"] for v in passed
570:+                if v["model_family"] != job["builder_family"]}
571:+
572:+    # A job carrying NO requirements is not a job everyone approved — it is a job whose
573:+    # requirements were never stamped. `0 < 0` is False, so treating zero as "nothing
574:+    # required" would let a row created outside dispatch merge with no reviews at all.
575:+    need_seats = job["required_reviews"] or 0
576:+    need_families = job["required_review_families"] or 0
577:+    if need_seats < 1 or need_families < 1:
578:+        raise _no("that job never had any review requirements set, so there is "
579:+                      "nothing to have passed")
580:+    if len(seats) < need_seats:
581:+        raise _no(f"only {len(seats)} of the {need_seats} reviewers "
582:+                      "have signed off on this version")
583:+    if len(families) < need_families:
584:+        raise _no(f"only {len(families)} different kinds of model have checked this; "
585:+                      f"{need_families} are required")
586:+
587:+    branch = job["branch"] or ""
588:+    if not BRANCH_RE.match(branch):
589:+        raise _no("there's no finished branch of code to merge for that job")
590:+
591:+    tip = _branch_tip(branch)
592:+    if tip is None:
593:+        raise _no("there's no finished branch of code to merge for that job")
594:+
595:+    # ══════════════════════════════════════════════════════════════════════════
596:+    # THE CHECK THIS WHOLE VERB EXISTS FOR.
597:+    #
598:+    # Everything above verifies the RECORD. This verifies that the code about to enter
599:+    # main IS the code the record is about. Without it, a builder commits v1, the panel
600:+    # reviews v1, `head_version` freezes at v1 — and then the builder pushes v2 to the
601:+    # same branch and asks for a merge. Every check passes, and v2 goes in. The version
602:+    # freeze that protects the record would be helping the attacker.
603:+    #
604:+    # Reviews are of bytes, not of intentions. Merge the bytes that were reviewed.
605:+    # ══════════════════════════════════════════════════════════════════════════
606:+    if not _same_commit(tip, version):
607:+        raise _no("the code on that branch isn't the code that was reviewed — "
608:+                      "it has changed since, so it needs checking again")
609:+
610:+    # And the commit must CONTAIN what the reviewers read. The panel judges the text the
611:+    # worker handed in (`jobs.result`); the version check above only proves the branch
612:+    # is the commit the record names. A worker could commit one thing and hand the
613:+    # reviewers another. So: the reviewed bytes must be in the commit, byte for byte.
614:+    if not _commit_holds_the_reviewed_work(tip, job_id, job["result"]):
615:+        raise _no("what's on that branch isn't what the reviewers read, "
616:+                      "so it can't be merged as reviewed")
617:+
618:+    if not _repo_is_ready():
619:+        raise _no("the project folder has unfinished changes in it, so it isn't "
620:+                      "safe to merge right now")
621:+
622:+    # ══════════════════════════════════════════════════════════════════════════
623:+    # ORDER IS THE POINT: the RECORD decides first, the irreversible act happens
624:+    # second. Merging and then asking produced "the code merged but the record wouldn't
625:+    # accept it" — an unreviewed merge with a polite note. The gatekeeper's own checks
626:+    # are a SUBSET of the schema's (it never checks for a passing tester), so the only
627:+    # safe order is to let the schema refuse before git is touched at all.
628:+    # ══════════════════════════════════════════════════════════════════════════
629:+    with _MERGE_LOCK:
630:+        # Re-resolve under the lock and merge the SHA, never the name. Between the check
631:+        # above and `git merge refs/heads/<branch>`, a builder could move the branch;
632:+        # merging by name would then merge whatever it points at now.
633:+        tip = _branch_tip(branch)
634:+        if tip is None or not _same_commit(tip, version):
635:+            raise _no("the code on that branch changed while the merge was being "
636:+                      "checked, so it needs checking again")
637:+        conn.execute("BEGIN IMMEDIATE")
638:+        try:
639:+            try:
640:+                set_status(conn, job_id, "shipped")
641:+            except (GuardViolation, sqlite3.IntegrityError) as exc:
642:+                conn.execute("ROLLBACK")
643:+                raise _no(_plain(exc)) from exc
644:+            commit = _git_merge(tip)
645:+            if commit is None:
646:+                conn.execute("ROLLBACK")          # the record never happened either
647:+                raise _no("the merge didn't go through cleanly — it needs a person")
648:+            conn.execute("COMMIT")
649:+        except BaseException:
650:+            # Never leave a transaction open on a connection somebody else will reuse.
651:+            if conn.in_transaction:
652:+                conn.execute("ROLLBACK")
653:+            raise
654:+
655:+    _note(conn, job_id,
656:+          f"Merged into the main line of code. Asked for by {_clean(asked_by)}.", kind="done")
657:+    _log(conn, "merge", f"job {job_id}", True,
658:+         f"{len(families)} model families signed off on {version}; merged {commit}",
659:+         asked_by, job_id)
660:+    return Receipt(verb="merge", subject=f"job {job_id}", reference=commit,
661:+                   detail=f"{len(families)} model families signed off on {version}")
662:+
663:+
664:+_MERGE_LOCK = threading.Lock()          # two merges racing share one git index
665:+
666:+
667:+def _job_exists(conn, job_id: int) -> bool:
668:+    return conn.execute("SELECT 1 FROM jobs WHERE id = ?", (job_id,)).fetchone() is not None
669:+
670:+
671:+def _plain(exc: Exception) -> str:
672:+    """A schema refusal, with the machine word taken off the front."""
673:+    return str(exc).replace("guard: ", "").strip() or "the record wouldn't accept it"
674:+
675:+
676:+def _branch_tip(branch: str) -> str | None:
677:+    """The commit a BRANCH points at — refs/heads/ so nothing else can be meant."""
678:+    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}"],
679:+                         cwd=REPO, capture_output=True, text=True)
680:+    return out.stdout.strip() or None if out.returncode == 0 else None
681:+
682:+
683:+def _same_commit(tip: str, version: str) -> bool:
684:+    """Is the reviewed version this exact commit?
685:+
686:+    `head_version` is a short id, so compare on the shorter length. A version that is
687:+    not a commit id at all (the local worker records a content hash) can never match,
688:+    which is correct: if we cannot prove the reviewed thing is this code, we do not
689:+    merge it.
690:+    """
691:+    version = (version or "").strip().lower()
692:+    tip = (tip or "").strip().lower()
693:+    if len(version) < 7 or not re.fullmatch(r"[0-9a-f]+", version):
694:+        return False
695:+    return tip.startswith(version)
696:+
697:+
698:+REVIEWED_FILE = "chief_output/job_{job_id}.txt"     # where executor.py commits the work
699:+
700:+
701:+def _commit_holds_the_reviewed_work(commit: str, job_id: int, reviewed: str | None) -> bool:
702:+    """Is the text the panel reviewed present, unchanged, in this exact commit?"""
703:+    if reviewed is None:
704:+        return False
705:+    out = subprocess.run(["git", "show", f"{commit}:{REVIEWED_FILE.format(job_id=job_id)}"],
706:+                         cwd=REPO, capture_output=True, text=True)
707:+    return out.returncode == 0 and out.stdout == reviewed
708:+
709:+
710:+def _repo_is_ready() -> bool:
711:+    """On the branch we merge into, with nothing half-done in the folder.
712:+
713:+    Merging into a detached HEAD orphans the result; merging over the owner's own
714:+    uncommitted work risks losing it when a failed merge is aborted.
715:+    """
716:+    head = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
717:+                          cwd=REPO, capture_output=True, text=True)
718:+    if head.returncode != 0 or head.stdout.strip() != MERGE_INTO:
719:+        return False
720:+    dirty = subprocess.run(["git", "status", "--porcelain"],
721:+                           cwd=REPO, capture_output=True, text=True)
722:+    return dirty.returncode == 0 and not dirty.stdout.strip()
723:+
724:+
725:+def _git_merge(commit: str) -> str | None:
726:+    """Merge one exact commit. Takes a SHA, not a ref, on purpose."""
727:+    try:
728:+        proc = subprocess.run(["git", "merge", "--no-ff", "--no-edit", commit],
729:+                              cwd=REPO, capture_output=True, text=True, timeout=120)
730:+    except subprocess.TimeoutExpired:
731:+        _abort_any_merge()
732:+        return None
733:+    if proc.returncode != 0:
734:+        # Leave nothing half-merged behind. A conflicted tree that nobody is looking at
735:+        # is worse than a refusal.
736:+        _abort_any_merge()
737:+        return None
738:+    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=REPO,
739:+                          capture_output=True, text=True)
740:+    return head.stdout.strip()[:12] or None
741:+
742:+
743:+def _abort_any_merge() -> None:
744:+    """Undo a half-finished merge — and ONLY a half-finished merge.
745:+
746:+    `git merge --abort` is `git reset --merge` underneath, which will discard the
747:+    owner's uncommitted work if no merge is actually in progress. Check first.
748:+    """
749:+    if (REPO / ".git" / "MERGE_HEAD").exists():
750:+        subprocess.run(["git", "merge", "--abort"], cwd=REPO, capture_output=True)
751:+
752:+
753:+# ---------------------------------------------------------------------------
754:+# DEPLOY — something reaches the world
755:+# ---------------------------------------------------------------------------
756:+def deploy(conn, target: str, *, job_id: int | None = None,
757:+           asked_by: str = "unknown") -> Receipt:
758:+    """Deploy — ONLY on a live, unused, read-back owner approval naming this target.
759:+
760:+    Decision D keeps Neill in the path for production deploys, and this is the only
761:+    place in the harness where an agent's request is not enough on its own. There is
762:+    deliberately no "the reviewers all agreed" route here: reviewers judge code, and a
763:+    deploy is a decision about the business.
764:+    """
765:+    target = _clean(target)
766:+    approval = conn.execute(
767:+        "SELECT * FROM live_approvals WHERE capability = 'deploy' AND action = ? "
768:+        "ORDER BY id DESC LIMIT 1", (target,),
769:+    ).fetchone()
770:+    if approval is None:
771:+        raise _refuse(conn, job_id,
772:+                      f"nothing has been approved for deploying {target} — "
773:+                      "that needs your say-so, tapped, not spoken",
774:+                      verb="deploy", subject=target, asked_by=asked_by)
775:+    # An approval granted about ONE job does not authorize the same words claimed under
776:+    # another. Without this, a yes given in the context of job 4 travels to job 99.
777:+    if approval["job_id"] is not None and approval["job_id"] != job_id:
778:+        raise _refuse(conn, job_id,
779:+                      "that approval was for a different piece of work",
780:+                      verb="deploy", subject=target, asked_by=asked_by)
781:+    if not approval["reversible"] and not (approval["recovery"] or "").strip():
782:+        raise _refuse(conn, job_id,
783:+                      "that deploy can't be undone and there's no written way back",
784:+                      verb="deploy", subject=target, asked_by=asked_by)
785:+
786:+    # No mechanism, no deploy — and above all no CONSUMED approval. Burning the owner's
787:+    # one-time yes on a verb that then does nothing would make him grant it twice for
788:+    # one deploy. The mechanism, when built, registers here and runs BEHIND the gate.
789:+    deployer = DEPLOYERS.get(target)
790:+    if deployer is None:
791:+        raise _refuse(conn, job_id,
792:+                      f"there's no way to deploy {target} built yet — your approval "
793:+                      "was not used up",
794:+                      verb="deploy", subject=target, asked_by=asked_by)
795:+
796:+    # Spend the approval FIRST. If the deploy dies halfway, the slip is still used —
797:+    # a retry must come back for a fresh yes rather than replay an old one. Two callers
798:+    # racing: SQLite serializes the writes and the single-use guard refuses the loser,
799:+    # which arrives here as a plain refusal rather than a crash.
800:+    try:
801:+        conn.execute("UPDATE approvals SET used_at = datetime('now') WHERE id = ?",
802:+                     (approval["id"],))
803:+    except sqlite3.IntegrityError as exc:
804:+        raise _refuse(conn, job_id, "that approval has already been used",
805:+                      verb="deploy", subject=target, asked_by=asked_by) from exc
806:+
807:+    try:
808:+        reference = str(deployer(target) or "")
809:+    except Exception as exc:  # noqa: BLE001 — a failed deploy is a refusal, said aloud
810:+        raise _refuse(conn, job_id, f"the deploy of {target} didn't go through: "
811:+                      f"{_clean(str(exc), 160)} — it needs a fresh approval to retry",
812:+                      verb="deploy", subject=target, asked_by=asked_by) from exc
813:+
814:+    detail = f"deployed {target} on your approval"
815:+    _note(conn, job_id, f"Deployed {target}, on your approval. "
816:+                        f"Asked for by {_clean(asked_by)}.", kind="done")
817:+    _log(conn, "deploy", target, True, detail, asked_by, job_id)
818:+    return Receipt(verb="deploy", subject=target, detail=detail,
819:+                   reference=reference or str(approval["id"]))
820:+
821:+
822:+# What actually performs a deploy, by target. EMPTY on purpose: nothing in the harness
823:+# can deploy anything yet. When something can, it registers here — behind the gate, so
824:+# that the owner's approval is the only thing that can start it.
825:+DEPLOYERS: dict[str, Callable[[str], str | None]] = {}
826:+
827:+
828:+# ---------------------------------------------------------------------------
829:+# SPEND — real money leaves the account
830:+# ---------------------------------------------------------------------------
831:+def spend(conn, seat_id: str, cents: int, *, job_id: int | None = None,
832:+          role: str = "build", asked_by: str = "unknown") -> Receipt:
833:+    """Reserve money BEFORE the provider is called, or refuse.
834:+
835:+    Sol: refusing to RECORD a charge doesn't unspend it. So the ledger is written first
836:+    and the call happens after. The daily and monthly caps live in the schema, which is
837:+    what makes this a reservation rather than a note — two agents reserving at the same
838:+    instant both hit the ledger, and the ledger refuses the one that breaches.
839:+
840:+    ⚠️ THERE IS NO RECONCILIATION YET. A reservation is an ESTIMATE, and if the real
841:+    call costs less, or never happens at all, the estimate stands against the cap
842:+    permanently. That is deliberate for now (erring toward over-counting spend is the
843:+    safe direction) but it is not the same thing as accurate accounting, and this
844:+    docstring said otherwise until the cross-model review called it.
845:+    """
846:+    if cents < 0:
847:+        raise _refuse(conn, job_id, "a charge can't be negative",
848:+                      verb="spend", subject=seat_id, asked_by=asked_by)
849:+    row = seat(conn, seat_id)
850:+    if row is None:
851:+        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
852:+                      verb="spend", subject=seat_id, asked_by=asked_by)
853:+    # A metered seat costs money every call. "Reserve zero, then make the call" would
854:+    # walk every cap — daily, role, monthly — without any of them moving.
855:+    if cents == 0 and row["tier"] == "metered":
856:+        raise _refuse(conn, job_id, "a paid worker can't reserve nothing — "
857:+                      "say what the call will cost",
858:+                      verb="spend", subject=seat_id, asked_by=asked_by)
859:+    # The caps are keyed BY ROLE, so a role nobody validated is a cap nobody enforces —
860:+    # 'research' would sail past both the build ration and the review ration.
861:+    if role not in SPEND_ROLES:
862:+        raise _refuse(conn, job_id, f"'{role}' isn't a kind of work money can be spent on",
863:+                      verb="spend", subject=seat_id, asked_by=asked_by)
864:+    row = seat(conn, seat_id)
865:+    if row is None:
866:+        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
867:+                      verb="spend", subject=seat_id, asked_by=asked_by)
868:+    if not row["enabled"]:
869:+        raise _refuse(conn, job_id, f"'{seat_id}' is switched off",
870:+                      verb="spend", subject=seat_id, asked_by=asked_by)
871:+
872:+    try:
873:+        record_usage(conn, seat_id, cents, job_id=job_id, role=role)
874:+    except (GuardViolation, sqlite3.IntegrityError) as exc:
875:+        raise _refuse(conn, job_id,
876:+                      "that would go past the spending limit for today",
877:+                      verb="spend", subject=seat_id, asked_by=asked_by) from exc
878:+
879:+    ref = conn.execute("SELECT last_insert_rowid() AS id").fetchone()["id"]
880:+    _log(conn, "spend", seat_id, True, f"{cents}c reserved for {role}", asked_by, job_id)
881:+    return Receipt(verb="spend", subject=seat_id, detail=f"{cents}c reserved for {role}",
882:+                   reference=str(ref))
883:+
884:+
885:+VERBS = {"merge": merge, "deploy": deploy, "spend": spend}
886:+
887:+
888:+# ---------------------------------------------------------------------------
889:+# The service — loopback only, and only these three verbs
890:+# ---------------------------------------------------------------------------
891:+def handle(request: dict[str, Any], *, db_path: Path | None = None) -> dict[str, Any]:
892:+    """One request in, one answer out. The whole surface area of the gatekeeper.
893:+
894:+    An unknown verb is refused without being examined further. This is the check that
895:+    keeps rule 1 true as the file grows.
896:+    """
897:+    verb = request.get("verb")
898:+    if verb not in VERBS:
899:+        return {"ok": False, "error": "the gatekeeper only does three things: "
900:+                                      "merge, deploy, spend"}
901:+
902:+    conn = connect(db_path or DB_PATH)
903:+    try:
904:+        asked_by = str(request.get("asked_by") or "unknown")
905:+        try:
906:+            if verb == "merge":
907:+                r = merge(conn, int(request["job_id"]), asked_by=asked_by)
908:+            elif verb == "deploy":
909:+                r = deploy(conn, str(request["target"]),
910:+                           job_id=_known_job(conn, request.get("job_id")), asked_by=asked_by)
911:+            else:
912:+                r = spend(conn, str(request["seat_id"]), int(request["cents"]),
913:+                          job_id=_known_job(conn, request.get("job_id")),
914:+                          role=str(request.get("role") or "build"), asked_by=asked_by)
915:+        except Refused as exc:
916:+            return {"ok": False, "error": str(exc)}
917:+        except (KeyError, ValueError, TypeError) as exc:
918:+            return {"ok": False, "error": f"that request didn't make sense: {exc}"}
919:+        except sqlite3.Error as exc:
920:+            return {"ok": False, "error": f"the record refused that: {_plain(exc)}"}
921:+        return {"ok": True, "verb": r.verb, "subject": r.subject,
922:+                "detail": r.detail, "reference": r.reference}
923:+    finally:
924:+        conn.close()
925:+
926:+
927:+def token() -> str:
928:+    """The shared secret a caller must present. Created once, readable only by us.
929:+
930:+    Loopback is a NETWORK control, not an authorization one. Without a token, any local
931:+    process — and any web page the owner happens to open, since a POST with a plain
932:+    content type is a "simple request" that needs no browser preflight — could drive the
933:+    three most dangerous powers in the system by fetching 127.0.0.1. A page cannot read
934:+    this file, so it cannot present the token.
935:+    """
936:+    TOKEN_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
937:+    if not TOKEN_PATH.exists() or not TOKEN_PATH.read_text().strip():
938:+        # 0600 from the first byte — never a world-readable instant — and O_EXCL so two
939:+        # processes starting at once can't each write a different token (the loser
940:+        # simply reads the winner's). An empty file counts as missing:
941:+        # `compare_digest("", "")` is True, so an empty token would have let a
942:+        # header-less request through. Fail closed, always.
943:+        if TOKEN_PATH.exists():
944:+            TOKEN_PATH.unlink()
945:+        try:
946:+            fd = os.open(TOKEN_PATH, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
947:+        except FileExistsError:
948:+            fd = None                           # someone else just created it
949:+        if fd is not None:
950:+            with os.fdopen(fd, "w") as f:
951:+                f.write(secrets.token_urlsafe(32))
952:+            os.chmod(TOKEN_PATH, 0o600)
953:+    value = TOKEN_PATH.read_text().strip()
954:+    if len(value) < 32:
955:+        raise RuntimeError("the gatekeeper token is missing or too short — refusing to serve")
956:+    return value
957:+
958:+
959:+def serve(host: str = "127.0.0.1", port: int = 8788) -> None:
960:+    """Run the gatekeeper as its own process.
961:+
962:+    LOOPBACK ONLY, and not a choice to revisit casually: the tailnet is other devices,
963:+    and the whole point of this process is that reaching it is harder than reaching the
964:+    agents, not easier. Standard library only — the thing holding the dangerous powers
965:+    should have the smallest possible surface.
966:+    """
967:+    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
968:+
969:+    expected = token()
970:+
971:+    class Handler(BaseHTTPRequestHandler):
972:+        protocol_version = "HTTP/1.1"
973:+
974:+        def _reply(self, code: int, answer: dict) -> None:
975:+            payload = json.dumps(answer).encode()
976:+            self.send_response(code)
977:+            self.send_header("Content-Type", "application/json")
978:+            self.send_header("Content-Length", str(len(payload)))
979:+            self.end_headers()
980:+            self.wfile.write(payload)
981:+
982:+        def do_POST(self):                                    # noqa: N802
983:+            try:
984:+                # Host check first: it is what stops DNS rebinding, where a page the
985:+                # owner is looking at resolves an attacker's domain to 127.0.0.1 and
986:+                # then talks to us with the browser's blessing.
987:+                host_header = (self.headers.get("Host") or "").split(":")[0]
988:+                if host_header not in ("127.0.0.1", "localhost", "[::1]"):
989:+                    return self._reply(403, {"ok": False, "error": "not for you"})
990:+                if not expected or not secrets.compare_digest(
991:+                        self.headers.get("X-Chief-Token") or "", expected):
992:+                    return self._reply(403, {"ok": False, "error": "not for you"})
993:+
994:+                length = int(self.headers.get("Content-Length") or 0)
995:+                if length < 0 or length > MAX_BODY_BYTES:
996:+                    return self._reply(413, {"ok": False, "error": "that request is too big"})
997:+                raw = self.rfile.read(length) if length else b"{}"
998:+                try:
999:+                    body = json.loads(raw or b"{}")
1000:+                except json.JSONDecodeError:
1001:+                    body = {}
1002:+                if not isinstance(body, dict):
1003:+                    body = {}
1004:+
1005:+                answer = handle(body)
1006:+                self._reply(200 if answer.get("ok") else 403, answer)
1007:+            except Exception:                                  # noqa: BLE001
1008:+                # The gatekeeper never dies of a bad request. Down means stopped, and
1009:+                # stopped means every irreversible thing stops with it.
1010:+                try:
1011:+                    self._reply(400, {"ok": False, "error": "that request didn't make sense"})
1012:+                except Exception:                              # noqa: BLE001
1013:+                    pass
1014:+
1015:+        def log_message(self, *args):                          # quiet by default
1016:+            pass
1017:+
1018:+    server = ThreadingHTTPServer((host, port), Handler)
1019:+    server.daemon_threads = True
1020:+    server.serve_forever()
1021:+
1022:+
1023:+if __name__ == "__main__":
1024:+    serve()
1028:+++ b/harness/gauntlet.py
1029:@@ -11,61 +11,64 @@ Four things are load-bearing here:
1055:+import json
1056:+import os
1059:+import urllib.error
1060:+import urllib.request
1095:@@ -122,94 +125,157 @@ def _run_cli(cmd: list[str]) -> tuple[str, str]:
1121:+XAI_CHAT_URL = "https://api.x.ai/v1/chat/completions"
1122:+XAI_KEY_VAR = "XAI_API_KEY"
1123:+MAX_REPLY_BYTES = 1_000_000     # a verdict is one line; anything bigger is not a reply
1124:+
1125:+
1126:+def _xai_review(request: str, code: str, model: str) -> tuple[str, str]:
1127:+    """The Grok-family reviewer, straight over HTTP.
1128:+
1129:+    No CLI here on purpose: Grok's CLI has been alleged to upload whole checkouts, and
1130:+    the reviewer must only ever see the bundle it is handed. Plain urllib rather than an
1131:+    SDK so the seat adds no dependency — the API is OpenAI-shaped and one POST is all a
1132:+    review needs. The key comes from the environment the server loads (~/.chief/env),
1133:+    never from the repo. A missing key is the TOOL failing, so it is a skip, never a
1134:+    verdict — same rule as a CLI exiting non-zero.
1135:+    """
1136:+    key = os.environ.get(XAI_KEY_VAR, "").strip()
1137:+    if not key:
1138:+        raise ReviewerBroke(f"{XAI_KEY_VAR} is not set in this environment")
1139:+    body = json.dumps({
1140:+        "model": model,
1141:+        "temperature": 0,
1142:+        "messages": [{"role": "user", "content": _prompt(request, code)}],
1143:+    }).encode()
1144:+    req = urllib.request.Request(
1145:+        XAI_CHAT_URL, data=body, method="POST",
1146:+        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
1147:+    )
1148:+    try:
1149:+        with urllib.request.urlopen(req, timeout=REVIEW_TIMEOUT_S) as resp:
1150:+            payload = json.loads(resp.read(MAX_REPLY_BYTES).decode("utf-8", "replace"))
1151:+    except urllib.error.HTTPError as exc:
1152:+        raise ReviewerBroke(
1153:+            f"xai answered {exc.code}: {exc.read().decode(errors='replace')[:200]}"
1154:+        ) from exc
1155:+    except (urllib.error.URLError, TimeoutError, OSError) as exc:
1156:+        raise ReviewerBroke(f"xai unreachable: {str(exc)[:200]}") from exc
1157:+    except ValueError as exc:                       # not JSON
1158:+        raise ReviewerBroke(f"xai reply was not readable: {str(exc)[:200]}") from exc
1159:+    try:
1160:+        choice = payload["choices"][0]
1161:+        text = choice["message"]["content"] or ""
1162:+    except (KeyError, IndexError, TypeError) as exc:
1163:+        raise ReviewerBroke(f"xai reply had no message: {str(payload)[:200]}") from exc
1164:+    # An empty answer, or one cut off before the verdict line, is the TOOL failing.
1165:+    # Left to _parse_verdict it would become a permanent FAIL against this version.
1166:+    if not text.strip():
1167:+        raise ReviewerBroke("xai answered with no text")
1168:+    if choice.get("finish_reason") not in (None, "stop"):
1169:+        raise ReviewerBroke(f"xai stopped early: {choice.get('finish_reason')}")
1170:+    return _parse_verdict(text)
1171:+
1172:+
1177:+    "xai": _xai_review,
1178:+}
1179:+
1180:+# Can the runner actually run HERE, now? A runner that exists but has no key would be
1181:+# counted onto every new job's panel and then skip — parking the job forever with
1182:+# "3 required, 2 reported". Better one legible exclusion at the door.
1183:+_READY: dict[str, Callable[[], bool]] = {
1184:+    "xai": lambda: bool(os.environ.get(XAI_KEY_VAR, "").strip()),
1190:+    return provider in REVIEWERS and _READY.get(provider, lambda: True)()
1223:+    builder_family: str = ""        # the author is not a second opinion (migration 007)
1224:+
1228:+        """Counted the way the database counts: minds OTHER than the author's."""
1229:+        return {r.family for r in self.runs
1230:+                if r.verdict == "pass" and r.family != self.builder_family}
1256:@@ -218,56 +284,68 @@ class PanelResult:

