/bin/zsh -lc "nl -ba harness/gatekeeper.py | sed -n '1,360p'" in /Users/user/code-projects/chief-command
 succeeded in 0ms:
     1	"""The gatekeeper (task #11) — the one holder of the irreversible powers.
     2	
     3	Everything else in this harness can be wrong and the worst case is wasted work. These
     4	three things cannot be taken back:
     5	
     6	    merge    code enters main
     7	    deploy   something reaches the world
     8	    spend    real money leaves the account
     9	
    10	Until now any agent could do all three directly: `dispatch.ship()` was an import away,
    11	and spend was recorded by whoever was spending. The schema guards are real, but they
    12	stop *mistakes*, not *reach* — an agent that wanted to ship unreviewed work never needed
    13	to defeat a trigger, because it could write its own approval or its own passing verdict.
    14	
    15	Sol's line, which is the whole task:
    16	
    17	    "The database cannot be the jailer if the prisoner can rewrite the jail."
    18	
    19	So this is not another guard. It is a separation of powers. Agents *ask*; the gatekeeper
    20	checks the record itself, does exactly the one thing, and refuses everything else.
    21	
    22	FOUR RULES, and the design is mostly just these:
    23	
    24	  1. THREE VERBS. Not "run this for me". A gatekeeper that can be asked to run an
    25	     arbitrary command is a shell with extra steps, and every hole in it is a hole in
    26	     everything. There is no generic verb here, and adding one would end the point of
    27	     the file.
    28	
    29	  2. IT NEVER BELIEVES THE ASKER. Every claim in a request is ignored except the job id
    30	     and the target. The gatekeeper re-reads the panel, the versions, the families and
    31	     the approvals from the database itself. An agent under prompt injection can ask for
    32	     anything it likes; the answer depends on the record, not on the asking.
    33	
    34	  3. REFUSALS ARE LOUD. Every refusal is written to the job in plain English. A silent
    35	     refusal is indistinguishable from a thing that was never attempted — which is how
    36	     you end up debugging "why didn't it deploy" for an hour.
    37	
    38	  4. NO FALLBACK. If the gatekeeper is unreachable, irreversible things do not happen.
    39	     A fallback to the old direct path would BE the bypass. Down means stopped.
    40	
    41	⚠️ WHAT THIS FILE DOES NOT YET DO. Right now every agent still runs as the same user and
    42	can open the database file directly, so a determined process could bypass this module
    43	entirely. The service is the door; the file permissions are the wall, and the wall is
    44	still owner's work (see docs/gatekeeper-task11-spec.md). Until that lands, this raises
    45	the floor from "anyone can do anything" to "the normal path is the checked one" — real,
    46	but not yet a boundary. That distinction is stated here rather than glossed, because a
    47	gatekeeper everyone believes in but that doesn't hold is worse than none.
    48	"""
    49	
    50	from __future__ import annotations
    51	
    52	import json
    53	import os
    54	import re
    55	import secrets
    56	import sqlite3
    57	import subprocess
    58	import threading
    59	from dataclasses import dataclass
    60	from pathlib import Path
    61	from typing import Any, Callable
    62	
    63	from db.jobs import GuardViolation, connect, record_usage, seat, set_status
    64	
    65	HARNESS = Path(__file__).resolve().parent
    66	REPO = HARNESS.parent
    67	DB_PATH = HARNESS / "db" / "chief.db"
    68	
    69	TOKEN_PATH = Path.home() / ".chief" / "gatekeeper.token"
    70	MAX_BODY_BYTES = 64 * 1024
    71	MERGE_INTO = "main"
    72	
    73	# A branch name we are willing to merge. Deliberately narrow: `jobs.branch` is written
    74	# by the same code an agent controls, and `git rev-parse --verify` accepts REVISION
    75	# EXPRESSIONS, not just branches — `:/some message` resolves to a commit by searching
    76	# commit messages. A permissive check here turns "merge the branch for job 17" into
    77	# "merge any commit in the repository."
    78	BRANCH_RE = re.compile(r"^job/\d+\Z")
    79	
    80	# What money can be spent ON. The daily caps in the schema are keyed by role, so a role
    81	# nobody validated is a cap nobody enforces — 'research' would sail past both the build
    82	# ration and the review ration.
    83	SPEND_ROLES = {"build", "review", "test", "research", "voice"}
    84	
    85	
    86	class Refused(RuntimeError):
    87	    """The gatekeeper said no. The message is in plain English, on purpose — it is
    88	    shown to Neill, and 'guard_family_floor violated' tells him nothing."""
    89	
    90	
    91	@dataclass
    92	class Receipt:
    93	    """Proof that the one thing happened, and what it was."""
    94	    verb: str
    95	    subject: str
    96	    detail: str = ""
    97	    reference: str = ""          # commit id, usage row, deploy id
    98	
    99	
   100	# ---------------------------------------------------------------------------
   101	# Saying no, out loud
   102	# ---------------------------------------------------------------------------
   103	def _clean(text: str, limit: int = 120) -> str:
   104	    """Make caller-supplied text safe to show Neill.
   105	
   106	    Everything written by `_note` is attributed to the gatekeeper — the one component he
   107	    is being told to trust — so an agent that can inject newlines into it can forge
   108	    gatekeeper-signed lines on his timeline. Strip the formatting, cap the length.
   109	    """
   110	    return re.sub(r"\s+", " ", str(text)).strip()[:limit]
   111	
   112	
   113	def _log(conn, verb: str, subject: str, granted: bool, detail: str,
   114	         asked_by: str = "unknown", job_id: int | None = None) -> None:
   115	    """The gatekeeper's own record, which does not depend on there being a job.
   116	
   117	    Deploys aren't necessarily about a job, and `events.job_id` is NOT NULL — so before
   118	    this existed, a deploy's grants AND its refusals were dropped on the floor, for the
   119	    one verb where saying it out loud matters most. Append-only by trigger.
   120	    """
   121	    conn.execute(
   122	        "INSERT INTO gate_log (verb, subject, granted, detail, asked_by, job_id) "
   123	        "VALUES (?,?,?,?,?,?)",
   124	        (verb, _clean(subject), int(granted), _clean(detail, 400),
   125	         _clean(asked_by, 60), job_id),
   126	    )
   127	
   128	
   129	def _note(conn, job_id: int | None, text: str, kind: str = "skipped") -> None:
   130	    """Write a refusal (or a grant) onto the job where a person will see it.
   131	
   132	    Refusals are 'skipped' events; a grant is 'done' — a merge showing up in the
   133	    activity stream as a skip was telling Neill the opposite of what happened."""
   134	    if job_id is None:
   135	        return
   136	    row = conn.execute(
   137	        "SELECT builder_seat FROM jobs WHERE id = ?", (job_id,)
   138	    ).fetchone()
   139	    if row is None:
   140	        return
   141	    s = seat(conn, row["builder_seat"])
   142	    if s is None:
   143	        return
   144	    conn.execute(
   145	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   146	        "VALUES (?,?,?,?,?,?,?)",
   147	        (job_id, s["id"], "gatekeeper", s["model"], s["family"], kind, text),
   148	    )
   149	
   150	
   151	def _refuse(conn, job_id: int | None, why: str = "", *, verb: str = "",
   152	            subject: str = "", asked_by: str = "unknown") -> Refused:
   153	    # A job id the record doesn't know must not reach gate_log: its foreign key would
   154	    # throw, and the refusal — the one thing rule 3 says must never vanish — would.
   155	    job_id = _known_job(conn, job_id)
   156	    _note(conn, job_id, f"The gatekeeper said no: {why}")
   157	    if verb:
   158	        _log(conn, verb, subject or str(job_id), False, why, asked_by, job_id)
   159	    return Refused(why)
   160	
   161	
   162	def _known_job(conn, job_id) -> int | None:
   163	    try:
   164	        job_id = int(job_id) if job_id is not None else None
   165	    except (TypeError, ValueError):
   166	        return None
   167	    return job_id if job_id is not None and _job_exists(conn, job_id) else None
   168	
   169	
   170	# ---------------------------------------------------------------------------
   171	# MERGE — code enters main
   172	# ---------------------------------------------------------------------------
   173	def merge(conn, job_id: int, *, asked_by: str = "unknown") -> Receipt:
   174	    """Merge a job's branch into main, if and only if the record earns it.
   175	
   176	    Every check below re-reads the database. None of them takes the asker's word for
   177	    anything — that is the entire difference between this and `dispatch.ship()`, which
   178	    did the thing because it was called.
   179	    """
   180	    def _no(why: str) -> Refused:
   181	        """One way out of this function, so no refusal can forget to write itself down."""
   182	        return _refuse(conn, job_id if _job_exists(conn, job_id) else None, why,
   183	                       verb="merge", subject=f"job {job_id}", asked_by=asked_by)
   184	
   185	    job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   186	    if job is None:
   187	        raise _no(f"there is no job {job_id}")
   188	
   189	    if job["status"] == "shipped":
   190	        raise _no("that work has already been merged once")
   191	    if job["status"] != "done":
   192	        raise _no("that work hasn't finished its checks yet, so there's nothing to merge")
   193	
   194	    version = job["head_version"]
   195	    if not version:
   196	        raise _no("nothing was actually put forward — there's no finished version to merge")
   197	
   198	    verdicts = conn.execute(
   199	        "SELECT reviewer_seat, model_family, verdict, role, reviewed_version "
   200	        "FROM verdicts WHERE job_id = ?", (job_id,)
   201	    ).fetchall()
   202	    current = [v for v in verdicts if v["reviewed_version"] == version]
   203	
   204	    # A failure on this version is fatal and is NOT outvoted. A failure on an unknown
   205	    # version is also fatal: it condemns we-don't-know-what, so it condemns everything.
   206	    for v in verdicts:
   207	        if v["verdict"] == "fail" and (
   208	                v["reviewed_version"] is None or v["reviewed_version"] == version):
   209	            raise _no("a reviewer turned this down and that stands")
   210	    if any(v["verdict"] == "needs_human" for v in verdicts):
   211	        raise _no("a reviewer asked for you to look at this first")
   212	
   213	    passed = [v for v in current if v["verdict"] == "pass" and v["role"] == "reviewer"]
   214	    seats = {v["reviewer_seat"] for v in passed}
   215	    # The author is not a second opinion (migration 007): a same-family pass is a
   216	    # legitimate review, it just does not count toward "different minds". The schema
   217	    # already refuses first; this keeps the gate honest even if it ever stops.
   218	    families = {v["model_family"] for v in passed
   219	                if v["model_family"] != job["builder_family"]}
   220	
   221	    # A job carrying NO requirements is not a job everyone approved — it is a job whose
   222	    # requirements were never stamped. `0 < 0` is False, so treating zero as "nothing
   223	    # required" would let a row created outside dispatch merge with no reviews at all.
   224	    need_seats = job["required_reviews"] or 0
   225	    need_families = job["required_review_families"] or 0
   226	    if need_seats < 1 or need_families < 1:
   227	        raise _no("that job never had any review requirements set, so there is "
   228	                      "nothing to have passed")
   229	    if len(seats) < need_seats:
   230	        raise _no(f"only {len(seats)} of the {need_seats} reviewers "
   231	                      "have signed off on this version")
   232	    if len(families) < need_families:
   233	        raise _no(f"only {len(families)} different kinds of model have checked this; "
   234	                      f"{need_families} are required")
   235	
   236	    branch = job["branch"] or ""
   237	    if not BRANCH_RE.match(branch):
   238	        raise _no("there's no finished branch of code to merge for that job")
   239	
   240	    tip = _branch_tip(branch)
   241	    if tip is None:
   242	        raise _no("there's no finished branch of code to merge for that job")
   243	
   244	    # ══════════════════════════════════════════════════════════════════════════
   245	    # THE CHECK THIS WHOLE VERB EXISTS FOR.
   246	    #
   247	    # Everything above verifies the RECORD. This verifies that the code about to enter
   248	    # main IS the code the record is about. Without it, a builder commits v1, the panel
   249	    # reviews v1, `head_version` freezes at v1 — and then the builder pushes v2 to the
   250	    # same branch and asks for a merge. Every check passes, and v2 goes in. The version
   251	    # freeze that protects the record would be helping the attacker.
   252	    #
   253	    # Reviews are of bytes, not of intentions. Merge the bytes that were reviewed.
   254	    # ══════════════════════════════════════════════════════════════════════════
   255	    if not _same_commit(tip, version):
   256	        raise _no("the code on that branch isn't the code that was reviewed — "
   257	                      "it has changed since, so it needs checking again")
   258	
   259	    # And the commit must CONTAIN what the reviewers read. The panel judges the text the
   260	    # worker handed in (`jobs.result`); the version check above only proves the branch
   261	    # is the commit the record names. A worker could commit one thing and hand the
   262	    # reviewers another. So: the reviewed bytes must be in the commit, byte for byte.
   263	    if not _commit_holds_the_reviewed_work(tip, job_id, job["result"]):
   264	        raise _no("what's on that branch isn't what the reviewers read, "
   265	                      "so it can't be merged as reviewed")
   266	
   267	    if not _repo_is_ready():
   268	        raise _no("the project folder has unfinished changes in it, so it isn't "
   269	                      "safe to merge right now")
   270	
   271	    # ══════════════════════════════════════════════════════════════════════════
   272	    # ORDER IS THE POINT: the RECORD decides first, the irreversible act happens
   273	    # second. Merging and then asking produced "the code merged but the record wouldn't
   274	    # accept it" — an unreviewed merge with a polite note. The gatekeeper's own checks
   275	    # are a SUBSET of the schema's (it never checks for a passing tester), so the only
   276	    # safe order is to let the schema refuse before git is touched at all.
   277	    # ══════════════════════════════════════════════════════════════════════════
   278	    with _MERGE_LOCK:
   279	        # Re-resolve under the lock and merge the SHA, never the name. Between the check
   280	        # above and `git merge refs/heads/<branch>`, a builder could move the branch;
   281	        # merging by name would then merge whatever it points at now.
   282	        tip = _branch_tip(branch)
   283	        if tip is None or not _same_commit(tip, version):
   284	            raise _no("the code on that branch changed while the merge was being "
   285	                      "checked, so it needs checking again")
   286	        conn.execute("BEGIN IMMEDIATE")
   287	        try:
   288	            try:
   289	                set_status(conn, job_id, "shipped")
   290	            except (GuardViolation, sqlite3.IntegrityError) as exc:
   291	                conn.execute("ROLLBACK")
   292	                raise _no(_plain(exc)) from exc
   293	            commit = _git_merge(tip)
   294	            if commit is None:
   295	                conn.execute("ROLLBACK")          # the record never happened either
   296	                raise _no("the merge didn't go through cleanly — it needs a person")
   297	            conn.execute("COMMIT")
   298	        except BaseException:
   299	            # Never leave a transaction open on a connection somebody else will reuse.
   300	            if conn.in_transaction:
   301	                conn.execute("ROLLBACK")
   302	            raise
   303	
   304	    _note(conn, job_id,
   305	          f"Merged into the main line of code. Asked for by {_clean(asked_by)}.", kind="done")
   306	    _log(conn, "merge", f"job {job_id}", True,
   307	         f"{len(families)} model families signed off on {version}; merged {commit}",
   308	         asked_by, job_id)
   309	    return Receipt(verb="merge", subject=f"job {job_id}", reference=commit,
   310	                   detail=f"{len(families)} model families signed off on {version}")
   311	
   312	
   313	_MERGE_LOCK = threading.Lock()          # two merges racing share one git index
   314	
   315	
   316	def _job_exists(conn, job_id: int) -> bool:
   317	    return conn.execute("SELECT 1 FROM jobs WHERE id = ?", (job_id,)).fetchone() is not None
   318	
   319	
   320	def _plain(exc: Exception) -> str:
   321	    """A schema refusal, with the machine word taken off the front."""
   322	    return str(exc).replace("guard: ", "").strip() or "the record wouldn't accept it"
   323	
   324	
   325	def _branch_tip(branch: str) -> str | None:
   326	    """The commit a BRANCH points at — refs/heads/ so nothing else can be meant."""
   327	    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}"],
   328	                         cwd=REPO, capture_output=True, text=True)
   329	    return out.stdout.strip() or None if out.returncode == 0 else None
   330	
   331	
   332	def _same_commit(tip: str, version: str) -> bool:
   333	    """Is the reviewed version this exact commit?
   334	
   335	    `head_version` is a short id, so compare on the shorter length. A version that is
   336	    not a commit id at all (the local worker records a content hash) can never match,
   337	    which is correct: if we cannot prove the reviewed thing is this code, we do not
   338	    merge it.
   339	    """
   340	    version = (version or "").strip().lower()
   341	    tip = (tip or "").strip().lower()
   342	    if len(version) < 7 or not re.fullmatch(r"[0-9a-f]+", version):
   343	        return False
   344	    return tip.startswith(version)
   345	
   346	
   347	REVIEWED_FILE = "chief_output/job_{job_id}.txt"     # where executor.py commits the work
   348	
   349	
   350	def _commit_holds_the_reviewed_work(commit: str, job_id: int, reviewed: str | None) -> bool:
   351	    """Is the text the panel reviewed present, unchanged, in this exact commit?"""
   352	    if reviewed is None:
   353	        return False
   354	    out = subprocess.run(["git", "show", f"{commit}:{REVIEWED_FILE.format(job_id=job_id)}"],
   355	                         cwd=REPO, capture_output=True, text=True)
   356	    return out.returncode == 0 and out.stdout == reviewed
   357	
   358	
   359	def _repo_is_ready() -> bool:
   360	    """On the branch we merge into, with nothing half-done in the folder.

exec
/bin/zsh -lc "nl -ba harness/gatekeeper.py | sed -n '358,700p'" in /Users/user/code-projects/chief-command
 succeeded in 0ms:
   358	
   359	def _repo_is_ready() -> bool:
   360	    """On the branch we merge into, with nothing half-done in the folder.
   361	
   362	    Merging into a detached HEAD orphans the result; merging over the owner's own
   363	    uncommitted work risks losing it when a failed merge is aborted.
   364	    """
   365	    head = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
   366	                          cwd=REPO, capture_output=True, text=True)
   367	    if head.returncode != 0 or head.stdout.strip() != MERGE_INTO:
   368	        return False
   369	    dirty = subprocess.run(["git", "status", "--porcelain"],
   370	                           cwd=REPO, capture_output=True, text=True)
   371	    return dirty.returncode == 0 and not dirty.stdout.strip()
   372	
   373	
   374	def _git_merge(commit: str) -> str | None:
   375	    """Merge one exact commit. Takes a SHA, not a ref, on purpose."""
   376	    try:
   377	        proc = subprocess.run(["git", "merge", "--no-ff", "--no-edit", commit],
   378	                              cwd=REPO, capture_output=True, text=True, timeout=120)
   379	    except subprocess.TimeoutExpired:
   380	        _abort_any_merge()
   381	        return None
   382	    if proc.returncode != 0:
   383	        # Leave nothing half-merged behind. A conflicted tree that nobody is looking at
   384	        # is worse than a refusal.
   385	        _abort_any_merge()
   386	        return None
   387	    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=REPO,
   388	                          capture_output=True, text=True)
   389	    return head.stdout.strip()[:12] or None
   390	
   391	
   392	def _abort_any_merge() -> None:
   393	    """Undo a half-finished merge — and ONLY a half-finished merge.
   394	
   395	    `git merge --abort` is `git reset --merge` underneath, which will discard the
   396	    owner's uncommitted work if no merge is actually in progress. Check first.
   397	    """
   398	    if (REPO / ".git" / "MERGE_HEAD").exists():
   399	        subprocess.run(["git", "merge", "--abort"], cwd=REPO, capture_output=True)
   400	
   401	
   402	# ---------------------------------------------------------------------------
   403	# DEPLOY — something reaches the world
   404	# ---------------------------------------------------------------------------
   405	def deploy(conn, target: str, *, job_id: int | None = None,
   406	           asked_by: str = "unknown") -> Receipt:
   407	    """Deploy — ONLY on a live, unused, read-back owner approval naming this target.
   408	
   409	    Decision D keeps Neill in the path for production deploys, and this is the only
   410	    place in the harness where an agent's request is not enough on its own. There is
   411	    deliberately no "the reviewers all agreed" route here: reviewers judge code, and a
   412	    deploy is a decision about the business.
   413	    """
   414	    target = _clean(target)
   415	    approval = conn.execute(
   416	        "SELECT * FROM live_approvals WHERE capability = 'deploy' AND action = ? "
   417	        "ORDER BY id DESC LIMIT 1", (target,),
   418	    ).fetchone()
   419	    if approval is None:
   420	        raise _refuse(conn, job_id,
   421	                      f"nothing has been approved for deploying {target} — "
   422	                      "that needs your say-so, tapped, not spoken",
   423	                      verb="deploy", subject=target, asked_by=asked_by)
   424	    # An approval granted about ONE job does not authorize the same words claimed under
   425	    # another. Without this, a yes given in the context of job 4 travels to job 99.
   426	    if approval["job_id"] is not None and approval["job_id"] != job_id:
   427	        raise _refuse(conn, job_id,
   428	                      "that approval was for a different piece of work",
   429	                      verb="deploy", subject=target, asked_by=asked_by)
   430	    if not approval["reversible"] and not (approval["recovery"] or "").strip():
   431	        raise _refuse(conn, job_id,
   432	                      "that deploy can't be undone and there's no written way back",
   433	                      verb="deploy", subject=target, asked_by=asked_by)
   434	
   435	    # No mechanism, no deploy — and above all no CONSUMED approval. Burning the owner's
   436	    # one-time yes on a verb that then does nothing would make him grant it twice for
   437	    # one deploy. The mechanism, when built, registers here and runs BEHIND the gate.
   438	    deployer = DEPLOYERS.get(target)
   439	    if deployer is None:
   440	        raise _refuse(conn, job_id,
   441	                      f"there's no way to deploy {target} built yet — your approval "
   442	                      "was not used up",
   443	                      verb="deploy", subject=target, asked_by=asked_by)
   444	
   445	    # Spend the approval FIRST. If the deploy dies halfway, the slip is still used —
   446	    # a retry must come back for a fresh yes rather than replay an old one. Two callers
   447	    # racing: SQLite serializes the writes and the single-use guard refuses the loser,
   448	    # which arrives here as a plain refusal rather than a crash.
   449	    try:
   450	        conn.execute("UPDATE approvals SET used_at = datetime('now') WHERE id = ?",
   451	                     (approval["id"],))
   452	    except sqlite3.IntegrityError as exc:
   453	        raise _refuse(conn, job_id, "that approval has already been used",
   454	                      verb="deploy", subject=target, asked_by=asked_by) from exc
   455	
   456	    try:
   457	        reference = str(deployer(target) or "")
   458	    except Exception as exc:  # noqa: BLE001 — a failed deploy is a refusal, said aloud
   459	        raise _refuse(conn, job_id, f"the deploy of {target} didn't go through: "
   460	                      f"{_clean(str(exc), 160)} — it needs a fresh approval to retry",
   461	                      verb="deploy", subject=target, asked_by=asked_by) from exc
   462	
   463	    detail = f"deployed {target} on your approval"
   464	    _note(conn, job_id, f"Deployed {target}, on your approval. "
   465	                        f"Asked for by {_clean(asked_by)}.", kind="done")
   466	    _log(conn, "deploy", target, True, detail, asked_by, job_id)
   467	    return Receipt(verb="deploy", subject=target, detail=detail,
   468	                   reference=reference or str(approval["id"]))
   469	
   470	
   471	# What actually performs a deploy, by target. EMPTY on purpose: nothing in the harness
   472	# can deploy anything yet. When something can, it registers here — behind the gate, so
   473	# that the owner's approval is the only thing that can start it.
   474	DEPLOYERS: dict[str, Callable[[str], str | None]] = {}
   475	
   476	
   477	# ---------------------------------------------------------------------------
   478	# SPEND — real money leaves the account
   479	# ---------------------------------------------------------------------------
   480	def spend(conn, seat_id: str, cents: int, *, job_id: int | None = None,
   481	          role: str = "build", asked_by: str = "unknown") -> Receipt:
   482	    """Reserve money BEFORE the provider is called, or refuse.
   483	
   484	    Sol: refusing to RECORD a charge doesn't unspend it. So the ledger is written first
   485	    and the call happens after. The daily and monthly caps live in the schema, which is
   486	    what makes this a reservation rather than a note — two agents reserving at the same
   487	    instant both hit the ledger, and the ledger refuses the one that breaches.
   488	
   489	    ⚠️ THERE IS NO RECONCILIATION YET. A reservation is an ESTIMATE, and if the real
   490	    call costs less, or never happens at all, the estimate stands against the cap
   491	    permanently. That is deliberate for now (erring toward over-counting spend is the
   492	    safe direction) but it is not the same thing as accurate accounting, and this
   493	    docstring said otherwise until the cross-model review called it.
   494	    """
   495	    if cents < 0:
   496	        raise _refuse(conn, job_id, "a charge can't be negative",
   497	                      verb="spend", subject=seat_id, asked_by=asked_by)
   498	    row = seat(conn, seat_id)
   499	    if row is None:
   500	        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
   501	                      verb="spend", subject=seat_id, asked_by=asked_by)
   502	    # A metered seat costs money every call. "Reserve zero, then make the call" would
   503	    # walk every cap — daily, role, monthly — without any of them moving.
   504	    if cents == 0 and row["tier"] == "metered":
   505	        raise _refuse(conn, job_id, "a paid worker can't reserve nothing — "
   506	                      "say what the call will cost",
   507	                      verb="spend", subject=seat_id, asked_by=asked_by)
   508	    # The caps are keyed BY ROLE, so a role nobody validated is a cap nobody enforces —
   509	    # 'research' would sail past both the build ration and the review ration.
   510	    if role not in SPEND_ROLES:
   511	        raise _refuse(conn, job_id, f"'{role}' isn't a kind of work money can be spent on",
   512	                      verb="spend", subject=seat_id, asked_by=asked_by)
   513	    row = seat(conn, seat_id)
   514	    if row is None:
   515	        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
   516	                      verb="spend", subject=seat_id, asked_by=asked_by)
   517	    if not row["enabled"]:
   518	        raise _refuse(conn, job_id, f"'{seat_id}' is switched off",
   519	                      verb="spend", subject=seat_id, asked_by=asked_by)
   520	
   521	    try:
   522	        record_usage(conn, seat_id, cents, job_id=job_id, role=role)
   523	    except (GuardViolation, sqlite3.IntegrityError) as exc:
   524	        raise _refuse(conn, job_id,
   525	                      "that would go past the spending limit for today",
   526	                      verb="spend", subject=seat_id, asked_by=asked_by) from exc
   527	
   528	    ref = conn.execute("SELECT last_insert_rowid() AS id").fetchone()["id"]
   529	    _log(conn, "spend", seat_id, True, f"{cents}c reserved for {role}", asked_by, job_id)
   530	    return Receipt(verb="spend", subject=seat_id, detail=f"{cents}c reserved for {role}",
   531	                   reference=str(ref))
   532	
   533	
   534	VERBS = {"merge": merge, "deploy": deploy, "spend": spend}
   535	
   536	
   537	# ---------------------------------------------------------------------------
   538	# The service — loopback only, and only these three verbs
   539	# ---------------------------------------------------------------------------
   540	def handle(request: dict[str, Any], *, db_path: Path | None = None) -> dict[str, Any]:
   541	    """One request in, one answer out. The whole surface area of the gatekeeper.
   542	
   543	    An unknown verb is refused without being examined further. This is the check that
   544	    keeps rule 1 true as the file grows.
   545	    """
   546	    verb = request.get("verb")
   547	    if verb not in VERBS:
   548	        return {"ok": False, "error": "the gatekeeper only does three things: "
   549	                                      "merge, deploy, spend"}
   550	
   551	    conn = connect(db_path or DB_PATH)
   552	    try:
   553	        asked_by = str(request.get("asked_by") or "unknown")
   554	        try:
   555	            if verb == "merge":
   556	                r = merge(conn, int(request["job_id"]), asked_by=asked_by)
   557	            elif verb == "deploy":
   558	                r = deploy(conn, str(request["target"]),
   559	                           job_id=_known_job(conn, request.get("job_id")), asked_by=asked_by)
   560	            else:
   561	                r = spend(conn, str(request["seat_id"]), int(request["cents"]),
   562	                          job_id=_known_job(conn, request.get("job_id")),
   563	                          role=str(request.get("role") or "build"), asked_by=asked_by)
   564	        except Refused as exc:
   565	            return {"ok": False, "error": str(exc)}
   566	        except (KeyError, ValueError, TypeError) as exc:
   567	            return {"ok": False, "error": f"that request didn't make sense: {exc}"}
   568	        except sqlite3.Error as exc:
   569	            return {"ok": False, "error": f"the record refused that: {_plain(exc)}"}
   570	        return {"ok": True, "verb": r.verb, "subject": r.subject,
   571	                "detail": r.detail, "reference": r.reference}
   572	    finally:
   573	        conn.close()
   574	
   575	
   576	def token() -> str:
   577	    """The shared secret a caller must present. Created once, readable only by us.
   578	
   579	    Loopback is a NETWORK control, not an authorization one. Without a token, any local
   580	    process — and any web page the owner happens to open, since a POST with a plain
   581	    content type is a "simple request" that needs no browser preflight — could drive the
   582	    three most dangerous powers in the system by fetching 127.0.0.1. A page cannot read
   583	    this file, so it cannot present the token.
   584	    """
   585	    TOKEN_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   586	    if not TOKEN_PATH.exists() or not TOKEN_PATH.read_text().strip():
   587	        # 0600 from the first byte — never a world-readable instant — and O_EXCL so two
   588	        # processes starting at once can't each write a different token (the loser
   589	        # simply reads the winner's). An empty file counts as missing:
   590	        # `compare_digest("", "")` is True, so an empty token would have let a
   591	        # header-less request through. Fail closed, always.
   592	        if TOKEN_PATH.exists():
   593	            TOKEN_PATH.unlink()
   594	        try:
   595	            fd = os.open(TOKEN_PATH, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
   596	        except FileExistsError:
   597	            fd = None                           # someone else just created it
   598	        if fd is not None:
   599	            with os.fdopen(fd, "w") as f:
   600	                f.write(secrets.token_urlsafe(32))
   601	            os.chmod(TOKEN_PATH, 0o600)
   602	    value = TOKEN_PATH.read_text().strip()
   603	    if len(value) < 32:
   604	        raise RuntimeError("the gatekeeper token is missing or too short — refusing to serve")
   605	    return value
   606	
   607	
   608	def serve(host: str = "127.0.0.1", port: int = 8788) -> None:
   609	    """Run the gatekeeper as its own process.
   610	
   611	    LOOPBACK ONLY, and not a choice to revisit casually: the tailnet is other devices,
   612	    and the whole point of this process is that reaching it is harder than reaching the
   613	    agents, not easier. Standard library only — the thing holding the dangerous powers
   614	    should have the smallest possible surface.
   615	    """
   616	    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
   617	
   618	    expected = token()
   619	
   620	    class Handler(BaseHTTPRequestHandler):
   621	        protocol_version = "HTTP/1.1"
   622	
   623	        def _reply(self, code: int, answer: dict) -> None:
   624	            payload = json.dumps(answer).encode()
   625	            self.send_response(code)
   626	            self.send_header("Content-Type", "application/json")
   627	            self.send_header("Content-Length", str(len(payload)))
   628	            self.end_headers()
   629	            self.wfile.write(payload)
   630	
   631	        def do_POST(self):                                    # noqa: N802
   632	            try:
   633	                # Host check first: it is what stops DNS rebinding, where a page the
   634	                # owner is looking at resolves an attacker's domain to 127.0.0.1 and
   635	                # then talks to us with the browser's blessing.
   636	                host_header = (self.headers.get("Host") or "").split(":")[0]
   637	                if host_header not in ("127.0.0.1", "localhost", "[::1]"):
   638	                    return self._reply(403, {"ok": False, "error": "not for you"})
   639	                if not expected or not secrets.compare_digest(
   640	                        self.headers.get("X-Chief-Token") or "", expected):
   641	                    return self._reply(403, {"ok": False, "error": "not for you"})
   642	
   643	                length = int(self.headers.get("Content-Length") or 0)
   644	                if length < 0 or length > MAX_BODY_BYTES:
   645	                    return self._reply(413, {"ok": False, "error": "that request is too big"})
   646	                raw = self.rfile.read(length) if length else b"{}"
   647	                try:
   648	                    body = json.loads(raw or b"{}")
   649	                except json.JSONDecodeError:
   650	                    body = {}
   651	                if not isinstance(body, dict):
   652	                    body = {}
   653	
   654	                answer = handle(body)
   655	                self._reply(200 if answer.get("ok") else 403, answer)
   656	            except Exception:                                  # noqa: BLE001
   657	                # The gatekeeper never dies of a bad request. Down means stopped, and
   658	                # stopped means every irreversible thing stops with it.
   659	                try:
   660	                    self._reply(400, {"ok": False, "error": "that request didn't make sense"})
   661	                except Exception:                              # noqa: BLE001
   662	                    pass
   663	
   664	        def log_message(self, *args):                          # quiet by default
   665	            pass
   666	
   667	    server = ThreadingHTTPServer((host, port), Handler)
   668	    server.daemon_threads = True
   669	    server.serve_forever()
   670	
   671	
   672	if __name__ == "__main__":
   673	    serve()

