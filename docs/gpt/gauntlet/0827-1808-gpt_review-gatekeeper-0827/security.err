   316	# ═══════════════════════════════════════════════════════════════════════════════
   317	# THE GATE LOG — every ask, every answer, never a draft
   318	# (added after the 2026-08-27 review found the table had no test and spend never
   319	#  logged its grants)
   320	# ═══════════════════════════════════════════════════════════════════════════════
   321	def _gate_rows(conn):
