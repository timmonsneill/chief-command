    91	
    92	    cfg = load_config() if cfg is None else cfg
    93	    roster, excluded = panel_roster(conn, cfg)
    94	    families = int(cfg.get("gauntlet", {}).get("min_model_families", 0))
    95	    builder_row = seat(conn, builder_seat)
    96	    _refuse_a_panel_that_cannot_hold(conn, roster, families,
    97	                                     builder_row["family"] if builder_row else None)
    98	
    99	    # Duplicate protection — a retry must not start the same work twice.
   100	    if dispatch_key:
   101	        existing = conn.execute(
   102	            "SELECT id, builder_seat, tier, tier_reason FROM jobs WHERE dispatch_key = ?",
   103	            (dispatch_key,),
   104	        ).fetchone()
   105	        if existing is not None:
   106	            return LocalDispatch(
   107	                job_id=existing["id"], seat_id=existing["builder_seat"],
   108	                reused=True, tier=existing["tier"] or "standard",
   109	                tier_reason=existing["tier_reason"] or "",
   110	            )
   111	
   112	    row = seat(conn, builder_seat)
   113	    if row is None:
   114	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   115	    if not row["enabled"]:
   116	        raise DispatchRefused(f"seat '{builder_seat}' is turned off")
   117	    if over_budget(conn, builder_seat):
   118	        raise DispatchRefused(f"seat '{builder_seat}' is over its budget for today")
   119	
   120	    call = tier_for_build(request)
   121	
   122	    # ONE transaction for the whole record of this dispatch. A job must never exist,
   123	    # even for an instant, without its review requirements stamped on — in autocommit
   124	    # that gap is a real row with a zero floor. The excluded-reviewer notes go in here
   125	    # too: if writing them fails, the right outcome is no job at all, not a committed
   126	    # job whose panel quietly shrank without saying so.
   127	    #
   128	    # BEGIN IMMEDIATE, not BEGIN: this reads before it writes, and a deferred
   129	    # transaction that upgrades to a write after another connection has committed fails
   130	    # instantly with a snapshot error that the busy-timeout does NOT retry.
   131	    conn.execute("BEGIN IMMEDIATE")
   132	    try:
   133	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   134	        conn.execute(
   135	            "UPDATE jobs SET required_reviews = ?, required_review_families = ?, "
   136	            "tier = ?, tier_reason = ?, dispatch_key = ?, branch = ? WHERE id = ?",
   137	            (len(roster), families, call.tier, call.reason, dispatch_key,
   138	             f"job/{job_id}", job_id),
   139	        )
   140	        # No silent caps: a reviewer left out of the panel is written down on the job.
   141	        # (A roster name that isn't a seat at all has no row to hang an event on —
   142	        # sync_seats refuses that config outright, the earlier and louder place.)
   143	        for seat_id, why in excluded.items():
   144	            row = seat(conn, seat_id)
   145	            if row is None:
   146	                continue
   147	            conn.execute(
   148	                "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   149	                "VALUES (?,?,?,?,?,?,?)",
   150	                (job_id, seat_id, seat_id, row["model"], row["family"], "skipped",
   151	                 f"not on the panel: {why}"),
   152	            )
   153	        conn.execute("COMMIT")
   154	    except Exception as exc:
   155	        conn.execute("ROLLBACK")
   156	        # Anything that goes wrong here is a refusal to dispatch, not a mystery 500 —
   157	        # and above all not a committed job with no worker coming for it.
   158	        raise DispatchRefused(f"could not record the job: {exc}") from exc
   159	    set_status(conn, job_id, "in_progress")
   160	
   161	    if start:
   162	        executor.start_in_background(job_id, cfg=cfg)
   163	
   164	    return LocalDispatch(
   165	        job_id=job_id, seat_id=builder_seat, reused=False,
   166	        tier=call.tier, tier_reason=call.reason,
   167	    )
   168	
   169	
   170	# ---------------------------------------------------------------------------
   171	# Config
   172	# ---------------------------------------------------------------------------
   173	def load_config(path: Path = CONFIG) -> dict[str, Any]:
   174	    # seats.toml uses // comments for readability; TOML has no //, so strip them before
   175	    # parsing. Must be string-aware: value strings hold `https://…` and `base_url` lines
   176	    # end in `"…"  // note` — cutting at the first // blindly would eat the URL. So we
   177	    # only strip a // that sits OUTSIDE a quoted string.
   178	    raw = "\n".join(_strip_slash_comment(line) for line in path.read_text().splitlines())
   179	    return tomllib.loads(raw)
   180	
   181	
   182	def _strip_slash_comment(line: str) -> str:
   183	    """Drop an inline/full-line `//` comment, ignoring `//` inside quotes."""
   184	    quote = ""
   185	    for i in range(len(line) - 1):
   186	        ch = line[i]
   187	        if quote:
   188	            if ch == quote:
   189	                quote = ""
   190	        elif ch in "\"'":
   191	            quote = ch
   192	        elif ch == "/" and line[i + 1] == "/":
   193	            return line[:i].rstrip()
   194	    return line
   195	
   196	
   197	def unresolved_reviewers(cfg: dict[str, Any]) -> list[str]:
   198	    """Gauntlet reviewers that don't name a real seat. Empty == all resolve.
   199	
   200	    A roster entry pointing at a seat that doesn't exist (the old `grinder_paid`) is a
   201	    silent trap: `over_budget` treats the unknown seat as uncapped, the pre-check says
   202	    "fine," then the verdict write rejects it. Catch it at startup instead.
   203	    """
   204	    seats = cfg.get("seats", {})
   205	    return [r for r in cfg.get("gauntlet", {}).get("reviewers", []) if r not in seats]
   206	
   207	
   208	def panel_roster(conn, cfg: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
   209	    """Who can actually sit on the panel right now — and who can't, and why.
   210	
   211	    A roster entry is only real if the seat exists, is switched on, and we have a way to
   212	    RUN it on this machine. A seat whose provider has no runner, or whose key is absent, is excluded; the
   213	    codex seat needs its login. Counting those as panel members would produce a required
   214	    panel that can never report, which fails closed but useless — every job parked
   215	    forever. Counting them silently would be worse: a panel that shrank without saying
   216	    so reads exactly like a full one.
   217	
   218	    So: exclude them, name them, and let the FAMILY FLOOR (which cannot be lowered) be
   219	    the thing that decides whether what's left is enough.
   220	    """
   221	    import gauntlet
   222	
   223	    roster: list[str] = []
   224	    excluded: dict[str, str] = {}
   225	    for seat_id in cfg.get("gauntlet", {}).get("reviewers", []):
   226	        row = seat(conn, seat_id)
   227	        if row is None:
   228	            excluded[seat_id] = "that reviewer isn't set up on this machine"
   229	        elif not row["enabled"]:
   230	            excluded[seat_id] = "that reviewer is turned off"
   231	        elif not gauntlet.has_runner(row["provider"]):
   232	            excluded[seat_id] = "we have no way to run that reviewer yet"
   233	        else:
   234	            roster.append(seat_id)
   235	    return roster, excluded
   236	
   237	
   238	def _refuse_a_panel_that_cannot_hold(conn, roster: list[str], floor: int,
   239	                                     builder_family: str | None = None) -> None:
   240	    """Refuse to dispatch work the panel could never certify.
   241	
   242	    Fail CLOSED, but say so at DISPATCH — when it is one legible refusal — rather than
   243	    at review time, where it becomes a job that parks forever and looks like a bug.
   244	    """
   245	    if floor < 1:
   246	        raise DispatchRefused(
   247	            "the review panel isn't configured (it needs at least one model family) "
   248	            "— refusing to start work that nothing would check"
   249	        )
   250	    # Counted the way the database counts (migration 007): the author's own family is
   251	    # not a second opinion. Counting it here admitted jobs the record then parked.
   252	    families = {seat(conn, s)["family"] for s in roster} - {builder_family}
   253	    if len(families) < floor:
   254	        raise DispatchRefused(
   255	            f"only {len(families)} model family/families can review right now and "
   256	            f"{floor} are required — refusing to start work that could never be checked"
   257	        )
   258	
   259	
   260	def sync_seats(conn, cfg: dict[str, Any]) -> None:
   261	    """Push the config's seats into the store, so guards can reason about them.
   262	
   263	    Refuses a config whose gauntlet names a seat that doesn't exist, or a seat missing a
   264	    family — both would blow up later, mid-panel, where it's far harder to see.
   265	    """
   266	    missing = unresolved_reviewers(cfg)
   267	    if missing:
   268	        raise DispatchRefused(f"gauntlet names seats that don't exist: {missing}")
   269	    for seat_id, s in cfg.get("seats", {}).items():
   270	        if "family" not in s:
   271	            raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
   272	    for seat_id, s in cfg.get("seats", {}).items():
   273	        upsert_seat(conn, Seat(
   274	            id=seat_id,
   275	            provider=s["provider"],
   276	            model=s["model"],
   277	            family=s["family"],
   278	            tier=s["tier"],
   279	            daily_cap_cents=s.get("daily_cap_cents"),
   280	            build_cap_cents=s.get("build_cap_cents"),
   281	            review_cap_cents=s.get("review_cap_cents"),
   282	            enabled=not s.get("disabled", False),
   283	            notes=s.get("notes", ""),
   284	        ))
   285	
   286	
   287	# ---------------------------------------------------------------------------
   288	# Dispatch
   289	# ---------------------------------------------------------------------------
   290	@dataclass
   291	class Dispatch:
   292	    job_id: int
   293	    run_id: str | None
   294	    seat_id: str
   295	
   296	
   297	def dispatch(
   298	    conn,
   299	    request: str,
   300	    builder_seat: str,
   301	    cfg: dict[str, Any],
   302	    origin: str = "text",
   303	    blocking: bool = False,
   304	) -> Dispatch:
   305	    """Record the job, then spawn it on OpenClaw. In that order, always.
   306	
   307	    Non-blocking by default — this is what lets the mouth stay responsive. OpenClaw's
   308	    sessions_spawn returns a run id immediately, so the voice head can say "on it" and
   309	    keep talking while the work grinds. A blocking dispatch here would reintroduce
   310	    exactly the latency wound that killed v1.
   311	    """
   312	    row = seat(conn, builder_seat)
   313	    if row is None:
   314	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   315	    if not row["enabled"]:
   316	        raise DispatchRefused(f"seat '{builder_seat}' is disabled")
   317	
   318	    # OpenClaw core has NO per-agent budget of any kind. If we don't check here,
   319	    # nothing does.
   320	    if over_budget(conn, builder_seat):
   321	        raise DispatchRefused(
   322	            f"seat '{builder_seat}' is over its daily cap — refusing to dispatch"
   323	        )
   324	
   325	    # SAME roster question dispatch_local asks. This path used to count the raw config
   326	    # list, so a job here was stamped as needing 3 reviewers when only 2 could ever run —
   327	    # and then parked forever with nothing to explain it, instead of one legible refusal
   328	    # at the door. Both entrances, one rule.
   329	    gauntlet = cfg.get("gauntlet", {})
   330	    roster, excluded = panel_roster(conn, cfg)
   331	    required = len(roster)
   332	    families = int(gauntlet.get("min_model_families", 0))
   333	    _refuse_a_panel_that_cannot_hold(conn, roster, families, row["family"])
   334	
   335	    # One transaction: the job must never exist for even a moment without its review
   336	    # requirements stamped on (autocommit would otherwise leave a floor-0 gap).
   337	    # IMMEDIATE because this reads before it writes — see dispatch_local.
   338	    conn.execute("BEGIN IMMEDIATE")
   339	    try:
   340	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   341	        conn.execute(
   342	            "UPDATE jobs SET required_reviews = ?, required_review_families = ? WHERE id = ?",
   343	            (required, families, job_id),
   344	        )
   345	        # No silent caps here either — same note dispatch_local writes.
   346	        for seat_id, why in excluded.items():
   347	            ex = seat(conn, seat_id)
   348	            if ex is None:
   349	                continue
   350	            conn.execute(
   351	                "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   352	                "VALUES (?,?,?,?,?,?,?)",
   353	                (job_id, seat_id, seat_id, ex["model"], ex["family"], "skipped",
   354	                 f"not on the panel: {why}"),
   355	            )
   356	        conn.execute("COMMIT")
   357	    except Exception:
   358	        conn.execute("ROLLBACK")
   359	        raise
   360	
   361	    run_id = _spawn(row, request, blocking=blocking)
   362	    attach_run(conn, job_id, run_id=run_id or "", branch=f"job/{job_id}")
   363	    set_status(conn, job_id, "in_progress")
   364	
   365	    return Dispatch(job_id=job_id, run_id=run_id, seat_id=builder_seat)
   366	
   367	
   368	def _spawn(seat_row, request: str, blocking: bool) -> str | None:
   369	    """Hand the work to OpenClaw.
   370	
   371	    `openclaw agent` runs one turn via the Gateway. The model is chosen per-spawn,
   372	    which is what lets a single orchestrator turn fan out across several families.
   373	    """
   374	    cmd = [
   375	        "openclaw", "agent",
   376	        "--model", f"{seat_row['provider']}/{seat_row['model']}",
   377	        "--message", request,
   378	    ]
   379	    if not blocking:
   380	        cmd.append("--detach")
   381	
   382	    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
   383	    if proc.returncode != 0:
   384	        raise DispatchRefused(f"openclaw refused the spawn: {proc.stderr.strip()[:300]}")
   385	
   386	    # The gateway echoes a run id; fall back to the raw stdout if the shape changes.
   387	    try:
   388	        return json.loads(proc.stdout).get("runId")
   389	    except (json.JSONDecodeError, AttributeError):
   390	        return proc.stdout.strip()[:80] or None
   391	
   392	
   393	# ---------------------------------------------------------------------------
   394	# The gauntlet (spec §6)
   395	# ---------------------------------------------------------------------------
   396	def run_gauntlet(conn, job_id: int, cfg: dict[str, Any]) -> dict[str, Any]:
   397	    """Fan the finished work out to the reviewer panel, in parallel, same bundle.
   398	
   399	    This used to return a list of reviewer NAMES and launch nobody — the gauntlet was a
   400	    plan, not a thing that ran (task #10). It now runs the panel and returns what
   401	    actually happened: who reviewed, which families, what they said, and — if the job
   402	    stayed parked — why, in plain words.
   403	
   404	    The model-diversity rule (§6) still isn't asserted here; it's RECORDED. Every
   405	    verdict snapshots the reviewing seat's family, and the schema refuses to complete a
   406	    job without enough distinct families passing THIS version. So "two different minds
   407	    looked at this" is a fact you can query, not a promise this function made.
   408	    """
   409	    import gauntlet as gauntlet_mod
   410	
   411	    return gauntlet_mod.run_gauntlet_for_job(conn, job_id, cfg).as_dict()
   412	
   413	
   414	def ship(conn, job_id: int, owner_confirmed: bool = False) -> None:
   415	    """DO NOT CALL. Shipping belongs to the gatekeeper now (task #11).
   416	
   417	    This function is the reason #11 exists: it was one import away from any agent, and
   418	    it did the thing because it was called. `gatekeeper.merge()` does the same job and
   419	    re-reads the record instead of trusting the caller.
   420	
   421	    Kept as a refusal rather than deleted, so that anything still reaching for the old
   422	    power gets a legible answer instead of an ImportError somebody "fixes" by
   423	    reimplementing it locally.
   424	    """
   425	    raise DispatchRefused(
   426	        "shipping is the gatekeeper's job now — ask it to merge (gatekeeper.merge), "
   427	        "which checks the panel, the version and the families itself"
   428	    )
   429	
   430	
   431	# The original ship() implementation used to sit here, renamed. That was the mistake the
   432	# comment above warns about, made in the same file: the new ship() refused politely while
   433	# the old power stayed callable eight lines below it. Deleted. gatekeeper.merge() is the
   434	# only route to 'shipped', and it re-reads the record instead of trusting the caller.
   435	
   436	
   437	def morning_report(conn) -> list[dict[str, Any]]:
   438	    """What shipped while you slept, and what didn't.
   439	
   440	    Neill is out of the critical path, not out of the loop. This is the difference.
   441	    """
   442	    rows = conn.execute(
   443	        """
   444	        SELECT id, request, status, builder_seat, spoken_summary, finished_at
   445	          FROM jobs
   446	         WHERE created_at >= datetime('now', '-1 day')
   447	         ORDER BY
   448	           CASE status WHEN 'shipped' THEN 0 WHEN 'review' THEN 1
   449	                       WHEN 'failed' THEN 2 ELSE 3 END,
   450	           id
   451	        """
   452	    ).fetchall()
   453	    return [dict(r) for r in rows]
     1	"""The worker. This is the thing that was missing — the reason nothing ran.
     2	
     3	Dispatch (dispatch.py) decides a job MAY run and records it. This module is what
     4	actually DOES it: it takes a queued job, runs the work on the assigned seat's real
     5	model, writes down every step as it goes, and lands a real result. Before this file
     6	existed, Chief said "putting Riggs on it" and no worker ever started.
     7	
     8	Two hard rules, both structural rather than polite:
     9	
    10	  1. THE WORK HAPPENS IN AN ISOLATED WORKTREE, never the live project. A builder gets
    11	     its own private copy of the repo (a git worktree). It physically cannot scribble
    12	     on main while it works — main is untouched until something is reviewed and merged
    13	     by the one service allowed to merge. "One worktree per agent" (owner + Sol).
    14	
    15	  2. LOCAL OUTPUT CANNOT COMPLETE ON ITS OWN. When the free local model finishes, the
    16	     job parks at 'review'. The database guards (schema.sql) refuse to let it reach
    17	     'done' without a higher-tier reviewer passing THIS version. We do not route
    18	     around that here; we feed it.
    19	
    20	Runs in a background thread so the app never blocks — the whole point of the
    21	architecture. sessions come and go; the job row is the durable truth.
    22	"""
    23	
    24	from __future__ import annotations
    25	
    26	import hashlib
    27	import os
    28	import json
    29	import subprocess
    30	import threading
    31	import urllib.request
    32	from pathlib import Path
    33	from typing import Any
    34	
    35	from db.jobs import (
    36	    connect,
    37	    seat,
    38	    set_head_version,
    39	    set_status,
    40	)
    41	
    42	HARNESS = Path(__file__).resolve().parent
    43	DB_PATH = HARNESS / "db" / "chief.db"
    44	WORKTREES = HARNESS / ".worktrees"       # gitignored; one subdir per job
    45	OUTPUT_DIRNAME = "chief_output"          # where a builder drops standalone work
    46	
    47	OLLAMA_URL = "http://127.0.0.1:11434/api/generate"
    48	
    49	
    50	# ---------------------------------------------------------------------------
    51	# Event trail — this is what the app's activity view reads. Every step, live.
    52	# ---------------------------------------------------------------------------
    53	def _event(conn, job_id: int, seat_row, kind: str, detail: str = "", target: str = "") -> None:
    54	    conn.execute(
    55	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, target, detail) "
    56	        "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
    57	        (job_id, seat_row["id"], seat_row["id"], seat_row["model"],
    58	         seat_row["family"], kind, target or None, detail or None),
    59	    )
    60	
    61	
    62	def _commit_in_worktree(wt: Path, job_id: int, branch: str, summary: str) -> str | None:
    63	    """Commit the job's output on its own branch and return the commit id.
    64	
    65	    This is what makes the gatekeeper's merge possible at all: it refuses unless the
    66	    branch tip IS the reviewed version, and a version has to be a commit for that to be
    67	    provable. If anything here fails, the caller falls back to a content hash — the job
    68	    is still reviewable, it just can never be merged by the gatekeeper, which is the
    69	    honest outcome for work that isn't in git.
    70	    """
    71	    env = {**os.environ,
    72	           "GIT_AUTHOR_NAME": "chief-worker", "GIT_AUTHOR_EMAIL": "worker@chief.local",
    73	           "GIT_COMMITTER_NAME": "chief-worker", "GIT_COMMITTER_EMAIL": "worker@chief.local"}
    74	    def git(*args):
    75	        return subprocess.run(["git", *args], cwd=wt, capture_output=True, text=True,
    76	                              timeout=60, env=env)
    77	    try:
    78	        if git("rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
    79	            return None
    80	        if git("checkout", "-B", branch).returncode != 0:
    81	            return None
    82	        if git("add", "-A", OUTPUT_DIRNAME).returncode != 0:
    83	            return None
    84	        if git("commit", "-q", "-m", f"job {job_id}: {summary[:60]}").returncode != 0:
    85	            return None
    86	        sha = git("rev-parse", "HEAD").stdout.strip()
    87	    except (subprocess.TimeoutExpired, OSError):
    88	        return None          # a hung git is "not in git", not a dead worker thread
    89	    return sha[:16] if len(sha) >= 16 else None
    90	
    91	
    92	def _version_of(text: str) -> str:
    93	    """The exact content being put forward, as a short hash. This is what the whole
    94	    review-to-version chain binds to: change the output, change the version, and every
    95	    earlier approval silently stops counting (schema.sql, gate 3)."""
    96	    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]
    97	
    98	
    99	# ---------------------------------------------------------------------------
   100	# Worktree isolation — a builder never touches the live project.
   101	# ---------------------------------------------------------------------------
   102	def _make_worktree(job_id: int, branch: str) -> tuple[Path | None, str]:
   103	    """Give this job its own private copy of the repo. Returns (path, note).
   104	
   105	    If git worktrees aren't usable for any reason, fall back to a plain isolated
   106	    directory and SAY SO — a silent fallback that quietly drops isolation would be
   107	    exactly the kind of unspoken gap this project keeps getting bitten by.
   108	    """
   109	    WORKTREES.mkdir(exist_ok=True)
   110	    dest = WORKTREES / f"job-{job_id}"
   111	    if dest.exists():
   112	        return dest, "reused"
   113	    try:
   114	        subprocess.run(
   115	            ["git", "worktree", "add", "--detach", str(dest)],
   116	            cwd=HARNESS.parent, capture_output=True, text=True, timeout=60, check=True,
   117	        )
   118	        return dest, "worktree"
   119	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   120	        # Isolation still holds (separate dir, outside the repo tree) — it just isn't a
   121	        # git worktree, so we record that honestly.
   122	        dest.mkdir(parents=True, exist_ok=True)
   123	        detail = getattr(exc, "stderr", "") or str(exc)
   124	        return dest, f"plain-dir ({str(detail)[:60].strip()})"
   125	
   126	
   127	def cleanup_worktree(job_id: int) -> None:
   128	    """Remove a job's worktree once its work is merged or abandoned."""
   129	    dest = WORKTREES / f"job-{job_id}"
   130	    if not dest.exists():
   131	        return
   132	    subprocess.run(["git", "worktree", "remove", "--force", str(dest)],
   133	                   cwd=HARNESS.parent, capture_output=True, text=True)
   134	    if dest.exists():
   135	        subprocess.run(["rm", "-rf", str(dest)], capture_output=True, text=True)
   136	
   137	
   138	# ---------------------------------------------------------------------------
   139	# The actual builders, one per provider. Add a provider = add a function.
   140	# ---------------------------------------------------------------------------
   141	def _ollama_build(seat_row, request: str, model: str) -> str:
   142	    """The free local coder actually writes the code."""
   143	    payload = json.dumps({"model": model, "prompt": request, "stream": False}).encode()
   144	    req = urllib.request.Request(
   145	        OLLAMA_URL, data=payload, headers={"Content-Type": "application/json"}
   146	    )
   147	    with urllib.request.urlopen(req, timeout=300) as r:
   148	        return json.loads(r.read())["response"].strip()
   149	
   150	
   151	_BUILDERS = {
   152	    "ollama": _ollama_build,
   153	}
   154	
   155	
   156	# Reviewing lives in gauntlet.py (task #10). This module builds; that one judges.
   157	# It used to hold a single hard-wired Claude reviewer, which was enough to close the
   158	# loop and was never the design — one reviewer cannot show that a DIFFERENT MIND looked.
   159	
   160	
   161	# ---------------------------------------------------------------------------
   162	# The run loop — everything above, in order, for one job.
   163	# ---------------------------------------------------------------------------
   164	def run_job(job_id: int, *, cfg: dict[str, Any] | None = None) -> dict[str, Any]:
   165	    """Take one recorded job and actually do it. Safe to call in a thread.
   166	
   167	    Opens its own database connection (sqlite + threads). WAL mode lets this write
   168	    while the web server reads. Never raises to the caller — a worker that dies must
   169	    leave a legible 'failed' row, not a stack trace nobody sees.
   170	    """
   171	    conn = connect(DB_PATH)
   172	    try:
   173	        job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   174	        if job is None:
   175	            return {"job_id": job_id, "status": "missing"}
   176	        seat_row = seat(conn, job["builder_seat"])
   177	        if seat_row is None:
   178	            set_status(conn, job_id, "failed", error=f"unknown seat {job['builder_seat']}")
   179	            return {"job_id": job_id, "status": "failed"}
   180	
   181	        builder = _BUILDERS.get(seat_row["provider"])
   182	        if builder is None:
   183	            # A provider we don't have a local runner for (codex/xai/claude-cli builds
   184	            # go through OpenClaw, not this in-process worker). Say so plainly.
   185	            set_status(conn, job_id, "failed",
   186	                       error=f"no in-process builder for provider '{seat_row['provider']}' "
   187	                             "— this seat dispatches through OpenClaw")
   188	            _event(conn, job_id, seat_row, "error",
   189	                   "This worker only runs the local model directly.")
   190	            return {"job_id": job_id, "status": "failed"}
   191	
   192	        # 1. Isolate.
   193	        wt, wt_note = _make_worktree(job_id, job["branch"] or f"job/{job_id}")
   194	        conn.execute("UPDATE jobs SET worktree = ? WHERE id = ?", (str(wt), job_id))
   195	        _event(conn, job_id, seat_row, "dispatched", f"Working in its own copy ({wt_note}).")
   196	
   197	        # 2. Build.
   198	        model = job["tier"] and _model_for(seat_row, job["tier"]) or seat_row["model"]
   199	        _event(conn, job_id, seat_row, "thinking", "Working out how to do it.")
   200	        try:
   201	            result = builder(seat_row, job["request"], model)
   202	        except Exception as exc:  # network, model, timeout — all land here
   203	            set_status(conn, job_id, "failed", error=f"builder error: {exc}")
   204	            _event(conn, job_id, seat_row, "error", "The worker hit a problem.")
   205	            return {"job_id": job_id, "status": "failed"}
   206	
   207	        # 3. Land the output in the isolated copy, and version it.
   208	        out_dir = wt / OUTPUT_DIRNAME
   209	        out_dir.mkdir(parents=True, exist_ok=True)
   210	        (out_dir / f"job_{job_id}.txt").write_text(result)
   211	        branch = job["branch"] or f"job/{job_id}"
   212	        version = _commit_in_worktree(wt, job_id, branch, job["request"]) or _version_of(result)
   213	        set_head_version(conn, job_id, version)
   214	        _event(conn, job_id, seat_row, "write",
   215	               f"Wrote {len(result)} characters of work.", target=str(out_dir))
   216	
   217	        # 4. Park for review. The guards will hold it here until a real reviewer passes
   218	        #    THIS version — we never force it past them.
   219	        set_status(conn, job_id, "review", result=result)
   220	
   221	        # 5. Hand the frozen bundle to the review panel — several families at once,
   222	        #    all bound to THIS version. The panel decides nothing the database wouldn't;
   223	        #    it produces the verdicts the guards ask for. Without a config there is no
   224	        #    panel, and the job simply stays parked (the safe outcome, not a shortcut).
   225	        if cfg is not None:
   226	            import gauntlet
   227	            gauntlet.run_panel(conn, job_id, job["request"], result, version, cfg,
   228	                               db_path=DB_PATH)
   229	
   230	        final = conn.execute("SELECT status FROM jobs WHERE id = ?", (job_id,)).fetchone()["status"]
   231	        return {"job_id": job_id, "status": final, "version": version}
   232	    finally:
   233	        conn.close()
   234	
   235	
   236	def _model_for(seat_row, tier: str) -> str:
   237	    try:
   238	        from tiering import resolve_model
   239	        return resolve_model(seat_row, tier)[0]
   240	    except Exception:
   241	        return seat_row["model"]
   242	
   243	
   244	# ---------------------------------------------------------------------------
   245	# Fire-and-forget: start a worker in the background so the app stays responsive.
   246	# ---------------------------------------------------------------------------
   247	def start_in_background(job_id: int, *, cfg: dict[str, Any] | None = None) -> threading.Thread:
   248	    t = threading.Thread(
   249	        target=run_job, args=(job_id,), kwargs={"cfg": cfg},
   250	        name=f"job-{job_id}", daemon=True,
   251	    )
   252	    t.start()
   253	    return t

codex
The central gate checks are careful about branch-name injection and reviewed-version substitution, but the security boundary is not complete yet: the code itself acknowledges that agents still share the same account and can reach both the records and version-control commands directly. I’m distinguishing that known staged limitation from new, fixable defects in this branch before deciding severity. I’m also starting the required full test run now.
