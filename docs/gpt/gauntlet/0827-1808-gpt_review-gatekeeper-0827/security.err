   110	def test_merge_refuses_when_a_reviewer_turned_it_down(conn):
   111	    """The objection lands AFTER the job completed — the completion guards fire on the
   112	    way into 'done' and cannot act on it, so the gatekeeper is the thing that must."""
   113	    job = _finished_job(conn)
   114	    set_status(conn, job, "done")
   115	    record_verdict(conn, job, "grok", verdict="fail", role="reviewer")
   116	    with pytest.raises(gatekeeper.Refused, match="turned this down"):
