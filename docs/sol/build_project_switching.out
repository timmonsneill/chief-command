+            "Background — this project's own accumulated notes (read-only context, "
+            f"not part of the task):\n\n{memory_text.strip()[:MEMORY_INDEX_MAX_CHARS]}"
+        )
+    sections.append(f"The task:\n\n{request}")
+    return "\n\n---\n\n".join(sections)
