/bin/zsh -lc "sed -n '1,180p' harness/server.py; rg -n \"def db|_db|DB =|_SEATS_SYNCED|def sync\" harness/server.py harness/dispatch.py | head -100" in /Users/user/code-projects/chief-command-worktrees/gpt-project-switching
