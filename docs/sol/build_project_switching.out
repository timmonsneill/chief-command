  MEM_SHOWN_FOR = pid;
  if (MEM_HTML[pid] !== undefined) { if (body) body.innerHTML = MEM_HTML[pid]; return; }
  try {
    const r = await fetch('/api/projects/' + pid + '/memory');
    if (!r.ok) {
      MEM_HTML[pid] = '<div class="empty2">No notes for this project yet.</div>';
    } else {
      const { index } = await r.json();
      MEM_HTML[pid] = '<div class="memidx">' + renderMemoryIndex(pid, index) + '</div>';
    }
  } catch { MEM_HTML[pid] = '<div class="empty2">Couldn\'t load the notes.</div>'; }
  // Only paint if the user is still looking at this project (mid-fetch switch guard).
  if (MEM_SHOWN_FOR === pid && body) body.innerHTML = MEM_HTML[pid];
}

// Build the index as escaped markup with NO inline handlers. File links carry the target
// in data- attributes and are opened by ONE delegated listener — so a hostile filename in
// a note (agent output is low-trust, AGENTS.md rule 6) can never break out into script.
function renderMemoryIndex(pid, index) {
  return index.split('\n').map(line => {
    const t = line.trim();
    if (!t) return '';
    if (t.startsWith('#')) return `<div class="memh">${esc(t.replace(/^#+\s*/, ''))}</div>`;
    const star = t.includes('⭐');
    const m = t.match(/\[([^\]]+)\]\(([^)]+\.md)\)/);  // first [title](file.md) in the bullet
    const rest = esc(t.replace(/^[-*⭐\s]+/, '').replace(/\[[^\]]+\]\([^)]+\)/, '').replace(/^\s*[—-]\s*/, ''));
    if (m) return `<div class="meml ${star?'imp':''}">`
      + `<a class="memlink" data-pid="${esc(pid)}" data-name="${esc(m[2])}">${esc(m[1])}</a>`
      + (rest ? ` <span class="memd">${rest}</span>` : '') + '</div>';
    return `<div class="meml ${star?'imp':''}">${esc(t.replace(/^[-*⭐\s]+/, ''))}</div>`;
  }).join('');
}

document.addEventListener('click', e => {
  const a = e.target.closest('.memlink');
  if (a) openMemory(a.dataset.pid, a.dataset.name);
});

async function openMemory(pid, name) {
  const r = await fetch('/api/projects/' + encodeURIComponent(pid) + '/memory/' + encodeURIComponent(name));
  const ov = document.querySelector('#memov'), bd = document.querySelector('#memovbody');
  bd.textContent = r.ok ? (await r.json()).text : 'Could not open that note.';  // textContent, never innerHTML
  ov.classList.add('on');
}
window.closeMemory = () => document.querySelector('#memov').classList.remove('on');

window.selectProject = id => { MEM_SHOWN_FOR = null; SELECTED_PROJECT = id; renderProjects(window.STATE); };
window.toggleTodo = async id => { await fetch('/api/todos/'+id+'/toggle',{method:'POST'}); refresh(); };
window.deleteTodo = async id => { await fetch('/api/todos/'+id+'/delete',{method:'POST'}); refresh(); };
window.addTodo = async (e, pid) => {
  e.preventDefault();
  const f = e.target;
  const text = f.querySelector('.ttextin').value.trim(); if (!text) return false;
  const section = f.querySelector('.tsecin').value.trim();
  await fetch('/api/projects/'+pid+'/todos', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({text, section})
  });
  f.querySelector('.ttextin').value = '';
  refresh();
  return false;
};
window.uploadFile = async (input, pid) => {
  if (!input.files || !input.files[0]) return;
  const fd = new FormData();
  fd.append('file', input.files[0]);
  fd.append('project_id', pid);
  const lbl = input.parentNode; const t = lbl.firstChild.textContent;
  lbl.firstChild.textContent = 'Uploading…';
  try { await fetch('/api/upload', {method:'POST', body:fd}); } finally { lbl.firstChild.textContent = t; }
  input.value = '';
  refresh();
};

refresh();
setInterval(() => { if (!$('#talk').classList.contains('on')) refresh(); }, 4000);
bubble('chief', 'Chief', "I'm here. Ask me anything, or tell me what to build.");
</script>
