   841	
   842	-- ===========================================================================
   843	-- GUARD 5 — the full panel, always. DISTINCT reviewers.
   844	--
   845	-- ⚠️ Sol #7: "The full panel can be faked with duplicate passes." It counted ROWS.
   846	-- One reviewer could pass the same job six times. Now it counts distinct seats.
   847	-- ===========================================================================
   848	CREATE TRIGGER IF NOT EXISTS guard_full_panel
   849	BEFORE UPDATE OF status ON jobs
   850	WHEN NEW.status = 'done' AND OLD.status <> 'done' AND NEW.required_reviews > 0
   851	BEGIN
   852	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
   853	    WHERE (
   854	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
   855	        -- the panel could be "filled" by the wrong kinds of check entirely.
   856	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
   857	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   858	          -- gate 3: the panel must have reviewed THIS version, not an earlier one
   859	          AND v.reviewed_version IS NEW.head_version
   860	    ) < NEW.required_reviews;
   861	END;
   862	
   863	-- ═══════════════════════════════════════════════════════════════════════════
   864	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   865	--
   866	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
   867	-- serious failure satisfied it. A reviewer could scream that the thing was broken and
   868	-- be outvoted by colleagues who hadn't noticed.
   869	--
   870	-- That is the opposite of what a gauntlet is FOR. One reviewer finding a real bug is
   871	-- the whole point — it isn't a democracy, it's a set of independent smoke detectors.
   872	-- Any one of them going off stops the job.
   873	-- ═══════════════════════════════════════════════════════════════════════════
   874	CREATE TRIGGER IF NOT EXISTS guard_a_failing_review_stops_it
   875	BEFORE UPDATE OF status ON jobs
   876	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   877	BEGIN
   878	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
   879	    WHERE EXISTS (
   880	        SELECT 1 FROM verdicts v
   881	        WHERE v.job_id = NEW.id AND v.verdict = 'fail'
   882	          -- gate 3: a fail condemns the VERSION it reviewed, not the job forever.
   883	          -- A fail with no version condemned we-don't-know-what: it blocks
   884	          -- everything. Same if the job itself is unversioned. Fail-closed.
   885	          AND (NEW.head_version IS NULL
   886	               OR v.reviewed_version IS NULL
   887	               OR v.reviewed_version = NEW.head_version)
   888	    );
   889	END;
   890	
