    58	def _guarded(fn):
    59	    """Translate the schema's RAISE(ABORT, 'guard: ...') into GuardViolation."""
    60	
    61	    def wrapper(*args, **kwargs):
    62	        try:
    63	            return fn(*args, **kwargs)
    64	        except sqlite3.IntegrityError as exc:
    65	            if "guard:" in str(exc):
   274	def record_verdict(
   275	    conn: sqlite3.Connection,
   276	    job_id: int,
   277	    reviewer_seat: str,
   278	    verdict: str,
   279	    severity: str | None = None,
   280	    summary: str | None = None,
   281	    detail: str | None = None,
   282	    role: str = "reviewer",
   283	    reviewed_version: str | None = None,
   284	) -> int:
   285	    """Record one seat's verdict.
   286	
   287	    role='reviewer' reads the diff and judges it.
   288	    role='tester'   drove the app (Playwright) and judges what it observed. Two guards
   289	                    apply: it must cite captured artifacts, and its family must differ
   290	                    from the builder's — Playwright stops a tester fabricating what
   291	                    happened; only a different mind stops it rationalizing it.
   292	
   293	    reviewed_version is WHAT the reviewer looked at. The gauntlet runner pins the
   294	    version before handing work to a reviewer and must pass it explicitly. When
   295	    omitted, it defaults to the job's current head_version — correct only when
   296	    nothing moved between review and recording, which the runner must guarantee.
   297	    A verdict whose version stops matching the job simply stops counting.
   298	
   299	    tier and family are snapshotted from the seat at write time, so re-tiering or
   300	    re-pointing a seat later cannot retroactively legitimize a job.
   301	    """
   302	    row = seat(conn, reviewer_seat)
   303	    if row is None:
   304	        raise ValueError(f"unknown seat: {reviewer_seat}")
   305	
   306	    if reviewed_version is None:
   307	        job_row = conn.execute(
   308	            "SELECT head_version FROM jobs WHERE id = ?", (job_id,)
   309	        ).fetchone()
   310	        if job_row is not None:
   311	            reviewed_version = job_row["head_version"]
   312	
   313	    cur = conn.execute(
   314	        """
   315	        INSERT INTO verdicts
   316	            (job_id, reviewer_seat, reviewer_tier, role, model_family,
   317	             verdict, severity, summary, detail, reviewed_version)
   318	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
   319	        """,
   320	        (job_id, reviewer_seat, row["tier"], role, row["family"],
   321	         verdict, severity, summary, detail, reviewed_version),
   322	    )
   323	    return int(cur.lastrowid)
   324	
   325	
   326	def resolve_escalation(conn: sqlite3.Connection, verdict_id: int, verdict: str) -> None:
   327	    """Answer a needs_human verdict so the job can proceed (§6 human review queue)."""
   328	    if verdict not in ("pass", "fail"):
   329	        raise ValueError("an escalation resolves to 'pass' or 'fail'")
   330	    conn.execute("UPDATE verdicts SET verdict = ? WHERE id = ?", (verdict, verdict_id))
   331	
   332	
   333	# --------------------------------------------------------------------------
   334	# Reporting — this is what the voice layer reads back
   335	# --------------------------------------------------------------------------
   336	def overnight_report(conn: sqlite3.Connection, since: str = "-1 day") -> list[sqlite3.Row]:
   337	    """Answers spec §7's 'what did the overnight run do?'"""
   338	    return conn.execute(
   339	        """
   340	        SELECT * FROM job_report
   341	         WHERE created_at >= datetime('now', ?)
   342	         ORDER BY id
   343	        """,
   344	        (since,),
   345	    ).fetchall()
   346	
   347	
   348	def spend_today(conn: sqlite3.Connection, seat_id: str) -> int:
   349	    row = conn.execute(
   350	        "SELECT COALESCE(SUM(cost_cents), 0) AS c FROM usage WHERE seat_id = ? AND day = date('now')",
   351	        (seat_id,),
   352	    ).fetchone()
   353	    return int(row["c"])
   354	
   355	
   356	def over_budget(conn: sqlite3.Connection, seat_id: str) -> bool:
   357	    """True if this seat has hit its daily cap.
   358	
   359	    OpenClaw has no per-agent budget of any kind, so the harness must check this
   360	    before dispatching. Uncapped seats (daily_cap_cents IS NULL) never block.
   361	    """
   362	    row = seat(conn, seat_id)
   363	    if row is None or row["daily_cap_cents"] is None:
   364	        return False
   365	    return spend_today(conn, seat_id) >= int(row["daily_cap_cents"])
   366	
   367	
   368	@_guarded
   369	def record_usage(
   370	    conn: sqlite3.Connection,
   371	    seat_id: str,
   372	    cost_cents: int,
   373	    job_id: int | None = None,
   374	    input_tokens: int = 0,
   375	    output_tokens: int = 0,
   376	    role: str = "build",
   377	) -> None:
   378	    """Record spend. The DATABASE refuses an entry that would breach the daily cap.
   379	
   380	    This used to be a Python check before dispatch — which Sol correctly called a
   381	    race (two dispatches both pass the check before either records spend) and easily
   382	    bypassed by any direct write. The ledger itself now says no.
   383	    """
   384	    conn.execute(
   385	        """
   386	        INSERT INTO usage (seat_id, job_id, role, input_tokens, output_tokens, cost_cents)
   387	        VALUES (?, ?, ?, ?, ?, ?)
   388	        """,
   389	        (seat_id, job_id, role, input_tokens, output_tokens, cost_cents),
   390	    )
   391	
   392	
   393	def can_build(conn: sqlite3.Connection, seat_id: str) -> bool:
   394	    """Has this seat used up its BUILDING budget? (It may still be able to review.)"""
   395	    row = seat(conn, seat_id)
   396	    if row is None or row["build_cap_cents"] is None:
   397	        return True
   398	    spent = conn.execute(
   399	        "SELECT COALESCE(SUM(cost_cents),0) c FROM usage "
   400	        "WHERE seat_id=? AND day=date('now') AND role='build'", (seat_id,)
   401	    ).fetchone()["c"]
   402	    return int(spent) < int(row["build_cap_cents"])
   403	
   404	
   405	# ---------------------------------------------------------------------------
   406	# The money
   407	# ---------------------------------------------------------------------------
   408	def month_spend(conn: sqlite3.Connection) -> dict[str, int]:
   409	    """What have we spent this month, and how close are we?"""
   410	    r = conn.execute("SELECT * FROM month_spend").fetchone()
   676	CREATE TRIGGER IF NOT EXISTS guard_panel_size_is_fixed
   677	BEFORE UPDATE OF required_reviews ON jobs
   678	WHEN OLD.required_reviews > 0 AND NEW.required_reviews < OLD.required_reviews
   679	BEGIN
   680	    SELECT RAISE(ABORT, 'guard: the panel cannot be shrunk after dispatch');
   681	END;
   682	
   683	-- A verdict, once written, is a fact. It cannot be edited into a pass.
   684	-- (Sol #2 — every verdict guard checked INSERT only, so you could rewrite the row.)
   685	CREATE TRIGGER IF NOT EXISTS guard_verdicts_are_append_only
   686	BEFORE UPDATE ON verdicts
   687	WHEN OLD.verdict <> NEW.verdict
   688	     AND NOT (OLD.verdict = 'needs_human' AND NEW.verdict IN ('pass','fail'))
   689	BEGIN
   690	    SELECT RAISE(ABORT, 'guard: a verdict cannot be rewritten — only an escalation may be answered');
   691	END;
   692	
   693	CREATE TRIGGER IF NOT EXISTS guard_verdict_identity_is_frozen
   694	BEFORE UPDATE ON verdicts
   695	WHEN OLD.role <> NEW.role OR OLD.model_family <> NEW.model_family
   696	  OR OLD.reviewer_seat <> NEW.reviewer_seat OR OLD.reviewer_tier <> NEW.reviewer_tier
   697	BEGIN
   698	    SELECT RAISE(ABORT, 'guard: who reviewed this cannot be rewritten after the fact');
   699	END;
   700	
   701	-- ═══════════════════════════════════════════════════════════════════════════
   702	-- THE REVIEW-TO-VERSION CHAIN (Sol build gate 3, 2026-07-20).
   703	--
   704	-- Sol's most dangerous flaw: "approve version A, builder changes it to B, the old
   705	-- approval still counts — believable green checks on code nobody reviewed."
   706	--
   707	-- The fix is not another approval ceremony; it is arithmetic. A verdict carries the
   708	-- version it reviewed. A job carries the version it is putting forward. Completion
   709	-- guards only count verdicts whose versions MATCH — so moving the code voids the
   710	-- approvals by construction, nothing needs to remember to revoke anything. And a
   711	-- FAIL condemns the version it saw, not the job forever: fix the code, the version
   712	-- changes, the old fail becomes history. (A fail with no recorded version blocks
   713	-- everything — fail-closed, because it condemned we-don't-know-what.)
   714	-- ═══════════════════════════════════════════════════════════════════════════
   715	
   716	-- A versioned job accepts no unversioned verdicts. (Unversioned legacy jobs keep
   717	-- their old semantics; the gatekeeper will not push anything unversioned anyway.)
   718	CREATE TRIGGER IF NOT EXISTS guard_verdict_must_cite_what_it_reviewed
   719	BEFORE INSERT ON verdicts
   720	WHEN (SELECT head_version FROM jobs WHERE id = NEW.job_id) IS NOT NULL
   721	     AND TRIM(COALESCE(NEW.reviewed_version, '')) = ''
   722	BEGIN
   723	    SELECT RAISE(ABORT, 'guard: this job is versioned — a verdict must say which version it reviewed');
   724	END;
   725	
   726	-- A build cannot finish without declaring WHICH code is finished.
   727	CREATE TRIGGER IF NOT EXISTS guard_a_build_finishes_a_version
   728	BEFORE UPDATE OF status ON jobs
   729	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   730	     AND NEW.kind = 'build'
   731	     AND TRIM(COALESCE(NEW.head_version, '')) = ''
   732	BEGIN
   733	    SELECT RAISE(ABORT, 'guard: a build cannot finish without naming the exact version that is finished');
   734	END;
   735	
   736	-- Once finished, WHAT finished is history. Rewriting head_version after done would
   737	-- let approved-hash-A ship as hash-B while every record still looks green.
   738	CREATE TRIGGER IF NOT EXISTS guard_finished_version_is_frozen
   739	BEFORE UPDATE OF head_version ON jobs
   740	WHEN OLD.status IN ('done', 'shipped') AND OLD.head_version IS NOT NEW.head_version
   741	BEGIN
   742	    SELECT RAISE(ABORT, 'guard: what version finished cannot be rewritten after the fact');
   743	END;
   744	
   745	-- A verdict cannot be DELETED. (Sol, round 3 — verified 2026-07-14.)
   746	--
   747	-- "Append-only" was enforced only against UPDATE, so a failing review that couldn't be
   748	-- EDITED into a pass could simply be DELETED — after which guard_a_failing_review_stops_it
   749	-- (which asks "does a fail EXIST?") saw nothing and let the job complete. Confirmed with a
   750	-- live exploit: fail deleted, then done. A verdict is a fact; facts are not retractable.
   751	CREATE TRIGGER IF NOT EXISTS guard_verdicts_cannot_be_deleted
   752	BEFORE DELETE ON verdicts
   753	BEGIN
   754	    SELECT RAISE(ABORT, 'guard: a verdict is a fact on the record — it cannot be deleted');
   755	END;
   756	
   757	-- A reviewer cannot LIE about who it is. (Sol #4 — the DB took the row's word for it.)
   758	CREATE TRIGGER IF NOT EXISTS guard_reviewer_identity_must_be_real
   759	BEFORE INSERT ON verdicts
   760	WHEN NEW.reviewer_tier <> (SELECT tier FROM seats WHERE id = NEW.reviewer_seat)
   761	  OR NEW.model_family  <> (SELECT family FROM seats WHERE id = NEW.reviewer_seat)
   762	BEGIN
   763	    SELECT RAISE(ABORT, 'guard: a reviewer cannot misrepresent its own tier or family');
   764	END;
   765	
   766	-- Build evidence can only come from the harness. (Sol #9 — the DB accepted a
   767	-- model-captured screenshot; only the Python helper refused.)
   768	CREATE TRIGGER IF NOT EXISTS guard_models_cannot_forge_evidence
   769	BEFORE INSERT ON artifacts
   770	WHEN NEW.captured_by = 'model' AND NEW.kind NOT IN ('source', 'quote')
   771	BEGIN
   772	    SELECT RAISE(ABORT, 'guard: a model may cite a source but may not produce build evidence');
   773	END;
   774	
   775	-- ===========================================================================
   776	-- GUARD 1 — local output never ships unreviewed (§4.3, §9)
   777	-- Now reads the SNAPSHOT (builder_tier), not the live seat.
   778	-- ===========================================================================
   779	CREATE TRIGGER IF NOT EXISTS guard_local_output_needs_review
   780	BEFORE UPDATE OF status ON jobs
   781	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   782	     AND NEW.builder_tier = 'local'
   783	BEGIN
   784	    SELECT RAISE(ABORT, 'guard: local-built job requires a passing subscription-tier review before done')
   785	    WHERE NOT EXISTS (
   786	        SELECT 1 FROM verdicts v
   787	        WHERE v.job_id = NEW.id
   788	          AND v.reviewer_tier IN ('subscription', 'metered')
   789	          AND v.verdict = 'pass'
   790	          -- gate 3: a pass only counts for the version it actually reviewed
   791	          AND v.reviewed_version IS NEW.head_version
   792	    );
   793	END;
   794	
   795	-- ===========================================================================
   796	-- GUARD 2 — escalations must be answered, not outrun (§6)
   797	-- ===========================================================================
   798	CREATE TRIGGER IF NOT EXISTS guard_unresolved_escalation
   799	BEFORE UPDATE OF status ON jobs
   800	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   801	BEGIN
   802	    SELECT RAISE(ABORT, 'guard: job has an unresolved needs_human verdict')
   803	    WHERE EXISTS (
   804	        SELECT 1 FROM verdicts v WHERE v.job_id = NEW.id AND v.verdict = 'needs_human'
   805	    );
   806	END;
   807	
   808	-- ===========================================================================
   809	-- GUARD 3 — a tester's verdict must cite REAL BUILD EVIDENCE.
   810	--
   840	END;
   841	
   842	-- ===========================================================================
   843	-- GUARD 5 — the full panel, always. DISTINCT reviewers.
   844	--
   845	-- ⚠️ Sol #7: "The full panel can be faked with duplicate passes." It counted ROWS.
   846	-- One reviewer could pass the same job six times. Now it counts distinct seats.
   847	-- ===========================================================================
   848	CREATE TRIGGER IF NOT EXISTS guard_full_panel
   849	BEFORE UPDATE OF status ON jobs
   850	WHEN NEW.status = 'done' AND OLD.status <> 'done' AND NEW.required_reviews > 0
   851	BEGIN
   852	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
   853	    WHERE (
   854	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
   855	        -- the panel could be "filled" by the wrong kinds of check entirely.
   856	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
   857	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   858	          -- gate 3: the panel must have reviewed THIS version, not an earlier one
   859	          AND v.reviewed_version IS NEW.head_version
   860	    ) < NEW.required_reviews;
   861	END;
   862	
   863	-- ═══════════════════════════════════════════════════════════════════════════
   864	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   865	--
   866	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
   867	-- serious failure satisfied it. A reviewer could scream that the thing was broken and
   868	-- be outvoted by colleagues who hadn't noticed.
   869	--
   870	-- That is the opposite of what a gauntlet is FOR. One reviewer finding a real bug is
   871	-- the whole point — it isn't a democracy, it's a set of independent smoke detectors.
   872	-- Any one of them going off stops the job.
   873	-- ═══════════════════════════════════════════════════════════════════════════
   874	CREATE TRIGGER IF NOT EXISTS guard_a_failing_review_stops_it
   875	BEFORE UPDATE OF status ON jobs
   876	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   877	BEGIN
   878	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
   879	    WHERE EXISTS (
   880	        SELECT 1 FROM verdicts v
   881	        WHERE v.job_id = NEW.id AND v.verdict = 'fail'
   882	          -- gate 3: a fail condemns the VERSION it reviewed, not the job forever.
   883	          -- A fail with no version condemned we-don't-know-what: it blocks
   884	          -- everything. Same if the job itself is unversioned. Fail-closed.
   885	          AND (NEW.head_version IS NULL
   886	               OR v.reviewed_version IS NULL
   887	               OR v.reviewed_version = NEW.head_version)
   888	    );
   889	END;
   890	
   891	-- Sol, round 2, #6: an objection raised AFTER 'done' could still be outrun, because
   892	-- the escalation guard only fired on the transition INTO done — not on done -> shipped.
   893	CREATE TRIGGER IF NOT EXISTS guard_late_escalation_still_blocks_shipping
   894	BEFORE UPDATE OF status ON jobs
   895	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   896	BEGIN
   897	    SELECT RAISE(ABORT, 'guard: someone raised an objection — it has to be answered first')
   898	    WHERE EXISTS (
   899	        SELECT 1 FROM verdicts v
   900	        WHERE v.job_id = NEW.id
   901	          AND (v.verdict = 'needs_human'  -- an unanswered question blocks, always
   902	               -- gate 3: a fail blocks the version it condemned (fail-closed when
   903	               -- either side is unversioned)
   904	               OR (v.verdict = 'fail'
   905	                   AND (NEW.head_version IS NULL
   906	                        OR v.reviewed_version IS NULL
   907	                        OR v.reviewed_version = NEW.head_version)))
   908	    );
   909	END;
   910	
   911	-- Sol, round 2, #4: evidence could be an EMPTY STRING. A path of '' satisfied
   912	-- "COALESCE(path, value) IS NOT NULL" perfectly well.
   913	CREATE TRIGGER IF NOT EXISTS guard_evidence_cannot_be_empty
   914	BEFORE INSERT ON artifacts
   915	WHEN TRIM(COALESCE(NEW.path, NEW.value, '')) = ''
   970	-- ledger itself refuses the entry that would breach the cap.
   971	-- ===========================================================================
   972	CREATE TRIGGER IF NOT EXISTS guard_no_negative_spend
   973	BEFORE INSERT ON usage
   974	WHEN NEW.cost_cents < 0
   975	BEGIN
   976	    SELECT RAISE(ABORT, 'guard: spend cannot be negative — no unwinding the meter');
   977	END;
   978	
   979	CREATE TRIGGER IF NOT EXISTS guard_daily_cap_is_hard
   980	BEFORE INSERT ON usage
   981	BEGIN
   982	    SELECT RAISE(ABORT, 'guard: this seat is over its daily cap')
   983	    WHERE (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
   984	      AND (
   985	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
   986	         WHERE seat_id = NEW.seat_id AND day = date('now')
   987	      ) + NEW.cost_cents
   988	      > (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id);
   989	END;
   990	
   991	-- Ration the EXPENSIVE work separately. A seat can be generous on reviewing and
   992	-- stingy on building — which is exactly how you want a metered seat to behave when
   993	-- you already pay flat-rate for two better builders.
   994	CREATE TRIGGER IF NOT EXISTS guard_build_cap_is_hard
   995	BEFORE INSERT ON usage
   996	WHEN NEW.role = 'build'
   997	BEGIN
   998	    SELECT RAISE(ABORT, 'guard: this seat has used up its building budget for today — it can still review')
   999	    WHERE (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1000	      AND (
  1001	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1002	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role = 'build'
  1003	      ) + NEW.cost_cents
  1004	      > (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id);
  1005	END;
  1006	
  1007	CREATE TRIGGER IF NOT EXISTS guard_review_cap_is_hard
  1008	BEFORE INSERT ON usage
  1009	WHEN NEW.role IN ('review', 'test')
  1010	BEGIN
  1011	    SELECT RAISE(ABORT, 'guard: this seat is over its reviewing budget for today')
  1012	    WHERE (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1013	      AND (
  1014	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1015	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role IN ('review','test')
  1016	      ) + NEW.cost_cents
  1017	      > (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id);
  1018	END;
  1019	
  1020	-- Keep updated_at honest.
  1021	CREATE TRIGGER IF NOT EXISTS jobs_touch_updated_at
  1022	AFTER UPDATE ON jobs
    85	// expensive to reverse. Everything else runs light or standard. See tiering.py — the
    86	// escalation is a RULE, not a vibe, and every job records which tier it got AND WHY.
    87	// ═══════════════════════════════════════════════════════════════════════════
    88	
    89	[seats.brain]
    90	provider = "codex"
    91	model = "gpt-5.6-sol"
    92	tier = "subscription"
    93	
    94	// Owner: "Sol needs to be the brain, but prolly doesn't need to be ultra for most
    95	// convos. Maybe if it's managing a major spec and deciding builds and such, but
    96	// generally lower effort in convo."
    97	//
    98	// Measured, and he's right: Sol at FULL effort took over FIVE MINUTES on a real
    99	// question. In a conversation that isn't thorough — it's a hang. Claude at ~8s gave a
   100	// genuinely better answer. So Sol's heavy tier is reserved for what it's actually for:
   101	// specs, architecture, and pushback.
   102	model_light    = "gpt-5.6-luna"             // quick takes
   103	model_standard = "gpt-5.6-terra"            // most work
   104	model_heavy    = "gpt-5.6-sol"              // specs, decisions, pushback. EARNED.
   105	effort_light    = "low"
   106	effort_standard = "medium"
   107	effort_heavy    = "high"
   108	
   109	mode = "ultra"                              // ONLY at heavy. Coordinated subagents.
   110	max_threads = 6                             // spec said 8; the real default is 6
   111	max_depth = 1
   112	notes = "OAuth is TOLERATED, not sanctioned. Most likely seat to break. Keep API-key swap ready."
   113	
   114	// ---------------------------------------------------------------------------
   115	// WORKHORSE — volume autonomous coding. Migrations, refactors, test backfills.
   116	//
   117	// OWNER DECISION (2026-07-13): OpenAI, not Claude. Rationale below — and note the
   118	// reason is NOT the one in the spec.
   119	//
   120	// ⚠️ THE SPEC'S REASON IS WRONG. It says Claude headless draws from a metered credit
   121	// pool. It does NOT — Anthropic announced that, then PAUSED it before it took effect.
   122	// `claude -p` runs on normal subscription limits TODAY. Claude-as-workhorse would not
   123	// cost extra dollars.
   124	//
   125	// ✅ THE REAL REASON, which nobody had written down: RATE LIMITS, not cost. Running a
   126	// workhorse hard (unattended overnight builds, migrations, backfills) burns Max plan
   127	// usage caps — and it's the SAME bucket as interactive use. The failure mode is nasty:
   128	// your autonomous builder silently eats the model you were going to review its work
   129	// with. So Claude stays OUT of the high-volume seat, and stays IN as low-volume
   130	// escalation (see [seats.reviewer]).
   131	//
   132	// GPT-5.6-sol is not a consolation prize here: 88.8% Terminal-Bench 2.1 (91.9% Ultra),
   133	// SOTA for agentic coding. Flat subscription, predictable, bounded.
   134	//
   135	// For the record, since it may matter on the Studio later:
   136	//     Claude Opus  87.6% SWE-bench Verified   (best autonomous coder available)
   137	//     GPT-5.6-sol  64.6% SWE-bench Pro / 88.8% Terminal-Bench  (top-tier agentic)
   138	//     Grok Build   70.8% SWE-bench Verified   (weak model, great harness)
   139	// ---------------------------------------------------------------------------
   140	[seats.workhorse]
   141	provider = "codex"
   142	model = "gpt-5.6-sol"
   143	tier = "subscription"
   144	worktree_isolated = true
   145	
   146	model_light    = "gpt-5.6-luna"             // scaffolding, boilerplate, first drafts
   147	model_standard = "gpt-5.6-terra"            // the bulk of real building
   148	model_heavy    = "gpt-5.6-sol"              // auth, money, data, or it failed twice
   149	notes = "OpenAI sub. Shares auth with [seats.brain] — see CONCENTRATION RISK below."
   150	
   151	// The Claude builders — Riggs (backend), Finn (frontend), Nova (glue). Same lanes,
   152	// same memory, tiered the same way. Opus is the best coder we own (87.6% SWE-bench);
   153	// it is also the one most likely to burn a weekly cap, so it is EARNED like the rest.
   154	[seats.riggs]
   155	provider = "claude-cli"
   156	model = "claude-opus-4-8"
   157	family = "claude"
   158	tier = "subscription"
   159	model_light    = "claude-haiku-4-5"
   160	model_standard = "claude-sonnet-5"
   161	model_heavy    = "claude-opus-4-8"          // the best coder we have. EARNED.
   162	notes = "Backend lane. Memory belongs to the LANE, not the model — swap the model, keep the scars."
   163	
   164	// ---------------------------------------------------------------------------
   165	// GROK — builder + cross-family reviewer.
   166	//
   167	// ⚠️ TWO EARLIER CLAIMS OF MINE WERE WRONG. Correcting both, on the record:
   168	//
   169	//   1. "Grok Build is weak (70.8% SWE-bench)." FALSE. That was grok-build-0.1, a
   170	//      legacy option nobody runs. Grok Build now DEFAULTS to grok-4.5. On a single
   171	//      consistent agentic-coding index: Grok 4.5 = 76, Codex = 76, Claude Code = 78.
   172	//      It is not the weak sibling. It matches Codex at ~half the cost/task ($2.49).
   173	//
   174	//   2. "The 403 is a Heavy-only tier gate." FALSE. It's an UNDISCLOSED MONTHLY QUOTA
   175	//      on standard SuperGrok. The 403 body lies — it says "you do not have an active
   200	//     BUILD on the seats you already pay for.
   201	//     REVIEW on the metered one, because reviewing is cheap.
   202	//
   203	// Which lands Grok exactly where it's most valuable anyway. Its worth was never being
   204	// the strongest coder — it isn't. It's being a DIFFERENT MIND that catches what Claude
   205	// and GPT both miss. And that job costs pennies.
   206	[seats.grok]
   207	provider = "xai"
   208	model = "grok-4.5"                          // NOT grok-build-0.1 (legacy, weak)
   209	tier = "subscription"                       // $30 SuperGrok, primary
   210	family = "grok"
   211	worktree_isolated = true
   212	daily_cap_cents  = 100                      // $1/day = ~$30/mo HARD CEILING
   213	build_cap_cents  = 25                       // ~25c/day of building — a RATION
   214	review_cap_cents = 75                       // reviewing is cheap; let it look at everything
   215	notes = "Reviews freely. Builds sparingly. Sub primary, API fallback."
   216	
   217	  // Failover target. Same model, metered. This is what makes the hidden quota a
   218	  // speed bump instead of a dead stop.
   219	  [seats.grok.fallback]
   220	  provider = "xai-api"
   221	  auth = "XAI_API_KEY"
   222	  tier = "metered"
   223	  notes = "Engages when the sub 403s. Capped by daily_cap_cents above."
   224	
   225	// ---------------------------------------------------------------------------
   226	// FREE GRINDER — the local junior. Overnight scaffolding, boilerplate, first drafts.
   227	// Sized for 16 GB. A junior dev, and treated as one: guard 1 in schema.sql makes it
   228	// STRUCTURALLY IMPOSSIBLE for its output to reach `done` unreviewed.
   229	// ---------------------------------------------------------------------------
   230	[seats.grinder_local]
   231	provider = "ollama"
   232	model = "qwen2.5-coder:7b"
   233	tier = "local"
   234	endpoint = "http://127.0.0.1:11434"
   235	notes = "Bump to qwen3-coder:30b on the Studio (§8 phase 5). One line."
   236	
   237	// ---------------------------------------------------------------------------
   238	// REVIEWER — escalation only. Highest judgment: architecture calls, contested
   239	// verdicts, the bug the local model looped on three times.
   240	//
   241	// Claude stays in the hierarchy HERE, deliberately. At escalation volume (a handful
   242	// of calls a day) it will not dent the Max rate limits that disqualify it from the
   243	// workhorse seat — and it is already paid for.
   244	//
   245	// It earns its seat twice over: it is the strongest model on the board (87.6%
   246	// SWE-bench Verified), AND it is a FOURTH model family in the gauntlet. §6 exists
   247	// because different models miss different bugs. Claude catching what GPT and Grok
   248	// both missed is the entire point of keeping it.
   249	//
   250	// Per spec §4.4 this seat is optional and droppable — the system must run without it.
   251	// Never at the mouth: claude-cli spawns a subprocess per call (3-5s).
   252	// ---------------------------------------------------------------------------
   253	[seats.reviewer]
   254	provider = "claude-cli"                     // sanctioned path; subscription OAuth is NOT
   255	model = "claude-opus-4-8"
   256	tier = "subscription"                       // NOT credits — the pool was paused, never shipped
   257	optional = true
   258	max_calls_per_day = 25                      // keeps escalation from eating interactive headroom
   259	
   260	// Owner: "Reviewers prolly need to be opus and one model down for ChatGPT, unless we
   261	// say to go high review or we have a good trigger to do higher reviews."
   262	//
   263	// THE RULE: A REVIEWER IS NEVER WEAKER THAN THE BUILDER. A junior checking a senior's
   264	// work is theatre — it produces a green tick and no safety. So review tier FLOORS at
   265	// whatever tier built the thing. And reviews are cheap anyway (read-heavy, ~1/10th the
   266	// tokens of a build), so generosity here costs far less than generosity on the build.
