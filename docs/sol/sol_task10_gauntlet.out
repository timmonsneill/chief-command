   552	-- ---------------------------------------------------------------------------
   553	-- Usage: per-seat spend, so the caps in `seats` mean something.
   554	-- OpenClaw core has NO per-agent cost or token budget. This is ours.
   555	-- ---------------------------------------------------------------------------
   556	CREATE TABLE IF NOT EXISTS usage (
   557	    id            INTEGER PRIMARY KEY,
   558	    seat_id       TEXT NOT NULL REFERENCES seats(id),
   559	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   560	    -- What kind of work this spend was. Lets us ration building separately from
   561	    -- reviewing — the whole point of the per-role caps above.
   562	    role          TEXT NOT NULL DEFAULT 'build'
   563	                  CHECK (role IN ('build', 'review', 'test', 'research', 'voice')),
   564	    day           TEXT NOT NULL DEFAULT (date('now')),
   565	    input_tokens  INTEGER NOT NULL DEFAULT 0,
   566	    output_tokens INTEGER NOT NULL DEFAULT 0,
   567	    cost_cents    INTEGER NOT NULL DEFAULT 0,
   568	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   569	);
   570	
