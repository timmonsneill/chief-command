  1028	-- ---------------------------------------------------------------------------
  1029	-- The §7 voice query: "what did the overnight run do?"
  1030	-- ---------------------------------------------------------------------------
  1031	CREATE VIEW IF NOT EXISTS job_report AS
  1032	SELECT
  1033	    j.id,
  1034	    j.created_at,
  1035	    j.finished_at,
  1036	    j.request,
  1037	    j.origin,
  1038	    j.builder_seat,
  1039	    s.provider   AS builder_provider,
  1040	    s.tier       AS builder_tier,
  1041	    j.status,
  1042	    j.branch,
  1043	    j.spoken_summary,
  1044	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id)                        AS review_count,
  1045	    (SELECT COUNT(DISTINCT v.model_family) FROM verdicts v WHERE v.job_id = j.id)  AS families_reviewed,
  1046	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id AND v.verdict = 'fail') AS fail_count,
  1047	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id AND v.verdict = 'needs_human') AS escalations
  1048	FROM jobs j
  1049	JOIN seats s ON s.id = j.builder_seat;
