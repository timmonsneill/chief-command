   572	CREATE INDEX IF NOT EXISTS idx_usage_month ON usage(day);
   573	
   574	-- ═══════════════════════════════════════════════════════════════════════════
   575	-- THE MONEY. Owner (2026-07-14): "$100/mo limit, notify me at $50."
   576	--
   577	-- TWO LAYERS, deliberately:
   578	--
   579	--   1. OpenAI's OWN monthly budget cap ($100), set in their dashboard. That is the
   580	--      REAL ceiling — it physically stops them serving requests, and no bug in this
   581	--      codebase can defeat it. It is also a terrible way to find out, because it
   582	--      cuts you off mid-sentence.
   583	--
   584	--   2. THIS. A softer, earlier layer that warns at $50 and refuses to spend past a
   585	--      budget we set ourselves — so we stop gracefully, say why, and never hit
   586	--      their wall at all.
   587	--
   588	-- Belt and braces. The dashboard cap is the thing that saves you if I'm wrong.
   589	-- ═══════════════════════════════════════════════════════════════════════════
   590	CREATE TABLE IF NOT EXISTS budget (
   591	    id              INTEGER PRIMARY KEY CHECK (id = 1),   -- exactly one row
   592	    monthly_cap_cents  INTEGER NOT NULL DEFAULT 10000,    -- $100
   593	    warn_at_cents      INTEGER NOT NULL DEFAULT 5000,     -- $50
   594	    warned_this_month  TEXT,                              -- 'YYYY-MM' so we warn once
   595	    updated_at         TEXT NOT NULL DEFAULT (datetime('now'))
   596	);
   597	
   598	INSERT OR IGNORE INTO budget (id, monthly_cap_cents, warn_at_cents) VALUES (1, 10000, 5000);
   599	
   600	-- The month's spend, all seats. This is the number that matters.
   601	CREATE VIEW IF NOT EXISTS month_spend AS
   602	SELECT
   603	    COALESCE(SUM(cost_cents), 0)                                   AS spent_cents,
   604	    (SELECT monthly_cap_cents FROM budget WHERE id = 1)            AS cap_cents,
   605	    (SELECT warn_at_cents     FROM budget WHERE id = 1)            AS warn_cents
   606	FROM usage
   607	WHERE strftime('%Y-%m', day) = strftime('%Y-%m', 'now');
   608	
   609	-- ═══════════════════════════════════════════════════════════════════════════
   610	-- GUARD 11 — the month's budget is hard. It refuses the entry that would breach it.
   611	--
   612	-- Same principle as every other guard here: this is not a policy an agent is asked
   613	-- to respect, it is a write that fails.
   614	-- ═══════════════════════════════════════════════════════════════════════════
   615	CREATE TRIGGER IF NOT EXISTS guard_monthly_budget_is_hard
   616	BEFORE INSERT ON usage
   617	BEGIN
   618	    SELECT RAISE(ABORT, 'guard: this would blow the monthly budget')
   619	    WHERE (SELECT spent_cents FROM month_spend) + NEW.cost_cents
   620	        > (SELECT monthly_cap_cents FROM budget WHERE id = 1);
   621	END;
   622	
   623	-- ===========================================================================
   624	-- THE GUARDS
   625	--
  1020	-- Keep updated_at honest.
  1021	CREATE TRIGGER IF NOT EXISTS jobs_touch_updated_at
  1022	AFTER UPDATE ON jobs
  1023	FOR EACH ROW
  1024	BEGIN
  1025	    UPDATE jobs SET updated_at = datetime('now') WHERE id = NEW.id;
  1026	END;
