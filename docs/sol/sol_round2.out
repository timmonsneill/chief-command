   246	-- ═══════════════════════════════════════════════════════════════════════════════
   247	-- CAPABILITIES — what an agent is PHYSICALLY ALLOWED to do.
   248	--
   249	-- This exists because Sol reviewed the architecture and demolished the previous
   250	-- safety story. The plan had been: the voice can act fast, and Chief watches and
   251	-- kills anything dumb. Sol's verdict:
   252	--
   253	--     "'Builders take minutes' measures how long they take to FINISH. What matters
   254	--      is how long they take to do their FIRST DAMAGING THING. That can be seconds.
   255	--      Chief and the builder would be RACING. There is no guarantee Chief wins."
   256	--
   257	--     "A fast supervisor is still only a fast witness if the builder can act first."
   258	--
   259	--     "A smarter model is not a security boundary."
   260	--
   261	-- He's right, and it's the difference between a bank with a vault and a bank with an
   262	-- attentive guard. You do not stop a robbery by watching carefully.
   263	--
   264	-- SO: agents get NO dangerous powers. Not "Chief will stop them" — THEY CANNOT.
   265	-- Reading code, writing code in their own worktree, running tests: always fine, and
   266	-- that's 95% of the work. Everything that touches the real world is denied by
   267	-- default and needs a signed, single-use permission slip for that exact act.
   268	-- ═══════════════════════════════════════════════════════════════════════════════
   269	CREATE TABLE IF NOT EXISTS capabilities (
   270	    seat_id       TEXT NOT NULL REFERENCES seats(id) ON DELETE CASCADE,
   271	    capability    TEXT NOT NULL CHECK (capability IN (
   272	                      -- SAFE. Granted to every builder. This is the actual job.
   273	                      'read_code', 'write_worktree', 'run_tests', 'open_pr',
   274	                      -- DANGEROUS. Denied to everyone by default. Each needs a
   275	                      -- fresh, single-use approval naming the exact action.
   276	                      'touch_production', 'delete_data', 'run_migration',
   277	                      'deploy', 'merge_to_main', 'force_push',
   278	                      'read_secrets', 'send_external', 'spend_money'
   279	                  )),
   280	    PRIMARY KEY (seat_id, capability)
   281	);
   282	
   283	-- The safe set. Everything an agent needs to actually build software, and nothing
   284	-- that can hurt you. Note what ISN'T here — that's the whole point.
   285	CREATE VIEW IF NOT EXISTS safe_capabilities AS
   286	SELECT 'read_code' AS capability UNION ALL SELECT 'write_worktree'
   287	UNION ALL SELECT 'run_tests' UNION ALL SELECT 'open_pr';
   288	
   289	-- ═══════════════════════════════════════════════════════════════════════════════
   290	-- APPROVALS — a signed, single-use permission slip for ONE exact dangerous act.
   291	--
   292	-- Sol on why a "yes" cannot be trusted on its own:
   293	--
   294	--     Chief: "First make a backup, then remove the old accounts."
   295	--     Neill: "Yes — skip the first one."
   296	--
   297	--     "That LOOKS like a confirmation, but it changes the safe plan into a dangerous
   298	--      one. Sending it directly recreates the original classification problem."
   299	--
   300	-- So an approval is not a word. It is a ROW: a numbered, one-time permission for a
   301	-- specific action, with the consequence written out in plain English and READ BACK to
   302	-- Neill before he can agree. It expires the moment the plan changes.
   303	--
   304	--     "A bare 'yes' should never approve something that was not just read back
   305	--      exactly." — which also handles the fact that a car is a terrible place to be
   306	--      understood correctly.
   307	-- ═══════════════════════════════════════════════════════════════════════════════
   308	CREATE TABLE IF NOT EXISTS approvals (
   309	    id            INTEGER PRIMARY KEY,
   310	    job_id        INTEGER REFERENCES jobs(id) ON DELETE CASCADE,
   311	    capability    TEXT NOT NULL,            -- the ONE dangerous thing this permits
   312	    -- Exactly what will happen. Not a category — the actual act.
   313	    action        TEXT NOT NULL,            -- "delete 4,200 accounts inactive since 2024-01-01"
   314	    -- What Chief SAID OUT LOUD to Neill before he agreed. If this is empty, nothing
   315	    -- was read back, and a 'yes' means nothing.
   316	    read_back     TEXT NOT NULL,
   317	    -- Is this undoable, and how? Sol: "Anything irreversible needs a tested recovery
   318	    -- method BEFORE it starts."
   319	    reversible    INTEGER NOT NULL DEFAULT 0 CHECK (reversible IN (0,1)),
   320	    recovery      TEXT,                     -- "restore from the snapshot taken at 09:14"
   321	
   322	    granted_by    TEXT NOT NULL DEFAULT 'owner' CHECK (granted_by = 'owner'),
   323	    granted_at    TEXT,
   324	    expires_at    TEXT NOT NULL,            -- short. Minutes, not hours.
   325	    used_at       TEXT,                     -- single use. Once spent, it's spent.
   326	    revoked_at    TEXT,
   327	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   328	);
   329	
   330	CREATE INDEX IF NOT EXISTS idx_approvals_job ON approvals(job_id);
   331	
   332	-- ═══════════════════════════════════════════════════════════════════════════════
   333	-- GUARD 12 — a dangerous act needs a live, unused, read-back approval.
   334	-- No approval, no action. Not "Chief said it was fine" — a signed slip, or nothing.
   335	-- ═══════════════════════════════════════════════════════════════════════════════
   336	CREATE VIEW IF NOT EXISTS live_approvals AS
   337	SELECT * FROM approvals
   338	 WHERE granted_at IS NOT NULL
   339	   AND used_at    IS NULL
   340	   AND revoked_at IS NULL
   341	   AND expires_at > datetime('now')
   342	   AND TRIM(read_back) <> '';
   343	
   344	-- An approval may never be BORN granted. (Sol, round 3 — verified 2026-07-14.)
   345	--
   346	-- Every approval guard fired on UPDATE OF granted_at only — the exact "born done" hole
   347	-- Sol found on the jobs table in round 1, never applied here. Confirmed with a live
   348	-- exploit: an INSERT with granted_at already set, reversible=0 and no recovery plan sailed
   349	-- straight into the live_approvals view. An approval must be born ungranted and become
   350	-- granted through an UPDATE, where the read-back and recovery guards below actually fire.
   351	CREATE TRIGGER IF NOT EXISTS guard_no_approval_is_born_granted
   352	BEFORE INSERT ON approvals
   353	WHEN NEW.granted_at IS NOT NULL
   354	BEGIN
   355	    SELECT RAISE(ABORT, 'guard: an approval cannot be created already granted — it must be granted through a read-back');
   356	END;
   357	
   358	-- An approval cannot be granted without something having been read back.
   359	CREATE TRIGGER IF NOT EXISTS guard_no_approval_without_readback
   360	BEFORE UPDATE OF granted_at ON approvals
   361	WHEN NEW.granted_at IS NOT NULL AND TRIM(COALESCE(NEW.read_back, '')) = ''
   362	BEGIN
   363	    SELECT RAISE(ABORT, 'guard: nothing was read back to him — a yes to nothing is not a yes');
   364	END;
   365	
   366	-- An irreversible act cannot be approved without a recovery plan.
   367	-- Sol: "'Kill' must never be presented as 'undo.'"
   368	CREATE TRIGGER IF NOT EXISTS guard_irreversible_needs_a_way_back
   369	BEFORE UPDATE OF granted_at ON approvals
   370	WHEN NEW.granted_at IS NOT NULL AND NEW.reversible = 0
   371	     AND TRIM(COALESCE(NEW.recovery, '')) = ''
   372	BEGIN
   373	    SELECT RAISE(ABORT, 'guard: this cannot be undone and has no way back — not without a recovery plan');
   374	END;
   375	
   376	-- Single use. A permission slip is spent when it is used.
   377	CREATE TRIGGER IF NOT EXISTS guard_an_approval_is_used_once
   378	BEFORE UPDATE OF used_at ON approvals
   379	WHEN OLD.used_at IS NOT NULL
   380	BEGIN
   381	    SELECT RAISE(ABORT, 'guard: that permission was already spent');
   382	END;
