   216	
   217	def _for_speech(text: str) -> str:
   218	    """Belt and braces. Chief is told not to write markdown; models do it anyway, and
   219	    nobody should ever hear 'hash hash' or 'asterisk asterisk' read out loud."""
   220	    text = re.sub(r"^#+\s*", "", text, flags=re.MULTILINE)
   221	    text = re.sub(r"\*\*(.+?)\*\*", r"\1", text)
   222	    text = re.sub(r"`(.+?)`", r"\1", text)
   223	    text = re.sub(r"^\s*[-*]\s+", "", text, flags=re.MULTILINE)
   224	    text = re.sub(r"\n{2,}", " ", text)
   225	    return " ".join(text.split()).strip()
   225	) -> int:
   226	    """Record GROUND TRUTH.
   227	
   228	    Two kinds, and they have different rules about who may write them:
   229	
   230	    EVIDENCE OF A BUILD (screenshot, trace, logs, exit codes) — only the harness or
   231	    Playwright. NEVER a model. A model cannot fabricate a screenshot, which is what
   232	    makes "I ran it and it worked" unsayable.
   233	
   234	    EVIDENCE OF A CLAIM (source, quote) — a model MAY write these, because a
   235	    researcher's whole job is to hand you a URL you can go and read yourself. The
   236	    check isn't "who wrote it down", it's "can someone else go and look?" — which is
   237	    why a different family has to read the sources cold (guard 8).
   238	    """
   239	    _MODEL_MAY_CITE = {"source", "quote"}
   240	    if captured_by == "model" and kind not in _MODEL_MAY_CITE:
   241	        raise ValueError(
   242	            f"a model may cite a source, but it may not produce a '{kind}' — "
   243	            "build evidence is captured by the harness, never claimed by a model"
   244	        )
   245	    if captured_by not in ("harness", "playwright", "model"):
   246	        raise ValueError(f"unknown artifact origin: {captured_by}")
   247	    cur = conn.execute(
   248	        """
   249	        INSERT INTO artifacts (job_id, kind, path, value, flow, captured_by)
   250	        VALUES (?, ?, ?, ?, ?, ?)
   251	        """,
   252	        (job_id, kind, path, value, flow, captured_by),
   253	    )
   254	    return int(cur.lastrowid)
