   209	def _clean(raw: str) -> str:
   210	    """Codex echoes the prompt, then 'codex', then the answer, then 'tokens used'."""
   211	    if "\ncodex\n" in raw:
   212	        raw = raw.split("\ncodex\n")[-1]
   213	    raw = re.split(r"\ntokens used\n", raw)[0]
   214	    return raw.strip()
