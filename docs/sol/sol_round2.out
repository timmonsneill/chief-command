   157	def ask_chief(said: str, context: str = "", pushed_back: bool = False) -> dict[str, Any]:
   158	    """Everything Neill says comes through here. Chief decides.
   159	
   160	    Returns both a SPOKEN answer (short, for the voice) and the full text (for the log)
   161	    — the same two-channel split we use everywhere: fast in the ear, complete on screen.
   162	    """
   163	    call = tier_for_talk(said, pushed_back=pushed_back)
   164	    model = CHIEF_DEEP if call.tier == HEAVY else CHIEF_MODEL
   165	    effort = "high" if call.tier == HEAVY else "low"
   166	
   167	    prompt = CHIEF_PROMPT
   168	    if context:
   169	        prompt += f"\n\n## WHAT YOU WERE JUST TALKING ABOUT\n{context}"
   170	    prompt += f"\n\n## HE JUST SAID\n{said}"
   171	
   172	    t0 = time.time()
   173	    try:
   174	        out = subprocess.run(
   175	            ["codex", "exec", "--skip-git-repo-check", "-m", model,
   176	             "-c", f"model_reasoning_effort={effort}", prompt],
   177	            capture_output=True, text=True,
   178	            timeout=45 if call.tier != HEAVY else 300,
   179	        )
   180	        answer = _clean(out.stdout)
   181	    except subprocess.TimeoutExpired:
   182	        # Sol: "The system needs a safe failure mode when Chief is unavailable."
   183	        # If Chief can't answer, we do NOT fall back to a dumber model making the call.
   184	        # We say so and do nothing. Silence is safer than an unsupervised guess.
   185	        return {
   186	            "spoken": "I'm having trouble thinking that through right now. Nothing's started.",
   187	            "full": "Chief timed out. No work was dispatched.",
   188	            "tier": call.tier, "seconds": round(time.time() - t0, 1), "failed": True,
   189	        }
   190	
   191	    if not answer.strip():
   192	        return {
   193	            "spoken": "Something went wrong on my end. Nothing's started.",
   194	            "full": "Chief returned nothing. No work was dispatched.",
   195	            "tier": call.tier, "seconds": round(time.time() - t0, 1), "failed": True,
   196	        }
   197	
   198	    return {
   199	        "spoken": _for_speech(answer),
   200	        "full": answer,
   201	        "tier": call.tier,
   202	        "why_tier": call.reason,
   203	        "model": model,
   204	        "seconds": round(time.time() - t0, 1),
   205	        "failed": False,
   206	    }
