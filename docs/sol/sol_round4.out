harness/db/schema.sql:502:    monthly_cap_cents  INTEGER NOT NULL DEFAULT 10000,    -- $100
harness/db/schema.sql:508:INSERT OR IGNORE INTO budget (id, monthly_cap_cents, warn_at_cents) VALUES (1, 10000, 5000);
harness/db/schema.sql:514:    (SELECT monthly_cap_cents FROM budget WHERE id = 1)            AS cap_cents,
harness/db/schema.sql:515:    (SELECT warn_at_cents     FROM budget WHERE id = 1)            AS warn_cents
