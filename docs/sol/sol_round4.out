   256	    if "opus" in m or "claude" in m:  return "Claude"
   257	    if "gpt" in m or "sol" in m:      return "Sol"
   258	    if "grok" in m:                   return "Grok"
   259	    if "qwen" in m:                   return "Coal"
   260	    return model
   261	
   262	
   263	# ---------------------------------------------------------------------------
   264	# The morning briefing — §7's "what did the overnight run do?"
   265	# ---------------------------------------------------------------------------
   266	def render_morning_voice(conn: sqlite3.Connection) -> str:
   267	    rows = conn.execute(
   268	        """
   269	        SELECT status, COUNT(*) n FROM jobs
   270	         WHERE created_at >= datetime('now', '-1 day') GROUP BY status
   271	        """
   272	    ).fetchall()
   273	    counts = {r["status"]: r["n"] for r in rows}
   274	    if not counts:
   275	        return "Nothing ran overnight."
   240	    detail        TEXT,
   241	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   242	);
   243	
   244	CREATE INDEX IF NOT EXISTS idx_verdicts_job ON verdicts(job_id);
   245	
   246	-- ═══════════════════════════════════════════════════════════════════════════════
   247	-- CAPABILITIES — what an agent is PHYSICALLY ALLOWED to do.
   248	--
   249	-- This exists because Sol reviewed the architecture and demolished the previous
   250	-- safety story. The plan had been: the voice can act fast, and Chief watches and
   251	-- kills anything dumb. Sol's verdict:
   252	--
   253	--     "'Builders take minutes' measures how long they take to FINISH. What matters
   254	--      is how long they take to do their FIRST DAMAGING THING. That can be seconds.
   255	--      Chief and the builder would be RACING. There is no guarantee Chief wins."
   256	--
   257	--     "A fast supervisor is still only a fast witness if the builder can act first."
   258	--
   259	--     "A smarter model is not a security boundary."
   260	--
   261	-- He's right, and it's the difference between a bank with a vault and a bank with an
   262	-- attentive guard. You do not stop a robbery by watching carefully.
   263	--
   264	-- SO: agents get NO dangerous powers. Not "Chief will stop them" — THEY CANNOT.
   265	-- Reading code, writing code in their own worktree, running tests: always fine, and
   266	-- that's 95% of the work. Everything that touches the real world is denied by
   267	-- default and needs a signed, single-use permission slip for that exact act.
   268	-- ═══════════════════════════════════════════════════════════════════════════════
   269	CREATE TABLE IF NOT EXISTS capabilities (
   270	    seat_id       TEXT NOT NULL REFERENCES seats(id) ON DELETE CASCADE,
   271	    capability    TEXT NOT NULL CHECK (capability IN (
   272	                      -- SAFE. Granted to every builder. This is the actual job.
   273	                      'read_code', 'write_worktree', 'run_tests', 'open_pr',
   274	                      -- DANGEROUS. Denied to everyone by default. Each needs a
   275	                      -- fresh, single-use approval naming the exact action.
   276	                      'touch_production', 'delete_data', 'run_migration',
   277	                      'deploy', 'merge_to_main', 'force_push',
   278	                      'read_secrets', 'send_external', 'spend_money'
   279	                  )),
   280	    PRIMARY KEY (seat_id, capability)
   281	);
   282	
   283	-- The safe set. Everything an agent needs to actually build software, and nothing
   284	-- that can hurt you. Note what ISN'T here — that's the whole point.
   285	CREATE VIEW IF NOT EXISTS safe_capabilities AS
   286	SELECT 'read_code' AS capability UNION ALL SELECT 'write_worktree'
   287	UNION ALL SELECT 'run_tests' UNION ALL SELECT 'open_pr';
   288	
   289	-- ═══════════════════════════════════════════════════════════════════════════════
   290	-- APPROVALS — a signed, single-use permission slip for ONE exact dangerous act.
   291	--
   292	-- Sol on why a "yes" cannot be trusted on its own:
   293	--
   294	--     Chief: "First make a backup, then remove the old accounts."
   295	--     Neill: "Yes — skip the first one."
   296	--
   297	--     "That LOOKS like a confirmation, but it changes the safe plan into a dangerous
   298	--      one. Sending it directly recreates the original classification problem."
   299	--
   300	-- So an approval is not a word. It is a ROW: a numbered, one-time permission for a
   301	-- specific action, with the consequence written out in plain English and READ BACK to
   302	-- Neill before he can agree. It expires the moment the plan changes.
   303	--
   304	--     "A bare 'yes' should never approve something that was not just read back
   305	--      exactly." — which also handles the fact that a car is a terrible place to be
   306	--      understood correctly.
   307	-- ═══════════════════════════════════════════════════════════════════════════════
   308	CREATE TABLE IF NOT EXISTS approvals (
   309	    id            INTEGER PRIMARY KEY,
   310	    job_id        INTEGER REFERENCES jobs(id) ON DELETE CASCADE,
   311	    capability    TEXT NOT NULL,            -- the ONE dangerous thing this permits
   312	    -- Exactly what will happen. Not a category — the actual act.
   313	    action        TEXT NOT NULL,            -- "delete 4,200 accounts inactive since 2024-01-01"
   314	    -- What Chief SAID OUT LOUD to Neill before he agreed. If this is empty, nothing
   315	    -- was read back, and a 'yes' means nothing.
   316	    read_back     TEXT NOT NULL,
   317	    -- Is this undoable, and how? Sol: "Anything irreversible needs a tested recovery
   318	    -- method BEFORE it starts."
   319	    reversible    INTEGER NOT NULL DEFAULT 0 CHECK (reversible IN (0,1)),
   320	    recovery      TEXT,                     -- "restore from the snapshot taken at 09:14"
   321	
   322	    granted_by    TEXT NOT NULL DEFAULT 'owner' CHECK (granted_by = 'owner'),
   323	    granted_at    TEXT,
   324	    expires_at    TEXT NOT NULL,            -- short. Minutes, not hours.
   325	    used_at       TEXT,                     -- single use. Once spent, it's spent.
   326	    revoked_at    TEXT,
   327	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   328	);
   329	
   330	CREATE INDEX IF NOT EXISTS idx_approvals_job ON approvals(job_id);
   331	
   332	-- ═══════════════════════════════════════════════════════════════════════════════
   333	-- GUARD 12 — a dangerous act needs a live, unused, read-back approval.
   334	-- No approval, no action. Not "Chief said it was fine" — a signed slip, or nothing.
   335	-- ═══════════════════════════════════════════════════════════════════════════════
   336	CREATE VIEW IF NOT EXISTS live_approvals AS
   337	SELECT * FROM approvals
   338	 WHERE granted_at IS NOT NULL
   339	   AND used_at    IS NULL
   340	   AND revoked_at IS NULL
   341	   AND expires_at > datetime('now')
   342	   AND TRIM(read_back) <> '';
   343	
   344	-- An approval may never be BORN granted. (Sol, round 3 — verified 2026-07-14.)
   345	--
   346	-- Every approval guard fired on UPDATE OF granted_at only — the exact "born done" hole
   347	-- Sol found on the jobs table in round 1, never applied here. Confirmed with a live
   348	-- exploit: an INSERT with granted_at already set, reversible=0 and no recovery plan sailed
   349	-- straight into the live_approvals view. An approval must be born ungranted and become
   350	-- granted through an UPDATE, where the read-back and recovery guards below actually fire.
   351	CREATE TRIGGER IF NOT EXISTS guard_no_approval_is_born_granted
   352	BEFORE INSERT ON approvals
   353	WHEN NEW.granted_at IS NOT NULL
   354	BEGIN
   355	    SELECT RAISE(ABORT, 'guard: an approval cannot be created already granted — it must be granted through a read-back');
   356	END;
   357	
   358	-- An approval cannot be granted without something having been read back.
   359	CREATE TRIGGER IF NOT EXISTS guard_no_approval_without_readback
   360	BEFORE UPDATE OF granted_at ON approvals
   361	WHEN NEW.granted_at IS NOT NULL AND TRIM(COALESCE(NEW.read_back, '')) = ''
   362	BEGIN
   363	    SELECT RAISE(ABORT, 'guard: nothing was read back to him — a yes to nothing is not a yes');
   364	END;
   365	
   366	-- An irreversible act cannot be approved without a recovery plan.
   367	-- Sol: "'Kill' must never be presented as 'undo.'"
   368	CREATE TRIGGER IF NOT EXISTS guard_irreversible_needs_a_way_back
   369	BEFORE UPDATE OF granted_at ON approvals
   370	WHEN NEW.granted_at IS NOT NULL AND NEW.reversible = 0
   371	     AND TRIM(COALESCE(NEW.recovery, '')) = ''
   372	BEGIN
   373	    SELECT RAISE(ABORT, 'guard: this cannot be undone and has no way back — not without a recovery plan');
   374	END;
   375	
   376	-- Single use. A permission slip is spent when it is used.
   377	CREATE TRIGGER IF NOT EXISTS guard_an_approval_is_used_once
   378	BEFORE UPDATE OF used_at ON approvals
   379	WHEN OLD.used_at IS NOT NULL
   380	BEGIN
   381	    SELECT RAISE(ABORT, 'guard: that permission was already spent');
   382	END;
   383	
   384	-- ---------------------------------------------------------------------------
   385	-- Events: the live activity stream. What an agent is doing RIGHT NOW.
   386	--
   387	-- This is what makes the text channel feel like the Claude Code terminal — you
   388	-- watch Riggs read auth.py, edit routes.py, run pytest, and come back green.
   389	-- Without it the harness can only tell you a job "happened," which is useless
   390	-- while you're waiting and only mildly interesting afterward.
   540	--
   541	-- Sol's closing line, which is the one that mattered:
   542	--     "Those are application conventions, not the claimed structurally impossible
   543	--      guarantees."
   544	--
   545	-- He was right. Fixed below. Each guard now fires on BOTH insert and update, checks
   546	-- SNAPSHOTTED facts rather than live ones, and validates claims against `seats`
   547	-- instead of trusting whatever the writer put in the row.
   548	-- ===========================================================================
   549	
   550	-- A job may never be BORN finished. (Sol, round 1, #1 — the worst one.)
   551	CREATE TRIGGER IF NOT EXISTS guard_no_job_is_born_done
   552	BEFORE INSERT ON jobs
   553	WHEN NEW.status IN ('done', 'shipped')
   554	BEGIN
   555	    SELECT RAISE(ABORT, 'guard: a job cannot be created already finished — it must earn it');
   556	END;
   557	
   558	-- A job may not LIE ABOUT WHO BUILT IT AT BIRTH. (Sol, round 2, #1 — critical.)
   559	--
   560	-- I froze the builder's identity AFTER creation, so it couldn't be rewritten. But I
   561	-- never checked it AT creation. Sol: "A direct database write can label local work as
   562	-- subscription work, then complete it without the required higher-quality review. The
   563	-- identity is frozen only after creation; the initial lie is never caught."
   564	--
   565	-- Freezing a lie just makes it a permanent lie.
   566	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_must_be_real
   567	BEFORE INSERT ON jobs
   568	WHEN NEW.builder_tier   <> (SELECT tier   FROM seats WHERE id = NEW.builder_seat)
   569	  OR NEW.builder_family <> (SELECT family FROM seats WHERE id = NEW.builder_seat)
   570	BEGIN
   571	    SELECT RAISE(ABORT, 'guard: a job cannot misrepresent who built it');
   572	END;
   573	
   574	-- The builder's tier/family are snapshotted at creation and are then HISTORY.
   575	-- (Sol #5, #6 — re-tiering a seat rewrote the past.)
   576	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_is_frozen
   577	BEFORE UPDATE ON jobs
   578	WHEN OLD.builder_seat <> NEW.builder_seat
   579	  OR OLD.builder_tier <> NEW.builder_tier
   580	  OR OLD.builder_family <> NEW.builder_family
   581	BEGIN
   582	    SELECT RAISE(ABORT, 'guard: who built this cannot be rewritten after the fact');
   583	END;
   584	
   585	-- The panel size is fixed at dispatch. (Sol #7 — it could be set to zero later.)
   586	CREATE TRIGGER IF NOT EXISTS guard_panel_size_is_fixed
   587	BEFORE UPDATE OF required_reviews ON jobs
   588	WHEN OLD.required_reviews > 0 AND NEW.required_reviews < OLD.required_reviews
   589	BEGIN
   590	    SELECT RAISE(ABORT, 'guard: the panel cannot be shrunk after dispatch');
   591	END;
   592	
   593	-- A verdict, once written, is a fact. It cannot be edited into a pass.
   594	-- (Sol #2 — every verdict guard checked INSERT only, so you could rewrite the row.)
   595	CREATE TRIGGER IF NOT EXISTS guard_verdicts_are_append_only
   596	BEFORE UPDATE ON verdicts
   597	WHEN OLD.verdict <> NEW.verdict
   598	     AND NOT (OLD.verdict = 'needs_human' AND NEW.verdict IN ('pass','fail'))
   599	BEGIN
   600	    SELECT RAISE(ABORT, 'guard: a verdict cannot be rewritten — only an escalation may be answered');
   601	END;
   602	
   603	CREATE TRIGGER IF NOT EXISTS guard_verdict_identity_is_frozen
   604	BEFORE UPDATE ON verdicts
   605	WHEN OLD.role <> NEW.role OR OLD.model_family <> NEW.model_family
   606	  OR OLD.reviewer_seat <> NEW.reviewer_seat OR OLD.reviewer_tier <> NEW.reviewer_tier
   607	BEGIN
   608	    SELECT RAISE(ABORT, 'guard: who reviewed this cannot be rewritten after the fact');
   609	END;
   610	
   611	-- A verdict cannot be DELETED. (Sol, round 3 — verified 2026-07-14.)
   612	--
   613	-- "Append-only" was enforced only against UPDATE, so a failing review that couldn't be
   614	-- EDITED into a pass could simply be DELETED — after which guard_a_failing_review_stops_it
   615	-- (which asks "does a fail EXIST?") saw nothing and let the job complete. Confirmed with a
   616	-- live exploit: fail deleted, then done. A verdict is a fact; facts are not retractable.
   617	CREATE TRIGGER IF NOT EXISTS guard_verdicts_cannot_be_deleted
   618	BEFORE DELETE ON verdicts
   619	BEGIN
   620	    SELECT RAISE(ABORT, 'guard: a verdict is a fact on the record — it cannot be deleted');
   621	END;
   622	
   623	-- A reviewer cannot LIE about who it is. (Sol #4 — the DB took the row's word for it.)
   624	CREATE TRIGGER IF NOT EXISTS guard_reviewer_identity_must_be_real
   625	BEFORE INSERT ON verdicts
   626	WHEN NEW.reviewer_tier <> (SELECT tier FROM seats WHERE id = NEW.reviewer_seat)
   627	  OR NEW.model_family  <> (SELECT family FROM seats WHERE id = NEW.reviewer_seat)
   628	BEGIN
   629	    SELECT RAISE(ABORT, 'guard: a reviewer cannot misrepresent its own tier or family');
   630	END;
   631	
   632	-- Build evidence can only come from the harness. (Sol #9 — the DB accepted a
   633	-- model-captured screenshot; only the Python helper refused.)
   634	CREATE TRIGGER IF NOT EXISTS guard_models_cannot_forge_evidence
   635	BEFORE INSERT ON artifacts
   636	WHEN NEW.captured_by = 'model' AND NEW.kind NOT IN ('source', 'quote')
   637	BEGIN
   638	    SELECT RAISE(ABORT, 'guard: a model may cite a source but may not produce build evidence');
   639	END;
   640	
   641	-- ===========================================================================
   642	-- GUARD 1 — local output never ships unreviewed (§4.3, §9)
   643	-- Now reads the SNAPSHOT (builder_tier), not the live seat.
   644	-- ===========================================================================
   645	CREATE TRIGGER IF NOT EXISTS guard_local_output_needs_review
   646	BEFORE UPDATE OF status ON jobs
   647	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   648	     AND NEW.builder_tier = 'local'
   649	BEGIN
   650	    SELECT RAISE(ABORT, 'guard: local-built job requires a passing subscription-tier review before done')
   651	    WHERE NOT EXISTS (
   652	        SELECT 1 FROM verdicts v
   653	        WHERE v.job_id = NEW.id
   654	          AND v.reviewer_tier IN ('subscription', 'metered')
   655	          AND v.verdict = 'pass'
   656	    );
   657	END;
   658	
   659	-- ===========================================================================
   660	-- GUARD 2 — escalations must be answered, not outrun (§6)
   661	-- ===========================================================================
   662	CREATE TRIGGER IF NOT EXISTS guard_unresolved_escalation
   663	BEFORE UPDATE OF status ON jobs
   664	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   665	BEGIN
   666	    SELECT RAISE(ABORT, 'guard: job has an unresolved needs_human verdict')
   667	    WHERE EXISTS (
   668	        SELECT 1 FROM verdicts v WHERE v.job_id = NEW.id AND v.verdict = 'needs_human'
   669	    );
   670	END;
   671	
   672	-- ===========================================================================
   673	-- GUARD 3 — a tester's verdict must cite REAL BUILD EVIDENCE.
   674	--
   675	-- ⚠️ Sol #3: "The 'no screenshot, no verdict' claim is false." My original guard
   676	-- accepted ANY artifact — including a research source, or an empty row. So a tester
   677	-- could "pass" a job on the strength of a URL somebody pasted. Now it must be
   678	-- evidence the HARNESS captured by actually driving the app.
   679	-- ===========================================================================
   680	CREATE TRIGGER IF NOT EXISTS guard_tester_must_cite_artifacts
   681	BEFORE INSERT ON verdicts
   682	WHEN NEW.role = 'tester'
   683	BEGIN
   684	    SELECT RAISE(ABORT, 'guard: a tester verdict requires real captured evidence — no screenshot, no verdict')
   685	    WHERE NOT EXISTS (
   686	        SELECT 1 FROM artifacts a
   687	        WHERE a.job_id = NEW.job_id
   688	          AND a.kind IN ('screenshot', 'trace', 'video', 'dom_snapshot')
   689	          AND a.captured_by IN ('harness', 'playwright')
   690	          AND COALESCE(a.path, a.value) IS NOT NULL
   691	    );
   692	END;
   693	
   694	-- ===========================================================================
   695	-- GUARD 4 — a model family may not test its own work.
   696	-- Reads the snapshot, so re-pointing a seat later changes nothing.
   697	-- ===========================================================================
   698	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_testing
   699	BEFORE INSERT ON verdicts
   700	WHEN NEW.role = 'tester'
   701	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
   702	BEGIN
   703	    SELECT RAISE(ABORT, 'guard: a model family may not test its own build');
   704	END;
   705	
   706	-- ===========================================================================
   707	-- GUARD 5 — the full panel, always. DISTINCT reviewers.
   708	--
   709	-- ⚠️ Sol #7: "The full panel can be faked with duplicate passes." It counted ROWS.
   710	-- One reviewer could pass the same job six times. Now it counts distinct seats.
   711	-- ===========================================================================
   712	CREATE TRIGGER IF NOT EXISTS guard_full_panel
   713	BEFORE UPDATE OF status ON jobs
   714	WHEN NEW.status = 'done' AND OLD.status <> 'done' AND NEW.required_reviews > 0
   715	BEGIN
   716	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
   717	    WHERE (
   718	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
   719	        -- the panel could be "filled" by the wrong kinds of check entirely.
   720	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
   721	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   722	    ) < NEW.required_reviews;
   723	END;
   724	
   725	-- ═══════════════════════════════════════════════════════════════════════════
   726	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   727	--
   728	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
   729	-- serious failure satisfied it. A reviewer could scream that the thing was broken and
   730	-- be outvoted by colleagues who hadn't noticed.
   731	--
   732	-- That is the opposite of what a gauntlet is FOR. One reviewer finding a real bug is
   733	-- the whole point — it isn't a democracy, it's a set of independent smoke detectors.
   734	-- Any one of them going off stops the job.
   735	-- ═══════════════════════════════════════════════════════════════════════════
   736	CREATE TRIGGER IF NOT EXISTS guard_a_failing_review_stops_it
   737	BEFORE UPDATE OF status ON jobs
   738	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   739	BEGIN
   740	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
   741	    WHERE EXISTS (
   742	        SELECT 1 FROM verdicts v WHERE v.job_id = NEW.id AND v.verdict = 'fail'
   743	    );
   744	END;
   745	
   746	-- Sol, round 2, #6: an objection raised AFTER 'done' could still be outrun, because
   747	-- the escalation guard only fired on the transition INTO done — not on done -> shipped.
   748	CREATE TRIGGER IF NOT EXISTS guard_late_escalation_still_blocks_shipping
   749	BEFORE UPDATE OF status ON jobs
   750	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   751	BEGIN
   752	    SELECT RAISE(ABORT, 'guard: someone raised an objection — it has to be answered first')
   753	    WHERE EXISTS (
   754	        SELECT 1 FROM verdicts v
   755	        WHERE v.job_id = NEW.id AND v.verdict IN ('needs_human', 'fail')
   756	    );
   757	END;
   758	
   759	-- Sol, round 2, #4: evidence could be an EMPTY STRING. A path of '' satisfied
   760	-- "COALESCE(path, value) IS NOT NULL" perfectly well.
   761	CREATE TRIGGER IF NOT EXISTS guard_evidence_cannot_be_empty
   762	BEFORE INSERT ON artifacts
   763	WHEN TRIM(COALESCE(NEW.path, NEW.value, '')) = ''
   764	BEGIN
   765	    SELECT RAISE(ABORT, 'guard: evidence with nothing in it is not evidence');
   766	END;
   767	
   768	-- ===========================================================================
   769	-- GUARD 6 — nothing ships without a passing cross-family tester.
   770	-- ===========================================================================
   771	CREATE TRIGGER IF NOT EXISTS guard_ship_requires_a_passing_tester
   772	BEFORE UPDATE OF status ON jobs
   773	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   774	BEGIN
   775	    SELECT RAISE(ABORT, 'guard: nothing ships without a passing cross-family tester on the record')
   776	    WHERE OLD.status <> 'done'
   777	       OR NOT EXISTS (
   778	           SELECT 1 FROM verdicts v
   779	           WHERE v.job_id = NEW.id AND v.role = 'tester' AND v.verdict = 'pass'
   780	       );
   781	END;
   782	
   783	-- ===========================================================================
   784	-- GUARD 7 — a researcher must show you where it got that.
   785	-- ===========================================================================
   786	CREATE TRIGGER IF NOT EXISTS guard_research_must_cite_sources
   787	BEFORE UPDATE OF status ON jobs
   788	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   789	     AND NEW.kind = 'research'
   790	BEGIN
   791	    SELECT RAISE(ABORT, 'guard: a research answer must cite sources — no source, no answer')
   792	    WHERE NOT EXISTS (
   793	        SELECT 1 FROM artifacts a
   794	        WHERE a.job_id = NEW.id AND a.kind IN ('source', 'quote')
   795	          AND COALESCE(a.path, a.value) IS NOT NULL
   796	    );
   797	END;
   798	
   799	-- ===========================================================================
   800	-- GUARD 8 — a model family may not fact-check its own research.
   801	-- ===========================================================================
   802	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_verifying
   803	BEFORE INSERT ON verdicts
   804	WHEN NEW.role = 'verifier'
   805	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
   806	BEGIN
   807	    SELECT RAISE(ABORT, 'guard: a model family may not fact-check its own research');
   808	END;
   809	
   810	-- ===========================================================================
   811	-- GUARD 9 — spend caps are enforced by the DATABASE, not by good manners.
   812	--
   813	-- ⚠️ Sol #8: "Spend caps do not structurally prevent runaway cost." They were a
   814	-- Python check before dispatch — a classic race (two dispatches both pass the check
   815	-- before either records spend), and a direct write skipped them entirely. Now the
   816	-- ledger itself refuses the entry that would breach the cap.
   817	-- ===========================================================================
   818	CREATE TRIGGER IF NOT EXISTS guard_no_negative_spend
   819	BEFORE INSERT ON usage
   820	WHEN NEW.cost_cents < 0
   821	BEGIN
   822	    SELECT RAISE(ABORT, 'guard: spend cannot be negative — no unwinding the meter');
   823	END;
   824	
   825	CREATE TRIGGER IF NOT EXISTS guard_daily_cap_is_hard
   826	BEFORE INSERT ON usage
   827	BEGIN
   828	    SELECT RAISE(ABORT, 'guard: this seat is over its daily cap')
   829	    WHERE (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
   830	      AND (
   831	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
   832	         WHERE seat_id = NEW.seat_id AND day = date('now')
   833	      ) + NEW.cost_cents
   834	      > (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id);
   835	END;
   836	
   837	-- Ration the EXPENSIVE work separately. A seat can be generous on reviewing and
   838	-- stingy on building — which is exactly how you want a metered seat to behave when
   839	-- you already pay flat-rate for two better builders.
   840	CREATE TRIGGER IF NOT EXISTS guard_build_cap_is_hard
   841	BEFORE INSERT ON usage
   842	WHEN NEW.role = 'build'
   843	BEGIN
   844	    SELECT RAISE(ABORT, 'guard: this seat has used up its building budget for today — it can still review')
   845	    WHERE (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
   846	      AND (
   847	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
   848	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role = 'build'
   849	      ) + NEW.cost_cents
   850	      > (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id);
   851	END;
   852	
   853	CREATE TRIGGER IF NOT EXISTS guard_review_cap_is_hard
   854	BEFORE INSERT ON usage
   855	WHEN NEW.role IN ('review', 'test')
   856	BEGIN
   857	    SELECT RAISE(ABORT, 'guard: this seat is over its reviewing budget for today')
   858	    WHERE (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
   859	      AND (
   860	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
   861	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role IN ('review','test')
   862	      ) + NEW.cost_cents
   863	      > (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id);
   864	END;
   865	
   866	-- Keep updated_at honest.
   867	CREATE TRIGGER IF NOT EXISTS jobs_touch_updated_at
   868	AFTER UPDATE ON jobs
   869	FOR EACH ROW
   870	BEGIN
   871	    UPDATE jobs SET updated_at = datetime('now') WHERE id = NEW.id;
   872	END;
   873	
   874	-- ---------------------------------------------------------------------------
   875	-- The §7 voice query: "what did the overnight run do?"
   876	-- ---------------------------------------------------------------------------
   877	CREATE VIEW IF NOT EXISTS job_report AS
   878	SELECT
   879	    j.id,
   880	    j.created_at,
   300	    conn.execute("UPDATE verdicts SET verdict = ? WHERE id = ?", (verdict, verdict_id))
   301	
   302	
   303	# --------------------------------------------------------------------------
   304	# Reporting — this is what the voice layer reads back
   305	# --------------------------------------------------------------------------
   306	def overnight_report(conn: sqlite3.Connection, since: str = "-1 day") -> list[sqlite3.Row]:
   307	    """Answers spec §7's 'what did the overnight run do?'"""
   308	    return conn.execute(
   309	        """
   310	        SELECT * FROM job_report
   311	         WHERE created_at >= datetime('now', ?)
   312	         ORDER BY id
   313	        """,
   314	        (since,),
   315	    ).fetchall()
   316	
   317	
   318	def spend_today(conn: sqlite3.Connection, seat_id: str) -> int:
   319	    row = conn.execute(
   320	        "SELECT COALESCE(SUM(cost_cents), 0) AS c FROM usage WHERE seat_id = ? AND day = date('now')",
   321	        (seat_id,),
   322	    ).fetchone()
   323	    return int(row["c"])
   324	
   325	
   326	def over_budget(conn: sqlite3.Connection, seat_id: str) -> bool:
   327	    """True if this seat has hit its daily cap.
   328	
   329	    OpenClaw has no per-agent budget of any kind, so the harness must check this
   330	    before dispatching. Uncapped seats (daily_cap_cents IS NULL) never block.
   331	    """
   332	    row = seat(conn, seat_id)
   333	    if row is None or row["daily_cap_cents"] is None:
   334	        return False
   335	    return spend_today(conn, seat_id) >= int(row["daily_cap_cents"])
   336	
   337	
   338	@_guarded
   339	def record_usage(
   340	    conn: sqlite3.Connection,
   341	    seat_id: str,
   342	    cost_cents: int,
   343	    job_id: int | None = None,
   344	    input_tokens: int = 0,
   345	    output_tokens: int = 0,
   346	    role: str = "build",
   347	) -> None:
   348	    """Record spend. The DATABASE refuses an entry that would breach the daily cap.
   349	
   350	    This used to be a Python check before dispatch — which Sol correctly called a
   351	    race (two dispatches both pass the check before either records spend) and easily
   352	    bypassed by any direct write. The ledger itself now says no.
   353	    """
   354	    conn.execute(
   355	        """
   356	        INSERT INTO usage (seat_id, job_id, role, input_tokens, output_tokens, cost_cents)
   357	        VALUES (?, ?, ?, ?, ?, ?)
   358	        """,
   359	        (seat_id, job_id, role, input_tokens, output_tokens, cost_cents),
   360	    )
   361	
   362	
   363	def can_build(conn: sqlite3.Connection, seat_id: str) -> bool:
   364	    """Has this seat used up its BUILDING budget? (It may still be able to review.)"""
   365	    row = seat(conn, seat_id)
   366	    if row is None or row["build_cap_cents"] is None:
   367	        return True
   368	    spent = conn.execute(
   369	        "SELECT COALESCE(SUM(cost_cents),0) c FROM usage "
   370	        "WHERE seat_id=? AND day=date('now') AND role='build'", (seat_id,)
   371	    ).fetchone()["c"]
   372	    return int(spent) < int(row["build_cap_cents"])
   373	
   374	
   375	# ---------------------------------------------------------------------------
   376	# The money
   377	# ---------------------------------------------------------------------------
   378	def month_spend(conn: sqlite3.Connection) -> dict[str, int]:
   379	    """What have we spent this month, and how close are we?"""
   380	    r = conn.execute("SELECT * FROM month_spend").fetchone()
   381	    spent, cap, warn = int(r["spent_cents"]), int(r["cap_cents"]), int(r["warn_cents"])
   382	    return {
   383	        "spent_cents": spent,
   384	        "cap_cents": cap,
   385	        "warn_cents": warn,
   386	        "remaining_cents": max(0, cap - spent),
   387	        "pct": round(100 * spent / cap, 1) if cap else 0.0,
   388	        "over_warn": spent >= warn,
   389	    }
   390	
   391	
   392	def set_budget(conn: sqlite3.Connection, monthly_cap_cents: int, warn_at_cents: int) -> None:
   393	    conn.execute(
   394	        "UPDATE budget SET monthly_cap_cents=?, warn_at_cents=?, updated_at=datetime('now') "
   395	        "WHERE id=1", (monthly_cap_cents, warn_at_cents)
   396	    )
   397	
   398	
   399	def budget_warning(conn: sqlite3.Connection) -> str | None:
   400	    """Should we tell Neill about the money right now?
   401	
   402	    Warns ONCE per month at the threshold, then goes quiet — a warning you see every
   403	    day is a warning you stop reading. Speaks up again only when the cap is actually
   404	    hit, because at that point work is stopping and he needs to know why.
   405	    """
   406	    m = month_spend(conn)
   407	    if m["spent_cents"] >= m["cap_cents"]:
   408	        return (f"You've hit the ${m['cap_cents']/100:.0f} monthly limit. "
   409	                f"I've stopped spending until you raise it or the month rolls over.")
   410	
   411	    if not m["over_warn"]:
   412	        return None
   413	
   414	    from datetime import datetime
   415	    this_month = datetime.now().strftime("%Y-%m")
   416	    row = conn.execute("SELECT warned_this_month FROM budget WHERE id=1").fetchone()
   417	    if row["warned_this_month"] == this_month:
   418	        return None   # already told him. Don't nag.
   419	
   420	    conn.execute("UPDATE budget SET warned_this_month=? WHERE id=1", (this_month,))
   421	    return (f"Heads up — you're at ${m['spent_cents']/100:.2f} of your "
   422	            f"${m['cap_cents']/100:.0f} monthly budget. About "
   423	            f"${m['remaining_cents']/100:.2f} left.")

