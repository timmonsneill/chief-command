  const d = document.createElement('div');
  d.className = 'turn ' + cls;
  d.innerHTML = `<div class="lbl">${who}</div>${(text||'').replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]))}`;
  $('#log').appendChild(d);
  d.scrollIntoView({behavior:'smooth', block:'end'});
