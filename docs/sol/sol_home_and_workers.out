    65	# ---------------------------------------------------------------------------
    66	# Event trail — this is what the app's activity view reads. Every step, live.
    67	# ---------------------------------------------------------------------------
    68	def _event(conn, job_id: int, seat_row, kind: str, detail: str = "", target: str = "") -> None:
    69	    conn.execute(
    70	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, target, detail) "
    71	        "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
    72	        (job_id, seat_row["id"], seat_row["id"], seat_row["model"],
    73	         seat_row["family"], kind, target or None, detail or None),
    74	    )
