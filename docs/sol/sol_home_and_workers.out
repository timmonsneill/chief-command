   227	
   228	    # A failure on this version is fatal and is NOT outvoted. A failure on an unknown
   229	    # version is also fatal: it condemns we-don't-know-what, so it condemns everything.
   230	    for v in verdicts:
   231	        if v["verdict"] == "fail" and (
   232	                v["reviewed_version"] is None or v["reviewed_version"] == version):
   233	            raise _no("a reviewer turned this down and that stands")
   234	    if any(v["verdict"] == "needs_human" for v in verdicts):
   235	        raise _no("a reviewer asked for you to look at this first")
   236	
   237	    passed = [v for v in current if v["verdict"] == "pass" and v["role"] == "reviewer"]
   238	    seats = {v["reviewer_seat"] for v in passed}
   239	    # The author is not a second opinion (migration 007): a same-family pass is a
   240	    # legitimate review, it just does not count toward "different minds". The schema
   241	    # already refuses first; this keeps the gate honest even if it ever stops.
