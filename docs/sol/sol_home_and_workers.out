   451	def run_gauntlet(conn, job_id: int, cfg: dict[str, Any]) -> dict[str, Any]:
   452	    """Fan the finished work out to the reviewer panel, in parallel, same bundle.
   453	
   454	    This used to return a list of reviewer NAMES and launch nobody — the gauntlet was a
   455	    plan, not a thing that ran (task #10). It now runs the panel and returns what
   456	    actually happened: who reviewed, which families, what they said, and — if the job
   457	    stayed parked — why, in plain words.
   458	
   459	    The model-diversity rule (§6) still isn't asserted here; it's RECORDED. Every
   460	    verdict snapshots the reviewing seat's family, and the schema refuses to complete a
   461	    job without enough distinct families passing THIS version. So "two different minds
   462	    looked at this" is a fact you can query, not a promise this function made.
   463	    """
   464	    import gauntlet as gauntlet_mod
   465	
   466	    return gauntlet_mod.run_gauntlet_for_job(conn, job_id, cfg).as_dict()
