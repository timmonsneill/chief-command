   610	# VOICE
   611	# ═══════════════════════════════════════════════════════════════════════════════
   612	import os  # noqa: E402
   613	
   614	import httpx  # noqa: E402
   615	
   616	from chief import ASK_CHIEF_TOOL, MOUTH_INSTRUCTIONS, ask_chief  # noqa: E402
   617	
   618	VOICE_MODEL = "gpt-realtime-2.1"   # the FULL model, NOT mini.
   619	# Mini has an open, unresolved bug where it refuses to call function tools. For a
   620	# telephone whose entire job is placing one call, that is fatal — you'd speak into
   621	# the car and nothing would happen. ~$50/mo more to remove the single point of
   622	# failure from the whole system. Cheapest insurance on the board.
   623	
   624	
   625	@app.get("/api/voice/token")
   626	async def voice_token():
   627	    """Mint a SHORT-LIVED client token so the real API key never reaches the browser.
   628	
   629	    The browser talks straight to OpenAI (that's what keeps the audio fast — it doesn't
   630	    bounce through this Mac). But it must never hold the key that can spend money, so
   631	    it gets a token that expires in a minute and can do nothing but start one session.
   632	    """
   633	    key = os.environ.get("OPENAI_API_KEY")
   634	    if not key:
   635	        return JSONResponse({"error": "no OpenAI key configured"}, status_code=503)
   636	
   637	    # Refuse to start a session we can't afford. Sol: "a safe failure mode when Chief
   638	    # is unavailable" — same principle for the money. Better to not start than to be
   639	    # cut off mid-sentence by OpenAI's own cap.
   640	    m = month_spend(db())
   641	    if m["spent_cents"] >= m["cap_cents"]:
   642	        return JSONResponse(
   643	            {"error": f"You're at your ${m['cap_cents']/100:.0f} monthly limit. "
   644	                      "Voice is off until you raise it."},
   645	            status_code=402,
   646	        )
   647	
   648	    async with httpx.AsyncClient(timeout=20) as http:
   649	        r = await http.post(
   650	            "https://api.openai.com/v1/realtime/client_secrets",
   651	            headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
   652	            json={
   653	                "session": {
   654	                    "type": "realtime",
   655	                    "model": VOICE_MODEL,
   656	                    "instructions": MOUTH_INSTRUCTIONS,
   657	                    "tools": [ASK_CHIEF_TOOL],
   658	                    # FORCE the call (Sol's bug #1). With "auto" the mouth could decide a
   659	                    # "yes" or a status question wasn't worth sending and answer it itself
   660	                    # — which is exactly the judgment that leaked twice. Required means
   661	                    # every single thing Neill says goes to Chief. The mouth cannot
   662	                    # freelance.
   663	                    "tool_choice": "required",
   664	                    "audio": {
   665	                        "input": {
   666	                            # SEMANTIC turn detection, not plain silence detection.
   667	                            # A driver pauses mid-sentence to merge; silence-based VAD
   668	                            # cuts him off. Semantic judges whether he SOUNDED finished.
   669	                            "turn_detection": {"type": "semantic_vad", "eagerness": "low",
   670	                                               "interrupt_response": True},
