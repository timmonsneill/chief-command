harness/gauntlet.py:947:def run_gauntlet_for_job(conn, job_id: int, cfg: dict[str, Any], *,
     1	"""The bridge: OpenClaw dispatches the work, the job store decides whether it may run.
     2	
     3	This is the piece that turns three separate things (a pinned OpenClaw, a job store,
     4	a seat config) into a system.
     5	
     6	Design decision worth stating, because it drives everything else:
     7	
     8	    THE JOB STORE IS THE SOURCE OF TRUTH, NOT A LISTENER.
     9	
    10	We record the job BEFORE we spawn it, and we refuse to spawn if the store says no
    11	(over budget, seat disabled). If we merely *observed* OpenClaw's events, work could
    12	run that was never recorded — and OpenClaw's subagent sessions auto-archive after
    13	~60 minutes and get soft-deleted, so anything we didn't write down is simply gone.
    14	Spec §7 wants "what did the overnight run do?" to be answerable. That only works if
    15	nothing can run without a row.
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	import json
    21	import subprocess
    22	import sys
    23	import tomllib
    24	from dataclasses import dataclass
    25	from pathlib import Path
    26	from typing import Any
    27	
    28	sys.path.insert(0, str(Path(__file__).resolve().parent))
    29	
    30	from db.jobs import (  # noqa: E402
    31	    Seat,
    32	    attach_run,
    33	    create_job,
    34	    over_budget,
    35	    seat,
    36	    set_status,
    37	    upsert_seat,
    38	)
    39	
    40	CONFIG = Path(__file__).resolve().parent / "config" / "seats.toml"
    41	BUILD_ESTIMATE_CENTS = 25       # reserved for a metered build before the call (an estimate;
    42	                                # real usage recording is queue task 1)
    43	
    44	# Which shape a job's reviewed bundle will be, keyed by the BUILDER SEAT'S
    45	# PROVIDER — stamped once at dispatch and then frozen (migration 008), because the
    46	# `seats` table is re-upserted from config on every server start and a seat's live
    47	# `provider` is therefore mutable history; what a job WAS must not follow it.
    48	# codex is NOT mapped here on purpose: there is no in-process codex builder yet
    49	# (executor.py only knows ollama and claude-cli). Mapping it to 'diff' now would
    50	# stamp a review contract for work nothing can actually produce. Add it back the
    51	# day an in-process codex builder exists.
    52	BUNDLE_KIND_BY_PROVIDER = {"claude-cli": "diff"}   # default: 'text'
    53	
    54	
    55	class DispatchRefused(RuntimeError):
    56	    """The harness declined to dispatch. Budget, disabled seat, or a guard."""
    57	
    58	
    59	# ---------------------------------------------------------------------------
    60	# The REAL, in-process dispatch path (task #9).
    61	#
    62	# dispatch()/_spawn() below hand work to OpenClaw — the production path, for the
    63	# paid coding seats. This one runs the free LOCAL model directly, in a background
    64	# worker, so the whole spine can be exercised end-to-end today with no money and no
    65	# exposed keys. Same recording, same guards, same worktree isolation.
    66	# ---------------------------------------------------------------------------
    67	@dataclass
    68	class LocalDispatch:
    69	    job_id: int
    70	    seat_id: str
    71	    reused: bool          # True = a duplicate key matched an existing job
    72	    tier: str
    73	    tier_reason: str
    74	
    75	
    76	def dispatch_local(
    77	    conn,
    78	    request: str,
    79	    builder_seat: str,
    80	    *,
    81	    cfg: dict[str, Any] | None = None,
    82	    origin: str = "text",
    83	    dispatch_key: str | None = None,
    84	    start: bool = True,
    85	    project_id: str = "chief",
    86	) -> LocalDispatch:
    87	    """Record a job and start a real local worker on it. Non-blocking.
    88	
    89	    Order is load-bearing: we check the seat and the budget, dedupe, THEN write the
    90	    row, THEN start the worker — the store is the source of truth, nothing runs
    91	    without a row. Duplicate protection: a repeated dispatch_key returns the job that
    92	    already exists instead of starting the work twice.
    93	
    94	    The review requirements come from the GAUNTLET CONFIG, never from the caller
    95	    (task #10). A caller that could say "one reviewer is enough" is the single-reviewer
    96	    door this task exists to close.
    97	    """
    98	    # create_job / over_budget / seat are already imported at module level — re-importing
    99	    # them here rebound them as LOCALS, which silently shadowed the module's own names.
   100	    # Anything that swapped them (a test, a future wrapper) was ignored inside this
   101	    # function while appearing to work everywhere else.
   102	    from tiering import tier_for_build
   103	    import executor
   104	
   105	    cfg = load_config() if cfg is None else cfg
   106	    roster, excluded = panel_roster(conn, cfg)
   107	    families = int(cfg.get("gauntlet", {}).get("min_model_families", 0))
   108	    builder_row = seat(conn, builder_seat)
   109	    _refuse_a_panel_that_cannot_hold(conn, roster, families,
   110	                                     builder_row["family"] if builder_row else None)
   111	    project_row = conn.execute(
   112	        "SELECT 1 FROM projects WHERE id = ? AND archived = 0", (project_id,)
   113	    ).fetchone()
   114	    if project_row is None:
   115	        raise DispatchRefused(f"unknown project: {project_id}")
   116	
   117	    # Duplicate protection — a retry must not start the same work twice.
   118	    if dispatch_key:
   119	        existing = conn.execute(
   120	            "SELECT id, builder_seat, tier, tier_reason FROM jobs WHERE dispatch_key = ?",
   121	            (dispatch_key,),
   122	        ).fetchone()
   123	        if existing is not None:
   124	            return LocalDispatch(
   125	                job_id=existing["id"], seat_id=existing["builder_seat"],
   126	                reused=True, tier=existing["tier"] or "standard",
   127	                tier_reason=existing["tier_reason"] or "",
   128	            )
   129	
   130	    row = seat(conn, builder_seat)
   131	    if row is None:
   132	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   133	    if not row["enabled"]:
   134	        raise DispatchRefused(f"seat '{builder_seat}' is turned off")
   135	    if over_budget(conn, builder_seat):
   136	        raise DispatchRefused(f"seat '{builder_seat}' is over its budget for today")
   137	
   138	    call = tier_for_build(request)
   139	
   140	    # ONE transaction for the whole record of this dispatch. A job must never exist,
   141	    # even for an instant, without its review requirements stamped on — in autocommit
   142	    # that gap is a real row with a zero floor. The excluded-reviewer notes go in here
   143	    # too: if writing them fails, the right outcome is no job at all, not a committed
   144	    # job whose panel quietly shrank without saying so.
   145	    #
   146	    # BEGIN IMMEDIATE, not BEGIN: this reads before it writes, and a deferred
   147	    # transaction that upgrades to a write after another connection has committed fails
   148	    # instantly with a snapshot error that the busy-timeout does NOT retry.
   149	    conn.execute("BEGIN IMMEDIATE")
   150	    try:
   151	        bundle_kind = BUNDLE_KIND_BY_PROVIDER.get(
   152	            builder_row["provider"] if builder_row else "", "text")
   153	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin,
   154	                            bundle_kind=bundle_kind, project_id=project_id)
   155	        conn.execute(
   156	            "UPDATE jobs SET required_reviews = ?, required_review_families = ?, "
   157	            "tier = ?, tier_reason = ?, dispatch_key = ?, branch = ?, bundle_kind = ? "
   158	            "WHERE id = ?",
   159	            (len(roster), families, call.tier, call.reason, dispatch_key,
   160	             f"job/{job_id}", bundle_kind, job_id),
   161	        )
   162	        # No silent caps: a reviewer left out of the panel is written down on the job.
   163	        # (A roster name that isn't a seat at all has no row to hang an event on —
   164	        # sync_seats refuses that config outright, the earlier and louder place.)
   165	        for seat_id, why in excluded.items():
   166	            row = seat(conn, seat_id)
   167	            if row is None:
   168	                continue
   169	            conn.execute(
   170	                "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   171	                "VALUES (?,?,?,?,?,?,?)",
   172	                (job_id, seat_id, seat_id, row["model"], row["family"], "skipped",
   173	                 f"not on the panel: {why}"),
   174	            )
   175	        conn.execute("COMMIT")
   176	    except Exception as exc:
   177	        conn.execute("ROLLBACK")
   178	        # Anything that goes wrong here is a refusal to dispatch, not a mystery 500 —
   179	        # and above all not a committed job with no worker coming for it.
   180	        raise DispatchRefused(f"could not record the job: {exc}") from exc
   181	    set_status(conn, job_id, "in_progress")
   182	
   183	    if start:
   184	        executor.start_in_background(job_id, cfg=cfg)
   185	
   186	    return LocalDispatch(
   187	        job_id=job_id, seat_id=builder_seat, reused=False,
   188	        tier=call.tier, tier_reason=call.reason,
   189	    )
   190	
   191	
   192	# ---------------------------------------------------------------------------
   193	# Config
   194	# ---------------------------------------------------------------------------
   195	def load_config(path: Path = CONFIG) -> dict[str, Any]:
   196	    # seats.toml uses // comments for readability; TOML has no //, so strip them before
   197	    # parsing. Must be string-aware: value strings hold `https://…` and `base_url` lines
   198	    # end in `"…"  // note` — cutting at the first // blindly would eat the URL. So we
   199	    # only strip a // that sits OUTSIDE a quoted string.
   200	    raw = "\n".join(_strip_slash_comment(line) for line in path.read_text().splitlines())
   201	    return tomllib.loads(raw)
   202	
   203	
   204	def _strip_slash_comment(line: str) -> str:
   205	    """Drop an inline/full-line `//` comment, ignoring `//` inside quotes."""
   206	    quote = ""
   207	    for i in range(len(line) - 1):
   208	        ch = line[i]
   209	        if quote:
   210	            if ch == quote:
   211	                quote = ""
   212	        elif ch in "\"'":
   213	            quote = ch
   214	        elif ch == "/" and line[i + 1] == "/":
   215	            return line[:i].rstrip()
   216	    return line
   217	
   218	
   219	def unresolved_reviewers(cfg: dict[str, Any]) -> list[str]:
   220	    """Gauntlet reviewers that don't name a real seat. Empty == all resolve.
   221	
   222	    A roster entry pointing at a seat that doesn't exist (the old `grinder_paid`) is a
   223	    silent trap: `over_budget` treats the unknown seat as uncapped, the pre-check says
   224	    "fine," then the verdict write rejects it. Catch it at startup instead.
   225	    """
   226	    seats = cfg.get("seats", {})
   227	    return [r for r in cfg.get("gauntlet", {}).get("reviewers", []) if r not in seats]
   228	
   229	
   230	def panel_roster(conn, cfg: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
   231	    """Who can actually sit on the panel right now — and who can't, and why.
   232	
   233	    A roster entry is only real if the seat exists, is switched on, and we have a way to
   234	    RUN it on this machine. A seat whose provider has no runner, or whose key is absent, is excluded; the
   235	    codex seat needs its login. Counting those as panel members would produce a required
   236	    panel that can never report, which fails closed but useless — every job parked
   237	    forever. Counting them silently would be worse: a panel that shrank without saying
   238	    so reads exactly like a full one.
   239	
   240	    So: exclude them, name them, and let the FAMILY FLOOR (which cannot be lowered) be
   241	    the thing that decides whether what's left is enough.
   242	    """
   243	    import gauntlet
   244	
   245	    roster: list[str] = []
   246	    excluded: dict[str, str] = {}
   247	    for seat_id in cfg.get("gauntlet", {}).get("reviewers", []):
   248	        row = seat(conn, seat_id)
   249	        if row is None:
   250	            excluded[seat_id] = "that reviewer isn't set up on this machine"
   251	        elif not row["enabled"]:
   252	            excluded[seat_id] = "that reviewer is turned off"
   253	        elif not gauntlet.has_runner(row["provider"]):
   254	            excluded[seat_id] = "we have no way to run that reviewer yet"
   255	        else:
   256	            roster.append(seat_id)
   257	    return roster, excluded
   258	
   259	
   260	def _refuse_a_panel_that_cannot_hold(conn, roster: list[str], floor: int,
   261	                                     builder_family: str | None = None) -> None:
   262	    """Refuse to dispatch work the panel could never certify.
   263	
   264	    Fail CLOSED, but say so at DISPATCH — when it is one legible refusal — rather than
   265	    at review time, where it becomes a job that parks forever and looks like a bug.
   266	    """
   267	    if floor < 1:
   268	        raise DispatchRefused(
   269	            "the review panel isn't configured (it needs at least one model family) "
   270	            "— refusing to start work that nothing would check"
   271	        )
   272	    # Counted the way the database counts (migration 007): the author's own family is
   273	    # not a second opinion. Counting it here admitted jobs the record then parked.
   274	    families = {seat(conn, s)["family"] for s in roster} - {builder_family}
   275	    if len(families) < floor:
   276	        raise DispatchRefused(
   277	            f"only {len(families)} model family/families can review right now and "
   278	            f"{floor} are required — refusing to start work that could never be checked"
   279	        )
   280	
   281	
   282	def sync_seats(conn, cfg: dict[str, Any]) -> None:
   283	    """Push the config's seats into the store, so guards can reason about them.
   284	
   285	    Refuses a config whose gauntlet names a seat that doesn't exist, or a seat missing a
   286	    family — both would blow up later, mid-panel, where it's far harder to see.
   287	    """
   288	    missing = unresolved_reviewers(cfg)
   289	    if missing:
   290	        raise DispatchRefused(f"gauntlet names seats that don't exist: {missing}")
   291	    for seat_id, s in cfg.get("seats", {}).items():
   292	        if "family" not in s:
   293	            raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
   294	    for seat_id, s in cfg.get("seats", {}).items():
   295	        upsert_seat(conn, Seat(
   296	            id=seat_id,
   297	            provider=s["provider"],
   298	            model=s["model"],
   299	            family=s["family"],
   300	            tier=s["tier"],
   301	            daily_cap_cents=s.get("daily_cap_cents"),
   302	            build_cap_cents=s.get("build_cap_cents"),
   303	            review_cap_cents=s.get("review_cap_cents"),
   304	            enabled=not s.get("disabled", False),
   305	            notes=s.get("notes", ""),
   306	        ))
   307	
   308	
   309	# ---------------------------------------------------------------------------
   310	# Dispatch
     1	"""The review panel (spec §6, task #10) — several different minds check the same work,
     2	at the same time, against one frozen version.
     3	
     4	Before this file, dispatch ran ONE reviewer. That is enough to close the loop and it is
     5	not the design: the property this project exists to guarantee is that *a different mind*
     6	looked, because different model families miss different bugs. One reviewer cannot
     7	provide it, and a panel of three seats that all run on the same model provides it no
     8	better — which is why the floor counts FAMILIES, not seats.
     9	
    10	Four things are load-bearing here:
    11	
    12	  1. ONE FROZEN BUNDLE. Every reviewer is handed the identical version string and the
    13	     identical code. Nothing re-reads the job row mid-panel. Two verdicts must never
    14	     bind to two different versions of "the same" work.
    15	
    16	  2. NOTHING IS ASSUMED — only recorded. A family counts when a verdict from that
    17	     family is on the record for THIS version. A reviewer that was skipped, capped out,
    18	     or crashed contributes nothing, and the panel says so out loud (see `runs`).
    19	
    20	  3. FAIL CLOSED. Too few families, any failure, any unanswered escalation → the job
    21	     stays parked. The panel never lowers the bar to reach a conclusion, and it never
    22	     forces a status past the database guards. It feeds them.
    23	
    24	  4. THE DATABASE IS THE BOUNDARY, NOT THIS FILE. Everything below is also enforced in
    25	     schema.sql as triggers. If this module were wrong, or replaced by something
    26	     careless, the guards would still refuse. That is deliberate: Python decides what to
    27	     TRY; the schema decides what is ALLOWED.
    28	
    29	Threads, not async: each reviewer is a subprocess call that blocks for tens of seconds,
    30	and each thread opens its OWN sqlite connection (connections are not shareable across
    31	threads).
    32	"""
    33	
    34	from __future__ import annotations
    35	
    36	import json
    37	import os
    38	import subprocess
    39	import tempfile
    40	import threading
    41	import urllib.error
    42	import urllib.request
    43	from dataclasses import dataclass, field
    44	from pathlib import Path
    45	from typing import Any, Callable
    46	
    47	from db.jobs import (
    48	    GuardViolation,
    49	    connect,
    50	    over_budget,
    51	    record_verdict,
    52	    seat,
    53	    set_status,
    54	)
    55	
    56	DB_PATH = Path(__file__).resolve().parent / "db" / "chief.db"
    57	
    58	REVIEW_TIMEOUT_S = 300          # a reviewer that hasn't answered by now has hung
    59	JOIN_GRACE_S = 30               # how long past its own timeout we wait for a thread
    60	DEFAULT_ESTIMATE_CENTS = 5      # what we reserve for a metered review before calling
    61	
    62	
    63	# ---------------------------------------------------------------------------
    64	# The reviewers themselves. One function per provider — adding a family to the
    65	# panel is adding a function here and a seat in seats.toml. Nothing else.
    66	#
    67	# LOCKDOWN (task #10 hardening, 2026-08-27). Sol's design gate found the softest target
    68	# in the whole panel: these calls ran on attacker-controllable text (a builder-written
    69	# diff) using the caller's own default CLI settings — ambient tool access, MCP servers,
    70	# extra directory grants, up to and including a medical-records repo grant that had
    71	# nothing to do with this project. And on the way out, `_parse_verdict` (removed below)
    72	# accepted any line starting with the word "PASS" — including one echoed straight out of
    73	# our own prompt, or planted in a diff a builder wrote. Two fixes, together:
    74	#
    75	#   1. Every CLI call below runs with every lockdown flag its `--help` actually offers —
    76	#      no ambient settings, no MCP, no tools, restricted mode. Checked against `claude
    77	#      --help` / `codex exec --help` on this machine, not assumed from memory. See
    78	#      test_reviewer_lockdown.py and assert_reviewers_locked_down() below, which fails
    79	#      loud if a future refactor ever drops one of these flags.
    80	#   2. Nobody scans free-text output for a magic word anymore. Every runner asks its
    81	#      provider for a STRUCTURED answer (claude: --json-schema, codex: --output-schema,
    82	#      xai: response_format=json_object) and reads only the structured field. Anything
    83	#      else — an echo, a narration line, a diff that happens to contain the string
    84	#      "PASS looks great" — is not JSON in the field we read, so it cannot become a
    85	#      verdict. It becomes ReviewerBroke: a skip, never a pass.
    86	# ---------------------------------------------------------------------------
    87	REVIEW_PROMPT = (
    88	    "You are reviewing another model's work. Judge it only by what is shown below: does "
    89	    "it actually do what was asked, and is it correct?\n\n"
    90	    "Answer with a JSON object with exactly these two fields:\n"
    91	    '  "verdict" — the string "pass" (it is correct and does what was asked) or "fail" '
    92	    "(it is wrong, incomplete, or unsafe)\n"
    93	    '  "reason" — one sentence, at most 280 characters, saying why\n\n'
    94	    "The task was: {request}\n\nThe work:\n{code}"
    95	)
    96	
    97	
    98	MAX_CODE_CHARS = 200_000        # past this we don't ask anyone to review it (see #7 below)
    99	
   100	# The shared shape every reviewer's structured answer must match. codex's structured-
   101	# output endpoint additionally refuses an object schema that doesn't say
   102	# "additionalProperties": false explicitly (confirmed against a live call, 2026-08-27),
   103	# so it gets its own copy rather than mutating this one.
   104	VERDICT_SCHEMA: dict[str, Any] = {
   105	    "type": "object",
   106	    "properties": {
   107	        "verdict": {"enum": ["pass", "fail"]},
   108	        "reason": {"type": "string", "maxLength": 280},
   109	    },
   110	    "required": ["verdict", "reason"],
   111	}
   112	CODEX_VERDICT_SCHEMA: dict[str, Any] = {**VERDICT_SCHEMA, "additionalProperties": False}
   113	
   114	
   115	class ReviewerBroke(RuntimeError):
   116	    """The reviewer never rendered a judgement — the TOOL failed, not the work.
   117	
   118	    This distinction is the whole reason the class exists. A CLI that exits non-zero
   119	    (expired login, rate limit, renamed model), or one that exits 0 with no parseable
   120	    structured answer, has not reviewed anything — so treating its output as an answer
   121	    would record a FAIL against the build. Verdicts are permanent and bound to the
   122	    version, so an infrastructure hiccup would condemn good work forever, and tell Neill
   123	    a reviewer "found a problem" when nothing reviewed anything. A broken reviewer is a
   124	    SKIP.
   125	    """
   126	
   127	
   128	def _prompt(request: str, code: str) -> str:
   129	    return REVIEW_PROMPT.format(request=request, code=code)
   130	
   131	
   132	def _run_cli_stdin(cmd: list[str], prompt: str) -> str:
   133	    """Run a reviewer CLI with the prompt on stdin — never as a positional argument.
   134	
   135	    Two reasons, both load-bearing: the lockdown flags below are variadic (`--tools
   136	    <tools...>`, `--json-schema <schema>`) and a positional prompt placed after them
   137	    would be swallowed as another value for the wrong flag rather than reaching the
   138	    model. And argv is visible to anyone on the box who can list processes; stdin is not.
   139	    """
   140	    proc = subprocess.run(
   141	        cmd, input=prompt, capture_output=True, text=True, timeout=REVIEW_TIMEOUT_S,
   142	    )
   143	    if proc.returncode != 0:
   144	        raise ReviewerBroke(
   145	            f"{cmd[0]} exited {proc.returncode}: "
   146	            f"{(proc.stderr or proc.stdout).strip()[:200]}"
   147	        )
   148	    return proc.stdout
   149	
   150	
   151	def _read_structured(structured: Any) -> tuple[str, str]:
   152	    """The ONLY door a verdict can walk through, for all three providers.
   153	
   154	    No stdout scan, no substring match, no trusting a free-text field — a provider that
   155	    didn't hand back a dict shaped like VERDICT_SCHEMA has not answered, full stop. This
   156	    is what makes a diff containing the literal line "PASS looks great" inert: that text
   157	    has to land in a JSON field named "verdict" holding exactly "pass", or it changes
   158	    nothing.
   159	    """
   160	    if not isinstance(structured, dict):
   161	        raise ReviewerBroke("the reviewer did not answer in the structured form we required")
   162	    verdict = structured.get("verdict")
   163	    reason = structured.get("reason")
   164	    if verdict not in ("pass", "fail"):
   165	        raise ReviewerBroke("the reviewer's structured answer had no valid verdict field")
   166	    if not isinstance(reason, str) or not reason.strip():
   167	        raise ReviewerBroke("the reviewer's structured answer had no reason")
   168	    return verdict, reason.strip()[:280]
   169	
   170	
   171	def _last_json_object(text: str) -> Any:
   172	    """Read backwards for the model's actual structured answer.
   173	
   174	    codex prints the run's narration (banner, token count) around the answer it wrote to
   175	    satisfy --output-schema; the same "read from the end" reasoning the old line-scan
   176	    used still applies — the model's real answer comes last. Unlike the old scan, a line
   177	    only counts here if it parses as JSON; free text (an echoed prompt, a narrated "PASS
   178	    looks great") is never mistaken for one.
   179	    """
   180	    for line in reversed(text.splitlines()):
   181	        stripped = line.strip()
   182	        if not stripped:
   183	            continue
   184	        try:
   185	            return json.loads(stripped)
   186	        except ValueError:
   187	            continue
   188	    raise ReviewerBroke("the reviewer did not answer in the structured form we required")
   189	
   190	
   191	# --- Claude family --------------------------------------------------------------
   192	def _claude_cmd(model: str) -> list[str]:
   193	    """Every flag here was checked against `claude --help` on this machine, 2026-08-27 —
   194	    none is assumed. See test_reviewer_lockdown.py for the flag-by-flag proof."""
   195	    return [
   196	        "claude", "-p",
   197	        "--setting-sources", "",       # no user/project/local settings load at all
   198	        "--strict-mcp-config",         # ...so no MCP server the caller happens to have
   199	        "--restricted",                # ...no Bash/file-running tools, no reading outside
   200	        "--safe-mode",                 #    the working dirs, no hooks/skills/plugins
   201	        "--tools", "",                 # belt-and-braces on top of --restricted: no tools
   202	        "--output-format", "json",
   203	        "--json-schema", json.dumps(VERDICT_SCHEMA),
   204	        "--model", model,
   205	    ]
   206	
   207	
   208	def _claude_review(request: str, code: str, model: str) -> tuple[str, str]:
   209	    """The Claude-family reviewer — locked down against exactly what Sol's design gate
   210	    flagged: a reviewer call running on attacker-controllable text (a builder-written
   211	    diff) with the caller's own ambient tool access, MCP connections and directory
   212	    grants. `--output-format json` puts the answer in a `structured_output` field
   213	    (confirmed with a live call, 2026-08-27); that field is the only thing read below —
   214	    never the free-text `result` string, which is a request-shaped answer echo, not a
   215	    contract.
   216	    """
   217	    raw = _run_cli_stdin(_claude_cmd(model), _prompt(request, code))
   218	    try:
   219	        result = json.loads(raw)
   220	    except ValueError as exc:
   221	        raise ReviewerBroke("the reviewer's reply wasn't readable JSON") from exc
   222	    if not isinstance(result, dict):
   223	        raise ReviewerBroke("the reviewer's reply wasn't the JSON envelope we expected")
   224	    if result.get("is_error"):
   225	        raise ReviewerBroke(f"the reviewer errored: {str(result.get('result', ''))[:160]}")
   226	    return _read_structured(result.get("structured_output"))
   227	
   228	
   229	# --- Codex / GPT family ----------------------------------------------------------
   230	def _codex_cmd(model: str, schema_path: Path) -> list[str]:
   231	    """Every flag here was checked against `codex exec --help` on this machine,
   232	    2026-08-27. codex has no `--json-schema <string>` like claude's; --output-schema
   233	    only takes a file, so the schema is written to a short-lived temp file per call
   234	    (see _codex_review) rather than kept as a long-lived shared path."""
   235	    return [
   236	        "codex", "exec",
   237	        "--sandbox", "read-only",       # reads the bundle it was handed; writes nothing
   238	        "--skip-git-repo-check",        # it is not operating on a checkout
   239	        # The GPT cross-model review (2026-08-27) proved the two lines above are NOT
   240	        # "no tools": codex's built-in web tool talks to OpenAI's backend, outside the
   241	        # sandbox, and fetched an outside URL when told to from INSIDE the reviewed
   242	        # code. And ~/.codex/config.toml (a trusted-project grant for the medical repo
   243	        # among it) was still being loaded. Verified live: with all of the below, the
   244	        # same instruction answers NO_WEB_TOOL.
   245	        "--ignore-user-config",         # no trusted-project grants, no MCP servers
   246	        "-c", 'web_search="disabled"',  # the built-in web tool
   247	        *[f for feat in CODEX_FEATURES_OFF for f in ("--disable", feat)],
   248	        "--model", model,
   249	        "--output-schema", str(schema_path),
   250	        "-",                            # read the prompt from stdin, never argv
   251	    ]
   252	
   253	
   254	# codex features a reviewer must not have. Names from `codex features list` on this
   255	# machine (stable ones only — a removed/unknown name makes codex exit with usage).
   256	CODEX_FEATURES_OFF = ("browser_use", "browser_use_external", "in_app_browser",
   257	                      "computer_use", "multi_agent", "image_generation", "plugins", "apps")
   258	
   259	
   260	def _codex_review(request: str, code: str, model: str) -> tuple[str, str]:
   261	    """The GPT-family reviewer, through the codex CLI."""
   262	    with tempfile.TemporaryDirectory(prefix="chief-review-") as tmp:
   263	        schema_path = Path(tmp) / "verdict_schema.json"
   264	        schema_path.write_text(json.dumps(CODEX_VERDICT_SCHEMA))
   265	        out = _run_cli_stdin(_codex_cmd(model, schema_path), _prompt(request, code))
   266	    return _read_structured(_last_json_object(out))
   267	
   268	
   269	# --- Grok / xai family -------------------------------------------------------------
   270	XAI_CHAT_URL = "https://api.x.ai/v1/chat/completions"
   271	XAI_KEY_VAR = "XAI_API_KEY"
   272	MAX_REPLY_BYTES = 1_000_000     # a verdict is one small JSON object; anything bigger isn't
   273	
   274	
   275	def _xai_review(request: str, code: str, model: str) -> tuple[str, str]:
   276	    """The Grok-family reviewer, straight over HTTP.
   277	
   278	    No CLI here on purpose: Grok's CLI has been alleged to upload whole checkouts, and
   279	    the reviewer must only ever see the bundle it is handed. Plain urllib rather than an
   280	    SDK so the seat adds no dependency — the API is OpenAI-shaped and one POST is all a
   281	    review needs. `response_format: json_object` is xai's structured-output mode
   282	    (confirmed against a live call, 2026-08-27); it guarantees valid JSON, not our exact
   283	    keys, so the prompt still names them and _read_structured still checks them. The key
   284	    comes from the environment the server loads (~/.chief/env), never from the repo. A
   285	    missing key is the TOOL failing, so it is a skip, never a verdict — same rule as a
   286	    CLI exiting non-zero.
   287	    """
   288	    key = os.environ.get(XAI_KEY_VAR, "").strip()
   289	    if not key:
   290	        raise ReviewerBroke("the paid reviewer has no sign-in key on this machine")
   291	    body = json.dumps({
   292	        "model": model,
   293	        "temperature": 0,
   294	        "response_format": {"type": "json_object"},
   295	        "messages": [{"role": "user", "content": _prompt(request, code)}],
   296	    }).encode()
   297	    req = urllib.request.Request(
   298	        XAI_CHAT_URL, data=body, method="POST",
   299	        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
   300	    )
   301	    try:
   302	        with urllib.request.urlopen(req, timeout=REVIEW_TIMEOUT_S) as resp:
   303	            payload = json.loads(resp.read(MAX_REPLY_BYTES).decode("utf-8", "replace"))
   304	    except urllib.error.HTTPError as exc:
   305	        # Status code only. The body is vendor text and could echo anything — it never
   306	        # reaches the record, which is what Neill reads.
   307	        why = {401: "its sign-in key was refused", 403: "it isn't allowed to do that",
   308	               429: "it is being rate-limited right now"}.get(exc.code,
   309	               f"it answered with error {exc.code}")
   310	        raise ReviewerBroke(f"the paid reviewer couldn't run — {why}") from exc
   311	    except (urllib.error.URLError, TimeoutError, OSError) as exc:
   312	        raise ReviewerBroke("the paid reviewer couldn't be reached") from exc
   313	    except ValueError as exc:                       # not JSON
   314	        raise ReviewerBroke("the paid reviewer sent back something unreadable") from exc
   315	    try:
   316	        choice = payload["choices"][0]
   317	        text = choice["message"]["content"] or ""
   318	    except (KeyError, IndexError, TypeError) as exc:
   319	        raise ReviewerBroke("the paid reviewer sent back no answer") from exc
   320	    # An empty answer, or one cut off before the closing brace, is the TOOL failing.
   321	    if not text.strip():
   322	        raise ReviewerBroke("the paid reviewer answered with nothing")
   323	    if choice.get("finish_reason") not in (None, "stop"):
   324	        raise ReviewerBroke("the paid reviewer was cut off before it finished")
   325	    try:
   326	        structured = json.loads(text)
   327	    except ValueError as exc:
   328	        raise ReviewerBroke("the paid reviewer's reply wasn't readable JSON") from exc
   329	    return _read_structured(structured)
   330	
   331	
   332	REVIEWERS: dict[str, Callable[[str, str, str], tuple[str, str]]] = {
   333	    "claude-cli": _claude_review,
   334	    "codex": _codex_review,
   335	    "xai": _xai_review,
   336	}
   337	
   338	
   339	# ---------------------------------------------------------------------------
   340	# Can the runner actually run HERE, now? A runner that exists but is logged out, or has
   341	# no key, would be counted onto every new job's panel and then skip — parking the job
   342	# forever with "3 required, 2 reported". Better one legible exclusion at the door.
   343	# ---------------------------------------------------------------------------
   344	def _claude_ready() -> bool:
   345	    """`claude auth status` prints JSON with a `loggedIn` field and exits 0 whether or
   346	    not it's logged in (confirmed with a live call, 2026-08-27) — so the exit code alone
   347	    is not enough; the field has to say so. `~/.claude` missing entirely is checked first
   348	    as a cheap short-circuit before spending a subprocess call."""
   349	    if not (Path.home() / ".claude").exists():
   350	        return False
   351	    try:
   352	        proc = subprocess.run(["claude", "auth", "status"], capture_output=True,
   353	                              text=True, timeout=15)
   354	    except (OSError, subprocess.TimeoutExpired):
   355	        return False
   356	    if proc.returncode != 0:
   357	        return False
   358	    try:
   359	        return bool(json.loads(proc.stdout).get("loggedIn"))
   360	    except ValueError:
   361	        return False
   362	
   363	
   364	def _codex_ready() -> bool:
   365	    """`codex login status` exits non-zero when logged out (the nearest equivalent to
   366	    claude's status field — codex has no machine-readable flag on this command)."""
   367	    try:
   368	        proc = subprocess.run(["codex", "login", "status"], capture_output=True,
   369	                              text=True, timeout=15)
   370	    except (OSError, subprocess.TimeoutExpired):
   371	        return False
   372	    return proc.returncode == 0
   373	
   374	
   375	_READY: dict[str, Callable[[], bool]] = {
   376	    "xai": lambda: bool(os.environ.get(XAI_KEY_VAR, "").strip()),
   377	    "claude-cli": _claude_ready,
   378	    "codex": _codex_ready,
   379	}
   380	
   381	
   382	def has_runner(provider: str) -> bool:
   383	    return provider in REVIEWERS and _READY.get(provider, lambda: True)()
   384	
   385	
   386	# ---------------------------------------------------------------------------
   387	# The startup self-check. Every other guarantee in this module assumes the reviewer
   388	# CLIs are actually running locked down — this is the one place that verifies it,
   389	# rather than trusting that nobody ever edits _claude_cmd/_codex_cmd without noticing
   390	# what they removed.
   391	# ---------------------------------------------------------------------------
   392	def _flag_value(argv: list[str], flag: str) -> str | None:
   393	    try:
   394	        i = argv.index(flag)
   395	    except ValueError:
   396	        return None
   397	    return argv[i + 1] if i + 1 < len(argv) else None
   398	
   399	
   400	def assert_reviewers_locked_down() -> None:
   401	    """Inspect the argv the runners would actually build and refuse to run the panel if
   402	    a lockdown flag is missing.
   403	
   404	    This builds argv only — it never spawns a process — so it is cheap enough to call on
   405	    every panel run. Called from run_panel(), which means a bad deploy (a refactor that
   406	    drops --restricted, a codex upgrade that renames --sandbox) fails the FIRST review
   407	    job loudly, instead of quietly running every review after it wide open.
   408	    """
   409	    claude_argv = _claude_cmd("probe-model")
   410	    codex_argv = _codex_cmd("probe-model", Path("/tmp/chief-review-probe/verdict_schema.json"))
   411	
   412	    failures: list[str] = []
   413	    if _flag_value(claude_argv, "--setting-sources") != "":
   414	        failures.append("claude: --setting-sources must be present and empty")
   415	    if "--strict-mcp-config" not in claude_argv:
   416	        failures.append("claude: --strict-mcp-config is missing")
   417	    if "--restricted" not in claude_argv:
   418	        failures.append("claude: --restricted is missing")
   419	    if "--safe-mode" not in claude_argv:
   420	        failures.append("claude: --safe-mode is missing")
   421	    if _flag_value(claude_argv, "--tools") != "":
   422	        failures.append("claude: --tools must be present and empty (no tool access)")
   423	    if not _flag_value(claude_argv, "--json-schema"):
   424	        failures.append("claude: --json-schema is missing")
   425	    if _flag_value(claude_argv, "--output-format") != "json":
   426	        failures.append("claude: --output-format json is missing")
   427	    if "--ignore-user-config" not in codex_argv:
   428	        failures.append("codex: --ignore-user-config is missing")
   429	    if 'web_search="disabled"' not in codex_argv:
   430	        failures.append("codex: web_search is not disabled")
   430	        failures.append("codex: web_search is not disabled")
   431	    for feat in CODEX_FEATURES_OFF:
   432	        if feat not in codex_argv:
   433	            failures.append(f"codex: feature '{feat}' is not disabled")
   434	
   435	    if _flag_value(codex_argv, "--sandbox") != "read-only":
   436	        failures.append("codex: --sandbox read-only is missing")
   437	    if "--skip-git-repo-check" not in codex_argv:
   438	        failures.append("codex: --skip-git-repo-check is missing")
   439	    if not _flag_value(codex_argv, "--output-schema"):
   440	        failures.append("codex: --output-schema is missing")
   441	
   442	    if failures:
   443	        raise RuntimeError(
   444	            "reviewer lockdown check failed — refusing to run the panel: "
   445	            + "; ".join(failures)
   446	        )
   447	
   448	
   449	# ---------------------------------------------------------------------------
   450	# What came back
   451	# ---------------------------------------------------------------------------
   452	@dataclass
   453	class ReviewerRun:
   454	    """One seat's participation — including the ones that did NOT participate.
   455	
   456	    A skipped reviewer is part of the result, never an omission. "No silent caps": a
   457	    panel that quietly shrank reads as a full panel to anyone looking at the verdicts.
   458	    """
   459	    seat_id: str
   460	    family: str = ""
   461	    verdict: str | None = None      # pass | fail | needs_human | None if it never ran
   462	    summary: str = ""
   463	    skipped: str = ""               # why it didn't run, in plain words
   464	
   465	    @property
   466	    def ran(self) -> bool:
   467	        return self.verdict is not None
   468	
   469	
   470	@dataclass
   471	class PanelResult:
   472	    job_id: int
   473	    version: str
   474	    required_families: int
   475	    runs: list[ReviewerRun] = field(default_factory=list)
   476	    certified: bool = False         # did the job actually reach 'done'
   477	    parked_reason: str = ""         # if not, why — in plain words
   478	
   479	    builder_family: str = ""        # the author is not a second opinion (migration 007)
   480	
   481	    @property
   482	    def families_passed(self) -> set[str]:
   483	        """Counted the way the database counts: minds OTHER than the author's."""
   484	        return {r.family for r in self.runs
   485	                if r.verdict == "pass" and r.family != self.builder_family}
   486	
   487	    @property
   488	    def failed(self) -> list[ReviewerRun]:
   489	        return [r for r in self.runs if r.verdict == "fail"]
   490	
   491	    def as_dict(self) -> dict[str, Any]:
   492	        return {
   493	            "job_id": self.job_id,
   494	            "version": self.version,
   495	            "required_families": self.required_families,
   496	            "families_passed": sorted(self.families_passed),
   497	            "certified": self.certified,
   498	            "parked_reason": self.parked_reason,
   499	            "runs": [
   500	                {"seat": r.seat_id, "family": r.family, "verdict": r.verdict,
   501	                 "summary": r.summary, "skipped": r.skipped}
   502	                for r in self.runs
   503	            ],
   504	        }
   505	
   506	    def spoken(self) -> str:
   507	        """One sentence for the voice. No seat names, no jargon."""
   508	        n = len([r for r in self.runs if r.ran])
   509	        minds = len(self.families_passed)
   510	        if self.certified:
   511	            return f"{n} different models checked it and it passed. Ready for you."
   512	        if self.failed:
   513	            return "It was checked and sent back — one of the reviewers found a problem."
   514	        return f"Only {minds} of the {self.required_families} required models could check it, so it's waiting."
   515	
   516	
   517	# ---------------------------------------------------------------------------
   518	# The panel
   519	# ---------------------------------------------------------------------------
   520	def _event(conn, job_id: int, seat_row, kind: str, detail: str) -> None:
   521	    conn.execute(
   522	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   523	        "VALUES (?, ?, ?, ?, ?, ?, ?)",
   524	        (job_id, seat_row["id"], seat_row["id"], seat_row["model"],
   525	         seat_row["family"], kind, detail),
   526	    )
   527	
   528	
   529	def _reserve_review_budget(conn, seat_id: str, job_id: int, cents: int) -> bool:
   530	    """Take the money BEFORE the call, not after.
   531	
   532	    Sol: "refusing to RECORD a charge doesn't unspend it." Two reviewers reserving at
   533	    once both hit the ledger, and the ledger's own cap trigger refuses the one that
   534	    would breach — so the race resolves in the database, not in a Python check that
   535	    both threads passed a moment earlier. Uncapped seats reserve nothing.
   536	    """
   537	    row = seat(conn, seat_id)
   538	    if row is None:
   539	        return True
   540	    # ALWAYS go through the ledger, even for a seat with no daily cap. Skipping the write
   541	    # when daily_cap_cents was NULL meant the MONTHLY budget and the per-role review
   542	    # ration never saw those calls at all — and today's two working reviewers are both
   543	    # uncapped, so that was every review in production. A flat-rate seat records 0 and
   544	    # still shows up in the account of what ran.
   545	    if row["tier"] != "metered":
   546	        cents = 0
   547	    # ASK, don't take. Spending is the gatekeeper's power (task #11) — the panel is a
   548	    # caller like any other, and gets no special path to the money because it happens
   549	    # to live in the same process.
   550	    import gatekeeper
   551	    try:
   552	        gatekeeper.spend(conn, seat_id, cents, job_id=job_id, role="review",
   553	                         asked_by="the review panel")
   554	        return True
   555	    except gatekeeper.Refused:
   556	        return False
   557	
   558	
   559	def _review_one(
   560	    job_id: int,
   561	    seat_id: str,
   562	    request: str,
   563	    code: str,
   564	    version: str,
   565	    cfg: dict[str, Any],
   566	    out: ReviewerRun,
   567	    db_path: Path,
   568	    decided: threading.Event,
   569	) -> None:
   570	    """One reviewer, in its own thread, on its own connection. Never raises.
   571	
   572	    The outer try/except is not belt-and-braces. ANY escape from this function kills the
   573	    thread with the run left blank — neither a verdict nor a stated reason — and a
   574	    reviewer that is neither counted nor excused is precisely the silent shrink this
   575	    panel exists to prevent. So every exit lands in `out`.
   576	    """
   577	    conn = None
   578	    try:
   579	        conn = connect(db_path)
   580	        row = seat(conn, seat_id)
   581	        if row is None:
   582	            out.skipped = "that reviewer isn't set up"
   583	            return
   584	        out.family = row["family"]
   585	        if not row["enabled"]:
   586	            out.skipped = "that reviewer is turned off"
   587	            _event(conn, job_id, row, "skipped", out.skipped)
   588	            return
   589	        runner = REVIEWERS.get(row["provider"])
   590	        if runner is None:
   591	            out.skipped = "we can't run that reviewer on this machine yet"
   592	            _event(conn, job_id, row, "skipped", out.skipped)
   593	            return
   594	
   595	        # Already reviewed this exact version? Then this is a re-run, and repeating it
   596	        # would spend the money twice and stack duplicate verdicts on the record. This
   597	        # check runs BEFORE the budget check below, on purpose: a retry must not throw
   598	        # away a reviewer's earlier PASS just because that seat is capped out today —
   599	        # the verdict was already earned and paid for.
   600	        already = conn.execute(
   601	            "SELECT verdict, summary FROM verdicts WHERE job_id=? AND reviewer_seat=? "
   602	            "AND reviewed_version IS ? ORDER BY id DESC LIMIT 1",
   603	            (job_id, seat_id, version),
   604	        ).fetchone()
   605	        if already is not None:
   606	            out.verdict, out.summary = already["verdict"], already["summary"] or ""
   607	            return
   608	
   609	        # Preflight size check, before any money moves or any provider is called. A
   610	        # reviewer that silently judged part of the work would be worse than one that
   611	        # didn't run — and truncating-then-asking would eventually FAIL the version
   612	        # forever on a build that simply grew past what one review call can hold. Skip
   613	        # plainly instead; skips can be retried, a truncated FAIL cannot be un-said.
   614	        if len(code) > MAX_CODE_CHARS:
   615	            out.skipped = "the work is too large to review in one go"
   616	            _event(conn, job_id, row, "skipped", out.skipped)
   617	            return
   618	
   619	        if over_budget(conn, seat_id):
   620	            out.skipped = "that reviewer is out of budget for today"
   621	            _event(conn, job_id, row, "skipped", out.skipped)
   622	            return
   623	
   624	        estimate = int(
   625	            cfg.get("seats", {}).get(seat_id, {}).get(
   626	                "review_estimate_cents", DEFAULT_ESTIMATE_CENTS)
   627	        )
   628	        if not _reserve_review_budget(conn, seat_id, job_id, estimate):
   629	            out.skipped = "that reviewer is out of budget for today"
   630	            _event(conn, job_id, row, "skipped", out.skipped)
   631	            return
   632	
   633	        _event(conn, job_id, row, "thinking", "Checking the work.")
   634	        try:
   635	            verdict, summary = runner(request, code, row["model"])
   636	        except subprocess.TimeoutExpired:
   637	            out.skipped = "that reviewer took too long and was stopped"
   638	            _event(conn, job_id, row, "error", out.skipped)
   639	            return
   640	        except ReviewerBroke as exc:
   641	            # The TOOL failed, not the work. Never a verdict — see ReviewerBroke.
   642	            out.skipped = "that reviewer couldn't run"
   643	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:160]}")
   644	            return
   645	        except Exception as exc:                      # noqa: BLE001 — a dead reviewer
   646	            out.skipped = "that reviewer couldn't finish"   # is a skip, never a pass
   647	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:120]}")
   648	            return
   649	
   650	        # The panel has already decided and moved on without us. Recording now would
   651	        # land a verdict on a job that was called finished a moment ago — and if it were
   652	        # a FAIL, the completion guards could no longer act on it, because they only fire
   653	        # on the way INTO done. A late answer is a non-answer.
   654	        if decided.is_set():
   655	            out.skipped = "that reviewer answered after the panel had already decided"
   656	            _event(conn, job_id, row, "skipped", out.skipped)
   657	            return
   658	
   659	        # reviewed_version is passed EXPLICITLY, never defaulted. The default reads the
   660	        # job's current head — which is only correct if nothing moved, and the whole
   661	        # point of the frozen bundle is not to depend on that being true.
   662	        try:
   663	            record_verdict(conn, job_id, seat_id, verdict=verdict,
   664	                           summary=summary, role="reviewer", reviewed_version=version)
   665	        except GuardViolation as exc:
   666	            out.skipped = "the record refused that verdict"
   667	            _event(conn, job_id, row, "error", str(exc)[:160])
   668	            return
   669	
   670	        # The `decided` check above and this write are not one step: the panel can
   671	        # decide and certify in between. A FAIL that lands after 'done' must un-certify
   672	        # from THIS side too — the writer is the only one who knows it just happened.
   673	        # `decided` is THIS panel's flag. Another panel on the same job (a re-run, a
   674	        # second dispatch) may have certified it already — so the check is on the
   675	        # record, not on our own bookkeeping.
   676	        if verdict == "fail":
   677	            status = conn.execute("SELECT status FROM jobs WHERE id = ?",
   678	                                  (job_id,)).fetchone()["status"]
   679	            if status == "done":
   680	                set_status(conn, job_id, "review",
   681	                           spoken_summary="Sent back — a reviewer found a problem.")
   682	            elif status == "shipped":
   683	                # Too late to un-merge. The one thing we can still do is refuse to be
   684	                # quiet about it: a merged objection is Neill's to see, not a footnote.
   685	                set_status(conn, job_id, "shipped",
   686	                           spoken_summary="⚠ A reviewer objected AFTER this was merged — "
   687	                                          "it needs your eyes.")
   688	                _event(conn, job_id, row, "error",
   689	                       "objection recorded after merge — needs a person")
   690	
   691	        out.summary = summary
   692	        out.verdict = verdict          # set LAST: `verdict` is what marks the run as real
   693	        _event(conn, job_id, row, "verdict",
   694	               "Passed the check." if verdict == "pass" else "Sent it back with notes.")
   695	    except Exception as exc:                          # noqa: BLE001
   696	        out.skipped = out.skipped or f"that reviewer couldn't finish: {str(exc)[:120]}"
   697	    finally:
   698	        if conn is not None:
   699	            conn.close()
   700	
