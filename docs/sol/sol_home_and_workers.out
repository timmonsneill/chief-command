    77	def _commit_in_worktree(wt: Path, job_id: int, branch: str, summary: str) -> str | None:
    78	    """Commit the job's output on its own branch and return the commit id.
    79	
    80	    This is what makes the gatekeeper's merge possible at all: it refuses unless the
    81	    branch tip IS the reviewed version, and a version has to be a commit for that to be
    82	    provable. If anything here fails, the caller falls back to a content hash — the job
    83	    is still reviewable, it just can never be merged by the gatekeeper, which is the
    84	    honest outcome for work that isn't in git.
    85	    """
    86	    env = {**os.environ,
    87	           "GIT_AUTHOR_NAME": "chief-worker", "GIT_AUTHOR_EMAIL": "worker@chief.local",
    88	           "GIT_COMMITTER_NAME": "chief-worker", "GIT_COMMITTER_EMAIL": "worker@chief.local"}
    89	    def git(*args):
    90	        return subprocess.run(["git", *args], cwd=wt, capture_output=True, text=True,
    91	                              timeout=60, env=env)
    92	    try:
    93	        if git("rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
    94	            return None
    95	        if git("checkout", "-B", branch).returncode != 0:
    96	            return None
    97	        if git("add", "-A", OUTPUT_DIRNAME).returncode != 0:
    98	            return None
    99	        if git("commit", "-q", "-m", f"job {job_id}: {summary[:60]}").returncode != 0:
   100	            return None
   101	        sha = git("rev-parse", "HEAD").stdout.strip()
   102	    except (subprocess.TimeoutExpired, OSError):
   103	        return None          # a hung git is "not in git", not a dead worker thread
   104	    return sha[:16] if len(sha) >= 16 else None
   105	
   106	
   107	def _version_of(text: str) -> str:
   108	    """The exact content being put forward, as a short hash. This is what the whole
   109	    review-to-version chain binds to: change the output, change the version, and every
   110	    earlier approval silently stops counting (schema.sql, gate 3)."""
   111	    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]
   112	
   113	
   114	# ---------------------------------------------------------------------------
   115	# Worktree isolation — a builder never touches the live project.
   116	# ---------------------------------------------------------------------------
   117	def _make_worktree(job_id: int, branch: str, source_repo: Path | None = None,
   118	                   source_branch: str = "main") -> tuple[Path | None, str]:
   119	    """Give this job its own private copy of the repo. Returns (path, note).
   120	
   121	    Checks out `source_branch` EXPLICITLY — a live wiring review found the earlier
   122	    version left the branch unnamed, which meant "whatever the source repo's
   123	    working copy happens to be sitting on right now" (the same class of bug
   124	    `db.projects._default_branch` was fixed for). A builder's starting point must be
   125	    the project's actual main line, not an accident of what a person or another job
   126	    left checked out.
   127	
   128	    If git worktrees aren't usable for any reason, fall back to a plain isolated
   129	    directory and SAY SO — a silent fallback that quietly drops isolation would be
   130	    exactly the kind of unspoken gap this project keeps getting bitten by.
   131	    """
   132	    WORKTREES.mkdir(exist_ok=True)
   133	    dest = WORKTREES / f"job-{job_id}"
   134	    if dest.exists():
   135	        return dest, "reused"
   136	    source_repo = source_repo if source_repo is not None else HARNESS.parent
   137	    try:
   138	        subprocess.run(
   139	            ["git", "worktree", "add", "--detach", str(dest), source_branch],
   140	            cwd=source_repo, capture_output=True, text=True, timeout=60, check=True,
   141	        )
   142	        return dest, "worktree"
   143	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   144	        # Isolation still holds (separate dir, outside the repo tree) — it just isn't a
   145	        # git worktree, so we record that honestly.
   146	        dest.mkdir(parents=True, exist_ok=True)
   147	        detail = getattr(exc, "stderr", "") or str(exc)
   148	        return dest, f"plain-dir ({str(detail)[:60].strip()})"
   149	
   150	
   151	def _make_clone(job_id: int, branch: str, source_repo: Path | None = None,
   152	                source_branch: str = "main") -> tuple[Path | None, str]:
   153	    """A standalone clone for code builders — the isolation a linked worktree
   154	    cannot provide.
   155	
   156	    `git worktree add` shares $GIT_COMMON_DIR with the live repo: .git/config,
   157	    hooks, refs, the object store. A builder holding real Edit/Write tools inside a
   158	    worktree could, in principle, move refs/heads/main or rewrite .git/config —
   159	    Sol's design gate named this explicitly as a hard STOP. A clone has its OWN
   160	    .git; nothing written inside it can touch the source repo's refs or config.
   161	
   162	    NO FALLBACK to a plain directory here (unlike _make_worktree): a code build
   163	    that can't be isolated must not run at all. The local text builder can fall
   164	    back honestly because it has no shell and writes one known file; a code
   165	    builder with edit tools cannot make that same trade.
   166	    """
   167	    CLONES.mkdir(exist_ok=True)
   168	    dest = CLONES / f"job-{job_id}"
   169	    if dest.exists():
   170	        # Sol's design gate: an existing job directory accepted without checking
   171	        # its cleanliness/HEAD is a way to redirect a builder. Refuse to reuse.
   172	        return None, "an isolated copy for this job already exists"
   173	    source_repo = source_repo if source_repo is not None else HARNESS.parent
   174	    try:
   175	        subprocess.run(
   176	            ["git", "clone", "--quiet", "--no-hardlinks", "--branch", source_branch,
   177	             str(source_repo), str(dest)],
   178	            capture_output=True, text=True, timeout=120, check=True,
   179	        )
   180	        subprocess.run(
   181	            ["git", "checkout", "-q", "-B", branch], cwd=dest,
   182	            capture_output=True, text=True, timeout=30, check=True,
   183	        )
   184	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   185	        if dest.exists():
   186	            subprocess.run(["rm", "-rf", str(dest)], capture_output=True, text=True)
   187	        detail = getattr(exc, "stderr", "") or str(exc)
   188	        return None, f"could not create an isolated copy ({str(detail)[:80].strip()})"
   189	    return dest, "clone"
   190	
   191	
   192	def cleanup_clone(job_id: int) -> None:
   193	    """Remove a job's clone AND its settings file.
   194	
   195	    Called from two places with two different meanings: (a) here in this module,
   196	    on every FAILED claude-cli build — a failed job has nothing left worth reading,
   197	    and leaving the clone behind would block a retry (_make_clone refuses to reuse
   198	    an existing job directory). (b) NOT called automatically when a diff job
   199	    reaches 'done' — Neill reads the candidate first; see gauntlet._ask_to_ship's
   200	    diff-kind branch, which deliberately never calls this on the success path.
   201	    """
   202	    dest = CLONES / f"job-{job_id}"
   203	    settings = dest.parent / f"{dest.name}.settings.json"
   204	    if dest.exists():
   205	        subprocess.run(["rm", "-rf", str(dest)], capture_output=True, text=True)
   206	    if settings.exists():
   207	        try:
   208	            settings.unlink()
   209	        except OSError:
   210	            pass
   211	
   212	
   213	def cleanup_worktree(conn, job_id: int) -> None:
   214	    """Remove a job's worktree once its work is merged or abandoned.
   215	
   216	    Runs `git worktree remove` (and a `prune`) against the job's OWN project repo —
