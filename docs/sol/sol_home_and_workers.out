   492	def morning_report(conn) -> list[dict[str, Any]]:
   493	    """What shipped while you slept, and what didn't.
   494	
   495	    Neill is out of the critical path, not out of the loop. This is the difference.
   496	    """
   497	    rows = conn.execute(
   498	        """
   499	        SELECT id, request, status, builder_seat, spoken_summary, finished_at
   500	          FROM jobs
   501	         WHERE created_at >= datetime('now', '-1 day')
   502	         ORDER BY
   503	           CASE status WHEN 'shipped' THEN 0 WHEN 'review' THEN 1
   504	                       WHEN 'failed' THEN 2 ELSE 3 END,
   505	           id
   506	        """
   507	    ).fetchall()
   508	    return [dict(r) for r in rows]
     1	"""The worker. This is the thing that was missing — the reason nothing ran.
     2	
     3	Dispatch (dispatch.py) decides a job MAY run and records it. This module is what
     4	actually DOES it: it takes a queued job, runs the work on the assigned seat's real
     5	model, writes down every step as it goes, and lands a real result. Before this file
     6	existed, Chief said "putting Riggs on it" and no worker ever started.
     7	
     8	Two hard rules, both structural rather than polite:
     9	
    10	  1. THE WORK HAPPENS IN AN ISOLATED WORKTREE, never the live project. A builder gets
    11	     its own private copy of the repo (a git worktree). It physically cannot scribble
    12	     on main while it works — main is untouched until something is reviewed and merged
    13	     by the one service allowed to merge. "One worktree per agent" (owner + Sol).
    14	
    15	  2. LOCAL OUTPUT CANNOT COMPLETE ON ITS OWN. When the free local model finishes, the
    16	     job parks at 'review'. The database guards (schema.sql) refuse to let it reach
    17	     'done' without a higher-tier reviewer passing THIS version. We do not route
    18	     around that here; we feed it.
    19	
    20	Runs in a background thread so the app never blocks — the whole point of the
    21	architecture. sessions come and go; the job row is the durable truth.
    22	"""
    23	
    24	from __future__ import annotations
    25	
    26	import hashlib
    27	import os
    28	import json
    29	import re
    30	import subprocess
    31	import threading
    32	import urllib.request
    33	from dataclasses import dataclass
    34	from pathlib import Path
    35	from typing import Any
    36	
    37	import git_policy
    38	
    39	from db.jobs import (
    40	    connect,
    41	    seat,
    42	    set_head_version,
    43	    set_status,
    44	)
    45	
    46	HARNESS = Path(__file__).resolve().parent
    47	DB_PATH = HARNESS / "db" / "chief.db"
    48	WORKTREES = HARNESS / ".worktrees"       # gitignored; one subdir per job
    49	CLONES = HARNESS.parent.parent / f"{HARNESS.parent.name}-clones"  # sibling to the
    50	                          # repo, e.g. chief-command-clones next to chief-command —
    51	                          # NEVER inside the repo tree. See _make_clone for why.
    52	BUILD_TIMEOUT_S = 900
    53	OUTPUT_DIRNAME = "chief_output"          # where a builder drops standalone work
    54	
    55	OLLAMA_URL = "http://127.0.0.1:11434/api/generate"
    56	
    57	# A project id is about to become a path SEGMENT (lanes/<project_id>/<seat>.md). It
    58	# comes from the `jobs.project_id` column — normally a real `projects.id`, which
    59	# dispatch already validated — but "normally" isn't a guard: this is the one place
    60	# that value touches a filesystem path, so it gets its own check right here rather
    61	# than trusting every caller upstream got it right.
    62	_SAFE_PATH_SEGMENT_RE = re.compile(r"^[a-z0-9_-]+$")
