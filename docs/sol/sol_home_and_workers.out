   105	class Refused(RuntimeError):
   106	    """The gatekeeper said no. The message is in plain English, on purpose — it is
   107	    shown to Neill, and 'guard_family_floor violated' tells him nothing."""
   108	
   109	
   110	@dataclass
   111	class Receipt:
   112	    """Proof that the one thing happened, and what it was."""
   113	    verb: str
   114	    subject: str
   115	    detail: str = ""
   116	    reference: str = ""          # commit id, usage row, deploy id
   117	
   118	
   119	# ---------------------------------------------------------------------------
   120	# Saying no, out loud
   121	# ---------------------------------------------------------------------------
   122	def _clean(text: str, limit: int = 120) -> str:
   123	    """Make caller-supplied text safe to show Neill.
   124	
   125	    Everything written by `_note` is attributed to the gatekeeper — the one component he
   126	    is being told to trust — so an agent that can inject newlines into it can forge
   127	    gatekeeper-signed lines on his timeline. Strip the formatting, cap the length.
   128	    """
   129	    return re.sub(r"\s+", " ", str(text)).strip()[:limit]
