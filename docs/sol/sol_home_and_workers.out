   202	                       verb="merge", subject=f"job {job_id}", asked_by=asked_by)
   203	
   204	    job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   205	    if job is None:
   206	        raise _no(f"there is no job {job_id}")
   207	
   208	    if job["status"] == "shipped":
   209	        raise _no("that work has already been merged once")
   210	    if job["status"] != "done":
   211	        raise _no("that work hasn't finished its checks yet, so there's nothing to merge")
   212	
   213	    try:
   214	        repo, merge_into = _repo_and_branch_for_job(conn, job["project_id"])
   215	    except ProjectRepoUnavailable as exc:
   216	        raise _no(str(exc))
   217	
   218	    version = job["head_version"]
   219	    if not version:
   220	        raise _no("nothing was actually put forward — there's no finished version to merge")
   221	
   222	    verdicts = conn.execute(
   223	        "SELECT reviewer_seat, model_family, verdict, role, reviewed_version "
   224	        "FROM verdicts WHERE job_id = ?", (job_id,)
   225	    ).fetchall()
   226	    current = [v for v in verdicts if v["reviewed_version"] == version]
   227	
   228	    # A failure on this version is fatal and is NOT outvoted. A failure on an unknown
   229	    # version is also fatal: it condemns we-don't-know-what, so it condemns everything.
   230	    for v in verdicts:
   231	        if v["verdict"] == "fail" and (
   232	                v["reviewed_version"] is None or v["reviewed_version"] == version):
   233	            raise _no("a reviewer turned this down and that stands")
   234	    if any(v["verdict"] == "needs_human" for v in verdicts):
   235	        raise _no("a reviewer asked for you to look at this first")
   236	
   237	    passed = [v for v in current if v["verdict"] == "pass" and v["role"] == "reviewer"]
   238	    seats = {v["reviewer_seat"] for v in passed}
   239	    # The author is not a second opinion (migration 007): a same-family pass is a
   240	    # legitimate review, it just does not count toward "different minds". The schema
   241	    # already refuses first; this keeps the gate honest even if it ever stops.
   242	    families = {v["model_family"] for v in passed
   243	                if v["model_family"] != job["builder_family"]}
   244	
   245	    # A job carrying NO requirements is not a job everyone approved — it is a job whose
   246	    # requirements were never stamped. `0 < 0` is False, so treating zero as "nothing
   247	    # required" would let a row created outside dispatch merge with no reviews at all.
   248	    # Same arithmetic as the schema (migration 007): unstamped is not unrequired — a
   249	    # missing number means ONE, never zero. Refusing zero outright rejected jobs the
   250	    # record had accepted honestly.
   251	    need_seats = max(job["required_reviews"] or 0, 1)
   252	    need_families = max(job["required_review_families"] or 0, 1)
   253	    if len(seats) < need_seats:
   254	        raise _no(f"only {len(seats)} of the {need_seats} reviewers "
   255	                      "have signed off on this version")
   256	    if len(families) < need_families:
   257	        raise _no(f"only {len(families)} different kinds of model have checked this; "
   258	                      f"{need_families} are required")
   259	
   260	    branch = job["branch"] or ""
   261	    if not BRANCH_RE.match(branch):
   262	        raise _no("there's no finished branch of code to merge for that job")
   263	
   264	    tip = _branch_tip(branch, repo)
