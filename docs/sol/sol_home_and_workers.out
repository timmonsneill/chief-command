   609	# ═══════════════════════════════════════════════════════════════════════════════
   610	# VOICE
   611	# ═══════════════════════════════════════════════════════════════════════════════
   612	import os  # noqa: E402
   613	
   614	import httpx  # noqa: E402
   615	
   616	from chief import ASK_CHIEF_TOOL, MOUTH_INSTRUCTIONS, ask_chief  # noqa: E402
   617	
   618	VOICE_MODEL = "gpt-realtime-2.1"   # the FULL model, NOT mini.
   619	# Mini has an open, unresolved bug where it refuses to call function tools. For a
   620	# telephone whose entire job is placing one call, that is fatal — you'd speak into
   621	# the car and nothing would happen. ~$50/mo more to remove the single point of
   622	# failure from the whole system. Cheapest insurance on the board.
   623	
   624	
   625	@app.get("/api/voice/token")
   626	async def voice_token():
   627	    """Mint a SHORT-LIVED client token so the real API key never reaches the browser.
   628	
   629	    The browser talks straight to OpenAI (that's what keeps the audio fast — it doesn't
   630	    bounce through this Mac). But it must never hold the key that can spend money, so
   631	    it gets a token that expires in a minute and can do nothing but start one session.
   632	    """
   633	    key = os.environ.get("OPENAI_API_KEY")
   634	    if not key:
   635	        return JSONResponse({"error": "no OpenAI key configured"}, status_code=503)
   636	
   637	    # Refuse to start a session we can't afford. Sol: "a safe failure mode when Chief
   638	    # is unavailable" — same principle for the money. Better to not start than to be
   639	    # cut off mid-sentence by OpenAI's own cap.
   640	    m = month_spend(db())
   641	    if m["spent_cents"] >= m["cap_cents"]:
   642	        return JSONResponse(
   643	            {"error": f"You're at your ${m['cap_cents']/100:.0f} monthly limit. "
   644	                      "Voice is off until you raise it."},
   645	            status_code=402,
   646	        )
   647	
   648	    async with httpx.AsyncClient(timeout=20) as http:
   649	        r = await http.post(
   650	            "https://api.openai.com/v1/realtime/client_secrets",
   651	            headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
   652	            json={
   653	                "session": {
   654	                    "type": "realtime",
   655	                    "model": VOICE_MODEL,
   656	                    "instructions": MOUTH_INSTRUCTIONS,
   657	                    "tools": [ASK_CHIEF_TOOL],
   658	                    # FORCE the call (Sol's bug #1). With "auto" the mouth could decide a
   659	                    # "yes" or a status question wasn't worth sending and answer it itself
   660	                    # — which is exactly the judgment that leaked twice. Required means
   661	                    # every single thing Neill says goes to Chief. The mouth cannot
   662	                    # freelance.
   663	                    "tool_choice": "required",
   664	                    "audio": {
   665	                        "input": {
   666	                            # SEMANTIC turn detection, not plain silence detection.
   667	                            # A driver pauses mid-sentence to merge; silence-based VAD
   668	                            # cuts him off. Semantic judges whether he SOUNDED finished.
   669	                            "turn_detection": {"type": "semantic_vad", "eagerness": "low",
   670	                                               "interrupt_response": True},
   671	                        },
   672	                        "output": {"voice": "cedar"},
   673	                    },
   674	                }
   675	            },
   676	        )
   677	    if r.status_code >= 400:
   678	        return JSONResponse({"error": r.text[:300]}, status_code=r.status_code)
   679	    return r.json()
   680	
   681	
   682	# The live conversation behind the voice. ONE session, held for the whole conversation,
   683	# so "yeah" / "no, the other one" mean something and there's no 3-5s process relaunch on
   684	# every utterance (that relaunch was the whole reason talking felt like hanging up and
   685	# redialling). See chief_live.py. Serialized with a lock: one mouth, one thread of
   686	# thought at a time. Rebuilt if it dies so a bad turn can't wedge the conversation.
   687	import asyncio  # noqa: E402
   688	
   689	from chief import CHIEF_MODEL as _CHIEF_MODEL  # noqa: E402
   690	
   691	_chief_session = None
   692	_chief_lock = asyncio.Lock()
   693	
   694	# SSE must not be cached or buffered anywhere between us and the phone, or "streaming"
   695	# quietly turns back into "wait for the whole thing" behind a proxy/CDN that batches
   696	# chunks. Tailscale-only today, but this is cheap insurance if that ever changes.
   697	_SSE_HEADERS = {"Cache-Control": "no-cache", "X-Accel-Buffering": "no"}
   698	
   699	# asyncio only holds a WEAK reference to a bare asyncio.create_task() result — if
   700	# nothing else keeps it alive, the garbage collector is free to collect it mid-run,
   701	# silently cancelling it (this is documented asyncio behaviour, not a hypothetical).
   702	# The whole point of _live_voice_producer is to survive a vanished HTTP response, so
   703	# it must not be that easy to kill by accident. This set is the strong reference; the
   704	# done-callback removes it once the turn is over, so it never grows unbounded.
   705	_background_voice_tasks: set[asyncio.Task] = set()
   706	
   707	
   708	def _spawn_background(coro) -> asyncio.Task:
   709	    task = asyncio.create_task(coro)
   710	    _background_voice_tasks.add(task)
   711	    task.add_done_callback(_background_voice_tasks.discard)
   712	    return task
   713	
   714	
   715	def _live_session():
   716	    """Lazily build the live Chief, seeded with the real project list.
   717	
   718	    The project list is baked in ONCE, when the session is born, because a held session
   719	    IS the point — it's what makes "yeah" cost a second instead of eight. The trade: a
   720	    project renamed mid-conversation won't reach Chief until the session next rebuilds
   721	    (on error, or a fresh boot). That's the right call for a single owner talking; the
   722	    list rarely changes inside one drive.
   723	    """
   724	    global _chief_session
   725	    if _chief_session is None:
   726	        from chief_live import ChiefSession
   727	        from db.projects import projects_context
   728	        _chief_session = ChiefSession(extra_context=projects_context(db()))
   729	    return _chief_session
   730	
   731	
   732	def _is_chiefs_own_continuation(said: str) -> bool:
   733	    """A message that starts this way is Chief's OWN follow-up sentence, echoed back by
   734	    a mouth that misread it as a new question (see voice.html's '(Chief continues:)'
   735	    follow-ups). It is never something Neill said. The browser already refuses to send
   736	    this, but the browser is not the trust boundary — a stale client, or the mouth
   737	    somehow originating the words itself, must not be able to make Chief talk to
   738	    himself. So it's blocked here too, before it ever reaches Chief or the record."""
   739	    return said.startswith("(Chief continues:)")
   740	
   741	
   742	def _record_voice_event(out: dict) -> None:
   743	    """Everything Chief says goes on the record, so the text channel always has the
   744	    full version of anything Neill only half-heard in the car. One INSERT, shared by
   745	    every voice path, so there is exactly one place this can drift from the others."""
   746	    c = db()
   747	    c.execute(
   748	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   749	        "SELECT id, 'chief', 'chief', ?, 'gpt', 'thinking', ? FROM jobs ORDER BY id DESC LIMIT 1",
   750	        (out.get("model", _CHIEF_MODEL), out["full"][:500]),
   751	    )
   752	
   753	
   754	@app.post("/api/voice/ask")
   755	async def voice_ask(request: Request):
   756	    """The mouth's ONE tool. Everything Neill says arrives here and goes to Chief.
   757	
   758	    The mouth decides nothing. It doesn't even decide whether something is worth
   759	    sending — because "is this worth sending?" is a judgment, and judgments are where
   760	    this leaked twice.
   761	    """
   762	    body = await request.json()
   763	    said = (body.get("said") or "").strip()
   764	    # Voice cannot dispatch a job — this only informs Chief's ANSWER (see
   765	    # chief.ask_chief's "PROJECT HE NAMED" section), on the fallback text path
   766	    # below. Starting work is still only ever /api/dispatch + the give form.
   767	    project = (body.get("project") or "").strip()
   768	    if not said:
   769	        return {"spoken": "I didn't catch that."}
   770	    if _is_chiefs_own_continuation(said):
   771	        return JSONResponse(
   772	            {"spoken": "", "full": "", "model": _CHIEF_MODEL, "failed": True},
   773	            status_code=400,
   774	        )
   775	
   776	    from mouth import is_pushback
   777	    pushed_back = is_pushback(said)
   778	
   779	    # The fast path: the LIVE streaming session (metered API, but text is pennies, and
   780	    # it's the difference between a one-second "yeah" and an eight-second one). Falls
   781	    # back to the free-but-slow subprocess brain when there's no API key to think with.
   782	    if os.environ.get("OPENAI_API_KEY"):
   783	        async with _chief_lock:
   784	            # `project` (above) is NOT threaded in here — the held live session has
   785	            # its own memory/remember() plumbing this doesn't hook into (see the
   786	            # project-switching build notes). Only the fallback branch below hears it.
   787	            session = _live_session()
   788	            try:
   789	                pieces: list[str] = []
   790	                async for sentence in session.say(said, deep=pushed_back):
   791	                    pieces.append(sentence)
   792	                answer = " ".join(pieces).strip()
   793	            except Exception:
   794	                # A wedged session must not wedge the conversation. Drop it; the next
   795	                # utterance rebuilds a clean one. We do NOT silently guess an answer.
   796	                global _chief_session
   797	                _chief_session = None
   798	                answer = ""
   799	        if answer:
   800	            from chief import _for_speech
   801	            out = {"spoken": _for_speech(answer), "full": answer,
   802	                   "model": _CHIEF_MODEL, "failed": False}
   803	        else:
   804	            out = {"spoken": "Something went wrong on my end. Nothing's started.",
   805	                   "full": "Chief returned nothing. No work was dispatched.",
   806	                   "model": _CHIEF_MODEL, "failed": True}
   807	    else:
   808	        # No live session to carry the thread, so the fallback must be handed BOTH the
   809	        # real project list AND what they were just talking about — otherwise it loses the
   810	        # per-turn continuity the streaming path keeps in session memory.
   811	        talking_about = (body.get("context") or "").strip()
   812	        context = "\n\n".join(p for p in (_project_context(), talking_about) if p)
   813	        # subprocess.run blocks for up to 300s (see chief.ask_chief) — run it off the
   814	        # event loop so one slow "are you sure" turn can't stall every other request
   815	        # this Mac is serving (health checks, the dashboard, another tab) for minutes.
   816	        from starlette.concurrency import run_in_threadpool
   817	        chief_kwargs = {"context": context, "pushed_back": pushed_back}
   818	        if project:
   819	            chief_kwargs["project"] = project
   820	        out = await run_in_threadpool(ask_chief, said, **chief_kwargs)
   821	
   822	    _record_voice_event(out)
   823	    return out
   824	
   825	
   826	async def _live_voice_producer(said: str, deep: bool, queue: "asyncio.Queue[tuple[str, dict]]") -> None:
   827	    """Runs one turn of Chief's live session to completion, independent of whoever is
   828	    listening on `queue`.
   829	
   830	    This is its own asyncio Task (see the caller), not something the SSE generator
   831	    awaits directly. That split is the fix for a real bug: when the SSE generator IS
   832	    the thing calling session.say(), a dropped phone connection cancels the generator —
   833	    and that cancellation propagates straight into session.say()'s own awaits as
   834	    asyncio.CancelledError. session.say() would then never reach the point where it
   835	    remembers what Chief said (chief_live.ChiefSession.remember() only runs after the
   836	    generator finishes normally), so the held conversation loses its own last turn —
   837	    Chief's next "yeah" would refer to nothing. Running this as a detached task means a
   838	    vanished phone can't touch it: nothing here is awaited by the HTTP response, so
   839	    nothing here gets cancelled when that response goes away. Chief always finishes the
   840	    thought and always remembers it; the record below is always written.
   841	    """
   842	    global _chief_session   # must be declared once, before any branch below assigns it
   843	    from chief import _for_speech
   844	
   845	    pieces: list[str] = []
   846	    cut_off = False
   847	    async with _chief_lock:
   848	        session = _live_session()
   849	        try:
   850	            async for sentence in session.say(said, deep=deep):
   851	                pieces.append(sentence)
   852	                await queue.put(("sentence", {"text": _for_speech(sentence)}))
   853	        except asyncio.CancelledError:
   854	            # Not expected in normal operation (nothing here cancels this task), but if
   855	            # the process itself is shutting down, still fall through and record
   856	            # whatever was said before re-raising, rather than losing it silently.
   857	            _chief_session = None
   858	            cut_off = True
   859	            raise
   860	        except Exception:
   861	            # A wedged session must not wedge the conversation. Drop it; the next
   862	            # utterance rebuilds a clean one.
   863	            _chief_session = None
   864	            cut_off = True
   865	        finally:
   866	            answer = " ".join(pieces).strip()
   867	            if answer:
   868	                if cut_off:
   869	                    # Some of this was already streamed to the phone and already spoken
   870	                    # before the turn broke — the record has to say what Neill actually
   871	                    # heard, not pretend nothing happened.
   872	                    answer = f"{answer} (cut off)"
   873	                out = {"spoken": _for_speech(answer), "full": answer,
   874	                       "model": _CHIEF_MODEL, "failed": cut_off}
   875	            else:
   876	                out = {"spoken": "Something went wrong on my end. Nothing's started.",
   877	                       "full": "Chief returned nothing. No work was dispatched.",
   878	                       "model": _CHIEF_MODEL, "failed": True}
   879	            _record_voice_event(out)
   880	            await queue.put(("done", out))
   881	
   882	
   883	@app.post("/api/voice/ask/stream")
   884	async def voice_ask_stream(request: Request):
   885	    """Let the mouth start speaking while Chief is still forming the full answer."""
   886	    body = await request.json()
   887	
   888	    def _sse(event: str, data: dict) -> str:
   889	        return f"event: {event}\ndata: {json.dumps(data)}\n\n"
   890	
   891	    said = (body.get("said") or "").strip()
   892	    # Voice cannot dispatch a job — this only informs Chief's ANSWER (see
   893	    # chief.ask_chief's "PROJECT HE NAMED" section), on the fallback text path
   894	    # below. Starting work is still only ever /api/dispatch + the give form.
   895	    project = (body.get("project") or "").strip()
   896	
   897	    if not said:
   898	        async def _empty():
   899	            yield _sse("done", {
   900	                "full": "", "spoken": "I didn't catch that.",
   901	                "model": _CHIEF_MODEL, "failed": True,
   902	            })
   903	        return StreamingResponse(_empty(), media_type="text/event-stream", headers=_SSE_HEADERS)
   904	
   905	    if _is_chiefs_own_continuation(said):
   906	        async def _blocked():
   907	            yield _sse("done", {"spoken": "", "full": "", "model": _CHIEF_MODEL, "failed": True})
   908	        return StreamingResponse(
   909	            _blocked(), media_type="text/event-stream", headers=_SSE_HEADERS, status_code=400,
   910	        )
   911	
   912	    from mouth import is_pushback
   913	    pushed_back = is_pushback(said)
   914	
   915	    if os.environ.get("OPENAI_API_KEY"):
   916	        queue: "asyncio.Queue[tuple[str, dict]]" = asyncio.Queue()
   917	        # `project` (above) is NOT threaded into the live session here — voice
   918	        # cannot dispatch a job either way, and the held session's own memory/
   919	        # remember() plumbing has no per-turn hook for this yet; only the fallback
   920	        # branch further down hears it.
   921	        # Fire-and-forget on purpose — see _live_voice_producer's docstring. This task
   922	        # is NOT awaited by the generator below, so the generator's own cancellation
   923	        # (a dropped phone) cannot reach it. _spawn_background is what keeps it alive
   924	        # long enough to finish (see that function).
   925	        _spawn_background(_live_voice_producer(said, pushed_back, queue))
   926	
   927	        async def _relay():
   928	            while True:
   929	                kind, payload = await queue.get()
   930	                if kind == "sentence":
   931	                    yield _sse("sentence", payload)
   932	                else:
   933	                    yield _sse("done", payload)
   934	                    return
   935	
   936	        return StreamingResponse(_relay(), media_type="text/event-stream", headers=_SSE_HEADERS)
   937	
   938	    # No live session to carry the thread — same free fallback voice_ask uses. Wrapped
   939	    # in a thread so the blocking subprocess call (up to 300s for a pushed-back turn)
   940	    # can't stall the whole server while it runs.
   941	    async def _fallback_gen():
   942	        from starlette.concurrency import run_in_threadpool
   943	        talking_about = (body.get("context") or "").strip()
   944	        context = "\n\n".join(p for p in (_project_context(), talking_about) if p)
   945	        chief_kwargs = {"context": context, "pushed_back": pushed_back}
   946	        if project:
   947	            chief_kwargs["project"] = project
   948	        out = await run_in_threadpool(ask_chief, said, **chief_kwargs)
   949	        yield _sse("sentence", {"text": out["spoken"]})
   950	        _record_voice_event(out)
   951	        yield _sse("done", out)
   952	
   953	    return StreamingResponse(_fallback_gen(), media_type="text/event-stream", headers=_SSE_HEADERS)
   954	
   955	
