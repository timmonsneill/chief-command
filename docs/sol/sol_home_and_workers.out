     1	"""Chief, as a LIVE CONVERSATION instead of a program I restart every turn.
     2	
     3	═══════════════════════════════════════════════════════════════════════════════
     4	WHY THIS EXISTS (owner, 2026-07-14):
     5	
     6	    "i talk fast, i make decisions fast, I want to have deep conversations about what
     7	     we are doing. im worried this isn't going to be possible with the back and forth
     8	     and tiering and sending everything to chief"
     9	
    10	He was right, and the problem was mine, not the architecture's.
    11	
    12	THE BUG: every turn, I was launching a BRAND NEW PROCESS to run Chief. Fresh start,
    13	fresh context, fresh everything — 3-5 seconds of pure launch overhead before Chief had
    14	even read his words. Then it thought. Then it died. Then he said "yeah" and the whole
    15	thing happened again from scratch.
    16	
    17	That is not a conversation. It's hanging up and redialling after every sentence.
    18	
    19	THE FIX: a live streaming session over the API.
    20	  - No process launch. The 3-5s of startup simply vanishes.
    21	  - It STREAMS. The voice starts speaking before Chief has finished thinking, so he
    22	    hears the answer BUILDING instead of silence-then-monologue.
    23	  - It REMEMBERS. "yeah", "no, the other one", "what about X" all work, because Chief
    24	    already knows what he's saying yeah TO.
    25	
    26	"Yeah" now costs about a second, not eight.
    27	
    28	═══════════════════════════════════════════════════════════════════════════════
    29	THE MONEY SPLIT — fast where he feels it, free where he doesn't.
    30	
    31	    CHIEF talks over the API.       Metered — but conversation is TEXT, which is pennies.
    32	    BUILDERS run as programs.       Free on the subscription, and a 5s startup is noise
    33	                                    on a 90-second build.
    34	
    35	Everything still goes through Chief. That part is not negotiable — it's what stopped
    36	"yes, skip the backup" from being a catastrophe. But going to Chief should cost him a
    37	beat, not a coffee break.
    38	"""
    39	
    40	from __future__ import annotations
    41	
    42	import json
    43	import os
    44	import sys
    45	from pathlib import Path
    46	from typing import Any, AsyncIterator
    47	
    48	import httpx
    49	
    50	sys.path.insert(0, str(Path(__file__).resolve().parent))
    51	
    52	from chief import CHIEF_PROMPT  # noqa: E402  (one source of truth for who Chief is)
    53	
    54	API = "https://api.openai.com/v1/chat/completions"
    55	
    56	# Terra by default. The benchmark said the top model bought no extra safety and cost
    57	# more rate limit — and Sol, under pressure, folded on a destructive act while the
    58	# cheaper models held. Chief is a colleague who flags problems, NOT the security
    59	# boundary. The capability gates are that.
    60	CHIEF_MODEL = "gpt-5.6-terra"
    61	CHIEF_DEEP = "gpt-5.6-sol"
    62	
    63	
    64	class ChiefSession:
    65	    """One live conversation. Holds the thread, so 'yeah' means something.
    66	
    67	    This is the whole point: Chief is not re-briefed from zero on every utterance. It
    68	    is a colleague who has been in the room the entire time.
    69	    """
    70	
    71	    def __init__(self, extra_context: str = "") -> None:
    72	        # The real project list (and anything else the caller knows) rides in the system
    73	        # message, so Chief has the FACTS from the first word and stops improvising what
    74	        # Neill is working on. It stays put while the conversation is trimmed around it.
    75	        system = CHIEF_PROMPT
    76	        if extra_context.strip():
    77	            system += f"\n\n## WHAT'S TRUE RIGHT NOW\n{extra_context.strip()}"
    78	        self.messages: list[dict[str, Any]] = [
    79	            {"role": "system", "content": system}
    80	        ]
    81	        self.key = os.environ.get("OPENAI_API_KEY", "")
    82	
    83	    def remember(self, role: str, content: str) -> None:
    84	        self.messages.append({"role": role, "content": content})
    85	        # Keep the thread from growing without bound. The system prompt always stays;
    86	        # we trim the oldest exchanges. (A long drive is a long conversation.)
    87	        if len(self.messages) > 41:
    88	            self.messages = [self.messages[0]] + self.messages[-40:]
    89	
    90	    async def say(self, said: str, deep: bool = False) -> AsyncIterator[str]:
    91	        """Neill said something. Stream Chief's answer back, sentence by sentence.
    92	
    93	        Yields SENTENCES, not tokens — because the voice speaks in sentences. The moment
    94	        a full sentence exists, it can start being spoken while Chief writes the next
    95	        one. That's what kills the wait.
    96	        """
    97	        if not self.key:
    98	            yield "I don't have my connection to think with. Nothing's started."
    99	            return
   100	
   101	        self.remember("user", said)
   102	
   103	        model = CHIEF_DEEP if deep else CHIEF_MODEL
   104	        payload = {
   105	            "model": model,
   106	            "messages": self.messages,
   107	            "stream": True,
   108	            # Low effort for conversation. He was right about this and said it three
   109	            # times: "Sol... prolly doesn't need to be ultra for most convos."
   110	            "reasoning_effort": "high" if deep else "low",
   111	        }
   112	
   113	        full: list[str] = []
   114	        buf = ""
   115	        try:
   116	            async with httpx.AsyncClient(timeout=httpx.Timeout(180.0, connect=10.0)) as http:
   117	                async with http.stream(
   118	                    "POST", API,
   119	                    headers={"Authorization": f"Bearer {self.key}",
   120	                             "Content-Type": "application/json"},
   121	                    json=payload,
   122	                ) as r:
   123	                    if r.status_code >= 400:
   124	                        # Drop the just-added user turn so a failed exchange doesn't leave
   125	                        # a dangling, unanswered message that corrupts the thread on the
   126	                        # next utterance. The raw API error stays in the log below, NEVER
   127	                        # in what gets spoken — Neill must never hear API jargon.
   128	                        body = (await r.aread()).decode()[:200]
   129	                        self.messages.pop()
   130	                        print(f"chief_live: API {r.status_code}: {body}", file=sys.stderr)
   131	                        yield "Something went wrong on my end. Nothing's started."
   132	                        return
   133	
   134	                    async for line in r.aiter_lines():
   135	                        if not line.startswith("data: "):
   136	                            continue
   137	                        data = line[6:]
   138	                        if data == "[DONE]":
   139	                            break
   140	                        try:
   141	                            delta = json.loads(data)["choices"][0]["delta"]
   142	                        except (json.JSONDecodeError, KeyError, IndexError):
   143	                            continue
   144	                        piece = delta.get("content") or ""
   145	                        if not piece:
   146	                            continue
   147	
   148	                        buf += piece
   149	                        full.append(piece)
   150	
   151	                        # Emit as soon as a sentence is whole. The voice can start
   152	                        # speaking it while Chief is still writing the next one.
   153	                        while (cut := _sentence_end(buf)) != -1:
   154	                            sentence = buf[: cut + 1].strip()
   155	                            buf = buf[cut + 1 :]
   156	                            if sentence:
   157	                                yield sentence
   158	
   159	            if buf.strip():
   160	                yield buf.strip()
   161	
   162	        except httpx.TimeoutException:
   163	            # Sol: "The system needs a safe failure mode when Chief is unavailable."
   164	            # We do NOT fall back to something dumber making the call. We say so and do
   165	            # nothing. Silence is safer than an unsupervised guess. Drop the dangling user
   166	            # turn so the next utterance starts from a clean thread.
   167	            self.messages.pop()
   168	            yield "I'm having trouble thinking that through. Nothing's started."
   169	            return
   170	
   171	        answer = "".join(full).strip()
   172	        if answer:
   173	            self.remember("assistant", answer)
   174	
   175	
   176	def _sentence_end(s: str) -> int:
   177	    """Where does the first complete sentence end?
   178	
   179	    Deliberately conservative — a false positive means the voice speaks half a thought
   180	    aloud, which sounds broken. Better to wait a beat than to blurt.
   181	    """
   182	    for i, ch in enumerate(s):
   183	        if ch in ".!?" and i + 1 < len(s) and s[i + 1] in " \n":
   184	            # Don't split on "e.g." / "Mr." / "4.2"
   185	            if i >= 1 and s[i - 1].isdigit() and i + 2 < len(s) and s[i + 2].isdigit():
   186	                continue
   187	            return i
   188	    return -1
