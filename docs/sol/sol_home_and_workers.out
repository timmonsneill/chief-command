   523	@app.post("/api/todos/{todo_id}/toggle")
   524	def toggle_todo_endpoint(todo_id: int):
   525	    from db.planning import toggle_todo
   526	    toggle_todo(db(), todo_id)
   527	    return {"ok": True}
