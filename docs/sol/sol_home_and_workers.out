   922	-- ---------------------------------------------------------------------------
   923	-- The gatekeeper's own log (task #11). events.job_id is NOT NULL, and a deploy is not
   924	-- necessarily about a job — so without this, a deploy's grants AND refusals had nowhere
   925	-- to go and were silently dropped. Append-only, like verdicts: a record, not a draft.
   926	-- ---------------------------------------------------------------------------
   927	CREATE TABLE IF NOT EXISTS gate_log (
   928	    id          INTEGER PRIMARY KEY,
   929	    verb        TEXT NOT NULL,
   930	    subject     TEXT NOT NULL,
   931	    granted     INTEGER NOT NULL CHECK (granted IN (0,1)),
   932	    detail      TEXT NOT NULL,
   933	    asked_by    TEXT NOT NULL,
   934	    job_id      INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   935	    created_at  TEXT NOT NULL DEFAULT (datetime('now'))
   936	);
   937	
   938	CREATE TRIGGER IF NOT EXISTS guard_gate_log_is_append_only
   939	BEFORE UPDATE ON gate_log
   940	BEGIN
   941	    SELECT RAISE(ABORT, 'guard: the gatekeeper log is a record, not a draft');
   942	END;
   943	
   944	CREATE TRIGGER IF NOT EXISTS guard_gate_log_cannot_be_deleted
   945	BEFORE DELETE ON gate_log
   946	BEGIN
   947	    SELECT RAISE(ABORT, 'guard: the gatekeeper log cannot be deleted');
   948	END;
