   164	        # sync_seats refuses that config outright, the earlier and louder place.)
   165	        for seat_id, why in excluded.items():
   166	            row = seat(conn, seat_id)
   167	            if row is None:
   168	                continue
   169	            conn.execute(
   170	                "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   171	                "VALUES (?,?,?,?,?,?,?)",
   172	                (job_id, seat_id, seat_id, row["model"], row["family"], "skipped",
   173	                 f"not on the panel: {why}"),
   174	            )
   175	        conn.execute("COMMIT")
   176	    except Exception as exc:
   177	        conn.execute("ROLLBACK")
   178	        # Anything that goes wrong here is a refusal to dispatch, not a mystery 500 —
   179	        # and above all not a committed job with no worker coming for it.
   180	        raise DispatchRefused(f"could not record the job: {exc}") from exc
   181	    set_status(conn, job_id, "in_progress")
   182	
   183	    if start:
   184	        executor.start_in_background(job_id, cfg=cfg)
   185	
   186	    return LocalDispatch(
   187	        job_id=job_id, seat_id=builder_seat, reused=False,
   188	        tier=call.tier, tier_reason=call.reason,
   189	    )
   190	
   191	
   192	# ---------------------------------------------------------------------------
   193	# Config
   194	# ---------------------------------------------------------------------------
   195	def load_config(path: Path = CONFIG) -> dict[str, Any]:
   196	    # seats.toml uses // comments for readability; TOML has no //, so strip them before
   197	    # parsing. Must be string-aware: value strings hold `https://…` and `base_url` lines
   198	    # end in `"…"  // note` — cutting at the first // blindly would eat the URL. So we
   199	    # only strip a // that sits OUTSIDE a quoted string.
   200	    raw = "\n".join(_strip_slash_comment(line) for line in path.read_text().splitlines())
   201	    return tomllib.loads(raw)
   202	
   203	
   204	def _strip_slash_comment(line: str) -> str:
   205	    """Drop an inline/full-line `//` comment, ignoring `//` inside quotes."""
   206	    quote = ""
   207	    for i in range(len(line) - 1):
   208	        ch = line[i]
   209	        if quote:
   210	            if ch == quote:
   211	                quote = ""
   212	        elif ch in "\"'":
   213	            quote = ch
   214	        elif ch == "/" and line[i + 1] == "/":
   215	            return line[:i].rstrip()
   216	    return line
   217	
   218	
   219	def unresolved_reviewers(cfg: dict[str, Any]) -> list[str]:
   220	    """Gauntlet reviewers that don't name a real seat. Empty == all resolve.
   221	
   222	    A roster entry pointing at a seat that doesn't exist (the old `grinder_paid`) is a
   223	    silent trap: `over_budget` treats the unknown seat as uncapped, the pre-check says
   224	    "fine," then the verdict write rejects it. Catch it at startup instead.
   225	    """
   226	    seats = cfg.get("seats", {})
   227	    return [r for r in cfg.get("gauntlet", {}).get("reviewers", []) if r not in seats]
   228	
   229	
   230	def panel_roster(conn, cfg: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
   231	    """Who can actually sit on the panel right now — and who can't, and why.
   232	
   233	    A roster entry is only real if the seat exists, is switched on, and we have a way to
   234	    RUN it on this machine. A seat whose provider has no runner, or whose key is absent, is excluded; the
   235	    codex seat needs its login. Counting those as panel members would produce a required
   236	    panel that can never report, which fails closed but useless — every job parked
   237	    forever. Counting them silently would be worse: a panel that shrank without saying
   238	    so reads exactly like a full one.
   239	
   240	    So: exclude them, name them, and let the FAMILY FLOOR (which cannot be lowered) be
   241	    the thing that decides whether what's left is enough.
   242	    """
   243	    import gauntlet
   244	
   245	    roster: list[str] = []
   246	    excluded: dict[str, str] = {}
   247	    for seat_id in cfg.get("gauntlet", {}).get("reviewers", []):
   248	        row = seat(conn, seat_id)
   249	        if row is None:
   250	            excluded[seat_id] = "that reviewer isn't set up on this machine"
   251	        elif not row["enabled"]:
   252	            excluded[seat_id] = "that reviewer is turned off"
   253	        elif not gauntlet.has_runner(row["provider"]):
   254	            excluded[seat_id] = "we have no way to run that reviewer yet"
   255	        else:
   256	            roster.append(seat_id)
   257	    return roster, excluded
   258	
   259	
   260	def _refuse_a_panel_that_cannot_hold(conn, roster: list[str], floor: int,
   261	                                     builder_family: str | None = None) -> None:
   262	    """Refuse to dispatch work the panel could never certify.
   263	
   264	    Fail CLOSED, but say so at DISPATCH — when it is one legible refusal — rather than
   265	    at review time, where it becomes a job that parks forever and looks like a bug.
   266	    """
   267	    if floor < 1:
   268	        raise DispatchRefused(
   269	            "the review panel isn't configured (it needs at least one model family) "
   270	            "— refusing to start work that nothing would check"
   271	        )
   272	    # Counted the way the database counts (migration 007): the author's own family is
   273	    # not a second opinion. Counting it here admitted jobs the record then parked.
   274	    families = {seat(conn, s)["family"] for s in roster} - {builder_family}
   275	    if len(families) < floor:
   276	        raise DispatchRefused(
   277	            f"only {len(families)} model family/families can review right now and "
   278	            f"{floor} are required — refusing to start work that could never be checked"
   279	        )
   280	
   281	
   282	def sync_seats(conn, cfg: dict[str, Any]) -> None:
   283	    """Push the config's seats into the store, so guards can reason about them.
   284	
   285	    Refuses a config whose gauntlet names a seat that doesn't exist, or a seat missing a
   286	    family — both would blow up later, mid-panel, where it's far harder to see.
   287	    """
   288	    missing = unresolved_reviewers(cfg)
   289	    if missing:
   290	        raise DispatchRefused(f"gauntlet names seats that don't exist: {missing}")
   291	    for seat_id, s in cfg.get("seats", {}).items():
   292	        if "family" not in s:
   293	            raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
   294	    for seat_id, s in cfg.get("seats", {}).items():
   295	        upsert_seat(conn, Seat(
   296	            id=seat_id,
   297	            provider=s["provider"],
   298	            model=s["model"],
   299	            family=s["family"],
   300	            tier=s["tier"],
   301	            daily_cap_cents=s.get("daily_cap_cents"),
   302	            build_cap_cents=s.get("build_cap_cents"),
   303	            review_cap_cents=s.get("review_cap_cents"),
   304	            enabled=not s.get("disabled", False),
   305	            notes=s.get("notes", ""),
   306	        ))
   307	
   308	
   309	# ---------------------------------------------------------------------------
   310	# Dispatch
   311	# ---------------------------------------------------------------------------
   312	@dataclass
   313	class Dispatch:
   314	    job_id: int
   315	    run_id: str | None
   316	    seat_id: str
   317	
   318	
   319	def dispatch(
   320	    conn,
   321	    request: str,
   322	    builder_seat: str,
   323	    cfg: dict[str, Any],
   324	    origin: str = "text",
   325	    blocking: bool = False,
   326	    project_id: str = "chief",
   327	) -> Dispatch:
   328	    """Record the job, then spawn it on OpenClaw. In that order, always.
   329	
   330	    Non-blocking by default — this is what lets the mouth stay responsive. OpenClaw's
   331	    sessions_spawn returns a run id immediately, so the voice head can say "on it" and
   332	    keep talking while the work grinds. A blocking dispatch here would reintroduce
   333	    exactly the latency wound that killed v1.
   334	
   335	    Stamps `project_id` the same way `dispatch_local` does — this path has no
   336	    in-process builder today (nothing calls it; see docs/HANDOFF_2026-08-27.md), but
   337	    a job's project must not depend on which of the two entrances recorded it.
   338	    """
   339	    row = seat(conn, builder_seat)
   340	    if row is None:
   341	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   342	    if not row["enabled"]:
   343	        raise DispatchRefused(f"seat '{builder_seat}' is disabled")
   344	
   345	    project_row = conn.execute(
   346	        "SELECT 1 FROM projects WHERE id = ? AND archived = 0", (project_id,)
   347	    ).fetchone()
   348	    if project_row is None:
   349	        raise DispatchRefused(f"unknown project: {project_id}")
   350	
   351	    # OpenClaw core has NO per-agent budget of any kind. If we don't check here,
   352	    # nothing does.
   353	    if over_budget(conn, builder_seat):
   354	        raise DispatchRefused(
   355	            f"seat '{builder_seat}' is over its daily cap — refusing to dispatch"
   356	        )
   357	
   358	    # SAME roster question dispatch_local asks. This path used to count the raw config
   359	    # list, so a job here was stamped as needing 3 reviewers when only 2 could ever run —
   360	    # and then parked forever with nothing to explain it, instead of one legible refusal
   361	    # at the door. Both entrances, one rule.
   362	    gauntlet = cfg.get("gauntlet", {})
   363	    roster, excluded = panel_roster(conn, cfg)
   364	    required = len(roster)
   365	    families = int(gauntlet.get("min_model_families", 0))
   366	    _refuse_a_panel_that_cannot_hold(conn, roster, families, row["family"])
   367	
   368	    # One transaction: the job must never exist for even a moment without its review
   369	    # requirements stamped on (autocommit would otherwise leave a floor-0 gap).
   370	    # IMMEDIATE because this reads before it writes — see dispatch_local.
   371	    conn.execute("BEGIN IMMEDIATE")
   372	    try:
   373	        bundle_kind = BUNDLE_KIND_BY_PROVIDER.get(row["provider"], "text")
   374	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin,
   375	                            bundle_kind=bundle_kind, project_id=project_id)
   376	        conn.execute(
   377	            "UPDATE jobs SET required_reviews = ?, required_review_families = ?, "
   378	            "bundle_kind = ? WHERE id = ?",
   379	            (required, families, bundle_kind, job_id),
   380	        )
   381	        # No silent caps here either — same note dispatch_local writes.
   382	        for seat_id, why in excluded.items():
   383	            ex = seat(conn, seat_id)
   384	            if ex is None:
   385	                continue
   386	            conn.execute(
   387	                "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   388	                "VALUES (?,?,?,?,?,?,?)",
   389	                (job_id, seat_id, seat_id, ex["model"], ex["family"], "skipped",
   390	                 f"not on the panel: {why}"),
   391	            )
   392	        conn.execute("COMMIT")
   393	    except Exception:
   394	        conn.execute("ROLLBACK")
   395	        raise
   396	
   397	    # A paid builder reserves BEFORE it is called — the same rule the review panel
   398	    # follows. Checking the ledger without writing to it let a metered seat build all
   399	    # day with the ledger reading zero.
   400	    if row["tier"] == "metered":
   401	        import gatekeeper
   402	        try:
   403	            gatekeeper.spend(conn, builder_seat, BUILD_ESTIMATE_CENTS, job_id=job_id,
   404	                             role="build", asked_by="dispatch")
   405	        except gatekeeper.Refused as exc:
   406	            set_status(conn, job_id, "failed", error=f"not started: {exc}")
   407	            raise DispatchRefused(str(exc)) from exc
   408	
   409	    try:
   410	        run_id = _spawn(row, request, blocking=blocking)
   411	    except Exception as exc:  # noqa: BLE001 — a job nobody is coming for must say so
   412	        # The reservation (if any) stands: over-counting spend is the safe direction,
   413	        # and a failed spawn may still have cost something. But the JOB must not sit
   414	        # at 'todo' forever looking like it is about to start.
   415	        set_status(conn, job_id, "failed", error=f"the worker couldn't be started: {exc}")
   416	        raise DispatchRefused(f"the worker couldn't be started: {exc}") from exc
   417	    attach_run(conn, job_id, run_id=run_id or "", branch=f"job/{job_id}")
   418	    set_status(conn, job_id, "in_progress")
   419	
   420	    return Dispatch(job_id=job_id, run_id=run_id, seat_id=builder_seat)
   421	
   422	
   423	def _spawn(seat_row, request: str, blocking: bool) -> str | None:
   424	    """Hand the work to OpenClaw.
   425	
   426	    `openclaw agent` runs one turn via the Gateway. The model is chosen per-spawn,
   427	    which is what lets a single orchestrator turn fan out across several families.
   428	    """
   429	    cmd = [
   430	        "openclaw", "agent",
   431	        "--model", f"{seat_row['provider']}/{seat_row['model']}",
   432	        "--message", request,
   433	    ]
   434	    if not blocking:
   435	        cmd.append("--detach")
   436	
   437	    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
   438	    if proc.returncode != 0:
   439	        raise DispatchRefused(f"openclaw refused the spawn: {proc.stderr.strip()[:300]}")
   440	
   441	    # The gateway echoes a run id; fall back to the raw stdout if the shape changes.
   442	    try:
   443	        return json.loads(proc.stdout).get("runId")
   444	    except (json.JSONDecodeError, AttributeError):
   445	        return proc.stdout.strip()[:80] or None
   446	
   447	
   448	# ---------------------------------------------------------------------------
   449	# The gauntlet (spec §6)
   450	# ---------------------------------------------------------------------------
   451	def run_gauntlet(conn, job_id: int, cfg: dict[str, Any]) -> dict[str, Any]:
   452	    """Fan the finished work out to the reviewer panel, in parallel, same bundle.
   453	
   454	    This used to return a list of reviewer NAMES and launch nobody — the gauntlet was a
   455	    plan, not a thing that ran (task #10). It now runs the panel and returns what
   456	    actually happened: who reviewed, which families, what they said, and — if the job
   457	    stayed parked — why, in plain words.
   458	
   459	    The model-diversity rule (§6) still isn't asserted here; it's RECORDED. Every
   460	    verdict snapshots the reviewing seat's family, and the schema refuses to complete a
   461	    job without enough distinct families passing THIS version. So "two different minds
   462	    looked at this" is a fact you can query, not a promise this function made.
   463	    """
   464	    import gauntlet as gauntlet_mod
   465	
   466	    return gauntlet_mod.run_gauntlet_for_job(conn, job_id, cfg).as_dict()
   467	
   468	
   469	def ship(conn, job_id: int, owner_confirmed: bool = False) -> None:
   470	    """DO NOT CALL. Shipping belongs to the gatekeeper now (task #11).
   471	
   472	    This function is the reason #11 exists: it was one import away from any agent, and
   473	    it did the thing because it was called. `gatekeeper.merge()` does the same job and
   474	    re-reads the record instead of trusting the caller.
   475	
   476	    Kept as a refusal rather than deleted, so that anything still reaching for the old
   477	    power gets a legible answer instead of an ImportError somebody "fixes" by
   478	    reimplementing it locally.
   479	    """
   480	    raise DispatchRefused(
   481	        "shipping is the gatekeeper's job now — ask it to merge (gatekeeper.merge), "
   482	        "which checks the panel, the version and the families itself"
   483	    )
   484	
   485	
   486	# The original ship() implementation used to sit here, renamed. That was the mistake the
   487	# comment above warns about, made in the same file: the new ship() refused politely while
   488	# the old power stayed callable eight lines below it. Deleted. gatekeeper.merge() is the
   489	# only route to 'shipped', and it re-reads the record instead of trusting the caller.
   490	
   491	
   492	def morning_report(conn) -> list[dict[str, Any]]:
   493	    """What shipped while you slept, and what didn't.
   494	
   495	    Neill is out of the critical path, not out of the loop. This is the difference.
   496	    """
   497	    rows = conn.execute(
   498	        """
   499	        SELECT id, request, status, builder_seat, spoken_summary, finished_at
   500	          FROM jobs
   501	         WHERE created_at >= datetime('now', '-1 day')
   502	         ORDER BY
   503	           CASE status WHEN 'shipped' THEN 0 WHEN 'review' THEN 1
   504	                       WHEN 'failed' THEN 2 ELSE 3 END,
   505	           id
   506	        """
   507	    ).fetchall()
   508	    return [dict(r) for r in rows]

