     1	"""Chief Command — the web app. Served on the tailnet, reachable from the phone.
     2	
     3	This is what Neill actually opens. Everything else in the harness exists so that this
     4	can tell him the truth.
     5	
     6	Design rules, all downstream of one fact — HE CANNOT READ CODE:
     7	  - Plain English everywhere. No filenames in the summary views.
     8	  - Model family is the color. You should see a Claude build was tested by a Grok
     9	    before you read a single word.
    10	  - Blocked things are loud. A job stuck at a gate is the most important thing on
    11	    the screen, because it's the only thing that needs him.
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import json
    17	import os
    18	import subprocess
    19	import sys
    20	from pathlib import Path
    21	
    22	sys.path.insert(0, str(Path(__file__).resolve().parent))
    23	
    24	
    25	# ---------------------------------------------------------------------------
    26	# Keys live in ~/.chief/env (chmod 600, never in the repo). Load them here so the
    27	# server can mint voice tokens and reach the seats however it was launched. This
    28	# is the intended config path — the file, not a hardcode. Existing environment
    29	# values win, so a key set in the shell is never clobbered.
    30	# ---------------------------------------------------------------------------
    31	def _load_chief_env() -> None:
    32	    env_file = Path.home() / ".chief" / "env"
    33	    if not env_file.exists():
    34	        return
    35	    for line in env_file.read_text().splitlines():
    36	        line = line.strip()
    37	        if not line or line.startswith("#"):
    38	            continue
    39	        if line.startswith("export "):
    40	            line = line[len("export "):]
    41	        if "=" not in line:
    42	            continue
    43	        key, _, val = line.partition("=")
    44	        key, val = key.strip(), val.strip().strip('"').strip("'")
    45	        os.environ.setdefault(key, val)
