   562	# ═══════════════════════════════════════════════════════════════════════════════
   563	# UPLOADS — images and files the owner drops in, pinned to a project. Bytes live on
   564	# disk (gitignored); a row in `attachments` is how the UI finds them.
   565	# ═══════════════════════════════════════════════════════════════════════════════
   566	UPLOADS = Path(__file__).resolve().parent / "uploads"
   567	_IMAGE_EXT = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".heic"}
   568	
   569	
   570	@app.post("/api/upload")
   571	async def upload_endpoint(
   572	    file: "UploadFile" = File(...),
   573	    project_id: str = Form(None),
   574	    job_id: int = Form(None),
   575	):
   576	    from db.planning import add_attachment
   577	
   578	    UPLOADS.mkdir(exist_ok=True)
   579	    raw = await file.read()
   580	    # A safe on-disk name — never trust the client's path. Keep the extension so the
   581	    # browser renders images; prefix with the attachment id after insert for uniqueness.
   582	    safe = "".join(ch for ch in (file.filename or "file")
   583	                   if ch.isalnum() or ch in "._- ").strip() or "file"
   584	    ext = Path(safe).suffix.lower()
   585	    kind = "image" if ext in _IMAGE_EXT else "file"
   586	
   587	    c = db()
   588	    # Insert first to get an id, then write bytes under an unambiguous name.
   589	    att_id = add_attachment(c, filename=safe, stored_path="", kind=kind,
   590	                            project_id=project_id or None,
   591	                            job_id=int(job_id) if job_id else None,
   592	                            size_bytes=len(raw))
   593	    dest = UPLOADS / f"{att_id}_{safe}"
   594	    dest.write_bytes(raw)
   595	    c.execute("UPDATE attachments SET stored_path=? WHERE id=?", (str(dest), att_id))
   596	    return {"id": att_id, "filename": safe, "kind": kind, "size_bytes": len(raw)}
   597	
   598	
   599	@app.get("/api/attachments/{att_id}")
   600	def get_attachment(att_id: int):
   601	    row = db().execute(
   602	        "SELECT filename, stored_path, kind FROM attachments WHERE id=?", (att_id,)
   603	    ).fetchone()
   604	    if row is None or not row["stored_path"] or not Path(row["stored_path"]).exists():
   605	        return JSONResponse({"error": "not found"}, status_code=404)
   606	    return FileResponse(row["stored_path"], filename=row["filename"])
