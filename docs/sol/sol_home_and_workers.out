   950	-- ═══════════════════════════════════════════════════════════════════════════
   951	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   952	--
   953	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
   954	-- serious failure satisfied it. A reviewer could scream that the thing was broken and
   955	-- be outvoted by colleagues who hadn't noticed.
   956	--
   957	-- That is the opposite of what a gauntlet is FOR. One reviewer finding a real bug is
   958	-- the whole point — it isn't a democracy, it's a set of independent smoke detectors.
   959	-- Any one of them going off stops the job.
   960	-- ═══════════════════════════════════════════════════════════════════════════
   961	CREATE TRIGGER IF NOT EXISTS guard_a_failing_review_stops_it
   962	BEFORE UPDATE OF status ON jobs
   963	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   964	BEGIN
   965	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
   966	    WHERE EXISTS (
   967	        SELECT 1 FROM verdicts v
   968	        WHERE v.job_id = NEW.id AND v.verdict = 'fail'
   969	          -- gate 3: a fail condemns the VERSION it reviewed, not the job forever.
   970	          -- A fail with no version condemned we-don't-know-what: it blocks
   971	          -- everything. Same if the job itself is unversioned. Fail-closed.
   972	          AND (NEW.head_version IS NULL
   973	               OR v.reviewed_version IS NULL
   974	               OR v.reviewed_version = NEW.head_version)
   975	    );
   976	END;
   977	
   978	-- Sol, round 2, #6: an objection raised AFTER 'done' could still be outrun, because
   979	-- the escalation guard only fired on the transition INTO done — not on done -> shipped.
   980	CREATE TRIGGER IF NOT EXISTS guard_late_escalation_still_blocks_shipping
   981	BEFORE UPDATE OF status ON jobs
   982	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   983	BEGIN
   984	    SELECT RAISE(ABORT, 'guard: someone raised an objection — it has to be answered first')
   985	    WHERE EXISTS (
   986	        SELECT 1 FROM verdicts v
   987	        WHERE v.job_id = NEW.id
   988	          AND (v.verdict = 'needs_human'  -- an unanswered question blocks, always
   989	               -- gate 3: a fail blocks the version it condemned (fail-closed when
   990	               -- either side is unversioned)
   991	               OR (v.verdict = 'fail'
   992	                   AND (NEW.head_version IS NULL
   993	                        OR v.reviewed_version IS NULL
   994	                        OR v.reviewed_version = NEW.head_version)))
   995	    );
   996	END;
   997	
   998	-- Sol, round 2, #4: evidence could be an EMPTY STRING. A path of '' satisfied
   999	-- "COALESCE(path, value) IS NOT NULL" perfectly well.
  1000	CREATE TRIGGER IF NOT EXISTS guard_evidence_cannot_be_empty
  1001	BEFORE INSERT ON artifacts
  1002	WHEN TRIM(COALESCE(NEW.path, NEW.value, '')) = ''
  1003	BEGIN
  1004	    SELECT RAISE(ABORT, 'guard: evidence with nothing in it is not evidence');
  1005	END;
  1006	
  1007	-- ===========================================================================
  1008	-- GUARD 6 — nothing ships without a passing cross-family tester.
  1009	-- ===========================================================================
  1010	CREATE TRIGGER IF NOT EXISTS guard_ship_requires_a_passing_tester
  1011	BEFORE UPDATE OF status ON jobs
  1012	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
  1013	BEGIN
  1014	    SELECT RAISE(ABORT, 'guard: nothing ships without a passing cross-family tester on the record')
  1015	    WHERE OLD.status <> 'done'
