   831	-- ===========================================================================
   832	-- GUARD 3 — a tester's verdict must cite REAL BUILD EVIDENCE.
   833	--
   834	-- ⚠️ Sol #3: "The 'no screenshot, no verdict' claim is false." My original guard
   835	-- accepted ANY artifact — including a research source, or an empty row. So a tester
   836	-- could "pass" a job on the strength of a URL somebody pasted. Now it must be
   837	-- evidence the HARNESS captured by actually driving the app.
   838	-- ===========================================================================
   839	CREATE TRIGGER IF NOT EXISTS guard_tester_must_cite_artifacts
   840	BEFORE INSERT ON verdicts
   841	WHEN NEW.role = 'tester'
   842	BEGIN
   843	    SELECT RAISE(ABORT, 'guard: a tester verdict requires real captured evidence — no screenshot, no verdict')
   844	    WHERE NOT EXISTS (
   845	        SELECT 1 FROM artifacts a
   846	        WHERE a.job_id = NEW.job_id
   847	          AND a.kind IN ('screenshot', 'trace', 'video', 'dom_snapshot')
   848	          AND a.captured_by IN ('harness', 'playwright')
   849	          AND COALESCE(a.path, a.value) IS NOT NULL
   850	    );
   851	END;
   852	
   853	-- ===========================================================================
   854	-- GUARD 4 — a model family may not test its own work.
   855	-- Reads the snapshot, so re-pointing a seat later changes nothing.
   856	-- ===========================================================================
   857	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_testing
   858	BEFORE INSERT ON verdicts
   859	WHEN NEW.role = 'tester'
   860	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
   861	BEGIN
   862	    SELECT RAISE(ABORT, 'guard: a model family may not test its own build');
   863	END;
   864	
   865	-- ===========================================================================
   866	-- GUARD 5 — the full panel, always. DISTINCT reviewers.
   867	--
   868	-- ⚠️ Sol #7: "The full panel can be faked with duplicate passes." It counted ROWS.
   869	-- One reviewer could pass the same job six times. Now it counts distinct seats.
   870	-- ===========================================================================
   871	-- The floor is UNCONDITIONAL (migration 007). It used to fire only when
   872	-- required_reviews > 0 — so a job whose requirements were never stamped had no
   873	-- requirements to fail, and reached 'done' with zero verdicts. Unstamped is not
   874	-- unrequired.
   875	CREATE TRIGGER IF NOT EXISTS guard_full_panel
   876	BEFORE UPDATE OF status ON jobs
   877	WHEN NEW.status = 'done' AND OLD.status <> 'done'
   878	BEGIN
   879	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
   880	    WHERE (
   881	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
   882	        -- the panel could be "filled" by the wrong kinds of check entirely.
   883	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
   884	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   885	          -- gate 3: the panel must have reviewed THIS version, not an earlier one
   886	          AND v.reviewed_version IS NEW.head_version
   887	    ) < MAX(NEW.required_reviews, 1);
   888	END;
   889	
   890	-- ===========================================================================
   891	-- GUARD 5b — the family floor (task #10). "Full set, always" counts SEATS; it does
   892	-- not guarantee more than one MIND looked. Sol's #10 gate: min_model_families was
   893	-- enforced nowhere in the DB — the gauntlet's core property rested on Python. Now
   894	-- the DB refuses ->done without >= required_review_families DISTINCT passing families
   895	-- on this version. Fails closed: too few families -> parked (never lowers the bar).
   896	-- Snapshotted un-lowerable at dispatch (guard_family_floor_is_fixed).
   897	-- ===========================================================================
   898	CREATE TRIGGER IF NOT EXISTS guard_family_floor_is_fixed
   899	BEFORE UPDATE OF required_review_families ON jobs
   900	WHEN OLD.required_review_families > 0 AND NEW.required_review_families < OLD.required_review_families
   901	BEGIN
   902	    SELECT RAISE(ABORT, 'guard: the family floor cannot be lowered after dispatch');
   903	END;
   904	
   905	CREATE TRIGGER IF NOT EXISTS guard_family_floor
   906	BEFORE UPDATE OF status ON jobs
   907	WHEN NEW.status = 'done' AND OLD.status <> 'done'
   908	BEGIN
   909	    SELECT RAISE(ABORT, 'guard: fewer model families reviewed this than required')
   910	    WHERE (
   911	        SELECT COUNT(DISTINCT v.model_family) FROM verdicts v
   912	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   913	          AND v.reviewed_version IS NEW.head_version
   914	          -- The AUTHOR is not a second opinion. Same-family review is allowed (it is a
   915	          -- weaker signal, not a forbidden one — see test_jobs.py) but it does not COUNT
   916	          -- toward diversity, or "two different minds" could include the one that wrote
   917	          -- it. (Migration 007.)
   918	          AND v.model_family <> NEW.builder_family
   919	    ) < MAX(NEW.required_review_families, 1);
