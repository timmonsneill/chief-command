   192	def merge(conn, job_id: int, *, asked_by: str = "unknown") -> Receipt:
   193	    """Merge a job's branch into main, if and only if the record earns it.
   194	
   195	    Every check below re-reads the database. None of them takes the asker's word for
   196	    anything — that is the entire difference between this and `dispatch.ship()`, which
   197	    did the thing because it was called.
   198	    """
   199	    def _no(why: str) -> Refused:
   200	        """One way out of this function, so no refusal can forget to write itself down."""
