   702	def run_panel(
   703	    conn,
   704	    job_id: int,
   705	    request: str,
   706	    code: str,
   707	    version: str,
   708	    cfg: dict[str, Any],
   709	    *,
   710	    roster: list[str] | None = None,
   711	    db_path: Path | None = None,
   712	) -> PanelResult:
   713	    """Run the whole panel in parallel against one frozen bundle, then decide.
   714	
   715	    `conn` is the caller's connection, used only for the final decision. Each reviewer
   716	    gets its own. Returns what actually happened — including who didn't run and why.
   717	    """
   718	    # Fail loud, first, before anyone is dispatched: a lockdown flag missing from a
   719	    # runner's argv is a hole in the exact place task #10's design gate found one.
   720	    assert_reviewers_locked_down()
   721	
   722	    import dispatch                      # local: dispatch imports this module
   723	
   724	    gauntlet = cfg.get("gauntlet", {})
   725	    # Ask the SAME question dispatch asked when it stamped the panel size on the job:
   726	    # who can actually sit? Falling back to the raw config list would put the panel and
   727	    # the job's own requirements at odds — the job needing 2 seats while the panel tried
   728	    # 3, one of which cannot run.
   729	    roster = roster if roster is not None else dispatch.panel_roster(conn, cfg)[0]
   730	    floor = int(gauntlet.get("min_model_families", 0))
   731	    db_path = db_path or DB_PATH
   732	
   733	    built_by = conn.execute("SELECT builder_family FROM jobs WHERE id = ?",
   734	                            (job_id,)).fetchone()
   735	    result = PanelResult(job_id=job_id, version=version, required_families=floor,
   736	                         builder_family=(built_by["builder_family"] if built_by else "") or "")
   737	
   738	    # A floor of zero is not "no requirement" — it is an UNCONFIGURED panel, and
   739	    # `0 < 0` is False, so every later check would wave it through and certify work
   740	    # nobody looked at. dispatch refuses this at the door; refuse it here too, because
   741	    # this function is reachable from anywhere and must not depend on its caller having
   742	    # been careful. Same for an empty roster: nobody to ask is not everybody agreeing.
   743	    if floor < 1 or not roster:
   744	        result.parked_reason = (
   745	            "no review panel is configured for this job — nothing would have checked it"
   746	        )
   747	        return result
   748	
   749	    result.runs = [ReviewerRun(seat_id=s) for s in roster]
   750	    decided = threading.Event()
   751	
   752	    threads = [
   753	        threading.Thread(
   754	            target=_review_one,
   755	            args=(job_id, run.seat_id, request, code, version, cfg, run, db_path,
   756	                  decided),
   757	            name=f"review-{job_id}-{run.seat_id}", daemon=True,
   758	        )
   759	        for run in result.runs
   760	    ]
   761	    for t in threads:
   762	        t.start()
   763	    for t in threads:
   764	        t.join(timeout=REVIEW_TIMEOUT_S + JOIN_GRACE_S)
   765	
   766	    # Close the door BEFORE reading any results. A reviewer still running has not
   767	    # answered, and must not be able to answer into a decision already made — the
   768	    # completion guards only fire on the way INTO done, so a late objection could never
   769	    # stop anything. It is recorded as not having participated, which is the truth.
   770	    decided.set()
   771	    for t, run in zip(threads, result.runs):
   772	        if t.is_alive() and not run.ran:
   773	            run.skipped = run.skipped or "that reviewer never answered"
   774	
   775	    # ── The decision. Every branch below ends in "leave it parked" except one. ──
   776	    if result.failed:
   777	        result.parked_reason = "a reviewer failed this version"
   778	        return result
   779	
   780	    families = result.families_passed
   781	    if len(families) < floor:
   782	        ran = len([r for r in result.runs if r.ran])
   783	        result.parked_reason = (
   784	            f"only {len(families)} model famil{'y' if len(families) == 1 else 'ies'} "
   785	            f"reviewed this ({ran} of {len(result.runs)} reviewers ran); "
   786	            f"{floor} are required"
   787	        )
   788	        return result
   789	
   790	    try:
   791	        set_status(conn, job_id, "done",
   792	                   spoken_summary=f"Checked by {len(families)} different models. Ready for you.")
   793	        result.certified = True
   794	    except GuardViolation as exc:
   795	        # Another gate still holds (panel size, an unanswered escalation, an old
   796	        # objection). Park honestly rather than argue with the boundary.
   797	        result.parked_reason = str(exc).replace("guard: ", "")
   798	
   799	    if result.certified:
   800	        _reconcile(conn, result)
   801	    if not result.certified:
   802	        # Say why it stopped, in the record, in plain words. A job parked with no stated
   803	        # reason is indistinguishable from a job nobody looked at.
   804	        conn.execute("UPDATE jobs SET spoken_summary = ? WHERE id = ?",
   805	                     (result.spoken(), job_id))
   806	    else:
   807	        # THE SAME ASK, FROM ONE PLACE, FOR BOTH ENTRY POINTS. A job can be certified
   808	        # by this worker (executor.run_job -> run_panel) or by the other path
   809	        # (dispatch.run_gauntlet -> run_gauntlet_for_job -> run_panel) — both funnel
   810	        # through here, so both get exactly the same "ask the gatekeeper" behaviour
   811	        # instead of one of them silently never asking.
   812	        _ask_to_ship(conn, job_id, cfg, db_path)
   813	    return result
   814	
   815	
   816	# ---------------------------------------------------------------------------
   817	# Asking to ship — the one place a certified job's fate is decided from here on.
   818	# ---------------------------------------------------------------------------
   819	# The schema's own words for "no cross-family tester yet" (guard_ship_requires_a_
   820	# passing_tester, schema.sql). Matched only to CHOOSE which fixed sentence to speak —
   821	# never echoed. A real tester doesn't exist yet, so this is the expected, common
   822	# refusal today, and it earns its own honest sentence rather than a generic one.
   823	_NO_TESTER_MARKER = "passing cross-family tester"
   824	
   825	# Every OTHER refusal reason gets this instead of the gatekeeper's own words. The
   826	# gatekeeper's refusals are plain English, but some legitimately NAME A FILE (see
   827	# gatekeeper._unreviewed_files_in) — fine for the scrollable event log (which already
   828	# has it, via gatekeeper.py's own `_note`/`_log`), wrong for the one-line status a
   829	# person reads at a glance (AGENTS.md's plain-English rule). Spoken text here is
   830	# always one of exactly two fixed sentences — never the gatekeeper's raw message,
   831	# regex-scrubbed or otherwise.
   832	_OTHER_REFUSAL_SENTENCE = (
   833	    "Checked and passed, but it couldn't be merged in right now — it needs a person "
   834	    "to take a look."
   835	)
   836	
   837	
   838	def _families_passed_count(conn, job) -> int:
   839	    """How many model families OTHER than the builder's passed review on the job's
   840	    CURRENT version — counted exactly the way guard_family_floor counts it. Re-derived
   841	    from the record rather than trusted from a caller (the gatekeeper's own rule:
   842	    it never believes the asker either)."""
   843	    row = conn.execute(
   844	        "SELECT COUNT(DISTINCT model_family) AS n FROM verdicts "
   845	        "WHERE job_id = ? AND verdict = 'pass' AND role = 'reviewer' "
   846	        "  AND reviewed_version IS ? AND model_family <> ?",
   847	        (job["id"], job["head_version"], job["builder_family"]),
   848	    ).fetchone()
   849	    return int(row["n"] or 0)
   850	
   851	
   852	# The fixed sentence for a certified 'diff' job (task #9's GO version — candidate
   853	# generation, no merge). Not the gatekeeper's problem to solve and not something
   854	# _ask_to_ship should improvise per job: one sentence, always the same shape, N
   855	# filled in from the record.
   856	def _model_count_phrase(n: int) -> str:
   857	    return "one other model" if n == 1 else f"{n} different models"
   858	
   859	
   860	_DIFF_CANDIDATE_SENTENCE = (
   861	    "Checked and passed by {phrase}. The changes are ready for you "
   862	    "to read before anything goes in."
   863	)
   864	
   865	
   866	def _ask_to_ship(conn, job_id: int, cfg: dict[str, Any], db_path: Path) -> None:
   867	    """Ask the gatekeeper to merge a job that was just certified — UNLESS it's a
   868	    'diff' job (a real code builder's candidate), which task #9's GO version stops
   869	    at 'done' on purpose: nothing runs the builder's own tests, nothing merges, and
   870	    the isolated clone that produced the candidate is left in place for Neill to
   871	    read. Text jobs (today's local-model path) keep asking the gatekeeper, exactly
   872	    as before.
   873	
   874	    Never raises. Whatever calls this (a background worker thread, or a synchronous
   875	    request handler) must not die because asking to merge went wrong — a job this
   876	    fails on simply stays exactly where the panel left it ('done'), same as any other
   877	    refusal.
   878	    """
   879	    try:
   880	        job_row = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   881	        if job_row is not None and (job_row["bundle_kind"] or "text") == "diff":
   882	            n = _families_passed_count(conn, job_row)
   883	            set_status(conn, job_id, "done",
   884	                       spoken_summary=_DIFF_CANDIDATE_SENTENCE.format(
   885	                           phrase=_model_count_phrase(n)))
   886	            return
   887	
   888	        import gatekeeper
   889	        try:
   890	            answer = gatekeeper.handle(
   891	                {"verb": "merge", "job_id": job_id, "asked_by": "the panel"},
   892	                db_path=db_path)
   893	        except Exception:                      # noqa: BLE001 — the ask itself failing
   894	            answer = {"ok": False, "error": ""}
   895	
   896	        if answer.get("ok"):
   897	            # Shipped. Its private copy of the repo has done its job.
   898	            import executor
   899	            try:
   900	                executor.cleanup_worktree(conn, job_id)

