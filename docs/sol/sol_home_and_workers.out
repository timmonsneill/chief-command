   318	
   319	    if not _repo_is_ready(repo, merge_into):
   320	        raise _no("the project folder has unfinished changes in it, so it isn't "
   321	                      "safe to merge right now")
   322	
   323	    # ══════════════════════════════════════════════════════════════════════════
   324	    # ORDER (queue task 6, reworked): the git work now happens OUTSIDE the database
   325	    # transaction. It used to be BEGIN IMMEDIATE -> set_status('shipped') -> git merge
   326	    # (up to 120s) -> COMMIT — which held a write transaction across a slow git
   327	    # operation, and connect()'s busy_timeout is 15s. Every OTHER writer on this
   328	    # database (the review panel recording verdicts from several threads, in
   329	    # particular) would hit "database is locked" and give up long before a real merge
   330	    # finished, turning a single slow merge into a wave of dropped writes elsewhere.
   331	    #
   332	    # New order: re-verify under the lock, merge in git, THEN a SHORT transaction that
   333	    # records it. If the record refuses (a guard fires, or the write itself fails),
   334	    # `_reset_main_to(before)` undoes the git side effect — the same helper the old
   335	    # code already used for "git merged, the record couldn't say so." The record is
   336	    # still the only thing that can make 'shipped' true; this just moves the slow,
   337	    # already-idempotent-to-undo git step ahead of the fast, guarded database step,
   338	    # instead of holding a lock across the slow one.
   339	    # ══════════════════════════════════════════════════════════════════════════
   340	    with _MERGE_LOCK:
   341	        # Re-resolve under the lock and merge the SHA, never the name. Between the check
   342	        # above and `git merge refs/heads/<branch>`, a builder could move the branch;
   343	        # merging by name would then merge whatever it points at now.
   344	        tip = _branch_tip(branch, repo)
   345	        if tip is None or not _same_commit(tip, version):
   346	            raise _no("the code on that branch changed while the merge was being "
   347	                      "checked, so it needs checking again")
   348	        # The TARGET is re-checked under the lock too: between the check above and
   349	        # here, another process could have checked out a different branch.
   350	        if not _repo_is_ready(repo, merge_into):
   351	            raise _no("the project folder changed while the merge was being checked, "
   352	                      "so it isn't safe to merge right now")
   353	        before = _main_tip(repo, merge_into)
   354	
   355	        commit = _git_merge(tip, repo)
   356	        if commit is None:
   357	            # Nothing committed to main and no database transaction was ever opened —
   358	            # there is nothing to roll back on either side.
   359	            raise _no("the merge didn't go through cleanly — it needs a person")
   360	
   361	        conn.execute("BEGIN IMMEDIATE")
   362	        try:
   363	            try:
   364	                set_status(conn, job_id, "shipped")
   365	            except (GuardViolation, sqlite3.IntegrityError) as exc:
   366	                conn.execute("ROLLBACK")
