   395	def _job_exists(conn, job_id: int) -> bool:
   396	    return conn.execute("SELECT 1 FROM jobs WHERE id = ?", (job_id,)).fetchone() is not None
   397	
   398	
   399	def _plain(exc: Exception) -> str:
   400	    """A schema refusal, with the machine word taken off the front."""
   401	    return str(exc).replace("guard: ", "").strip() or "the record wouldn't accept it"
   402	
   403	
   404	def _branch_tip(branch: str, repo: Path) -> str | None:
   405	    """The commit a BRANCH points at — refs/heads/ so nothing else can be meant."""
   406	    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}"],
   407	                         cwd=repo, capture_output=True, text=True)
   408	    return out.stdout.strip() or None if out.returncode == 0 else None
   409	
   410	
   411	def _same_commit(tip: str, version: str) -> bool:
   412	    """Is the reviewed version this exact commit?
   413	
   414	    A FULL 40-character sha (every 'diff'-kind job stores one — see
   415	    executor._commit_diff_in_clone) is compared for EXACT equality, never a
   416	    prefix: a prefix match on a full sha adds nothing but an accidental collision
   417	    surface. Older/legacy rows recorded a short 16-char id (the local worker's
   418	    truncated commit id, or a content hash for jobs never in git at all) — those
   419	    keep the prefix match, since a short id was never meant to be exact. A version
   420	    that is not a commit id at all can never match either way, which is correct: if
   421	    we cannot prove the reviewed thing is this code, we do not merge it.
   422	    """
   423	    version = (version or "").strip().lower()
   424	    tip = (tip or "").strip().lower()
   425	    if len(version) < 7 or not re.fullmatch(r"[0-9a-f]+", version):
   426	        return False
   427	    if len(version) == 40:
   428	        return tip == version
   429	    return tip.startswith(version)
   430	
   430	
   431	
   432	REVIEWED_FILE = "chief_output/job_{job_id}.txt"     # where executor.py commits the work
   433	
   434	
   435	def _commit_holds_the_reviewed_work(commit: str, job_id: int, reviewed: str | None,
   436	                                    repo: Path) -> bool:
   437	    """Is the text the panel reviewed present, unchanged, in this exact commit?"""
   438	    if reviewed is None:
   439	        return False
   440	    out = subprocess.run(["git", "show", f"{commit}:{REVIEWED_FILE.format(job_id=job_id)}"],
   441	                         cwd=repo, capture_output=True, text=True)
   442	    return out.returncode == 0 and out.stdout == reviewed
   443	
   444	
   445	def _unreviewed_files_in(commit: str, job_id: int, repo: Path,
   446	                         merge_into: str) -> list[str]:
   447	    """Every path the branch changes relative to main, except the one reviewed file."""
   448	    base = subprocess.run(["git", "merge-base", merge_into, commit], cwd=repo,
   449	                          capture_output=True, text=True)
   450	    if base.returncode != 0 or not base.stdout.strip():
   451	        return ["<no common history with main>"]
   452	    diff = subprocess.run(["git", "diff", "--name-only", f"{base.stdout.strip()}..{commit}"],
   453	                          cwd=repo, capture_output=True, text=True)
   454	    if diff.returncode != 0:
   455	        return ["<could not list the branch's changes>"]
   456	    allowed = REVIEWED_FILE.format(job_id=job_id)
   457	    return sorted(p for p in diff.stdout.splitlines() if p.strip() and p.strip() != allowed)
   458	
   459	
   460	def _range_diff_lines(base: str, tip: str,
   461	                      repo: Path) -> tuple[list[str], list[str]] | None:
   462	    """`git diff --raw` and `git diff --numstat` for one COMMITTED range, split
   463	    into lines — the same shape git_policy.disallowed_paths() reads from
   464	    executor.py's staged-changes check, applied here to a committed range instead.
   465	    Returns None if either command failed — the caller must treat that as a
   466	    refusal, never as "nothing to flag"."""
   467	    raw = subprocess.run(["git", "diff", "--raw", f"{base}..{tip}"], cwd=repo,
   468	                         capture_output=True, text=True)
   469	    numstat = subprocess.run(["git", "diff", "--numstat", f"{base}..{tip}"], cwd=repo,
   470	                             capture_output=True, text=True)
   471	    if raw.returncode != 0 or numstat.returncode != 0:
   472	        return None
   473	    return (raw.stdout.splitlines(), numstat.stdout.splitlines())
   474	
   475	
   476	def _diff_bundle(base: str, tip: str, repo: Path) -> str | None:
   477	    """The exact text a 'diff'-kind job's panel reviewed — recomputed with the
   478	    SAME command used when it was stored (executor._diff_against_main), so
   479	    equality here means fidelity to what was actually shown, not luck."""
   480	    out = subprocess.run(["git", "diff", f"{base}..{tip}"], cwd=repo,
   481	                         capture_output=True, text=True)
   482	    return out.stdout if out.returncode == 0 else None
   483	
   484	
   485	def _repo_is_ready(repo: Path, merge_into: str) -> bool:
   486	    """On the branch we merge into, with nothing half-done in the folder.
   487	
   488	    Merging into a detached HEAD orphans the result; merging over the owner's own
   489	    uncommitted work risks losing it when a failed merge is aborted.
   490	    """
   491	    head = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
   492	                          cwd=repo, capture_output=True, text=True)
   493	    if head.returncode != 0 or head.stdout.strip() != merge_into:
   494	        return False
   495	    dirty = subprocess.run(["git", "status", "--porcelain"],
   496	                           cwd=repo, capture_output=True, text=True)
   497	    return dirty.returncode == 0 and not dirty.stdout.strip()
   498	
   499	
   500	def _git_merge(commit: str, repo: Path) -> str | None:
   501	    """Merge one exact commit. Takes a SHA, not a ref, on purpose."""
   502	    try:
   503	        proc = subprocess.run(["git", "merge", "--no-ff", "--no-edit", commit],
   504	                              cwd=repo, capture_output=True, text=True, timeout=120)
   505	    except subprocess.TimeoutExpired:
   506	        _abort_any_merge(repo)
   507	        return None
   508	    if proc.returncode != 0:
   509	        # Leave nothing half-merged behind. A conflicted tree that nobody is looking at
   510	        # is worse than a refusal.
   511	        _abort_any_merge(repo)
   512	        return None
   513	    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=repo,
   514	                          capture_output=True, text=True)
   515	    return head.stdout.strip()[:12] or None
   516	
   517	
   518	def _main_tip(repo: Path, merge_into: str) -> str | None:
   519	    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{merge_into}^{{commit}}"],
   520	                         cwd=repo, capture_output=True, text=True)
   521	    return out.stdout.strip() or None if out.returncode == 0 else None
   522	
   523	
   524	def _reset_main_to(commit: str | None, repo: Path) -> None:
   525	    """Undo a merge whose record failed to commit. Only ever called with the tip that
   526	    was captured moments earlier under the merge lock, on a tree verified clean."""
   527	    if commit:
   528	        subprocess.run(["git", "reset", "--hard", commit], cwd=repo, capture_output=True)
   529	
   530	
   531	def _abort_any_merge(repo: Path) -> None:
   532	    """Undo a half-finished merge — and ONLY a half-finished merge.
   533	
   534	    `git merge --abort` is `git reset --merge` underneath, which will discard the
   535	    owner's uncommitted work if no merge is actually in progress. Check first.
   536	    """
   537	    if (repo / ".git" / "MERGE_HEAD").exists():
   538	        subprocess.run(["git", "merge", "--abort"], cwd=repo, capture_output=True)
   539	
   540	
   541	# ---------------------------------------------------------------------------
   542	# DEPLOY — something reaches the world
   543	# ---------------------------------------------------------------------------
   544	def deploy(conn, target: str, *, job_id: int | None = None,
   545	           asked_by: str = "unknown") -> Receipt:
   546	    """Deploy — ONLY on a live, unused, read-back owner approval naming this target.
   547	
   548	    Decision D keeps Neill in the path for production deploys, and this is the only
   549	    place in the harness where an agent's request is not enough on its own. There is
   550	    deliberately no "the reviewers all agreed" route here: reviewers judge code, and a
   551	    deploy is a decision about the business.
   552	    """
   553	    target = _clean(target)
   554	    approval = conn.execute(
   555	        "SELECT * FROM live_approvals WHERE capability = 'deploy' AND action = ? "
   556	        "ORDER BY id DESC LIMIT 1", (target,),
   557	    ).fetchone()
   558	    if approval is None:
   559	        raise _refuse(conn, job_id,
   560	                      f"nothing has been approved for deploying {target} — "
   561	                      "that needs your say-so, tapped, not spoken",
   562	                      verb="deploy", subject=target, asked_by=asked_by)
   563	    # An approval granted about ONE job does not authorize the same words claimed under
   564	    # another. Without this, a yes given in the context of job 4 travels to job 99.
   565	    if approval["job_id"] is not None and approval["job_id"] != job_id:
   566	        raise _refuse(conn, job_id,
   567	                      "that approval was for a different piece of work",
   568	                      verb="deploy", subject=target, asked_by=asked_by)
   569	    if not approval["reversible"] and not (approval["recovery"] or "").strip():
   570	        raise _refuse(conn, job_id,
   571	                      "that deploy can't be undone and there's no written way back",
   572	                      verb="deploy", subject=target, asked_by=asked_by)
   573	
   574	    # No mechanism, no deploy — and above all no CONSUMED approval. Burning the owner's
   575	    # one-time yes on a verb that then does nothing would make him grant it twice for
   576	    # one deploy. The mechanism, when built, registers here and runs BEHIND the gate.
   577	    deployer = DEPLOYERS.get(target)
   578	    if deployer is None:
   579	        raise _refuse(conn, job_id,
   580	                      f"there's no way to deploy {target} built yet — your approval "
   581	                      "was not used up",
   582	                      verb="deploy", subject=target, asked_by=asked_by)
   583	
   584	    # Spend the approval FIRST. If the deploy dies halfway, the slip is still used —
   585	    # a retry must come back for a fresh yes rather than replay an old one. Two callers
   586	    # racing: SQLite serializes the writes and the single-use guard refuses the loser,
   587	    # which arrives here as a plain refusal rather than a crash.
   588	    try:
   589	        cur = conn.execute(
   590	            "UPDATE approvals SET used_at = datetime('now') "
   591	            " WHERE id = ? AND used_at IS NULL AND revoked_at IS NULL "
   592	            "   AND expires_at > datetime('now')",           # re-checked AT consumption
   593	            (approval["id"],))
   594	    except sqlite3.IntegrityError as exc:
   595	        raise _refuse(conn, job_id, "that approval has already been used",
   596	                      verb="deploy", subject=target, asked_by=asked_by) from exc
   597	    if cur.rowcount != 1:
   598	        raise _refuse(conn, job_id, "that approval was withdrawn or ran out just now",
   599	                      verb="deploy", subject=target, asked_by=asked_by)
   600	
   601	    try:
   602	        reference = str(deployer(target) or "")
   603	    except Exception as exc:  # noqa: BLE001 — a failed deploy is a refusal, said aloud
   604	        raise _refuse(conn, job_id, f"the deploy of {target} didn't go through: "
   605	                      f"{_clean(str(exc), 160)} — it needs a fresh approval to retry",
   606	                      verb="deploy", subject=target, asked_by=asked_by) from exc
   607	
   608	    detail = f"deployed {target} on your approval"
   609	    _note(conn, job_id, f"Deployed {target}, on your approval. "
   610	                        f"Asked for by {_clean(asked_by)}.", kind="done")
   611	    _log(conn, "deploy", target, True, detail, asked_by, job_id)
   612	    return Receipt(verb="deploy", subject=target, detail=detail,
   613	                   reference=reference or str(approval["id"]))
   614	
   615	
   616	# What actually performs a deploy, by target. EMPTY on purpose: nothing in the harness
   617	# can deploy anything yet. When something can, it registers here — behind the gate, so
   618	# that the owner's approval is the only thing that can start it.
   619	DEPLOYERS: dict[str, Callable[[str], str | None]] = {}
   620	
   621	
   622	# ---------------------------------------------------------------------------
   623	# SPEND — real money leaves the account
   624	# ---------------------------------------------------------------------------
   625	def spend(conn, seat_id: str, cents: int, *, job_id: int | None = None,
   626	          role: str = "build", asked_by: str = "unknown") -> Receipt:
   627	    """Reserve money BEFORE the provider is called, or refuse.
   628	
   629	    Sol: refusing to RECORD a charge doesn't unspend it. So the ledger is written first
   630	    and the call happens after. The daily and monthly caps live in the schema, which is
   631	    what makes this a reservation rather than a note — two agents reserving at the same
   632	    instant both hit the ledger, and the ledger refuses the one that breaches.
   633	
   634	    ⚠️ THERE IS NO RECONCILIATION YET. A reservation is an ESTIMATE, and if the real
   635	    call costs less, or never happens at all, the estimate stands against the cap
   636	    permanently. That is deliberate for now (erring toward over-counting spend is the
   637	    safe direction) but it is not the same thing as accurate accounting, and this
   638	    docstring said otherwise until the cross-model review called it.
   639	    """
   640	    if cents < 0:
   641	        raise _refuse(conn, job_id, "a charge can't be negative",
   642	                      verb="spend", subject=seat_id, asked_by=asked_by)
   643	    row = seat(conn, seat_id)
   644	    if row is None:
   645	        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
   646	                      verb="spend", subject=seat_id, asked_by=asked_by)
   647	    # A metered seat costs money every call. "Reserve zero, then make the call" would
   648	    # walk every cap — daily, role, monthly — without any of them moving.
   649	    if cents == 0 and row["tier"] == "metered":
   650	        raise _refuse(conn, job_id, "a paid worker can't reserve nothing — "
   651	                      "say what the call will cost",
   652	                      verb="spend", subject=seat_id, asked_by=asked_by)
   653	    # The caps are keyed BY ROLE, so a role nobody validated is a cap nobody enforces —
   654	    # 'research' would sail past both the build ration and the review ration.
   655	    if role not in SPEND_ROLES:
   656	        raise _refuse(conn, job_id, f"'{role}' isn't a kind of work money can be spent on",
   657	                      verb="spend", subject=seat_id, asked_by=asked_by)
   658	    row = seat(conn, seat_id)
   659	    if row is None:
   660	        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
   661	                      verb="spend", subject=seat_id, asked_by=asked_by)
   662	    if not row["enabled"]:
   663	        raise _refuse(conn, job_id, f"'{seat_id}' is switched off",
   664	                      verb="spend", subject=seat_id, asked_by=asked_by)
   665	
   666	    try:
   667	        record_usage(conn, seat_id, cents, job_id=job_id, role=role)
   668	    except (GuardViolation, sqlite3.IntegrityError) as exc:
   669	        raise _refuse(conn, job_id,
   670	                      "that would go past the spending limit for today",
   671	                      verb="spend", subject=seat_id, asked_by=asked_by) from exc
   672	
   673	    ref = conn.execute("SELECT last_insert_rowid() AS id").fetchone()["id"]
   674	    _log(conn, "spend", seat_id, True, f"{cents}c reserved for {role}", asked_by, job_id)
   675	    return Receipt(verb="spend", subject=seat_id, detail=f"{cents}c reserved for {role}",
   676	                   reference=str(ref))
   677	
   678	
   679	VERBS = {"merge": merge, "deploy": deploy, "spend": spend}
   680	
   681	
   682	# ---------------------------------------------------------------------------
   683	# The service — loopback only, and only these three verbs
   684	# ---------------------------------------------------------------------------
   685	def handle(request: dict[str, Any], *, db_path: Path | None = None) -> dict[str, Any]:
   686	    """One request in, one answer out. The whole surface area of the gatekeeper.
   687	
   688	    An unknown verb is refused without being examined further. This is the check that
   689	    keeps rule 1 true as the file grows.
   690	    """
   691	    verb = request.get("verb")
   692	    if verb not in VERBS:
   693	        return {"ok": False, "error": "the gatekeeper only does three things: "
   694	                                      "merge, deploy, spend"}
   695	
   696	    conn = connect(db_path or DB_PATH)
   697	    try:
   698	        asked_by = str(request.get("asked_by") or "unknown")
   699	        try:
   700	            if verb == "merge":
   701	                r = merge(conn, int(request["job_id"]), asked_by=asked_by)
   702	            elif verb == "deploy":
   703	                r = deploy(conn, str(request["target"]),
   704	                           job_id=_known_job(conn, request.get("job_id")), asked_by=asked_by)
   705	            else:
   706	                r = spend(conn, str(request["seat_id"]), int(request["cents"]),
   707	                          job_id=_known_job(conn, request.get("job_id")),
   708	                          role=str(request.get("role") or "build"), asked_by=asked_by)
   709	        except Refused as exc:
   710	            return {"ok": False, "error": str(exc)}
   711	        except (KeyError, ValueError, TypeError) as exc:
   712	            return {"ok": False, "error": f"that request didn't make sense: {exc}"}
   713	        except sqlite3.Error as exc:
   714	            return {"ok": False, "error": f"the record refused that: {_plain(exc)}"}
   715	        return {"ok": True, "verb": r.verb, "subject": r.subject,
   716	                "detail": r.detail, "reference": r.reference}
   717	    finally:
   718	        conn.close()
   719	
   720	
   721	def token() -> str:
   722	    """The shared secret a caller must present. Created once, readable only by us.
   723	
   724	    Loopback is a NETWORK control, not an authorization one. Without a token, any local
   725	    process — and any web page the owner happens to open, since a POST with a plain
   726	    content type is a "simple request" that needs no browser preflight — could drive the
   727	    three most dangerous powers in the system by fetching 127.0.0.1. A page cannot read
   728	    this file, so it cannot present the token.
   729	    """
   730	    TOKEN_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   731	    if not TOKEN_PATH.exists() or not TOKEN_PATH.read_text().strip():
   732	        # 0600 from the first byte — never a world-readable instant — and O_EXCL so two
   733	        # processes starting at once can't each write a different token (the loser
   734	        # simply reads the winner's). An empty file counts as missing:
   735	        # `compare_digest("", "")` is True, so an empty token would have let a
   736	        # header-less request through. Fail closed, always.
   737	        if TOKEN_PATH.exists():
   738	            TOKEN_PATH.unlink()
   739	        try:
   740	            fd = os.open(TOKEN_PATH, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
   741	        except FileExistsError:
   742	            fd = None                           # someone else just created it
   743	        if fd is not None:
   744	            with os.fdopen(fd, "w") as f:
   745	                f.write(secrets.token_urlsafe(32))
   746	            os.chmod(TOKEN_PATH, 0o600)
   747	    value = TOKEN_PATH.read_text().strip()
   748	    if len(value) < 32:
   749	        raise RuntimeError("the gatekeeper token is missing or too short — refusing to serve")
   750	    return value
   751	
   752	
   753	def serve(host: str = "127.0.0.1", port: int = 8788) -> None:
   754	    """Run the gatekeeper as its own process.
   755	
   756	    LOOPBACK ONLY, and not a choice to revisit casually: the tailnet is other devices,
   757	    and the whole point of this process is that reaching it is harder than reaching the
   758	    agents, not easier. Standard library only — the thing holding the dangerous powers
   759	    should have the smallest possible surface.
   760	    """
   761	    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
   762	
   763	    expected = token()
   764	
   765	    class Handler(BaseHTTPRequestHandler):
   766	        protocol_version = "HTTP/1.1"
   767	
   768	        def _reply(self, code: int, answer: dict) -> None:
   769	            payload = json.dumps(answer).encode()
   770	            self.send_response(code)
   771	            self.send_header("Content-Type", "application/json")
   772	            self.send_header("Content-Length", str(len(payload)))
   773	            if code >= 400:
   774	                # A refusal may have left the request body unread; on a kept-alive
   775	                # connection those bytes would be parsed as the NEXT request. Close.
   776	                self.send_header("Connection", "close")
   777	                self.close_connection = True
   778	            self.end_headers()
   779	            self.wfile.write(payload)
   780	
   781	        def do_POST(self):                                    # noqa: N802
   782	            try:
   783	                # Host check first: it is what stops DNS rebinding, where a page the
   784	                # owner is looking at resolves an attacker's domain to 127.0.0.1 and
   785	                # then talks to us with the browser's blessing.
   786	                host_header = (self.headers.get("Host") or "").split(":")[0]
   787	                if host_header not in ("127.0.0.1", "localhost", "[::1]"):
   788	                    return self._reply(403, {"ok": False, "error": "not for you"})
   789	                if not expected or not secrets.compare_digest(
   790	                        self.headers.get("X-Chief-Token") or "", expected):
   791	                    return self._reply(403, {"ok": False, "error": "not for you"})
   792	
   793	                length = int(self.headers.get("Content-Length") or 0)
   794	                if length < 0 or length > MAX_BODY_BYTES:
   795	                    return self._reply(413, {"ok": False, "error": "that request is too big"})
   796	                raw = self.rfile.read(length) if length else b"{}"
   797	                try:
   798	                    body = json.loads(raw or b"{}")
   799	                except json.JSONDecodeError:
   800	                    body = {}
   801	                if not isinstance(body, dict):
   802	                    body = {}
   803	
   804	                answer = handle(body)
   805	                self._reply(200 if answer.get("ok") else 403, answer)
   806	            except Exception:                                  # noqa: BLE001
   807	                # The gatekeeper never dies of a bad request. Down means stopped, and
   808	                # stopped means every irreversible thing stops with it.
   809	                try:
   810	                    self._reply(400, {"ok": False, "error": "that request didn't make sense"})
   811	                except Exception:                              # noqa: BLE001
   812	                    pass
   813	
   814	        def log_message(self, *args):                          # quiet by default
   815	            pass
   816	
   817	    server = ThreadingHTTPServer((host, port), Handler)
   818	    server.daemon_threads = True
   819	    server.serve_forever()
   820	
   820	
   821	
   822	if __name__ == "__main__":
   823	    serve()

