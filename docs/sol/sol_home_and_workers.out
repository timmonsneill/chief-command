   230	def panel_roster(conn, cfg: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
   231	    """Who can actually sit on the panel right now — and who can't, and why.
   232	
   233	    A roster entry is only real if the seat exists, is switched on, and we have a way to
   234	    RUN it on this machine. A seat whose provider has no runner, or whose key is absent, is excluded; the
   235	    codex seat needs its login. Counting those as panel members would produce a required
   236	    panel that can never report, which fails closed but useless — every job parked
   237	    forever. Counting them silently would be worse: a panel that shrank without saying
   238	    so reads exactly like a full one.
   239	
   240	    So: exclude them, name them, and let the FAMILY FLOOR (which cannot be lowered) be
   241	    the thing that decides whether what's left is enough.
   242	    """
   243	    import gauntlet
   244	
   245	    roster: list[str] = []
   246	    excluded: dict[str, str] = {}
   247	    for seat_id in cfg.get("gauntlet", {}).get("reviewers", []):
   248	        row = seat(conn, seat_id)
   249	        if row is None:
   250	            excluded[seat_id] = "that reviewer isn't set up on this machine"
   251	        elif not row["enabled"]:
   252	            excluded[seat_id] = "that reviewer is turned off"
   253	        elif not gauntlet.has_runner(row["provider"]):
   254	            excluded[seat_id] = "we have no way to run that reviewer yet"
   255	        else:
   256	            roster.append(seat_id)
   257	    return roster, excluded
   258	
   259	
   260	def _refuse_a_panel_that_cannot_hold(conn, roster: list[str], floor: int,
   261	                                     builder_family: str | None = None) -> None:
   262	    """Refuse to dispatch work the panel could never certify.
   263	
   264	    Fail CLOSED, but say so at DISPATCH — when it is one legible refusal — rather than
   265	    at review time, where it becomes a job that parks forever and looks like a bug.
   266	    """
   267	    if floor < 1:
   268	        raise DispatchRefused(
   269	            "the review panel isn't configured (it needs at least one model family) "
   270	            "— refusing to start work that nothing would check"
   271	        )
   272	    # Counted the way the database counts (migration 007): the author's own family is
   273	    # not a second opinion. Counting it here admitted jobs the record then parked.
   274	    families = {seat(conn, s)["family"] for s in roster} - {builder_family}
   275	    if len(families) < floor:
   276	        raise DispatchRefused(
   277	            f"only {len(families)} model family/families can review right now and "
   278	            f"{floor} are required — refusing to start work that could never be checked"
   279	        )
