   181	def _known_job(conn, job_id) -> int | None:
   182	    try:
   183	        job_id = int(job_id) if job_id is not None else None
   184	    except (TypeError, ValueError):
   185	        return None
   186	    return job_id if job_id is not None and _job_exists(conn, job_id) else None
