   289	    if missing:
   290	        raise DispatchRefused(f"gauntlet names seats that don't exist: {missing}")
   291	    for seat_id, s in cfg.get("seats", {}).items():
   292	        if "family" not in s:
   293	            raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
   294	    for seat_id, s in cfg.get("seats", {}).items():
   295	        upsert_seat(conn, Seat(
   296	            id=seat_id,
   297	            provider=s["provider"],
   298	            model=s["model"],
   299	            family=s["family"],
   300	            tier=s["tier"],
   301	            daily_cap_cents=s.get("daily_cap_cents"),
   302	            build_cap_cents=s.get("build_cap_cents"),
   303	            review_cap_cents=s.get("review_cap_cents"),
   304	            enabled=not s.get("disabled", False),
   305	            notes=s.get("notes", ""),
   306	        ))
