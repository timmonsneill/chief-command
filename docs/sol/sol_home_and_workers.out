   156	
   157	-- ---------------------------------------------------------------------------
   158	-- Todos: the checklist that belongs to a PROJECT, so it stops living in a
   159	-- terminal window and following nobody. Owner's annoyance, verbatim: "right now I
   160	-- have persistent todos that has to jump from window to window, which is annoying."
   161	--
   162	-- `owner_only` marks the items only Neill can do (rotate a key, flip a setting) —
   163	-- the ones the fleet must never quietly tick off on his behalf.
   164	-- ---------------------------------------------------------------------------
   165	CREATE TABLE IF NOT EXISTS todos (
   166	    id            INTEGER PRIMARY KEY,
   167	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
   168	    -- Sub-category WITHIN a project, so a project can hold several running lists
   169	    -- ("Security", "Build", "My tasks"). Owner: "ideally we can create a sub
   170	    -- category under each project as well." NULL / '' folds into a "General" list.
   171	    section       TEXT,
   172	    text          TEXT NOT NULL,
   173	    done          INTEGER NOT NULL DEFAULT 0 CHECK (done IN (0, 1)),
   174	    owner_only    INTEGER NOT NULL DEFAULT 0 CHECK (owner_only IN (0, 1)),
   175	    position      INTEGER NOT NULL DEFAULT 0,
   176	    created_at    TEXT NOT NULL DEFAULT (datetime('now')),
   177	    done_at       TEXT
   178	);
   179	
   180	CREATE INDEX IF NOT EXISTS idx_todos_project ON todos(project_id, section, position, id);
   181	
   182	-- ---------------------------------------------------------------------------
   183	-- Attachments: images and files Neill drops in — a screenshot of a bug, a mockup,
   184	-- a document — pinned to a project or a specific job. The bytes live on disk
   185	-- (gitignored); this row is how the UI finds them. captured_by is always the owner
   186	-- here; agent-produced evidence is the `artifacts` table, which has its own guards.
   187	-- ---------------------------------------------------------------------------
   188	CREATE TABLE IF NOT EXISTS attachments (
   189	    id            INTEGER PRIMARY KEY,
   190	    project_id    TEXT REFERENCES projects(id) ON DELETE SET NULL,
   191	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   192	    filename      TEXT NOT NULL,             -- the original name, for display
   193	    stored_path   TEXT NOT NULL,             -- where the bytes actually live
   194	    kind          TEXT NOT NULL CHECK (kind IN ('image', 'file')),
   195	    size_bytes    INTEGER,
   196	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   197	);
   198	
   199	CREATE INDEX IF NOT EXISTS idx_attachments_project ON attachments(project_id);
   200	CREATE INDEX IF NOT EXISTS idx_attachments_job ON attachments(job_id);
   201	
   202	-- ---------------------------------------------------------------------------
   203	-- Jobs: one row per dispatched unit of work. This is the audit trail.
   204	-- ---------------------------------------------------------------------------
   205	CREATE TABLE IF NOT EXISTS jobs (
   206	    id            INTEGER PRIMARY KEY,
   207	    created_at    TEXT NOT NULL DEFAULT (datetime('now')),
   208	    updated_at    TEXT NOT NULL DEFAULT (datetime('now')),
   209	    started_at    TEXT,
   210	    finished_at   TEXT,
   211	
   212	    request       TEXT NOT NULL,             -- what was asked, verbatim (§7)
   213	    -- A 2-4 word handle the mouth coins at dispatch: "the rate limiter".
   214	    -- The VOICE says this. The TEXT shows `request` in full. Echoing a man's own
   215	    -- paragraph back at him is not how a colleague talks.
   216	    task_name     TEXT,
   217	    origin        TEXT NOT NULL DEFAULT 'text'
   218	                  CHECK (origin IN ('text', 'voice', 'cron', 'relay')),  -- 'relay' = Jess (§10)
   219	
   220	    -- 'build'    → produces code. Ground truth = a screenshot (Playwright drove it).
   221	    -- 'research' → produces an ANSWER. Ground truth = a source (someone can go read it).
   222	    -- Same principle, different evidence. A researcher that can't cite is a researcher
   223	    -- that might be confabulating — and a confident wrong answer is worse than no answer,
   224	    -- because you act on it.
   225	    kind          TEXT NOT NULL DEFAULT 'build' CHECK (kind IN ('build', 'research')),
   226	
   227	    project_id    TEXT REFERENCES projects(id) ON DELETE SET NULL,
   228	
   229	    -- Which tier this job actually ran at, and WHY. The 'why' matters: if we're
   230	    -- burning heavy tier on boilerplate, this column is how we find out.
   231	    tier          TEXT NOT NULL DEFAULT 'standard'
   232	                  CHECK (tier IN ('light', 'standard', 'heavy')),
   233	    tier_reason   TEXT,
   234	
   235	    builder_seat  TEXT NOT NULL REFERENCES seats(id),
   236	    -- SNAPSHOTTED AT CREATION. Sol (cross-family review, 2026-07-13) found that
   237	    -- guards read the builder's tier/family LIVE from `seats`, so re-tiering a local
   238	    -- seat to 'subscription' retroactively legitimized its old unreviewed work.
   239	    -- Freeze it here. What a seat is TODAY cannot change what it WAS.
   240	    builder_tier   TEXT NOT NULL DEFAULT 'local'
   241	                   CHECK (builder_tier IN ('local','subscription','metered')),
   242	    builder_family TEXT NOT NULL DEFAULT 'unknown',
   243	
   244	    -- WHAT SHAPE the reviewed bundle is (task #9, migration 008). 'text' = one
   245	    -- file's content (the local model's path, unchanged). 'diff' = a code
   246	    -- builder's `git diff <merge-base main>..<tip>` — a different review AND
   247	    -- merge contract. Stamped at dispatch from the builder seat's provider,
   248	    -- frozen by guard_builder_identity_is_frozen below — never inferred later
   249	    -- from a seat's live (mutable) provider column.
   250	    bundle_kind   TEXT NOT NULL DEFAULT 'text' CHECK (bundle_kind IN ('text', 'diff')),
   251	
   252	    run_id        TEXT,                      -- OpenClaw sessions_spawn run id
   253	    session_key   TEXT,                      -- agent:<id>:subagent:<uuid>
   254	
   255	    -- Git as audit trail (§7). Worktree-per-job, main untouched until merged.
   256	    branch        TEXT,
   257	    worktree      TEXT,
   258	
   259	    -- THE VERSION UNDER REVIEW (Sol build gate 3, 2026-07-20). The exact content
   260	    -- hash the builder is putting forward — a git commit id. Reviews bind to this:
   261	    -- a verdict only counts toward completion while its reviewed_version matches.
   262	    -- The moment the builder changes the code, this changes, and every earlier
   263	    -- approval silently stops counting. Sol called the alternative the most
   264	    -- dangerous flaw in the system: "believable green checks on code nobody
   265	    -- reviewed." The gatekeeper's job at push time is to verify the code leaving
   266	    -- the building IS this hash — the DB proves the chain, git proves the content.
   267	    head_version  TEXT,
   268	
   269	    -- 'done'    = the gauntlet passed. The machine is satisfied.
   270	    -- 'shipped' = merged into the main line by the GATEKEEPER (Decision D, 2026-07-17:
   271	    --             the gauntlet IS the approval; Neill gates production DEPLOYS, not
   272	    --             merges). Guard 6 still requires a cross-family tester on the record.
   273	    -- (Earlier wording — "only Neill can move this" — predates Decision D.)
   274	    -- These are NOT the same thing, and conflating them is how agents launder
   275	    -- confidence. From Chief's memory, learned the hard way:
   276	    --     "Chief must NEVER say 'shipped' unless Neill has confirmed it works on
   277	    --      his device. 'Shipped' is reserved for Neill-confirmed-working."
   278	    -- That rule now lives here instead of in a prompt.
   279	    status        TEXT NOT NULL DEFAULT 'todo'
   280	                  CHECK (status IN ('todo', 'in_progress', 'review', 'done',
   281	                                    'shipped', 'failed', 'cancelled')),
   282	    -- Set ONLY by the owner, through mark_shipped(). No agent has a path to this.
   283	    owner_confirmed_at TEXT,
   284	
   285	    -- How many passing reviews this job needs before it may complete. Set at
   286	    -- dispatch from the gauntlet config. Also from Chief's memory:
   287	    --     "Full set, always. No 'minimum,' no 'pick two,' no 'optional depending
   288	    --      on scope.'"
   289	    required_reviews INTEGER NOT NULL DEFAULT 0,
   290	
   291	    -- How many DISTINCT model families must have a passing review before done. This is
   292	    -- the floor "full set, always" doesn't itself guarantee: a full panel could still be
   293	    -- one family wearing three hats. Set at dispatch from the gauntlet's
   294	    -- min_model_families. Snapshotted and un-lowerable, like required_reviews. (task #10)
   295	    required_review_families INTEGER NOT NULL DEFAULT 0,
   296	
   297	    result        TEXT,                      -- final summary / diff ref
   298	    error         TEXT,
   299	
   300	    -- Voice wants a spoken-length answer; the text log keeps the detail (§5.3).
   301	    spoken_summary TEXT,
   302	
   303	    attempts      INTEGER NOT NULL DEFAULT 0,
   304	    parent_job_id INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   305	
   306	    -- DUPLICATE PROTECTION. A retry — a double-tap, a dropped connection, the voice
   307	    -- re-sending — must not start the same work twice. The caller stamps a key; a
   308	    -- second dispatch with the same key returns the existing job instead of spawning
   309	    -- a new one. NULL = no key given (nothing to dedupe against). The unique index
   310	    -- below lets many NULLs coexist but forbids two rows sharing a real key.
   311	    dispatch_key  TEXT
   312	);
   313	
   314	CREATE INDEX IF NOT EXISTS idx_jobs_status  ON jobs(status);
   315	CREATE INDEX IF NOT EXISTS idx_jobs_created ON jobs(created_at);
   316	CREATE INDEX IF NOT EXISTS idx_jobs_run     ON jobs(run_id);
   317	CREATE UNIQUE INDEX IF NOT EXISTS idx_jobs_dispatch_key ON jobs(dispatch_key)
   318	    WHERE dispatch_key IS NOT NULL;
   319	
   320	-- ---------------------------------------------------------------------------
   321	-- Verdicts: the gauntlet's output (§6). One row per reviewer per job.
   322	-- reviewer_tier is denormalized at write time so a later seat re-tiering cannot
   323	-- retroactively validate a job that was never properly reviewed.
   324	-- ---------------------------------------------------------------------------
   325	CREATE TABLE IF NOT EXISTS verdicts (
   326	    id            INTEGER PRIMARY KEY,
   327	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   328	    reviewer_seat TEXT NOT NULL REFERENCES seats(id),
   329	    reviewer_tier TEXT NOT NULL CHECK (reviewer_tier IN ('local', 'subscription', 'metered')),
   330	    -- 'reviewer' reads the diff and judges. 'tester' DRIVES THE APP (Playwright) and
   331	    -- judges what it observed. The tester guards below apply only to the latter.
   332	    -- 'reviewer' reads the diff and judges it.
   333	    -- 'tester'   DROVE the running app (Playwright) and judges what it observed.
   334	    -- 'verifier' FACT-CHECKS a research answer against its sources.
   335	    role          TEXT NOT NULL DEFAULT 'reviewer'
   336	                  CHECK (role IN ('reviewer', 'tester', 'verifier')),
   337	    -- model family is snapshotted here so §6's "at least two families" rule is
   338	    -- auditable, and so the no-self-family-testing guard has something to check.
   339	    model_family  TEXT NOT NULL,
   340	    -- WHAT, exactly, did this reviewer look at? Snapshotted at write time. A verdict
   341	    -- whose version no longer matches the job's head_version is history, not
   342	    -- approval — it stops counting the moment the code moves on. This is the other
   343	    -- half of the review-to-version chain.
   344	    reviewed_version TEXT,
   345	    verdict       TEXT NOT NULL CHECK (verdict IN ('pass', 'fail', 'needs_human')),
   346	    severity      TEXT CHECK (severity IN ('p0', 'p1', 'p2', 'p3')),
   347	    summary       TEXT,
   348	    detail        TEXT,
   349	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   350	);
   351	
   352	CREATE INDEX IF NOT EXISTS idx_verdicts_job ON verdicts(job_id);
   353	
   354	-- ═══════════════════════════════════════════════════════════════════════════════
   355	-- CAPABILITIES — what an agent is PHYSICALLY ALLOWED to do.
   356	--
   357	-- This exists because Sol reviewed the architecture and demolished the previous
   358	-- safety story. The plan had been: the voice can act fast, and Chief watches and
   359	-- kills anything dumb. Sol's verdict:
   360	--
   361	--     "'Builders take minutes' measures how long they take to FINISH. What matters
   362	--      is how long they take to do their FIRST DAMAGING THING. That can be seconds.
   363	--      Chief and the builder would be RACING. There is no guarantee Chief wins."
   364	--
   365	--     "A fast supervisor is still only a fast witness if the builder can act first."
   366	--
   367	--     "A smarter model is not a security boundary."
   368	--
   369	-- He's right, and it's the difference between a bank with a vault and a bank with an
   370	-- attentive guard. You do not stop a robbery by watching carefully.
   371	--
   372	-- SO: agents get NO dangerous powers. Not "Chief will stop them" — THEY CANNOT.
   373	-- Reading code, writing code in their own worktree, running tests: always fine, and
   374	-- that's 95% of the work. Everything that touches the real world is denied by
   375	-- default and needs a signed, single-use permission slip for that exact act.
   376	-- ═══════════════════════════════════════════════════════════════════════════════
   377	CREATE TABLE IF NOT EXISTS capabilities (
   378	    seat_id       TEXT NOT NULL REFERENCES seats(id) ON DELETE CASCADE,
   379	    capability    TEXT NOT NULL CHECK (capability IN (
   380	                      -- SAFE. Granted to every builder. This is the actual job.
   381	                      'read_code', 'write_worktree', 'run_tests', 'open_pr',
   382	                      -- DANGEROUS. Denied to everyone by default. Each needs a
   383	                      -- fresh, single-use approval naming the exact action.
   384	                      'touch_production', 'delete_data', 'run_migration',
   385	                      'deploy', 'merge_to_main', 'force_push',
   386	                      'read_secrets', 'send_external', 'spend_money'
   387	                  )),
   388	    PRIMARY KEY (seat_id, capability)
   389	);
   390	
   391	-- The safe set. Everything an agent needs to actually build software, and nothing
   392	-- that can hurt you. Note what ISN'T here — that's the whole point.
   393	CREATE VIEW IF NOT EXISTS safe_capabilities AS
   394	SELECT 'read_code' AS capability UNION ALL SELECT 'write_worktree'
   395	UNION ALL SELECT 'run_tests' UNION ALL SELECT 'open_pr';
   396	
   397	-- ═══════════════════════════════════════════════════════════════════════════════
   398	-- APPROVALS — a signed, single-use permission slip for ONE exact dangerous act.
   399	--
   400	-- Sol on why a "yes" cannot be trusted on its own:
   401	--
   402	--     Chief: "First make a backup, then remove the old accounts."
   403	--     Neill: "Yes — skip the first one."
   404	--
   405	--     "That LOOKS like a confirmation, but it changes the safe plan into a dangerous
   406	--      one. Sending it directly recreates the original classification problem."
   407	--
   408	-- So an approval is not a word. It is a ROW: a numbered, one-time permission for a
   409	-- specific action, with the consequence written out in plain English and READ BACK to
   410	-- Neill before he can agree. It expires the moment the plan changes.
   411	--
   412	--     "A bare 'yes' should never approve something that was not just read back
   413	--      exactly." — which also handles the fact that a car is a terrible place to be
   414	--      understood correctly.
   415	-- ═══════════════════════════════════════════════════════════════════════════════
   416	CREATE TABLE IF NOT EXISTS approvals (
   417	    id            INTEGER PRIMARY KEY,
   418	    job_id        INTEGER REFERENCES jobs(id) ON DELETE CASCADE,
   419	    capability    TEXT NOT NULL,            -- the ONE dangerous thing this permits
   420	    -- Exactly what will happen. Not a category — the actual act.
   421	    action        TEXT NOT NULL,            -- "delete 4,200 accounts inactive since 2024-01-01"
   422	    -- What Chief SAID OUT LOUD to Neill before he agreed. If this is empty, nothing
   423	    -- was read back, and a 'yes' means nothing.
   424	    read_back     TEXT NOT NULL,
   425	    -- Is this undoable, and how? Sol: "Anything irreversible needs a tested recovery
   426	    -- method BEFORE it starts."
   427	    reversible    INTEGER NOT NULL DEFAULT 0 CHECK (reversible IN (0,1)),
   428	    recovery      TEXT,                     -- "restore from the snapshot taken at 09:14"
   429	
   430	    granted_by    TEXT NOT NULL DEFAULT 'owner' CHECK (granted_by = 'owner'),
   431	    granted_at    TEXT,
   432	    expires_at    TEXT NOT NULL,            -- short. Minutes, not hours.
   433	    used_at       TEXT,                     -- single use. Once spent, it's spent.
   434	    revoked_at    TEXT,
   435	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   436	);
   437	
   438	CREATE INDEX IF NOT EXISTS idx_approvals_job ON approvals(job_id);
   439	
   440	-- ═══════════════════════════════════════════════════════════════════════════════
   441	-- GUARD 12 — a dangerous act needs a live, unused, read-back approval.
   442	-- No approval, no action. Not "Chief said it was fine" — a signed slip, or nothing.
   443	-- ═══════════════════════════════════════════════════════════════════════════════
   444	CREATE VIEW IF NOT EXISTS live_approvals AS
   445	SELECT * FROM approvals
   446	 WHERE granted_at IS NOT NULL
   447	   AND used_at    IS NULL
   448	   AND revoked_at IS NULL
   449	   AND expires_at > datetime('now')
   450	   AND TRIM(read_back) <> '';
   451	
   452	-- An approval may never be BORN granted. (Sol, round 3 — verified 2026-07-14.)
   453	--
   454	-- Every approval guard fired on UPDATE OF granted_at only — the exact "born done" hole
   455	-- Sol found on the jobs table in round 1, never applied here. Confirmed with a live
   456	-- exploit: an INSERT with granted_at already set, reversible=0 and no recovery plan sailed
   457	-- straight into the live_approvals view. An approval must be born ungranted and become
   458	-- granted through an UPDATE, where the read-back and recovery guards below actually fire.
   459	CREATE TRIGGER IF NOT EXISTS guard_no_approval_is_born_granted
   460	BEFORE INSERT ON approvals
   461	WHEN NEW.granted_at IS NOT NULL
   462	BEGIN
   463	    SELECT RAISE(ABORT, 'guard: an approval cannot be created already granted — it must be granted through a read-back');
   464	END;
   465	
   466	-- An approval cannot be granted without something having been read back.
   467	CREATE TRIGGER IF NOT EXISTS guard_no_approval_without_readback
   468	BEFORE UPDATE OF granted_at ON approvals
   469	WHEN NEW.granted_at IS NOT NULL AND TRIM(COALESCE(NEW.read_back, '')) = ''
   470	BEGIN
   471	    SELECT RAISE(ABORT, 'guard: nothing was read back to him — a yes to nothing is not a yes');
   472	END;
   473	
   474	-- An irreversible act cannot be approved without a recovery plan.
   475	-- Sol: "'Kill' must never be presented as 'undo.'"
   476	CREATE TRIGGER IF NOT EXISTS guard_irreversible_needs_a_way_back
   477	BEFORE UPDATE OF granted_at ON approvals
   478	WHEN NEW.granted_at IS NOT NULL AND NEW.reversible = 0
   479	     AND TRIM(COALESCE(NEW.recovery, '')) = ''
   480	BEGIN
   481	    SELECT RAISE(ABORT, 'guard: this cannot be undone and has no way back — not without a recovery plan');
   482	END;
   483	
   484	-- Single use. A permission slip is spent when it is used.
   485	CREATE TRIGGER IF NOT EXISTS guard_an_approval_is_used_once
   486	BEFORE UPDATE OF used_at ON approvals
   487	WHEN OLD.used_at IS NOT NULL
   488	BEGIN
   489	    SELECT RAISE(ABORT, 'guard: that permission was already spent');
   490	END;
   491	
   492	-- ---------------------------------------------------------------------------
   493	-- Events: the live activity stream. What an agent is doing RIGHT NOW.
   494	--
   495	-- This is what makes the text channel feel like the Claude Code terminal — you
   496	-- watch Riggs read auth.py, edit routes.py, run pytest, and come back green.
   497	-- Without it the harness can only tell you a job "happened," which is useless
   498	-- while you're waiting and only mildly interesting afterward.
   499	--
   500	-- ONE STREAM, TWO RENDERINGS (this is the key design decision):
   501	--   VOICE reads jobs.spoken_summary — a sentence. "Riggs is on it, two minutes."
   502	--   TEXT  reads THIS table in full   — every tool call, every file, every result.
   503	-- Same truth, different verbosity. The voice can escalate into this table on
   504	-- request ("what's it actually doing?") — see [voice] in seats.toml.
   505	--
   506	-- Note `lane` and `model` are BOTH recorded. The lane (Riggs) carries the memory
   507	-- and the conventions; the model is whoever is sitting in that chair today. You
   508	-- must always be able to see which — otherwise you can't tell whether your auth
   509	-- module was built by your best coder or your cheapest one.
   510	-- ---------------------------------------------------------------------------
   511	CREATE TABLE IF NOT EXISTS events (
   512	    id            INTEGER PRIMARY KEY,
   513	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   514	    seat_id       TEXT NOT NULL REFERENCES seats(id),
   515	    lane          TEXT NOT NULL,             -- 'riggs' | 'finn' | 'nova' | 'forge' ...
   516	    model         TEXT NOT NULL,             -- who is actually in the chair right now
   517	    family        TEXT NOT NULL,
   518	    -- 'skipped' is load-bearing (task #10): the record needs a word for something that
   519	    -- did NOT happen. A reviewer that was capped out or couldn't run must leave a mark,
   520	    -- or a panel that quietly shrank looks identical to a full one. (Migration 006.)
   521	    kind          TEXT NOT NULL CHECK (kind IN (
   522	                      'dispatched', 'thinking', 'read', 'edit', 'write',
   523	                      'command', 'test_run', 'browse', 'verdict', 'done', 'error',
   524	                      'skipped'
   525	                  )),
   526	    target        TEXT,                      -- the file / command / URL it touched
   527	    detail        TEXT,                      -- one line, terminal-style
   528	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   529	);
   530	
   531	CREATE INDEX IF NOT EXISTS idx_events_job ON events(job_id, id);
   532	
   533	-- ---------------------------------------------------------------------------
   534	-- Artifacts: GROUND TRUTH. Captured by the harness, not reported by a model.
   535	--
   536	-- This is the anti-fabrication layer, and it exists for a specific reason:
   537	-- GPT-5.6-sol's own system card admits it fabricates results, and METR measured a
   538	-- cheating rate higher than any public model they'd evaluated. A tester that lies
   539	-- doesn't just fail — it silently disables the only quality gate in the fleet,
   540	-- because nothing checks the tester.
   541	--
   542	-- The defense is structural: Playwright drives the app like a real user and the
   543	-- HARNESS writes the screenshots, traces, console logs and network dumps to disk.
   544	-- The tester never asserts "I ran it and it worked" — it INTERPRETS artifacts it
   545	-- did not produce and cannot forge. You can't fabricate a screenshot.
   546	--
   547	-- Forge (the existing Claude Code integration tester) already worked this way by
   548	-- discipline: "If you didn't execute it and see it work, it's not tested."
   549	-- Here that stops being a personality trait and becomes a constraint.
   550	-- ---------------------------------------------------------------------------
   551	CREATE TABLE IF NOT EXISTS artifacts (
   552	    id            INTEGER PRIMARY KEY,
   553	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   554	    kind          TEXT NOT NULL CHECK (kind IN (
   555	                      -- build evidence: the harness drove the app and wrote these down
   556	                      'screenshot', 'trace', 'video', 'console_log',
   557	                      'network_log', 'dom_snapshot', 'exit_code', 'stdout', 'stderr',
   558	                      -- research evidence: a claim you can go and check yourself
   559	                      'source', 'quote'
   560	                  )),
   561	    path          TEXT,                      -- on-disk artifact
   562	    value         TEXT,                      -- inline (e.g. an exit code)
   563	    -- The flow this came from, e.g. "login -> dashboard -> dispatch a build"
   564	    flow          TEXT,
   565	    -- 'model' IS allowed here, but ONLY for research sources — a researcher must be
   566	    -- able to hand you a URL. It is still not allowed to invent a screenshot.
   567	    captured_by   TEXT NOT NULL DEFAULT 'harness'
   568	                  CHECK (captured_by IN ('harness', 'playwright', 'model')),
   569	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   570	);
   571	
   572	CREATE INDEX IF NOT EXISTS idx_artifacts_job ON artifacts(job_id);
   573	
   574	-- ---------------------------------------------------------------------------
   575	-- Usage: per-seat spend, so the caps in `seats` mean something.
   576	-- OpenClaw core has NO per-agent cost or token budget. This is ours.
   577	-- ---------------------------------------------------------------------------
   578	CREATE TABLE IF NOT EXISTS usage (
   579	    id            INTEGER PRIMARY KEY,
   580	    seat_id       TEXT NOT NULL REFERENCES seats(id),
   581	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   582	    -- What kind of work this spend was. Lets us ration building separately from
   583	    -- reviewing — the whole point of the per-role caps above.
   584	    role          TEXT NOT NULL DEFAULT 'build'
   585	                  CHECK (role IN ('build', 'review', 'test', 'research', 'voice')),
   586	    day           TEXT NOT NULL DEFAULT (date('now')),
   587	    input_tokens  INTEGER NOT NULL DEFAULT 0,
   588	    output_tokens INTEGER NOT NULL DEFAULT 0,
   589	    cost_cents    INTEGER NOT NULL DEFAULT 0,
   590	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   591	);
   592	
   593	CREATE INDEX IF NOT EXISTS idx_usage_seat_day ON usage(seat_id, day);
   594	CREATE INDEX IF NOT EXISTS idx_usage_month ON usage(day);
   595	
   596	-- ═══════════════════════════════════════════════════════════════════════════
   597	-- THE MONEY. Owner (2026-07-14): "$100/mo limit, notify me at $50."
   598	--
   599	-- TWO LAYERS, deliberately:
   600	--
   601	--   1. OpenAI's OWN monthly budget cap ($100), set in their dashboard. That is the
   602	--      REAL ceiling — it physically stops them serving requests, and no bug in this
   603	--      codebase can defeat it. It is also a terrible way to find out, because it
   604	--      cuts you off mid-sentence.
   605	--
   606	--   2. THIS. A softer, earlier layer that warns at $50 and refuses to spend past a
   607	--      budget we set ourselves — so we stop gracefully, say why, and never hit
   608	--      their wall at all.
   609	--
   610	-- Belt and braces. The dashboard cap is the thing that saves you if I'm wrong.
   611	-- ═══════════════════════════════════════════════════════════════════════════
   612	CREATE TABLE IF NOT EXISTS budget (
   613	    id              INTEGER PRIMARY KEY CHECK (id = 1),   -- exactly one row
   614	    monthly_cap_cents  INTEGER NOT NULL DEFAULT 10000,    -- $100
   615	    warn_at_cents      INTEGER NOT NULL DEFAULT 5000,     -- $50
   616	    warned_this_month  TEXT,                              -- 'YYYY-MM' so we warn once
   617	    updated_at         TEXT NOT NULL DEFAULT (datetime('now'))
   618	);
   619	
   620	INSERT OR IGNORE INTO budget (id, monthly_cap_cents, warn_at_cents) VALUES (1, 10000, 5000);
   621	
   622	-- The month's spend, all seats. This is the number that matters.
   623	CREATE VIEW IF NOT EXISTS month_spend AS
   624	SELECT
   625	    COALESCE(SUM(cost_cents), 0)                                   AS spent_cents,
   626	    (SELECT monthly_cap_cents FROM budget WHERE id = 1)            AS cap_cents,
   627	    (SELECT warn_at_cents     FROM budget WHERE id = 1)            AS warn_cents
   628	FROM usage
   629	WHERE strftime('%Y-%m', day) = strftime('%Y-%m', 'now');
   630	
   631	-- ═══════════════════════════════════════════════════════════════════════════
   632	-- GUARD 11 — the month's budget is hard. It refuses the entry that would breach it.
   633	--
   634	-- Same principle as every other guard here: this is not a policy an agent is asked
   635	-- to respect, it is a write that fails.
   636	-- ═══════════════════════════════════════════════════════════════════════════
   637	CREATE TRIGGER IF NOT EXISTS guard_monthly_budget_is_hard
   638	BEFORE INSERT ON usage
   639	BEGIN
   640	    SELECT RAISE(ABORT, 'guard: this would blow the monthly budget')
   641	    WHERE (SELECT spent_cents FROM month_spend) + NEW.cost_cents
   642	        > (SELECT monthly_cap_cents FROM budget WHERE id = 1);
   643	END;
   644	
   645	-- ===========================================================================
   646	-- THE GUARDS
   647	--
   648	-- ⚠️ REWRITTEN 2026-07-13 after a cross-family review. Sol (GPT) reviewed Claude's
   649	-- code and found NINE ways through. The headline: every guard fired on UPDATE of
   650	-- status, and NONE fired on INSERT — so a job could be BORN 'done'. Fences around
   651	-- the front door, no wall.
   652	--
   653	-- Sol's closing line, which is the one that mattered:
   654	--     "Those are application conventions, not the claimed structurally impossible
   655	--      guarantees."
   656	--
   657	-- He was right. Fixed below. Each guard now fires on BOTH insert and update, checks
   658	-- SNAPSHOTTED facts rather than live ones, and validates claims against `seats`
   659	-- instead of trusting whatever the writer put in the row.
   660	-- ===========================================================================
   661	
   662	-- A job may never be BORN finished. (Sol, round 1, #1 — the worst one.)
   663	CREATE TRIGGER IF NOT EXISTS guard_no_job_is_born_done
   664	BEFORE INSERT ON jobs
   665	WHEN NEW.status IN ('done', 'shipped')
   666	BEGIN
   667	    SELECT RAISE(ABORT, 'guard: a job cannot be created already finished — it must earn it');
   668	END;
   669	
   670	-- A job may not LIE ABOUT WHO BUILT IT AT BIRTH. (Sol, round 2, #1 — critical.)
   671	--
   672	-- I froze the builder's identity AFTER creation, so it couldn't be rewritten. But I
   673	-- never checked it AT creation. Sol: "A direct database write can label local work as
   674	-- subscription work, then complete it without the required higher-quality review. The
   675	-- identity is frozen only after creation; the initial lie is never caught."
   676	--
   677	-- Freezing a lie just makes it a permanent lie.
   678	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_must_be_real
   679	BEFORE INSERT ON jobs
   680	WHEN NEW.builder_tier   <> (SELECT tier   FROM seats WHERE id = NEW.builder_seat)
   681	  OR NEW.builder_family <> (SELECT family FROM seats WHERE id = NEW.builder_seat)
   682	BEGIN
   683	    SELECT RAISE(ABORT, 'guard: a job cannot misrepresent who built it');
   684	END;
   685	
   686	-- The builder's tier/family are snapshotted at creation and are then HISTORY.
   687	-- (Sol #5, #6 — re-tiering a seat rewrote the past.)
   688	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_is_frozen
   689	BEFORE UPDATE ON jobs
   690	WHEN OLD.builder_seat <> NEW.builder_seat
   691	  OR OLD.builder_tier <> NEW.builder_tier
   692	  OR OLD.builder_family <> NEW.builder_family
   693	  OR OLD.bundle_kind <> NEW.bundle_kind
   694	BEGIN
   695	    SELECT RAISE(ABORT, 'guard: who built this cannot be rewritten after the fact');
   696	END;
   697	
   698	-- The panel size is fixed at dispatch. (Sol #7 — it could be set to zero later.)
   699	CREATE TRIGGER IF NOT EXISTS guard_panel_size_is_fixed
   700	BEFORE UPDATE OF required_reviews ON jobs
   701	WHEN OLD.required_reviews > 0 AND NEW.required_reviews < OLD.required_reviews
   702	BEGIN
   703	    SELECT RAISE(ABORT, 'guard: the panel cannot be shrunk after dispatch');
   704	END;
   705	
   706	-- A verdict, once written, is a fact. It cannot be edited into a pass.
   707	-- (Sol #2 — every verdict guard checked INSERT only, so you could rewrite the row.)
   708	CREATE TRIGGER IF NOT EXISTS guard_verdicts_are_append_only
   709	BEFORE UPDATE ON verdicts
   710	WHEN OLD.verdict <> NEW.verdict
   711	     AND NOT (OLD.verdict = 'needs_human' AND NEW.verdict IN ('pass','fail'))
   712	BEGIN
   713	    SELECT RAISE(ABORT, 'guard: a verdict cannot be rewritten — only an escalation may be answered');
   714	END;
   715	
   716	CREATE TRIGGER IF NOT EXISTS guard_verdict_identity_is_frozen
   717	BEFORE UPDATE ON verdicts
   718	WHEN OLD.role <> NEW.role OR OLD.model_family <> NEW.model_family
   719	  OR OLD.reviewer_seat <> NEW.reviewer_seat OR OLD.reviewer_tier <> NEW.reviewer_tier
   720	BEGIN
   721	    SELECT RAISE(ABORT, 'guard: who reviewed this cannot be rewritten after the fact');
   722	END;
   723	
   724	-- ═══════════════════════════════════════════════════════════════════════════
   725	-- THE REVIEW-TO-VERSION CHAIN (Sol build gate 3, 2026-07-20).
   726	--
   727	-- Sol's most dangerous flaw: "approve version A, builder changes it to B, the old
   728	-- approval still counts — believable green checks on code nobody reviewed."
   729	--
   730	-- The fix is not another approval ceremony; it is arithmetic. A verdict carries the
   731	-- version it reviewed. A job carries the version it is putting forward. Completion
   732	-- guards only count verdicts whose versions MATCH — so moving the code voids the
   733	-- approvals by construction, nothing needs to remember to revoke anything. And a
   734	-- FAIL condemns the version it saw, not the job forever: fix the code, the version
   735	-- changes, the old fail becomes history. (A fail with no recorded version blocks
   736	-- everything — fail-closed, because it condemned we-don't-know-what.)
   737	-- ═══════════════════════════════════════════════════════════════════════════
   738	
   739	-- A versioned job accepts no unversioned verdicts. (Unversioned legacy jobs keep
   740	-- their old semantics; the gatekeeper will not push anything unversioned anyway.)
   741	CREATE TRIGGER IF NOT EXISTS guard_verdict_must_cite_what_it_reviewed
   742	BEFORE INSERT ON verdicts
   743	WHEN (SELECT head_version FROM jobs WHERE id = NEW.job_id) IS NOT NULL
   744	     AND TRIM(COALESCE(NEW.reviewed_version, '')) = ''
   745	BEGIN
   746	    SELECT RAISE(ABORT, 'guard: this job is versioned — a verdict must say which version it reviewed');
   747	END;
   748	
   749	-- A build cannot finish without declaring WHICH code is finished.
   750	CREATE TRIGGER IF NOT EXISTS guard_a_build_finishes_a_version
   751	BEFORE UPDATE OF status ON jobs
   752	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   753	     AND NEW.kind = 'build'
   754	     AND TRIM(COALESCE(NEW.head_version, '')) = ''
   755	BEGIN
   756	    SELECT RAISE(ABORT, 'guard: a build cannot finish without naming the exact version that is finished');
   757	END;
   758	
   759	-- Once finished, WHAT finished is history. Rewriting head_version after done would
   760	-- let approved-hash-A ship as hash-B while every record still looks green.
   761	CREATE TRIGGER IF NOT EXISTS guard_finished_version_is_frozen
   762	BEFORE UPDATE OF head_version ON jobs
   763	WHEN OLD.status IN ('done', 'shipped') AND OLD.head_version IS NOT NEW.head_version
   764	BEGIN
   765	    SELECT RAISE(ABORT, 'guard: what version finished cannot be rewritten after the fact');
   766	END;
   767	
   768	-- A verdict cannot be DELETED. (Sol, round 3 — verified 2026-07-14.)
   769	--
   770	-- "Append-only" was enforced only against UPDATE, so a failing review that couldn't be
   771	-- EDITED into a pass could simply be DELETED — after which guard_a_failing_review_stops_it
   772	-- (which asks "does a fail EXIST?") saw nothing and let the job complete. Confirmed with a
   773	-- live exploit: fail deleted, then done. A verdict is a fact; facts are not retractable.
   774	CREATE TRIGGER IF NOT EXISTS guard_verdicts_cannot_be_deleted
   775	BEFORE DELETE ON verdicts
   776	BEGIN
   777	    SELECT RAISE(ABORT, 'guard: a verdict is a fact on the record — it cannot be deleted');
   778	END;
   779	
   780	-- A reviewer cannot LIE about who it is. (Sol #4 — the DB took the row's word for it.)
   781	CREATE TRIGGER IF NOT EXISTS guard_reviewer_identity_must_be_real
   782	BEFORE INSERT ON verdicts
   783	WHEN NEW.reviewer_tier <> (SELECT tier FROM seats WHERE id = NEW.reviewer_seat)
   784	  OR NEW.model_family  <> (SELECT family FROM seats WHERE id = NEW.reviewer_seat)
   785	BEGIN
   786	    SELECT RAISE(ABORT, 'guard: a reviewer cannot misrepresent its own tier or family');
   787	END;
   788	
   789	-- Build evidence can only come from the harness. (Sol #9 — the DB accepted a
   790	-- model-captured screenshot; only the Python helper refused.)
   791	CREATE TRIGGER IF NOT EXISTS guard_models_cannot_forge_evidence
   792	BEFORE INSERT ON artifacts
   793	WHEN NEW.captured_by = 'model' AND NEW.kind NOT IN ('source', 'quote')
   794	BEGIN
   795	    SELECT RAISE(ABORT, 'guard: a model may cite a source but may not produce build evidence');
   796	END;
   797	
   798	-- ===========================================================================
   799	-- GUARD 1 — local output never ships unreviewed (§4.3, §9)
   800	-- Now reads the SNAPSHOT (builder_tier), not the live seat.
   801	-- ===========================================================================
   802	CREATE TRIGGER IF NOT EXISTS guard_local_output_needs_review
   803	BEFORE UPDATE OF status ON jobs
   804	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   805	     AND NEW.builder_tier = 'local'
   806	BEGIN
   807	    SELECT RAISE(ABORT, 'guard: local-built job requires a passing subscription-tier review before done')
   808	    WHERE NOT EXISTS (
   809	        SELECT 1 FROM verdicts v
   810	        WHERE v.job_id = NEW.id
   811	          AND v.reviewer_tier IN ('subscription', 'metered')
   812	          AND v.verdict = 'pass'
   813	          -- gate 3: a pass only counts for the version it actually reviewed
   814	          AND v.reviewed_version IS NEW.head_version
   815	    );
   816	END;
   817	
   818	-- ===========================================================================
   819	-- GUARD 2 — escalations must be answered, not outrun (§6)
   820	-- ===========================================================================
   821	CREATE TRIGGER IF NOT EXISTS guard_unresolved_escalation
   822	BEFORE UPDATE OF status ON jobs
   823	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   824	BEGIN
   825	    SELECT RAISE(ABORT, 'guard: job has an unresolved needs_human verdict')
   826	    WHERE EXISTS (
   827	        SELECT 1 FROM verdicts v WHERE v.job_id = NEW.id AND v.verdict = 'needs_human'
   828	    );
   829	END;
   830	
   831	-- ===========================================================================
   832	-- GUARD 3 — a tester's verdict must cite REAL BUILD EVIDENCE.
   833	--
   834	-- ⚠️ Sol #3: "The 'no screenshot, no verdict' claim is false." My original guard
   835	-- accepted ANY artifact — including a research source, or an empty row. So a tester
   836	-- could "pass" a job on the strength of a URL somebody pasted. Now it must be
   837	-- evidence the HARNESS captured by actually driving the app.
   838	-- ===========================================================================
   839	CREATE TRIGGER IF NOT EXISTS guard_tester_must_cite_artifacts
   840	BEFORE INSERT ON verdicts
   841	WHEN NEW.role = 'tester'
   842	BEGIN
   843	    SELECT RAISE(ABORT, 'guard: a tester verdict requires real captured evidence — no screenshot, no verdict')
   844	    WHERE NOT EXISTS (
   845	        SELECT 1 FROM artifacts a
   846	        WHERE a.job_id = NEW.job_id
   847	          AND a.kind IN ('screenshot', 'trace', 'video', 'dom_snapshot')
   848	          AND a.captured_by IN ('harness', 'playwright')
   849	          AND COALESCE(a.path, a.value) IS NOT NULL
   850	    );
   851	END;
   852	
   853	-- ===========================================================================
   854	-- GUARD 4 — a model family may not test its own work.
   855	-- Reads the snapshot, so re-pointing a seat later changes nothing.
   856	-- ===========================================================================
   857	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_testing
   858	BEFORE INSERT ON verdicts
   859	WHEN NEW.role = 'tester'
   860	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
   861	BEGIN
   862	    SELECT RAISE(ABORT, 'guard: a model family may not test its own build');
   863	END;
   864	
   865	-- ===========================================================================
   866	-- GUARD 5 — the full panel, always. DISTINCT reviewers.
   867	--
   868	-- ⚠️ Sol #7: "The full panel can be faked with duplicate passes." It counted ROWS.
   869	-- One reviewer could pass the same job six times. Now it counts distinct seats.
   870	-- ===========================================================================
   871	-- The floor is UNCONDITIONAL (migration 007). It used to fire only when
   872	-- required_reviews > 0 — so a job whose requirements were never stamped had no
   873	-- requirements to fail, and reached 'done' with zero verdicts. Unstamped is not
   874	-- unrequired.
   875	CREATE TRIGGER IF NOT EXISTS guard_full_panel
   876	BEFORE UPDATE OF status ON jobs
   877	WHEN NEW.status = 'done' AND OLD.status <> 'done'
   878	BEGIN
   879	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
   880	    WHERE (
   881	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
   882	        -- the panel could be "filled" by the wrong kinds of check entirely.
   883	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
   884	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   885	          -- gate 3: the panel must have reviewed THIS version, not an earlier one
   886	          AND v.reviewed_version IS NEW.head_version
   887	    ) < MAX(NEW.required_reviews, 1);
   888	END;
   889	
   890	-- ===========================================================================
   891	-- GUARD 5b — the family floor (task #10). "Full set, always" counts SEATS; it does
   892	-- not guarantee more than one MIND looked. Sol's #10 gate: min_model_families was
   893	-- enforced nowhere in the DB — the gauntlet's core property rested on Python. Now
   894	-- the DB refuses ->done without >= required_review_families DISTINCT passing families
   895	-- on this version. Fails closed: too few families -> parked (never lowers the bar).
   896	-- Snapshotted un-lowerable at dispatch (guard_family_floor_is_fixed).
   897	-- ===========================================================================
   898	CREATE TRIGGER IF NOT EXISTS guard_family_floor_is_fixed
   899	BEFORE UPDATE OF required_review_families ON jobs
   900	WHEN OLD.required_review_families > 0 AND NEW.required_review_families < OLD.required_review_families
   901	BEGIN
   902	    SELECT RAISE(ABORT, 'guard: the family floor cannot be lowered after dispatch');
   903	END;
   904	
   905	CREATE TRIGGER IF NOT EXISTS guard_family_floor
   906	BEFORE UPDATE OF status ON jobs
   907	WHEN NEW.status = 'done' AND OLD.status <> 'done'
   908	BEGIN
   909	    SELECT RAISE(ABORT, 'guard: fewer model families reviewed this than required')
   910	    WHERE (
   911	        SELECT COUNT(DISTINCT v.model_family) FROM verdicts v
   912	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   913	          AND v.reviewed_version IS NEW.head_version
   914	          -- The AUTHOR is not a second opinion. Same-family review is allowed (it is a
   915	          -- weaker signal, not a forbidden one — see test_jobs.py) but it does not COUNT
   916	          -- toward diversity, or "two different minds" could include the one that wrote
   917	          -- it. (Migration 007.)
   918	          AND v.model_family <> NEW.builder_family
   919	    ) < MAX(NEW.required_review_families, 1);
   920	END;
   921	
   922	-- ---------------------------------------------------------------------------
   923	-- The gatekeeper's own log (task #11). events.job_id is NOT NULL, and a deploy is not
   924	-- necessarily about a job — so without this, a deploy's grants AND refusals had nowhere
   925	-- to go and were silently dropped. Append-only, like verdicts: a record, not a draft.
   926	-- ---------------------------------------------------------------------------
   927	CREATE TABLE IF NOT EXISTS gate_log (
   928	    id          INTEGER PRIMARY KEY,
   929	    verb        TEXT NOT NULL,
   930	    subject     TEXT NOT NULL,
   931	    granted     INTEGER NOT NULL CHECK (granted IN (0,1)),
   932	    detail      TEXT NOT NULL,
   933	    asked_by    TEXT NOT NULL,
   934	    job_id      INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   935	    created_at  TEXT NOT NULL DEFAULT (datetime('now'))
   936	);
   937	
   938	CREATE TRIGGER IF NOT EXISTS guard_gate_log_is_append_only
   939	BEFORE UPDATE ON gate_log
   940	BEGIN
   941	    SELECT RAISE(ABORT, 'guard: the gatekeeper log is a record, not a draft');
   942	END;
   943	
   944	CREATE TRIGGER IF NOT EXISTS guard_gate_log_cannot_be_deleted
   945	BEFORE DELETE ON gate_log
   946	BEGIN
   947	    SELECT RAISE(ABORT, 'guard: the gatekeeper log cannot be deleted');
   948	END;
   949	
   950	-- ═══════════════════════════════════════════════════════════════════════════
   951	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   952	--
   953	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
   954	-- serious failure satisfied it. A reviewer could scream that the thing was broken and
   955	-- be outvoted by colleagues who hadn't noticed.
   956	--
   957	-- That is the opposite of what a gauntlet is FOR. One reviewer finding a real bug is
   958	-- the whole point — it isn't a democracy, it's a set of independent smoke detectors.
   959	-- Any one of them going off stops the job.
   960	-- ═══════════════════════════════════════════════════════════════════════════
   961	CREATE TRIGGER IF NOT EXISTS guard_a_failing_review_stops_it
   962	BEFORE UPDATE OF status ON jobs
   963	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   964	BEGIN
   965	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
   966	    WHERE EXISTS (
   967	        SELECT 1 FROM verdicts v
   968	        WHERE v.job_id = NEW.id AND v.verdict = 'fail'
   969	          -- gate 3: a fail condemns the VERSION it reviewed, not the job forever.
   970	          -- A fail with no version condemned we-don't-know-what: it blocks
   971	          -- everything. Same if the job itself is unversioned. Fail-closed.
   972	          AND (NEW.head_version IS NULL
   973	               OR v.reviewed_version IS NULL
   974	               OR v.reviewed_version = NEW.head_version)
   975	    );
   976	END;
   977	
   978	-- Sol, round 2, #6: an objection raised AFTER 'done' could still be outrun, because
   979	-- the escalation guard only fired on the transition INTO done — not on done -> shipped.
   980	CREATE TRIGGER IF NOT EXISTS guard_late_escalation_still_blocks_shipping
   981	BEFORE UPDATE OF status ON jobs
   982	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   983	BEGIN
   984	    SELECT RAISE(ABORT, 'guard: someone raised an objection — it has to be answered first')
   985	    WHERE EXISTS (
   986	        SELECT 1 FROM verdicts v
   987	        WHERE v.job_id = NEW.id
   988	          AND (v.verdict = 'needs_human'  -- an unanswered question blocks, always
   989	               -- gate 3: a fail blocks the version it condemned (fail-closed when
   990	               -- either side is unversioned)
   991	               OR (v.verdict = 'fail'
   992	                   AND (NEW.head_version IS NULL
   993	                        OR v.reviewed_version IS NULL
   994	                        OR v.reviewed_version = NEW.head_version)))
   995	    );
   996	END;
   997	
   998	-- Sol, round 2, #4: evidence could be an EMPTY STRING. A path of '' satisfied
   999	-- "COALESCE(path, value) IS NOT NULL" perfectly well.
  1000	CREATE TRIGGER IF NOT EXISTS guard_evidence_cannot_be_empty
  1001	BEFORE INSERT ON artifacts
  1002	WHEN TRIM(COALESCE(NEW.path, NEW.value, '')) = ''
  1003	BEGIN
  1004	    SELECT RAISE(ABORT, 'guard: evidence with nothing in it is not evidence');
  1005	END;
  1006	
  1007	-- ===========================================================================
  1008	-- GUARD 6 — nothing ships without a passing cross-family tester.
  1009	-- ===========================================================================
  1010	CREATE TRIGGER IF NOT EXISTS guard_ship_requires_a_passing_tester
  1011	BEFORE UPDATE OF status ON jobs
  1012	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
  1013	BEGIN
  1014	    SELECT RAISE(ABORT, 'guard: nothing ships without a passing cross-family tester on the record')
  1015	    WHERE OLD.status <> 'done'
  1016	       OR NOT EXISTS (
  1017	           SELECT 1 FROM verdicts v
  1018	           WHERE v.job_id = NEW.id AND v.role = 'tester' AND v.verdict = 'pass'
  1019	             -- gate 3: the tester must have driven THIS version of the app
  1020	             AND v.reviewed_version IS NEW.head_version
  1021	       );
  1022	END;
  1023	
  1024	-- ===========================================================================
  1025	-- GUARD 7 — a researcher must show you where it got that.
  1026	-- ===========================================================================
  1027	CREATE TRIGGER IF NOT EXISTS guard_research_must_cite_sources
  1028	BEFORE UPDATE OF status ON jobs
  1029	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
  1030	     AND NEW.kind = 'research'
  1031	BEGIN
  1032	    SELECT RAISE(ABORT, 'guard: a research answer must cite sources — no source, no answer')
  1033	    WHERE NOT EXISTS (
  1034	        SELECT 1 FROM artifacts a
  1035	        WHERE a.job_id = NEW.id AND a.kind IN ('source', 'quote')
  1036	          AND COALESCE(a.path, a.value) IS NOT NULL
  1037	    );
  1038	END;
  1039	
  1040	-- ===========================================================================
  1041	-- GUARD 8 — a model family may not fact-check its own research.
  1042	-- ===========================================================================
  1043	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_verifying
  1044	BEFORE INSERT ON verdicts
  1045	WHEN NEW.role = 'verifier'
  1046	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
  1047	BEGIN
  1048	    SELECT RAISE(ABORT, 'guard: a model family may not fact-check its own research');
  1049	END;
  1050	
  1051	-- ===========================================================================
  1052	-- GUARD 9 — spend caps are enforced by the DATABASE, not by good manners.
  1053	--
  1054	-- ⚠️ Sol #8: "Spend caps do not structurally prevent runaway cost." They were a
  1055	-- Python check before dispatch — a classic race (two dispatches both pass the check
  1056	-- before either records spend), and a direct write skipped them entirely. Now the
  1057	-- ledger itself refuses the entry that would breach the cap.
  1058	-- ===========================================================================
  1059	CREATE TRIGGER IF NOT EXISTS guard_no_negative_spend
  1060	BEFORE INSERT ON usage
  1061	WHEN NEW.cost_cents < 0
  1062	BEGIN
  1063	    SELECT RAISE(ABORT, 'guard: spend cannot be negative — no unwinding the meter');
  1064	END;
  1065	
  1066	CREATE TRIGGER IF NOT EXISTS guard_daily_cap_is_hard
  1067	BEFORE INSERT ON usage
  1068	BEGIN
  1069	    SELECT RAISE(ABORT, 'guard: this seat is over its daily cap')
  1070	    WHERE (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1071	      AND (
  1072	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1073	         WHERE seat_id = NEW.seat_id AND day = date('now')
  1074	      ) + NEW.cost_cents
  1075	      > (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id);
  1076	END;
  1077	
  1078	-- Ration the EXPENSIVE work separately. A seat can be generous on reviewing and
  1079	-- stingy on building — which is exactly how you want a metered seat to behave when
  1080	-- you already pay flat-rate for two better builders.
  1081	CREATE TRIGGER IF NOT EXISTS guard_build_cap_is_hard
  1082	BEFORE INSERT ON usage
  1083	WHEN NEW.role = 'build'
  1084	BEGIN
  1085	    SELECT RAISE(ABORT, 'guard: this seat has used up its building budget for today — it can still review')
  1086	    WHERE (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1087	      AND (
  1088	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1089	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role = 'build'
  1090	      ) + NEW.cost_cents
  1091	      > (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id);
  1092	END;
  1093	
  1094	CREATE TRIGGER IF NOT EXISTS guard_review_cap_is_hard
  1095	BEFORE INSERT ON usage
  1096	WHEN NEW.role IN ('review', 'test')
  1097	BEGIN
  1098	    SELECT RAISE(ABORT, 'guard: this seat is over its reviewing budget for today')
  1099	    WHERE (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1100	      AND (
  1101	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1102	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role IN ('review','test')
  1103	      ) + NEW.cost_cents
  1104	      > (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id);
  1105	END;
  1106	
  1107	-- Keep updated_at honest.
  1108	CREATE TRIGGER IF NOT EXISTS jobs_touch_updated_at
  1109	AFTER UPDATE ON jobs
  1110	FOR EACH ROW
  1111	BEGIN
  1112	    UPDATE jobs SET updated_at = datetime('now') WHERE id = NEW.id;
  1113	END;
  1114	
  1115	-- ---------------------------------------------------------------------------
  1116	-- The §7 voice query: "what did the overnight run do?"
  1117	-- ---------------------------------------------------------------------------
  1118	CREATE VIEW IF NOT EXISTS job_report AS
  1119	SELECT
  1120	    j.id,
  1121	    j.created_at,
  1122	    j.finished_at,
  1123	    j.request,
  1124	    j.origin,
  1125	    j.builder_seat,
  1126	    s.provider   AS builder_provider,
  1127	    s.tier       AS builder_tier,
  1128	    j.status,
  1129	    j.branch,
  1130	    j.spoken_summary,
  1131	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id)                        AS review_count,
  1132	    (SELECT COUNT(DISTINCT v.model_family) FROM verdicts v WHERE v.job_id = j.id)  AS families_reviewed,
  1133	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id AND v.verdict = 'fail') AS fail_count,
  1134	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id AND v.verdict = 'needs_human') AS escalations
  1135	FROM jobs j
  1136	JOIN seats s ON s.id = j.builder_seat;

