   382	
   383	    _note(conn, job_id,
   384	          f"Merged into the main line of code. Asked for by {_clean(asked_by)}.", kind="done")
   385	    _log(conn, "merge", f"job {job_id}", True,
   386	         f"{len(families)} model families signed off on {version}; merged {commit}",
   387	         asked_by, job_id)
   388	    return Receipt(verb="merge", subject=f"job {job_id}", reference=commit,
   389	                   detail=f"{len(families)} model families signed off on {version}")
