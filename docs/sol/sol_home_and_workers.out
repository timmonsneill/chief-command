  1023	
  1024	-- ===========================================================================
  1025	-- GUARD 7 — a researcher must show you where it got that.
  1026	-- ===========================================================================
  1027	CREATE TRIGGER IF NOT EXISTS guard_research_must_cite_sources
  1028	BEFORE UPDATE OF status ON jobs
  1029	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
  1030	     AND NEW.kind = 'research'
  1031	BEGIN
  1032	    SELECT RAISE(ABORT, 'guard: a research answer must cite sources — no source, no answer')
  1033	    WHERE NOT EXISTS (
  1034	        SELECT 1 FROM artifacts a
  1035	        WHERE a.job_id = NEW.id AND a.kind IN ('source', 'quote')
  1036	          AND COALESCE(a.path, a.value) IS NOT NULL
  1037	    );
  1038	END;
  1039	
  1040	-- ===========================================================================
  1041	-- GUARD 8 — a model family may not fact-check its own research.
  1042	-- ===========================================================================
  1043	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_verifying
  1044	BEFORE INSERT ON verdicts
  1045	WHEN NEW.role = 'verifier'
  1046	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
  1047	BEGIN
  1048	    SELECT RAISE(ABORT, 'guard: a model family may not fact-check its own research');
  1049	END;
  1050	
  1051	-- ===========================================================================
  1052	-- GUARD 9 — spend caps are enforced by the DATABASE, not by good manners.
  1053	--
  1054	-- ⚠️ Sol #8: "Spend caps do not structurally prevent runaway cost." They were a
  1055	-- Python check before dispatch — a classic race (two dispatches both pass the check
  1056	-- before either records spend), and a direct write skipped them entirely. Now the
  1057	-- ledger itself refuses the entry that would breach the cap.
  1058	-- ===========================================================================
  1059	CREATE TRIGGER IF NOT EXISTS guard_no_negative_spend
  1060	BEFORE INSERT ON usage
  1061	WHEN NEW.cost_cents < 0
  1062	BEGIN
  1063	    SELECT RAISE(ABORT, 'guard: spend cannot be negative — no unwinding the meter');
  1064	END;
  1065	
  1066	CREATE TRIGGER IF NOT EXISTS guard_daily_cap_is_hard
  1067	BEFORE INSERT ON usage
  1068	BEGIN
  1069	    SELECT RAISE(ABORT, 'guard: this seat is over its daily cap')
  1070	    WHERE (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1071	      AND (
  1072	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1073	         WHERE seat_id = NEW.seat_id AND day = date('now')
  1074	      ) + NEW.cost_cents
  1075	      > (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id);
  1076	END;
  1077	
  1078	-- Ration the EXPENSIVE work separately. A seat can be generous on reviewing and
  1079	-- stingy on building — which is exactly how you want a metered seat to behave when
  1080	-- you already pay flat-rate for two better builders.
  1081	CREATE TRIGGER IF NOT EXISTS guard_build_cap_is_hard
  1082	BEFORE INSERT ON usage
  1083	WHEN NEW.role = 'build'
  1084	BEGIN
  1085	    SELECT RAISE(ABORT, 'guard: this seat has used up its building budget for today — it can still review')
  1086	    WHERE (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1087	      AND (
  1088	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1089	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role = 'build'
  1090	      ) + NEW.cost_cents
  1091	      > (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id);
  1092	END;
  1093	
  1094	CREATE TRIGGER IF NOT EXISTS guard_review_cap_is_hard
  1095	BEFORE INSERT ON usage
  1096	WHEN NEW.role IN ('review', 'test')
  1097	BEGIN
  1098	    SELECT RAISE(ABORT, 'guard: this seat is over its reviewing budget for today')
  1099	    WHERE (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1100	      AND (
  1101	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1102	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role IN ('review','test')
  1103	      ) + NEW.cost_cents
  1104	      > (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id);
  1105	END;
  1106	
  1107	-- Keep updated_at honest.
  1108	CREATE TRIGGER IF NOT EXISTS jobs_touch_updated_at
  1109	AFTER UPDATE ON jobs
  1110	FOR EACH ROW
  1111	BEGIN
  1112	    UPDATE jobs SET updated_at = datetime('now') WHERE id = NEW.id;
  1113	END;
  1114	
  1115	-- ---------------------------------------------------------------------------
  1116	-- The §7 voice query: "what did the overnight run do?"
  1117	-- ---------------------------------------------------------------------------
  1118	CREATE VIEW IF NOT EXISTS job_report AS
  1119	SELECT
  1120	    j.id,
  1121	    j.created_at,
  1122	    j.finished_at,
  1123	    j.request,
  1124	    j.origin,
  1125	    j.builder_seat,
  1126	    s.provider   AS builder_provider,
  1127	    s.tier       AS builder_tier,
  1128	    j.status,
  1129	    j.branch,
  1130	    j.spoken_summary,
  1131	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id)                        AS review_count,
  1132	    (SELECT COUNT(DISTINCT v.model_family) FROM verdicts v WHERE v.job_id = j.id)  AS families_reviewed,
  1133	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id AND v.verdict = 'fail') AS fail_count,
  1134	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id AND v.verdict = 'needs_human') AS escalations
  1135	FROM jobs j
  1136	JOIN seats s ON s.id = j.builder_seat;

