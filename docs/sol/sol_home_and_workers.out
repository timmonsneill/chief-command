   131	
   132	def _log(conn, verb: str, subject: str, granted: bool, detail: str,
   133	         asked_by: str = "unknown", job_id: int | None = None) -> None:
   134	    """The gatekeeper's own record, which does not depend on there being a job.
   135	
   136	    Deploys aren't necessarily about a job, and `events.job_id` is NOT NULL — so before
   137	    this existed, a deploy's grants AND its refusals were dropped on the floor, for the
   138	    one verb where saying it out loud matters most. Append-only by trigger.
   139	    """
   140	    conn.execute(
   141	        "INSERT INTO gate_log (verb, subject, granted, detail, asked_by, job_id) "
   142	        "VALUES (?,?,?,?,?,?)",
   143	        (verb, _clean(subject), int(granted), _clean(detail, 400),
   144	         _clean(asked_by, 60), job_id),
   145	    )
   146	
   147	
   148	def _note(conn, job_id: int | None, text: str, kind: str = "skipped") -> None:
   149	    """Write a refusal (or a grant) onto the job where a person will see it.
   150	
   151	    Refusals are 'skipped' events; a grant is 'done' — a merge showing up in the
   152	    activity stream as a skip was telling Neill the opposite of what happened."""
   153	    if job_id is None:
   154	        return
   155	    row = conn.execute(
   156	        "SELECT builder_seat FROM jobs WHERE id = ?", (job_id,)
   157	    ).fetchone()
   158	    if row is None:
   159	        return
   160	    s = seat(conn, row["builder_seat"])
   161	    if s is None:
   162	        return
   163	    conn.execute(
   164	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   165	        "VALUES (?,?,?,?,?,?,?)",
   166	        (job_id, s["id"], "gatekeeper", s["model"], s["family"], kind, text),
   167	    )
