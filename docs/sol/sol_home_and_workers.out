   368	                # was, so the record and the repository never disagree about shipping.
   369	                _reset_main_to(before, repo)
   370	                raise _no(_plain(exc)) from exc
   371	            try:
   372	                conn.execute("COMMIT")
   373	            except sqlite3.Error:
   374	                # git merged, the record couldn't say so. Same undo, different cause.
   375	                _reset_main_to(before, repo)
