    77	def _repo_and_branch_for_job(conn, project_id: str | None) -> tuple[Path, str]:
    78	    """Which repo + default branch a merge applies to.
    79	
    80	    A job with no project on it (every job before this feature, and every existing
    81	    gatekeeper test's disposable fixture) keeps using the module's OWN REPO/
    82	    MERGE_INTO, read live here rather than captured at import time — that's what
    83	    keeps `monkeypatch.setattr(gatekeeper, "REPO", tmp)` working unchanged in every
    84	    existing test. A job that DOES name a project resolves THAT project's repo, and
    85	    if it can't, the caller must refuse the merge rather than silently falling back
    86	    to a different repo than the one the panel actually reviewed.
    87	    """
    88	    if not project_id:
    89	        return REPO, MERGE_INTO
    90	    return resolve_repo(conn, project_id)
    91	
    92	# A branch name we are willing to merge. Deliberately narrow: `jobs.branch` is written
    93	# by the same code an agent controls, and `git rev-parse --verify` accepts REVISION
    94	# EXPRESSIONS, not just branches — `:/some message` resolves to a commit by searching
    95	# commit messages. A permissive check here turns "merge the branch for job 17" into
    96	# "merge any commit in the repository."
    97	BRANCH_RE = re.compile(r"^job/\d+\Z")
    98	
    99	# What money can be spent ON. The daily caps in the schema are keyed by role, so a role
   100	# nobody validated is a cap nobody enforces — 'research' would sail past both the build
   101	# ration and the review ration.
   102	SPEND_ROLES = {"build", "review", "test", "research", "voice"}
