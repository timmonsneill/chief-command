   821	CREATE TRIGGER IF NOT EXISTS guard_unresolved_escalation
   822	BEFORE UPDATE OF status ON jobs
   823	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   824	BEGIN
