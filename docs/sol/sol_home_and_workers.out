     1	// Chief Command v2 — seat definitions (spec §4)
     2	//
     3	// Providers sit behind NAMED ROLES so any of them can be swapped without touching
     4	// orchestration logic. Nothing else in the harness may reference a provider by name —
     5	// only by seat id. Vendor policy drift is risk #1 on this project (§9).
     6	//
     7	// Hardware (Phase 0 RAM check, §2): M2 Pro, 16 GB. BELOW the spec's 36 GB threshold,
     8	// so the free grinder is a 7B coder, not the hoped-for 30B.
     9	//
    10	// ===========================================================================
    11	// THE ORGANIZING PRINCIPLE
    12	//
    13	// Every seat answers ONE of two questions: "how fast does it talk?" or "how well
    14	// does it think?" Nothing is good at both, because thinking well MEANS taking time.
    15	// So we don't fight the tension — we seat around it:
    16	//
    17	//   MOUTH   fast, dumb, never blocks. Dispatches and narrates.
    18	//   BRAIN   slow, deep. A dispatch target you are never waiting on.
    19	//   WORKHORSE  the best autonomous coder we can buy. Volume + quality.
    20	//   GRINDERS   cheap parallel attempts. Output NEVER ships unreviewed (DB-enforced).
    21	//   REVIEWER   escalation, highest judgment. Optional and droppable.
    22	// ===========================================================================
    23	
    24	// ---------------------------------------------------------------------------
    25	// MOUTH — the Talker. What Neill actually talks to.
    26	//
    27	// Speech-to-speech: audio in, audio out, ONE model, native tool calling. This is
    28	// what deletes the Whisper + Kokoro + Pipecat-plumbing stack that killed v1.
    29	//
    30	// DECISION DEFERRED ON PURPOSE. Both candidates are GA, sub-second, and speak the
    31	// SAME wire protocol (xAI is OpenAI-Realtime-compatible — you change the base URL).
    32	// So: build against the OpenAI Realtime event schema, keep base_url in config, and
    33	// the other becomes a ONE-LINE swap. Do not marry either one.
    34	//
    35	// DECIDED 2026-08-27 (owner), on current measured numbers, not a blog post:
    36	//   grok-voice-think-fast-2.0  $0.08/min ($4.80/hr)  0.70s to first sound  S2S 82.9
    37	//   grok-voice-think-fast-1.0  $0.05/min ($3.00/hr)  1.25s                 S2S 75.7
    38	//   gpt-realtime-2.1 (high)    ~$10.75/hr measured   1.21s                 S2S 79.1
    39	// Grok 2.0 is faster, better and less than half OpenAI's cost. Google is out (rule 5).
    40	// The voice FEELING dumb is the design (the mouth never answers; everything waits on
    41	// the 13s Chief) — the fix is the fast lane (#12), not a vendor swap. OpenAI stays a
    42	// one-line fallback (same wire protocol). Pinned by exact id; never a -latest alias.
    43	// ---------------------------------------------------------------------------
    44	[seats.mouth]
    45	// ⚠️ WHAT ACTUALLY RUNS (found 2026-08-27): the voice page and its token endpoint in
    46	// harness/server.py + harness/web/voice.html are hardwired to OpenAI's realtime API
    47	// over WebRTC. For weeks this block said "grok" while the code ignored it — a config
    48	// that lies. It now says what runs. The DECIDED target is Grok voice 2.0 (above);
    49	// getting there is a BUILD (xAI's realtime is WebSocket-only, so the browser audio
    50	// path must be rewritten, plus its own token step) — queued as the top voice task.
    51	provider = "openai-realtime"
    52	model = "gpt-realtime-2.1"                  // the FULL model: mini won't reliably call the tool
    53	base_url = "https://api.openai.com/v1/realtime"
    54	family = "gpt"
    55	tier = "metered"
    56	turn_detection = "semantic_vad"             // NOT push-to-talk. Owner override.
    57	eagerness = "low"                           // a driver pauses mid-sentence to merge
    58	interrupt_response = true                   // barge-in
    59	
    60	// VOICE HAS ITS OWN BUDGET, separate from the builders. OpenAI realtime measures
    61	// ~$10.75/hr with reasoning up (~$0.06-0.11/min with caching). 480c/day ≈ 45 min-1 hr.
    62	// The Grok 2.0 target is $4.80/hr for the same hour.
    63	daily_cap_cents = 480
    64	notes = "Fast + dumb BY DESIGN. Never blocks. Target: Grok voice 2.0 (build queued)."
    65	
    66	// ---------------------------------------------------------------------------
    67	// BRAIN — deep reasoning, planning, decomposition, judging the gauntlet.
    68	// SLOW BY DESIGN and that is fine: it is a dispatch target, never a conversation
    69	// partner. Its ~13s time-to-first-token is invisible because you are never waiting.
    70	//
    71	// Ultra mode is literally an orchestrator: it decomposes the task and spawns
    72	// parallel subagents trained to coordinate MID-task rather than merge at the end.
    73	// That is the reviewer-gauntlet shape (§6), native.
    74	//   Terminal-Bench 2.1: 88.8% single-agent / 91.9% Ultra — SOTA for agentic work.
    75	// ---------------------------------------------------------------------------
    76	// ═══════════════════════════════════════════════════════════════════════════
    77	// MODEL TIERS — nothing gets the top model by default. Owner (2026-07-14):
    78	//     "If we do highest model every time for every build, on autonomous work, Claude
    79	//      and ChatGPT are gonna bottom out."
    80	//
    81	// THE KEY FACT: the binding constraint on autonomous work is RATE LIMITS, not money.
    82	// Claude and OpenAI are both flat-rate — you already paid. But you CANNOT BUY YOUR WAY
    83	// OUT OF A WEEKLY CAP. Every top-tier call spent on boilerplate is one you don't have
    84	// left for the thing that actually needed it.
    85	//
    86	// So the top tier is EARNED: you ask for it, the work is dangerous (auth/money/data),
    87	// it already failed twice, a reviewer flagged p0/p1, or it's a decision that's
    88	// expensive to reverse. Everything else runs light or standard. See tiering.py — the
    89	// escalation is a RULE, not a vibe, and every job records which tier it got AND WHY.
    90	// ═══════════════════════════════════════════════════════════════════════════
    91	
    92	[seats.brain]
    93	provider = "codex"
    94	model = "gpt-5.6-sol"
    95	tier = "subscription"
    96	family = "gpt"
    97	
    98	// Owner: "Sol needs to be the brain, but prolly doesn't need to be ultra for most
    99	// convos. Maybe if it's managing a major spec and deciding builds and such, but
   100	// generally lower effort in convo."
   101	//
   102	// Measured, and he's right: Sol at FULL effort took over FIVE MINUTES on a real
   103	// question. In a conversation that isn't thorough — it's a hang. Claude at ~8s gave a
   104	// genuinely better answer. So Sol's heavy tier is reserved for what it's actually for:
   105	// specs, architecture, and pushback.
   106	model_light    = "gpt-5.6-luna"             // quick takes
   107	model_standard = "gpt-5.6-terra"            // most work
   108	model_heavy    = "gpt-5.6-sol"              // specs, decisions, pushback. EARNED.
   109	effort_light    = "low"
   110	effort_standard = "medium"
   111	effort_heavy    = "high"
   112	
   113	mode = "ultra"                              // ONLY at heavy. Coordinated subagents.
   114	max_threads = 6                             // spec said 8; the real default is 6
   115	max_depth = 1
   116	notes = "OAuth is TOLERATED, not sanctioned. Most likely seat to break. Keep API-key swap ready."
   117	
   118	// ---------------------------------------------------------------------------
   119	// WORKHORSE — volume autonomous coding. Migrations, refactors, test backfills.
   120	//
   121	// OWNER DECISION (2026-07-13): OpenAI, not Claude. Rationale below — and note the
   122	// reason is NOT the one in the spec.
   123	//
   124	// ⚠️ THE SPEC'S REASON IS WRONG. It says Claude headless draws from a metered credit
   125	// pool. It does NOT — Anthropic announced that, then PAUSED it before it took effect.
   126	// `claude -p` runs on normal subscription limits TODAY. Claude-as-workhorse would not
   127	// cost extra dollars.
   128	//
   129	// ✅ THE REAL REASON, which nobody had written down: RATE LIMITS, not cost. Running a
   130	// workhorse hard (unattended overnight builds, migrations, backfills) burns Max plan
   131	// usage caps — and it's the SAME bucket as interactive use. The failure mode is nasty:
   132	// your autonomous builder silently eats the model you were going to review its work
   133	// with. So Claude stays OUT of the high-volume seat, and stays IN as low-volume
   134	// escalation (see [seats.reviewer]).
   135	//
   136	// GPT-5.6-sol is not a consolation prize here: 88.8% Terminal-Bench 2.1 (91.9% Ultra),
   137	// SOTA for agentic coding. Flat subscription, predictable, bounded.
   138	//
   139	// For the record, since it may matter on the Studio later:
   140	//     Claude Opus  87.6% SWE-bench Verified   (best autonomous coder available)
   141	//     GPT-5.6-sol  64.6% SWE-bench Pro / 88.8% Terminal-Bench  (top-tier agentic)
   142	//     Grok Build   70.8% SWE-bench Verified   (weak model, great harness)
   143	// ---------------------------------------------------------------------------
   144	[seats.workhorse]
   145	provider = "codex"
   146	model = "gpt-5.6-sol"
   147	tier = "subscription"
   148	family = "gpt"
   149	worktree_isolated = true
   150	
   151	model_light    = "gpt-5.6-luna"             // scaffolding, boilerplate, first drafts
   152	model_standard = "gpt-5.6-terra"            // the bulk of real building
   153	model_heavy    = "gpt-5.6-sol"              // auth, money, data, or it failed twice
   154	notes = "OpenAI sub. Shares auth with [seats.brain] — see CONCENTRATION RISK below."
   155	
   156	// The Claude builders — Riggs (backend), Finn (frontend), Nova (glue). Same lanes,
   157	// same memory, tiered the same way. Opus is the best coder we own (87.6% SWE-bench);
   158	// it is also the one most likely to burn a weekly cap, so it is EARNED like the rest.
   159	[seats.riggs]
   160	provider = "claude-cli"
   161	model = "claude-opus-4-8"
   162	family = "claude"
   163	tier = "subscription"
   164	model_light    = "claude-haiku-4-5"
   165	model_standard = "claude-sonnet-5"
   166	model_heavy    = "claude-opus-4-8"          // the best coder we have. EARNED.
   167	notes = "Backend lane. Memory belongs to the LANE, not the model — swap the model, keep the scars."
   168	
   169	// ---------------------------------------------------------------------------
   170	// GROK — builder + cross-family reviewer.
   171	//
   172	// ⚠️ TWO EARLIER CLAIMS OF MINE WERE WRONG. Correcting both, on the record:
   173	//
   174	//   1. "Grok Build is weak (70.8% SWE-bench)." FALSE. That was grok-build-0.1, a
   175	//      legacy option nobody runs. Grok Build now DEFAULTS to grok-4.5. On a single
   176	//      consistent agentic-coding index: Grok 4.5 = 76, Codex = 76, Claude Code = 78.
   177	//      It is not the weak sibling. It matches Codex at ~half the cost/task ($2.49).
   178	//
   179	//   2. "The 403 is a Heavy-only tier gate." FALSE. It's an UNDISCLOSED MONTHLY QUOTA
   180	//      on standard SuperGrok. The 403 body lies — it says "you do not have an active
   181	//      Grok subscription" when you do and have merely run out. Users have been locked
   182	//      out after ~3 days of LIGHT cron use. Nobody publishes the quota.
   183	//
   184	// I also invented a workload ("throw 8 parallel attempts, let the gauntlet pick") to
   185	// compensate for a weakness that was my own measurement error. Dropped. Grok is just
   186	// a good, cheap builder. No exotic volume pattern needed.
   187	//
   188	// THE ANSWER TO THE HIDDEN QUOTA: don't choose between sub and API — run BOTH.
   189	// Subscription primary, metered API key as fallback on the same seat. When the
   190	// mystery quota dies at 2am mid-build, the seat fails over to the key and KEEPS
   191	// GOING instead of stalling the run. Subscription economics, metered reliability.
   192	//
   193	// HARD CEILING: $30 sub + $30/mo API cap = $60/mo maximum, no surprises.
   194	// (daily_cap_cents 100 x ~30 days = ~$30/mo of fallback.)
   195	// ---------------------------------------------------------------------------
   196	// GROK BUILDS LESS THAN THE OTHERS — deliberately. Owner (2026-07-13):
   197	//     "it can review as much as it wants more or less, but shouldn't build as much
   198	//      as claude and chat"
   199	//
   200	// He's right, and the economics agree. Claude and OpenAI are FLAT-RATE — a build on
   201	// those seats costs nothing marginal, it's already bought. Grok is METERED, so every
   202	// build is real money leaving the account. And builds are the EXPENSIVE kind of work
   203	// (token-heavy) while reviews are CHEAP (read-heavy, ~1/10 the tokens).
   204	//
   205	//     BUILD on the seats you already pay for.
   206	//     REVIEW on the metered one, because reviewing is cheap.
   207	//
   208	// Which lands Grok exactly where it's most valuable anyway. Its worth was never being
   209	// the strongest coder — it isn't. It's being a DIFFERENT MIND that catches what Claude
   210	// and GPT both miss. And that job costs pennies.
   211	[seats.grok]
   212	provider = "xai"
   213	model = "grok-4.5"                          // NOT grok-build-0.1 (legacy, weak)
   214	tier = "metered"                            // the runner calls the paid API with a key;
   215	family = "grok"                             // the SuperGrok sub covers the app, NOT this
   216	
   217	// Was OFF while the leaked xAI key was unrotated. Key rotated 2026-07-21; the runner
   218	// landed 2026-08-27 and the seat came back on the same day — a third mind on the panel.
   219	// If it must be turned off again, turn it OFF here rather than leaving it failing: an
   220	// enabled seat with no working key is a panel member that can never report. (A missing
   221	// key now excludes the seat at the door instead — see gauntlet.has_runner.)
   222	//
   223	// Owner decision, 2026-07-21: GROK DOES NOT TOUCH THE ARCH MEDICAL-RECORDS REPO. That
   224	// repo is out of scope entirely (Decision C); this line records the standing rule.
   225	disabled = false
   226	worktree_isolated = true
   227	daily_cap_cents  = 100                      // $1/day = ~$30/mo HARD CEILING
   228	build_cap_cents  = 25                       // ~25c/day of building — a RATION
   229	review_cap_cents = 75                       // reviewing is cheap; let it look at everything
   230	notes = "Reviews freely. Builds sparingly. Metered API, capped by the record."
   231	
   232	// ---------------------------------------------------------------------------
   233	// FREE GRINDER — the local junior. Overnight scaffolding, boilerplate, first drafts.
   234	// Sized for 16 GB. A junior dev, and treated as one: guard 1 in schema.sql makes it
   235	// STRUCTURALLY IMPOSSIBLE for its output to reach `done` unreviewed.
   236	// ---------------------------------------------------------------------------
   237	[seats.grinder_local]
   238	provider = "ollama"
   239	model = "qwen2.5-coder:7b"
   240	tier = "local"
   241	family = "qwen"
   242	endpoint = "http://127.0.0.1:11434"
   243	notes = "Bump to qwen3-coder:30b on the Studio (§8 phase 5). One line."
   244	
   245	// ---------------------------------------------------------------------------
   246	// REVIEWER — escalation only. Highest judgment: architecture calls, contested
   247	// verdicts, the bug the local model looped on three times.
   248	//
   249	// Claude stays in the hierarchy HERE, deliberately. At escalation volume (a handful
   250	// of calls a day) it will not dent the Max rate limits that disqualify it from the
   251	// workhorse seat — and it is already paid for.
   252	//
   253	// It earns its seat twice over: it is the strongest model on the board (87.6%
   254	// SWE-bench Verified), AND it is a FOURTH model family in the gauntlet. §6 exists
   255	// because different models miss different bugs. Claude catching what GPT and Grok
   256	// both missed is the entire point of keeping it.
   257	//
   258	// Per spec §4.4 this seat is optional and droppable — the system must run without it.
   259	// Never at the mouth: claude-cli spawns a subprocess per call (3-5s).
   260	// ---------------------------------------------------------------------------
   261	[seats.reviewer]
   262	provider = "claude-cli"                     // sanctioned path; subscription OAuth is NOT
   263	model = "claude-opus-4-8"
   264	tier = "subscription"                       // NOT credits — the pool was paused, never shipped
   265	family = "claude"
   266	optional = true
   267	max_calls_per_day = 25                      // keeps escalation from eating interactive headroom
   268	
   269	// Owner: "Reviewers prolly need to be opus and one model down for ChatGPT, unless we
   270	// say to go high review or we have a good trigger to do higher reviews."
   271	//
   272	// THE RULE: A REVIEWER IS NEVER WEAKER THAN THE BUILDER. A junior checking a senior's
   273	// work is theatre — it produces a green tick and no safety. So review tier FLOORS at
   274	// whatever tier built the thing. And reviews are cheap anyway (read-heavy, ~1/10th the
   275	// tokens of a build), so generosity here costs far less than generosity on the build.
   276	model_standard = "claude-sonnet-5"          // ordinary reviews
   277	model_heavy    = "claude-opus-4-8"          // dangerous areas, heavy builds, or you asked
   278	notes = "Low-volume escalation. Strongest model + 4th model family. Droppable by design."
   279	
   280	// ===========================================================================
   281	// ⚠️ CONCENTRATION RISK — read before changing anything above
   282	//
   283	// [seats.brain] and [seats.workhorse] BOTH run on the Codex OAuth path. That path is
   284	// TOLERATED, NOT SANCTIONED: no OpenAI doc blesses third-party OAuth, and their ToS
   285	// forbids sharing account credentials. Anthropic closed this exact door in Feb/Apr
   286	// 2026; Google closed it in Feb–June 2026 WITH ACCOUNT BANS. OpenAI is the last
   287	// vendor standing, and that is a TIMING position, not a policy position.
   288	//
   289	// If it closes, we lose the brain AND the builder in the same morning.
   290	//
   291	// Mitigation (cheap, and worth having ready rather than improvised under pressure):
   292	// both seats must swap to a paid API key by changing `provider`/`tier` here and
   293	// NOTHING else. That is what the seat abstraction is for. Test the swap before we
   294	// need it.
   295	// ===========================================================================
   296	
   297	// ===========================================================================
   298	// VOICE — how much it tells you, and when.
   299	//
   300	// THE RULE: one event stream, two renderings. The voice and the text are not two
   301	// systems — they read the SAME job records at different verbosity. Anything the
   302	// voice says, you could have read. Anything you can read, the voice can summarize.
   303	//
   304	//   VOICE  → a sentence.  "Riggs is on it."
   305	//   TEXT   → the terminal. Every tool call, every file, every result.
   306	//
   307	// Voice escalates on request. That's the interaction model: fast by default, deep
   308	// on demand — the same principle that put a quick model at the mouth and a slow one
   309	// at the brain.
   310	//
   311	// SHORT IS NOT A STYLE PREFERENCE — IT'S THE BILL. Audio output is 55-70% of the
   312	// realtime cost and runs ~16x the price of the same content as text. A chatty voice
   313	// is an expensive voice. §5.3 already asked for short spoken summaries with full
   314	// detail in the log; it was written for latency and it pays off twice.
   315	// ===========================================================================
   316	[voice]
   317	default_depth = "brief"                     // brief | normal | detailed
   318	
   319	// What each depth actually says:
   320	//   brief    "Riggs is on it."
   321	//   normal   "Riggs, on Claude — editing routes.py."
   322	//   detailed "Riggs on Claude: read auth.py, then edited routes.py, then ran tests.
   323	//             Panel: 5 of 6 passed, 3 different models."
   324	//
   325	// ALWAYS name the model at 'normal' and above. "Riggs" alone doesn't tell you
   326	// whether your auth module was built by your best coder or your cheapest one.
   327	speak_the_model = true
   328	
   329	// Phrases that pull the voice deeper into the same stream the text channel shows.
   330	escalate_on = [
   331	  "what's it doing", "tell me more", "details", "go deeper",
   332	  "what happened", "walk me through it", "why",
   333	]
   334	
   335	// Volunteer bad news; stay quiet about good news unless asked. Nobody wants a
   336	// running commentary on a build that's going fine.
   337	interrupt_me_on = ["failed", "needs_human", "over_budget", "guard_blocked"]
   338	stay_quiet_on   = ["thinking", "read", "edit"]
   339	
   340	// Spoken replies get truncated to this. The full text is always in the log.
   341	max_spoken_seconds = 12
   342	
   343	// ---------------------------------------------------------------------------
   344	// GAUNTLET (§6) — reviewers run in PARALLEL against one frozen bundle.
   345	// The model-family rule is recorded per-verdict in the DB, so it is AUDITABLE
   346	// rather than merely asserted. Different models miss different bugs.
   347	//
   348	// Four families available: gpt (brain), claude (reviewer), grok (grok),
   349	// qwen (grinder_local, the LOCAL builder — not a reviewer of its own work).
   350	//
   351	// The panel is HIGHER-TIER cross-family reviewers of a local build. Three runners
   352	// exist today: claude-cli, codex (needs the codex login), and xai (needs XAI_API_KEY
   353	// in the environment). If fewer than two families can actually run, the family-floor
   354	// guard correctly PARKS jobs (it does not lower the bar) — see migration 005. That is
   355	// the safe failure, not a bug.
   356	// ---------------------------------------------------------------------------
   357	[gauntlet]
   358	reviewers = ["reviewer", "brain", "grok"]   // claude · gpt · grok — real seats, all resolve
   359	min_model_families = 2                      // §6 floor; we can reach 4
   360	escalate_to = "reviewer"                    // needs_human resolution seat
   361	escalate_to_human_on = ["needs_human"]      // ...or Neill's queue
   362	
   363	// ---------------------------------------------------------------------------
   364	// PROJECTS — the one folder real project code is allowed to live under.
   365	//
   366	// `db.projects.resolve_repo` refuses any project whose repo_path resolves OUTSIDE
   367	// this root, even if the path itself looks legitimate. This is what stops a job
   368	// (or a test that forgot to repoint a project row) from silently driving some
   369	// other repo on this machine — a missed guard here is a wrong-repo build nobody
   370	// would notice until review, not a crash you'd catch immediately.
   371	// ---------------------------------------------------------------------------
   372	[projects]
   373	root = "~/code-projects"

