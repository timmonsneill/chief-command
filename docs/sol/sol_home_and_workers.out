   113	
   114	# ---------------------------------------------------------------------------
   115	# Worktree isolation — a builder never touches the live project.
   116	# ---------------------------------------------------------------------------
   117	def _make_worktree(job_id: int, branch: str, source_repo: Path | None = None,
   118	                   source_branch: str = "main") -> tuple[Path | None, str]:
   119	    """Give this job its own private copy of the repo. Returns (path, note).
   120	
   121	    Checks out `source_branch` EXPLICITLY — a live wiring review found the earlier
   122	    version left the branch unnamed, which meant "whatever the source repo's
   123	    working copy happens to be sitting on right now" (the same class of bug
   124	    `db.projects._default_branch` was fixed for). A builder's starting point must be
   125	    the project's actual main line, not an accident of what a person or another job
   126	    left checked out.
   127	
   128	    If git worktrees aren't usable for any reason, fall back to a plain isolated
   129	    directory and SAY SO — a silent fallback that quietly drops isolation would be
   130	    exactly the kind of unspoken gap this project keeps getting bitten by.
   131	    """
   132	    WORKTREES.mkdir(exist_ok=True)
   133	    dest = WORKTREES / f"job-{job_id}"
   134	    if dest.exists():
   135	        return dest, "reused"
   136	    source_repo = source_repo if source_repo is not None else HARNESS.parent
   137	    try:
   138	        subprocess.run(
   139	            ["git", "worktree", "add", "--detach", str(dest), source_branch],
   140	            cwd=source_repo, capture_output=True, text=True, timeout=60, check=True,
   141	        )
   142	        return dest, "worktree"
   143	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   144	        # Isolation still holds (separate dir, outside the repo tree) — it just isn't a
   145	        # git worktree, so we record that honestly.
   146	        dest.mkdir(parents=True, exist_ok=True)
   147	        detail = getattr(exc, "stderr", "") or str(exc)
   148	        return dest, f"plain-dir ({str(detail)[:60].strip()})"
   149	
   150	
   151	def _make_clone(job_id: int, branch: str, source_repo: Path | None = None,
   152	                source_branch: str = "main") -> tuple[Path | None, str]:
   153	    """A standalone clone for code builders — the isolation a linked worktree
   154	    cannot provide.
   155	
   156	    `git worktree add` shares $GIT_COMMON_DIR with the live repo: .git/config,
   157	    hooks, refs, the object store. A builder holding real Edit/Write tools inside a
   158	    worktree could, in principle, move refs/heads/main or rewrite .git/config —
   159	    Sol's design gate named this explicitly as a hard STOP. A clone has its OWN
   160	    .git; nothing written inside it can touch the source repo's refs or config.
   161	
   162	    NO FALLBACK to a plain directory here (unlike _make_worktree): a code build
   163	    that can't be isolated must not run at all. The local text builder can fall
   164	    back honestly because it has no shell and writes one known file; a code
   165	    builder with edit tools cannot make that same trade.
   166	    """
   167	    CLONES.mkdir(exist_ok=True)
   168	    dest = CLONES / f"job-{job_id}"
   169	    if dest.exists():
   170	        # Sol's design gate: an existing job directory accepted without checking
   171	        # its cleanliness/HEAD is a way to redirect a builder. Refuse to reuse.
   172	        return None, "an isolated copy for this job already exists"
   173	    source_repo = source_repo if source_repo is not None else HARNESS.parent
   174	    try:
   175	        subprocess.run(
   176	            ["git", "clone", "--quiet", "--no-hardlinks", "--branch", source_branch,
   177	             str(source_repo), str(dest)],
   178	            capture_output=True, text=True, timeout=120, check=True,
   179	        )
   180	        subprocess.run(
   181	            ["git", "checkout", "-q", "-B", branch], cwd=dest,
   182	            capture_output=True, text=True, timeout=30, check=True,
   183	        )
   184	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   185	        if dest.exists():
   186	            subprocess.run(["rm", "-rf", str(dest)], capture_output=True, text=True)
   187	        detail = getattr(exc, "stderr", "") or str(exc)
   188	        return None, f"could not create an isolated copy ({str(detail)[:80].strip()})"
   189	    return dest, "clone"
   190	
   191	
   192	def cleanup_clone(job_id: int) -> None:
   193	    """Remove a job's clone AND its settings file.
   194	
   195	    Called from two places with two different meanings: (a) here in this module,
   196	    on every FAILED claude-cli build — a failed job has nothing left worth reading,
   197	    and leaving the clone behind would block a retry (_make_clone refuses to reuse
   198	    an existing job directory). (b) NOT called automatically when a diff job
   199	    reaches 'done' — Neill reads the candidate first; see gauntlet._ask_to_ship's
   200	    diff-kind branch, which deliberately never calls this on the success path.
   201	    """
   202	    dest = CLONES / f"job-{job_id}"
   203	    settings = dest.parent / f"{dest.name}.settings.json"
   204	    if dest.exists():
   205	        subprocess.run(["rm", "-rf", str(dest)], capture_output=True, text=True)
   206	    if settings.exists():
   207	        try:
   208	            settings.unlink()
   209	        except OSError:
   210	            pass
   211	
   212	
   213	def cleanup_worktree(conn, job_id: int) -> None:
   214	    """Remove a job's worktree once its work is merged or abandoned.
   215	
   216	    Runs `git worktree remove` (and a `prune`) against the job's OWN project repo —
   217	    a live wiring review against a real Jess clone found this always ran against
   218	    `HARNESS.parent` (this repo) regardless of which repo actually owned the
   219	    worktree, which leaves a stale entry behind in the project's REAL repo forever
   220	    (git worktree metadata lives with the repo that created it, not the worktree
   221	    directory itself — removing the directory from the wrong repo's cwd does
   222	    nothing to that repo's own bookkeeping). `conn` is what lets this resolve which
   223	    repo that is; every caller already has one.
   224	    """
   225	    dest = WORKTREES / f"job-{job_id}"
   226	    row = conn.execute(
   227	        "SELECT project_id FROM jobs WHERE id = ?", (job_id,)
   228	    ).fetchone()
   229	    project_id = row["project_id"] if row else None
   230	    repo: Path | None = HARNESS.parent
   231	    if project_id:
   232	        from db.projects import ProjectRepoUnavailable, resolve_repo
   233	        try:
   234	            repo, _branch = resolve_repo(conn, project_id)
   235	        except ProjectRepoUnavailable:
   236	            # Can't safely name the repo that owns this worktree's metadata — do
   237	            # NOT guess by touching some other repo's `git worktree` bookkeeping.
   238	            # The directory itself can still be cleared below.
   239	            repo = None
   240	    if dest.exists():
   241	        if repo is not None:
   242	            subprocess.run(["git", "worktree", "remove", "--force", str(dest)],
   243	                           cwd=repo, capture_output=True, text=True)
   244	        if dest.exists():
   245	            subprocess.run(["rm", "-rf", str(dest)], capture_output=True, text=True)
   246	    if repo is not None:
   247	        # A --force remove can leave a stale entry behind if the directory was
   248	        # already gone by another path; prune clears anything that points at
   249	        # nothing rather than trusting the remove above always caught it.
   250	        subprocess.run(["git", "worktree", "prune"], cwd=repo,
   251	                       capture_output=True, text=True)
   252	
   253	
   254	# ---------------------------------------------------------------------------
   255	# The actual builders, one per provider. Add a provider = add a function.
   256	# ---------------------------------------------------------------------------
   257	# The claude-cli builder — locked down the same way gauntlet.py's reviewer CLI
   258	# calls are (see that file's `_claude_cmd` / `assert_reviewers_locked_down`, which
   259	# this mirrors). Checked against `claude --help` on this machine, 2026-08-27:
   260	#   --append-system-prompt-file does NOT exist on this build (only
   261	#   --append-system-prompt <text>, which is an argv value, not a file, and this
   262	#   project's rule is prompt-on-stdin only — variadic flags swallow a positional
   263	#   argument). So project-aware conventions and notes travel on stdin, ahead of the
   264	#   actual request, clearly labelled as background context rather than an instruction
   265	#   to follow over the task (see _compose_builder_prompt).
   266	# ---------------------------------------------------------------------------
   267	def _claude_build_argv(model: str, clone: Path, settings_path: Path) -> list[str]:
   268	    return [
   269	        "claude", "-p",
   270	        "--setting-sources", "",       # no user/project/local settings load at all
   271	        "--strict-mcp-config",         # ...so no MCP server the caller happens to have
   272	        "--restricted",                # ...no Bash/shell tools, file tools confined
   273	        "--safe-mode",                 #    to the working dirs, no hooks/skills/plugins
   274	        "--permission-mode", "acceptEdits",   # headless: apply edits, never prompt
   275	        "--tools", "Read Edit Write Glob Grep",   # no Bash — deliberately, tonight
   276	        "--add-dir", str(clone),
   277	        "--settings", str(settings_path),
   278	        "--max-budget-usd", "3",
   279	        "--model", model,
   280	        "--output-format", "json",
   281	    ]
   282	
   283	
   284	def _flag_value(argv: list[str], flag: str) -> str | None:
   285	    try:
   286	        i = argv.index(flag)
   287	    except ValueError:
   288	        return None
   289	    return argv[i + 1] if i + 1 < len(argv) else None
   290	
   291	
   292	def assert_builders_locked_down() -> None:
   293	    """Inspect the argv a build call would actually use and refuse to build if a
   294	    lockdown flag is missing. Builds argv only — never spawns a process — so it's
   295	    cheap enough to call before every build. Mirrors
   296	    gauntlet.assert_reviewers_locked_down(); a refactor that drops --restricted or
   297	    swaps --tools for something wider fails the FIRST build loudly instead of
   298	    quietly running every build after it wide open.
   299	    """
   300	    argv = _claude_build_argv(
   301	        "probe-model", Path("/tmp/chief-build-probe"),
   302	        Path("/tmp/chief-build-probe/settings.json"),
   303	    )
   304	    failures: list[str] = []
   305	    if _flag_value(argv, "--setting-sources") != "":
   306	        failures.append("claude: --setting-sources must be present and empty")
   307	    if "--strict-mcp-config" not in argv:
   308	        failures.append("claude: --strict-mcp-config is missing")
   309	    if "--restricted" not in argv:
   310	        failures.append("claude: --restricted is missing")
   311	    if "--safe-mode" not in argv:
   312	        failures.append("claude: --safe-mode is missing")
   313	    if _flag_value(argv, "--permission-mode") != "acceptEdits":
   314	        failures.append("claude: --permission-mode acceptEdits is missing")
   315	    if _flag_value(argv, "--tools") != "Read Edit Write Glob Grep":
   316	        failures.append("claude: --tools must be exactly 'Read Edit Write Glob Grep' (no Bash)")
   317	    if not _flag_value(argv, "--add-dir"):
   318	        failures.append("claude: --add-dir is missing")
   319	    if not _flag_value(argv, "--settings"):
   320	        failures.append("claude: --settings is missing")
   321	    if _flag_value(argv, "--max-budget-usd") != "3":
   322	        failures.append("claude: --max-budget-usd 3 is missing")
   323	    if _flag_value(argv, "--output-format") != "json":
   324	        failures.append("claude: --output-format json is missing")
   325	    if not _flag_value(argv, "--model"):
   326	        failures.append("claude: --model is missing")
   327	    if failures:
   328	        raise RuntimeError(
   329	            "builder lockdown check failed — refusing to build: " + "; ".join(failures)
   330	        )
   331	
   332	
   333	MEMORY_INDEX_MAX_CHARS = 8000        # a project's MEMORY.md can be large; cap what
   334	                                     # rides into every single build prompt
   335	REPO_CONVENTIONS_MAX_CHARS = 8000    # same cap, for a project's own CLAUDE.md/AGENTS.md
   336	
   337	
   338	def _lane_memory_text(project_id: str, seat_id: str) -> str:
   339	    """This PROJECT's own conventions for THIS builder seat — never a different
   340	    project's (Sol's design gate flagged prepending the wrong project's memory as a
   341	    real bug, 2026-07-xx), and never a hardcoded filename (a live wiring review
   342	    found this always read `riggs.md` regardless of which seat was actually
   343	    building — harmless today because riggs is the only seat with a lane file, but
   344	    wrong the moment a second one gets one). Looks for a project-specific file
   345	    first, falls back to the shared one, in `lanes/<project_id>/<seat_id>.md` then
   346	    `lanes/<seat_id>.md`.
   347	
   348	    `project_id` is about to become a path segment — refuse anything that doesn't
   349	    look like a real id rather than build a path out of it. `seat_id` comes from
   350	    the seats table (admin-controlled config, not a job's own free text) but gets
   351	    the same check for the same reason: it's the same kind of use.
   352	    """
   353	    if not (_SAFE_PATH_SEGMENT_RE.match(project_id or "")
   354	            and _SAFE_PATH_SEGMENT_RE.match(seat_id or "")):
   355	        return ""
   356	    for path in (
   357	        HARNESS / "config" / "lanes" / project_id / f"{seat_id}.md",
   358	        HARNESS / "config" / "lanes" / f"{seat_id}.md",
   359	    ):
   360	        try:
   361	            text = path.read_text()
   362	        except OSError:
   363	            continue
   364	        if text.strip():
   365	            return text
   366	    return ""
   367	
   368	
   369	def _repo_conventions_text(repo: Path | None) -> str:
   370	    """A project's own CLAUDE.md/AGENTS.md, read straight off its repo root.
   371	
   372	    Not every project has a `memory_dir` configured (chief and jess don't today),
   373	    but every real project repo already carries one of these — its own canonical
   374	    rules, not a copy that can drift out of sync with them. `repo` is whatever the
   375	    builder is actually about to work in (the resolved project repo, or this
   376	    harness's own repo for a legacy job with no project on it) — never guessed from
   377	    anywhere else.
   378	    """
   379	    if repo is None:
   380	        return ""
   381	    for name in ("CLAUDE.md", "AGENTS.md"):
   382	        try:
   383	            text = (repo / name).read_text()
   384	        except OSError:
   385	            continue
   386	        if text.strip():
   387	            return text
   388	    return ""
   389	
   390	
   391	def _compose_builder_prompt(request: str, lane_text: str, memory_text: str | None,
   392	                            repo_conventions_text: str | None = None) -> str:
   393	    """Everything that rides into the builder ahead of the actual task, each part
   394	    clearly labelled as background so the model never mistakes a project's own notes
   395	    for an instruction to follow over the real request."""
   396	    sections: list[str] = []
   397	    if lane_text.strip():
   398	        sections.append(
   399	            "Background — this project's own conventions (read-only context, not "
   400	            f"part of the task):\n\n{lane_text.strip()}"
   401	        )
   402	    if repo_conventions_text and repo_conventions_text.strip():
   403	        sections.append(
   404	            "Background — this project's own CLAUDE.md/AGENTS.md (read-only "
   405	            "context, not part of the task):\n\n"
   406	            f"{repo_conventions_text.strip()[:REPO_CONVENTIONS_MAX_CHARS]}"
   407	        )
   408	    if memory_text and memory_text.strip():
   409	        sections.append(
   410	            "Background — this project's own accumulated notes (read-only context, "
   411	            f"not part of the task):\n\n{memory_text.strip()[:MEMORY_INDEX_MAX_CHARS]}"
   412	        )
   413	    sections.append(f"The task:\n\n{request}")
   414	    return "\n\n---\n\n".join(sections)
   415	
   416	
   417	def _settings_path_for(clone: Path) -> Path:
   418	    """Where a clone's --settings file lives: alongside the clone, in CLONES
   419	    itself (never inside the clone — see the per-job --settings contract in
   420	    _claude_build_argv), named after the clone directory."""
   421	    return clone.parent / f"{clone.name}.settings.json"
   422	
   423	
   424	def _plain_builder_error(raw: str) -> str:
   425	    """Turn CLI/vendor text into something Neill could read without flinching.
   426	    Only translates the ONE pattern we know shows up in practice (an unauthenticated
   427	    session); anything else stays as truncated raw text — this is a translation of
   428	    a specific known phrase, not a general jargon filter."""
   429	    if "not logged in" in raw.lower():
   430	        return "the builder isn't signed in on this machine"
   431	    return raw.strip()[:300]
   432	
   433	
   434	def _claude_cli_build(seat_row, request: str, model: str, clone: Path) -> str:
   435	    """Run the builder INSIDE the clone with the already-composed full prompt.
   436	
   437	    Returns the CLI's raw stdout (a JSON envelope) for logging only — the actual work
   438	    product is whatever changed on disk, which the CALLER commits. This function never
   439	    reads or trusts the model's own narration of what it did.
   440	    """
   441	    assert_builders_locked_down()
   442	    settings_path = _settings_path_for(clone)
   443	    settings_path.write_text(json.dumps({"permissions": {"additionalDirectories": []}}))
   444	    argv = _claude_build_argv(model, clone, settings_path)
   445	
   446	    # MINIMAL ENV. PATH so the CLI's own subprocess calls (git) resolve; HOME so it
   447	    # finds its OAuth session — nothing else. No XAI_API_KEY, no OPENAI_API_KEY: a
   448	    # diff a builder writes must never be able to read a sibling provider's key out
   449	    # of its own process environment.
   450	    env = {
   451	        "PATH": os.environ.get("PATH", "/usr/bin:/bin:/usr/local/bin"),
   452	        "HOME": os.environ.get("HOME", str(Path.home())),
   453	        # USER, not just HOME: verified live that with only PATH+HOME the CLI
   454	        # exits "Not logged in" — the macOS Keychain lookup for the OAuth session
   455	        # keys off USER as well. Still no XAI_API_KEY/OPENAI_API_KEY — a sibling
   456	        # provider's key must never reach this process.
   457	        "USER": os.environ.get("USER", ""),
   458	    }
   459	    proc = subprocess.run(
   460	        argv, input=request, cwd=clone, env=env,
   461	        capture_output=True, text=True, timeout=BUILD_TIMEOUT_S,
   462	    )
   463	    if proc.returncode != 0:
   464	        raise RuntimeError(_plain_builder_error(proc.stderr or proc.stdout))
   465	
   466	    # The exit code alone isn't enough — the CLI can exit 0 with an envelope that
   467	    # says the run didn't actually finish (mirrors gauntlet.py's _claude_review,
   468	    # which does the same is_error check for the review path). NOTHING gets
   469	    # committed on any of these: the caller only calls _commit_diff_in_clone after
   470	    # this function returns successfully.
   471	    try:
   472	        envelope = json.loads(proc.stdout)
   473	    except ValueError as exc:
   474	        raise RuntimeError("the builder's reply wasn't readable JSON") from exc
   475	    if not isinstance(envelope, dict):
   476	        raise RuntimeError("the builder's reply wasn't the JSON envelope we expected")
   477	    if envelope.get("is_error"):
   478	        raise RuntimeError(_plain_builder_error(str(envelope.get("result", ""))))
   479	    subtype = envelope.get("subtype")
   480	    if subtype and subtype != "success":
   481	        raise RuntimeError(f"the builder didn't finish cleanly ({subtype})")
   482	    return proc.stdout
   483	
   484	
   485	def _ollama_build(seat_row, request: str, model: str) -> str:
   486	    """The free local coder actually writes the code."""
   487	    payload = json.dumps({"model": model, "prompt": request, "stream": False}).encode()
   488	    req = urllib.request.Request(
   489	        OLLAMA_URL, data=payload, headers={"Content-Type": "application/json"}
   490	    )
   491	    with urllib.request.urlopen(req, timeout=300) as r:
   492	        return json.loads(r.read())["response"].strip()
   493	
   494	
   495	_BUILDERS = {
   496	    "ollama": _ollama_build,
   497	}
   498	
   499	
   500	@dataclass
   501	class ClonedCommit:
   502	    sha: str | None
   503	    reason: str = ""          # why sha is None, in plain words (the job's error text)
   504	
   505	
   506	def _disallowed_files_staged(clone: Path) -> list[str]:
   507	    try:
   508	        raw = subprocess.run(["git", "diff", "--cached", "--raw"], cwd=clone,
   509	                             capture_output=True, text=True, timeout=30)
   510	        numstat = subprocess.run(["git", "diff", "--cached", "--numstat"], cwd=clone,
   511	                                 capture_output=True, text=True, timeout=30)
   512	    except (subprocess.TimeoutExpired, OSError):
   513	        return ["(could not check what changed — refusing to guess)"]
   514	    if raw.returncode != 0 or numstat.returncode != 0:
   515	        # An empty result here used to mean "nothing to flag" — indistinguishable
   516	        # from git having FAILED to tell us anything at all. A check that can't
   517	        # run is not a clean bill of health.
   518	        return ["(could not check what changed — refusing to guess)"]
   519	    return git_policy.disallowed_paths(raw.stdout.splitlines(), numstat.stdout.splitlines())
   520	
   521	
   522	def _commit_diff_in_clone(clone: Path, job_id: int, branch: str, summary: str) -> ClonedCommit:
   523	    """Commit whatever the builder changed — and refuse to commit anything that
   524	    isn't a plain text file. This is the FIRST of the two places that list is
   525	    enforced (gatekeeper.merge re-applies it at merge time on the committed range;
   526	    see git_policy.py's docstring) — together they mean no path a builder can take
   527	    lands something the panel never saw the shape of, in main.
   528	    """
   529	    env = {**os.environ,
   530	           "GIT_AUTHOR_NAME": "chief-worker", "GIT_AUTHOR_EMAIL": "worker@chief.local",
   531	           "GIT_COMMITTER_NAME": "chief-worker", "GIT_COMMITTER_EMAIL": "worker@chief.local"}
   532	
   533	    def git(*args, timeout=60):
   534	        return subprocess.run(["git", *args], cwd=clone, capture_output=True, text=True,
   535	                              timeout=timeout, env=env)
   536	
   537	    try:
   538	        if git("rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
   539	            return ClonedCommit(None, "the isolated copy isn't a real git checkout")
   540	        if git("add", "-A").returncode != 0:
   541	            return ClonedCommit(None, "could not stage the change")
   542	        staged = git("diff", "--cached", "--name-only").stdout.strip()
   543	        if not staged:
   544	            return ClonedCommit(None, "nothing changed — there's no work to review")
   545	        bad = _disallowed_files_staged(clone)
   546	        if bad:
   547	            git("reset")          # unstage — leave nothing half-prepared behind
   548	            return ClonedCommit(
   549	                None,
   550	                "the change touches things that can't be reviewed as plain code "
   551	                f"({', '.join(bad)[:200]})",
   552	            )
   553	        if git("commit", "-q", "-m", f"job {job_id}: {summary[:60]}").returncode != 0:
   554	            return ClonedCommit(None, "the change couldn't be committed")
   555	        sha = git("rev-parse", "HEAD").stdout.strip()
   556	    except (subprocess.TimeoutExpired, OSError) as exc:
   557	        return ClonedCommit(None, f"git didn't respond ({str(exc)[:80]})")
   558	    if len(sha) != 40:
   559	        return ClonedCommit(None, "git didn't return a real commit id")
   560	    return ClonedCommit(sha)
   561	
   562	
   563	def _merge_base_with_main(clone: Path, branch: str = "main") -> str | None:
   564	    try:
   565	        out = subprocess.run(["git", "merge-base", branch, "HEAD"], cwd=clone,
   566	                             capture_output=True, text=True, timeout=30)
   567	    except (subprocess.TimeoutExpired, OSError):
   568	        return None
   569	    return (out.stdout.strip() or None) if out.returncode == 0 else None
   570	
   571	
   572	def _diff_against_main(clone: Path, base: str, tip: str) -> str | None:
   573	    try:
   574	        out = subprocess.run(["git", "diff", f"{base}..{tip}"], cwd=clone,
   575	                             capture_output=True, text=True, timeout=60)
   576	    except (subprocess.TimeoutExpired, OSError):
   577	        return None
   578	    return out.stdout if out.returncode == 0 else None
   579	
   580	
   581	# Reviewing lives in gauntlet.py (task #10). This module builds; that one judges.
   582	# It used to hold a single hard-wired Claude reviewer, which was enough to close the
   583	# loop and was never the design — one reviewer cannot show that a DIFFERENT MIND looked.
   584	
   585	
   586	# ---------------------------------------------------------------------------
   587	# The run loop — everything above, in order, for one job.
   588	# ---------------------------------------------------------------------------
   589	def run_job(job_id: int, *, cfg: dict[str, Any] | None = None) -> dict[str, Any]:
   590	    """Take one recorded job and actually do it. Safe to call in a thread.
   591	
   592	    Opens its own database connection (sqlite + threads). WAL mode lets this write
   593	    while the web server reads. Never raises to the caller — a worker that dies must
   594	    leave a legible 'failed' row, not a stack trace nobody sees.
   595	    """
   596	    conn = connect(DB_PATH)
   597	    try:
   598	        job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   599	        if job is None:
   600	            return {"job_id": job_id, "status": "missing"}
   601	        seat_row = seat(conn, job["builder_seat"])
   602	        if seat_row is None:
   603	            set_status(conn, job_id, "failed", error=f"unknown seat {job['builder_seat']}")
   604	            return {"job_id": job_id, "status": "failed"}
   605	
   606	        provider = seat_row["provider"]
   607	        is_claude_builder = provider == "claude-cli"
   608	        builder = _BUILDERS.get(provider)
   609	        if builder is None and not is_claude_builder:
   610	            # A provider we don't have a local runner for (codex/xai builds go
   611	            # through OpenClaw, not this in-process worker). Say so plainly.
   612	            set_status(conn, job_id, "failed",
   613	                       error=f"no in-process builder for provider '{provider}' "
   614	                             "— this seat dispatches through OpenClaw")
   615	            _event(conn, job_id, seat_row, "error",
   616	                   "This worker only runs the local model or the claude-cli builder directly.")
   617	            return {"job_id": job_id, "status": "failed"}
   618	
   619	        # The job's bundle_kind was frozen at dispatch from the seat's provider AT
   620	        # THAT TIME (dispatch.BUNDLE_KIND_BY_PROVIDER). Seats are re-upserted from
   621	        # config on every server start, so a seat's LIVE provider can drift after a
   622	        # job is queued (e.g. reconfigured between dispatch and this worker actually
   623	        # running). If the frozen stamp and the live provider now disagree about
   624	        # what shape this job's review should be, refuse rather than guess which
   625	        # one is right — running it either way would produce a bundle that doesn't
   626	        # match what the record says it should be.
   627	        expected_kind = "diff" if is_claude_builder else "text"
   628	        actual_kind = job["bundle_kind"] or "text"
   629	        if actual_kind != expected_kind:
   630	            set_status(conn, job_id, "failed",
   631	                       error="this job's review shape no longer matches its builder "
   632	                             "— refusing to run it")
   633	            _event(conn, job_id, seat_row, "error",
   634	                   "This job's setup changed since it was queued and can't safely continue.")
   635	            return {"job_id": job_id, "status": "failed"}
   636	
   637	        project_id = job["project_id"]
   638	        effective_project_id = project_id or "chief"
   639	        project_display = None
   640	        source_repo, source_branch = None, "main"
   641	        if project_id:
   642	            from db.projects import ProjectRepoUnavailable, project_name, resolve_repo
   643	            try:
   644	                source_repo, source_branch = resolve_repo(conn, project_id)
   645	            except ProjectRepoUnavailable as exc:
   646	                set_status(conn, job_id, "failed", error=str(exc))
   647	                _event(conn, job_id, seat_row, "error", str(exc))
   648	                return {"job_id": job_id, "status": "failed"}
   649	            project_display = project_name(conn, project_id)
   650	        else:
   651	            from db.projects import project_name
   652	            project_display = project_name(conn, "chief")
   653	
   654	        branch = job["branch"] or f"job/{job_id}"
   655	
   656	        # 1. Isolate. Code builders get a standalone clone (no shared .git with
   657	        #    main); the local text builder keeps the lighter-weight worktree — it
   658	        #    never runs a shell and only ever writes one known file.
   659	        if is_claude_builder:
   660	            wt, wt_note = _make_clone(job_id, branch, source_repo, source_branch)
   661	            if wt is None:
   662	                set_status(conn, job_id, "failed",
   663	                           error=f"could not isolate the build: {wt_note}")
   664	                _event(conn, job_id, seat_row, "error",
   665	                       "Could not set up an isolated copy to build in.")
   666	                cleanup_clone(job_id)
   667	                return {"job_id": job_id, "status": "failed"}
   668	        else:
   669	            wt, wt_note = _make_worktree(job_id, branch, source_repo, source_branch)
   670	        conn.execute("UPDATE jobs SET worktree = ? WHERE id = ?", (str(wt), job_id))
   671	        _event(conn, job_id, seat_row, "dispatched",
   672	               f"Working in {project_display}'s code, in its own copy ({wt_note}).")
   673	
   674	        from db.projects import memory_index
   675	        lane_text = _lane_memory_text(effective_project_id, seat_row["id"])
   676	        # The repo this project's own CLAUDE.md/AGENTS.md lives in — the resolved
   677	        # project repo for an explicit-project job, this harness's own repo for a
   678	        # legacy one (source_repo is None there, same as everywhere else it's used).
   679	        conventions_repo = source_repo if source_repo is not None else HARNESS.parent
   680	        repo_conventions = _repo_conventions_text(conventions_repo)
   681	        try:
   682	            memory_text = memory_index(conn, effective_project_id)
   683	        except Exception:
   684	            memory_text = None
   685	        built_prompt = _compose_builder_prompt(
   686	            job["request"], lane_text, memory_text, repo_conventions)
   687	
   688	        # 2. Build.
   689	        model = job["tier"] and _model_for(seat_row, job["tier"]) or seat_row["model"]
   690	        _event(conn, job_id, seat_row, "thinking", "Working out how to do it.")
   691	
   692	        if is_claude_builder:
   693	            try:
   694	                _claude_cli_build(seat_row, built_prompt, model, wt)
   695	            except Exception as exc:  # noqa: BLE001 — model, timeout, lockdown check
   696	                set_status(conn, job_id, "failed", error=f"builder error: {exc}")
   697	                _event(conn, job_id, seat_row, "error", "The worker hit a problem.")
   698	                cleanup_clone(job_id)
   699	                return {"job_id": job_id, "status": "failed"}
   700	
   701	            # 3. Commit what changed, refusing anything that isn't plain text —
   702	            #    and bind the FULL 40-char sha, never a truncated prefix (the
   703	            #    gatekeeper's own version check requires the full length once one
   704	            #    is stored — see gatekeeper._same_commit).
   705	            commit = _commit_diff_in_clone(wt, job_id, branch, job["request"])
   706	            if commit.sha is None:
   707	                set_status(conn, job_id, "failed", error=commit.reason)
   708	                _event(conn, job_id, seat_row, "error", commit.reason)
   709	                cleanup_clone(job_id)
   710	                return {"job_id": job_id, "status": "failed"}
   711	            version = commit.sha
   712	            base = _merge_base_with_main(wt, source_branch)
   713	            bundle = _diff_against_main(wt, base, version) if base else None
   714	            if not base or bundle is None:
   715	                set_status(conn, job_id, "failed",
   716	                           error="could not compute the change against the main line")
   717	                _event(conn, job_id, seat_row, "error",
   718	                       "Could not compare the work against the main line of code.")
   719	                cleanup_clone(job_id)
   720	                return {"job_id": job_id, "status": "failed"}
   721	            set_head_version(conn, job_id, version)
   722	            result = bundle
   723	            _event(conn, job_id, seat_row, "write",
   724	                   f"Wrote a change of {len(result)} characters.", target=str(wt))
   725	        else:
   726	            try:
   727	                result = builder(seat_row, built_prompt, model)
   728	            except Exception as exc:  # noqa: BLE001 — network, model, timeout
   729	                set_status(conn, job_id, "failed", error=f"builder error: {exc}")
   730	                _event(conn, job_id, seat_row, "error", "The worker hit a problem.")
   731	                return {"job_id": job_id, "status": "failed"}
   732	
   733	            out_dir = wt / OUTPUT_DIRNAME
   734	            out_dir.mkdir(parents=True, exist_ok=True)
   735	            (out_dir / f"job_{job_id}.txt").write_text(result)
   736	            version = _commit_in_worktree(wt, job_id, branch, job["request"]) or _version_of(result)
   737	            set_head_version(conn, job_id, version)
   738	            _event(conn, job_id, seat_row, "write",
   739	                   f"Wrote {len(result)} characters of work.", target=str(out_dir))
   740	
   741	        # 4. Park for review. The guards will hold it here until a real reviewer
   742	        #    passes THIS version — we never force it past them.
   743	        set_status(conn, job_id, "review", result=result)
   744	
   745	        # 5. Hand the frozen bundle to the review panel — unchanged shape. The one
   746	        #    new condition: never run the harness's own test suite on builder-
   747	        #    written code (task #9's GO version stops at a reviewed candidate).
   748	        if cfg is not None:
   749	            import gauntlet
   750	            reviewer_request = (
   751	                f"{job['request']}\n\nThis work is for the project '{project_display}'."
   752	            )
   753	            panel = gauntlet.run_panel(conn, job_id, reviewer_request, result, version,
   754	                                       cfg, db_path=DB_PATH)
   755	            if panel.certified and not is_claude_builder:
   756	                import tester
   757	                try:
   758	                    tester.record_smoke_check(conn, job_id)
   759	                except Exception:  # noqa: BLE001 — purely diagnostic; never worth
   760	                    pass            # losing the worker thread over
   761	
   762	        final = conn.execute("SELECT status FROM jobs WHERE id = ?", (job_id,)).fetchone()["status"]
   763	        return {"job_id": job_id, "status": final, "version": version}
   764	    finally:
   765	        conn.close()
   766	
   767	
   768	def _model_for(seat_row, tier: str) -> str:
   769	    try:
   770	        from tiering import resolve_model
   771	        return resolve_model(seat_row, tier)[0]
   772	    except Exception:
   773	        return seat_row["model"]
   774	
   775	
   776	# ---------------------------------------------------------------------------
   777	# Fire-and-forget: start a worker in the background so the app stays responsive.
   778	# ---------------------------------------------------------------------------
   779	def start_in_background(job_id: int, *, cfg: dict[str, Any] | None = None) -> threading.Thread:
   780	    t = threading.Thread(
   781	        target=run_job, args=(job_id,), kwargs={"cfg": cfg},
   782	        name=f"job-{job_id}", daemon=True,
   783	    )
   784	    t.start()
   785	    return t

