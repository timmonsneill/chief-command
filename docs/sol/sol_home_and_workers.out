   169	
   170	def _refuse(conn, job_id: int | None, why: str = "", *, verb: str = "",
   171	            subject: str = "", asked_by: str = "unknown") -> Refused:
   172	    # A job id the record doesn't know must not reach gate_log: its foreign key would
   173	    # throw, and the refusal — the one thing rule 3 says must never vanish — would.
   174	    job_id = _known_job(conn, job_id)
   175	    _note(conn, job_id, f"The gatekeeper said no: {why}")
   176	    if verb:
   177	        _log(conn, verb, subject or str(job_id), False, why, asked_by, job_id)
   178	    return Refused(why)
