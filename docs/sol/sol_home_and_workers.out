   295	@app.get("/api/willthink")
   296	async def will_think(q: str = ""):
   297	    """Will this need thinking? Asked BEFORE we start, so the UI knows whether to show a
   298	    holding line at all.
   299	
   300	    Sol, round 2, #17: "The browser always says 'Let me think about that' before it knows
   301	    whether thinking is needed, including for 'stop', 'cancel', greetings, and status
   302	    checks. This makes instant commands feel delayed and falsely implies that
   303	    cancellation is being processed."
   304	
   305	    Dead right, and it's a nasty little bug — telling a man you're pondering his "stop"
   306	    is exactly the wrong impression to give.
   307	    """
   308	    from mouth import needs_the_brain, cover_the_gap
   309	    if needs_the_brain(q or ""):
   310	        return {"thinking": True, "holding": cover_the_gap()}
   311	    return {"thinking": False}
   312	
   313	
   314	@app.post("/api/say")
   315	async def say(request: Request):
   316	    """The text channel. Type at Chief; Chief decides what to do about it.
   317	
   318	    This is the SAME brain the voice will use — mouth.py. Text and voice are two
   319	    doors into one room, which is the whole point of building text first.
   320	    """
   321	    body = await request.json()
   322	    utterance = (body.get("text") or "").strip()
   323	    if not utterance:
   324	        return JSONResponse({"reply": "Say something."})
   325	
   326	    from mouth import needs_the_brain, is_pushback, cover_the_gap, dig_in, think, THINK_FAST, THINK_HARD
   327	
   328	    last = body.get("last_answer") or ""
   329	
   330	    if is_pushback(utterance) and last:
   331	        answer, secs = think(
   332	            body.get("last_question", utterance),
   333	            context=f"You already answered this and he pushed back. Your last answer was: {last}",
   334	            tier=THINK_HARD,
   335	        )
   336	        return {"reply": answer, "holding": dig_in(), "seconds": round(secs, 1), "tier": "deep"}
   337	
   338	    if needs_the_brain(utterance):
   339	        answer, secs = think(utterance, context=_project_context(), tier=THINK_FAST)
   340	        return {"reply": answer, "holding": cover_the_gap(), "seconds": round(secs, 1), "tier": "think"}
   341	
   342	    return {"reply": _handle_directly(utterance), "tier": "instant", "seconds": 0}
   343	
   344	
   345	def _project_context() -> str:
   346	    """What Chief needs to know before answering: the REAL project list first (so it
   347	    stops improvising what Neill is working on), then loose facts we've gathered."""
   348	    from db.projects import projects_context
   349	
   350	    c = db()
   351	    parts = []
   352	    real = projects_context(c)
   353	    if real:
   354	        parts.append(real)
   355	    rows = c.execute("SELECT fact FROM project_memory ORDER BY id DESC LIMIT 12").fetchall()
   356	    facts = " ".join(r["fact"] for r in rows)
   357	    if facts:
   358	        parts.append(f"What we know about this project: {facts}")
   359	    return "\n\n".join(parts)
   360	
   361	
   362	def _handle_directly(u: str) -> str:
   363	    """The six things the mouth may answer alone. Everything else already went upstairs."""
   364	    c = db()
   365	    low = u.lower()
   366	
   367	    if any(w in low for w in ("overnight", "last night", "what ran", "what shipped", "what happened")):
   368	        rows = c.execute(
   369	            "SELECT status, COUNT(*) n FROM jobs WHERE created_at >= datetime('now','-1 day') "
   370	            "GROUP BY status"
   371	        ).fetchall()
   372	        if not rows:
   373	            return "Nothing ran overnight."
   374	        counts = {r["status"]: r["n"] for r in rows}
   375	        bits = []
   376	        if counts.get("shipped"): bits.append(f"{counts['shipped']} finished")
   377	        if counts.get("review"):  bits.append(f"{counts['review']} waiting on the others")
   378	        if counts.get("failed"):  bits.append(f"{counts['failed']} broke")
   379	        return (", ".join(bits) + ".") if bits else "Nothing finished overnight."
   380	
   381	    if any(w in low for w in ("status", "going", "doing", "update")):
   382	        row = c.execute(
   383	            "SELECT j.task_name, j.status, j.builder_seat FROM jobs j "
   384	            "WHERE j.status IN ('in_progress','review') ORDER BY j.id DESC LIMIT 1"
   385	        ).fetchone()
   386	        if not row:
   387	            return "Nothing's running right now."
   388	        who = row["builder_seat"].title()
   389	        thing = row["task_name"] or "it"
   390	        return (f"{who} is on {thing}." if row["status"] == "in_progress"
   391	                else f"{who} finished {thing}. The others are checking it.")
   392	
   393	    return "Got it."
   394	
   395	
   396	# ═══════════════════════════════════════════════════════════════════════════════
   397	# DISPATCH — where "putting someone on it" stops being a figure of speech.
   398	#
   399	# This starts a REAL worker. Today it runs the free local coder, so the whole loop
   400	# can be exercised with no money and no keys: you type a job, a real model builds it
   401	# in its own isolated copy of the code, and a stronger model checks it before it can
   402	# be called done. The paid coding seats will hang off this same path through OpenClaw.
   403	# ═══════════════════════════════════════════════════════════════════════════════
   404	def _pick_local_builder(c) -> str | None:
   405	    """The free local coder, whatever it's named in this database."""
   406	    row = c.execute(
   407	        "SELECT id FROM seats WHERE provider = 'ollama' AND enabled = 1 ORDER BY id LIMIT 1"
   408	    ).fetchone()
   409	    return row["id"] if row else None
   410	
   411	
   412	# Who reviews is NOT the server's decision any more (task #10). It used to hand-pick a
   413	# single Claude seat here, which quietly made "one reviewer" the real policy no matter
   414	# what the gauntlet config said. The panel now comes from the config, and the family
   415	# floor decides whether it's enough.
   416	
   417	
   418	@app.post("/api/dispatch")
   419	async def dispatch_endpoint(request: Request):
   420	    """Give the team a real job. Non-blocking: returns as soon as it's recorded and
   421	    the worker has started, so the page stays live while the work grinds.
   422	
   423	    `builder` is OPTIONAL and defaults to the local coder — the button in the UI
   424	    that reaches the real code builder was missing entirely (rule 9: a feature with
   425	    no reachable control is not done), not just this validation. See web/index.html's
   426	    #giveBuilder picker.
   427	    """
   428	    import dispatch as dispatch_mod
   429	
   430	    body = await request.json()
   431	    text = (body.get("text") or "").strip()
   432	    if not text:
   433	        return JSONResponse({"error": "Say what to build."}, status_code=400)
   434	    # The client stamps a nonce so a double-tap or a re-send can't start it twice.
   435	    nonce = (body.get("nonce") or "").strip() or None
   436	    requested_builder = (body.get("builder") or "").strip()
   437	    requested_project = (body.get("project") or "").strip() or "chief"
   438	
   439	    c = db()
   440	    proj_row = c.execute(
   441	        "SELECT name, repo_path FROM projects WHERE id = ? AND archived = 0",
   442	        (requested_project,),
   443	    ).fetchone()
   444	    if proj_row is None:
   445	        return JSONResponse({"error": "That project doesn't exist."}, status_code=400)
   446	    # Refused HERE, at the door, never after a job sits around and fails at build
   447	    # time — the picker itself already hides these (web/index.html), this is the
   448	    # backstop for a direct API call. Only the "no repo at all" case (Arch, Decision
   449	    # C) is checked this early: it's a plain column read, not a filesystem/git
   450	    # probe, so it's cheap and safe to do before a job even exists. The deeper
   451	    # checks (does the folder exist, is it really git, which branch) still happen
   452	    # at build time in executor.run_job — they need to touch disk/git, which isn't
   453	    # something to redo speculatively on every dispatch call.
   454	    if not proj_row["repo_path"]:
   455	        return JSONResponse(
   456	            {"error": "That project is kept at arm's length — the team can read "
   457	                      "its notes but not touch its code."},
   458	            status_code=400,
   459	        )
   460	    if requested_builder:
   461	        row = c.execute(
   462	            "SELECT id, provider, enabled FROM seats WHERE id = ?", (requested_builder,)
   463	        ).fetchone()
   464	        if row is None:
   465	            return JSONResponse({"error": "That builder doesn't exist."}, status_code=400)
   466	        if not row["enabled"]:
   467	            return JSONResponse(
   468	                {"error": f"{requested_builder.title()} is turned off right now."},
   469	                status_code=400,
   470	            )
   471	        if row["provider"] not in ("claude-cli", "ollama"):
   472	            return JSONResponse(
   473	                {"error": "That builder can't take a direct job yet — pick the "
   474	                          "local coder or Riggs."},
   475	                status_code=400,
   476	            )
   477	        builder = requested_builder
   478	    else:
   479	        builder = _pick_local_builder(c)
   480	        if not builder:
   481	            return JSONResponse(
   482	                {"error": "The free local coder isn't available on this machine right now."},
   483	                status_code=503,
   484	            )
   485	    try:
   486	        d = dispatch_mod.dispatch_local(
   487	            c, text, builder, origin="text", dispatch_key=nonce,
   488	            project_id=requested_project,
   489	        )
   490	    except dispatch_mod.DispatchRefused as exc:
   491	        return JSONResponse({"error": str(exc)}, status_code=409)
   492	
   493	    who = builder.title()
   494	    project_note = (f" — working in {proj_row['name']}"
   495	                    if requested_project != "chief" else "")
   496	    if d.reused:
   497	        reply = f"Already on it — {who} picked that up a moment ago."
   498	    else:
   499	        reply = (f"{who} is on it{project_note}. A panel of different models will "
   500	                 "check the work before it's called done.")
   501	    return {"job_id": d.job_id, "reused": d.reused, "reply": reply, "builder": builder}
   502	
   503	
   504	# ═══════════════════════════════════════════════════════════════════════════════
   505	# TODOS — the checklist that lives in the command center, grouped by project and by
   506	# the owner's own sections ("Now", "Later", "Post-launch"). No more jumping windows.
   507	# ═══════════════════════════════════════════════════════════════════════════════
   508	@app.post("/api/projects/{project_id}/todos")
   509	async def add_todo_endpoint(project_id: str, request: Request):
   510	    from db.planning import add_todo
   511	    body = await request.json()
   512	    text = (body.get("text") or "").strip()
   513	    if not text:
   514	        return JSONResponse({"error": "Say what the todo is."}, status_code=400)
   515	    c = db()
   516	    if c.execute("SELECT 1 FROM projects WHERE id=?", (project_id,)).fetchone() is None:
   517	        return JSONResponse({"error": "No such project."}, status_code=404)
   518	    tid = add_todo(c, project_id, text,
   519	                   section=body.get("section"), owner_only=bool(body.get("owner_only")))
   520	    return {"id": tid}
   521	
