     1	"""Durable job store for the Chief Command v2 harness.
     2	
     3	OpenClaw dispatches the work; this records it. Its subagent sessions auto-archive
     4	after ~60 minutes, so anything we want to answer later ("what did the overnight run
     5	do?", spec §7) has to live here.
     6	
     7	The two rules that must never quietly stop holding are enforced in schema.sql as
     8	triggers, not here — see guard_local_output_needs_review and
     9	guard_unresolved_escalation. This module will simply raise if you try to violate them.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import sqlite3
    15	from dataclasses import dataclass
    16	from pathlib import Path
    17	from typing import Any, Iterable, Optional
    18	
    19	DB_PATH = Path(__file__).resolve().parent / "chief.db"
    20	SCHEMA_PATH = Path(__file__).resolve().parent / "schema.sql"
    21	
    22	# Raised by the schema triggers. We surface it as something catchable.
    23	class GuardViolation(RuntimeError):
    24	    """A structural rule was violated (e.g. shipping unreviewed local output)."""
    25	
    26	
    27	@dataclass(frozen=True)
    28	class Seat:
    29	    id: str
    30	    provider: str
    31	    model: str
    32	    family: str  # gpt | claude | grok | qwen — what determines shared blind spots
    33	    tier: str  # local | subscription | metered
    34	    daily_cap_cents: Optional[int] = None   # hard ceiling across everything
    35	    build_cap_cents: Optional[int] = None   # ration the EXPENSIVE work
    36	    review_cap_cents: Optional[int] = None  # reviewing is cheap — be generous
    37	    # Three models per seat. NOTHING gets `heavy` by default — it has to be earned.
    38	    # Rate limits, not money, are the binding constraint on autonomous work, and you
    39	    # cannot buy your way out of a weekly cap.
    40	    model_light: Optional[str] = None
    41	    model_standard: Optional[str] = None
    42	    model_heavy: Optional[str] = None
    43	    enabled: bool = True
    44	    notes: str = ""
    45	
    46	
    47	def connect(db_path: Path | str = DB_PATH) -> sqlite3.Connection:
    48	    # timeout is stated rather than inherited from the stdlib default: the review panel
    49	    # writes verdicts from several threads at once, and how long a writer waits for the
    50	    # lock before giving up is a real property of this system, not a detail to leave to
    51	    # whatever the standard library happens to pick.
    52	    conn = sqlite3.connect(db_path, isolation_level=None,  # autocommit; we manage txns
    53	                           timeout=15.0)
    54	    conn.row_factory = sqlite3.Row
    55	    conn.execute("PRAGMA foreign_keys = ON")
    56	    conn.execute("PRAGMA busy_timeout = 15000")
    57	    return conn
    58	
    59	
    60	def init_db(conn: sqlite3.Connection) -> None:
    61	    """Build the schema on a FRESH database only.
    62	
    63	    This used to run schema.sql on EVERY call — including server startup against the LIVE
    64	    DB. That made editing schema.sql a silent live deploy: a new `CREATE TRIGGER IF NOT
    65	    EXISTS` installs on the next restart while `CREATE TABLE IF NOT EXISTS` stays a no-op,
    66	    so a trigger can land WITHOUT the column it references and jam every status change (it
    67	    did, 2026-07-20). An existing DB now advances ONLY through the numbered migrations in
    68	    db/migrations/, applied deliberately — never as a side effect of a restart.
    69	    """
    70	    initialized = conn.execute(
    71	        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'jobs'"
    72	    ).fetchone()
    73	    if initialized:
    74	        return
    75	    conn.executescript(SCHEMA_PATH.read_text())
    76	
    77	
    78	def _guarded(fn):
    79	    """Translate the schema's RAISE(ABORT, 'guard: ...') into GuardViolation."""
    80	
    81	    def wrapper(*args, **kwargs):
    82	        try:
    83	            return fn(*args, **kwargs)
    84	        except sqlite3.IntegrityError as exc:
    85	            if "guard:" in str(exc):
    86	                raise GuardViolation(str(exc)) from exc
    87	            raise
    88	
    89	    return wrapper
    90	
    91	
    92	# --------------------------------------------------------------------------
    93	# Seats
    94	# --------------------------------------------------------------------------
    95	def upsert_seat(conn: sqlite3.Connection, seat: Seat) -> None:
    96	    conn.execute(
    97	        """
    98	        INSERT INTO seats (id, provider, model, family, tier, daily_cap_cents,
    99	                           build_cap_cents, review_cap_cents,
   100	                           model_light, model_standard, model_heavy, enabled, notes)
   101	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
   102	        ON CONFLICT(id) DO UPDATE SET
   103	            provider = excluded.provider,
   104	            model = excluded.model,
   105	            family = excluded.family,
   106	            tier = excluded.tier,
   107	            daily_cap_cents = excluded.daily_cap_cents,
   108	            build_cap_cents = excluded.build_cap_cents,
   109	            review_cap_cents = excluded.review_cap_cents,
   110	            model_light = excluded.model_light,
   111	            model_standard = excluded.model_standard,
   112	            model_heavy = excluded.model_heavy,
   113	            enabled = excluded.enabled,
   114	            notes = excluded.notes
   115	        """,
   116	        (seat.id, seat.provider, seat.model, seat.family, seat.tier,
   117	         seat.daily_cap_cents, seat.build_cap_cents, seat.review_cap_cents,
   118	         seat.model_light, seat.model_standard, seat.model_heavy,
   119	         int(seat.enabled), seat.notes),
   120	    )
   121	
   122	
   123	def seat(conn: sqlite3.Connection, seat_id: str) -> sqlite3.Row | None:
   124	    return conn.execute("SELECT * FROM seats WHERE id = ?", (seat_id,)).fetchone()
   125	
   126	
   127	# --------------------------------------------------------------------------
   128	# Jobs
   129	# --------------------------------------------------------------------------
   130	def create_job(
   131	    conn: sqlite3.Connection,
   132	    request: str,
   133	    builder_seat: str,
   134	    origin: str = "text",
   135	    parent_job_id: Optional[int] = None,
   136	    task_name: Optional[str] = None,
   137	    bundle_kind: str = "text",
   138	    project_id: Optional[str] = None,
   139	) -> int:
   140	    """task_name is the 2-4 word handle the voice will use ("the rate limiter").
   141	
   142	    The mouth coins it at dispatch. Without one the voice falls back to truncating
   143	    the request, which reads back the owner's own paragraph at him — exactly what a
   144	    colleague would never do.
   145	    """
   146	    row = seat(conn, builder_seat)
   147	    if row is None:
   148	        raise ValueError(f"unknown builder seat: {builder_seat}")
   149	
   150	    # Snapshot who built this, AT BUILD TIME. Sol's cross-family review found that
   151	    # reading the builder's tier live meant re-tiering a local seat retroactively
   152	    # legitimized its old unreviewed work. What a seat is today cannot change what
   153	    # it was. bundle_kind travels in this SAME birth write because the schema freezes
   154	    # it immediately too — a later UPDATE would correctly be rejected as rewritten
   155	    # history. The schema then freezes these columns.
   156	    cur = conn.execute(
   157	        """
   158	        INSERT INTO jobs (request, builder_seat, builder_tier, builder_family,
   159	                          bundle_kind, origin, parent_job_id, task_name, project_id)
   160	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
   161	        """,
   162	        (request, builder_seat, row["tier"], row["family"], bundle_kind,
   163	         origin, parent_job_id, task_name, project_id),
   164	    )
   165	    return int(cur.lastrowid)
   166	
   167	
   168	def claim_next_job(conn: sqlite3.Connection, builder_seat: str) -> sqlite3.Row | None:
   169	    """Atomically claim the oldest queued job for this seat.
   170	
   171	    Uses UPDATE...RETURNING against a subquery so two workers racing for the same
   172	    row cannot both win — SQLite serializes the write and only one claim lands.
   173	    Cribbed from clu's approach; it removes the need for any external lock.
   174	    """
   175	    row = conn.execute(
   176	        """
   177	        UPDATE jobs
   178	           SET status = 'in_progress',
   179	               started_at = datetime('now'),
   180	               attempts = attempts + 1
   181	         WHERE id = (
   182	             SELECT id FROM jobs
   183	              WHERE status = 'todo' AND builder_seat = ?
   184	              ORDER BY id
   185	              LIMIT 1
   186	         )
   187	        RETURNING *
   188	        """,
   189	        (builder_seat,),
   190	    ).fetchone()
   191	    return row
   192	
   193	
   194	def attach_run(
   195	    conn: sqlite3.Connection,
   196	    job_id: int,
   197	    run_id: str,
   198	    session_key: str | None = None,
   199	    branch: str | None = None,
   200	    worktree: str | None = None,
   201	) -> None:
   202	    """Record the OpenClaw spawn that is actually doing the work."""
   203	    conn.execute(
   204	        """
   205	        UPDATE jobs SET run_id = ?, session_key = ?, branch = ?, worktree = ?
   206	         WHERE id = ?
   207	        """,
   208	        (run_id, session_key, branch, worktree, job_id),
   209	    )
   210	
   211	
   212	@_guarded
   213	def set_head_version(conn: sqlite3.Connection, job_id: int, version: str) -> None:
   214	    """Record the exact version (git commit id) the builder is putting forward.
   215	
   216	    This is the pivot of the review-to-version chain: every completion guard only
   217	    counts verdicts whose reviewed_version matches this. Calling it again after the
   218	    builder iterates voids all earlier approvals by construction — nothing needs to
   219	    remember to revoke them. Frozen by the schema once the job is done.
   220	    """
   221	    if not version or not version.strip():
   222	        raise ValueError("a version must actually name a version")
   223	    conn.execute(
   224	        "UPDATE jobs SET head_version = ? WHERE id = ?", (version.strip(), job_id)
   225	    )
   226	
   227	
   228	@_guarded
   229	def set_status(
   230	    conn: sqlite3.Connection,
   231	    job_id: int,
   232	    status: str,
   233	    result: str | None = None,
   234	    error: str | None = None,
   235	    spoken_summary: str | None = None,
   236	) -> None:
   237	    """Move a job's status.
   238	
   239	    Moving to 'done' runs the schema guards. If the builder was a local seat and no
   240	    higher-tier reviewer has passed it, this raises GuardViolation — by design.
   241	    """
   242	    finished = status in ("done", "failed", "cancelled")
   243	    conn.execute(
   244	        """
   245	        UPDATE jobs
   246	           SET status = ?,
   247	               result = COALESCE(?, result),
   248	               error = COALESCE(?, error),
   249	               spoken_summary = COALESCE(?, spoken_summary),
   250	               finished_at = CASE WHEN ? THEN datetime('now') ELSE finished_at END
   251	         WHERE id = ?
   252	        """,
   253	        (status, result, error, spoken_summary, int(finished), job_id),
   254	    )
   255	
   256	
   257	def record_artifact(
   258	    conn: sqlite3.Connection,
   259	    job_id: int,
   260	    kind: str,
   261	    path: str | None = None,
   262	    value: str | None = None,
   263	    flow: str | None = None,
   264	    captured_by: str = "playwright",
   265	) -> int:
   266	    """Record GROUND TRUTH.
   267	
   268	    Two kinds, and they have different rules about who may write them:
   269	
   270	    EVIDENCE OF A BUILD (screenshot, trace, logs, exit codes) — only the harness or
   271	    Playwright. NEVER a model. A model cannot fabricate a screenshot, which is what
   272	    makes "I ran it and it worked" unsayable.
   273	
   274	    EVIDENCE OF A CLAIM (source, quote) — a model MAY write these, because a
   275	    researcher's whole job is to hand you a URL you can go and read yourself. The
   276	    check isn't "who wrote it down", it's "can someone else go and look?" — which is
   277	    why a different family has to read the sources cold (guard 8).
   278	    """
   279	    _MODEL_MAY_CITE = {"source", "quote"}
   280	    if captured_by == "model" and kind not in _MODEL_MAY_CITE:
   281	        raise ValueError(
   282	            f"a model may cite a source, but it may not produce a '{kind}' — "
   283	            "build evidence is captured by the harness, never claimed by a model"
   284	        )
   285	    if captured_by not in ("harness", "playwright", "model"):
   286	        raise ValueError(f"unknown artifact origin: {captured_by}")
   287	    cur = conn.execute(
   288	        """
   289	        INSERT INTO artifacts (job_id, kind, path, value, flow, captured_by)
   290	        VALUES (?, ?, ?, ?, ?, ?)
   291	        """,
   292	        (job_id, kind, path, value, flow, captured_by),
   293	    )
   294	    return int(cur.lastrowid)
   295	
   296	
   297	@_guarded
   298	def record_verdict(
   299	    conn: sqlite3.Connection,
   300	    job_id: int,
   301	    reviewer_seat: str,
   302	    verdict: str,
   303	    severity: str | None = None,
   304	    summary: str | None = None,
   305	    detail: str | None = None,
   306	    role: str = "reviewer",
   307	    reviewed_version: str | None = None,
   308	) -> int:
   309	    """Record one seat's verdict.
   310	
   311	    role='reviewer' reads the diff and judges it.
   312	    role='tester'   drove the app (Playwright) and judges what it observed. Two guards
   313	                    apply: it must cite captured artifacts, and its family must differ
   314	                    from the builder's — Playwright stops a tester fabricating what
   315	                    happened; only a different mind stops it rationalizing it.
   316	
   317	    reviewed_version is WHAT the reviewer looked at. The gauntlet runner pins the
   318	    version before handing work to a reviewer and must pass it explicitly. When
   319	    omitted, it defaults to the job's current head_version — correct only when
   320	    nothing moved between review and recording, which the runner must guarantee.
   321	    A verdict whose version stops matching the job simply stops counting.
   322	
   323	    tier and family are snapshotted from the seat at write time, so re-tiering or
   324	    re-pointing a seat later cannot retroactively legitimize a job.
   325	    """
   326	    row = seat(conn, reviewer_seat)
   327	    if row is None:
   328	        raise ValueError(f"unknown seat: {reviewer_seat}")
   329	
   330	    if reviewed_version is None:
   331	        job_row = conn.execute(
   332	            "SELECT head_version FROM jobs WHERE id = ?", (job_id,)
   333	        ).fetchone()
   334	        if job_row is not None:
   335	            reviewed_version = job_row["head_version"]
   336	
   337	    cur = conn.execute(
   338	        """
   339	        INSERT INTO verdicts
   340	            (job_id, reviewer_seat, reviewer_tier, role, model_family,
   341	             verdict, severity, summary, detail, reviewed_version)
   342	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
   343	        """,
   344	        (job_id, reviewer_seat, row["tier"], role, row["family"],
   345	         verdict, severity, summary, detail, reviewed_version),
   346	    )
   347	    return int(cur.lastrowid)
   348	
   349	
   350	def resolve_escalation(conn: sqlite3.Connection, verdict_id: int, verdict: str) -> None:
   351	    """Answer a needs_human verdict so the job can proceed (§6 human review queue)."""
   352	    if verdict not in ("pass", "fail"):
   353	        raise ValueError("an escalation resolves to 'pass' or 'fail'")
   354	    conn.execute("UPDATE verdicts SET verdict = ? WHERE id = ?", (verdict, verdict_id))
   355	
   356	
   357	# --------------------------------------------------------------------------
   358	# Reporting — this is what the voice layer reads back
   359	# --------------------------------------------------------------------------
   360	def overnight_report(conn: sqlite3.Connection, since: str = "-1 day") -> list[sqlite3.Row]:
   361	    """Answers spec §7's 'what did the overnight run do?'"""
   362	    return conn.execute(
   363	        """
   364	        SELECT * FROM job_report
   365	         WHERE created_at >= datetime('now', ?)
   366	         ORDER BY id
   367	        """,
   368	        (since,),
   369	    ).fetchall()
   370	
   371	
   372	def spend_today(conn: sqlite3.Connection, seat_id: str) -> int:
   373	    row = conn.execute(
   374	        "SELECT COALESCE(SUM(cost_cents), 0) AS c FROM usage WHERE seat_id = ? AND day = date('now')",
   375	        (seat_id,),
   376	    ).fetchone()
   377	    return int(row["c"])
   378	
   379	
   380	def over_budget(conn: sqlite3.Connection, seat_id: str) -> bool:
   381	    """True if this seat has hit its daily cap.
   382	
   383	    OpenClaw has no per-agent budget of any kind, so the harness must check this
   384	    before dispatching. Uncapped seats (daily_cap_cents IS NULL) never block.
   385	    """
   386	    row = seat(conn, seat_id)
   387	    if row is None or row["daily_cap_cents"] is None:
   388	        return False
   389	    return spend_today(conn, seat_id) >= int(row["daily_cap_cents"])
   390	
   391	
   392	@_guarded
   393	def record_usage(
   394	    conn: sqlite3.Connection,
   395	    seat_id: str,
   396	    cost_cents: int,
   397	    job_id: int | None = None,
   398	    input_tokens: int = 0,
   399	    output_tokens: int = 0,
   400	    role: str = "build",
   401	) -> None:
   402	    """Record spend. The DATABASE refuses an entry that would breach the daily cap.
   403	
   404	    This used to be a Python check before dispatch — which Sol correctly called a
   405	    race (two dispatches both pass the check before either records spend) and easily
   406	    bypassed by any direct write. The ledger itself now says no.
   407	    """
   408	    conn.execute(
   409	        """
   410	        INSERT INTO usage (seat_id, job_id, role, input_tokens, output_tokens, cost_cents)
   411	        VALUES (?, ?, ?, ?, ?, ?)
   412	        """,
   413	        (seat_id, job_id, role, input_tokens, output_tokens, cost_cents),
   414	    )
   415	
   416	
   417	def can_build(conn: sqlite3.Connection, seat_id: str) -> bool:
   418	    """Has this seat used up its BUILDING budget? (It may still be able to review.)"""
   419	    row = seat(conn, seat_id)
   420	    if row is None or row["build_cap_cents"] is None:
   421	        return True
   422	    spent = conn.execute(
   423	        "SELECT COALESCE(SUM(cost_cents),0) c FROM usage "
   424	        "WHERE seat_id=? AND day=date('now') AND role='build'", (seat_id,)
   425	    ).fetchone()["c"]
   426	    return int(spent) < int(row["build_cap_cents"])
   427	
   428	
   429	# ---------------------------------------------------------------------------
   430	# The money
   431	# ---------------------------------------------------------------------------
   432	def month_spend(conn: sqlite3.Connection) -> dict[str, int]:
   433	    """What have we spent this month, and how close are we?"""
   434	    r = conn.execute("SELECT * FROM month_spend").fetchone()
   435	    spent, cap, warn = int(r["spent_cents"]), int(r["cap_cents"]), int(r["warn_cents"])
   436	    return {
   437	        "spent_cents": spent,
   438	        "cap_cents": cap,
   439	        "warn_cents": warn,
   440	        "remaining_cents": max(0, cap - spent),
   441	        "pct": round(100 * spent / cap, 1) if cap else 0.0,
   442	        "over_warn": spent >= warn,
   443	    }
   444	
   445	
   446	def set_budget(conn: sqlite3.Connection, monthly_cap_cents: int, warn_at_cents: int) -> None:
   447	    conn.execute(
   448	        "UPDATE budget SET monthly_cap_cents=?, warn_at_cents=?, updated_at=datetime('now') "
   449	        "WHERE id=1", (monthly_cap_cents, warn_at_cents)
   450	    )
   451	
   452	
   453	def budget_warning(conn: sqlite3.Connection) -> str | None:
   454	    """Should we tell Neill about the money right now?
   455	
   456	    Warns ONCE per month at the threshold, then goes quiet — a warning you see every
   457	    day is a warning you stop reading. Speaks up again only when the cap is actually
   458	    hit, because at that point work is stopping and he needs to know why.
   459	    """
   460	    m = month_spend(conn)
   461	    if m["spent_cents"] >= m["cap_cents"]:
   462	        return (f"You've hit the ${m['cap_cents']/100:.0f} monthly limit. "
   463	                f"I've stopped spending until you raise it or the month rolls over.")
   464	
   465	    if not m["over_warn"]:
   466	        return None
   467	
   468	    from datetime import datetime
   469	    this_month = datetime.now().strftime("%Y-%m")
   470	    row = conn.execute("SELECT warned_this_month FROM budget WHERE id=1").fetchone()
   471	    if row["warned_this_month"] == this_month:
   472	        return None   # already told him. Don't nag.
   473	
   474	    conn.execute("UPDATE budget SET warned_this_month=? WHERE id=1", (this_month,))
   475	    return (f"Heads up — you're at ${m['spent_cents']/100:.2f} of your "
   476	            f"${m['cap_cents']/100:.0f} monthly budget. About "
   477	            f"${m['remaining_cents']/100:.2f} left.")

