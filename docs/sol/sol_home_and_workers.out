    72	def _sync_seats_once(c) -> None:
    73	    """Push seats.toml into the store on the first request after a restart.
    74	
    75	    This was never wired up, so the seat definitions only reached the live database when
    76	    somebody ran it by hand — meaning an edit to the config (a new reviewer, a seat
    77	    switched off) could sit there looking applied and do nothing. It also runs the
    78	    startup validation: a gauntlet naming a seat that doesn't exist, or a seat with no
    79	    model family, is refused loudly here instead of failing later, mid-panel.
    80	    """
    81	    global _SEATS_SYNCED
    82	    if _SEATS_SYNCED:
    83	        return
    84	    _SEATS_SYNCED = True          # set first: a broken config must not retry every request
    85	    try:
    86	        import dispatch
    87	        dispatch.sync_seats(c, dispatch.load_config())
    88	    except Exception as exc:      # noqa: BLE001 — the app must still serve the record
    89	        print(f"[chief] seat config was not applied: {exc}")
    90	
    91	
    92	# ── The plain-English layer. He must never see a machine word. ───────────────
    93	#
    94	# Sol caught the UI leaking filenames and shell commands straight into the detail view.
    95	# This is the translation layer that stops it. The rule from AGENTS.md:
    96	#
    97	#     "If you cannot explain what you did without jargon, you do not yet understand
    98	#      what you did."
    99	
   100	_EVENT_ENGLISH = {
   101	    "dispatched": "Picked it up",
   102	    "read":       "Read through the existing code",
   103	    "thinking":   "Worked out how to do it",
   104	    "edit":       "Changed the code",
   105	    "write":      "Wrote new code",
   106	    "command":    "Ran something",
   107	    "test_run":   "Ran the tests",
   108	    "browse":     "Clicked through it like a user",
   109	    "verdict":    "Gave a verdict",
   110	    "done":       "Finished",
   111	    "error":      "Hit a problem",
   112	    # A reviewer that sat out MUST NOT read as one that worked. Without this line it
   113	    # fell through to the default "Worked on it" — the record was honest about the
   114	    # panel shrinking and the screen quietly contradicted it. (task #10)
   115	    "skipped":    "Sat this one out",
   116	}
   117	
   118	
   119	def _in_plain_english(e: dict) -> dict:
   120	    """Translate one line of machine activity into something a person can read.
   121	
   122	    NOTE the deliberate asymmetry: we keep the OUTCOME of a test run ("6 passed") but
   123	    drop the COMMAND that produced it ("pytest -q"). The outcome is a fact about the
   124	    work. The command is a fact about the tooling, and Neill doesn't use the tooling.
   125	    """
   126	    kind = e.get("kind", "")
   127	    what = _EVENT_ENGLISH.get(kind, "Worked on it")
   128	    out = {"what": what, "kind": kind}
   129	
   130	    detail = (e.get("detail") or "").strip()
   131	    # Keep a detail ONLY if it reads like a RESULT, not a machine artifact — and not if
   132	    # it's just restating the line it's attached to.
   133	    looks_technical = any(c in detail for c in ("/", "\\", ".py", ".ts", ".sql", "()", "--"))
   134	    is_redundant = detail.lower().strip(".") == what.lower().strip(".")
   135	    if detail and not looks_technical and not is_redundant:
   136	        out["note"] = detail
   137	    return out
   138	
   139	
   140	# ── Plain-English status. He should never see a machine word. ────────────────
   141	STATUS_WORDS = {
   142	    "todo":        ("Queued",      "waiting"),
   143	    "in_progress": ("Building",    "running"),
   144	    "review":      ("Being checked", "running"),
   145	    "done":        ("Checked, ready", "ok"),
   146	    "shipped":     ("Done",        "ok"),
   147	    "failed":      ("Broke",       "bad"),
   148	    "cancelled":   ("Stopped",     "waiting"),
   149	}
   150	
   151	
   152	@app.get("/api/state")
   153	def state():
   154	    """Everything the dashboard needs, in one call."""
   155	    c = db()
   156	
   157	    seats = [dict(r) for r in c.execute(
   158	        "SELECT id, model, family, tier, daily_cap_cents, build_cap_cents FROM seats WHERE enabled=1"
   159	    )]
   160	    for s in seats:
   161	        spent = c.execute(
   162	            "SELECT COALESCE(SUM(cost_cents),0) v FROM usage WHERE seat_id=? AND day=date('now')",
   163	            (s["id"],)
   164	        ).fetchone()["v"]
   165	        s["spent_today_cents"] = int(spent)
   166	        s["color"] = FAMILY_COLOR.get(s["family"], "#7E90A8")
   167	
   168	    jobs = []
   169	    for r in c.execute(
   170	        """SELECT j.*, s.model AS builder_model
   171	             FROM jobs j JOIN seats s ON s.id = j.builder_seat
   172	            ORDER BY j.id DESC LIMIT 40"""
   173	    ):
   174	        j = dict(r)
   175	        word, tone = STATUS_WORDS.get(j["status"], (j["status"], "waiting"))
   176	        j["status_word"] = word
   177	        j["tone"] = tone
   178	        j["color"] = FAMILY_COLOR.get(j["builder_family"], "#7E90A8")
   179	        j["verdicts"] = [dict(v) for v in c.execute(
   180	            "SELECT reviewer_seat, reviewer_tier, model_family, role, verdict, summary "
   181	            "FROM verdicts WHERE job_id=? ORDER BY id", (j["id"],)
   182	        )]
   183	        for v in j["verdicts"]:
   184	            v["color"] = FAMILY_COLOR.get(v["model_family"], "#7E90A8")
   185	        # ⚠️ Sol's review: "The web app explicitly leaks filenames, commands, model
   186	        # names, and jargon. The detailed work view displays raw event type, target,
   187	        # and detail. Those fields are DESIGNED to contain filenames, commands, web
   188	        # addresses, and machine output. The plain-English requirement is contradicted
   189	        # by the interface itself."
   190	        #
   191	        # He's right, and it broke the one promise that matters most. So the API now
   192	        # TRANSLATES events before they leave the server. The raw fields still exist in
   193	        # the database — they're what an engineer would need — but they never reach
   194	        # Neill's screen.
   195	        j["events"] = [_in_plain_english(dict(e)) for e in c.execute(
   196	            "SELECT kind, target, detail, lane, model FROM events WHERE job_id=? ORDER BY id",
   197	            (j["id"],)
   198	        )]
   199	        # Why is this stuck? In words he can act on.
   200	        j["blocked_because"] = _why_blocked(c, j)
   201	        jobs.append(j)
   202	
   203	    from db.planning import todos_for, attachments_for
   204	
   205	    projects = [dict(r) for r in c.execute("SELECT * FROM projects WHERE archived=0")]
   206	    for p in projects:
   207	        p["memory"] = [dict(m) for m in c.execute(
   208	            "SELECT kind, fact FROM project_memory WHERE project_id=? ORDER BY id DESC LIMIT 30",
   209	            (p["id"],)
   210	        )]
   211	        p["plan"] = [dict(x) for x in c.execute(
   212	            "SELECT * FROM plan_items WHERE project_id=? ORDER BY position, id", (p["id"],)
   213	        )]
   214	        p["todos"] = todos_for(c, p["id"])
   215	        p["todo_open"] = c.execute(
   216	            "SELECT COUNT(*) n FROM todos WHERE project_id=? AND done=0", (p["id"],)
   217	        ).fetchone()["n"]
   218	        p["attachments"] = attachments_for(c, p["id"])
   219	        p["job_count"] = c.execute(
   220	            "SELECT COUNT(*) n FROM jobs WHERE project_id=?", (p["id"],)
   221	        ).fetchone()["n"]
   222	
   223	    return {"seats": seats, "jobs": jobs, "projects": projects,
   224	            "usage_week": _usage_week()}
   225	
   226	
   227	# What the subscription seats have used this week, in words. Read from the tools' own
   228	# session logs on disk (harness/usage_local.py) — those can be gigabytes, so this is
   229	# computed at most once every few minutes, never on every dashboard poll.
   230	_USAGE_CACHE: dict = {"at": 0.0, "value": None}
   231	_USAGE_TTL_S = 300
   232	
   233	
   234	def _usage_week() -> dict:
   235	    import time
   236	    now = time.monotonic()
   237	    if _USAGE_CACHE["value"] is not None and now - _USAGE_CACHE["at"] < _USAGE_TTL_S:
   238	        return _USAGE_CACHE["value"]
   239	    try:
   240	        from usage_local import in_plain_english, local_usage
   241	        u = local_usage(days=7)
   242	        value = {
   243	            "summary": in_plain_english(u, 7).splitlines(),
   244	            "families": {
   245	                fam: {"sessions": x.sessions, "words_written": int(x.output_tokens * 0.75),
   246	                      "allowance_used_percent": x.allowance_used_percent}
   247	                for fam, x in u.items()
   248	            },
   249	        }
   250	    except Exception as exc:  # noqa: BLE001 — the dashboard must never die on this
   251	        value = {"summary": ["Couldn't read this week's usage right now."],
   252	                 "families": {}, "error": str(exc)[:120]}
   253	    _USAGE_CACHE.update(at=now, value=value)
   254	    return value
   255	
   256	
   257	def _why_blocked(c, j) -> str | None:
   258	    """The single most useful string on the screen: what is this waiting for?"""
   259	    if j["status"] in ("shipped", "failed", "cancelled"):
   260	        return None
   260	        return None
   261	
   262	    if any(v["verdict"] == "needs_human" for v in j["verdicts"]):
   263	        return "Someone needs to make a call on this — the reviewers disagreed."
   264	
   265	    if j["status"] == "done":
   266	        has_tester = any(v["role"] == "tester" and v["verdict"] == "pass" for v in j["verdicts"])
   267	        if not has_tester:
   268	            return "Nobody has actually opened it and used it yet."
   269	        return None
   270	
   271	    if j["status"] == "review":
   272	        if j["builder_tier"] == "local":
   273	            paid = any(v["reviewer_tier"] in ("subscription", "metered") and v["verdict"] == "pass"
   274	                       for v in j["verdicts"])
   275	            if not paid:
   276	                return "Coal wrote this. It can't go anywhere until a better model checks it."
   277	        if any(v["verdict"] == "fail" for v in j["verdicts"]):
   278	            return "A reviewer sent this back. It needs another go."
   279	        need = j["required_reviews"] or 0
   280	        got = len({v["reviewer_seat"] for v in j["verdicts"] if v["verdict"] == "pass"})
   281	        if need and got < need:
   282	            return f"Waiting on the others — {got} of {need} have looked at it."
   283	        # The seat count can be satisfied while the FAMILY floor isn't — three seats
   284	        # that are all the same underlying model is one mind in three hats. Say which
   285	        # wall it's actually behind, or the page reads "2 of 2 done" next to a job that
   286	        # is visibly not moving. (task #10)
   287	        need_fams = j["required_review_families"] or 0
   288	        fams = {v["model_family"] for v in j["verdicts"] if v["verdict"] == "pass"}
   289	        if need_fams and len(fams) < need_fams:
   290	            return (f"Only {len(fams)} of {need_fams} different models have checked it — "
   291	                    "it needs a second opinion from a different kind of model.")
   292	    return None
   293	
   294	
   295	@app.get("/api/willthink")
   296	async def will_think(q: str = ""):
   297	    """Will this need thinking? Asked BEFORE we start, so the UI knows whether to show a
   298	    holding line at all.
   299	
   300	    Sol, round 2, #17: "The browser always says 'Let me think about that' before it knows
   301	    whether thinking is needed, including for 'stop', 'cancel', greetings, and status
   302	    checks. This makes instant commands feel delayed and falsely implies that
   303	    cancellation is being processed."
   304	
   305	    Dead right, and it's a nasty little bug — telling a man you're pondering his "stop"
   306	    is exactly the wrong impression to give.
   307	    """
   308	    from mouth import needs_the_brain, cover_the_gap
   309	    if needs_the_brain(q or ""):
   310	        return {"thinking": True, "holding": cover_the_gap()}
   311	    return {"thinking": False}
   312	
   313	
   314	@app.post("/api/say")
   315	async def say(request: Request):
   316	    """The text channel. Type at Chief; Chief decides what to do about it.
   317	
   318	    This is the SAME brain the voice will use — mouth.py. Text and voice are two
   319	    doors into one room, which is the whole point of building text first.
   320	    """
   321	    body = await request.json()
   322	    utterance = (body.get("text") or "").strip()
   323	    if not utterance:
   324	        return JSONResponse({"reply": "Say something."})
   325	
   326	    from mouth import needs_the_brain, is_pushback, cover_the_gap, dig_in, think, THINK_FAST, THINK_HARD
   327	
   328	    last = body.get("last_answer") or ""
   329	
   330	    if is_pushback(utterance) and last:
   331	        answer, secs = think(
   332	            body.get("last_question", utterance),
   333	            context=f"You already answered this and he pushed back. Your last answer was: {last}",
   334	            tier=THINK_HARD,
   335	        )
   336	        return {"reply": answer, "holding": dig_in(), "seconds": round(secs, 1), "tier": "deep"}
   337	
   338	    if needs_the_brain(utterance):
   339	        answer, secs = think(utterance, context=_project_context(), tier=THINK_FAST)
   340	        return {"reply": answer, "holding": cover_the_gap(), "seconds": round(secs, 1), "tier": "think"}
   341	
   342	    return {"reply": _handle_directly(utterance), "tier": "instant", "seconds": 0}
   343	
   344	
   345	def _project_context() -> str:
   346	    """What Chief needs to know before answering: the REAL project list first (so it
   347	    stops improvising what Neill is working on), then loose facts we've gathered."""
   348	    from db.projects import projects_context
   349	
   350	    c = db()
   351	    parts = []
   352	    real = projects_context(c)
   353	    if real:
   354	        parts.append(real)
   355	    rows = c.execute("SELECT fact FROM project_memory ORDER BY id DESC LIMIT 12").fetchall()
   356	    facts = " ".join(r["fact"] for r in rows)
   357	    if facts:
   358	        parts.append(f"What we know about this project: {facts}")
   359	    return "\n\n".join(parts)
   360	
   361	
   362	def _handle_directly(u: str) -> str:
   363	    """The six things the mouth may answer alone. Everything else already went upstairs."""
   364	    c = db()
   365	    low = u.lower()
   366	
   367	    if any(w in low for w in ("overnight", "last night", "what ran", "what shipped", "what happened")):
   368	        rows = c.execute(
   369	            "SELECT status, COUNT(*) n FROM jobs WHERE created_at >= datetime('now','-1 day') "
   370	            "GROUP BY status"
   371	        ).fetchall()
   372	        if not rows:
   373	            return "Nothing ran overnight."
   374	        counts = {r["status"]: r["n"] for r in rows}
   375	        bits = []
   376	        if counts.get("shipped"): bits.append(f"{counts['shipped']} finished")
   377	        if counts.get("review"):  bits.append(f"{counts['review']} waiting on the others")
   378	        if counts.get("failed"):  bits.append(f"{counts['failed']} broke")
   379	        return (", ".join(bits) + ".") if bits else "Nothing finished overnight."
   380	
   381	    if any(w in low for w in ("status", "going", "doing", "update")):
   382	        row = c.execute(
   383	            "SELECT j.task_name, j.status, j.builder_seat FROM jobs j "
   384	            "WHERE j.status IN ('in_progress','review') ORDER BY j.id DESC LIMIT 1"
   385	        ).fetchone()
   386	        if not row:
   387	            return "Nothing's running right now."
   388	        who = row["builder_seat"].title()
   389	        thing = row["task_name"] or "it"
   390	        return (f"{who} is on {thing}." if row["status"] == "in_progress"
   391	                else f"{who} finished {thing}. The others are checking it.")
   392	
   393	    return "Got it."
   394	
   395	
   396	# ═══════════════════════════════════════════════════════════════════════════════
   397	# DISPATCH — where "putting someone on it" stops being a figure of speech.
   398	#
   399	# This starts a REAL worker. Today it runs the free local coder, so the whole loop
   400	# can be exercised with no money and no keys: you type a job, a real model builds it
   401	# in its own isolated copy of the code, and a stronger model checks it before it can
   402	# be called done. The paid coding seats will hang off this same path through OpenClaw.
   403	# ═══════════════════════════════════════════════════════════════════════════════
   404	def _pick_local_builder(c) -> str | None:
   405	    """The free local coder, whatever it's named in this database."""
   406	    row = c.execute(
   407	        "SELECT id FROM seats WHERE provider = 'ollama' AND enabled = 1 ORDER BY id LIMIT 1"
   408	    ).fetchone()
   409	    return row["id"] if row else None
   410	
   411	
   412	# Who reviews is NOT the server's decision any more (task #10). It used to hand-pick a
   413	# single Claude seat here, which quietly made "one reviewer" the real policy no matter
   414	# what the gauntlet config said. The panel now comes from the config, and the family
   415	# floor decides whether it's enough.
   416	
   417	
   418	@app.post("/api/dispatch")
   419	async def dispatch_endpoint(request: Request):
   420	    """Give the team a real job. Non-blocking: returns as soon as it's recorded and
   421	    the worker has started, so the page stays live while the work grinds.
   422	
   423	    `builder` is OPTIONAL and defaults to the local coder — the button in the UI
   424	    that reaches the real code builder was missing entirely (rule 9: a feature with
   425	    no reachable control is not done), not just this validation. See web/index.html's
   426	    #giveBuilder picker.
   427	    """
   428	    import dispatch as dispatch_mod
   429	
   430	    body = await request.json()
   431	    text = (body.get("text") or "").strip()
   432	    if not text:
   433	        return JSONResponse({"error": "Say what to build."}, status_code=400)
   434	    # The client stamps a nonce so a double-tap or a re-send can't start it twice.
   435	    nonce = (body.get("nonce") or "").strip() or None
   436	    requested_builder = (body.get("builder") or "").strip()
   437	    requested_project = (body.get("project") or "").strip() or "chief"
   438	
   439	    c = db()
   440	    proj_row = c.execute(
   441	        "SELECT name, repo_path FROM projects WHERE id = ? AND archived = 0",
   442	        (requested_project,),
   443	    ).fetchone()
   444	    if proj_row is None:
   445	        return JSONResponse({"error": "That project doesn't exist."}, status_code=400)
   446	    # Refused HERE, at the door, never after a job sits around and fails at build
   447	    # time — the picker itself already hides these (web/index.html), this is the
   448	    # backstop for a direct API call. Only the "no repo at all" case (Arch, Decision
   449	    # C) is checked this early: it's a plain column read, not a filesystem/git
   450	    # probe, so it's cheap and safe to do before a job even exists. The deeper
   451	    # checks (does the folder exist, is it really git, which branch) still happen
   452	    # at build time in executor.run_job — they need to touch disk/git, which isn't
   453	    # something to redo speculatively on every dispatch call.
   454	    if not proj_row["repo_path"]:
   455	        return JSONResponse(
   456	            {"error": "That project is kept at arm's length — the team can read "
   457	                      "its notes but not touch its code."},
   458	            status_code=400,
   459	        )
   460	    if requested_builder:
   461	        row = c.execute(
   462	            "SELECT id, provider, enabled FROM seats WHERE id = ?", (requested_builder,)
   463	        ).fetchone()
   464	        if row is None:
   465	            return JSONResponse({"error": "That builder doesn't exist."}, status_code=400)
   466	        if not row["enabled"]:
   467	            return JSONResponse(
   468	                {"error": f"{requested_builder.title()} is turned off right now."},
   469	                status_code=400,
   470	            )
   471	        if row["provider"] not in ("claude-cli", "ollama"):
   472	            return JSONResponse(
   473	                {"error": "That builder can't take a direct job yet — pick the "
   474	                          "local coder or Riggs."},
   475	                status_code=400,
   476	            )
   477	        builder = requested_builder
   478	    else:
   479	        builder = _pick_local_builder(c)
   480	        if not builder:
   481	            return JSONResponse(
   482	                {"error": "The free local coder isn't available on this machine right now."},
   483	                status_code=503,
   484	            )
   485	    try:
   486	        d = dispatch_mod.dispatch_local(
   487	            c, text, builder, origin="text", dispatch_key=nonce,
   488	            project_id=requested_project,
   489	        )
   490	    except dispatch_mod.DispatchRefused as exc:
   491	        return JSONResponse({"error": str(exc)}, status_code=409)
   492	
   493	    who = builder.title()
   494	    project_note = (f" — working in {proj_row['name']}"
   495	                    if requested_project != "chief" else "")
   496	    if d.reused:
   497	        reply = f"Already on it — {who} picked that up a moment ago."
   498	    else:
   499	        reply = (f"{who} is on it{project_note}. A panel of different models will "
   500	                 "check the work before it's called done.")
   501	    return {"job_id": d.job_id, "reused": d.reused, "reply": reply, "builder": builder}
   502	
