harness/db/projects.py-85-
harness/db/projects.py-86-    `name` is a bare filename from the index (e.g. 'feedback_names_mean_roles.md'). We
harness/db/projects.py:87:    resolve it INSIDE the memory folder and refuse anything that escapes it — a memory
harness/db/projects.py-88-    name is never allowed to reach out to ~/.ssh or a sibling project. Returns None if
harness/db/projects.py-89-    it isn't a real file safely inside the folder.
harness/db/projects.py-90-    """
harness/db/projects.py:91:    # Notes are markdown, and that's ALL we serve — a memory folder could sit next to
harness/db/projects.py-92-    # other files, and "read any file in there" is a wider door than intended. Enforcing
harness/db/projects.py-93-    # the suffix keeps the door the size of the feature.
harness/db/projects.py-94-    if not name.endswith(".md"):
harness/db/projects.py-95-        return None
harness/db/projects.py:96:    root = _memory_root(conn, project_id)
harness/db/projects.py-97-    if root is None:
harness/db/projects.py-98-        return None
harness/db/projects.py-99-    root = root.resolve()
harness/db/projects.py-100-    target = (root / name).resolve()
harness/db/projects.py:101:    # Containment check: the resolved target must live under the memory folder. Blocks
harness/db/projects.py-102-    # '../', absolute paths, and symlink escapes.
harness/db/projects.py-103-    if root != target and root not in target.parents:
harness/db/projects.py-104-        return None
harness/db/projects.py-105-    if not target.is_file():
