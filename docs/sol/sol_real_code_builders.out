   175	                {"verb": "merge", "job_id": job_id, "asked_by": "the panel"},
   176	                db_path=DB_PATH,
   177	            )
   178	        except Exception:  # noqa: BLE001 - asking must never crash the worker
   179	            answer = {"ok": False, "error": "something went wrong asking to merge this"}
   180	        if not answer.get("ok"):
   181	            # The gatekeeper already wrote its own refusal onto the event trail. Put
   182	            # the same plain-English reason where the voice reads current status.
   183	            set_status(
   184	                conn,
   185	                job_id,
   186	                "done",
   187	                spoken_summary=str(answer.get("error") or "the gatekeeper said no")[:200],
   188	            )
   189	    elif outcome.get("ran"):
   190	        set_status(
   191	            conn,
   192	            job_id,
   193	            "done",
   194	            spoken_summary=("Checked and certified, but the automated tests didn't "
   195	                            "confirm it runs: "
   196	                            f"{str(outcome.get('reason') or '')[:160]}"),
   197	        )
