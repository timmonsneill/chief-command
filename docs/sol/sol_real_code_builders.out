   170	# ---------------------------------------------------------------------------
   171	# MERGE — code enters main
   172	# ---------------------------------------------------------------------------
   173	def merge(conn, job_id: int, *, asked_by: str = "unknown") -> Receipt:
   174	    """Merge a job's branch into main, if and only if the record earns it.
   175	
   176	    Every check below re-reads the database. None of them takes the asker's word for
   177	    anything — that is the entire difference between this and `dispatch.ship()`, which
   178	    did the thing because it was called.
   179	    """
   180	    def _no(why: str) -> Refused:
   181	        """One way out of this function, so no refusal can forget to write itself down."""
   182	        return _refuse(conn, job_id if _job_exists(conn, job_id) else None, why,
   183	                       verb="merge", subject=f"job {job_id}", asked_by=asked_by)
   184	
   185	    job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   186	    if job is None:
   187	        raise _no(f"there is no job {job_id}")
   188	
   189	    if job["status"] == "shipped":
   190	        raise _no("that work has already been merged once")
   191	    if job["status"] != "done":
   192	        raise _no("that work hasn't finished its checks yet, so there's nothing to merge")
   193	
   194	    version = job["head_version"]
   195	    if not version:
   196	        raise _no("nothing was actually put forward — there's no finished version to merge")
   197	
   198	    verdicts = conn.execute(
   199	        "SELECT reviewer_seat, model_family, verdict, role, reviewed_version "
   200	        "FROM verdicts WHERE job_id = ?", (job_id,)
   201	    ).fetchall()
   202	    current = [v for v in verdicts if v["reviewed_version"] == version]
   203	
   204	    # A failure on this version is fatal and is NOT outvoted. A failure on an unknown
   205	    # version is also fatal: it condemns we-don't-know-what, so it condemns everything.
   206	    for v in verdicts:
   207	        if v["verdict"] == "fail" and (
   208	                v["reviewed_version"] is None or v["reviewed_version"] == version):
   209	            raise _no("a reviewer turned this down and that stands")
   210	    if any(v["verdict"] == "needs_human" for v in verdicts):
   211	        raise _no("a reviewer asked for you to look at this first")
   212	
   213	    passed = [v for v in current if v["verdict"] == "pass" and v["role"] == "reviewer"]
   214	    seats = {v["reviewer_seat"] for v in passed}
   215	    # The author is not a second opinion (migration 007): a same-family pass is a
   216	    # legitimate review, it just does not count toward "different minds". The schema
   217	    # already refuses first; this keeps the gate honest even if it ever stops.
   218	    families = {v["model_family"] for v in passed
   219	                if v["model_family"] != job["builder_family"]}
   220	
   221	    # A job carrying NO requirements is not a job everyone approved — it is a job whose
   222	    # requirements were never stamped. `0 < 0` is False, so treating zero as "nothing
   223	    # required" would let a row created outside dispatch merge with no reviews at all.
   224	    # Same arithmetic as the schema (migration 007): unstamped is not unrequired — a
   225	    # missing number means ONE, never zero. Refusing zero outright rejected jobs the
   226	    # record had accepted honestly.
   227	    need_seats = max(job["required_reviews"] or 0, 1)
   228	    need_families = max(job["required_review_families"] or 0, 1)
   229	    if len(seats) < need_seats:
   230	        raise _no(f"only {len(seats)} of the {need_seats} reviewers "
   231	                      "have signed off on this version")
   232	    if len(families) < need_families:
   233	        raise _no(f"only {len(families)} different kinds of model have checked this; "
   234	                      f"{need_families} are required")
   235	
   236	    branch = job["branch"] or ""
   237	    if not BRANCH_RE.match(branch):
   238	        raise _no("there's no finished branch of code to merge for that job")
   239	
   240	    tip = _branch_tip(branch)
   241	    if tip is None:
   242	        raise _no("there's no finished branch of code to merge for that job")
   243	
   244	    # ══════════════════════════════════════════════════════════════════════════
   245	    # THE CHECK THIS WHOLE VERB EXISTS FOR.
   246	    #
   247	    # Everything above verifies the RECORD. This verifies that the code about to enter
   248	    # main IS the code the record is about. Without it, a builder commits v1, the panel
   249	    # reviews v1, `head_version` freezes at v1 — and then the builder pushes v2 to the
   250	    # same branch and asks for a merge. Every check passes, and v2 goes in. The version
   251	    # freeze that protects the record would be helping the attacker.
   252	    #
   253	    # Reviews are of bytes, not of intentions. Merge the bytes that were reviewed.
   254	    # ══════════════════════════════════════════════════════════════════════════
   255	    if not _same_commit(tip, version):
   256	        raise _no("the code on that branch isn't the code that was reviewed — "
   257	                      "it has changed since, so it needs checking again")
   258	
   259	    # And the commit must CONTAIN what the reviewers read. The panel judges the text the
   260	    # worker handed in (`jobs.result`); the version check above only proves the branch
   261	    # is the commit the record names. A worker could commit one thing and hand the
   262	    # reviewers another. So: the reviewed bytes must be in the commit, byte for byte.
   263	    if not _commit_holds_the_reviewed_work(tip, job_id, job["result"]):
   264	        raise _no("what's on that branch isn't what the reviewers read, "
   265	                      "so it can't be merged as reviewed")
   266	    # ...and NOTHING ELSE. A commit with the reviewed file plus one more file is a
   267	    # reviewed file and an unreviewed one. The panel read one thing; one thing merges.
   268	    extra = _unreviewed_files_in(tip, job_id)
   269	    if extra:
   270	        raise _no("that branch changes things the reviewers never saw "
   271	                      f"({_clean(', '.join(extra), 160)}), so it can't be merged as reviewed")
   272	
   273	    if not _repo_is_ready():
   274	        raise _no("the project folder has unfinished changes in it, so it isn't "
   275	                      "safe to merge right now")
   276	
   277	    # ══════════════════════════════════════════════════════════════════════════
   278	    # ORDER IS THE POINT: the RECORD decides first, the irreversible act happens
   279	    # second. Merging and then asking produced "the code merged but the record wouldn't
   280	    # accept it" — an unreviewed merge with a polite note. The gatekeeper's own checks
   281	    # are a SUBSET of the schema's (it never checks for a passing tester), so the only
   282	    # safe order is to let the schema refuse before git is touched at all.
   283	    # ══════════════════════════════════════════════════════════════════════════
   284	    with _MERGE_LOCK:
   285	        # Re-resolve under the lock and merge the SHA, never the name. Between the check
   286	        # above and `git merge refs/heads/<branch>`, a builder could move the branch;
   287	        # merging by name would then merge whatever it points at now.
   288	        tip = _branch_tip(branch)
   289	        if tip is None or not _same_commit(tip, version):
   290	            raise _no("the code on that branch changed while the merge was being "
   291	                      "checked, so it needs checking again")
   292	        # The TARGET is re-checked under the lock too: between the check above and
   293	        # here, another process could have checked out a different branch.
   294	        if not _repo_is_ready():
   295	            raise _no("the project folder changed while the merge was being checked, "
   296	                      "so it isn't safe to merge right now")
   297	        before = _main_tip()
   298	        conn.execute("BEGIN IMMEDIATE")
   299	        try:
   300	            try:
   301	                set_status(conn, job_id, "shipped")
   302	            except (GuardViolation, sqlite3.IntegrityError) as exc:
   303	                conn.execute("ROLLBACK")
   304	                raise _no(_plain(exc)) from exc
   305	            commit = _git_merge(tip)
   306	            if commit is None:
   307	                conn.execute("ROLLBACK")          # the record never happened either
   308	                raise _no("the merge didn't go through cleanly — it needs a person")
   309	            try:
   310	                conn.execute("COMMIT")
   311	            except sqlite3.Error:
   312	                # git merged, the record couldn't say so. Put main back exactly where it
   313	                # was, so the record and the repository never disagree about shipping.
   314	                _reset_main_to(before)
   315	                raise
   316	        except BaseException:
   317	            # Never leave a transaction open on a connection somebody else will reuse.
   318	            if conn.in_transaction:
   319	                conn.execute("ROLLBACK")
   320	            raise
   321	
   322	    _note(conn, job_id,
   323	          f"Merged into the main line of code. Asked for by {_clean(asked_by)}.", kind="done")
   324	    _log(conn, "merge", f"job {job_id}", True,
   325	         f"{len(families)} model families signed off on {version}; merged {commit}",
   326	         asked_by, job_id)
   327	    return Receipt(verb="merge", subject=f"job {job_id}", reference=commit,
   328	                   detail=f"{len(families)} model families signed off on {version}")
   329	
   330	
   331	_MERGE_LOCK = threading.Lock()          # two merges racing share one git index
   332	
   333	
   334	def _job_exists(conn, job_id: int) -> bool:
   335	    return conn.execute("SELECT 1 FROM jobs WHERE id = ?", (job_id,)).fetchone() is not None
   336	
   337	
   338	def _plain(exc: Exception) -> str:
   339	    """A schema refusal, with the machine word taken off the front."""
   340	    return str(exc).replace("guard: ", "").strip() or "the record wouldn't accept it"
   341	
   342	
   343	def _branch_tip(branch: str) -> str | None:
   344	    """The commit a BRANCH points at — refs/heads/ so nothing else can be meant."""
   345	    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}"],
   346	                         cwd=REPO, capture_output=True, text=True)
   347	    return out.stdout.strip() or None if out.returncode == 0 else None
   348	
   349	
   350	def _same_commit(tip: str, version: str) -> bool:
   351	    """Is the reviewed version this exact commit?
   352	
   353	    `head_version` is a short id, so compare on the shorter length. A version that is
   354	    not a commit id at all (the local worker records a content hash) can never match,
   355	    which is correct: if we cannot prove the reviewed thing is this code, we do not
   356	    merge it.
   357	    """
   358	    version = (version or "").strip().lower()
   359	    tip = (tip or "").strip().lower()
   360	    if len(version) < 7 or not re.fullmatch(r"[0-9a-f]+", version):
   361	        return False
   362	    return tip.startswith(version)
   363	
   364	
   365	REVIEWED_FILE = "chief_output/job_{job_id}.txt"     # where executor.py commits the work
   366	
   367	
   368	def _commit_holds_the_reviewed_work(commit: str, job_id: int, reviewed: str | None) -> bool:
   369	    """Is the text the panel reviewed present, unchanged, in this exact commit?"""
   370	    if reviewed is None:
   371	        return False
   372	    out = subprocess.run(["git", "show", f"{commit}:{REVIEWED_FILE.format(job_id=job_id)}"],
   373	                         cwd=REPO, capture_output=True, text=True)
   374	    return out.returncode == 0 and out.stdout == reviewed
   375	
   376	
   377	def _unreviewed_files_in(commit: str, job_id: int) -> list[str]:
   378	    """Every path the branch changes relative to main, except the one reviewed file."""
   379	    base = subprocess.run(["git", "merge-base", MERGE_INTO, commit], cwd=REPO,
   380	                          capture_output=True, text=True)
   381	    if base.returncode != 0 or not base.stdout.strip():
   382	        return ["<no common history with main>"]
   383	    diff = subprocess.run(["git", "diff", "--name-only", f"{base.stdout.strip()}..{commit}"],
   384	                          cwd=REPO, capture_output=True, text=True)
   385	    if diff.returncode != 0:
   386	        return ["<could not list the branch's changes>"]
   387	    allowed = REVIEWED_FILE.format(job_id=job_id)
   388	    return sorted(p for p in diff.stdout.splitlines() if p.strip() and p.strip() != allowed)
   389	
   390	
   391	def _repo_is_ready() -> bool:
   392	    """On the branch we merge into, with nothing half-done in the folder.
   393	
   394	    Merging into a detached HEAD orphans the result; merging over the owner's own
   395	    uncommitted work risks losing it when a failed merge is aborted.
   396	    """
   397	    head = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
   398	                          cwd=REPO, capture_output=True, text=True)
   399	    if head.returncode != 0 or head.stdout.strip() != MERGE_INTO:
   400	        return False
   401	    dirty = subprocess.run(["git", "status", "--porcelain"],
   402	                           cwd=REPO, capture_output=True, text=True)
   403	    return dirty.returncode == 0 and not dirty.stdout.strip()
   404	
   405	
   406	def _git_merge(commit: str) -> str | None:
   407	    """Merge one exact commit. Takes a SHA, not a ref, on purpose."""
   408	    try:
   409	        proc = subprocess.run(["git", "merge", "--no-ff", "--no-edit", commit],
   410	                              cwd=REPO, capture_output=True, text=True, timeout=120)
   411	    except subprocess.TimeoutExpired:
   412	        _abort_any_merge()
   413	        return None
   414	    if proc.returncode != 0:
   415	        # Leave nothing half-merged behind. A conflicted tree that nobody is looking at
   416	        # is worse than a refusal.
   417	        _abort_any_merge()
   418	        return None
   419	    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=REPO,
   420	                          capture_output=True, text=True)
   421	    return head.stdout.strip()[:12] or None
   422	
   423	
   424	def _main_tip() -> str | None:
   425	    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{MERGE_INTO}^{{commit}}"],
   426	                         cwd=REPO, capture_output=True, text=True)
   427	    return out.stdout.strip() or None if out.returncode == 0 else None
   428	
   429	
   430	def _reset_main_to(commit: str | None) -> None:
   431	    """Undo a merge whose record failed to commit. Only ever called with the tip that
   432	    was captured moments earlier under the merge lock, on a tree verified clean."""
   433	    if commit:
   434	        subprocess.run(["git", "reset", "--hard", commit], cwd=REPO, capture_output=True)
   435	
   436	
   437	def _abort_any_merge() -> None:
   438	    """Undo a half-finished merge — and ONLY a half-finished merge.
   439	
   440	    `git merge --abort` is `git reset --merge` underneath, which will discard the
   441	    owner's uncommitted work if no merge is actually in progress. Check first.
   442	    """
   443	    if (REPO / ".git" / "MERGE_HEAD").exists():
   444	        subprocess.run(["git", "merge", "--abort"], cwd=REPO, capture_output=True)
   445	
   446	
