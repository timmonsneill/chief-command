   172	# ---------------------------------------------------------------------------
   173	# Config
   174	# ---------------------------------------------------------------------------
   175	def load_config(path: Path = CONFIG) -> dict[str, Any]:
   176	    # seats.toml uses // comments for readability; TOML has no //, so strip them before
   177	    # parsing. Must be string-aware: value strings hold `https://…` and `base_url` lines
   178	    # end in `"…"  // note` — cutting at the first // blindly would eat the URL. So we
   179	    # only strip a // that sits OUTSIDE a quoted string.
   180	    raw = "\n".join(_strip_slash_comment(line) for line in path.read_text().splitlines())
   181	    return tomllib.loads(raw)
   182	
   183	
   184	def _strip_slash_comment(line: str) -> str:
   185	    """Drop an inline/full-line `//` comment, ignoring `//` inside quotes."""
   186	    quote = ""
   187	    for i in range(len(line) - 1):
   188	        ch = line[i]
   189	        if quote:
   190	            if ch == quote:
   191	                quote = ""
   192	        elif ch in "\"'":
   193	            quote = ch
   194	        elif ch == "/" and line[i + 1] == "/":
   195	            return line[:i].rstrip()
   196	    return line
   197	
   198	
   199	def unresolved_reviewers(cfg: dict[str, Any]) -> list[str]:
   200	    """Gauntlet reviewers that don't name a real seat. Empty == all resolve.
   201	
   202	    A roster entry pointing at a seat that doesn't exist (the old `grinder_paid`) is a
   203	    silent trap: `over_budget` treats the unknown seat as uncapped, the pre-check says
   204	    "fine," then the verdict write rejects it. Catch it at startup instead.
   205	    """
   206	    seats = cfg.get("seats", {})
   207	    return [r for r in cfg.get("gauntlet", {}).get("reviewers", []) if r not in seats]
   208	
   209	
   210	def panel_roster(conn, cfg: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
   211	    """Who can actually sit on the panel right now — and who can't, and why.
   212	
   213	    A roster entry is only real if the seat exists, is switched on, and we have a way to
   214	    RUN it on this machine. A seat whose provider has no runner, or whose key is absent, is excluded; the
   215	    codex seat needs its login. Counting those as panel members would produce a required
   216	    panel that can never report, which fails closed but useless — every job parked
   217	    forever. Counting them silently would be worse: a panel that shrank without saying
   218	    so reads exactly like a full one.
   219	
   220	    So: exclude them, name them, and let the FAMILY FLOOR (which cannot be lowered) be
   221	    the thing that decides whether what's left is enough.
   222	    """
   223	    import gauntlet
   224	
   225	    roster: list[str] = []
   226	    excluded: dict[str, str] = {}
   227	    for seat_id in cfg.get("gauntlet", {}).get("reviewers", []):
   228	        row = seat(conn, seat_id)
   229	        if row is None:
   230	            excluded[seat_id] = "that reviewer isn't set up on this machine"
   231	        elif not row["enabled"]:
   232	            excluded[seat_id] = "that reviewer is turned off"
   233	        elif not gauntlet.has_runner(row["provider"]):
   234	            excluded[seat_id] = "we have no way to run that reviewer yet"
   235	        else:
   236	            roster.append(seat_id)
   237	    return roster, excluded
   238	
   239	
   240	def _refuse_a_panel_that_cannot_hold(conn, roster: list[str], floor: int,
   241	                                     builder_family: str | None = None) -> None:
   242	    """Refuse to dispatch work the panel could never certify.
   243	
   244	    Fail CLOSED, but say so at DISPATCH — when it is one legible refusal — rather than
   245	    at review time, where it becomes a job that parks forever and looks like a bug.
   246	    """
   247	    if floor < 1:
   248	        raise DispatchRefused(
   249	            "the review panel isn't configured (it needs at least one model family) "
   250	            "— refusing to start work that nothing would check"
   251	        )
   252	    # Counted the way the database counts (migration 007): the author's own family is
   253	    # not a second opinion. Counting it here admitted jobs the record then parked.
   254	    families = {seat(conn, s)["family"] for s in roster} - {builder_family}
   255	    if len(families) < floor:
   256	        raise DispatchRefused(
   257	            f"only {len(families)} model family/families can review right now and "
   258	            f"{floor} are required — refusing to start work that could never be checked"
   259	        )
   260	
   261	
   262	def sync_seats(conn, cfg: dict[str, Any]) -> None:
   263	    """Push the config's seats into the store, so guards can reason about them.
   264	
   265	    Refuses a config whose gauntlet names a seat that doesn't exist, or a seat missing a
   266	    family — both would blow up later, mid-panel, where it's far harder to see.
   267	    """
   268	    missing = unresolved_reviewers(cfg)
   269	    if missing:
   270	        raise DispatchRefused(f"gauntlet names seats that don't exist: {missing}")
   271	    for seat_id, s in cfg.get("seats", {}).items():
   272	        if "family" not in s:
   273	            raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
   274	    for seat_id, s in cfg.get("seats", {}).items():
   275	        upsert_seat(conn, Seat(
   276	            id=seat_id,
   277	            provider=s["provider"],
   278	            model=s["model"],
   279	            family=s["family"],
   280	            tier=s["tier"],
   281	            daily_cap_cents=s.get("daily_cap_cents"),
   282	            build_cap_cents=s.get("build_cap_cents"),
   283	            review_cap_cents=s.get("review_cap_cents"),
   284	            enabled=not s.get("disabled", False),
   285	            notes=s.get("notes", ""),
   286	        ))
