   333	def _review_one(
   334	    job_id: int,
   335	    seat_id: str,
   336	    request: str,
   337	    code: str,
   338	    version: str,
   339	    cfg: dict[str, Any],
   340	    out: ReviewerRun,
   341	    db_path: Path,
   342	    decided: threading.Event,
   343	) -> None:
   344	    """One reviewer, in its own thread, on its own connection. Never raises.
   345	
   346	    The outer try/except is not belt-and-braces. ANY escape from this function kills the
   347	    thread with the run left blank — neither a verdict nor a stated reason — and a
   348	    reviewer that is neither counted nor excused is precisely the silent shrink this
   349	    panel exists to prevent. So every exit lands in `out`.
   350	    """
   351	    conn = None
   352	    try:
   353	        conn = connect(db_path)
   354	        row = seat(conn, seat_id)
   355	        if row is None:
   356	            out.skipped = "that reviewer isn't set up"
   357	            return
   358	        out.family = row["family"]
   359	        if not row["enabled"]:
   360	            out.skipped = "that reviewer is turned off"
   361	            _event(conn, job_id, row, "skipped", out.skipped)
   362	            return
   363	        runner = REVIEWERS.get(row["provider"])
   364	        if runner is None:
   365	            out.skipped = "we can't run that reviewer on this machine yet"
   366	            _event(conn, job_id, row, "skipped", out.skipped)
   367	            return
   368	        if over_budget(conn, seat_id):
   369	            out.skipped = "that reviewer is out of budget for today"
   370	            _event(conn, job_id, row, "skipped", out.skipped)
   371	            return
   372	
   373	        estimate = int(
   374	            cfg.get("seats", {}).get(seat_id, {}).get(
   375	                "review_estimate_cents", DEFAULT_ESTIMATE_CENTS)
   376	        )
   377	        # Already reviewed this exact version? Then this is a re-run, and repeating it
   378	        # would spend the money twice and stack duplicate verdicts on the record.
   379	        already = conn.execute(
   380	            "SELECT verdict, summary FROM verdicts WHERE job_id=? AND reviewer_seat=? "
   381	            "AND reviewed_version IS ? ORDER BY id DESC LIMIT 1",
   382	            (job_id, seat_id, version),
   383	        ).fetchone()
   384	        if already is not None:
   385	            out.verdict, out.summary = already["verdict"], already["summary"] or ""
   386	            return
   387	
   388	        if not _reserve_review_budget(conn, seat_id, job_id, estimate):
   389	            out.skipped = "that reviewer is out of budget for today"
   390	            _event(conn, job_id, row, "skipped", out.skipped)
   391	            return
   392	
   393	        _event(conn, job_id, row, "thinking", "Checking the work.")
   394	        try:
   395	            verdict, summary = runner(request, code, row["model"])
   396	        except subprocess.TimeoutExpired:
   397	            out.skipped = "that reviewer took too long and was stopped"
   398	            _event(conn, job_id, row, "error", out.skipped)
   399	            return
   400	        except ReviewerBroke as exc:
   401	            # The TOOL failed, not the work. Never a verdict — see ReviewerBroke.
   402	            out.skipped = "that reviewer couldn't run"
   403	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:160]}")
   404	            return
   405	        except Exception as exc:                      # noqa: BLE001 — a dead reviewer
   406	            out.skipped = "that reviewer couldn't finish"   # is a skip, never a pass
   407	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:120]}")
   408	            return
   409	
   410	        # The panel has already decided and moved on without us. Recording now would
   411	        # land a verdict on a job that was called finished a moment ago — and if it were
   412	        # a FAIL, the completion guards could no longer act on it, because they only fire
   413	        # on the way INTO done. A late answer is a non-answer.
   414	        if decided.is_set():
   415	            out.skipped = "that reviewer answered after the panel had already decided"
   416	            _event(conn, job_id, row, "skipped", out.skipped)
   417	            return
   418	
   419	        # reviewed_version is passed EXPLICITLY, never defaulted. The default reads the
   420	        # job's current head — which is only correct if nothing moved, and the whole
   421	        # point of the frozen bundle is not to depend on that being true.
   422	        try:
   423	            record_verdict(conn, job_id, seat_id, verdict=verdict,
   424	                           summary=summary, role="reviewer", reviewed_version=version)
   425	        except GuardViolation as exc:
   426	            out.skipped = "the record refused that verdict"
   427	            _event(conn, job_id, row, "error", str(exc)[:160])
   428	            return
   429	
   430	        # The `decided` check above and this write are not one step: the panel can
   431	        # decide and certify in between. A FAIL that lands after 'done' must un-certify
   432	        # from THIS side too — the writer is the only one who knows it just happened.
   433	        # `decided` is THIS panel's flag. Another panel on the same job (a re-run, a
   434	        # second dispatch) may have certified it already — so the check is on the
   435	        # record, not on our own bookkeeping.
   436	        if verdict == "fail":
   437	            status = conn.execute("SELECT status FROM jobs WHERE id = ?",
   438	                                  (job_id,)).fetchone()["status"]
   439	            if status == "done":
   440	                set_status(conn, job_id, "review",
   441	                           spoken_summary="Sent back — a reviewer found a problem.")
   442	            elif status == "shipped":
   443	                # Too late to un-merge. The one thing we can still do is refuse to be
   444	                # quiet about it: a merged objection is Neill's to see, not a footnote.
   445	                set_status(conn, job_id, "shipped",
   446	                           spoken_summary="⚠ A reviewer objected AFTER this was merged — "
   447	                                          "it needs your eyes.")
   448	                _event(conn, job_id, row, "error",
   449	                       "objection recorded after merge — needs a person")
   450	
   451	        out.summary = summary
   452	        out.verdict = verdict          # set LAST: `verdict` is what marks the run as real
   453	        _event(conn, job_id, row, "verdict",
   454	               "Passed the check." if verdict == "pass" else "Sent it back with notes.")
   455	    except Exception as exc:                          # noqa: BLE001
   456	        out.skipped = out.skipped or f"that reviewer couldn't finish: {str(exc)[:120]}"
   457	    finally:
   458	        if conn is not None:
   459	            conn.close()
   460	
