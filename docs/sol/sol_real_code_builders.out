    44	
    45	class DispatchRefused(RuntimeError):
    46	    """The harness declined to dispatch. Budget, disabled seat, or a guard."""
    47	
    48	
    49	# ---------------------------------------------------------------------------
    50	# The REAL, in-process dispatch path (task #9).
    51	#
    52	# dispatch()/_spawn() below hand work to OpenClaw — the production path, for the
    53	# paid coding seats. This one runs the free LOCAL model directly, in a background
    54	# worker, so the whole spine can be exercised end-to-end today with no money and no
    55	# exposed keys. Same recording, same guards, same worktree isolation.
    56	# ---------------------------------------------------------------------------
    57	@dataclass
    58	class LocalDispatch:
    59	    job_id: int
    60	    seat_id: str
    61	    reused: bool          # True = a duplicate key matched an existing job
    62	    tier: str
    63	    tier_reason: str
    64	
    65	
    66	def dispatch_local(
    67	    conn,
    68	    request: str,
    69	    builder_seat: str,
    70	    *,
    71	    cfg: dict[str, Any] | None = None,
    72	    origin: str = "text",
    73	    dispatch_key: str | None = None,
    74	    start: bool = True,
    75	) -> LocalDispatch:
    76	    """Record a job and start a real local worker on it. Non-blocking.
    77	
    78	    Order is load-bearing: we check the seat and the budget, dedupe, THEN write the
    79	    row, THEN start the worker — the store is the source of truth, nothing runs
    80	    without a row. Duplicate protection: a repeated dispatch_key returns the job that
    81	    already exists instead of starting the work twice.
    82	
    83	    The review requirements come from the GAUNTLET CONFIG, never from the caller
    84	    (task #10). A caller that could say "one reviewer is enough" is the single-reviewer
    85	    door this task exists to close.
    86	    """
    87	    # create_job / over_budget / seat are already imported at module level — re-importing
    88	    # them here rebound them as LOCALS, which silently shadowed the module's own names.
    89	    # Anything that swapped them (a test, a future wrapper) was ignored inside this
    90	    # function while appearing to work everywhere else.
    91	    from tiering import tier_for_build
    92	    import executor
    93	
    94	    cfg = load_config() if cfg is None else cfg
    95	    roster, excluded = panel_roster(conn, cfg)
    96	    families = int(cfg.get("gauntlet", {}).get("min_model_families", 0))
    97	    builder_row = seat(conn, builder_seat)
    98	    _refuse_a_panel_that_cannot_hold(conn, roster, families,
    99	                                     builder_row["family"] if builder_row else None)
   100	
   101	    # Duplicate protection — a retry must not start the same work twice.
   102	    if dispatch_key:
   103	        existing = conn.execute(
   104	            "SELECT id, builder_seat, tier, tier_reason FROM jobs WHERE dispatch_key = ?",
   105	            (dispatch_key,),
   106	        ).fetchone()
   107	        if existing is not None:
   108	            return LocalDispatch(
   109	                job_id=existing["id"], seat_id=existing["builder_seat"],
   110	                reused=True, tier=existing["tier"] or "standard",
   111	                tier_reason=existing["tier_reason"] or "",
   112	            )
   113	
   114	    row = seat(conn, builder_seat)
   115	    if row is None:
   116	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   117	    if not row["enabled"]:
   118	        raise DispatchRefused(f"seat '{builder_seat}' is turned off")
   119	    if over_budget(conn, builder_seat):
   120	        raise DispatchRefused(f"seat '{builder_seat}' is over its budget for today")
   121	
   122	    call = tier_for_build(request)
   123	
   124	    # ONE transaction for the whole record of this dispatch. A job must never exist,
   125	    # even for an instant, without its review requirements stamped on — in autocommit
   126	    # that gap is a real row with a zero floor. The excluded-reviewer notes go in here
   127	    # too: if writing them fails, the right outcome is no job at all, not a committed
   128	    # job whose panel quietly shrank without saying so.
   129	    #
   130	    # BEGIN IMMEDIATE, not BEGIN: this reads before it writes, and a deferred
   131	    # transaction that upgrades to a write after another connection has committed fails
   132	    # instantly with a snapshot error that the busy-timeout does NOT retry.
   133	    conn.execute("BEGIN IMMEDIATE")
   134	    try:
   135	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   136	        conn.execute(
   137	            "UPDATE jobs SET required_reviews = ?, required_review_families = ?, "
   138	            "tier = ?, tier_reason = ?, dispatch_key = ?, branch = ? WHERE id = ?",
   139	            (len(roster), families, call.tier, call.reason, dispatch_key,
   140	             f"job/{job_id}", job_id),
   141	        )
   142	        # No silent caps: a reviewer left out of the panel is written down on the job.
   143	        # (A roster name that isn't a seat at all has no row to hang an event on —
   144	        # sync_seats refuses that config outright, the earlier and louder place.)
   145	        for seat_id, why in excluded.items():
   146	            row = seat(conn, seat_id)
   147	            if row is None:
   148	                continue
   149	            conn.execute(
   150	                "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   151	                "VALUES (?,?,?,?,?,?,?)",
   152	                (job_id, seat_id, seat_id, row["model"], row["family"], "skipped",
   153	                 f"not on the panel: {why}"),
   154	            )
   155	        conn.execute("COMMIT")
   156	    except Exception as exc:
   157	        conn.execute("ROLLBACK")
   158	        # Anything that goes wrong here is a refusal to dispatch, not a mystery 500 —
   159	        # and above all not a committed job with no worker coming for it.
   160	        raise DispatchRefused(f"could not record the job: {exc}") from exc
   161	    set_status(conn, job_id, "in_progress")
   162	
   163	    if start:
   164	        executor.start_in_background(job_id, cfg=cfg)
   165	
   166	    return LocalDispatch(
   167	        job_id=job_id, seat_id=builder_seat, reused=False,
   168	        tier=call.tier, tier_reason=call.reason,
   169	    )
   170	
