   564	
   565	def _reconcile(conn, result: PanelResult) -> None:
   566	    """Last look: did an objection land while we were deciding?
   567	
   568	    The `decided` flag narrows that window; it cannot close it, because a straggler can
   569	    pass the check and be writing as the main thread commits. So after certifying we ask
   570	    the record — not our own bookkeeping — whether a failure exists against this version,
   571	    and un-certify if one does. Status can move back out of 'done'; the guards only
   572	    police the way in. A job wrongly parked costs a re-run. A job wrongly called finished
   573	    is the thing this project exists to prevent.
   574	    """
   575	    late = conn.execute(
   576	        "SELECT reviewer_seat FROM verdicts WHERE job_id=? AND verdict='fail' "
   577	        "AND reviewed_version IS ?", (result.job_id, result.version),
   578	    ).fetchone()
   579	    if late is None:
   580	        return
   581	    set_status(conn, result.job_id, "review",
   582	               spoken_summary="Sent back — a reviewer found a problem.")
   583	    result.certified = False
   584	    result.parked_reason = "a reviewer failed this version (it answered late)"
   585	
   586	
   587	def run_gauntlet_for_job(conn, job_id: int, cfg: dict[str, Any], *,
   588	                         db_path: Path | None = None) -> PanelResult:
   589	    """Run the panel for a job that is already parked at review.
   590	
   591	    Reads the frozen bundle off the job row ONCE — the request, the output that was put
   592	    forward, and the version it was recorded under — and hands that same snapshot to
   593	    everyone.
   594	    """
   595	    job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   596	    if job is None:
   597	        raise ValueError(f"no such job: {job_id}")
   598	    if not job["head_version"]:
   599	        # Nothing was put forward, so there is nothing to bind a verdict to. A verdict
   600	        # with no version condemns or approves we-don't-know-what.
   601	        return PanelResult(job_id=job_id, version="", required_families=0,
   602	                           parked_reason="no finished version to review")
   603	    return run_panel(conn, job_id, job["request"], job["result"] or "",
   604	                     job["head_version"], cfg, db_path=db_path)

