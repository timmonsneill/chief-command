   289	# ---------------------------------------------------------------------------
   290	# Dispatch
   291	# ---------------------------------------------------------------------------
   292	@dataclass
   293	class Dispatch:
   294	    job_id: int
   295	    run_id: str | None
   296	    seat_id: str
   297	
   298	
   299	def dispatch(
   300	    conn,
   301	    request: str,
   302	    builder_seat: str,
   303	    cfg: dict[str, Any],
   304	    origin: str = "text",
   305	    blocking: bool = False,
   306	) -> Dispatch:
   307	    """Record the job, then spawn it on OpenClaw. In that order, always.
   308	
   309	    Non-blocking by default — this is what lets the mouth stay responsive. OpenClaw's
   310	    sessions_spawn returns a run id immediately, so the voice head can say "on it" and
   311	    keep talking while the work grinds. A blocking dispatch here would reintroduce
   312	    exactly the latency wound that killed v1.
   313	    """
   314	    row = seat(conn, builder_seat)
   315	    if row is None:
   316	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   317	    if not row["enabled"]:
   318	        raise DispatchRefused(f"seat '{builder_seat}' is disabled")
   319	
   320	    # OpenClaw core has NO per-agent budget of any kind. If we don't check here,
   321	    # nothing does.
   322	    if over_budget(conn, builder_seat):
   323	        raise DispatchRefused(
   324	            f"seat '{builder_seat}' is over its daily cap — refusing to dispatch"
   325	        )
   326	
   327	    # SAME roster question dispatch_local asks. This path used to count the raw config
   328	    # list, so a job here was stamped as needing 3 reviewers when only 2 could ever run —
   329	    # and then parked forever with nothing to explain it, instead of one legible refusal
   330	    # at the door. Both entrances, one rule.
   331	    gauntlet = cfg.get("gauntlet", {})
   332	    roster, excluded = panel_roster(conn, cfg)
   333	    required = len(roster)
   334	    families = int(gauntlet.get("min_model_families", 0))
   335	    _refuse_a_panel_that_cannot_hold(conn, roster, families, row["family"])
   336	
   337	    # One transaction: the job must never exist for even a moment without its review
   338	    # requirements stamped on (autocommit would otherwise leave a floor-0 gap).
   339	    # IMMEDIATE because this reads before it writes — see dispatch_local.
   340	    conn.execute("BEGIN IMMEDIATE")
   341	    try:
   342	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   343	        conn.execute(
   344	            "UPDATE jobs SET required_reviews = ?, required_review_families = ? WHERE id = ?",
   345	            (required, families, job_id),
   346	        )
   347	        # No silent caps here either — same note dispatch_local writes.
   348	        for seat_id, why in excluded.items():
   349	            ex = seat(conn, seat_id)
   350	            if ex is None:
   351	                continue
   352	            conn.execute(
   353	                "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   354	                "VALUES (?,?,?,?,?,?,?)",
   355	                (job_id, seat_id, seat_id, ex["model"], ex["family"], "skipped",
   356	                 f"not on the panel: {why}"),
   357	            )
   358	        conn.execute("COMMIT")
   359	    except Exception:
   360	        conn.execute("ROLLBACK")
   361	        raise
   362	
   363	    # A paid builder reserves BEFORE it is called — the same rule the review panel
   364	    # follows. Checking the ledger without writing to it let a metered seat build all
   365	    # day with the ledger reading zero.
   366	    if row["tier"] == "metered":
   367	        import gatekeeper
   368	        try:
   369	            gatekeeper.spend(conn, builder_seat, BUILD_ESTIMATE_CENTS, job_id=job_id,
   370	                             role="build", asked_by="dispatch")
   371	        except gatekeeper.Refused as exc:
   372	            set_status(conn, job_id, "failed", error=f"not started: {exc}")
   373	            raise DispatchRefused(str(exc)) from exc
   374	
   375	    try:
   376	        run_id = _spawn(row, request, blocking=blocking)
   377	    except Exception as exc:  # noqa: BLE001 — a job nobody is coming for must say so
   378	        # The reservation (if any) stands: over-counting spend is the safe direction,
   379	        # and a failed spawn may still have cost something. But the JOB must not sit
   380	        # at 'todo' forever looking like it is about to start.
   381	        set_status(conn, job_id, "failed", error=f"the worker couldn't be started: {exc}")
   382	        raise DispatchRefused(f"the worker couldn't be started: {exc}") from exc
   383	    attach_run(conn, job_id, run_id=run_id or "", branch=f"job/{job_id}")
   384	    set_status(conn, job_id, "in_progress")
   385	
   386	    return Dispatch(job_id=job_id, run_id=run_id, seat_id=builder_seat)
   387	
   388	
   389	def _spawn(seat_row, request: str, blocking: bool) -> str | None:
   390	    """Hand the work to OpenClaw.
   391	
   392	    `openclaw agent` runs one turn via the Gateway. The model is chosen per-spawn,
   393	    which is what lets a single orchestrator turn fan out across several families.
   394	    """
   395	    cmd = [
   396	        "openclaw", "agent",
   397	        "--model", f"{seat_row['provider']}/{seat_row['model']}",
   398	        "--message", request,
   399	    ]
   400	    if not blocking:
   401	        cmd.append("--detach")
   402	
   403	    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
   404	    if proc.returncode != 0:
   405	        raise DispatchRefused(f"openclaw refused the spawn: {proc.stderr.strip()[:300]}")
   406	
   407	    # The gateway echoes a run id; fall back to the raw stdout if the shape changes.
   408	    try:
   409	        return json.loads(proc.stdout).get("runId")
   410	    except (json.JSONDecodeError, AttributeError):
   411	        return proc.stdout.strip()[:80] or None
   412	
   413	
   414	# ---------------------------------------------------------------------------
   415	# The gauntlet (spec §6)
   416	# ---------------------------------------------------------------------------
   417	def run_gauntlet(conn, job_id: int, cfg: dict[str, Any]) -> dict[str, Any]:
   418	    """Fan the finished work out to the reviewer panel, in parallel, same bundle.
   419	
   420	    This used to return a list of reviewer NAMES and launch nobody — the gauntlet was a
   421	    plan, not a thing that ran (task #10). It now runs the panel and returns what
   422	    actually happened: who reviewed, which families, what they said, and — if the job
   423	    stayed parked — why, in plain words.
   424	
   425	    The model-diversity rule (§6) still isn't asserted here; it's RECORDED. Every
   426	    verdict snapshots the reviewing seat's family, and the schema refuses to complete a
   427	    job without enough distinct families passing THIS version. So "two different minds
   428	    looked at this" is a fact you can query, not a promise this function made.
   429	    """
   430	    import gauntlet as gauntlet_mod
   431	
   432	    return gauntlet_mod.run_gauntlet_for_job(conn, job_id, cfg).as_dict()
   433	
   434	
   435	def ship(conn, job_id: int, owner_confirmed: bool = False) -> None:
   436	    """DO NOT CALL. Shipping belongs to the gatekeeper now (task #11).
   437	
   438	    This function is the reason #11 exists: it was one import away from any agent, and
   439	    it did the thing because it was called. `gatekeeper.merge()` does the same job and
   440	    re-reads the record instead of trusting the caller.
   441	
   442	    Kept as a refusal rather than deleted, so that anything still reaching for the old
   443	    power gets a legible answer instead of an ImportError somebody "fixes" by
   444	    reimplementing it locally.
   445	    """
   446	    raise DispatchRefused(
   447	        "shipping is the gatekeeper's job now — ask it to merge (gatekeeper.merge), "
   448	        "which checks the panel, the version and the families itself"
   449	    )
   450	
   451	
   452	# The original ship() implementation used to sit here, renamed. That was the mistake the
   453	# comment above warns about, made in the same file: the new ship() refused politely while
   454	# the old power stayed callable eight lines below it. Deleted. gatekeeper.merge() is the
   455	# only route to 'shipped', and it re-reads the record instead of trusting the caller.
   456	
   457	
   458	def morning_report(conn) -> list[dict[str, Any]]:
   459	    """What shipped while you slept, and what didn't.
   460	
   461	    Neill is out of the critical path, not out of the loop. This is the difference.
   462	    """
   463	    rows = conn.execute(
   464	        """
   465	        SELECT id, request, status, builder_seat, spoken_summary, finished_at
   466	          FROM jobs
   467	         WHERE created_at >= datetime('now', '-1 day')
   468	         ORDER BY
   469	           CASE status WHEN 'shipped' THEN 0 WHEN 'review' THEN 1
   470	                       WHEN 'failed' THEN 2 ELSE 3 END,
   471	           id
   472	        """
   473	    ).fetchall()
   474	    return [dict(r) for r in rows]

