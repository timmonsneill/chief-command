harness/db/schema.sql-17--- Seats: the named roles from spec §4. Providers are swappable behind these.
harness/db/schema.sql-18--- ---------------------------------------------------------------------------
harness/db/schema.sql-19-CREATE TABLE IF NOT EXISTS seats (
harness/db/schema.sql-20-    id            TEXT PRIMARY KEY,          -- 'brain' | 'workhorse' | 'grinder_local' | 'reviewer' | 'tester' | 'mouth'
harness/db/schema.sql:21:    provider      TEXT NOT NULL,             -- 'codex' | 'xai' | 'ollama' | 'claude-cli' | ...
harness/db/schema.sql-22-    model         TEXT NOT NULL,
harness/db/schema.sql-23-    -- Model FAMILY, not provider. Two seats can share a family via different providers
harness/db/schema.sql:24:    -- (e.g. claude-cli and an Anthropic API key are both 'claude'). The gauntlet's
harness/db/schema.sql-25-    -- diversity rule and the no-self-testing guard both key off this, so it must be
harness/db/schema.sql-26-    -- the thing that actually determines shared blind spots.
harness/db/schema.sql-27-    family        TEXT NOT NULL,             -- 'gpt' | 'claude' | 'grok' | 'qwen'
harness/db/schema.sql-28-    -- tier drives the review guard below. 'local' output is never trusted on its own.
--
harness/db/schema.sql-77-    notes         TEXT
harness/db/schema.sql-78-);
harness/db/schema.sql-79-
harness/db/schema.sql-80--- ---------------------------------------------------------------------------
harness/db/schema.sql:81:-- Projects: the top-level thing work belongs to. Each has its OWN memory.
harness/db/schema.sql-82---
harness/db/schema.sql:83:-- Owner: "ability to see a projects tab and each project has its own memory,
harness/db/schema.sql-84--- timeline/planning."
harness/db/schema.sql-85---
harness/db/schema.sql-86--- This matters more than it looks. Memory that isn't scoped to a project leaks:
harness/db/schema.sql-87--- lessons from the EMR bleed into the harness, conventions from one codebase get
harness/db/schema.sql:88:-- applied to another. Chief already keeps per-AGENT memory; this is per-PROJECT,
harness/db/schema.sql-89--- and the two are different axes. Riggs knows how HE works; the project knows how
harness/db/schema.sql-90--- IT works.
harness/db/schema.sql-91--- ---------------------------------------------------------------------------
harness/db/schema.sql-92-CREATE TABLE IF NOT EXISTS projects (
harness/db/schema.sql-93-    id            TEXT PRIMARY KEY,          -- 'chief', 'arch', 'jess'
harness/db/schema.sql-94-    name          TEXT NOT NULL,
harness/db/schema.sql-95-    repo_path     TEXT,
harness/db/schema.sql-96-    description   TEXT,
harness/db/schema.sql:97:    -- Where this project's own memory lives. Loaded into context for any job on it.
harness/db/schema.sql:98:    memory_dir    TEXT,
harness/db/schema.sql-99-    color         TEXT,                      -- the UI reads this
harness/db/schema.sql-100-    archived      INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0,1)),
harness/db/schema.sql-101-    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
harness/db/schema.sql-102-);
--
harness/db/schema.sql-105--- Studio), not just wherever a row happened to be typed. Without this, `projects` is
harness/db/schema.sql-106--- empty on a new box and Chief goes back to improvising what Neill is working on — the
harness/db/schema.sql-107--- exact bug this seed exists to kill. OR IGNORE so it never clobbers live edits.
harness/db/schema.sql-108---
harness/db/schema.sql:109:-- repo_path: Arch is deliberately NULL. Chief may read Arch's NOTES (memory), but the
harness/db/schema.sql-110--- fleet must never be pointed at its code or its patient data (Decision C, PHI). Dispatch
harness/db/schema.sql-111--- does not route by repo_path today; if it ever learns to, THAT is where the guard goes.
harness/db/schema.sql-112---
harness/db/schema.sql:113:-- memory_dir is NOT seeded here on purpose: it's the one genuinely machine-specific value
harness/db/schema.sql-114--- (where this box keeps the project's notes), so it's set as local config per machine —
harness/db/schema.sql-115--- keeping this file hardware-agnostic (rule 4).
harness/db/schema.sql-116-INSERT OR IGNORE INTO projects (id, name, repo_path, description, color) VALUES
harness/db/schema.sql-117-  ('chief', 'Chief Command', '~/code-projects/chief-command',
