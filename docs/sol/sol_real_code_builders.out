harness/db/schema.sql-128-    id            INTEGER PRIMARY KEY,
harness/db/schema.sql-129-    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
harness/db/schema.sql-130-    kind          TEXT NOT NULL DEFAULT 'lesson'
harness/db/schema.sql-131-                  CHECK (kind IN ('lesson', 'convention', 'constraint', 'decision', 'gotcha')),
--
harness/db/schema.sql-134-    learned_from  INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
harness/db/schema.sql-135-    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
harness/db/schema.sql-136-);
