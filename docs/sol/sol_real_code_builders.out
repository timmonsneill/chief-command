   531	def spend(conn, seat_id: str, cents: int, *, job_id: int | None = None,
   532	          role: str = "build", asked_by: str = "unknown") -> Receipt:
   533	    """Reserve money BEFORE the provider is called, or refuse.
   534	
   535	    Sol: refusing to RECORD a charge doesn't unspend it. So the ledger is written first
   536	    and the call happens after. The daily and monthly caps live in the schema, which is
   537	    what makes this a reservation rather than a note — two agents reserving at the same
   538	    instant both hit the ledger, and the ledger refuses the one that breaches.
   539	
   540	    ⚠️ THERE IS NO RECONCILIATION YET. A reservation is an ESTIMATE, and if the real
   541	    call costs less, or never happens at all, the estimate stands against the cap
   542	    permanently. That is deliberate for now (erring toward over-counting spend is the
   543	    safe direction) but it is not the same thing as accurate accounting, and this
   544	    docstring said otherwise until the cross-model review called it.
   545	    """
   546	    if cents < 0:
   547	        raise _refuse(conn, job_id, "a charge can't be negative",
   548	                      verb="spend", subject=seat_id, asked_by=asked_by)
   549	    row = seat(conn, seat_id)
   550	    if row is None:
   551	        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
   552	                      verb="spend", subject=seat_id, asked_by=asked_by)
   553	    # A metered seat costs money every call. "Reserve zero, then make the call" would
   554	    # walk every cap — daily, role, monthly — without any of them moving.
   555	    if cents == 0 and row["tier"] == "metered":
   556	        raise _refuse(conn, job_id, "a paid worker can't reserve nothing — "
   557	                      "say what the call will cost",
   558	                      verb="spend", subject=seat_id, asked_by=asked_by)
   559	    # The caps are keyed BY ROLE, so a role nobody validated is a cap nobody enforces —
   560	    # 'research' would sail past both the build ration and the review ration.
   561	    if role not in SPEND_ROLES:
   562	        raise _refuse(conn, job_id, f"'{role}' isn't a kind of work money can be spent on",
   563	                      verb="spend", subject=seat_id, asked_by=asked_by)
   564	    row = seat(conn, seat_id)
   565	    if row is None:
   566	        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
   567	                      verb="spend", subject=seat_id, asked_by=asked_by)
   568	    if not row["enabled"]:
