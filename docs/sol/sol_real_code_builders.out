harness/db/schema.sql-367--- ═══════════════════════════════════════════════════════════════════════════════
harness/db/schema.sql-368-CREATE TABLE IF NOT EXISTS capabilities (
harness/db/schema.sql-369-    seat_id       TEXT NOT NULL REFERENCES seats(id) ON DELETE CASCADE,
harness/db/schema.sql-370-    capability    TEXT NOT NULL CHECK (capability IN (
harness/db/schema.sql-371-                      -- SAFE. Granted to every builder. This is the actual job.
harness/db/schema.sql:372:                      'read_code', 'write_worktree', 'run_tests', 'open_pr',
harness/db/schema.sql-373-                      -- DANGEROUS. Denied to everyone by default. Each needs a
