   431	-- ═══════════════════════════════════════════════════════════════════════════════
   432	-- GUARD 12 — a dangerous act needs a live, unused, read-back approval.
   433	-- No approval, no action. Not "Chief said it was fine" — a signed slip, or nothing.
   434	-- ═══════════════════════════════════════════════════════════════════════════════
   435	CREATE VIEW IF NOT EXISTS live_approvals AS
   436	SELECT * FROM approvals
   437	 WHERE granted_at IS NOT NULL
   438	   AND used_at    IS NULL
   439	   AND revoked_at IS NULL
   440	   AND expires_at > datetime('now')
   441	   AND TRIM(read_back) <> '';
   442	
   443	-- An approval may never be BORN granted. (Sol, round 3 — verified 2026-07-14.)
   444	--
   445	-- Every approval guard fired on UPDATE OF granted_at only — the exact "born done" hole
   446	-- Sol found on the jobs table in round 1, never applied here. Confirmed with a live
   447	-- exploit: an INSERT with granted_at already set, reversible=0 and no recovery plan sailed
   448	-- straight into the live_approvals view. An approval must be born ungranted and become
   449	-- granted through an UPDATE, where the read-back and recovery guards below actually fire.
   450	CREATE TRIGGER IF NOT EXISTS guard_no_approval_is_born_granted
   451	BEFORE INSERT ON approvals
   452	WHEN NEW.granted_at IS NOT NULL
   453	BEGIN
   454	    SELECT RAISE(ABORT, 'guard: an approval cannot be created already granted — it must be granted through a read-back');
   455	END;
   456	
   457	-- An approval cannot be granted without something having been read back.
   458	CREATE TRIGGER IF NOT EXISTS guard_no_approval_without_readback
   459	BEFORE UPDATE OF granted_at ON approvals
   460	WHEN NEW.granted_at IS NOT NULL AND TRIM(COALESCE(NEW.read_back, '')) = ''
   461	BEGIN
   462	    SELECT RAISE(ABORT, 'guard: nothing was read back to him — a yes to nothing is not a yes');
   463	END;
   464	
   465	-- An irreversible act cannot be approved without a recovery plan.
   466	-- Sol: "'Kill' must never be presented as 'undo.'"
   467	CREATE TRIGGER IF NOT EXISTS guard_irreversible_needs_a_way_back
   468	BEFORE UPDATE OF granted_at ON approvals
   469	WHEN NEW.granted_at IS NOT NULL AND NEW.reversible = 0
   470	     AND TRIM(COALESCE(NEW.recovery, '')) = ''
   471	BEGIN
   472	    SELECT RAISE(ABORT, 'guard: this cannot be undone and has no way back — not without a recovery plan');
   473	END;
   474	
   475	-- Single use. A permission slip is spent when it is used.
   476	CREATE TRIGGER IF NOT EXISTS guard_an_approval_is_used_once
   477	BEFORE UPDATE OF used_at ON approvals
   478	WHEN OLD.used_at IS NOT NULL
   479	BEGIN
   480	    SELECT RAISE(ABORT, 'guard: that permission was already spent');
   481	END;
   482	
   483	-- ---------------------------------------------------------------------------
   484	-- Events: the live activity stream. What an agent is doing RIGHT NOW.
   485	--
   486	-- This is what makes the text channel feel like the Claude Code terminal — you
   487	-- watch Riggs read auth.py, edit routes.py, run pytest, and come back green.
   488	-- Without it the harness can only tell you a job "happened," which is useless
   489	-- while you're waiting and only mildly interesting afterward.
   490	--
   491	-- ONE STREAM, TWO RENDERINGS (this is the key design decision):
   492	--   VOICE reads jobs.spoken_summary — a sentence. "Riggs is on it, two minutes."
   493	--   TEXT  reads THIS table in full   — every tool call, every file, every result.
   494	-- Same truth, different verbosity. The voice can escalate into this table on
   495	-- request ("what's it actually doing?") — see [voice] in seats.toml.
   496	--
   497	-- Note `lane` and `model` are BOTH recorded. The lane (Riggs) carries the memory
   498	-- and the conventions; the model is whoever is sitting in that chair today. You
   499	-- must always be able to see which — otherwise you can't tell whether your auth
   500	-- module was built by your best coder or your cheapest one.
   501	-- ---------------------------------------------------------------------------
   502	CREATE TABLE IF NOT EXISTS events (
   503	    id            INTEGER PRIMARY KEY,
   504	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   505	    seat_id       TEXT NOT NULL REFERENCES seats(id),
   506	    lane          TEXT NOT NULL,             -- 'riggs' | 'finn' | 'nova' | 'forge' ...
   507	    model         TEXT NOT NULL,             -- who is actually in the chair right now
   508	    family        TEXT NOT NULL,
   509	    -- 'skipped' is load-bearing (task #10): the record needs a word for something that
   510	    -- did NOT happen. A reviewer that was capped out or couldn't run must leave a mark,
   511	    -- or a panel that quietly shrank looks identical to a full one. (Migration 006.)
   512	    kind          TEXT NOT NULL CHECK (kind IN (
   513	                      'dispatched', 'thinking', 'read', 'edit', 'write',
   514	                      'command', 'test_run', 'browse', 'verdict', 'done', 'error',
   515	                      'skipped'
   516	                  )),
   517	    target        TEXT,                      -- the file / command / URL it touched
   518	    detail        TEXT,                      -- one line, terminal-style
   519	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   520	);

