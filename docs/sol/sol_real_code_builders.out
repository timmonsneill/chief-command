   164	def _after_certification(conn, job_id: int, cfg: dict[str, Any]) -> None:
   165	    """Once the panel certifies (result.certified), prove the work actually runs and
   166	    ask the one component allowed to ship it. Pulled out of run_job so it can be
   167	    exercised directly against a job already parked at 'done'.
   168	    """
