   622	-- ═══════════════════════════════════════════════════════════════════════════
   623	-- GUARD 11 — the month's budget is hard. It refuses the entry that would breach it.
   624	--
   625	-- Same principle as every other guard here: this is not a policy an agent is asked
   626	-- to respect, it is a write that fails.
   627	-- ═══════════════════════════════════════════════════════════════════════════
   628	CREATE TRIGGER IF NOT EXISTS guard_monthly_budget_is_hard
   629	BEFORE INSERT ON usage
   630	BEGIN
   631	    SELECT RAISE(ABORT, 'guard: this would blow the monthly budget')
   632	    WHERE (SELECT spent_cents FROM month_spend) + NEW.cost_cents
   633	        > (SELECT monthly_cap_cents FROM budget WHERE id = 1);
   634	END;
   635	
   636	-- ===========================================================================
   637	-- THE GUARDS
   638	--
   639	-- ⚠️ REWRITTEN 2026-07-13 after a cross-family review. Sol (GPT) reviewed Claude's
   640	-- code and found NINE ways through. The headline: every guard fired on UPDATE of
   641	-- status, and NONE fired on INSERT — so a job could be BORN 'done'. Fences around
   642	-- the front door, no wall.
   643	--
   644	-- Sol's closing line, which is the one that mattered:
   645	--     "Those are application conventions, not the claimed structurally impossible
   646	--      guarantees."
   647	--
   648	-- He was right. Fixed below. Each guard now fires on BOTH insert and update, checks
   649	-- SNAPSHOTTED facts rather than live ones, and validates claims against `seats`
   650	-- instead of trusting whatever the writer put in the row.
   651	-- ===========================================================================
   652	
   653	-- A job may never be BORN finished. (Sol, round 1, #1 — the worst one.)
   654	CREATE TRIGGER IF NOT EXISTS guard_no_job_is_born_done
   655	BEFORE INSERT ON jobs
   656	WHEN NEW.status IN ('done', 'shipped')
   657	BEGIN
   658	    SELECT RAISE(ABORT, 'guard: a job cannot be created already finished — it must earn it');
   659	END;
   660	
   661	-- A job may not LIE ABOUT WHO BUILT IT AT BIRTH. (Sol, round 2, #1 — critical.)
   662	--
   663	-- I froze the builder's identity AFTER creation, so it couldn't be rewritten. But I
   664	-- never checked it AT creation. Sol: "A direct database write can label local work as
   665	-- subscription work, then complete it without the required higher-quality review. The
   666	-- identity is frozen only after creation; the initial lie is never caught."
   667	--
   668	-- Freezing a lie just makes it a permanent lie.
   669	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_must_be_real
   670	BEFORE INSERT ON jobs
   671	WHEN NEW.builder_tier   <> (SELECT tier   FROM seats WHERE id = NEW.builder_seat)
   672	  OR NEW.builder_family <> (SELECT family FROM seats WHERE id = NEW.builder_seat)
   673	BEGIN
   674	    SELECT RAISE(ABORT, 'guard: a job cannot misrepresent who built it');
   675	END;
   676	
   677	-- The builder's tier/family are snapshotted at creation and are then HISTORY.
   678	-- (Sol #5, #6 — re-tiering a seat rewrote the past.)
   679	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_is_frozen
   680	BEFORE UPDATE ON jobs
   681	WHEN OLD.builder_seat <> NEW.builder_seat
   682	  OR OLD.builder_tier <> NEW.builder_tier
   683	  OR OLD.builder_family <> NEW.builder_family
   684	BEGIN
   685	    SELECT RAISE(ABORT, 'guard: who built this cannot be rewritten after the fact');
   686	END;
   687	
   688	-- The panel size is fixed at dispatch. (Sol #7 — it could be set to zero later.)
   689	CREATE TRIGGER IF NOT EXISTS guard_panel_size_is_fixed
   690	BEFORE UPDATE OF required_reviews ON jobs
   691	WHEN OLD.required_reviews > 0 AND NEW.required_reviews < OLD.required_reviews
   692	BEGIN
   693	    SELECT RAISE(ABORT, 'guard: the panel cannot be shrunk after dispatch');
   694	END;
   695	
   696	-- A verdict, once written, is a fact. It cannot be edited into a pass.
   697	-- (Sol #2 — every verdict guard checked INSERT only, so you could rewrite the row.)
   698	CREATE TRIGGER IF NOT EXISTS guard_verdicts_are_append_only
   699	BEFORE UPDATE ON verdicts
   700	WHEN OLD.verdict <> NEW.verdict
   701	     AND NOT (OLD.verdict = 'needs_human' AND NEW.verdict IN ('pass','fail'))
   702	BEGIN
   703	    SELECT RAISE(ABORT, 'guard: a verdict cannot be rewritten — only an escalation may be answered');
   704	END;
   705	
   706	CREATE TRIGGER IF NOT EXISTS guard_verdict_identity_is_frozen
   707	BEFORE UPDATE ON verdicts
   708	WHEN OLD.role <> NEW.role OR OLD.model_family <> NEW.model_family
   709	  OR OLD.reviewer_seat <> NEW.reviewer_seat OR OLD.reviewer_tier <> NEW.reviewer_tier
   710	BEGIN
   711	    SELECT RAISE(ABORT, 'guard: who reviewed this cannot be rewritten after the fact');
   712	END;
   713	
   714	-- ═══════════════════════════════════════════════════════════════════════════
   715	-- THE REVIEW-TO-VERSION CHAIN (Sol build gate 3, 2026-07-20).
   716	--
   717	-- Sol's most dangerous flaw: "approve version A, builder changes it to B, the old
   718	-- approval still counts — believable green checks on code nobody reviewed."
   719	--
   720	-- The fix is not another approval ceremony; it is arithmetic. A verdict carries the
   721	-- version it reviewed. A job carries the version it is putting forward. Completion
   722	-- guards only count verdicts whose versions MATCH — so moving the code voids the
   723	-- approvals by construction, nothing needs to remember to revoke anything. And a
   724	-- FAIL condemns the version it saw, not the job forever: fix the code, the version
   725	-- changes, the old fail becomes history. (A fail with no recorded version blocks
   726	-- everything — fail-closed, because it condemned we-don't-know-what.)
   727	-- ═══════════════════════════════════════════════════════════════════════════
   728	
   729	-- A versioned job accepts no unversioned verdicts. (Unversioned legacy jobs keep
   730	-- their old semantics; the gatekeeper will not push anything unversioned anyway.)
   731	CREATE TRIGGER IF NOT EXISTS guard_verdict_must_cite_what_it_reviewed
   732	BEFORE INSERT ON verdicts
   733	WHEN (SELECT head_version FROM jobs WHERE id = NEW.job_id) IS NOT NULL
   734	     AND TRIM(COALESCE(NEW.reviewed_version, '')) = ''
   735	BEGIN
   736	    SELECT RAISE(ABORT, 'guard: this job is versioned — a verdict must say which version it reviewed');
   737	END;
   738	
   739	-- A build cannot finish without declaring WHICH code is finished.
   740	CREATE TRIGGER IF NOT EXISTS guard_a_build_finishes_a_version
   741	BEFORE UPDATE OF status ON jobs
