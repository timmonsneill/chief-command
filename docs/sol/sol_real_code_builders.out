   223	# ---------------------------------------------------------------------------
   224	# What came back
   225	# ---------------------------------------------------------------------------
   226	@dataclass
   227	class ReviewerRun:
   228	    """One seat's participation — including the ones that did NOT participate.
   229	
   230	    A skipped reviewer is part of the result, never an omission. "No silent caps": a
   231	    panel that quietly shrank reads as a full panel to anyone looking at the verdicts.
   232	    """
   233	    seat_id: str
   234	    family: str = ""
   235	    verdict: str | None = None      # pass | fail | needs_human | None if it never ran
   236	    summary: str = ""
   237	    skipped: str = ""               # why it didn't run, in plain words
   238	
   239	    @property
   240	    def ran(self) -> bool:
   241	        return self.verdict is not None
   242	
   243	
   244	@dataclass
   245	class PanelResult:
   246	    job_id: int
   247	    version: str
   248	    required_families: int
   249	    runs: list[ReviewerRun] = field(default_factory=list)
   250	    certified: bool = False         # did the job actually reach 'done'
   251	    parked_reason: str = ""         # if not, why — in plain words
   252	
   253	    builder_family: str = ""        # the author is not a second opinion (migration 007)
   254	
   255	    @property
   256	    def families_passed(self) -> set[str]:
   257	        """Counted the way the database counts: minds OTHER than the author's."""
   258	        return {r.family for r in self.runs
   259	                if r.verdict == "pass" and r.family != self.builder_family}
   260	
   261	    @property
   262	    def failed(self) -> list[ReviewerRun]:
   263	        return [r for r in self.runs if r.verdict == "fail"]
   264	
   265	    def as_dict(self) -> dict[str, Any]:
   266	        return {
   267	            "job_id": self.job_id,
   268	            "version": self.version,
   269	            "required_families": self.required_families,
   270	            "families_passed": sorted(self.families_passed),
   271	            "certified": self.certified,
   272	            "parked_reason": self.parked_reason,
   273	            "runs": [
   274	                {"seat": r.seat_id, "family": r.family, "verdict": r.verdict,
   275	                 "summary": r.summary, "skipped": r.skipped}
   276	                for r in self.runs
   277	            ],
   278	        }
   279	
   280	    def spoken(self) -> str:
   281	        """One sentence for the voice. No seat names, no jargon."""
   282	        n = len([r for r in self.runs if r.ran])
   283	        minds = len(self.families_passed)
   284	        if self.certified:
   285	            return f"{n} different models checked it and it passed. Ready for you."
   286	        if self.failed:
   287	            return "It was checked and sent back — one of the reviewers found a problem."
   288	        return f"Only {minds} of the {self.required_families} required models could check it, so it's waiting."
   289	
   290	
   291	# ---------------------------------------------------------------------------
   292	# The panel
   293	# ---------------------------------------------------------------------------
   294	def _event(conn, job_id: int, seat_row, kind: str, detail: str) -> None:
   295	    conn.execute(
   296	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   297	        "VALUES (?, ?, ?, ?, ?, ?, ?)",
   298	        (job_id, seat_row["id"], seat_row["id"], seat_row["model"],
   299	         seat_row["family"], kind, detail),
   300	    )
   301	
   302	
   303	def _reserve_review_budget(conn, seat_id: str, job_id: int, cents: int) -> bool:
   304	    """Take the money BEFORE the call, not after.
   305	
   306	    Sol: "refusing to RECORD a charge doesn't unspend it." Two reviewers reserving at
   307	    once both hit the ledger, and the ledger's own cap trigger refuses the one that
   308	    would breach — so the race resolves in the database, not in a Python check that
   309	    both threads passed a moment earlier. Uncapped seats reserve nothing.
   310	    """
   311	    row = seat(conn, seat_id)
   312	    if row is None:
   313	        return True
   314	    # ALWAYS go through the ledger, even for a seat with no daily cap. Skipping the write
   315	    # when daily_cap_cents was NULL meant the MONTHLY budget and the per-role review
   316	    # ration never saw those calls at all — and today's two working reviewers are both
   317	    # uncapped, so that was every review in production. A flat-rate seat records 0 and
   318	    # still shows up in the account of what ran.
   319	    if row["tier"] != "metered":
   320	        cents = 0
   321	    # ASK, don't take. Spending is the gatekeeper's power (task #11) — the panel is a
   322	    # caller like any other, and gets no special path to the money because it happens
   323	    # to live in the same process.
   324	    import gatekeeper
   325	    try:
   326	        gatekeeper.spend(conn, seat_id, cents, job_id=job_id, role="review",
   327	                         asked_by="the review panel")
   328	        return True
   329	    except gatekeeper.Refused:
   330	        return False
   331	
   332	
   333	def _review_one(
   334	    job_id: int,
   335	    seat_id: str,
   336	    request: str,
   337	    code: str,
   338	    version: str,
   339	    cfg: dict[str, Any],
   340	    out: ReviewerRun,
   341	    db_path: Path,
   342	    decided: threading.Event,
   343	) -> None:
   344	    """One reviewer, in its own thread, on its own connection. Never raises.
   345	
   346	    The outer try/except is not belt-and-braces. ANY escape from this function kills the
   347	    thread with the run left blank — neither a verdict nor a stated reason — and a
   348	    reviewer that is neither counted nor excused is precisely the silent shrink this
   349	    panel exists to prevent. So every exit lands in `out`.
   350	    """
   351	    conn = None
   352	    try:
   353	        conn = connect(db_path)
   354	        row = seat(conn, seat_id)
   355	        if row is None:
   356	            out.skipped = "that reviewer isn't set up"
   357	            return
   358	        out.family = row["family"]
   359	        if not row["enabled"]:
   360	            out.skipped = "that reviewer is turned off"
   361	            _event(conn, job_id, row, "skipped", out.skipped)
   362	            return
   363	        runner = REVIEWERS.get(row["provider"])
   364	        if runner is None:
   365	            out.skipped = "we can't run that reviewer on this machine yet"
   366	            _event(conn, job_id, row, "skipped", out.skipped)
   367	            return
   368	        if over_budget(conn, seat_id):
   369	            out.skipped = "that reviewer is out of budget for today"
   370	            _event(conn, job_id, row, "skipped", out.skipped)
   371	            return
   372	
   373	        estimate = int(
   374	            cfg.get("seats", {}).get(seat_id, {}).get(
   375	                "review_estimate_cents", DEFAULT_ESTIMATE_CENTS)
   376	        )
   377	        # Already reviewed this exact version? Then this is a re-run, and repeating it
   378	        # would spend the money twice and stack duplicate verdicts on the record.
   379	        already = conn.execute(
   380	            "SELECT verdict, summary FROM verdicts WHERE job_id=? AND reviewer_seat=? "
   381	            "AND reviewed_version IS ? ORDER BY id DESC LIMIT 1",
   382	            (job_id, seat_id, version),
   383	        ).fetchone()
   384	        if already is not None:
   385	            out.verdict, out.summary = already["verdict"], already["summary"] or ""
   386	            return
   387	
   388	        if not _reserve_review_budget(conn, seat_id, job_id, estimate):
   389	            out.skipped = "that reviewer is out of budget for today"
   390	            _event(conn, job_id, row, "skipped", out.skipped)
   391	            return
   392	
   393	        _event(conn, job_id, row, "thinking", "Checking the work.")
   394	        try:
   395	            verdict, summary = runner(request, code, row["model"])
   396	        except subprocess.TimeoutExpired:
   397	            out.skipped = "that reviewer took too long and was stopped"
   398	            _event(conn, job_id, row, "error", out.skipped)
   399	            return
   400	        except ReviewerBroke as exc:
   401	            # The TOOL failed, not the work. Never a verdict — see ReviewerBroke.
   402	            out.skipped = "that reviewer couldn't run"
   403	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:160]}")
   404	            return
   405	        except Exception as exc:                      # noqa: BLE001 — a dead reviewer
   406	            out.skipped = "that reviewer couldn't finish"   # is a skip, never a pass
   407	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:120]}")
   408	            return
   409	
   410	        # The panel has already decided and moved on without us. Recording now would
   411	        # land a verdict on a job that was called finished a moment ago — and if it were
   412	        # a FAIL, the completion guards could no longer act on it, because they only fire
   413	        # on the way INTO done. A late answer is a non-answer.
   414	        if decided.is_set():
   415	            out.skipped = "that reviewer answered after the panel had already decided"
   416	            _event(conn, job_id, row, "skipped", out.skipped)
   417	            return
   418	
   419	        # reviewed_version is passed EXPLICITLY, never defaulted. The default reads the
   420	        # job's current head — which is only correct if nothing moved, and the whole
   421	        # point of the frozen bundle is not to depend on that being true.
   422	        try:
   423	            record_verdict(conn, job_id, seat_id, verdict=verdict,
   424	                           summary=summary, role="reviewer", reviewed_version=version)
   425	        except GuardViolation as exc:
   426	            out.skipped = "the record refused that verdict"
   427	            _event(conn, job_id, row, "error", str(exc)[:160])
   428	            return
   429	
   430	        # The `decided` check above and this write are not one step: the panel can
   431	        # decide and certify in between. A FAIL that lands after 'done' must un-certify
   432	        # from THIS side too — the writer is the only one who knows it just happened.
   433	        # `decided` is THIS panel's flag. Another panel on the same job (a re-run, a
   434	        # second dispatch) may have certified it already — so the check is on the
   435	        # record, not on our own bookkeeping.
   436	        if verdict == "fail":
   437	            status = conn.execute("SELECT status FROM jobs WHERE id = ?",
   438	                                  (job_id,)).fetchone()["status"]
   439	            if status == "done":
   440	                set_status(conn, job_id, "review",
   441	                           spoken_summary="Sent back — a reviewer found a problem.")
   442	            elif status == "shipped":
   443	                # Too late to un-merge. The one thing we can still do is refuse to be
   444	                # quiet about it: a merged objection is Neill's to see, not a footnote.
   445	                set_status(conn, job_id, "shipped",
   446	                           spoken_summary="⚠ A reviewer objected AFTER this was merged — "
   447	                                          "it needs your eyes.")
   448	                _event(conn, job_id, row, "error",
   449	                       "objection recorded after merge — needs a person")
   450	
   451	        out.summary = summary
   452	        out.verdict = verdict          # set LAST: `verdict` is what marks the run as real
   453	        _event(conn, job_id, row, "verdict",
   454	               "Passed the check." if verdict == "pass" else "Sent it back with notes.")
   455	    except Exception as exc:                          # noqa: BLE001
   456	        out.skipped = out.skipped or f"that reviewer couldn't finish: {str(exc)[:120]}"
   457	    finally:
   458	        if conn is not None:
   459	            conn.close()
   460	
   461	
   462	def run_panel(
   463	    conn,
   464	    job_id: int,
   465	    request: str,
   466	    code: str,
   467	    version: str,
   468	    cfg: dict[str, Any],
   469	    *,
   470	    roster: list[str] | None = None,
   471	    db_path: Path | None = None,
   472	) -> PanelResult:
   473	    """Run the whole panel in parallel against one frozen bundle, then decide.
   474	
   475	    `conn` is the caller's connection, used only for the final decision. Each reviewer
   476	    gets its own. Returns what actually happened — including who didn't run and why.
   477	    """
   478	    import dispatch                      # local: dispatch imports this module
   479	
   480	    gauntlet = cfg.get("gauntlet", {})
   481	    # Ask the SAME question dispatch asked when it stamped the panel size on the job:
   482	    # who can actually sit? Falling back to the raw config list would put the panel and
   483	    # the job's own requirements at odds — the job needing 2 seats while the panel tried
   484	    # 3, one of which cannot run.
   485	    roster = roster if roster is not None else dispatch.panel_roster(conn, cfg)[0]
   486	    floor = int(gauntlet.get("min_model_families", 0))
   487	    db_path = db_path or DB_PATH
   488	
   489	    built_by = conn.execute("SELECT builder_family FROM jobs WHERE id = ?",
   490	                            (job_id,)).fetchone()
   491	    result = PanelResult(job_id=job_id, version=version, required_families=floor,
   492	                         builder_family=(built_by["builder_family"] if built_by else "") or "")
   493	
   494	    # A floor of zero is not "no requirement" — it is an UNCONFIGURED panel, and
   495	    # `0 < 0` is False, so every later check would wave it through and certify work
   496	    # nobody looked at. dispatch refuses this at the door; refuse it here too, because
   497	    # this function is reachable from anywhere and must not depend on its caller having
   498	    # been careful. Same for an empty roster: nobody to ask is not everybody agreeing.
   499	    if floor < 1 or not roster:
   500	        result.parked_reason = (
   501	            "no review panel is configured for this job — nothing would have checked it"
   502	        )
   503	        return result
   504	
   505	    result.runs = [ReviewerRun(seat_id=s) for s in roster]
   506	    decided = threading.Event()
   507	
   508	    threads = [
   509	        threading.Thread(
   510	            target=_review_one,
   511	            args=(job_id, run.seat_id, request, code, version, cfg, run, db_path,
   512	                  decided),
   513	            name=f"review-{job_id}-{run.seat_id}", daemon=True,
   514	        )
   515	        for run in result.runs
   516	    ]
   517	    for t in threads:
   518	        t.start()
   519	    for t in threads:
   520	        t.join(timeout=REVIEW_TIMEOUT_S + JOIN_GRACE_S)
   521	
   522	    # Close the door BEFORE reading any results. A reviewer still running has not
   523	    # answered, and must not be able to answer into a decision already made — the
   524	    # completion guards only fire on the way INTO done, so a late objection could never
   525	    # stop anything. It is recorded as not having participated, which is the truth.
   526	    decided.set()
   527	    for t, run in zip(threads, result.runs):
   528	        if t.is_alive() and not run.ran:
   529	            run.skipped = run.skipped or "that reviewer never answered"
   530	
   531	    # ── The decision. Every branch below ends in "leave it parked" except one. ──
   532	    if result.failed:
   533	        result.parked_reason = "a reviewer failed this version"
   534	        return result
   535	
   536	    families = result.families_passed
   537	    if len(families) < floor:
   538	        ran = len([r for r in result.runs if r.ran])
   539	        result.parked_reason = (
   540	            f"only {len(families)} model famil{'y' if len(families) == 1 else 'ies'} "
   541	            f"reviewed this ({ran} of {len(result.runs)} reviewers ran); "
   542	            f"{floor} are required"
   543	        )
   544	        return result
   545	
   546	    try:
   547	        set_status(conn, job_id, "done",
   548	                   spoken_summary=f"Checked by {len(families)} different models. Ready for you.")
   549	        result.certified = True
   550	    except GuardViolation as exc:
   551	        # Another gate still holds (panel size, an unanswered escalation, an old
   552	        # objection). Park honestly rather than argue with the boundary.
   553	        result.parked_reason = str(exc).replace("guard: ", "")
   554	
   555	    if result.certified:
   556	        _reconcile(conn, result)
   557	    if not result.certified:
   558	        # Say why it stopped, in the record, in plain words. A job parked with no stated
   559	        # reason is indistinguishable from a job nobody looked at.
   560	        conn.execute("UPDATE jobs SET spoken_summary = ? WHERE id = ?",
   561	                     (result.spoken(), job_id))
   562	    return result
   563	
   564	
   565	def _reconcile(conn, result: PanelResult) -> None:
   566	    """Last look: did an objection land while we were deciding?
   567	
   568	    The `decided` flag narrows that window; it cannot close it, because a straggler can
   569	    pass the check and be writing as the main thread commits. So after certifying we ask
   570	    the record — not our own bookkeeping — whether a failure exists against this version,
   571	    and un-certify if one does. Status can move back out of 'done'; the guards only
   572	    police the way in. A job wrongly parked costs a re-run. A job wrongly called finished
   573	    is the thing this project exists to prevent.
   574	    """
   575	    late = conn.execute(
   576	        "SELECT reviewer_seat FROM verdicts WHERE job_id=? AND verdict='fail' "
   577	        "AND reviewed_version IS ?", (result.job_id, result.version),
   578	    ).fetchone()
   579	    if late is None:
   580	        return
   581	    set_status(conn, result.job_id, "review",
   582	               spoken_summary="Sent back — a reviewer found a problem.")
   583	    result.certified = False
   584	    result.parked_reason = "a reviewer failed this version (it answered late)"
   585	
   586	
   587	def run_gauntlet_for_job(conn, job_id: int, cfg: dict[str, Any], *,
   588	                         db_path: Path | None = None) -> PanelResult:
   589	    """Run the panel for a job that is already parked at review.
   590	
   591	    Reads the frozen bundle off the job row ONCE — the request, the output that was put
   592	    forward, and the version it was recorded under — and hands that same snapshot to
   593	    everyone.
   594	    """
   595	    job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   596	    if job is None:
   597	        raise ValueError(f"no such job: {job_id}")
   598	    if not job["head_version"]:
   599	        # Nothing was put forward, so there is nothing to bind a verdict to. A verdict
   600	        # with no version condemns or approves we-don't-know-what.
   601	        return PanelResult(job_id=job_id, version="", required_families=0,
   602	                           parked_reason="no finished version to review")
   603	    return run_panel(conn, job_id, job["request"], job["result"] or "",
   604	                     job["head_version"], cfg, db_path=db_path)

