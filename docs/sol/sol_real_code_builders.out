   294	def _event(conn, job_id: int, seat_row, kind: str, detail: str) -> None:
   295	    conn.execute(
   296	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   297	        "VALUES (?, ?, ?, ?, ?, ?, ?)",
   298	        (job_id, seat_row["id"], seat_row["id"], seat_row["model"],
   299	         seat_row["family"], kind, detail),
   300	    )
   301	
   302	
   303	def _reserve_review_budget(conn, seat_id: str, job_id: int, cents: int) -> bool:
   304	    """Take the money BEFORE the call, not after.
   305	
   306	    Sol: "refusing to RECORD a charge doesn't unspend it." Two reviewers reserving at
   307	    once both hit the ledger, and the ledger's own cap trigger refuses the one that
   308	    would breach — so the race resolves in the database, not in a Python check that
   309	    both threads passed a moment earlier. Uncapped seats reserve nothing.
   310	    """
   311	    row = seat(conn, seat_id)
   312	    if row is None:
   313	        return True
   314	    # ALWAYS go through the ledger, even for a seat with no daily cap. Skipping the write
   315	    # when daily_cap_cents was NULL meant the MONTHLY budget and the per-role review
   316	    # ration never saw those calls at all — and today's two working reviewers are both
   317	    # uncapped, so that was every review in production. A flat-rate seat records 0 and
   318	    # still shows up in the account of what ran.
   319	    if row["tier"] != "metered":
   320	        cents = 0
   321	    # ASK, don't take. Spending is the gatekeeper's power (task #11) — the panel is a
   322	    # caller like any other, and gets no special path to the money because it happens
   323	    # to live in the same process.
   324	    import gatekeeper
   325	    try:
   326	        gatekeeper.spend(conn, seat_id, cents, job_id=job_id, role="review",
   327	                         asked_by="the review panel")
   328	        return True
   329	    except gatekeeper.Refused:
   330	        return False
   331	
