   226	@dataclass
   227	class ReviewerRun:
   228	    """One seat's participation — including the ones that did NOT participate.
   229	
   230	    A skipped reviewer is part of the result, never an omission. "No silent caps": a
   231	    panel that quietly shrank reads as a full panel to anyone looking at the verdicts.
   232	    """
   233	    seat_id: str
   234	    family: str = ""
   235	    verdict: str | None = None      # pass | fail | needs_human | None if it never ran
   236	    summary: str = ""
   237	    skipped: str = ""               # why it didn't run, in plain words
   238	
   239	    @property
   240	    def ran(self) -> bool:
   241	        return self.verdict is not None
   242	
   243	
   244	@dataclass
   245	class PanelResult:
   246	    job_id: int
   247	    version: str
   248	    required_families: int
   249	    runs: list[ReviewerRun] = field(default_factory=list)
   250	    certified: bool = False         # did the job actually reach 'done'
   251	    parked_reason: str = ""         # if not, why — in plain words
   252	
   253	    builder_family: str = ""        # the author is not a second opinion (migration 007)
   254	
   255	    @property
   256	    def families_passed(self) -> set[str]:
   257	        """Counted the way the database counts: minds OTHER than the author's."""
   258	        return {r.family for r in self.runs
   259	                if r.verdict == "pass" and r.family != self.builder_family}
   260	
   261	    @property
   262	    def failed(self) -> list[ReviewerRun]:
   263	        return [r for r in self.runs if r.verdict == "fail"]
   264	
   265	    def as_dict(self) -> dict[str, Any]:
   266	        return {
   267	            "job_id": self.job_id,
   268	            "version": self.version,
   269	            "required_families": self.required_families,
   270	            "families_passed": sorted(self.families_passed),
   271	            "certified": self.certified,
   272	            "parked_reason": self.parked_reason,
   273	            "runs": [
   274	                {"seat": r.seat_id, "family": r.family, "verdict": r.verdict,
   275	                 "summary": r.summary, "skipped": r.skipped}
   276	                for r in self.runs
   277	            ],
   278	        }
   279	
   280	    def spoken(self) -> str:
   281	        """One sentence for the voice. No seat names, no jargon."""
   282	        n = len([r for r in self.runs if r.ran])
   283	        minds = len(self.families_passed)
   284	        if self.certified:
   285	            return f"{n} different models checked it and it passed. Ready for you."
   286	        if self.failed:
   287	            return "It was checked and sent back — one of the reviewers found a problem."
   288	        return f"Only {minds} of the {self.required_families} required models could check it, so it's waiting."
   289	
