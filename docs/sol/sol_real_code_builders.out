   524	-- ---------------------------------------------------------------------------
   525	-- Artifacts: GROUND TRUTH. Captured by the harness, not reported by a model.
   526	--
   527	-- This is the anti-fabrication layer, and it exists for a specific reason:
   528	-- GPT-5.6-sol's own system card admits it fabricates results, and METR measured a
   529	-- cheating rate higher than any public model they'd evaluated. A tester that lies
   530	-- doesn't just fail — it silently disables the only quality gate in the fleet,
   531	-- because nothing checks the tester.
   532	--
   533	-- The defense is structural: Playwright drives the app like a real user and the
   534	-- HARNESS writes the screenshots, traces, console logs and network dumps to disk.
   535	-- The tester never asserts "I ran it and it worked" — it INTERPRETS artifacts it
   536	-- did not produce and cannot forge. You can't fabricate a screenshot.
   537	--
   538	-- Forge (the existing Claude Code integration tester) already worked this way by
   539	-- discipline: "If you didn't execute it and see it work, it's not tested."
   540	-- Here that stops being a personality trait and becomes a constraint.
   541	-- ---------------------------------------------------------------------------
   542	CREATE TABLE IF NOT EXISTS artifacts (
   543	    id            INTEGER PRIMARY KEY,
   544	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   545	    kind          TEXT NOT NULL CHECK (kind IN (
   546	                      -- build evidence: the harness drove the app and wrote these down
   547	                      'screenshot', 'trace', 'video', 'console_log',
   548	                      'network_log', 'dom_snapshot', 'exit_code', 'stdout', 'stderr',
   549	                      -- research evidence: a claim you can go and check yourself
   550	                      'source', 'quote'
   551	                  )),
   552	    path          TEXT,                      -- on-disk artifact
   553	    value         TEXT,                      -- inline (e.g. an exit code)
   554	    -- The flow this came from, e.g. "login -> dashboard -> dispatch a build"
   555	    flow          TEXT,
   556	    -- 'model' IS allowed here, but ONLY for research sources — a researcher must be
   557	    -- able to hand you a URL. It is still not allowed to invent a screenshot.
   558	    captured_by   TEXT NOT NULL DEFAULT 'harness'
   559	                  CHECK (captured_by IN ('harness', 'playwright', 'model')),
   560	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   561	);
   562	
   563	CREATE INDEX IF NOT EXISTS idx_artifacts_job ON artifacts(job_id);
