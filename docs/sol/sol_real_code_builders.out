harness/db/schema.sql-836-        WHERE a.job_id = NEW.job_id
harness/db/schema.sql-837-          AND a.kind IN ('screenshot', 'trace', 'video', 'dom_snapshot')
harness/db/schema.sql-838-          AND a.captured_by IN ('harness', 'playwright')
