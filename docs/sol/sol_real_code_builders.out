   627	def token() -> str:
   628	    """The shared secret a caller must present. Created once, readable only by us.
   629	
   630	    Loopback is a NETWORK control, not an authorization one. Without a token, any local
   631	    process — and any web page the owner happens to open, since a POST with a plain
   632	    content type is a "simple request" that needs no browser preflight — could drive the
   633	    three most dangerous powers in the system by fetching 127.0.0.1. A page cannot read
   634	    this file, so it cannot present the token.
   635	    """
   636	    TOKEN_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   637	    if not TOKEN_PATH.exists() or not TOKEN_PATH.read_text().strip():
   638	        # 0600 from the first byte — never a world-readable instant — and O_EXCL so two
   639	        # processes starting at once can't each write a different token (the loser
   640	        # simply reads the winner's). An empty file counts as missing:
   641	        # `compare_digest("", "")` is True, so an empty token would have let a
   642	        # header-less request through. Fail closed, always.
   643	        if TOKEN_PATH.exists():
   644	            TOKEN_PATH.unlink()
   645	        try:
   646	            fd = os.open(TOKEN_PATH, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
   647	        except FileExistsError:
   648	            fd = None                           # someone else just created it
   649	        if fd is not None:
   650	            with os.fdopen(fd, "w") as f:
   651	                f.write(secrets.token_urlsafe(32))
   652	            os.chmod(TOKEN_PATH, 0o600)
   653	    value = TOKEN_PATH.read_text().strip()
   654	    if len(value) < 32:
   655	        raise RuntimeError("the gatekeeper token is missing or too short — refusing to serve")
   656	    return value
   657	
   658	
   659	def serve(host: str = "127.0.0.1", port: int = 8788) -> None:
   660	    """Run the gatekeeper as its own process.
   661	
   662	    LOOPBACK ONLY, and not a choice to revisit casually: the tailnet is other devices,
   663	    and the whole point of this process is that reaching it is harder than reaching the
   664	    agents, not easier. Standard library only — the thing holding the dangerous powers
   665	    should have the smallest possible surface.
   666	    """
   667	    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
   668	
   669	    expected = token()
   670	
   671	    class Handler(BaseHTTPRequestHandler):
   672	        protocol_version = "HTTP/1.1"
   673	
   674	        def _reply(self, code: int, answer: dict) -> None:
   675	            payload = json.dumps(answer).encode()
   676	            self.send_response(code)
   677	            self.send_header("Content-Type", "application/json")
   678	            self.send_header("Content-Length", str(len(payload)))
   679	            if code >= 400:
   680	                # A refusal may have left the request body unread; on a kept-alive
   681	                # connection those bytes would be parsed as the NEXT request. Close.
   682	                self.send_header("Connection", "close")
   683	                self.close_connection = True
   684	            self.end_headers()
   685	            self.wfile.write(payload)
   686	
   687	        def do_POST(self):                                    # noqa: N802
   688	            try:
   689	                # Host check first: it is what stops DNS rebinding, where a page the
   690	                # owner is looking at resolves an attacker's domain to 127.0.0.1 and
   691	                # then talks to us with the browser's blessing.
   692	                host_header = (self.headers.get("Host") or "").split(":")[0]
   693	                if host_header not in ("127.0.0.1", "localhost", "[::1]"):
   694	                    return self._reply(403, {"ok": False, "error": "not for you"})
   695	                if not expected or not secrets.compare_digest(
   696	                        self.headers.get("X-Chief-Token") or "", expected):
   697	                    return self._reply(403, {"ok": False, "error": "not for you"})
   698	
   699	                length = int(self.headers.get("Content-Length") or 0)
   700	                if length < 0 or length > MAX_BODY_BYTES:
   701	                    return self._reply(413, {"ok": False, "error": "that request is too big"})
   702	                raw = self.rfile.read(length) if length else b"{}"
   703	                try:
   704	                    body = json.loads(raw or b"{}")
   705	                except json.JSONDecodeError:
   706	                    body = {}
   707	                if not isinstance(body, dict):
   708	                    body = {}
   709	
   710	                answer = handle(body)
   711	                self._reply(200 if answer.get("ok") else 403, answer)
   712	            except Exception:                                  # noqa: BLE001
   713	                # The gatekeeper never dies of a bad request. Down means stopped, and
   714	                # stopped means every irreversible thing stops with it.
   715	                try:
   716	                    self._reply(400, {"ok": False, "error": "that request didn't make sense"})
   717	                except Exception:                              # noqa: BLE001
   718	                    pass
   719	
   720	        def log_message(self, *args):                          # quiet by default
   721	            pass
   722	
   723	    server = ThreadingHTTPServer((host, port), Handler)
   724	    server.daemon_threads = True
   725	    server.serve_forever()
   726	
   727	
   728	if __name__ == "__main__":
   729	    serve()

