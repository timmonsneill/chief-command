   588	# ---------------------------------------------------------------------------
   589	# The service — loopback only, and only these three verbs
   590	# ---------------------------------------------------------------------------
   591	def handle(request: dict[str, Any], *, db_path: Path | None = None) -> dict[str, Any]:
   592	    """One request in, one answer out. The whole surface area of the gatekeeper.
   593	
   594	    An unknown verb is refused without being examined further. This is the check that
   595	    keeps rule 1 true as the file grows.
   596	    """
   597	    verb = request.get("verb")
   598	    if verb not in VERBS:
   599	        return {"ok": False, "error": "the gatekeeper only does three things: "
   600	                                      "merge, deploy, spend"}
   601	
   602	    conn = connect(db_path or DB_PATH)
   603	    try:
   604	        asked_by = str(request.get("asked_by") or "unknown")
   605	        try:
   606	            if verb == "merge":
   607	                r = merge(conn, int(request["job_id"]), asked_by=asked_by)
   608	            elif verb == "deploy":
   609	                r = deploy(conn, str(request["target"]),
   610	                           job_id=_known_job(conn, request.get("job_id")), asked_by=asked_by)
   611	            else:
   612	                r = spend(conn, str(request["seat_id"]), int(request["cents"]),
   613	                          job_id=_known_job(conn, request.get("job_id")),
   614	                          role=str(request.get("role") or "build"), asked_by=asked_by)
   615	        except Refused as exc:
   616	            return {"ok": False, "error": str(exc)}
   617	        except (KeyError, ValueError, TypeError) as exc:
   618	            return {"ok": False, "error": f"that request didn't make sense: {exc}"}
   619	        except sqlite3.Error as exc:
   620	            return {"ok": False, "error": f"the record refused that: {_plain(exc)}"}
   621	        return {"ok": True, "verb": r.verb, "subject": r.subject,
   622	                "detail": r.detail, "reference": r.reference}
   623	    finally:
   624	        conn.close()
