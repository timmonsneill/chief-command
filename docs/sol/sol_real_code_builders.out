harness/db/schema.sql-19-CREATE TABLE IF NOT EXISTS seats (
harness/db/schema.sql:20:    id            TEXT PRIMARY KEY,          -- 'brain' | 'workhorse' | 'grinder_local' | 'reviewer' | 'tester' | 'mouth'
harness/db/schema.sql-21-    provider      TEXT NOT NULL,             -- 'codex' | 'xai' | 'ollama' | 'claude-cli' | ...
harness/db/schema.sql-22-    model         TEXT NOT NULL,
harness/db/schema.sql-23-    -- Model FAMILY, not provider. Two seats can share a family via different providers
harness/db/schema.sql-24-    -- (e.g. claude-cli and an Anthropic API key are both 'claude'). The gauntlet's
harness/db/schema.sql-25-    -- diversity rule and the no-self-testing guard both key off this, so it must be
--
harness/db/schema.sql-258-    head_version  TEXT,
harness/db/schema.sql-259-
harness/db/schema.sql-260-    -- 'done'    = the gauntlet passed. The machine is satisfied.
harness/db/schema.sql-261-    -- 'shipped' = merged into the main line by the GATEKEEPER (Decision D, 2026-07-17:
harness/db/schema.sql-262-    --             the gauntlet IS the approval; Neill gates production DEPLOYS, not
harness/db/schema.sql:263:    --             merges). Guard 6 still requires a cross-family tester on the record.
harness/db/schema.sql-264-    -- (Earlier wording — "only Neill can move this" — predates Decision D.)
harness/db/schema.sql-265-    -- These are NOT the same thing, and conflating them is how agents launder
harness/db/schema.sql-266-    -- confidence. From Chief's memory, learned the hard way:
harness/db/schema.sql-267-    --     "Chief must NEVER say 'shipped' unless Neill has confirmed it works on
harness/db/schema.sql-268-    --      his device. 'Shipped' is reserved for Neill-confirmed-working."
--
harness/db/schema.sql-316-CREATE TABLE IF NOT EXISTS verdicts (
harness/db/schema.sql-317-    id            INTEGER PRIMARY KEY,
harness/db/schema.sql-318-    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
harness/db/schema.sql-319-    reviewer_seat TEXT NOT NULL REFERENCES seats(id),
harness/db/schema.sql-320-    reviewer_tier TEXT NOT NULL CHECK (reviewer_tier IN ('local', 'subscription', 'metered')),
harness/db/schema.sql:321:    -- 'reviewer' reads the diff and judges. 'tester' DRIVES THE APP (Playwright) and
harness/db/schema.sql:322:    -- judges what it observed. The tester guards below apply only to the latter.
harness/db/schema.sql-323-    -- 'reviewer' reads the diff and judges it.
harness/db/schema.sql:324:    -- 'tester'   DROVE the running app (Playwright) and judges what it observed.
harness/db/schema.sql-325-    -- 'verifier' FACT-CHECKS a research answer against its sources.
harness/db/schema.sql-326-    role          TEXT NOT NULL DEFAULT 'reviewer'
harness/db/schema.sql:327:                  CHECK (role IN ('reviewer', 'tester', 'verifier')),
harness/db/schema.sql-328-    -- model family is snapshotted here so §6's "at least two families" rule is
harness/db/schema.sql-329-    -- auditable, and so the no-self-family-testing guard has something to check.
harness/db/schema.sql-330-    model_family  TEXT NOT NULL,
harness/db/schema.sql-331-    -- WHAT, exactly, did this reviewer look at? Snapshotted at write time. A verdict
harness/db/schema.sql-332-    -- whose version no longer matches the job's head_version is history, not
