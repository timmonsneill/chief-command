   200	def run_job(job_id: int, *, cfg: dict[str, Any] | None = None) -> dict[str, Any]:
   201	    """Take one recorded job and actually do it. Safe to call in a thread.
   202	
   203	    Opens its own database connection (sqlite + threads). WAL mode lets this write
   204	    while the web server reads. Never raises to the caller — a worker that dies must
   205	    leave a legible 'failed' row, not a stack trace nobody sees.
   206	    """
   207	    conn = connect(DB_PATH)
   208	    try:
   209	        job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   210	        if job is None:
   211	            return {"job_id": job_id, "status": "missing"}
   212	        seat_row = seat(conn, job["builder_seat"])
   213	        if seat_row is None:
   214	            set_status(conn, job_id, "failed", error=f"unknown seat {job['builder_seat']}")
   215	            return {"job_id": job_id, "status": "failed"}
   216	
   217	        builder = _BUILDERS.get(seat_row["provider"])
   218	        if builder is None:
   219	            # A provider we don't have a local runner for (codex/xai/claude-cli builds
   220	            # go through OpenClaw, not this in-process worker). Say so plainly.
   221	            set_status(conn, job_id, "failed",
   222	                       error=f"no in-process builder for provider '{seat_row['provider']}' "
   223	                             "— this seat dispatches through OpenClaw")
   224	            _event(conn, job_id, seat_row, "error",
   225	                   "This worker only runs the local model directly.")
   226	            return {"job_id": job_id, "status": "failed"}
   227	
   228	        # 1. Isolate.
   229	        wt, wt_note = _make_worktree(job_id, job["branch"] or f"job/{job_id}")
   230	        conn.execute("UPDATE jobs SET worktree = ? WHERE id = ?", (str(wt), job_id))
   231	        _event(conn, job_id, seat_row, "dispatched", f"Working in its own copy ({wt_note}).")
   232	
   233	        # 2. Build.
   234	        model = job["tier"] and _model_for(seat_row, job["tier"]) or seat_row["model"]
   235	        _event(conn, job_id, seat_row, "thinking", "Working out how to do it.")
   236	        try:
   237	            result = builder(seat_row, job["request"], model)
   238	        except Exception as exc:  # network, model, timeout — all land here
   239	            set_status(conn, job_id, "failed", error=f"builder error: {exc}")
   240	            _event(conn, job_id, seat_row, "error", "The worker hit a problem.")
   241	            return {"job_id": job_id, "status": "failed"}
   242	
   243	        # 3. Land the output in the isolated copy, and version it.
   244	        out_dir = wt / OUTPUT_DIRNAME
   245	        out_dir.mkdir(parents=True, exist_ok=True)
   246	        (out_dir / f"job_{job_id}.txt").write_text(result)
   247	        branch = job["branch"] or f"job/{job_id}"
   248	        version = _commit_in_worktree(wt, job_id, branch, job["request"]) or _version_of(result)
   249	        set_head_version(conn, job_id, version)
   250	        _event(conn, job_id, seat_row, "write",
   251	               f"Wrote {len(result)} characters of work.", target=str(out_dir))
   252	
   253	        # 4. Park for review. The guards will hold it here until a real reviewer passes
   254	        #    THIS version — we never force it past them.
   255	        set_status(conn, job_id, "review", result=result)
   256	
   257	        # 5. Hand the frozen bundle to the review panel — several families at once,
   258	        #    all bound to THIS version. The panel decides nothing the database wouldn't;
   259	        #    it produces the verdicts the guards ask for. Without a config there is no
   260	        #    panel, and the job simply stays parked (the safe outcome, not a shortcut).
   261	        if cfg is not None:
   262	            import gauntlet
   263	            panel = gauntlet.run_panel(conn, job_id, job["request"], result, version,
   264	                                       cfg, db_path=DB_PATH)
   265	            if panel.certified:
   266	                _after_certification(conn, job_id, cfg)
