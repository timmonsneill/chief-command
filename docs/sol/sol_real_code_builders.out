   462	def run_panel(
   463	    conn,
   464	    job_id: int,
   465	    request: str,
   466	    code: str,
   467	    version: str,
   468	    cfg: dict[str, Any],
   469	    *,
   470	    roster: list[str] | None = None,
   471	    db_path: Path | None = None,
   472	) -> PanelResult:
   473	    """Run the whole panel in parallel against one frozen bundle, then decide.
   474	
   475	    `conn` is the caller's connection, used only for the final decision. Each reviewer
   476	    gets its own. Returns what actually happened — including who didn't run and why.
   477	    """
   478	    import dispatch                      # local: dispatch imports this module
   479	
   480	    gauntlet = cfg.get("gauntlet", {})
   481	    # Ask the SAME question dispatch asked when it stamped the panel size on the job:
   482	    # who can actually sit? Falling back to the raw config list would put the panel and
   483	    # the job's own requirements at odds — the job needing 2 seats while the panel tried
   484	    # 3, one of which cannot run.
   485	    roster = roster if roster is not None else dispatch.panel_roster(conn, cfg)[0]
   486	    floor = int(gauntlet.get("min_model_families", 0))
   487	    db_path = db_path or DB_PATH
   488	
   489	    built_by = conn.execute("SELECT builder_family FROM jobs WHERE id = ?",
   490	                            (job_id,)).fetchone()
   491	    result = PanelResult(job_id=job_id, version=version, required_families=floor,
   492	                         builder_family=(built_by["builder_family"] if built_by else "") or "")
   493	
   494	    # A floor of zero is not "no requirement" — it is an UNCONFIGURED panel, and
   495	    # `0 < 0` is False, so every later check would wave it through and certify work
   496	    # nobody looked at. dispatch refuses this at the door; refuse it here too, because
   497	    # this function is reachable from anywhere and must not depend on its caller having
   498	    # been careful. Same for an empty roster: nobody to ask is not everybody agreeing.
   499	    if floor < 1 or not roster:
   500	        result.parked_reason = (
   501	            "no review panel is configured for this job — nothing would have checked it"
   502	        )
   503	        return result
   504	
   505	    result.runs = [ReviewerRun(seat_id=s) for s in roster]
   506	    decided = threading.Event()
   507	
   508	    threads = [
   509	        threading.Thread(
   510	            target=_review_one,
   511	            args=(job_id, run.seat_id, request, code, version, cfg, run, db_path,
   512	                  decided),
   513	            name=f"review-{job_id}-{run.seat_id}", daemon=True,
   514	        )
   515	        for run in result.runs
   516	    ]
   517	    for t in threads:
   518	        t.start()
   519	    for t in threads:
   520	        t.join(timeout=REVIEW_TIMEOUT_S + JOIN_GRACE_S)
   521	
   522	    # Close the door BEFORE reading any results. A reviewer still running has not
   523	    # answered, and must not be able to answer into a decision already made — the
   524	    # completion guards only fire on the way INTO done, so a late objection could never
   525	    # stop anything. It is recorded as not having participated, which is the truth.
   526	    decided.set()
   527	    for t, run in zip(threads, result.runs):
   528	        if t.is_alive() and not run.ran:
   529	            run.skipped = run.skipped or "that reviewer never answered"
   530	
   531	    # ── The decision. Every branch below ends in "leave it parked" except one. ──
   532	    if result.failed:
   533	        result.parked_reason = "a reviewer failed this version"
   534	        return result
   535	
   536	    families = result.families_passed
   537	    if len(families) < floor:
   538	        ran = len([r for r in result.runs if r.ran])
   539	        result.parked_reason = (
   540	            f"only {len(families)} model famil{'y' if len(families) == 1 else 'ies'} "

