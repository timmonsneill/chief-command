   330	
   331	_MERGE_LOCK = threading.Lock()          # two merges racing share one git index
   332	
   333	
   334	def _job_exists(conn, job_id: int) -> bool:
   335	    return conn.execute("SELECT 1 FROM jobs WHERE id = ?", (job_id,)).fetchone() is not None
   336	
   337	
   338	def _plain(exc: Exception) -> str:
   339	    """A schema refusal, with the machine word taken off the front."""
   340	    return str(exc).replace("guard: ", "").strip() or "the record wouldn't accept it"
   341	
   342	
   343	def _branch_tip(branch: str) -> str | None:
   344	    """The commit a BRANCH points at — refs/heads/ so nothing else can be meant."""
   345	    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}"],
   346	                         cwd=REPO, capture_output=True, text=True)
   347	    return out.stdout.strip() or None if out.returncode == 0 else None
   348	
   349	
   350	def _same_commit(tip: str, version: str) -> bool:
   351	    """Is the reviewed version this exact commit?
   352	
   353	    `head_version` is a short id, so compare on the shorter length. A version that is
   354	    not a commit id at all (the local worker records a content hash) can never match,
   355	    which is correct: if we cannot prove the reviewed thing is this code, we do not
   356	    merge it.
   357	    """
   358	    version = (version or "").strip().lower()
   359	    tip = (tip or "").strip().lower()
   360	    if len(version) < 7 or not re.fullmatch(r"[0-9a-f]+", version):
   361	        return False
   362	    return tip.startswith(version)
   363	
   364	
   365	REVIEWED_FILE = "chief_output/job_{job_id}.txt"     # where executor.py commits the work
   366	
   367	
   368	def _commit_holds_the_reviewed_work(commit: str, job_id: int, reviewed: str | None) -> bool:
   369	    """Is the text the panel reviewed present, unchanged, in this exact commit?"""
   370	    if reviewed is None:
   371	        return False
   372	    out = subprocess.run(["git", "show", f"{commit}:{REVIEWED_FILE.format(job_id=job_id)}"],
   373	                         cwd=REPO, capture_output=True, text=True)
   374	    return out.returncode == 0 and out.stdout == reviewed
   375	
   376	
   377	def _unreviewed_files_in(commit: str, job_id: int) -> list[str]:
   378	    """Every path the branch changes relative to main, except the one reviewed file."""
   379	    base = subprocess.run(["git", "merge-base", MERGE_INTO, commit], cwd=REPO,
   380	                          capture_output=True, text=True)
   381	    if base.returncode != 0 or not base.stdout.strip():
   382	        return ["<no common history with main>"]
   383	    diff = subprocess.run(["git", "diff", "--name-only", f"{base.stdout.strip()}..{commit}"],
   384	                          cwd=REPO, capture_output=True, text=True)
   385	    if diff.returncode != 0:
   386	        return ["<could not list the branch's changes>"]
   387	    allowed = REVIEWED_FILE.format(job_id=job_id)
   388	    return sorted(p for p in diff.stdout.splitlines() if p.strip() and p.strip() != allowed)
   389	
   390	
   391	def _repo_is_ready() -> bool:
   392	    """On the branch we merge into, with nothing half-done in the folder.
   393	
   394	    Merging into a detached HEAD orphans the result; merging over the owner's own
   395	    uncommitted work risks losing it when a failed merge is aborted.
   396	    """
   397	    head = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
   398	                          cwd=REPO, capture_output=True, text=True)
   399	    if head.returncode != 0 or head.stdout.strip() != MERGE_INTO:
   400	        return False
   401	    dirty = subprocess.run(["git", "status", "--porcelain"],
   402	                           cwd=REPO, capture_output=True, text=True)
   403	    return dirty.returncode == 0 and not dirty.stdout.strip()
   404	
   405	
   406	def _git_merge(commit: str) -> str | None:
   407	    """Merge one exact commit. Takes a SHA, not a ref, on purpose."""
   408	    try:
   409	        proc = subprocess.run(["git", "merge", "--no-ff", "--no-edit", commit],
   410	                              cwd=REPO, capture_output=True, text=True, timeout=120)
   411	    except subprocess.TimeoutExpired:
   412	        _abort_any_merge()
   413	        return None
   414	    if proc.returncode != 0:
   415	        # Leave nothing half-merged behind. A conflicted tree that nobody is looking at
   416	        # is worse than a refusal.
   417	        _abort_any_merge()
   418	        return None
   419	    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=REPO,
   420	                          capture_output=True, text=True)
   421	    return head.stdout.strip()[:12] or None
   422	
   423	
   424	def _main_tip() -> str | None:
   425	    out = subprocess.run(["git", "rev-parse", "--verify", f"refs/heads/{MERGE_INTO}^{{commit}}"],
   426	                         cwd=REPO, capture_output=True, text=True)
   427	    return out.stdout.strip() or None if out.returncode == 0 else None
   428	
   429	
   430	def _reset_main_to(commit: str | None) -> None:
   431	    """Undo a merge whose record failed to commit. Only ever called with the tip that
   432	    was captured moments earlier under the merge lock, on a tree verified clean."""
   433	    if commit:
   434	        subprocess.run(["git", "reset", "--hard", commit], cwd=REPO, capture_output=True)
   435	
   436	
   437	def _abort_any_merge() -> None:
   438	    """Undo a half-finished merge — and ONLY a half-finished merge.
   439	
   440	    `git merge --abort` is `git reset --merge` underneath, which will discard the
   441	    owner's uncommitted work if no merge is actually in progress. Check first.
   442	    """
   443	    if (REPO / ".git" / "MERGE_HEAD").exists():
   444	        subprocess.run(["git", "merge", "--abort"], cwd=REPO, capture_output=True)
   445	
   446	
   447	# ---------------------------------------------------------------------------
   448	# DEPLOY — something reaches the world
   449	# ---------------------------------------------------------------------------
   450	def deploy(conn, target: str, *, job_id: int | None = None,
   451	           asked_by: str = "unknown") -> Receipt:
   452	    """Deploy — ONLY on a live, unused, read-back owner approval naming this target.
   453	
   454	    Decision D keeps Neill in the path for production deploys, and this is the only
   455	    place in the harness where an agent's request is not enough on its own. There is
   456	    deliberately no "the reviewers all agreed" route here: reviewers judge code, and a
   457	    deploy is a decision about the business.
   458	    """
   459	    target = _clean(target)
   460	    approval = conn.execute(
   461	        "SELECT * FROM live_approvals WHERE capability = 'deploy' AND action = ? "
   462	        "ORDER BY id DESC LIMIT 1", (target,),
   463	    ).fetchone()
   464	    if approval is None:
   465	        raise _refuse(conn, job_id,
   466	                      f"nothing has been approved for deploying {target} — "
   467	                      "that needs your say-so, tapped, not spoken",
   468	                      verb="deploy", subject=target, asked_by=asked_by)
   469	    # An approval granted about ONE job does not authorize the same words claimed under
   470	    # another. Without this, a yes given in the context of job 4 travels to job 99.
   471	    if approval["job_id"] is not None and approval["job_id"] != job_id:
   472	        raise _refuse(conn, job_id,
   473	                      "that approval was for a different piece of work",
   474	                      verb="deploy", subject=target, asked_by=asked_by)
   475	    if not approval["reversible"] and not (approval["recovery"] or "").strip():
   476	        raise _refuse(conn, job_id,
   477	                      "that deploy can't be undone and there's no written way back",
   478	                      verb="deploy", subject=target, asked_by=asked_by)
   479	
   480	    # No mechanism, no deploy — and above all no CONSUMED approval. Burning the owner's
   481	    # one-time yes on a verb that then does nothing would make him grant it twice for
   482	    # one deploy. The mechanism, when built, registers here and runs BEHIND the gate.
   483	    deployer = DEPLOYERS.get(target)
   484	    if deployer is None:
   485	        raise _refuse(conn, job_id,
   486	                      f"there's no way to deploy {target} built yet — your approval "
   487	                      "was not used up",
   488	                      verb="deploy", subject=target, asked_by=asked_by)
   489	
   490	    # Spend the approval FIRST. If the deploy dies halfway, the slip is still used —
   491	    # a retry must come back for a fresh yes rather than replay an old one. Two callers
   492	    # racing: SQLite serializes the writes and the single-use guard refuses the loser,
   493	    # which arrives here as a plain refusal rather than a crash.
   494	    try:
   495	        cur = conn.execute(
   496	            "UPDATE approvals SET used_at = datetime('now') "
   497	            " WHERE id = ? AND used_at IS NULL AND revoked_at IS NULL "
   498	            "   AND expires_at > datetime('now')",           # re-checked AT consumption
   499	            (approval["id"],))
   500	    except sqlite3.IntegrityError as exc:
   501	        raise _refuse(conn, job_id, "that approval has already been used",
   502	                      verb="deploy", subject=target, asked_by=asked_by) from exc
   503	    if cur.rowcount != 1:
   504	        raise _refuse(conn, job_id, "that approval was withdrawn or ran out just now",
   505	                      verb="deploy", subject=target, asked_by=asked_by)
   506	
   507	    try:
   508	        reference = str(deployer(target) or "")
   509	    except Exception as exc:  # noqa: BLE001 — a failed deploy is a refusal, said aloud
   510	        raise _refuse(conn, job_id, f"the deploy of {target} didn't go through: "
   511	                      f"{_clean(str(exc), 160)} — it needs a fresh approval to retry",
   512	                      verb="deploy", subject=target, asked_by=asked_by) from exc
   513	
   514	    detail = f"deployed {target} on your approval"
   515	    _note(conn, job_id, f"Deployed {target}, on your approval. "
   516	                        f"Asked for by {_clean(asked_by)}.", kind="done")
   517	    _log(conn, "deploy", target, True, detail, asked_by, job_id)
   518	    return Receipt(verb="deploy", subject=target, detail=detail,
   519	                   reference=reference or str(approval["id"]))
   520	
   521	
   522	# What actually performs a deploy, by target. EMPTY on purpose: nothing in the harness
   523	# can deploy anything yet. When something can, it registers here — behind the gate, so
   524	# that the owner's approval is the only thing that can start it.
   525	DEPLOYERS: dict[str, Callable[[str], str | None]] = {}
   526	
   527	
   528	# ---------------------------------------------------------------------------
   529	# SPEND — real money leaves the account
   530	# ---------------------------------------------------------------------------
   531	def spend(conn, seat_id: str, cents: int, *, job_id: int | None = None,
   532	          role: str = "build", asked_by: str = "unknown") -> Receipt:
   533	    """Reserve money BEFORE the provider is called, or refuse.
   534	
   535	    Sol: refusing to RECORD a charge doesn't unspend it. So the ledger is written first
   536	    and the call happens after. The daily and monthly caps live in the schema, which is
   537	    what makes this a reservation rather than a note — two agents reserving at the same
   538	    instant both hit the ledger, and the ledger refuses the one that breaches.
   539	
   540	    ⚠️ THERE IS NO RECONCILIATION YET. A reservation is an ESTIMATE, and if the real
   541	    call costs less, or never happens at all, the estimate stands against the cap
   542	    permanently. That is deliberate for now (erring toward over-counting spend is the
   543	    safe direction) but it is not the same thing as accurate accounting, and this
   544	    docstring said otherwise until the cross-model review called it.
   545	    """
   546	    if cents < 0:
   547	        raise _refuse(conn, job_id, "a charge can't be negative",
   548	                      verb="spend", subject=seat_id, asked_by=asked_by)
   549	    row = seat(conn, seat_id)
   550	    if row is None:
   551	        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
   552	                      verb="spend", subject=seat_id, asked_by=asked_by)
   553	    # A metered seat costs money every call. "Reserve zero, then make the call" would
   554	    # walk every cap — daily, role, monthly — without any of them moving.
   555	    if cents == 0 and row["tier"] == "metered":
   556	        raise _refuse(conn, job_id, "a paid worker can't reserve nothing — "
   557	                      "say what the call will cost",
   558	                      verb="spend", subject=seat_id, asked_by=asked_by)
   559	    # The caps are keyed BY ROLE, so a role nobody validated is a cap nobody enforces —
   560	    # 'research' would sail past both the build ration and the review ration.
   561	    if role not in SPEND_ROLES:
   562	        raise _refuse(conn, job_id, f"'{role}' isn't a kind of work money can be spent on",
   563	                      verb="spend", subject=seat_id, asked_by=asked_by)
   564	    row = seat(conn, seat_id)
   565	    if row is None:
   566	        raise _refuse(conn, job_id, f"there's no such worker as '{_clean(seat_id, 40)}'",
   567	                      verb="spend", subject=seat_id, asked_by=asked_by)
   568	    if not row["enabled"]:
   569	        raise _refuse(conn, job_id, f"'{seat_id}' is switched off",
   570	                      verb="spend", subject=seat_id, asked_by=asked_by)
   571	
   572	    try:
   573	        record_usage(conn, seat_id, cents, job_id=job_id, role=role)
   574	    except (GuardViolation, sqlite3.IntegrityError) as exc:
   575	        raise _refuse(conn, job_id,
   576	                      "that would go past the spending limit for today",
   577	                      verb="spend", subject=seat_id, asked_by=asked_by) from exc
   578	
   579	    ref = conn.execute("SELECT last_insert_rowid() AS id").fetchone()["id"]
   580	    _log(conn, "spend", seat_id, True, f"{cents}c reserved for {role}", asked_by, job_id)
   581	    return Receipt(verb="spend", subject=seat_id, detail=f"{cents}c reserved for {role}",
   582	                   reference=str(ref))
   583	
   584	
   585	VERBS = {"merge": merge, "deploy": deploy, "spend": spend}
   586	
   587	
   588	# ---------------------------------------------------------------------------
   589	# The service — loopback only, and only these three verbs
   590	# ---------------------------------------------------------------------------
   591	def handle(request: dict[str, Any], *, db_path: Path | None = None) -> dict[str, Any]:
   592	    """One request in, one answer out. The whole surface area of the gatekeeper.
   593	
   594	    An unknown verb is refused without being examined further. This is the check that
   595	    keeps rule 1 true as the file grows.
   596	    """
   597	    verb = request.get("verb")
   598	    if verb not in VERBS:
   599	        return {"ok": False, "error": "the gatekeeper only does three things: "
   600	                                      "merge, deploy, spend"}
   601	
   602	    conn = connect(db_path or DB_PATH)
   603	    try:
   604	        asked_by = str(request.get("asked_by") or "unknown")
   605	        try:
   606	            if verb == "merge":
   607	                r = merge(conn, int(request["job_id"]), asked_by=asked_by)
   608	            elif verb == "deploy":
   609	                r = deploy(conn, str(request["target"]),
   610	                           job_id=_known_job(conn, request.get("job_id")), asked_by=asked_by)
   611	            else:
   612	                r = spend(conn, str(request["seat_id"]), int(request["cents"]),
   613	                          job_id=_known_job(conn, request.get("job_id")),
   614	                          role=str(request.get("role") or "build"), asked_by=asked_by)
   615	        except Refused as exc:
   616	            return {"ok": False, "error": str(exc)}
   617	        except (KeyError, ValueError, TypeError) as exc:
   618	            return {"ok": False, "error": f"that request didn't make sense: {exc}"}
   619	        except sqlite3.Error as exc:
   620	            return {"ok": False, "error": f"the record refused that: {_plain(exc)}"}

