+            elif any(parts[i] == "scripts" and parts[i + 1] == "hooks"
+                     for i in range(len(parts) - 1)):
+                _flag(p, "inside a hooks directory")
             elif new_mode == "120000":
                 _flag(p, "a symlink")
             elif new_mode == "160000":
