     <status>\t<path>` (renames/copies carry a second tab-separated path).
@@ -48,21 +48,30 @@
         fields = meta.split()
         if len(fields) < 5:
             continue
-        old_mode, new_mode, _old_sha, _new_sha, status = fields[:5]
