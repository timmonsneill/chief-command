+        ":000000 100644 0000000 1234567 A\tscripts/hooks/pre-commit.sh",
+        ":000000 100644 0000000 1234567 A\ta/b/scripts/hooks/deep.sh",
+    ]
+    bad = git_policy.disallowed_paths(raw, [])
