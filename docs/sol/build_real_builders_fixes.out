diff --git a/docs/gpt/GPT_TASK_QUEUE.md b/docs/gpt/GPT_TASK_QUEUE.md
index 3ed46b6cf4bbc9ef017ae8f52f656690f585e509..346135a2c77e5b549b81a49e60b235eeb34faa4d
--- a/docs/gpt/GPT_TASK_QUEUE.md
