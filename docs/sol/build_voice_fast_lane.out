+        "model": server._CHIEF_MODEL,
+        "failed": True,
+    })]
+
+    conn = connect(db_path)
+    after = conn.execute("SELECT COUNT(*) AS count FROM events").fetchone()["count"]
+    conn.close()
+    assert after == before
