-              output: JSON.stringify({ answer: out.spoken }) }
-    }));
-    dc.send(JSON.stringify({ type: 'response.create' }));
-    setState('live', 'listening');
+        if (name === 'sentence') {
+          hold.remove();
+          turn('chief', 'Chief', out.text);
+          if (!sawSentence) {
+            sawSentence = true;
+            dc.send(JSON.stringify({
+              type: 'conversation.item.create',
+              item: { type: 'function_call_output', call_id: ev.call_id,
+                      output: JSON.stringify({ answer: out.text }) }
+            }));
+            dc.send(JSON.stringify({ type: 'response.create' }));
+            mouthBusy = true;
+          } else {
+            sentenceQueue.push(out.text);
+            pumpSentenceQueue();
+          }
+        }
+
+        if (name === 'done') {
+          sawDone = true;
+          hold.remove();
+          lastAnswer = out.full || out.spoken;
+          if (out.failed && !sawSentence) {
+            dc.send(JSON.stringify({
+              type: 'conversation.item.create',
+              item: { type: 'function_call_output', call_id: ev.call_id,
+                      output: JSON.stringify({ answer: out.spoken }) }
+            }));
+            dc.send(JSON.stringify({ type: 'response.create' }));
+            mouthBusy = true;
+          }
+          setState('live', 'listening');
+        }
+      };
+
+      while (true) {
+        const {value, done} = await reader.read();
+        buffer += decoder.decode(value || new Uint8Array(), {stream: !done});
+        let cut;
+        while ((cut = buffer.indexOf('\n\n')) !== -1) {
+          takeEvent(buffer.slice(0, cut));
+          buffer = buffer.slice(cut + 2);
+        }
+        if (done) break;
+      }
+      if (buffer.trim()) takeEvent(buffer.trim());
+      if (!sawDone) throw new Error('voice stream ended early');
+    } catch (err) {
+      hold.remove();
+      sentenceQueue.length = 0;
+      dc.send(JSON.stringify({
+        type: 'conversation.item.create',
+        item: { type: 'function_call_output', call_id: ev.call_id,
