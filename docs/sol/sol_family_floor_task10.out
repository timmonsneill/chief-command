    26	SEATS = [
    27	    Seat("grinder_local", "ollama", "qwen2.5-coder:7b", "qwen", "local"),
    28	    Seat("reviewer", "claude-cli", "claude-opus-4-8", "claude", "subscription",
    29	         daily_cap_cents=500),
    30	    Seat("off_seat", "ollama", "qwen2.5-coder:7b", "qwen", "local"),
    31	]
    32	
    33	
    34	@pytest.fixture()
    35	def conn(tmp_path, monkeypatch):
    36	    # Point the executor at the throwaway DB, and never spawn a background thread by
    37	    # default — these tests drive run_job() synchronously where they want it.
    38	    db = tmp_path / "test.db"
    39	    monkeypatch.setattr(executor, "DB_PATH", db)
    40	    monkeypatch.setattr(executor, "WORKTREES", tmp_path / ".worktrees")
    41	    c = connect(db)
    42	    init_db(c)
    43	    for s in SEATS:
    44	        upsert_seat(c, s)
    45	    c.execute("UPDATE seats SET enabled = 0 WHERE id = 'off_seat'")
    46	    return c
