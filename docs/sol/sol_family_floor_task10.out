    57	# ── Recording: nothing runs without a row, and the row says the right things ──
    58	def test_dispatch_records_the_job_before_starting(conn):
    59	    d = dispatch.dispatch_local(conn, "add a helper function", "grinder_local", start=False)
    60	    row = conn.execute("SELECT * FROM jobs WHERE id = ?", (d.job_id,)).fetchone()
    61	    assert row["status"] == "in_progress"
    62	    assert row["required_reviews"] == 1
    63	    assert row["tier"] and row["tier_reason"]          # tiering actually ran
    64	    assert row["branch"] == f"job/{d.job_id}"
    65	    assert d.reused is False
    66	
    67	
    68	# ── Duplicate protection: a retry must not start the same job twice ───────────
    69	def test_a_repeated_dispatch_key_returns_the_same_job(conn):
    70	    first = dispatch.dispatch_local(conn, "build X", "grinder_local",
    71	                                    dispatch_key="abc-123", start=False)
    72	    second = dispatch.dispatch_local(conn, "build X", "grinder_local",
    73	                                     dispatch_key="abc-123", start=False)
    74	    assert second.reused is True
    75	    assert second.job_id == first.job_id
    76	    n = conn.execute("SELECT COUNT(*) c FROM jobs").fetchone()["c"]
    77	    assert n == 1, "the retry started a second job"
