   385	        reply = f"Already on it — {who} picked that up a moment ago."
   386	    else:
   387	        reply = f"{who} is on it. A stronger model will check the work before it's called done."
   388	    return {"job_id": d.job_id, "reused": d.reused, "reply": reply, "builder": builder}
   389	
