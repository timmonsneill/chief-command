     1	"""Sol build gate 3: the review-to-version chain.
     2	
     3	Sol's most dangerous flaw, in his words: approve version A, builder changes it to B,
     4	"the old approval still counts" — producing "believable green checks on code nobody
     5	reviewed." These tests attack the chain the way he would: reuse a stale approval,
     6	outrun a fail by re-completing, rewrite what shipped after the fact.
     7	"""
     8	
     9	import sys
    10	from pathlib import Path
    11	
    12	import pytest
    13	
    14	sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    15	
    16	from db.jobs import (  # noqa: E402
    17	    GuardViolation,
    18	    Seat,
    19	    connect,
    20	    create_job,
    21	    init_db,
    22	    record_artifact,
    23	    record_verdict,
    24	    set_head_version,
    25	    set_status,
    26	    upsert_seat,
    27	)
    28	
    29	SEATS = [
    30	    Seat("riggs", "claude-cli", "claude-opus-4-8", "claude", "subscription"),
    31	    Seat("sol", "codex", "gpt-5.6-sol", "gpt", "subscription"),
    32	    Seat("grok", "xai", "grok-4.5", "grok", "metered"),
    33	    Seat("grinder", "ollama", "qwen2.5-coder:7b", "qwen", "local"),
    34	]
    35	
    36	
    37	@pytest.fixture()
    38	def conn(tmp_path):
    39	    c = connect(tmp_path / "test.db")
    40	    init_db(c)
    41	    for s in SEATS:
    42	        upsert_seat(c, s)
    43	    return c
    44	
    45	
    46	# ── The headline attack: a stale approval must not count ────────────────────
    47	def test_an_approval_of_version_a_does_not_approve_version_b(conn):
    48	    """Sol: 'approve version A, builder changes it to B, the old approval still
    49	    counts.' It must not. The moment the code moves, the green checks go stale."""
    50	    job = create_job(conn, "the auth module", builder_seat="grinder")
    51	    set_head_version(conn, job, "version-A")
    52	    record_verdict(conn, job, "sol", verdict="pass")  # reviews version-A
    53	
    54	    set_head_version(conn, job, "version-B")  # builder quietly changes the code
    55	
    56	    with pytest.raises(GuardViolation, match="review"):
    57	        set_status(conn, job, "done")
    58	
    59	
    60	def test_a_fresh_review_of_the_new_version_completes_it(conn):
    61	    job = create_job(conn, "the auth module", builder_seat="grinder")
    62	    set_head_version(conn, job, "version-A")
    63	    record_verdict(conn, job, "sol", verdict="pass")
    64	    set_head_version(conn, job, "version-B")
    65	    record_verdict(conn, job, "sol", verdict="pass")  # someone actually looked at B
    66	
    67	    set_status(conn, job, "done")
    68	    assert conn.execute("SELECT status FROM jobs WHERE id=?", (job,)).fetchone()[0] == "done"
    69	
    70	
    71	def test_the_full_panel_must_have_reviewed_the_current_version(conn):
    72	    """Three real passes on version A are zero passes on version B."""
    73	    job = create_job(conn, "the login form", builder_seat="riggs")
    74	    conn.execute("UPDATE jobs SET required_reviews=2 WHERE id=?", (job,))
    75	    set_head_version(conn, job, "version-A")
    76	    record_verdict(conn, job, "sol", verdict="pass")
    77	    record_verdict(conn, job, "grok", verdict="pass")
    78	
    79	    set_head_version(conn, job, "version-B")
    80	
    81	    with pytest.raises(GuardViolation, match="panel"):
    82	        set_status(conn, job, "done")
    83	
    84	
    85	# ── A fail condemns a VERSION, not the job forever ──────────────────────────
    86	def test_a_fail_condemns_the_version_it_reviewed_not_the_job(conn):
    87	    """Before gate 3, one fail meant the job could never complete — a fixed build
    88	    could never ship. Now: fail version A, fix it, pass version B, done."""
    89	    job = create_job(conn, "the rate limiter", builder_seat="riggs")
    90	    set_head_version(conn, job, "version-A")
    91	    record_verdict(conn, job, "sol", verdict="fail", severity="p1",
    92	                   summary="blocks our own status checks")
    93	
    94	    set_head_version(conn, job, "version-B")  # the fix
    95	    record_verdict(conn, job, "sol", verdict="pass")
    96	
    97	    set_status(conn, job, "done")
    98	    assert conn.execute("SELECT status FROM jobs WHERE id=?", (job,)).fetchone()[0] == "done"
    99	
   100	
   101	def test_a_fail_on_the_current_version_still_stops_it_dead(conn):
   102	    job = create_job(conn, "the rate limiter", builder_seat="riggs")
   103	    set_head_version(conn, job, "version-A")
   104	    record_verdict(conn, job, "sol", verdict="pass")
   105	    record_verdict(conn, job, "grok", verdict="fail", severity="p1", summary="drops rows")
   106	
   107	    with pytest.raises(GuardViolation, match="does not get outvoted"):
   108	        set_status(conn, job, "done")
   109	
   110	
   111	def test_a_fail_with_no_recorded_version_blocks_everything(conn):
   112	    """Fail-closed: a fail that condemned we-don't-know-what condemns everything.
   113	    (Written straight to the DB to simulate a legacy row — the Python layer always
   114	    records a version on a versioned job.)"""
   115	    job = create_job(conn, "the rate limiter", builder_seat="riggs")
   116	    set_head_version(conn, job, "version-A")
   117	    conn.execute(
   118	        "INSERT INTO verdicts (job_id, reviewer_seat, reviewer_tier, role, "
   119	        "model_family, verdict, reviewed_version) "
   120	        "VALUES (?, 'sol', 'subscription', 'reviewer', 'gpt', 'fail', 'legacy')",
   121	        (job,),
   122	    )
   123	    # Even after "fixing" to a new version, a versionless fail would block; here the
   124	    # fail cites a version, so the fix clears it — but now plant a true NULL one.
   125	    set_head_version(conn, job, "version-B")
   126	    conn.execute("UPDATE jobs SET head_version=NULL WHERE id=?", (job,))
   127	    with pytest.raises(GuardViolation):
   128	        set_status(conn, job, "done")
   129	
   130	
   131	# ── An unanswered question blocks regardless of version ─────────────────────
   132	def test_needs_human_cannot_be_outrun_by_a_new_version(conn):
   133	    """A fail condemns a version. A QUESTION demands an answer — pushing new code
   134	    is not an answer."""
   135	    job = create_job(conn, "the migration", builder_seat="riggs")
   136	    set_head_version(conn, job, "version-A")
   137	    record_verdict(conn, job, "sol", verdict="needs_human",
   138	                   summary="does this drop rows?")
   139	
   140	    set_head_version(conn, job, "version-B")
   141	    record_verdict(conn, job, "sol", verdict="pass")
   142	
   143	    with pytest.raises(GuardViolation, match="needs_human"):
   144	        set_status(conn, job, "done")
   145	
   146	
   147	# ── The record itself resists tampering ─────────────────────────────────────
   148	def test_a_versioned_job_rejects_verdicts_that_name_no_version(conn):
   149	    job = create_job(conn, "the auth module", builder_seat="riggs")
   150	    set_head_version(conn, job, "version-A")
   151	    with pytest.raises(Exception, match="which version"):
   152	        conn.execute(
   153	            "INSERT INTO verdicts (job_id, reviewer_seat, reviewer_tier, role, "
   154	            "model_family, verdict) "
   155	            "VALUES (?, 'sol', 'subscription', 'reviewer', 'gpt', 'pass')",
   156	            (job,),
   157	        )
   158	
   159	
   160	def test_a_build_cannot_finish_without_naming_its_version(conn):
   161	    job = create_job(conn, "the auth module", builder_seat="riggs")
   162	    with pytest.raises(GuardViolation, match="naming the exact version"):
   163	        set_status(conn, job, "done")
   164	
   165	
   166	def test_what_finished_cannot_be_rewritten_afterward(conn):
   167	    """The complement of the stale-approval attack: complete honestly as version A,
   168	    then flip head_version to B so the record claims B was the approved thing."""
   169	    job = create_job(conn, "the auth module", builder_seat="riggs")
   170	    set_head_version(conn, job, "version-A")
   171	    record_verdict(conn, job, "sol", verdict="pass")
   172	    set_status(conn, job, "done")
   173	
   174	    with pytest.raises(GuardViolation, match="cannot be rewritten"):
   175	        set_head_version(conn, job, "version-B")
   176	
   177	
   178	def test_shipping_requires_the_tester_to_have_driven_the_current_version(conn):
   179	    job = create_job(conn, "the login form", builder_seat="riggs")
   180	    set_head_version(conn, job, "version-A")
   181	    record_artifact(conn, job, kind="screenshot", path="/tmp/a.png",
   182	                    captured_by="playwright")
   183	    record_verdict(conn, job, "sol", verdict="pass", role="tester",
   184	                   reviewed_version="version-OLD")  # drove an earlier build
   185	    set_status(conn, job, "done")
   186	
   187	    with pytest.raises(GuardViolation, match="tester"):
   188	        set_status(conn, job, "shipped")

