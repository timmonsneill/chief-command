   301	
   302	CREATE INDEX IF NOT EXISTS idx_jobs_status  ON jobs(status);
   303	CREATE INDEX IF NOT EXISTS idx_jobs_created ON jobs(created_at);
   304	CREATE INDEX IF NOT EXISTS idx_jobs_run     ON jobs(run_id);
   305	CREATE UNIQUE INDEX IF NOT EXISTS idx_jobs_dispatch_key ON jobs(dispatch_key)
   306	    WHERE dispatch_key IS NOT NULL;
   307	
   308	-- ---------------------------------------------------------------------------
   309	-- Verdicts: the gauntlet's output (§6). One row per reviewer per job.
   310	-- reviewer_tier is denormalized at write time so a later seat re-tiering cannot
   311	-- retroactively validate a job that was never properly reviewed.
   312	-- ---------------------------------------------------------------------------
   313	CREATE TABLE IF NOT EXISTS verdicts (
   314	    id            INTEGER PRIMARY KEY,
   315	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   316	    reviewer_seat TEXT NOT NULL REFERENCES seats(id),
   317	    reviewer_tier TEXT NOT NULL CHECK (reviewer_tier IN ('local', 'subscription', 'metered')),
   318	    -- 'reviewer' reads the diff and judges. 'tester' DRIVES THE APP (Playwright) and
   319	    -- judges what it observed. The tester guards below apply only to the latter.
   320	    -- 'reviewer' reads the diff and judges it.
   321	    -- 'tester'   DROVE the running app (Playwright) and judges what it observed.
   322	    -- 'verifier' FACT-CHECKS a research answer against its sources.
   323	    role          TEXT NOT NULL DEFAULT 'reviewer'
   324	                  CHECK (role IN ('reviewer', 'tester', 'verifier')),
   325	    -- model family is snapshotted here so §6's "at least two families" rule is
   326	    -- auditable, and so the no-self-family-testing guard has something to check.
   327	    model_family  TEXT NOT NULL,
   328	    -- WHAT, exactly, did this reviewer look at? Snapshotted at write time. A verdict
   329	    -- whose version no longer matches the job's head_version is history, not
   330	    -- approval — it stops counting the moment the code moves on. This is the other
   331	    -- half of the review-to-version chain.
   332	    reviewed_version TEXT,
   333	    verdict       TEXT NOT NULL CHECK (verdict IN ('pass', 'fail', 'needs_human')),
   334	    severity      TEXT CHECK (severity IN ('p0', 'p1', 'p2', 'p3')),
   335	    summary       TEXT,
   336	    detail        TEXT,
   337	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   338	);
   339	
   340	CREATE INDEX IF NOT EXISTS idx_verdicts_job ON verdicts(job_id);
   341	
   342	-- ═══════════════════════════════════════════════════════════════════════════════
   343	-- CAPABILITIES — what an agent is PHYSICALLY ALLOWED to do.
   344	--
   345	-- This exists because Sol reviewed the architecture and demolished the previous
   346	-- safety story. The plan had been: the voice can act fast, and Chief watches and
   347	-- kills anything dumb. Sol's verdict:
   348	--
   349	--     "'Builders take minutes' measures how long they take to FINISH. What matters
   350	--      is how long they take to do their FIRST DAMAGING THING. That can be seconds.
     1	-- Migration 001 — bring the LIVE database up to the hardened schema.sql
     2	-- Sol build gate 1 (round 7): "migrate the live DB to the hardened rules."
     3	--
     4	-- Found by diffing the live DB against a fresh build of schema.sql on 2026-07-20:
     5	--   1. guard_verdicts_cannot_be_deleted   MISSING — a failing review could be deleted,
     6	--      then the job completed (Sol round 3, verified exploit).
     7	--   2. guard_no_approval_is_born_granted  MISSING — an approval could be inserted
     8	--      pre-granted, skipping the read-back guards (Sol round 3, verified exploit).
     9	--   3. guard_full_panel                   STALE — live version counts any 'pass',
    10	--      so testers/verifiers could fill the reviewer panel (Sol round 2, #5).
    11	--   4. jobs.tier / jobs.tier_reason       MISSING — tiering has nowhere to record.
    12	--   5. seats model_/effort_ tier columns  MISSING — same.
    13	--
    14	-- Additive ALTERs + trigger recreation only. No row is rewritten or re-inserted —
    15	-- replaying history through the guards is exactly what the guards exist to prevent.
    16	-- Backup taken first: harness/db/backups/chief.db.pre-hardening-2026-07-20
    17	
    18	BEGIN;
    19	
    20	ALTER TABLE jobs ADD COLUMN tier TEXT NOT NULL DEFAULT 'standard'
    21	    CHECK (tier IN ('light', 'standard', 'heavy'));
    22	ALTER TABLE jobs ADD COLUMN tier_reason TEXT;
    23	
    24	ALTER TABLE seats ADD COLUMN model_light    TEXT;
    25	ALTER TABLE seats ADD COLUMN model_standard TEXT;
    26	ALTER TABLE seats ADD COLUMN model_heavy    TEXT;
    27	ALTER TABLE seats ADD COLUMN effort_light    TEXT DEFAULT 'low';
    28	ALTER TABLE seats ADD COLUMN effort_standard TEXT DEFAULT 'medium';
    29	ALTER TABLE seats ADD COLUMN effort_heavy    TEXT DEFAULT 'high';
    30	
    31	-- Replace the stale panel guard with the round-2 fix: only role='reviewer' counts.
    32	DROP TRIGGER guard_full_panel;
    33	CREATE TRIGGER guard_full_panel
    34	BEFORE UPDATE OF status ON jobs
    35	WHEN NEW.status = 'done' AND OLD.status <> 'done' AND NEW.required_reviews > 0
    36	BEGIN
    37	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
    38	    WHERE (
    39	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
    40	        -- the panel could be "filled" by the wrong kinds of check entirely.
    41	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
    42	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
    43	    ) < NEW.required_reviews;
    44	END;
    45	
    46	CREATE TRIGGER guard_no_approval_is_born_granted
    47	BEFORE INSERT ON approvals
    48	WHEN NEW.granted_at IS NOT NULL
    49	BEGIN
    50	    SELECT RAISE(ABORT, 'guard: an approval cannot be created already granted — it must be granted through a read-back');
    51	END;
    52	
    53	CREATE TRIGGER guard_verdicts_cannot_be_deleted
    54	BEFORE DELETE ON verdicts
    55	BEGIN
    56	    SELECT RAISE(ABORT, 'guard: a verdict is a fact on the record — it cannot be deleted');
    57	END;
