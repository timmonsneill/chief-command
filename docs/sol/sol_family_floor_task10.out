    59	COMMIT;
     1	-- Migration 002 — the review-to-version chain (Sol build gate 3).
     2	--
     3	-- Sol's most dangerous flaw: approve version A, builder changes it to B, the old
     4	-- approval still counts — "believable green checks on code nobody reviewed."
     5	--
     6	-- Jobs now carry head_version (the exact content hash being put forward); verdicts
     7	-- carry reviewed_version (what the reviewer actually looked at). Completion guards
     8	-- only count verdicts whose version MATCHES, so moving the code voids approvals by
     9	-- construction, and a fail condemns the version it saw instead of the job forever.
    10	--
    11	-- Existing rows keep NULL versions: job 1 shipped before versioning existed (its
    12	-- record is history and stays untouched); job 2 cannot now complete until it gets a
    13	-- version and version-matched reviews — which is correct, nobody reviewed a
    14	-- recorded version of it.
    15	
    16	BEGIN;
    17	
    18	ALTER TABLE jobs ADD COLUMN head_version TEXT;
    19	ALTER TABLE verdicts ADD COLUMN reviewed_version TEXT;
    20	
    21	CREATE TRIGGER guard_verdict_must_cite_what_it_reviewed
    22	BEFORE INSERT ON verdicts
    23	WHEN (SELECT head_version FROM jobs WHERE id = NEW.job_id) IS NOT NULL
    24	     AND TRIM(COALESCE(NEW.reviewed_version, '')) = ''
    25	BEGIN
    26	    SELECT RAISE(ABORT, 'guard: this job is versioned — a verdict must say which version it reviewed');
    27	END;
    28	
    29	CREATE TRIGGER guard_a_build_finishes_a_version
    30	BEFORE UPDATE OF status ON jobs
    31	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
    32	     AND NEW.kind = 'build'
    33	     AND TRIM(COALESCE(NEW.head_version, '')) = ''
    34	BEGIN
    35	    SELECT RAISE(ABORT, 'guard: a build cannot finish without naming the exact version that is finished');
    36	END;
    37	
    38	CREATE TRIGGER guard_finished_version_is_frozen
    39	BEFORE UPDATE OF head_version ON jobs
    40	WHEN OLD.status IN ('done', 'shipped') AND OLD.head_version IS NOT NEW.head_version
    41	BEGIN
    42	    SELECT RAISE(ABORT, 'guard: what version finished cannot be rewritten after the fact');
    43	END;
    44	
    45	-- The five completion guards, rebuilt with version matching. Executable text must
    46	-- stay identical to schema.sql — the drift test compares them.
    47	
    48	DROP TRIGGER guard_local_output_needs_review;
    49	CREATE TRIGGER guard_local_output_needs_review
    50	BEFORE UPDATE OF status ON jobs
    51	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
    52	     AND NEW.builder_tier = 'local'
    53	BEGIN
    54	    SELECT RAISE(ABORT, 'guard: local-built job requires a passing subscription-tier review before done')
    55	    WHERE NOT EXISTS (
    56	        SELECT 1 FROM verdicts v
    57	        WHERE v.job_id = NEW.id
    58	          AND v.reviewer_tier IN ('subscription', 'metered')
    59	          AND v.verdict = 'pass'
    60	          -- gate 3: a pass only counts for the version it actually reviewed
    61	          AND v.reviewed_version IS NEW.head_version
    62	    );
    63	END;
    64	
    65	DROP TRIGGER guard_full_panel;
    66	CREATE TRIGGER guard_full_panel
    67	BEFORE UPDATE OF status ON jobs
    68	WHEN NEW.status = 'done' AND OLD.status <> 'done' AND NEW.required_reviews > 0
    69	BEGIN
    70	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
    71	    WHERE (
    72	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
    73	        -- the panel could be "filled" by the wrong kinds of check entirely.
    74	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
    75	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
    76	          -- gate 3: the panel must have reviewed THIS version, not an earlier one
    77	          AND v.reviewed_version IS NEW.head_version
    78	    ) < NEW.required_reviews;
    79	END;
    80	
    81	DROP TRIGGER guard_a_failing_review_stops_it;
    82	CREATE TRIGGER guard_a_failing_review_stops_it
    83	BEFORE UPDATE OF status ON jobs
    84	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
    85	BEGIN
    86	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
    87	    WHERE EXISTS (
    88	        SELECT 1 FROM verdicts v
    89	        WHERE v.job_id = NEW.id AND v.verdict = 'fail'
    90	          -- gate 3: a fail condemns the VERSION it reviewed, not the job forever.
    91	          -- A fail with no version condemned we-don't-know-what: it blocks
    92	          -- everything. Same if the job itself is unversioned. Fail-closed.
    93	          AND (NEW.head_version IS NULL
    94	               OR v.reviewed_version IS NULL
    95	               OR v.reviewed_version = NEW.head_version)
    96	    );
    97	END;
    98	
    99	DROP TRIGGER guard_late_escalation_still_blocks_shipping;
   100	CREATE TRIGGER guard_late_escalation_still_blocks_shipping
   101	BEFORE UPDATE OF status ON jobs
   102	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   103	BEGIN
   104	    SELECT RAISE(ABORT, 'guard: someone raised an objection — it has to be answered first')
   105	    WHERE EXISTS (
   106	        SELECT 1 FROM verdicts v
   107	        WHERE v.job_id = NEW.id
   108	          AND (v.verdict = 'needs_human'  -- an unanswered question blocks, always
   109	               -- gate 3: a fail blocks the version it condemned (fail-closed when
   110	               -- either side is unversioned)
   111	               OR (v.verdict = 'fail'
   112	                   AND (NEW.head_version IS NULL
   113	                        OR v.reviewed_version IS NULL
   114	                        OR v.reviewed_version = NEW.head_version)))
   115	    );
   116	END;
   117	
   118	DROP TRIGGER guard_ship_requires_a_passing_tester;
   119	CREATE TRIGGER guard_ship_requires_a_passing_tester
   120	BEFORE UPDATE OF status ON jobs
   121	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   122	BEGIN
   123	    SELECT RAISE(ABORT, 'guard: nothing ships without a passing cross-family tester on the record')
   124	    WHERE OLD.status <> 'done'
   125	       OR NOT EXISTS (
   126	           SELECT 1 FROM verdicts v
   127	           WHERE v.job_id = NEW.id AND v.role = 'tester' AND v.verdict = 'pass'
   128	             -- gate 3: the tester must have driven THIS version of the app
   129	             AND v.reviewed_version IS NEW.head_version
   130	       );
   131	END;
   132	
   133	COMMIT;
