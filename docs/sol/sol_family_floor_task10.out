    86	# ── Refusals: the store says no before any work is done ───────────────────────
    87	def test_unknown_seat_is_refused(conn):
    88	    with pytest.raises(dispatch.DispatchRefused, match="unknown seat"):
    89	        dispatch.dispatch_local(conn, "build X", "nobody", start=False)
