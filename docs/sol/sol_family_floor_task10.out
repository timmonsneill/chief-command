     1	-- Migration 003 — duplicate protection for dispatch (task #9).
     2	--
     3	-- A retry must not start the same job twice: a double-tap on the send button, a
     4	-- dropped connection that the client re-sends, the voice re-forwarding. The caller
     5	-- stamps a dispatch_key; a second dispatch with the same key returns the existing
     6	-- job. The partial unique index lets unkeyed jobs (NULL) coexist freely while
     7	-- forbidding two rows from sharing a real key.
     8	
     9	BEGIN;
    10	
    11	ALTER TABLE jobs ADD COLUMN dispatch_key TEXT;
    12	
    13	CREATE UNIQUE INDEX IF NOT EXISTS idx_jobs_dispatch_key ON jobs(dispatch_key)
    14	    WHERE dispatch_key IS NOT NULL;
    15	
    16	COMMIT;
     1	-- Migration 004 — todos + attachments for the command center (tasks #15, #16).
     2	--
     3	-- Todos that belong to a PROJECT (so they stop jumping window to window), grouped
     4	-- into free-form sections the owner names himself ("Now", "Later", "Post-launch").
     5	-- Attachments so images and files can be pinned to a project or a job.
     6	
     7	BEGIN;
     8	
     9	CREATE TABLE IF NOT EXISTS todos (
    10	    id            INTEGER PRIMARY KEY,
    11	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
    12	    section       TEXT,
    13	    text          TEXT NOT NULL,
    14	    done          INTEGER NOT NULL DEFAULT 0 CHECK (done IN (0, 1)),
    15	    owner_only    INTEGER NOT NULL DEFAULT 0 CHECK (owner_only IN (0, 1)),
    16	    position      INTEGER NOT NULL DEFAULT 0,
    17	    created_at    TEXT NOT NULL DEFAULT (datetime('now')),
    18	    done_at       TEXT
    19	);
    20	
    21	CREATE INDEX IF NOT EXISTS idx_todos_project ON todos(project_id, section, position, id);
    22	
    23	CREATE TABLE IF NOT EXISTS attachments (
    24	    id            INTEGER PRIMARY KEY,
    25	    project_id    TEXT REFERENCES projects(id) ON DELETE SET NULL,
    26	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
    27	    filename      TEXT NOT NULL,
    28	    stored_path   TEXT NOT NULL,
    29	    kind          TEXT NOT NULL CHECK (kind IN ('image', 'file')),
    30	    size_bytes    INTEGER,
    31	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
    32	);
    33	
    34	CREATE INDEX IF NOT EXISTS idx_attachments_project ON attachments(project_id);
    35	CREATE INDEX IF NOT EXISTS idx_attachments_job ON attachments(job_id);
    36	
    37	COMMIT;
