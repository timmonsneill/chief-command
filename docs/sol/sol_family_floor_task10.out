   222	def test_the_same_family_may_still_REVIEW_its_own_build(conn):
   223	    """The no-self-testing rule is about DRIVING THE APP, not reading a diff.
   224	
   225	    A same-family reviewer is a weaker signal, but it isn't forbidden — the gauntlet's
   226	    min_model_families rule handles diversity there. Only the tester seat is hard-gated.
   227	    """
   228	    upsert_seat(conn, Seat("claude_builder", "claude-cli", "claude-opus-4-8", "claude", "subscription"))
   229	    job = create_job(conn, "add the login form", builder_seat="claude_builder")
   230	    set_head_version(conn, job, "abc123")
   231	    record_verdict(conn, job, "reviewer", verdict="pass", role="reviewer")  # claude reviewing claude
   232	    set_status(conn, job, "done")
   233	    assert conn.execute("SELECT status FROM jobs WHERE id = ?", (job,)).fetchone()["status"] == "done"
