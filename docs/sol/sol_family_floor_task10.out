     1	"""Dispatch + executor: the spine that makes assigned work actually start (task #9).
     2	
     3	The recording/dedup/refusal tests run anywhere. The end-to-end test needs the local
     4	Ollama model actually serving, so it skips cleanly when that isn't available.
     5	"""
     6	
     7	import sys
     8	import urllib.request
     9	from pathlib import Path
    10	
    11	import pytest
    12	
    13	sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
