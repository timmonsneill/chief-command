    97	# ── End to end: the local model actually runs and lands real work ─────────────
    98	@pytest.mark.skipif(not _ollama_up(), reason="local Ollama model not serving")
    99	def test_the_local_worker_actually_produces_and_parks_for_review(conn):
   100	    task = ("Write a Python function `add(a, b)` that returns their sum. "
   101	            "Return ONLY the code.")
   102	    d = dispatch.dispatch_local(conn, task, "grinder_local", start=False)
   103	
   104	    result = executor.run_job(d.job_id)          # synchronous; no reviewer wired
   105	    assert result["status"] == "review", "local output should park for review"
   106	
   107	    row = conn.execute("SELECT * FROM jobs WHERE id = ?", (d.job_id,)).fetchone()
   108	    assert row["head_version"], "the produced version was not recorded"
   109	    assert row["result"] and len(row["result"]) > 0, "no real output landed"
   110	    assert row["worktree"], "no isolated worktree was recorded"
   111	    assert Path(row["worktree"]).exists(), "the worktree does not exist on disk"
   112	
   113	    events = conn.execute(
   114	        "SELECT kind FROM events WHERE job_id = ? ORDER BY id", (d.job_id,)
   115	    ).fetchall()
   116	    kinds = [e["kind"] for e in events]
   117	    assert "dispatched" in kinds and "write" in kinds, f"missing event trail: {kinds}"
   118	
   119	    # The safety spine: local output cannot be forced to done without a real review.
   120	    with pytest.raises(GuardViolation):
   121	        set_status(conn, d.job_id, "done")
   122	
   123	    executor.cleanup_worktree(d.job_id)
   210	    job = create_job(conn, "add the login form", builder_seat="claude_builder")
   211	    record_artifact(conn, job, kind="screenshot", path="/tmp/x.png")
   212	
   213	    record_verdict(conn, job, "grok_tester", verdict="fail", role="tester",
   214	                   severity="p2", summary="Validation fires on blur; users expect it on submit.")
   215	
   216	    row = conn.execute(
   217	        "SELECT verdict, model_family FROM verdicts WHERE job_id = ? AND role='tester'", (job,)
   218	    ).fetchone()
   219	    assert row["verdict"] == "fail" and row["model_family"] == "grok"
