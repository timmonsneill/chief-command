    26	def _object_names(conn: sqlite3.Connection, kind: str) -> set[str]:
    27	    rows = conn.execute(
    28	        "SELECT name FROM sqlite_master WHERE type = ? AND name NOT LIKE 'sqlite_%'",
    29	        (kind,),
    30	    )
    31	    return {r[0] for r in rows}
    32	
    33	
    34	def _columns(conn: sqlite3.Connection, table: str) -> set[tuple]:
    35	    # (name, type, notnull, default) — column ORDER is allowed to differ, because
    36	    # ALTER TABLE ADD COLUMN appends and that is how live migrations happen.
    37	    rows = conn.execute(f"PRAGMA table_info({table})")
    38	    return {(r[1], r[2], r[3], r[4]) for r in rows}
    39	
    40	
    41	def _normalized_trigger_sql(conn: sqlite3.Connection) -> dict[str, str]:
    42	    rows = conn.execute("SELECT name, sql FROM sqlite_master WHERE type = 'trigger'")
    43	    # Whitespace and comments may drift between schema.sql and a migration; the
    44	    # executable text must not. Strip comment lines, collapse whitespace.
    45	    out = {}
    46	    for name, sql in rows:
    47	        lines = [
    48	            line.split("--")[0] for line in sql.splitlines()
    49	        ]
    50	        out[name] = " ".join(" ".join(lines).split())
    51	    return out
    52	
