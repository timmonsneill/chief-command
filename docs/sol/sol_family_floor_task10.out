    63	def _version_of(text: str) -> str:
    64	    """The exact content being put forward, as a short hash. This is what the whole
    65	    review-to-version chain binds to: change the output, change the version, and every
    66	    earlier approval silently stops counting (schema.sql, gate 3)."""
    67	    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]
