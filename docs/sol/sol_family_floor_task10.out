   236	# ---------------------------------------------------------------------------
   237	# Guard 6 — a job ships on the GATES, not on a human and not on agent confidence.
   238	#
   239	# Owner override: "I don't want shipped depending on me. If it is reviewed and
   240	# tested, then it ships." Neill is out of the critical path — so the schema now
   315	# benchmark — wrong model entirely. It also said a web-view app can't get
   316	# background mic access — also wrong. Both fluent, both sourced-sounding, both
   317	# false. Neill caught them by pushing back; nothing in the system would have.
   318	#
   319	# A confident wrong answer is worse than no answer, because you ACT on it. Neill
   320	# nearly made a purchasing decision on the first one.
   321	# ---------------------------------------------------------------------------
   322	def _research_job(conn, seat="orchestrator"):
   323	    job = create_job(conn, "Is Grok Build worth buying?", builder_seat=seat,
   324	                     task_name="the Grok question")
   325	    conn.execute("UPDATE jobs SET kind='research' WHERE id=?", (job,))
   326	    return job
   327	
   328	
   329	def test_a_research_answer_without_sources_cannot_land(conn):
   330	    job = _research_job(conn)
   331	    set_status(conn, job, "review", result="Grok scores 70.8%. Not worth it.")
   332	
   333	    with pytest.raises(GuardViolation, match="no source, no answer"):
   334	        set_status(conn, job, "done")
   335	
   336	
   337	def test_a_research_answer_with_sources_can_land(conn):
   338	    job = _research_job(conn)
   339	    record_artifact(conn, job, kind="source", path="https://docs.x.ai/build/overview",
   340	                    captured_by="model")
   341	    set_status(conn, job, "done")
   342	    assert conn.execute("SELECT status FROM jobs WHERE id=?", (job,)).fetchone()["status"] == "done"
   343	
   344	
   345	def test_a_model_may_cite_a_source_but_not_forge_a_screenshot(conn):
   346	    """The asymmetry that makes this work.
   347	
   348	    A researcher's job IS to hand you a URL — it may write one down. But no model
   349	    may claim it took a screenshot, because then 'I ran it and it worked' becomes
   350	    sayable again.
   351	    """
   352	    job = _research_job(conn)
   353	    record_artifact(conn, job, kind="source", path="https://x.ai", captured_by="model")
   354	
   355	    with pytest.raises(ValueError, match="may not produce a 'screenshot'"):
   356	        record_artifact(conn, job, kind="screenshot", path="/tmp/fake.png", captured_by="model")
   357	
