    17	from typing import Any, Iterable, Optional
    18	
    19	DB_PATH = Path(__file__).resolve().parent / "chief.db"
    20	SCHEMA_PATH = Path(__file__).resolve().parent / "schema.sql"
    21	
    22	# Raised by the schema triggers. We surface it as something catchable.
    23	class GuardViolation(RuntimeError):
    24	    """A structural rule was violated (e.g. shipping unreviewed local output)."""
    25	
    26	
    27	@dataclass(frozen=True)
    28	class Seat:
    29	    id: str
    30	    provider: str
    31	    model: str
    32	    family: str  # gpt | claude | grok | qwen — what determines shared blind spots
    33	    tier: str  # local | subscription | metered
    34	    daily_cap_cents: Optional[int] = None   # hard ceiling across everything
    35	    build_cap_cents: Optional[int] = None   # ration the EXPENSIVE work
    36	    review_cap_cents: Optional[int] = None  # reviewing is cheap — be generous
    37	    # Three models per seat. NOTHING gets `heavy` by default — it has to be earned.
    38	    # Rate limits, not money, are the binding constraint on autonomous work, and you
    39	    # cannot buy your way out of a weekly cap.
    40	    model_light: Optional[str] = None
    41	    model_standard: Optional[str] = None
    42	    model_heavy: Optional[str] = None
    43	    enabled: bool = True
    44	    notes: str = ""
    45	
    46	
    47	def connect(db_path: Path | str = DB_PATH) -> sqlite3.Connection:
    48	    conn = sqlite3.connect(db_path, isolation_level=None)  # autocommit; we manage txns
    49	    conn.row_factory = sqlite3.Row
    50	    conn.execute("PRAGMA foreign_keys = ON")
    51	    return conn
    52	
    53	
    54	def init_db(conn: sqlite3.Connection) -> None:
    55	    conn.executescript(SCHEMA_PATH.read_text())
    56	
    57	
    58	def _guarded(fn):
    59	    """Translate the schema's RAISE(ABORT, 'guard: ...') into GuardViolation."""
    60	
    61	    def wrapper(*args, **kwargs):
    62	        try:
    63	            return fn(*args, **kwargs)
    64	        except sqlite3.IntegrityError as exc:
    65	            if "guard:" in str(exc):
    66	                raise GuardViolation(str(exc)) from exc
    67	            raise
    68	
    69	    return wrapper
    70	
    71	
    72	# --------------------------------------------------------------------------
    73	# Seats
    74	# --------------------------------------------------------------------------
    75	def upsert_seat(conn: sqlite3.Connection, seat: Seat) -> None:
    76	    conn.execute(
    77	        """
    78	        INSERT INTO seats (id, provider, model, family, tier, daily_cap_cents,
    79	                           build_cap_cents, review_cap_cents,
    80	                           model_light, model_standard, model_heavy, enabled, notes)
    81	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    82	        ON CONFLICT(id) DO UPDATE SET
    83	            provider = excluded.provider,
    84	            model = excluded.model,
    85	            family = excluded.family,
    86	            tier = excluded.tier,
    87	            daily_cap_cents = excluded.daily_cap_cents,
    88	            build_cap_cents = excluded.build_cap_cents,
    89	            review_cap_cents = excluded.review_cap_cents,
    90	            model_light = excluded.model_light,
    91	            model_standard = excluded.model_standard,
    92	            model_heavy = excluded.model_heavy,
    93	            enabled = excluded.enabled,
    94	            notes = excluded.notes
    95	        """,
    96	        (seat.id, seat.provider, seat.model, seat.family, seat.tier,
    97	         seat.daily_cap_cents, seat.build_cap_cents, seat.review_cap_cents,
    98	         seat.model_light, seat.model_standard, seat.model_heavy,
    99	         int(seat.enabled), seat.notes),
   100	    )
   101	
   102	
   103	def seat(conn: sqlite3.Connection, seat_id: str) -> sqlite3.Row | None:
   104	    return conn.execute("SELECT * FROM seats WHERE id = ?", (seat_id,)).fetchone()
   105	
   106	
   107	# --------------------------------------------------------------------------
   108	# Jobs
   109	# --------------------------------------------------------------------------
   110	def create_job(
   111	    conn: sqlite3.Connection,
   112	    request: str,
   113	    builder_seat: str,
   114	    origin: str = "text",
   115	    parent_job_id: Optional[int] = None,
   116	    task_name: Optional[str] = None,
   117	) -> int:
   118	    """task_name is the 2-4 word handle the voice will use ("the rate limiter").
   119	
   120	    The mouth coins it at dispatch. Without one the voice falls back to truncating
   121	    the request, which reads back the owner's own paragraph at him — exactly what a
   122	    colleague would never do.
   123	    """
   124	    row = seat(conn, builder_seat)
   125	    if row is None:
   126	        raise ValueError(f"unknown builder seat: {builder_seat}")
   127	
   128	    # Snapshot who built this, AT BUILD TIME. Sol's cross-family review found that
   129	    # reading the builder's tier live meant re-tiering a local seat retroactively
   130	    # legitimized its old unreviewed work. What a seat is today cannot change what
   131	    # it was. The schema then freezes these columns.
   132	    cur = conn.execute(
   133	        """
   134	        INSERT INTO jobs (request, builder_seat, builder_tier, builder_family,
   135	                          origin, parent_job_id, task_name)
   136	        VALUES (?, ?, ?, ?, ?, ?, ?)
   137	        """,
   138	        (request, builder_seat, row["tier"], row["family"],
   139	         origin, parent_job_id, task_name),
   140	    )
   141	    return int(cur.lastrowid)
   142	
   143	
   144	def claim_next_job(conn: sqlite3.Connection, builder_seat: str) -> sqlite3.Row | None:
   145	    """Atomically claim the oldest queued job for this seat.
   146	
   147	    Uses UPDATE...RETURNING against a subquery so two workers racing for the same
   148	    row cannot both win — SQLite serializes the write and only one claim lands.
   149	    Cribbed from clu's approach; it removes the need for any external lock.
   150	    """
   151	    row = conn.execute(
   152	        """
   153	        UPDATE jobs
   154	           SET status = 'in_progress',
   155	               started_at = datetime('now'),
   156	               attempts = attempts + 1
   157	         WHERE id = (
   158	             SELECT id FROM jobs
   159	              WHERE status = 'todo' AND builder_seat = ?
   160	              ORDER BY id
   161	              LIMIT 1
   162	         )
   163	        RETURNING *
   164	        """,
   165	        (builder_seat,),
   166	    ).fetchone()
   167	    return row
   168	
   169	
   170	def attach_run(
   171	    conn: sqlite3.Connection,
   172	    job_id: int,
   173	    run_id: str,
   174	    session_key: str | None = None,
   175	    branch: str | None = None,
   176	    worktree: str | None = None,
   177	) -> None:
   178	    """Record the OpenClaw spawn that is actually doing the work."""
   179	    conn.execute(
   180	        """
   181	        UPDATE jobs SET run_id = ?, session_key = ?, branch = ?, worktree = ?
   182	         WHERE id = ?
   183	        """,
   184	        (run_id, session_key, branch, worktree, job_id),
   185	    )
   186	
   187	
   188	@_guarded
   189	def set_head_version(conn: sqlite3.Connection, job_id: int, version: str) -> None:
   190	    """Record the exact version (git commit id) the builder is putting forward.
   191	
   192	    This is the pivot of the review-to-version chain: every completion guard only
   193	    counts verdicts whose reviewed_version matches this. Calling it again after the
   194	    builder iterates voids all earlier approvals by construction — nothing needs to
   195	    remember to revoke them. Frozen by the schema once the job is done.
   196	    """
   197	    if not version or not version.strip():
   198	        raise ValueError("a version must actually name a version")
   199	    conn.execute(
   200	        "UPDATE jobs SET head_version = ? WHERE id = ?", (version.strip(), job_id)
   201	    )
   202	
   203	
   204	@_guarded
   205	def set_status(
   206	    conn: sqlite3.Connection,
   207	    job_id: int,
   208	    status: str,
   209	    result: str | None = None,
   210	    error: str | None = None,
   211	    spoken_summary: str | None = None,
   212	) -> None:
   213	    """Move a job's status.
   214	
   215	    Moving to 'done' runs the schema guards. If the builder was a local seat and no
   216	    higher-tier reviewer has passed it, this raises GuardViolation — by design.
   217	    """
   218	    finished = status in ("done", "failed", "cancelled")
   219	    conn.execute(
   220	        """
   221	        UPDATE jobs
   222	           SET status = ?,
   223	               result = COALESCE(?, result),
   224	               error = COALESCE(?, error),
   225	               spoken_summary = COALESCE(?, spoken_summary),
   226	               finished_at = CASE WHEN ? THEN datetime('now') ELSE finished_at END
   227	         WHERE id = ?
   228	        """,
   229	        (status, result, error, spoken_summary, int(finished), job_id),
   230	    )
   231	
   232	
   233	def record_artifact(
   234	    conn: sqlite3.Connection,
   235	    job_id: int,
   236	    kind: str,
   237	    path: str | None = None,
   238	    value: str | None = None,
   239	    flow: str | None = None,
   240	    captured_by: str = "playwright",
   241	) -> int:
   242	    """Record GROUND TRUTH.
   243	
   244	    Two kinds, and they have different rules about who may write them:
   245	
   246	    EVIDENCE OF A BUILD (screenshot, trace, logs, exit codes) — only the harness or
   247	    Playwright. NEVER a model. A model cannot fabricate a screenshot, which is what
   248	    makes "I ran it and it worked" unsayable.
   249	
   250	    EVIDENCE OF A CLAIM (source, quote) — a model MAY write these, because a
   251	    researcher's whole job is to hand you a URL you can go and read yourself. The
   252	    check isn't "who wrote it down", it's "can someone else go and look?" — which is
   253	    why a different family has to read the sources cold (guard 8).
   254	    """
   255	    _MODEL_MAY_CITE = {"source", "quote"}
   256	    if captured_by == "model" and kind not in _MODEL_MAY_CITE:
   257	        raise ValueError(
   258	            f"a model may cite a source, but it may not produce a '{kind}' — "
   259	            "build evidence is captured by the harness, never claimed by a model"
   260	        )
   261	    if captured_by not in ("harness", "playwright", "model"):
   262	        raise ValueError(f"unknown artifact origin: {captured_by}")
   263	    cur = conn.execute(
   264	        """
   265	        INSERT INTO artifacts (job_id, kind, path, value, flow, captured_by)
   266	        VALUES (?, ?, ?, ?, ?, ?)
   267	        """,
   268	        (job_id, kind, path, value, flow, captured_by),
   269	    )
   270	    return int(cur.lastrowid)
   271	
   272	
   273	@_guarded
   274	def record_verdict(
   275	    conn: sqlite3.Connection,
   276	    job_id: int,
   277	    reviewer_seat: str,
   278	    verdict: str,
   279	    severity: str | None = None,
   280	    summary: str | None = None,
   281	    detail: str | None = None,
   282	    role: str = "reviewer",
   283	    reviewed_version: str | None = None,
   284	) -> int:
   285	    """Record one seat's verdict.
   286	
   287	    role='reviewer' reads the diff and judges it.
   288	    role='tester'   drove the app (Playwright) and judges what it observed. Two guards
   289	                    apply: it must cite captured artifacts, and its family must differ
   290	                    from the builder's — Playwright stops a tester fabricating what
   291	                    happened; only a different mind stops it rationalizing it.
   292	
   293	    reviewed_version is WHAT the reviewer looked at. The gauntlet runner pins the
   294	    version before handing work to a reviewer and must pass it explicitly. When
   295	    omitted, it defaults to the job's current head_version — correct only when
   296	    nothing moved between review and recording, which the runner must guarantee.
   297	    A verdict whose version stops matching the job simply stops counting.
   298	
   299	    tier and family are snapshotted from the seat at write time, so re-tiering or
   300	    re-pointing a seat later cannot retroactively legitimize a job.
   301	    """
   302	    row = seat(conn, reviewer_seat)
   303	    if row is None:
   304	        raise ValueError(f"unknown seat: {reviewer_seat}")
   305	
   306	    if reviewed_version is None:
   307	        job_row = conn.execute(
   308	            "SELECT head_version FROM jobs WHERE id = ?", (job_id,)
   309	        ).fetchone()
   310	        if job_row is not None:
   311	            reviewed_version = job_row["head_version"]
   312	
   313	    cur = conn.execute(
   314	        """
   315	        INSERT INTO verdicts
   316	            (job_id, reviewer_seat, reviewer_tier, role, model_family,
   317	             verdict, severity, summary, detail, reviewed_version)
   318	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
   319	        """,
   320	        (job_id, reviewer_seat, row["tier"], role, row["family"],
   321	         verdict, severity, summary, detail, reviewed_version),
   322	    )
   323	    return int(cur.lastrowid)
   324	
   325	
   326	def resolve_escalation(conn: sqlite3.Connection, verdict_id: int, verdict: str) -> None:
   327	    """Answer a needs_human verdict so the job can proceed (§6 human review queue)."""
   328	    if verdict not in ("pass", "fail"):
   329	        raise ValueError("an escalation resolves to 'pass' or 'fail'")
   330	    conn.execute("UPDATE verdicts SET verdict = ? WHERE id = ?", (verdict, verdict_id))
   331	
   332	
   333	# --------------------------------------------------------------------------
   334	# Reporting — this is what the voice layer reads back
   335	# --------------------------------------------------------------------------
   336	def overnight_report(conn: sqlite3.Connection, since: str = "-1 day") -> list[sqlite3.Row]:
   337	    """Answers spec §7's 'what did the overnight run do?'"""
   338	    return conn.execute(
   339	        """
   340	        SELECT * FROM job_report
   341	         WHERE created_at >= datetime('now', ?)
   342	         ORDER BY id
   343	        """,
   344	        (since,),
   345	    ).fetchall()
   346	
   347	
   348	def spend_today(conn: sqlite3.Connection, seat_id: str) -> int:
   349	    row = conn.execute(
   350	        "SELECT COALESCE(SUM(cost_cents), 0) AS c FROM usage WHERE seat_id = ? AND day = date('now')",
   351	        (seat_id,),
   352	    ).fetchone()
   353	    return int(row["c"])
   354	
   355	
   356	def over_budget(conn: sqlite3.Connection, seat_id: str) -> bool:
   357	    """True if this seat has hit its daily cap.
   358	
   359	    OpenClaw has no per-agent budget of any kind, so the harness must check this
   360	    before dispatching. Uncapped seats (daily_cap_cents IS NULL) never block.
   361	    """
   362	    row = seat(conn, seat_id)
   363	    if row is None or row["daily_cap_cents"] is None:
   364	        return False
   365	    return spend_today(conn, seat_id) >= int(row["daily_cap_cents"])
   366	
   367	
   368	@_guarded
   369	def record_usage(
   370	    conn: sqlite3.Connection,
   371	    seat_id: str,
   372	    cost_cents: int,
   373	    job_id: int | None = None,
   374	    input_tokens: int = 0,
   375	    output_tokens: int = 0,
   376	    role: str = "build",
   377	) -> None:
   378	    """Record spend. The DATABASE refuses an entry that would breach the daily cap.
   379	
   380	    This used to be a Python check before dispatch — which Sol correctly called a
   381	    race (two dispatches both pass the check before either records spend) and easily
   382	    bypassed by any direct write. The ledger itself now says no.
   383	    """
   384	    conn.execute(
   385	        """
   386	        INSERT INTO usage (seat_id, job_id, role, input_tokens, output_tokens, cost_cents)
   387	        VALUES (?, ?, ?, ?, ?, ?)
   388	        """,
   389	        (seat_id, job_id, role, input_tokens, output_tokens, cost_cents),
   390	    )
   391	
   392	
   393	def can_build(conn: sqlite3.Connection, seat_id: str) -> bool:
   394	    """Has this seat used up its BUILDING budget? (It may still be able to review.)"""
   395	    row = seat(conn, seat_id)
   396	    if row is None or row["build_cap_cents"] is None:
   397	        return True
   398	    spent = conn.execute(
   399	        "SELECT COALESCE(SUM(cost_cents),0) c FROM usage "
   400	        "WHERE seat_id=? AND day=date('now') AND role='build'", (seat_id,)
   401	    ).fetchone()["c"]
   402	    return int(spent) < int(row["build_cap_cents"])
   403	
   404	
   405	# ---------------------------------------------------------------------------
   406	# The money
   407	# ---------------------------------------------------------------------------
   408	def month_spend(conn: sqlite3.Connection) -> dict[str, int]:
   409	    """What have we spent this month, and how close are we?"""
   410	    r = conn.execute("SELECT * FROM month_spend").fetchone()
   411	    spent, cap, warn = int(r["spent_cents"]), int(r["cap_cents"]), int(r["warn_cents"])
   412	    return {
   413	        "spent_cents": spent,
   414	        "cap_cents": cap,
   415	        "warn_cents": warn,
   416	        "remaining_cents": max(0, cap - spent),
   417	        "pct": round(100 * spent / cap, 1) if cap else 0.0,
   418	        "over_warn": spent >= warn,
   419	    }
   420	
   421	
   422	def set_budget(conn: sqlite3.Connection, monthly_cap_cents: int, warn_at_cents: int) -> None:
   423	    conn.execute(
   424	        "UPDATE budget SET monthly_cap_cents=?, warn_at_cents=?, updated_at=datetime('now') "
   425	        "WHERE id=1", (monthly_cap_cents, warn_at_cents)
   426	    )
   427	
   428	
   429	def budget_warning(conn: sqlite3.Connection) -> str | None:
   430	    """Should we tell Neill about the money right now?
   431	
   432	    Warns ONCE per month at the threshold, then goes quiet — a warning you see every
   433	    day is a warning you stop reading. Speaks up again only when the cap is actually
   434	    hit, because at that point work is stopping and he needs to know why.
   435	    """
   436	    m = month_spend(conn)
   437	    if m["spent_cents"] >= m["cap_cents"]:
   438	        return (f"You've hit the ${m['cap_cents']/100:.0f} monthly limit. "
   439	                f"I've stopped spending until you raise it or the month rolls over.")
   440	
   441	    if not m["over_warn"]:
   442	        return None
   443	
   444	    from datetime import datetime
   445	    this_month = datetime.now().strftime("%Y-%m")
   446	    row = conn.execute("SELECT warned_this_month FROM budget WHERE id=1").fetchone()
   447	    if row["warned_this_month"] == this_month:
   448	        return None   # already told him. Don't nag.
   449	
   450	    conn.execute("UPDATE budget SET warned_this_month=? WHERE id=1", (this_month,))
   451	    return (f"Heads up — you're at ${m['spent_cents']/100:.2f} of your "
   452	            f"${m['cap_cents']/100:.0f} monthly budget. About "
   453	            f"${m['remaining_cents']/100:.2f} left.")
     1	-- Chief Command v2 — harness job store
     2	--
     3	-- This is the layer OpenClaw does NOT give us. Its subagent sessions auto-archive
     4	-- after ~60 minutes and get soft-deleted; that is session archival, not durable job
     5	-- history. Spec §7 wants "what did the overnight run do?" to be answerable. This is that.
     6	--
     7	-- Two rules are enforced STRUCTURALLY here rather than in a prompt, because rules that
     8	-- live in prompts quietly stop holding at 4am:
     9	--   1. Local-model output can never reach `done` without a higher-tier passing review
    10	--      (spec §4.3 / §9 — "enforce in the pipeline itself, not by convention").
    11	--   2. Per-seat spend caps (OpenClaw core has no per-agent budget of any kind).
    12	
    13	PRAGMA journal_mode = WAL;
    14	PRAGMA foreign_keys = ON;
    15	
    16	-- ---------------------------------------------------------------------------
    17	-- Seats: the named roles from spec §4. Providers are swappable behind these.
    18	-- ---------------------------------------------------------------------------
    19	CREATE TABLE IF NOT EXISTS seats (
    20	    id            TEXT PRIMARY KEY,          -- 'brain' | 'workhorse' | 'grinder_local' | 'reviewer' | 'tester' | 'mouth'
    21	    provider      TEXT NOT NULL,             -- 'codex' | 'xai' | 'ollama' | 'claude-cli' | ...
    22	    model         TEXT NOT NULL,
    23	    -- Model FAMILY, not provider. Two seats can share a family via different providers
    24	    -- (e.g. claude-cli and an Anthropic API key are both 'claude'). The gauntlet's
    25	    -- diversity rule and the no-self-testing guard both key off this, so it must be
    26	    -- the thing that actually determines shared blind spots.
    27	    family        TEXT NOT NULL,             -- 'gpt' | 'claude' | 'grok' | 'qwen'
    28	    -- tier drives the review guard below. 'local' output is never trusted on its own.
    29	    tier          TEXT NOT NULL CHECK (tier IN ('local', 'subscription', 'metered')),
    30	    -- ═══════════════════════════════════════════════════════════════════════
    31	    -- MODEL TIERS. Owner (2026-07-14):
    32	    --     "If we do highest model every time for every build, on autonomous work,
    33	    --      Claude and ChatGPT are gonna bottom out. I need us to build in model
    34	    --      tiering as well."
    35	    --
    36	    -- He's right, and it's the difference between a system that runs for a month and
    37	    -- one that dies on Thursday. Rate limits are the binding constraint on autonomous
    38	    -- work — NOT money (Claude and OpenAI are flat-rate). You cannot buy your way out
    39	    -- of a weekly cap. You can only spend it wisely.
    40	    --
    41	    -- So every seat carries THREE models, and the harness picks by what the work
    42	    -- actually deserves:
    43	    --
    44	    --   light     the cheap one. Boilerplate, scaffolding, small fixes, quick answers.
    45	    --   standard  the default. Most real work.
    46	    --   heavy     the top of the line. Reserved, and it has to be EARNED.
    47	    --
    48	    -- Nothing gets `heavy` by default. It's earned by: an explicit ask ("think hard"),
    49	    -- a risky area (auth, money, data), a repeat failure, or a major decision. See
    50	    -- tiering.py — the whole point is that the escalation is a rule, not a vibe.
    51	    -- ═══════════════════════════════════════════════════════════════════════
    52	    model_light    TEXT,     -- e.g. claude-haiku / gpt-5.6-luna
    53	    model_standard TEXT,     -- e.g. claude-sonnet / gpt-5.6-terra
    54	    model_heavy    TEXT,     -- e.g. claude-opus / gpt-5.6-sol  (EARNED, never default)
    55	    effort_light    TEXT DEFAULT 'low',
    56	    effort_standard TEXT DEFAULT 'medium',
    57	    effort_heavy    TEXT DEFAULT 'high',
    58	
    59	    -- CAPS ARE PER-ROLE, not just per-seat. Owner's call (2026-07-13):
    60	    --     "it can review as much as it wants more or less, but shouldn't build as
    61	    --      much as claude and chat"
    62	    --
    63	    -- The economics say the same thing. Claude and OpenAI are FLAT-RATE — a build on
    64	    -- those seats costs nothing marginal, it's already paid for. Grok is METERED, so
    65	    -- every build is real money. And builds are the expensive kind of work (token-heavy)
    66	    -- while reviews are cheap (read-heavy, ~1/10 the tokens).
    67	    --
    68	    -- So: BUILD on the seats you've already bought. REVIEW on the metered one, because
    69	    -- reviewing is cheap — and reviewing is what Grok is actually best at anyway. Its
    70	    -- value was never being the strongest coder. It's being a DIFFERENT MIND.
    71	    --
    72	    -- NULL = uncapped.
    73	    daily_cap_cents        INTEGER,   -- total across all roles (the hard ceiling)
    74	    build_cap_cents        INTEGER,   -- ration the expensive work
    75	    review_cap_cents       INTEGER,   -- reviewing is cheap; be generous
    76	    enabled       INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0, 1)),
    77	    notes         TEXT
    78	);
    79	
    80	-- ---------------------------------------------------------------------------
    81	-- Projects: the top-level thing work belongs to. Each has its OWN memory.
    82	--
    83	-- Owner: "ability to see a projects tab and each project has its own memory,
    84	-- timeline/planning."
    85	--
    86	-- This matters more than it looks. Memory that isn't scoped to a project leaks:
    87	-- lessons from the EMR bleed into the harness, conventions from one codebase get
    88	-- applied to another. Chief already keeps per-AGENT memory; this is per-PROJECT,
    89	-- and the two are different axes. Riggs knows how HE works; the project knows how
    90	-- IT works.
    91	-- ---------------------------------------------------------------------------
    92	CREATE TABLE IF NOT EXISTS projects (
    93	    id            TEXT PRIMARY KEY,          -- 'chief', 'arch', 'jess'
    94	    name          TEXT NOT NULL,
    95	    repo_path     TEXT,
    96	    description   TEXT,
    97	    -- Where this project's own memory lives. Loaded into context for any job on it.
    98	    memory_dir    TEXT,
    99	    color         TEXT,                      -- the UI reads this
   100	    archived      INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0,1)),
   101	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   102	);
   103	
   104	-- The REAL projects, seeded so Chief knows them on ANY machine (a fresh DB or the Mac
   105	-- Studio), not just wherever a row happened to be typed. Without this, `projects` is
   106	-- empty on a new box and Chief goes back to improvising what Neill is working on — the
   107	-- exact bug this seed exists to kill. OR IGNORE so it never clobbers live edits.
   108	--
   109	-- repo_path: Arch is deliberately NULL. Chief may read Arch's NOTES (memory), but the
   110	-- fleet must never be pointed at its code or its patient data (Decision C, PHI). Dispatch
   111	-- does not route by repo_path today; if it ever learns to, THAT is where the guard goes.
   112	--
   113	-- memory_dir is NOT seeded here on purpose: it's the one genuinely machine-specific value
   114	-- (where this box keeps the project's notes), so it's set as local config per machine —
   115	-- keeping this file hardware-agnostic (rule 4).
   116	INSERT OR IGNORE INTO projects (id, name, repo_path, description, color) VALUES
   117	  ('chief', 'Chief Command', '~/code-projects/chief-command',
   118	   'The thing you talk to. This.', '#2E9BFF'),
   119	  ('jess', 'Jess', '~/code-projects/personal-assist',
   120	   'Personal assistant. Connects to Chief over the tailnet later.', '#A78BFA'),
   121	  ('arch', 'Arch (Arch to Freedom EMR)', NULL,
   122	   'The records system for the addiction-recovery facility — staff, beds, roles, approvals, the voice assistant Archie. Voice-first. Held at arm''s length here on purpose: Chief can read its notes but the fleet does not touch its code or its patient data.',
   123	   '#22c55e');
   124	
   125	-- Project memory: facts that belong to the PROJECT, not to an agent and not to a job.
   126	-- "The API returns snake_case." "Never touch the billing table directly."
   127	CREATE TABLE IF NOT EXISTS project_memory (
   128	    id            INTEGER PRIMARY KEY,
   129	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
   130	    kind          TEXT NOT NULL DEFAULT 'lesson'
   131	                  CHECK (kind IN ('lesson', 'convention', 'constraint', 'decision', 'gotcha')),
   132	    fact          TEXT NOT NULL,
   133	    -- Where it came from, so a wrong lesson can be traced and killed.
   134	    learned_from  INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   135	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   136	);
   137	
   138	CREATE INDEX IF NOT EXISTS idx_pmem_project ON project_memory(project_id);
   139	
   140	-- The plan. What's coming, in order. This is the timeline the UI draws.
   141	CREATE TABLE IF NOT EXISTS plan_items (
   142	    id            INTEGER PRIMARY KEY,
   143	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
   144	    title         TEXT NOT NULL,
   145	    detail        TEXT,
   146	    phase         TEXT,                      -- 'phase 1', 'phase 2'…
   147	    status        TEXT NOT NULL DEFAULT 'planned'
   148	                  CHECK (status IN ('planned', 'active', 'blocked', 'done', 'dropped')),
   149	    blocked_on    TEXT,                      -- plain English. "waiting on Neill to log in"
   150	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   151	    position      INTEGER NOT NULL DEFAULT 0,
   152	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   153	);
   154	
   155	CREATE INDEX IF NOT EXISTS idx_plan_project ON plan_items(project_id, position);
   156	
   157	-- ---------------------------------------------------------------------------
   158	-- Todos: the checklist that belongs to a PROJECT, so it stops living in a
   159	-- terminal window and following nobody. Owner's annoyance, verbatim: "right now I
   160	-- have persistent todos that has to jump from window to window, which is annoying."
   161	--
   162	-- `owner_only` marks the items only Neill can do (rotate a key, flip a setting) —
   163	-- the ones the fleet must never quietly tick off on his behalf.
   164	-- ---------------------------------------------------------------------------
   165	CREATE TABLE IF NOT EXISTS todos (
   166	    id            INTEGER PRIMARY KEY,
   167	    project_id    TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
   168	    -- Sub-category WITHIN a project, so a project can hold several running lists
   169	    -- ("Security", "Build", "My tasks"). Owner: "ideally we can create a sub
   170	    -- category under each project as well." NULL / '' folds into a "General" list.
   171	    section       TEXT,
   172	    text          TEXT NOT NULL,
   173	    done          INTEGER NOT NULL DEFAULT 0 CHECK (done IN (0, 1)),
   174	    owner_only    INTEGER NOT NULL DEFAULT 0 CHECK (owner_only IN (0, 1)),
   175	    position      INTEGER NOT NULL DEFAULT 0,
   176	    created_at    TEXT NOT NULL DEFAULT (datetime('now')),
   177	    done_at       TEXT
   178	);
   179	
   180	CREATE INDEX IF NOT EXISTS idx_todos_project ON todos(project_id, section, position, id);
   181	
   182	-- ---------------------------------------------------------------------------
   183	-- Attachments: images and files Neill drops in — a screenshot of a bug, a mockup,
   184	-- a document — pinned to a project or a specific job. The bytes live on disk
   185	-- (gitignored); this row is how the UI finds them. captured_by is always the owner
   186	-- here; agent-produced evidence is the `artifacts` table, which has its own guards.
   187	-- ---------------------------------------------------------------------------
   188	CREATE TABLE IF NOT EXISTS attachments (
   189	    id            INTEGER PRIMARY KEY,
   190	    project_id    TEXT REFERENCES projects(id) ON DELETE SET NULL,
   191	    job_id        INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   192	    filename      TEXT NOT NULL,             -- the original name, for display
   193	    stored_path   TEXT NOT NULL,             -- where the bytes actually live
   194	    kind          TEXT NOT NULL CHECK (kind IN ('image', 'file')),
   195	    size_bytes    INTEGER,
   196	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   197	);
   198	
   199	CREATE INDEX IF NOT EXISTS idx_attachments_project ON attachments(project_id);
   200	CREATE INDEX IF NOT EXISTS idx_attachments_job ON attachments(job_id);
   201	
   202	-- ---------------------------------------------------------------------------
   203	-- Jobs: one row per dispatched unit of work. This is the audit trail.
   204	-- ---------------------------------------------------------------------------
   205	CREATE TABLE IF NOT EXISTS jobs (
   206	    id            INTEGER PRIMARY KEY,
   207	    created_at    TEXT NOT NULL DEFAULT (datetime('now')),
   208	    updated_at    TEXT NOT NULL DEFAULT (datetime('now')),
   209	    started_at    TEXT,
   210	    finished_at   TEXT,
   211	
   212	    request       TEXT NOT NULL,             -- what was asked, verbatim (§7)
   213	    -- A 2-4 word handle the mouth coins at dispatch: "the rate limiter".
   214	    -- The VOICE says this. The TEXT shows `request` in full. Echoing a man's own
   215	    -- paragraph back at him is not how a colleague talks.
   216	    task_name     TEXT,
   217	    origin        TEXT NOT NULL DEFAULT 'text'
   218	                  CHECK (origin IN ('text', 'voice', 'cron', 'relay')),  -- 'relay' = Jess (§10)
   219	
   220	    -- 'build'    → produces code. Ground truth = a screenshot (Playwright drove it).
   240	    builder_tier   TEXT NOT NULL DEFAULT 'local'
   241	                   CHECK (builder_tier IN ('local','subscription','metered')),
   242	    builder_family TEXT NOT NULL DEFAULT 'unknown',
   243	    run_id        TEXT,                      -- OpenClaw sessions_spawn run id
   244	    session_key   TEXT,                      -- agent:<id>:subagent:<uuid>
   245	
   246	    -- Git as audit trail (§7). Worktree-per-job, main untouched until merged.
   247	    branch        TEXT,
   248	    worktree      TEXT,
   249	
   250	    -- THE VERSION UNDER REVIEW (Sol build gate 3, 2026-07-20). The exact content
   251	    -- hash the builder is putting forward — a git commit id. Reviews bind to this:
   252	    -- a verdict only counts toward completion while its reviewed_version matches.
   253	    -- The moment the builder changes the code, this changes, and every earlier
   254	    -- approval silently stops counting. Sol called the alternative the most
   255	    -- dangerous flaw in the system: "believable green checks on code nobody
   256	    -- reviewed." The gatekeeper's job at push time is to verify the code leaving
   257	    -- the building IS this hash — the DB proves the chain, git proves the content.
   258	    head_version  TEXT,
   259	
   260	    -- 'done'    = the gauntlet passed. The machine is satisfied.
   261	    -- 'shipped' = NEILL said it works on his device. Only he can move this.
   262	    -- These are NOT the same thing, and conflating them is how agents launder
   263	    -- confidence. From Chief's memory, learned the hard way:
   264	    --     "Chief must NEVER say 'shipped' unless Neill has confirmed it works on
   265	    --      his device. 'Shipped' is reserved for Neill-confirmed-working."
   266	    -- That rule now lives here instead of in a prompt.
   267	    status        TEXT NOT NULL DEFAULT 'todo'
   268	                  CHECK (status IN ('todo', 'in_progress', 'review', 'done',
   269	                                    'shipped', 'failed', 'cancelled')),
   270	    -- Set ONLY by the owner, through mark_shipped(). No agent has a path to this.
   271	    owner_confirmed_at TEXT,
   272	
   273	    -- How many passing reviews this job needs before it may complete. Set at
   274	    -- dispatch from the gauntlet config. Also from Chief's memory:
   275	    --     "Full set, always. No 'minimum,' no 'pick two,' no 'optional depending
   276	    --      on scope.'"
   277	    required_reviews INTEGER NOT NULL DEFAULT 0,
   278	
   279	    -- How many DISTINCT model families must have a passing review before done. This is
   280	    -- the floor "full set, always" doesn't itself guarantee: a full panel could still be
   281	    -- one family wearing three hats. Set at dispatch from the gauntlet's
   282	    -- min_model_families. Snapshotted and un-lowerable, like required_reviews. (task #10)
   283	    required_review_families INTEGER NOT NULL DEFAULT 0,
   284	
   285	    result        TEXT,                      -- final summary / diff ref
   286	    error         TEXT,
   287	
   288	    -- Voice wants a spoken-length answer; the text log keeps the detail (§5.3).
   289	    spoken_summary TEXT,
   290	
   291	    attempts      INTEGER NOT NULL DEFAULT 0,
   292	    parent_job_id INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   293	
   294	    -- DUPLICATE PROTECTION. A retry — a double-tap, a dropped connection, the voice
   295	    -- re-sending — must not start the same work twice. The caller stamps a key; a
   296	    -- second dispatch with the same key returns the existing job instead of spawning
   297	    -- a new one. NULL = no key given (nothing to dedupe against). The unique index
   298	    -- below lets many NULLs coexist but forbids two rows sharing a real key.
   299	    dispatch_key  TEXT
   300	);
   301	
   302	CREATE INDEX IF NOT EXISTS idx_jobs_status  ON jobs(status);
   303	CREATE INDEX IF NOT EXISTS idx_jobs_created ON jobs(created_at);
   304	CREATE INDEX IF NOT EXISTS idx_jobs_run     ON jobs(run_id);
   305	CREATE UNIQUE INDEX IF NOT EXISTS idx_jobs_dispatch_key ON jobs(dispatch_key)
   306	    WHERE dispatch_key IS NOT NULL;
   307	
   308	-- ---------------------------------------------------------------------------
   309	-- Verdicts: the gauntlet's output (§6). One row per reviewer per job.
   310	-- reviewer_tier is denormalized at write time so a later seat re-tiering cannot
   311	-- retroactively validate a job that was never properly reviewed.
   312	-- ---------------------------------------------------------------------------
   313	CREATE TABLE IF NOT EXISTS verdicts (
   314	    id            INTEGER PRIMARY KEY,
   315	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   316	    reviewer_seat TEXT NOT NULL REFERENCES seats(id),
   317	    reviewer_tier TEXT NOT NULL CHECK (reviewer_tier IN ('local', 'subscription', 'metered')),
   318	    -- 'reviewer' reads the diff and judges. 'tester' DRIVES THE APP (Playwright) and
   319	    -- judges what it observed. The tester guards below apply only to the latter.
   320	    -- 'reviewer' reads the diff and judges it.
   321	    -- 'tester'   DROVE the running app (Playwright) and judges what it observed.
   322	    -- 'verifier' FACT-CHECKS a research answer against its sources.
   323	    role          TEXT NOT NULL DEFAULT 'reviewer'
   324	                  CHECK (role IN ('reviewer', 'tester', 'verifier')),
   325	    -- model family is snapshotted here so §6's "at least two families" rule is
   326	    -- auditable, and so the no-self-family-testing guard has something to check.
   327	    model_family  TEXT NOT NULL,
   328	    -- WHAT, exactly, did this reviewer look at? Snapshotted at write time. A verdict
   329	    -- whose version no longer matches the job's head_version is history, not
   330	    -- approval — it stops counting the moment the code moves on. This is the other
   331	    -- half of the review-to-version chain.
   332	    reviewed_version TEXT,
   333	    verdict       TEXT NOT NULL CHECK (verdict IN ('pass', 'fail', 'needs_human')),
   334	    severity      TEXT CHECK (severity IN ('p0', 'p1', 'p2', 'p3')),
   335	    summary       TEXT,
   336	    detail        TEXT,
   337	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   338	);
   339	
   340	CREATE INDEX IF NOT EXISTS idx_verdicts_job ON verdicts(job_id);
   341	
   342	-- ═══════════════════════════════════════════════════════════════════════════════
   343	-- CAPABILITIES — what an agent is PHYSICALLY ALLOWED to do.
   344	--
   345	-- This exists because Sol reviewed the architecture and demolished the previous
   346	-- safety story. The plan had been: the voice can act fast, and Chief watches and
   347	-- kills anything dumb. Sol's verdict:
   348	--
   349	--     "'Builders take minutes' measures how long they take to FINISH. What matters
   350	--      is how long they take to do their FIRST DAMAGING THING. That can be seconds.
   351	--      Chief and the builder would be RACING. There is no guarantee Chief wins."
   352	--
   353	--     "A fast supervisor is still only a fast witness if the builder can act first."
   354	--
   355	--     "A smarter model is not a security boundary."
   356	--
   357	-- He's right, and it's the difference between a bank with a vault and a bank with an
   358	-- attentive guard. You do not stop a robbery by watching carefully.
   359	--
   360	-- SO: agents get NO dangerous powers. Not "Chief will stop them" — THEY CANNOT.
   630	-- THE GUARDS
   631	--
   632	-- ⚠️ REWRITTEN 2026-07-13 after a cross-family review. Sol (GPT) reviewed Claude's
   633	-- code and found NINE ways through. The headline: every guard fired on UPDATE of
   634	-- status, and NONE fired on INSERT — so a job could be BORN 'done'. Fences around
   635	-- the front door, no wall.
   636	--
   637	-- Sol's closing line, which is the one that mattered:
   638	--     "Those are application conventions, not the claimed structurally impossible
   639	--      guarantees."
   640	--
   641	-- He was right. Fixed below. Each guard now fires on BOTH insert and update, checks
   642	-- SNAPSHOTTED facts rather than live ones, and validates claims against `seats`
   643	-- instead of trusting whatever the writer put in the row.
   644	-- ===========================================================================
   645	
   646	-- A job may never be BORN finished. (Sol, round 1, #1 — the worst one.)
   647	CREATE TRIGGER IF NOT EXISTS guard_no_job_is_born_done
   648	BEFORE INSERT ON jobs
   649	WHEN NEW.status IN ('done', 'shipped')
   650	BEGIN
   651	    SELECT RAISE(ABORT, 'guard: a job cannot be created already finished — it must earn it');
   652	END;
   653	
   654	-- A job may not LIE ABOUT WHO BUILT IT AT BIRTH. (Sol, round 2, #1 — critical.)
   655	--
   656	-- I froze the builder's identity AFTER creation, so it couldn't be rewritten. But I
   657	-- never checked it AT creation. Sol: "A direct database write can label local work as
   658	-- subscription work, then complete it without the required higher-quality review. The
   659	-- identity is frozen only after creation; the initial lie is never caught."
   660	--
   661	-- Freezing a lie just makes it a permanent lie.
   662	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_must_be_real
   663	BEFORE INSERT ON jobs
   664	WHEN NEW.builder_tier   <> (SELECT tier   FROM seats WHERE id = NEW.builder_seat)
   665	  OR NEW.builder_family <> (SELECT family FROM seats WHERE id = NEW.builder_seat)
   666	BEGIN
   667	    SELECT RAISE(ABORT, 'guard: a job cannot misrepresent who built it');
   668	END;
   669	
   670	-- The builder's tier/family are snapshotted at creation and are then HISTORY.
   671	-- (Sol #5, #6 — re-tiering a seat rewrote the past.)
   672	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_is_frozen
   673	BEFORE UPDATE ON jobs
   674	WHEN OLD.builder_seat <> NEW.builder_seat
   675	  OR OLD.builder_tier <> NEW.builder_tier
   676	  OR OLD.builder_family <> NEW.builder_family
   677	BEGIN
   678	    SELECT RAISE(ABORT, 'guard: who built this cannot be rewritten after the fact');
   679	END;
   680	
   681	-- The panel size is fixed at dispatch. (Sol #7 — it could be set to zero later.)
   682	CREATE TRIGGER IF NOT EXISTS guard_panel_size_is_fixed
   683	BEFORE UPDATE OF required_reviews ON jobs
   684	WHEN OLD.required_reviews > 0 AND NEW.required_reviews < OLD.required_reviews
   685	BEGIN
   686	    SELECT RAISE(ABORT, 'guard: the panel cannot be shrunk after dispatch');
   687	END;
   688	
   689	-- A verdict, once written, is a fact. It cannot be edited into a pass.
   690	-- (Sol #2 — every verdict guard checked INSERT only, so you could rewrite the row.)
   691	CREATE TRIGGER IF NOT EXISTS guard_verdicts_are_append_only
   692	BEFORE UPDATE ON verdicts
   693	WHEN OLD.verdict <> NEW.verdict
   694	     AND NOT (OLD.verdict = 'needs_human' AND NEW.verdict IN ('pass','fail'))
   695	BEGIN
   696	    SELECT RAISE(ABORT, 'guard: a verdict cannot be rewritten — only an escalation may be answered');
   697	END;
   698	
   699	CREATE TRIGGER IF NOT EXISTS guard_verdict_identity_is_frozen
   700	BEFORE UPDATE ON verdicts
   701	WHEN OLD.role <> NEW.role OR OLD.model_family <> NEW.model_family
   702	  OR OLD.reviewer_seat <> NEW.reviewer_seat OR OLD.reviewer_tier <> NEW.reviewer_tier
   703	BEGIN
   704	    SELECT RAISE(ABORT, 'guard: who reviewed this cannot be rewritten after the fact');
   705	END;
   706	
   707	-- ═══════════════════════════════════════════════════════════════════════════
   708	-- THE REVIEW-TO-VERSION CHAIN (Sol build gate 3, 2026-07-20).
   709	--
   710	-- Sol's most dangerous flaw: "approve version A, builder changes it to B, the old
   711	-- approval still counts — believable green checks on code nobody reviewed."
   712	--
   713	-- The fix is not another approval ceremony; it is arithmetic. A verdict carries the
   714	-- version it reviewed. A job carries the version it is putting forward. Completion
   715	-- guards only count verdicts whose versions MATCH — so moving the code voids the
   716	-- approvals by construction, nothing needs to remember to revoke anything. And a
   717	-- FAIL condemns the version it saw, not the job forever: fix the code, the version
   718	-- changes, the old fail becomes history. (A fail with no recorded version blocks
   719	-- everything — fail-closed, because it condemned we-don't-know-what.)
   720	-- ═══════════════════════════════════════════════════════════════════════════
   721	
   722	-- A versioned job accepts no unversioned verdicts. (Unversioned legacy jobs keep
   723	-- their old semantics; the gatekeeper will not push anything unversioned anyway.)
   724	CREATE TRIGGER IF NOT EXISTS guard_verdict_must_cite_what_it_reviewed
   725	BEFORE INSERT ON verdicts
  1045	    WHERE (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1046	      AND (
  1047	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1048	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role IN ('review','test')
  1049	      ) + NEW.cost_cents
  1050	      > (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id);
  1051	END;
  1052	
  1053	-- Keep updated_at honest.
  1054	CREATE TRIGGER IF NOT EXISTS jobs_touch_updated_at
  1055	AFTER UPDATE ON jobs
  1056	FOR EACH ROW
  1057	BEGIN
  1058	    UPDATE jobs SET updated_at = datetime('now') WHERE id = NEW.id;
  1059	END;
  1060	
  1061	-- ---------------------------------------------------------------------------
  1062	-- The §7 voice query: "what did the overnight run do?"
  1063	-- ---------------------------------------------------------------------------
  1064	CREATE VIEW IF NOT EXISTS job_report AS
  1065	SELECT
  1066	    j.id,
  1067	    j.created_at,
  1068	    j.finished_at,
  1069	    j.request,
  1070	    j.origin,
  1071	    j.builder_seat,
  1072	    s.provider   AS builder_provider,
  1073	    s.tier       AS builder_tier,
  1074	    j.status,
  1075	    j.branch,
  1076	    j.spoken_summary,
  1077	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id)                        AS review_count,
  1078	    (SELECT COUNT(DISTINCT v.model_family) FROM verdicts v WHERE v.job_id = j.id)  AS families_reviewed,
  1079	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id AND v.verdict = 'fail') AS fail_count,
  1080	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id AND v.verdict = 'needs_human') AS escalations
  1081	FROM jobs j
  1082	JOIN seats s ON s.id = j.builder_seat;
   120	
   121	
   122	_BUILDERS = {
   123	    "ollama": _ollama_build,
   124	}
   125	
   126	
   127	# ---------------------------------------------------------------------------
   128	# Optional single reviewer — enough to close the loop and honor the guards.
   129	# The FULL parallel gauntlet is task #10; this is the one real cross-tier pass
   130	# that lets a local job legitimately complete.
   131	# ---------------------------------------------------------------------------
   132	def _claude_review(request: str, code: str) -> tuple[str, str]:
   133	    """A higher-tier model reads the work and judges it. Returns (verdict, summary)."""
   134	    prompt = (
   135	        "You are reviewing another model's code. Reply with EXACTLY one line: "
   136	        "'PASS <one-line reason>' or 'FAIL <one-line reason>'.\n\n"
   137	        f"The task was: {request}\n\nThe code:\n{code}"
   138	    )
   139	    out = subprocess.run(
   140	        ["claude", "-p", prompt], capture_output=True, text=True, timeout=180
   141	    ).stdout.strip()
   142	    verdict = "pass" if out.upper().lstrip().startswith("PASS") else "fail"
   143	    return verdict, out[:280]
   144	
   145	
   146	_REVIEWERS = {
   147	    "claude-cli": _claude_review,
   148	}
   149	
   150	
   151	# ---------------------------------------------------------------------------
   152	# The run loop — everything above, in order, for one job.
   153	# ---------------------------------------------------------------------------
   154	def run_job(job_id: int, *, reviewer_seat: str | None = None) -> dict[str, Any]:
   155	    """Take one recorded job and actually do it. Safe to call in a thread.
   156	
   157	    Opens its own database connection (sqlite + threads). WAL mode lets this write
   158	    while the web server reads. Never raises to the caller — a worker that dies must
   159	    leave a legible 'failed' row, not a stack trace nobody sees.
   160	    """
   161	    conn = connect(DB_PATH)
   162	    try:
   163	        job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   164	        if job is None:
   165	            return {"job_id": job_id, "status": "missing"}
   166	        seat_row = seat(conn, job["builder_seat"])
   167	        if seat_row is None:
   168	            set_status(conn, job_id, "failed", error=f"unknown seat {job['builder_seat']}")
   169	            return {"job_id": job_id, "status": "failed"}
   170	
   171	        builder = _BUILDERS.get(seat_row["provider"])
   172	        if builder is None:
   173	            # A provider we don't have a local runner for (codex/xai/claude-cli builds
   174	            # go through OpenClaw, not this in-process worker). Say so plainly.
   175	            set_status(conn, job_id, "failed",
   176	                       error=f"no in-process builder for provider '{seat_row['provider']}' "
   177	                             "— this seat dispatches through OpenClaw")
   178	            _event(conn, job_id, seat_row, "error",
   179	                   "This worker only runs the local model directly.")
   180	            return {"job_id": job_id, "status": "failed"}
   181	
   182	        # 1. Isolate.
   183	        wt, wt_note = _make_worktree(job_id, job["branch"] or f"job/{job_id}")
   184	        conn.execute("UPDATE jobs SET worktree = ? WHERE id = ?", (str(wt), job_id))
   185	        _event(conn, job_id, seat_row, "dispatched", f"Working in its own copy ({wt_note}).")
   186	
   187	        # 2. Build.
   188	        model = job["tier"] and _model_for(seat_row, job["tier"]) or seat_row["model"]
   189	        _event(conn, job_id, seat_row, "thinking", "Working out how to do it.")
   190	        try:
   191	            result = builder(seat_row, job["request"], model)
   192	        except Exception as exc:  # network, model, timeout — all land here
   193	            set_status(conn, job_id, "failed", error=f"builder error: {exc}")
   194	            _event(conn, job_id, seat_row, "error", "The worker hit a problem.")
   195	            return {"job_id": job_id, "status": "failed"}
   196	
   197	        # 3. Land the output in the isolated copy, and version it.
   198	        out_dir = wt / OUTPUT_DIRNAME
   199	        out_dir.mkdir(parents=True, exist_ok=True)
   200	        (out_dir / f"job_{job_id}.txt").write_text(result)
   201	        version = _version_of(result)
   202	        set_head_version(conn, job_id, version)
   203	        _event(conn, job_id, seat_row, "write",
   204	               f"Wrote {len(result)} characters of work.", target=str(out_dir))
   205	
   206	        # 4. Park for review. The guards will hold it here until a real reviewer passes
   207	        #    THIS version — we never force it past them.
   208	        set_status(conn, job_id, "review", result=result)
   209	
   210	        # 5. If a reviewer is wired and available, run the one real cross-tier pass.
   211	        if reviewer_seat:
   212	            _run_one_review(conn, job_id, job["request"], result, version, reviewer_seat)
   213	
   214	        final = conn.execute("SELECT status FROM jobs WHERE id = ?", (job_id,)).fetchone()["status"]
   215	        return {"job_id": job_id, "status": final, "version": version}
   216	    finally:
   217	        conn.close()
   218	
   219	
   220	def _model_for(seat_row, tier: str) -> str:
   221	    try:
   222	        from tiering import resolve_model
   223	        return resolve_model(seat_row, tier)[0]
   224	    except Exception:
   225	        return seat_row["model"]
   226	
   227	
   228	def _run_one_review(conn, job_id, request, code, version, reviewer_seat) -> None:
   229	    rev = seat(conn, reviewer_seat)
   230	    if rev is None or not rev["enabled"]:
   231	        return
   232	    reviewer = _REVIEWERS.get(rev["provider"])
   233	    if reviewer is None:
   234	        return
   235	    _event(conn, job_id, rev, "thinking", "A stronger model is checking the work.")
   236	    try:
   237	        verdict, summary = reviewer(request, code)
   238	    except Exception as exc:
   239	        _event(conn, job_id, rev, "error", "The reviewer couldn't finish.")
   240	        return
   241	    # reviewed_version defaults to the job's head_version inside record_verdict, which
   242	    # is exactly `version` — so this verdict is bound to what was actually reviewed.
   243	    try:
   244	        record_verdict(conn, job_id, reviewer_seat, verdict=verdict,
   245	                       summary=summary, role="reviewer")
   246	    except GuardViolation:
   247	        return
   248	    _event(conn, job_id, rev, "verdict", "Passed the check." if verdict == "pass"
   249	           else "Sent it back with notes.")
   250	
   251	    if verdict == "pass":
   252	        try:
   253	            set_status(conn, job_id, "done",
   254	                       spoken_summary="Built and checked. Ready for you.")
   255	        except GuardViolation:
   256	            # Some other gate still holds (e.g. panel size). Leave it parked, honestly.
   257	            pass
   258	
   259	
   260	# ---------------------------------------------------------------------------
   261	# Fire-and-forget: start a worker in the background so the app stays responsive.
   262	# ---------------------------------------------------------------------------
   263	def start_in_background(job_id: int, *, reviewer_seat: str | None = None) -> threading.Thread:
   264	    t = threading.Thread(
   265	        target=run_job, args=(job_id,), kwargs={"reviewer_seat": reviewer_seat},
   266	        name=f"job-{job_id}", daemon=True,
   267	    )
   268	    t.start()
   269	    return t
     1	"""The family floor — the gauntlet's core property, now a DB guard (task #10).
     2	
     3	Sol's #10 gate: "at least two model FAMILIES reviewed this" was enforced nowhere in the
     4	database — it lived in a config value and a comment, so it rested on Python being right.
     5	These tests prove the schema now refuses to complete a job unless enough DISTINCT
     6	families actually passed it, on the current version, and that the floor can't be lowered
     7	after the fact.
     8	
     9	A guard trips the same way through the helpers or raw SQL — that's the point.
    10	"""
    11	
    12	import sqlite3
    13	import sys
    14	from pathlib import Path
    15	
    16	import pytest
    17	
    18	sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    19	
    20	from db.jobs import (  # noqa: E402
    21	    GuardViolation, Seat, connect, create_job, init_db, record_verdict,
    22	    set_status, upsert_seat,
    23	)
    24	
    25	BLOCKED = (GuardViolation, sqlite3.IntegrityError)
    26	
    27	# Two seats share the GPT family on purpose — a "full panel" of distinct seats can still
    28	# be a single mind wearing several hats, which is exactly what the family floor catches.
    29	SEATS = [
    30	    Seat("riggs", "claude-cli", "claude-opus-4-8", "claude", "subscription"),
    31	    Seat("sol",   "codex",      "gpt-5.6-sol",     "gpt",    "subscription"),
    32	    Seat("sol2",  "codex",      "gpt-5.6-terra",   "gpt",    "subscription"),
    33	    Seat("grok",  "xai",        "grok-4.5",        "grok",   "metered", daily_cap_cents=100),
    34	]
    35	
    36	
    37	@pytest.fixture()
    38	def conn(tmp_path):
    39	    c = connect(tmp_path / "t.db")
    40	    init_db(c)
    41	    for s in SEATS:
    42	        upsert_seat(c, s)
    43	    return c
    44	
    45	
    46	def _job(conn, families):
    47	    # Builder is subscription-tier (not local) so the higher-tier guard doesn't also
    48	    # fire — we're isolating the FAMILY floor here.
    49	    job = create_job(conn, "the login form", builder_seat="riggs")
    50	    conn.execute(
    51	        "UPDATE jobs SET required_reviews=2, required_review_families=?, head_version='v1' "
    52	        "WHERE id=?", (families, job),
    53	    )
    54	    return job
    55	
    56	
    57	def test_a_full_panel_of_one_family_does_not_complete(conn):
    58	    """Two DISTINCT seats pass — but both are GPT. Seat count is satisfied; the family
    59	    floor is not. The job must NOT reach done."""
    60	    job = _job(conn, families=2)
    61	    record_verdict(conn, job, "sol",  verdict="pass")   # gpt
    62	    record_verdict(conn, job, "sol2", verdict="pass")   # gpt again — different seat, same mind
    63	    with pytest.raises(BLOCKED, match="fewer model families"):
    64	        set_status(conn, job, "done")
    65	
    66	
    67	def test_two_families_satisfy_the_floor(conn):
    68	    job = _job(conn, families=2)
    69	    record_verdict(conn, job, "sol",  verdict="pass")   # gpt
    70	    record_verdict(conn, job, "grok", verdict="pass")   # grok — a second family
    71	    set_status(conn, job, "done")
    72	    assert conn.execute("SELECT status FROM jobs WHERE id=?", (job,)).fetchone()[0] == "done"
    73	
    74	
    75	def test_only_current_version_families_count(conn):
    76	    """A pass on an earlier version is history, not a vote on what's on the table now."""
    77	    job = _job(conn, families=2)
    78	    record_verdict(conn, job, "grok", verdict="pass", reviewed_version="OLD")  # stale
    79	    record_verdict(conn, job, "sol",  verdict="pass")                          # current (v1)
    80	    # Only one CURRENT-version family (gpt) — the stale grok pass doesn't count.
    81	    with pytest.raises(BLOCKED, match="fewer model families"):
    82	        set_status(conn, job, "done")
    83	
    84	
    85	def test_the_family_floor_cannot_be_lowered_after_dispatch(conn):
    86	    job = _job(conn, families=2)
    87	    with pytest.raises(BLOCKED, match="family floor cannot be lowered"):
    88	        conn.execute("UPDATE jobs SET required_review_families=1 WHERE id=?", (job,))
    89	
    90	
    91	def test_a_zero_floor_is_inert_for_legacy_jobs(conn):
    92	    """Existing rows default to 0 — the guard must not retroactively block them."""
    93	    job = _job(conn, families=0)
    94	    record_verdict(conn, job, "sol",  verdict="pass")
    95	    record_verdict(conn, job, "sol2", verdict="pass")
    96	    set_status(conn, job, "done")   # required_reviews=2 met, family floor inert at 0
    97	    assert conn.execute("SELECT status FROM jobs WHERE id=?", (job,)).fetchone()[0] == "done"
     1	"""The live database must carry the same guards the tests test.
     2	
     3	Every other test in this suite builds a FRESH database from schema.sql and proves
     4	the guards hold there. None of that says anything about harness/db/chief.db — and
     5	on 2026-07-20 the live DB turned out to be missing two guards (verdict deletion,
     6	born-granted approvals) and running a stale panel guard, months of green tests
     7	notwithstanding. Sol's build gate 1: the live DB must match the hardened rules.
     8	
     9	These tests skip cleanly when no live DB exists (fresh checkout, CI).
    10	"""
    11	
    12	import sqlite3
    13	from pathlib import Path
    14	
    15	import pytest
    16	
    17	HARNESS = Path(__file__).resolve().parent.parent
    18	SCHEMA = HARNESS / "db" / "schema.sql"
    19	LIVE_DB = HARNESS / "db" / "chief.db"
    20	
    21	pytestmark = pytest.mark.skipif(
    22	    not LIVE_DB.exists(), reason="no live database on this machine"
    23	)
    24	
    25	
    26	def _object_names(conn: sqlite3.Connection, kind: str) -> set[str]:
    27	    rows = conn.execute(
    28	        "SELECT name FROM sqlite_master WHERE type = ? AND name NOT LIKE 'sqlite_%'",
    29	        (kind,),
    30	    )
    31	    return {r[0] for r in rows}
    32	
    33	
    34	def _columns(conn: sqlite3.Connection, table: str) -> set[tuple]:
    35	    # (name, type, notnull, default) — column ORDER is allowed to differ, because
    36	    # ALTER TABLE ADD COLUMN appends and that is how live migrations happen.
    37	    rows = conn.execute(f"PRAGMA table_info({table})")
    38	    return {(r[1], r[2], r[3], r[4]) for r in rows}
    39	
    40	
    41	def _normalized_trigger_sql(conn: sqlite3.Connection) -> dict[str, str]:
    42	    rows = conn.execute("SELECT name, sql FROM sqlite_master WHERE type = 'trigger'")
    43	    # Whitespace and comments may drift between schema.sql and a migration; the
    44	    # executable text must not. Strip comment lines, collapse whitespace.
    45	    out = {}
    46	    for name, sql in rows:
    47	        lines = [
    48	            line.split("--")[0] for line in sql.splitlines()
    49	        ]
    50	        out[name] = " ".join(" ".join(lines).split())
    51	    return out
    52	
    53	
    54	@pytest.fixture(scope="module")
    55	def fresh():
    56	    conn = sqlite3.connect(":memory:")
    57	    conn.executescript(SCHEMA.read_text())
    58	    yield conn
    59	    conn.close()
    60	
    61	
    62	@pytest.fixture(scope="module")
    63	def live():
    64	    # Read-only: this test must never be able to touch the record.
    65	    conn = sqlite3.connect(f"file:{LIVE_DB}?mode=ro", uri=True)
    66	    yield conn
    67	    conn.close()
    68	
    69	
    70	def test_live_db_has_every_table(fresh, live):
    71	    assert _object_names(fresh, "table") <= _object_names(live, "table")
    72	
    73	
    74	def test_live_db_has_every_view(fresh, live):
    75	    assert _object_names(fresh, "view") <= _object_names(live, "view")
    76	
    77	
    78	def test_live_db_has_every_guard_with_identical_teeth(fresh, live):
    79	    fresh_triggers = _normalized_trigger_sql(fresh)
    80	    live_triggers = _normalized_trigger_sql(live)
    81	    missing = set(fresh_triggers) - set(live_triggers)
    82	    assert not missing, f"live DB is missing guards: {sorted(missing)}"
    83	    stale = {
    84	        name
    85	        for name, sql in fresh_triggers.items()
    86	        if live_triggers[name] != sql
    87	    }
    88	    assert not stale, f"live DB guards differ from schema.sql: {sorted(stale)}"
    89	
    90	
    91	def test_live_db_tables_have_every_column(fresh, live):
    92	    for table in _object_names(fresh, "table"):
    93	        missing = _columns(fresh, table) - _columns(live, table)
    94	        assert not missing, f"live {table} is missing columns: {sorted(missing)}"
     1	"""The gauntlet config must actually load and name real seats.
