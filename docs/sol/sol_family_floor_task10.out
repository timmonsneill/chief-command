   359	def test_a_family_cannot_fact_check_its_own_research(conn):
   360	    """The exact hole that let the Grok number through.
   361	
   362	    A family that got a fact wrong will re-read its own sources and find them
   363	    convincing — it made the same inference the first time. Only a different mind
   364	    reads them cold.
   365	    """
   366	    job = _research_job(conn, seat="orchestrator")  # gpt
   367	    record_artifact(conn, job, kind="source", path="https://x.ai", captured_by="model")
   368	
   369	    with pytest.raises(GuardViolation, match="may not fact-check its own research"):
   370	        record_verdict(conn, job, "orchestrator", verdict="pass", role="verifier")
   371	
   372	
   373	def test_a_different_family_can_fact_check_it(conn):
   374	    job = _research_job(conn, seat="orchestrator")  # gpt built it
   375	    record_artifact(conn, job, kind="source", path="https://x.ai", captured_by="model")
