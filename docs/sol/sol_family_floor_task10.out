    41	def test_inline_slash_comment_stripped_but_urls_survive():
    42	    # The whole reason the naive stripper broke: value strings hold https://.
    43	    assert _strip_slash_comment('base_url = "https://api.x.ai/v1"  // swap me') \
    44	        == 'base_url = "https://api.x.ai/v1"'
    45	    assert _strip_slash_comment('// a whole-line comment') == ''
    46	    assert _strip_slash_comment('model = "grok-4.5"') == 'model = "grok-4.5"'
    47	
