    49	def test_sync_seats_refuses_a_phantom_reviewer(tmp_path):
    50	    c = connect(tmp_path / "t.db")
    51	    init_db(c)
    52	    bad = {"seats": {"real": {"provider": "p", "model": "m", "family": "claude", "tier": "t"}},
    53	           "gauntlet": {"reviewers": ["real", "grinder_paid"]}}
    54	    with pytest.raises(DispatchRefused):
    55	        sync_seats(c, bad)
    56	
    57	
    58	def test_sync_seats_refuses_a_familyless_seat(tmp_path):
    59	    c = connect(tmp_path / "t.db")
    60	    init_db(c)
    61	    bad = {"seats": {"nofam": {"provider": "p", "model": "m", "tier": "t"}},
    62	           "gauntlet": {"reviewers": []}}
    63	    with pytest.raises(DispatchRefused):
    64	        sync_seats(c, bad)

