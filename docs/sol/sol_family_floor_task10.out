    80	def test_different_keys_are_different_jobs(conn):
    81	    a = dispatch.dispatch_local(conn, "build X", "grinder_local", dispatch_key="k1", start=False)
    82	    b = dispatch.dispatch_local(conn, "build Y", "grinder_local", dispatch_key="k2", start=False)
    83	    assert a.job_id != b.job_id
    84	
