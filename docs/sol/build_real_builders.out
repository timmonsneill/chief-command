--- /dev/null
+++ b/harness/.real-builders-test-bin/claude
@@ -0,0 +1,7 @@
+#!/bin/sh
+if [ "$1" = "auth" ] && [ "$2" = "status" ]; then
+    echo '{"loggedIn": true}'
+    exit 0
+fi
