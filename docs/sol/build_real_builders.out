     builder_tier   TEXT NOT NULL DEFAULT 'local'
                    CHECK (builder_tier IN ('local','subscription','metered')),
     builder_family TEXT NOT NULL DEFAULT 'unknown',
+
+    -- WHAT SHAPE the reviewed bundle is (task #9, migration 008). 'text' = one
