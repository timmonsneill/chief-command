452-def _abort_any_merge() -> None:
453-    """Undo a half-finished merge — and ONLY a half-finished merge.
454-
455-    `git merge --abort` is `git reset --merge` underneath, which will discard the
456-    owner's uncommitted work if no merge is actually in progress. Check first.
457-    """
458-    if (REPO / ".git" / "MERGE_HEAD").exists():
459-        subprocess.run(["git", "merge", "--abort"], cwd=REPO, capture_output=True)
