365-def _same_commit(tip: str, version: str) -> bool:
366-    """Is the reviewed version this exact commit?
367-
368-    `head_version` is a short id, so compare on the shorter length. A version that is
369-    not a commit id at all (the local worker records a content hash) can never match,
370-    which is correct: if we cannot prove the reviewed thing is this code, we do not
371-    merge it.
372-    """
373-    version = (version or "").strip().lower()
374-    tip = (tip or "").strip().lower()
375-    if len(version) < 7 or not re.fullmatch(r"[0-9a-f]+", version):
376-        return False
377-    return tip.startswith(version)
