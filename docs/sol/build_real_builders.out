+
+# ---------------------------------------------------------------------------
+# Process environment and standalone-clone isolation
+# ---------------------------------------------------------------------------
+def test_builder_process_receives_only_path_and_home(tmp_path, monkeypatch):
+    clone = tmp_path / "clone"
+    clone.mkdir()
+    seen = {}
