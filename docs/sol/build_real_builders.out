sed -n '620,720p' harness/db/schema.sql
rg -n -A115 -B20 '"'^def _ask_to_ship'"' harness/gauntlet.py
rg -n -A80 -B40 '"'^def _commit_holds_the_reviewed_work|''^def _unreviewed_files_in|''^def merge'"\\(' harness/gatekeeper.py
