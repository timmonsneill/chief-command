   156	
   157	def ask_chief(said: str, context: str = "", pushed_back: bool = False) -> dict[str, Any]:
   158	    """Everything Neill says comes through here. Chief decides.
   159	
   160	    Returns both a SPOKEN answer (short, for the voice) and the full text (for the log)
   161	    — the same two-channel split we use everywhere: fast in the ear, complete on screen.
   162	    """
   163	    call = tier_for_talk(said, pushed_back=pushed_back)
   164	    model = CHIEF_DEEP if call.tier == HEAVY else CHIEF_MODEL
   165	    effort = "high" if call.tier == HEAVY else "low"
   166	
   167	    prompt = CHIEF_PROMPT
   168	    if context:
   169	        prompt += f"\n\n## WHAT YOU WERE JUST TALKING ABOUT\n{context}"
   170	    prompt += f"\n\n## HE JUST SAID\n{said}"
   171	
   172	    t0 = time.time()
   173	    try:
   174	        out = subprocess.run(
   175	            ["codex", "exec", "--skip-git-repo-check", "-m", model,
   176	             "-c", f"model_reasoning_effort={effort}", prompt],
   177	            capture_output=True, text=True,
   178	            timeout=45 if call.tier != HEAVY else 300,
   179	        )
   180	        answer = _clean(out.stdout)
   181	    except subprocess.TimeoutExpired:
   182	        # Sol: "The system needs a safe failure mode when Chief is unavailable."
   183	        # If Chief can't answer, we do NOT fall back to a dumber model making the call.
   184	        # We say so and do nothing. Silence is safer than an unsupervised guess.
   185	        return {
   186	            "spoken": "I'm having trouble thinking that through right now. Nothing's started.",
   187	            "full": "Chief timed out. No work was dispatched.",
   188	            "tier": call.tier, "seconds": round(time.time() - t0, 1), "failed": True,
   189	        }
   190	
   191	    if not answer.strip():
   192	        return {
   193	            "spoken": "Something went wrong on my end. Nothing's started.",
   194	            "full": "Chief returned nothing. No work was dispatched.",
   195	            "tier": call.tier, "seconds": round(time.time() - t0, 1), "failed": True,
   196	        }
   197	
   198	    return {
   199	        "spoken": _for_speech(answer),
   200	        "full": answer,
   201	        "tier": call.tier,
   202	        "why_tier": call.reason,
   203	        "model": model,
   204	        "seconds": round(time.time() - t0, 1),
   205	        "failed": False,
   206	    }
   207	
   208	
   209	def _clean(raw: str) -> str:
   210	    """Codex echoes the prompt, then 'codex', then the answer, then 'tokens used'."""
   230	    r"\bmake sense\b", r"\bright\?*$",
   231	]
   232	
   233	
   234	def needs_the_brain(utterance: str) -> bool:
   235	    """Should this reach the smarter mind?
   236	
   237	    DEFAULT: YES. The mouth keeps a job only if it matches the allow-list, contains
   238	    nothing that gives it away as a conversation, AND isn't dangerous.
   239	
   240	    The asymmetry is the whole design:
   241	      - escalating needlessly costs ~8 seconds
   242	      - answering something it shouldn't have costs Neill's trust in the whole thing
   243	    Those are not close. Bias all the way toward reaching.
   244	    """
   245	    u = utterance.strip().lower()
   246	
   247	    # A question, a hedge, or an opinion word — it's a conversation, whatever it starts with.
   248	    if any(re.search(p, u) for p in _NOT_ACTUALLY_A_COMMAND):
   249	        return True
   250	
   251	    # A DANGEROUS ORDER DESERVES A MOMENT'S THOUGHT BEFORE IT IS OBEYED.
   252	    #
   253	    # Sol's review caught "Run production without a backup" sailing straight through as
   254	    # a routine dispatch. It's command-shaped, so the grammar checks all pass — but a
   255	    # fast model that cheerfully obeys that is not a feature, it's a loaded gun.
   256	    #
   257	    # So anything touching auth, money, patient data, deletion, migrations or production
   258	    # goes upstairs first. Not to refuse it — to think for eight seconds and, if it's
   259	    # alarming, say so before doing it.
   260	    from tiering import _RISKY  # noqa: PLC0415  (single source of truth for "dangerous")
   261	    if any(re.search(p, u) for p in _RISKY):
   262	        return True
   263	
   264	    # "go deep", "think hard", "be careful" — he's explicitly asking for the good brain.
   265	    from tiering import _HE_ASKED  # noqa: PLC0415
   266	    if any(re.search(p, u) for p in _HE_ASKED):
   267	        return True
   268	
   269	    if not any(re.search(p, u) for p in _MAY_ANSWER_ALONE):
   270	        return True
   271	
   272	    # A matched command buried in a longer thought is him THINKING, not commanding.
   273	    return len(u.split()) > 14
   274	
   275	
   276	# ═══════════════════════════════════════════════════════════════════════════════
   277	# THE THREE TIERS — and the MEASURED numbers that decided them
   278	#
   279	# Benchmarked on this machine, 2026-07-13, on a real question of Neill's (not a toy):
   280	#
   281	#   MOUTH (voice model)     < 1s     dispatch, status, banter. Never thinks.
   282	#   CLAUDE                  ~8s      ← THE THINKING TIER. Genuinely good answer.
   283	#   GROK                    ~5s      faster, but it produced WAFFLE — restated the
   284	#                                    question poetically and said nothing. Rejected.
   285	#   SOL, low effort         > 60s    fine on a trivial question, slow on a real one.
   286	#   SOL, default effort     > 300s   unusable in conversation. Reserved for pushback.
   287	#
   288	# THE FINDING: eight seconds of a real answer beats five seconds of noise. Speed only
   289	# matters if the thing it says is worth hearing.
   290	#
   291	# So the thinking tier is CLAUDE, not Grok and not Sol-at-low-effort. It is also the
   292	# cheapest possible choice — Claude is flat-rate subscription, so conversation costs
   293	# NOTHING marginal. Grok would have been metered. We get the better answer for free.
   294	#
   295	# SOL is still here, but only where it earns its keep: when Neill pushes back and
   296	# says "that's not smart enough". He explicitly opted into that wait:
   297	#     "if i push and say hey this isn't that smart... it goes to the higher effort.
   298	#      I don't mind sometimes waiting when i need it to."
   299	# ═══════════════════════════════════════════════════════════════════════════════
   300	
   301	THINK_FAST = "claude"   # ~8s   — the default. Smart, plain-spoken, free.
   302	THINK_HARD = "sol"      # slow  — earned by pushback, never guessed at.
   303	
   304	# He told us exactly what pushback sounds like.
   305	# ⚠️ Sol, round 2, #11: "Pushback detection loses ordinary dissatisfaction. Phrases
   306	# such as 'I disagree', 'you misunderstood me', 'that misses the point', 'I'm not
   307	# convinced', 'why would we do that?', 'that worries me', and 'no, because…' are missed."
   308	#
   309	# He's right — I'd only caught the loud, obvious pushback. Most disagreement is quieter
   310	# than that, and a quiet correction that gets a shallow answer is worse than a loud one,
   311	# because Neill won't push twice.
   312	_PUSHBACK = [
   313	    # loud
   314	    r"not (that )?smart", r"doesn'?t make sense", r"that'?s not right", r"that'?s wrong",
   315	    r"think (harder|again|more)", r"try again", r"you'?re missing", r"that'?s not it",
   316	    r"doesn'?t work", r"not (good|great) enough", r"go deeper", r"really think",
   317	    r"are you sure", r"that'?s (shallow|thin|weak|lazy)", r"come on", r"do better",
   318	    r"dig in", r"nah\b",
   319	    # quiet — the ones Sol caught me missing
   320	    r"\bi disagree\b", r"\bi don'?t (agree|buy|believe|think)\b",
   321	    r"\bnot convinced\b", r"\byou misunderstood\b", r"\bmisses the point\b",
   322	    r"\bthat'?s not what i (meant|said|asked)\b", r"\byou'?re not (getting|hearing)\b",
   323	    r"\bworries me\b", r"\bthat concerns me\b", r"\bhmm\b.*\bbut\b",
   324	    r"^no,? (but|because|i|that|it)\b", r"\bi'?d push back\b",
   325	    r"\bfeels? (off|wrong|thin|shallow)\b", r"\bis that really\b",
   326	    r"\bwhy would we\b", r"\bsurely\b",
   327	]
   328	
   329	
   330	def is_pushback(utterance: str) -> bool:
   331	    """Did he just tell us the last answer wasn't good enough?
   332	
   333	    If so, the SAME question goes back — to the slow model, at full effort. He has
   334	    opted into the wait by pushing.
   335	    """
   336	    return any(re.search(p, utterance.strip().lower()) for p in _PUSHBACK)
   337	
   338	
   339	DIGGING_IN_LINES = [
   340	    "Fair. Let me actually sit with that one.",
   341	    "You're right, that was thin. Give me a proper minute.",
   342	    "Okay — let me think about it properly this time.",
   343	    "Yeah, that deserves better. Hang on.",
   344	]
   345	
   346	
   347	def dig_in() -> str:
   348	    return random.choice(DIGGING_IN_LINES)
   349	
   350	
   351	_SPEECH_BRIEF = """You are the thinking half of Chief, a voice assistant. Neill is
   352	listening to your answer OUT LOUD, in a car. He cannot read it.
   353	
   354	WHO HE IS:
   355	- He CANNOT read or write code. His words: "I know Spanish 101, that's it."
   356	- NEVER use filenames, tool names, or jargon. Say what happened to the THING.
   357	- He is SHARP. Don't talk down to him. Just never assume programming knowledge.
   358	
   359	HOW YOU'LL BE HEARD:
   360	- Someone is going to SAY this to him. Not read it. SAY it.
   361	- No headers. No bullets. No markdown. No "firstly".
   362	- LEAD WITH THE ANSWER in the first sentence. He asked something — answer it.
   363	- Then two or three sentences of why. That's all.
   364	- If there's genuinely more, end with "there's more if you want it."
   365	- Think as hard as you like. Just don't SHOW the thinking — show the conclusion.
   366	
   367	Talk like a smart friend in a car who was asked a real question."""
   368	
   369	
   370	def think(question: str, context: str = "", tier: str = THINK_FAST) -> tuple[str, float]:
   371	    """Go and actually think about something. Returns (answer, seconds).
   372	
   373	    tier=THINK_FAST (~8s)  Claude. The default. Smart, fast enough to feel like a
   374	                           pause rather than a hang, and free (flat-rate seat).
   375	    tier=THINK_HARD (slow) Sol at full effort. ONLY on pushback — he has to have
   376	                           asked for the wait.
   377	    """
   378	    harder = ""
   379	    if tier == THINK_HARD:
   380	        harder = ("\n\nHE HAS ALREADY PUSHED BACK ON A SHALLOWER ANSWER. He is waiting "
   381	                  "on you deliberately, and he knows it's costing him time. Do NOT hand "
   382	                  "him the obvious take again. Question the premise. Tell him something "
   383	                  "he has not thought of. EARN THE WAIT.")
   384	
   385	    prompt = f"{_SPEECH_BRIEF}{harder}\n\n"
   386	    if context:
   387	        prompt += f"CONTEXT: {context}\n\n"
   388	    prompt += f"NEILL ASKED: {question}"
   389	
   390	    t0 = time.time()
   391	    if tier == THINK_FAST:
   392	        out = subprocess.run(["claude", "-p", prompt],
   393	                             capture_output=True, text=True, timeout=120)
   394	        answer = out.stdout.strip()
   395	    else:
   396	        out = subprocess.run(
   397	            ["codex", "exec", "--skip-git-repo-check", "-c", "model_reasoning_effort=high", prompt],
   398	            capture_output=True, text=True, timeout=600,
   399	        )
   400	        answer = out.stdout.strip()
   401	        for m in ("\ncodex\n",):
   402	            if m in answer:
   403	                answer = answer.split(m)[-1]
   404	        answer = re.split(r"\ntokens used\n", answer)[0]
   405	
   406	    return _strip_for_speech(answer), time.time() - t0
   407	
   408	
   409	def _strip_for_speech(text: str) -> str:
   410	    """Last line of defence. The models are told not to write markdown; sometimes they
   411	    do it anyway. Nobody should ever hear "hash hash" or "asterisk asterisk"."""
   412	    text = re.sub(r"^#+\s*", "", text, flags=re.MULTILINE)
   413	    text = re.sub(r"\*\*(.+?)\*\*", r"\1", text)
   414	    text = re.sub(r"`(.+?)`", r"\1", text)
   415	    text = re.sub(r"^[-*]\s+", "", text, flags=re.MULTILINE)
   416	    text = re.sub(r"\n{2,}", " ", text)
   417	    return " ".join(text.split()).strip()

