    28	app = FastAPI(title="Chief Command")
    29	
    30	DB = Path(__file__).resolve().parent / "db" / "chief.db"
    31	
    32	FAMILY_COLOR = {"claude": "#FF8A3D", "gpt": "#00E5A0", "grok": "#B06CFF", "qwen": "#2E9BFF"}
    33	
    34	
    35	def db():
    36	    c = connect(DB)
    37	    init_db(c)
    38	    return c
