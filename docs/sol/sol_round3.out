   318	def spend_today(conn: sqlite3.Connection, seat_id: str) -> int:
   319	    row = conn.execute(
   320	        "SELECT COALESCE(SUM(cost_cents), 0) AS c FROM usage WHERE seat_id = ? AND day = date('now')",
   285	import os  # noqa: E402
   286	
   287	import httpx  # noqa: E402
   288	
   289	from chief import ASK_CHIEF_TOOL, MOUTH_INSTRUCTIONS, ask_chief  # noqa: E402
   290	
   291	VOICE_MODEL = "gpt-realtime-2.1"   # the FULL model, NOT mini.
   292	# Mini has an open, unresolved bug where it refuses to call function tools. For a
   293	# telephone whose entire job is placing one call, that is fatal — you'd speak into
   294	# the car and nothing would happen. ~$50/mo more to remove the single point of
   295	# failure from the whole system. Cheapest insurance on the board.
   296	
   297	
   298	@app.get("/api/voice/token")
   299	async def voice_token():
   300	    """Mint a SHORT-LIVED client token so the real API key never reaches the browser.
   301	
   302	    The browser talks straight to OpenAI (that's what keeps the audio fast — it doesn't
   303	    bounce through this Mac). But it must never hold the key that can spend money, so
   304	    it gets a token that expires in a minute and can do nothing but start one session.
   305	    """
   306	    key = os.environ.get("OPENAI_API_KEY")
   307	    if not key:
   308	        return JSONResponse({"error": "no OpenAI key configured"}, status_code=503)
   309	
   310	    # Refuse to start a session we can't afford. Sol: "a safe failure mode when Chief
   311	    # is unavailable" — same principle for the money. Better to not start than to be
   312	    # cut off mid-sentence by OpenAI's own cap.
   313	    m = month_spend(db())
   314	    if m["spent_cents"] >= m["cap_cents"]:
   315	        return JSONResponse(
   316	            {"error": f"You're at your ${m['cap_cents']/100:.0f} monthly limit. "
   317	                      "Voice is off until you raise it."},
   318	            status_code=402,
   319	        )
   320	
   321	    async with httpx.AsyncClient(timeout=20) as http:
   322	        r = await http.post(
   323	            "https://api.openai.com/v1/realtime/client_secrets",
   324	            headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
   325	            json={
   326	                "session": {
   327	                    "type": "realtime",
   328	                    "model": VOICE_MODEL,
   329	                    "instructions": MOUTH_INSTRUCTIONS,
   330	                    "tools": [ASK_CHIEF_TOOL],
   331	                    "tool_choice": "auto",
   332	                    "audio": {
   333	                        "input": {
   334	                            # SEMANTIC turn detection, not plain silence detection.
   335	                            # A driver pauses mid-sentence to merge; silence-based VAD
   336	                            # cuts him off. Semantic judges whether he SOUNDED finished.
   337	                            "turn_detection": {"type": "semantic_vad", "eagerness": "low",
   338	                                               "interrupt_response": True},
   339	                        },
   340	                        "output": {"voice": "cedar"},
   341	                    },
   342	                }
   343	            },
   344	        )
   345	    if r.status_code >= 400:
   346	        return JSONResponse({"error": r.text[:300]}, status_code=r.status_code)
   347	    return r.json()
   348	
   349	
   350	@app.post("/api/voice/ask")
   351	async def voice_ask(request: Request):
   352	    """The mouth's ONE tool. Everything Neill says arrives here and goes to Chief.
   353	
   354	    The mouth decides nothing. It doesn't even decide whether something is worth
   355	    sending — because "is this worth sending?" is a judgment, and judgments are where
   260	--
   261	-- He's right, and it's the difference between a bank with a vault and a bank with an
   262	-- attentive guard. You do not stop a robbery by watching carefully.
   263	--
   264	-- SO: agents get NO dangerous powers. Not "Chief will stop them" — THEY CANNOT.
   265	-- Reading code, writing code in their own worktree, running tests: always fine, and
   266	-- that's 95% of the work. Everything that touches the real world is denied by
   267	-- default and needs a signed, single-use permission slip for that exact act.
   268	-- ═══════════════════════════════════════════════════════════════════════════════
   269	CREATE TABLE IF NOT EXISTS capabilities (
   270	    seat_id       TEXT NOT NULL REFERENCES seats(id) ON DELETE CASCADE,
   271	    capability    TEXT NOT NULL CHECK (capability IN (
   272	                      -- SAFE. Granted to every builder. This is the actual job.
   273	                      'read_code', 'write_worktree', 'run_tests', 'open_pr',
   274	                      -- DANGEROUS. Denied to everyone by default. Each needs a
   275	                      -- fresh, single-use approval naming the exact action.
   276	                      'touch_production', 'delete_data', 'run_migration',
   277	                      'deploy', 'merge_to_main', 'force_push',
   278	                      'read_secrets', 'send_external', 'spend_money'
   279	                  )),
   280	    PRIMARY KEY (seat_id, capability)
   281	);
   282	
   283	-- The safe set. Everything an agent needs to actually build software, and nothing
   284	-- that can hurt you. Note what ISN'T here — that's the whole point.
   285	CREATE VIEW IF NOT EXISTS safe_capabilities AS
   286	SELECT 'read_code' AS capability UNION ALL SELECT 'write_worktree'
   287	UNION ALL SELECT 'run_tests' UNION ALL SELECT 'open_pr';
   288	
   289	-- ═══════════════════════════════════════════════════════════════════════════════
   290	-- APPROVALS — a signed, single-use permission slip for ONE exact dangerous act.
   291	--
   292	-- Sol on why a "yes" cannot be trusted on its own:
   293	--
   294	--     Chief: "First make a backup, then remove the old accounts."
   295	--     Neill: "Yes — skip the first one."
   296	--
   297	--     "That LOOKS like a confirmation, but it changes the safe plan into a dangerous
   298	--      one. Sending it directly recreates the original classification problem."
   299	--
   300	-- So an approval is not a word. It is a ROW: a numbered, one-time permission for a
   301	-- specific action, with the consequence written out in plain English and READ BACK to
   302	-- Neill before he can agree. It expires the moment the plan changes.
   303	--
   304	--     "A bare 'yes' should never approve something that was not just read back
   305	--      exactly." — which also handles the fact that a car is a terrible place to be
   306	--      understood correctly.
   307	-- ═══════════════════════════════════════════════════════════════════════════════
   308	CREATE TABLE IF NOT EXISTS approvals (
   309	    id            INTEGER PRIMARY KEY,
   310	    job_id        INTEGER REFERENCES jobs(id) ON DELETE CASCADE,
   311	    capability    TEXT NOT NULL,            -- the ONE dangerous thing this permits
   312	    -- Exactly what will happen. Not a category — the actual act.
   313	    action        TEXT NOT NULL,            -- "delete 4,200 accounts inactive since 2024-01-01"
   314	    -- What Chief SAID OUT LOUD to Neill before he agreed. If this is empty, nothing
   315	    -- was read back, and a 'yes' means nothing.
   316	    read_back     TEXT NOT NULL,
   317	    -- Is this undoable, and how? Sol: "Anything irreversible needs a tested recovery
   318	    -- method BEFORE it starts."
   319	    reversible    INTEGER NOT NULL DEFAULT 0 CHECK (reversible IN (0,1)),
   320	    recovery      TEXT,                     -- "restore from the snapshot taken at 09:14"
   321	
   322	    granted_by    TEXT NOT NULL DEFAULT 'owner' CHECK (granted_by = 'owner'),
   323	    granted_at    TEXT,
   324	    expires_at    TEXT NOT NULL,            -- short. Minutes, not hours.
   325	    used_at       TEXT,                     -- single use. Once spent, it's spent.
   326	    revoked_at    TEXT,
   327	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   328	);
   329	
   330	CREATE INDEX IF NOT EXISTS idx_approvals_job ON approvals(job_id);
   331	
   332	-- ═══════════════════════════════════════════════════════════════════════════════
   333	-- GUARD 12 — a dangerous act needs a live, unused, read-back approval.
   334	-- No approval, no action. Not "Chief said it was fine" — a signed slip, or nothing.
   335	-- ═══════════════════════════════════════════════════════════════════════════════
   336	CREATE VIEW IF NOT EXISTS live_approvals AS
   337	SELECT * FROM approvals
   338	 WHERE granted_at IS NOT NULL
   339	   AND used_at    IS NULL
   340	   AND revoked_at IS NULL
   341	   AND expires_at > datetime('now')
   342	   AND TRIM(read_back) <> '';
   343	
   344	-- An approval may never be BORN granted. (Sol, round 3 — verified 2026-07-14.)
   345	--
   346	-- Every approval guard fired on UPDATE OF granted_at only — the exact "born done" hole
   347	-- Sol found on the jobs table in round 1, never applied here. Confirmed with a live
   348	-- exploit: an INSERT with granted_at already set, reversible=0 and no recovery plan sailed
   349	-- straight into the live_approvals view. An approval must be born ungranted and become
   350	-- granted through an UPDATE, where the read-back and recovery guards below actually fire.
   351	CREATE TRIGGER IF NOT EXISTS guard_no_approval_is_born_granted
   352	BEFORE INSERT ON approvals
   353	WHEN NEW.granted_at IS NOT NULL
   354	BEGIN
   355	    SELECT RAISE(ABORT, 'guard: an approval cannot be created already granted — it must be granted through a read-back');
   356	END;
   357	
   358	-- An approval cannot be granted without something having been read back.
   359	CREATE TRIGGER IF NOT EXISTS guard_no_approval_without_readback
   360	BEFORE UPDATE OF granted_at ON approvals
   361	WHEN NEW.granted_at IS NOT NULL AND TRIM(COALESCE(NEW.read_back, '')) = ''
   362	BEGIN
   363	    SELECT RAISE(ABORT, 'guard: nothing was read back to him — a yes to nothing is not a yes');
   364	END;
   365	
   366	-- An irreversible act cannot be approved without a recovery plan.
   367	-- Sol: "'Kill' must never be presented as 'undo.'"
   368	CREATE TRIGGER IF NOT EXISTS guard_irreversible_needs_a_way_back
   369	BEFORE UPDATE OF granted_at ON approvals
   370	WHEN NEW.granted_at IS NOT NULL AND NEW.reversible = 0
   371	     AND TRIM(COALESCE(NEW.recovery, '')) = ''
   372	BEGIN
   373	    SELECT RAISE(ABORT, 'guard: this cannot be undone and has no way back — not without a recovery plan');
   374	END;
   375	
   376	-- Single use. A permission slip is spent when it is used.
   377	CREATE TRIGGER IF NOT EXISTS guard_an_approval_is_used_once
   378	BEFORE UPDATE OF used_at ON approvals
   379	WHEN OLD.used_at IS NOT NULL
   380	BEGIN
   381	    SELECT RAISE(ABORT, 'guard: that permission was already spent');
   382	END;
   383	
   384	-- ---------------------------------------------------------------------------
   385	-- Events: the live activity stream. What an agent is doing RIGHT NOW.
   386	--
   387	-- This is what makes the text channel feel like the Claude Code terminal — you
   388	-- watch Riggs read auth.py, edit routes.py, run pytest, and come back green.
   389	-- Without it the harness can only tell you a job "happened," which is useless
   390	-- while you're waiting and only mildly interesting afterward.
   630	END;
   631	
   632	-- Build evidence can only come from the harness. (Sol #9 — the DB accepted a
   633	-- model-captured screenshot; only the Python helper refused.)
   634	CREATE TRIGGER IF NOT EXISTS guard_models_cannot_forge_evidence
   635	BEFORE INSERT ON artifacts
   636	WHEN NEW.captured_by = 'model' AND NEW.kind NOT IN ('source', 'quote')
   637	BEGIN
   638	    SELECT RAISE(ABORT, 'guard: a model may cite a source but may not produce build evidence');
   639	END;
   640	
   641	-- ===========================================================================
   642	-- GUARD 1 — local output never ships unreviewed (§4.3, §9)
   643	-- Now reads the SNAPSHOT (builder_tier), not the live seat.
   644	-- ===========================================================================
   645	CREATE TRIGGER IF NOT EXISTS guard_local_output_needs_review
   646	BEFORE UPDATE OF status ON jobs
   647	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   648	     AND NEW.builder_tier = 'local'
   649	BEGIN
   650	    SELECT RAISE(ABORT, 'guard: local-built job requires a passing subscription-tier review before done')
   651	    WHERE NOT EXISTS (
   652	        SELECT 1 FROM verdicts v
   653	        WHERE v.job_id = NEW.id
   654	          AND v.reviewer_tier IN ('subscription', 'metered')
   655	          AND v.verdict = 'pass'
   656	    );
   657	END;
   658	
   659	-- ===========================================================================
   660	-- GUARD 2 — escalations must be answered, not outrun (§6)
   661	-- ===========================================================================
   662	CREATE TRIGGER IF NOT EXISTS guard_unresolved_escalation
   663	BEFORE UPDATE OF status ON jobs
   664	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   665	BEGIN
   666	    SELECT RAISE(ABORT, 'guard: job has an unresolved needs_human verdict')
   667	    WHERE EXISTS (
   668	        SELECT 1 FROM verdicts v WHERE v.job_id = NEW.id AND v.verdict = 'needs_human'
   669	    );
   670	END;
   671	
   672	-- ===========================================================================
   673	-- GUARD 3 — a tester's verdict must cite REAL BUILD EVIDENCE.
   674	--
   675	-- ⚠️ Sol #3: "The 'no screenshot, no verdict' claim is false." My original guard
   676	-- accepted ANY artifact — including a research source, or an empty row. So a tester
   677	-- could "pass" a job on the strength of a URL somebody pasted. Now it must be
   678	-- evidence the HARNESS captured by actually driving the app.
   679	-- ===========================================================================
   680	CREATE TRIGGER IF NOT EXISTS guard_tester_must_cite_artifacts
   681	BEFORE INSERT ON verdicts
   682	WHEN NEW.role = 'tester'
   683	BEGIN
   684	    SELECT RAISE(ABORT, 'guard: a tester verdict requires real captured evidence — no screenshot, no verdict')
   685	    WHERE NOT EXISTS (
   686	        SELECT 1 FROM artifacts a
   687	        WHERE a.job_id = NEW.job_id
   688	          AND a.kind IN ('screenshot', 'trace', 'video', 'dom_snapshot')
   689	          AND a.captured_by IN ('harness', 'playwright')
   690	          AND COALESCE(a.path, a.value) IS NOT NULL
   691	    );
   692	END;
   693	
   694	-- ===========================================================================
   695	-- GUARD 4 — a model family may not test its own work.
   696	-- Reads the snapshot, so re-pointing a seat later changes nothing.
   697	-- ===========================================================================
   698	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_testing
   699	BEFORE INSERT ON verdicts
   700	WHEN NEW.role = 'tester'
   701	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
   702	BEGIN
   703	    SELECT RAISE(ABORT, 'guard: a model family may not test its own build');
   704	END;
   705	
   706	-- ===========================================================================
   707	-- GUARD 5 — the full panel, always. DISTINCT reviewers.
   708	--
   709	-- ⚠️ Sol #7: "The full panel can be faked with duplicate passes." It counted ROWS.
   710	-- One reviewer could pass the same job six times. Now it counts distinct seats.
   711	-- ===========================================================================
   712	CREATE TRIGGER IF NOT EXISTS guard_full_panel
   713	BEFORE UPDATE OF status ON jobs
   714	WHEN NEW.status = 'done' AND OLD.status <> 'done' AND NEW.required_reviews > 0
   715	BEGIN
   716	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
   717	    WHERE (
   718	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
   719	        -- the panel could be "filled" by the wrong kinds of check entirely.
   720	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
   721	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   722	    ) < NEW.required_reviews;
   723	END;
   724	
   725	-- ═══════════════════════════════════════════════════════════════════════════
   726	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   727	--
   728	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
   729	-- serious failure satisfied it. A reviewer could scream that the thing was broken and
   730	-- be outvoted by colleagues who hadn't noticed.
   731	--
   732	-- That is the opposite of what a gauntlet is FOR. One reviewer finding a real bug is
   733	-- the whole point — it isn't a democracy, it's a set of independent smoke detectors.
   734	-- Any one of them going off stops the job.
   735	-- ═══════════════════════════════════════════════════════════════════════════
   736	CREATE TRIGGER IF NOT EXISTS guard_a_failing_review_stops_it
   737	BEFORE UPDATE OF status ON jobs
   738	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   739	BEGIN
   740	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
   741	    WHERE EXISTS (
   742	        SELECT 1 FROM verdicts v WHERE v.job_id = NEW.id AND v.verdict = 'fail'
   743	    );
   744	END;
   745	
   746	-- Sol, round 2, #6: an objection raised AFTER 'done' could still be outrun, because
   747	-- the escalation guard only fired on the transition INTO done — not on done -> shipped.
   748	CREATE TRIGGER IF NOT EXISTS guard_late_escalation_still_blocks_shipping
   749	BEFORE UPDATE OF status ON jobs
   750	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   751	BEGIN
   752	    SELECT RAISE(ABORT, 'guard: someone raised an objection — it has to be answered first')
   753	    WHERE EXISTS (
   754	        SELECT 1 FROM verdicts v
   755	        WHERE v.job_id = NEW.id AND v.verdict IN ('needs_human', 'fail')
   756	    );
   757	END;
   758	
   759	-- Sol, round 2, #4: evidence could be an EMPTY STRING. A path of '' satisfied
   760	-- "COALESCE(path, value) IS NOT NULL" perfectly well.
   761	CREATE TRIGGER IF NOT EXISTS guard_evidence_cannot_be_empty
   762	BEFORE INSERT ON artifacts
   763	WHEN TRIM(COALESCE(NEW.path, NEW.value, '')) = ''
   764	BEGIN
   765	    SELECT RAISE(ABORT, 'guard: evidence with nothing in it is not evidence');
   766	END;
   767	
   768	-- ===========================================================================
   769	-- GUARD 6 — nothing ships without a passing cross-family tester.
   770	-- ===========================================================================
   771	CREATE TRIGGER IF NOT EXISTS guard_ship_requires_a_passing_tester
   772	BEFORE UPDATE OF status ON jobs
   773	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   774	BEGIN
   775	    SELECT RAISE(ABORT, 'guard: nothing ships without a passing cross-family tester on the record')
   776	    WHERE OLD.status <> 'done'
   777	       OR NOT EXISTS (
   778	           SELECT 1 FROM verdicts v
   779	           WHERE v.job_id = NEW.id AND v.role = 'tester' AND v.verdict = 'pass'
   780	       );
   781	END;
   782	
   783	-- ===========================================================================
   784	-- GUARD 7 — a researcher must show you where it got that.
   785	-- ===========================================================================
   786	CREATE TRIGGER IF NOT EXISTS guard_research_must_cite_sources
   787	BEFORE UPDATE OF status ON jobs
   788	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   789	     AND NEW.kind = 'research'
   790	BEGIN
   791	    SELECT RAISE(ABORT, 'guard: a research answer must cite sources — no source, no answer')
   792	    WHERE NOT EXISTS (
   793	        SELECT 1 FROM artifacts a
   794	        WHERE a.job_id = NEW.id AND a.kind IN ('source', 'quote')
   795	          AND COALESCE(a.path, a.value) IS NOT NULL
   796	    );
   797	END;
   798	
   799	-- ===========================================================================
   800	-- GUARD 8 — a model family may not fact-check its own research.

