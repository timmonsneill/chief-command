   191	@app.get("/api/willthink")
   192	async def will_think(q: str = ""):
   193	    """Will this need thinking? Asked BEFORE we start, so the UI knows whether to show a
   194	    holding line at all.
   195	
   196	    Sol, round 2, #17: "The browser always says 'Let me think about that' before it knows
   197	    whether thinking is needed, including for 'stop', 'cancel', greetings, and status
   198	    checks. This makes instant commands feel delayed and falsely implies that
   199	    cancellation is being processed."
   200	
   201	    Dead right, and it's a nasty little bug — telling a man you're pondering his "stop"
   202	    is exactly the wrong impression to give.
   203	    """
   204	    from mouth import needs_the_brain, cover_the_gap
   205	    if needs_the_brain(q or ""):
   206	        return {"thinking": True, "holding": cover_the_gap()}
   207	    return {"thinking": False}
   208	
   209	
   210	@app.post("/api/say")
   211	async def say(request: Request):
   212	    """The text channel. Type at Chief; Chief decides what to do about it.
   213	
   214	    This is the SAME brain the voice will use — mouth.py. Text and voice are two
   215	    doors into one room, which is the whole point of building text first.
   216	    """
   217	    body = await request.json()
   218	    utterance = (body.get("text") or "").strip()
   219	    if not utterance:
   220	        return JSONResponse({"reply": "Say something."})
   221	
   222	    from mouth import needs_the_brain, is_pushback, cover_the_gap, dig_in, think, THINK_FAST, THINK_HARD
   223	
   224	    last = body.get("last_answer") or ""
   225	
   226	    if is_pushback(utterance) and last:
   227	        answer, secs = think(
   228	            body.get("last_question", utterance),
   229	            context=f"You already answered this and he pushed back. Your last answer was: {last}",
   230	            tier=THINK_HARD,
   231	        )
   232	        return {"reply": answer, "holding": dig_in(), "seconds": round(secs, 1), "tier": "deep"}
   233	
   234	    if needs_the_brain(utterance):
   235	        answer, secs = think(utterance, context=_project_context(), tier=THINK_FAST)
   236	        return {"reply": answer, "holding": cover_the_gap(), "seconds": round(secs, 1), "tier": "think"}
   237	
   238	    return {"reply": _handle_directly(utterance), "tier": "instant", "seconds": 0}
   239	
   240	
   241	def _project_context() -> str:
   242	    c = db()
   243	    rows = c.execute("SELECT fact FROM project_memory ORDER BY id DESC LIMIT 12").fetchall()
   244	    facts = " ".join(r["fact"] for r in rows)
   245	    return f"What we know about this project: {facts}" if facts else ""
   246	
   247	
   248	def _handle_directly(u: str) -> str:
   249	    """The six things the mouth may answer alone. Everything else already went upstairs."""
   250	    c = db()
   251	    low = u.lower()
   252	
   253	    if any(w in low for w in ("overnight", "last night", "what ran", "what shipped", "what happened")):
   254	        rows = c.execute(
   255	            "SELECT status, COUNT(*) n FROM jobs WHERE created_at >= datetime('now','-1 day') "
   256	            "GROUP BY status"
   257	        ).fetchall()
   258	        if not rows:
   259	            return "Nothing ran overnight."
   260	        counts = {r["status"]: r["n"] for r in rows}
   261	        bits = []
   262	        if counts.get("shipped"): bits.append(f"{counts['shipped']} finished")
   263	        if counts.get("review"):  bits.append(f"{counts['review']} waiting on the others")
   264	        if counts.get("failed"):  bits.append(f"{counts['failed']} broke")
   265	        return (", ".join(bits) + ".") if bits else "Nothing finished overnight."
   266	
   267	    if any(w in low for w in ("status", "going", "doing", "update")):
   268	        row = c.execute(
   269	            "SELECT j.task_name, j.status, j.builder_seat FROM jobs j "
   270	            "WHERE j.status IN ('in_progress','review') ORDER BY j.id DESC LIMIT 1"
   271	        ).fetchone()
   272	        if not row:
   273	            return "Nothing's running right now."
   274	        who = row["builder_seat"].title()
   275	        thing = row["task_name"] or "it"
   276	        return (f"{who} is on {thing}." if row["status"] == "in_progress"
   277	                else f"{who} finished {thing}. The others are checking it.")
   278	
   279	    return "Got it."
   280	
   281	
   282	# ═══════════════════════════════════════════════════════════════════════════════
   283	# VOICE
   284	# ═══════════════════════════════════════════════════════════════════════════════
   285	import os  # noqa: E402
   145	                "description": "What Neill said, verbatim. Do not summarize or clean it up.",
   146	            },
   147	            "context": {
   148	                "type": "string",
   149	                "description": "What you two were just talking about, if it matters.",
   150	            },
   151	        },
   152	        "required": ["said"],
   153	    },
   154	}
