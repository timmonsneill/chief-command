    40	
    41	# ── The plain-English layer. He must never see a machine word. ───────────────
    42	#
    43	# Sol caught the UI leaking filenames and shell commands straight into the detail view.
    44	# This is the translation layer that stops it. The rule from AGENTS.md:
    45	#
    46	#     "If you cannot explain what you did without jargon, you do not yet understand
    47	#      what you did."
    48	
    49	_EVENT_ENGLISH = {
    50	    "dispatched": "Picked it up",
    51	    "read":       "Read through the existing code",
    52	    "thinking":   "Worked out how to do it",
    53	    "edit":       "Changed the code",
    54	    "write":      "Wrote new code",
    55	    "command":    "Ran something",
    56	    "test_run":   "Ran the tests",
    57	    "browse":     "Clicked through it like a user",
    58	    "verdict":    "Gave a verdict",
    59	    "done":       "Finished",
    60	    "error":      "Hit a problem",
    61	}
    62	
    63	
    64	def _in_plain_english(e: dict) -> dict:
    65	    """Translate one line of machine activity into something a person can read.
    66	
    67	    NOTE the deliberate asymmetry: we keep the OUTCOME of a test run ("6 passed") but
    68	    drop the COMMAND that produced it ("pytest -q"). The outcome is a fact about the
    69	    work. The command is a fact about the tooling, and Neill doesn't use the tooling.
    70	    """
    71	    kind = e.get("kind", "")
    72	    what = _EVENT_ENGLISH.get(kind, "Worked on it")
    73	    out = {"what": what, "kind": kind}
    74	
    75	    detail = (e.get("detail") or "").strip()
    76	    # Keep a detail ONLY if it reads like a RESULT, not a machine artifact — and not if
    77	    # it's just restating the line it's attached to.
    78	    looks_technical = any(c in detail for c in ("/", "\\", ".py", ".ts", ".sql", "()", "--"))
    79	    is_redundant = detail.lower().strip(".") == what.lower().strip(".")
    80	    if detail and not looks_technical and not is_redundant:
    81	        out["note"] = detail
    82	    return out
    83	
    84	
    85	# ── Plain-English status. He should never see a machine word. ────────────────
    86	STATUS_WORDS = {
    87	    "todo":        ("Queued",      "waiting"),
    88	    "in_progress": ("Building",    "running"),
    89	    "review":      ("Being checked", "running"),
    90	    "done":        ("Checked, ready", "ok"),
    91	    "shipped":     ("Done",        "ok"),
    92	    "failed":      ("Broke",       "bad"),
    93	    "cancelled":   ("Stopped",     "waiting"),
    94	}
    95	
    96	
    97	@app.get("/api/state")
    98	def state():
    99	    """Everything the dashboard needs, in one call."""
   100	    c = db()
   101	
   102	    seats = [dict(r) for r in c.execute(
   103	        "SELECT id, model, family, tier, daily_cap_cents, build_cap_cents FROM seats WHERE enabled=1"
   104	    )]
   105	    for s in seats:
   106	        spent = c.execute(
   107	            "SELECT COALESCE(SUM(cost_cents),0) v FROM usage WHERE seat_id=? AND day=date('now')",
   108	            (s["id"],)
   109	        ).fetchone()["v"]
   110	        s["spent_today_cents"] = int(spent)
   111	        s["color"] = FAMILY_COLOR.get(s["family"], "#7E90A8")
   112	
   113	    jobs = []
   114	    for r in c.execute(
   115	        """SELECT j.*, s.model AS builder_model
   116	             FROM jobs j JOIN seats s ON s.id = j.builder_seat
   117	            ORDER BY j.id DESC LIMIT 40"""
   118	    ):
   119	        j = dict(r)
   120	        word, tone = STATUS_WORDS.get(j["status"], (j["status"], "waiting"))
   121	        j["status_word"] = word
   122	        j["tone"] = tone
   123	        j["color"] = FAMILY_COLOR.get(j["builder_family"], "#7E90A8")
   124	        j["verdicts"] = [dict(v) for v in c.execute(
   125	            "SELECT reviewer_seat, model_family, role, verdict, summary FROM verdicts "
   126	            "WHERE job_id=? ORDER BY id", (j["id"],)
   127	        )]
   128	        for v in j["verdicts"]:
   129	            v["color"] = FAMILY_COLOR.get(v["model_family"], "#7E90A8")
   130	        # ⚠️ Sol's review: "The web app explicitly leaks filenames, commands, model
   131	        # names, and jargon. The detailed work view displays raw event type, target,
   132	        # and detail. Those fields are DESIGNED to contain filenames, commands, web
   133	        # addresses, and machine output. The plain-English requirement is contradicted
   134	        # by the interface itself."
   135	        #
   136	        # He's right, and it broke the one promise that matters most. So the API now
   137	        # TRANSLATES events before they leave the server. The raw fields still exist in
   138	        # the database — they're what an engineer would need — but they never reach
   139	        # Neill's screen.
   140	        j["events"] = [_in_plain_english(dict(e)) for e in c.execute(
   141	            "SELECT kind, target, detail, lane, model FROM events WHERE job_id=? ORDER BY id",
   142	            (j["id"],)
   143	        )]
   144	        # Why is this stuck? In words he can act on.
   145	        j["blocked_because"] = _why_blocked(c, j)
   146	        jobs.append(j)
   147	
   148	    projects = [dict(r) for r in c.execute("SELECT * FROM projects WHERE archived=0")]
   149	    for p in projects:
   150	        p["memory"] = [dict(m) for m in c.execute(
   151	            "SELECT kind, fact FROM project_memory WHERE project_id=? ORDER BY id DESC LIMIT 30",
   152	            (p["id"],)
   153	        )]
   154	        p["plan"] = [dict(x) for x in c.execute(
   155	            "SELECT * FROM plan_items WHERE project_id=? ORDER BY position, id", (p["id"],)
   156	        )]
   157	        p["job_count"] = c.execute(
   158	            "SELECT COUNT(*) n FROM jobs WHERE project_id=?", (p["id"],)
   159	        ).fetchone()["n"]
   160	
   161	    return {"seats": seats, "jobs": jobs, "projects": projects}
   162	
   163	
   164	def _why_blocked(c, j) -> str | None:
   165	    """The single most useful string on the screen: what is this waiting for?"""
   166	    if j["status"] in ("shipped", "failed", "cancelled"):
   167	        return None
   168	
   169	    if any(v["verdict"] == "needs_human" for v in j["verdicts"]):
   170	        return "Someone needs to make a call on this — the reviewers disagreed."
   171	
   172	    if j["status"] == "done":
   173	        has_tester = any(v["role"] == "tester" and v["verdict"] == "pass" for v in j["verdicts"])
   174	        if not has_tester:
   175	            return "Nobody has actually opened it and used it yet."
   176	        return None
   177	
   178	    if j["status"] == "review":
   179	        if j["builder_tier"] == "local":
   180	            paid = any(v["reviewer_tier"] in ("subscription", "metered") and v["verdict"] == "pass"
   181	                       for v in j["verdicts"])
   182	            if not paid:
   183	                return "Coal wrote this. It can't go anywhere until a better model checks it."
   184	        need = j["required_reviews"] or 0
   185	        got = len({v["reviewer_seat"] for v in j["verdicts"] if v["verdict"] == "pass"})
   186	        if need and got < need:
   187	            return f"Waiting on the others — {got} of {need} have looked at it."
   188	    return None
   189	
