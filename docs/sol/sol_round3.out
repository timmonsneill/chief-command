    81	@dataclass
    82	class Dispatch:
    83	    job_id: int
    84	    run_id: str | None
    85	    seat_id: str
    86	
    87	
    88	def dispatch(
    89	    conn,
    90	    request: str,
    91	    builder_seat: str,
    92	    cfg: dict[str, Any],
    93	    origin: str = "text",
    94	    blocking: bool = False,
    95	) -> Dispatch:
    96	    """Record the job, then spawn it on OpenClaw. In that order, always.
    97	
    98	    Non-blocking by default — this is what lets the mouth stay responsive. OpenClaw's
    99	    sessions_spawn returns a run id immediately, so the voice head can say "on it" and
   100	    keep talking while the work grinds. A blocking dispatch here would reintroduce
   101	    exactly the latency wound that killed v1.
   102	    """
   103	    row = seat(conn, builder_seat)
   104	    if row is None:
   105	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   106	    if not row["enabled"]:
   107	        raise DispatchRefused(f"seat '{builder_seat}' is disabled")
   108	
   109	    # OpenClaw core has NO per-agent budget of any kind. If we don't check here,
   110	    # nothing does.
   111	    if over_budget(conn, builder_seat):
   112	        raise DispatchRefused(
   113	            f"seat '{builder_seat}' is over its daily cap — refusing to dispatch"
   114	        )
   115	
   116	    gauntlet = cfg.get("gauntlet", {})
   117	    required = len(gauntlet.get("reviewers", []))
   118	
   119	    job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   120	    conn.execute("UPDATE jobs SET required_reviews = ? WHERE id = ?", (required, job_id))
   121	
   122	    run_id = _spawn(row, request, blocking=blocking)
   123	    attach_run(conn, job_id, run_id=run_id or "", branch=f"job/{job_id}")
   124	    set_status(conn, job_id, "in_progress")
   125	
   126	    return Dispatch(job_id=job_id, run_id=run_id, seat_id=builder_seat)
   127	
   128	
   129	def _spawn(seat_row, request: str, blocking: bool) -> str | None:
   130	    """Hand the work to OpenClaw.
   131	
   132	    `openclaw agent` runs one turn via the Gateway. The model is chosen per-spawn,
   133	    which is what lets a single orchestrator turn fan out across several families.
   134	    """
   135	    cmd = [
   136	        "openclaw", "agent",
   137	        "--model", f"{seat_row['provider']}/{seat_row['model']}",
   138	        "--message", request,
   139	    ]
   140	    if not blocking:
   141	        cmd.append("--detach")
   142	
   143	    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
   144	    if proc.returncode != 0:
   145	        raise DispatchRefused(f"openclaw refused the spawn: {proc.stderr.strip()[:300]}")
   146	
   147	    # The gateway echoes a run id; fall back to the raw stdout if the shape changes.
   148	    try:
   149	        return json.loads(proc.stdout).get("runId")
   150	    except (json.JSONDecodeError, AttributeError):
   151	        return proc.stdout.strip()[:80] or None
   152	
   153	
   154	# ---------------------------------------------------------------------------
   155	# The gauntlet (spec §6)
   156	# ---------------------------------------------------------------------------
   157	def run_gauntlet(conn, job_id: int, cfg: dict[str, Any]) -> list[str]:
   158	    """Fan the finished work out to the reviewer panel, in parallel, same bundle.
   159	
   160	    The model-diversity rule (§6) isn't asserted here — it's recorded. Every verdict
   161	    snapshots the reviewing seat's family, so "at least two families looked at this"
   162	    is a fact you can query rather than a promise someone made.
   163	    """
   164	    gauntlet = cfg.get("gauntlet", {})
   165	    verdicts = []
   166	    for reviewer in gauntlet.get("reviewers", []):
   167	        if over_budget(conn, reviewer):
   168	            continue  # a capped-out reviewer is skipped, not faked
   169	        verdicts.append(reviewer)
   170	    return verdicts
   171	
   172	
   173	def ship(conn, job_id: int, owner_confirmed: bool = False) -> None:
   174	    """Ship a job. The GATES decide, not a human and not an agent's confidence.
   175	
   176	    Owner override (2026-07-13): Neill is out of the critical path. A job that cleared
   177	    'done' AND carries a passing cross-family tester verdict backed by real Playwright
   178	    artifacts will ship on its own. The schema refuses anything less — so an agent
   179	    cannot ship on vibes, and Neill doesn't have to stay up to approve it.
   180	
   181	    owner_confirmed is optional and only stamps the record (useful when he DOES eyeball
   182	    something). It grants no extra power: the gates apply either way.
   183	    """
   184	    if owner_confirmed:
   185	        conn.execute(
   186	            "UPDATE jobs SET owner_confirmed_at = datetime('now') WHERE id = ?", (job_id,)
   187	        )
   188	    set_status(conn, job_id, "shipped")
   189	
   190	
   191	def morning_report(conn) -> list[dict[str, Any]]:
   192	    """What shipped while you slept, and what didn't.
   193	
   194	    Neill is out of the critical path, not out of the loop. This is the difference.
   195	    """
   196	    rows = conn.execute(
   197	        """
   198	        SELECT id, request, status, builder_seat, spoken_summary, finished_at
   199	          FROM jobs
   200	         WHERE created_at >= datetime('now', '-1 day')
   201	         ORDER BY
   202	           CASE status WHEN 'shipped' THEN 0 WHEN 'review' THEN 1
   203	                       WHEN 'failed' THEN 2 ELSE 3 END,
   204	           id
   205	        """
   245	    if captured_by not in ("harness", "playwright", "model"):
   246	        raise ValueError(f"unknown artifact origin: {captured_by}")
   247	    cur = conn.execute(
   248	        """
   249	        INSERT INTO artifacts (job_id, kind, path, value, flow, captured_by)
   250	        VALUES (?, ?, ?, ?, ?, ?)
   251	        """,
   252	        (job_id, kind, path, value, flow, captured_by),
   253	    )
   254	    return int(cur.lastrowid)
   255	
   256	
   257	@_guarded
   258	def record_verdict(
   259	    conn: sqlite3.Connection,
   260	    job_id: int,
   261	    reviewer_seat: str,
   262	    verdict: str,
   263	    severity: str | None = None,
   264	    summary: str | None = None,
   265	    detail: str | None = None,
   266	    role: str = "reviewer",
   267	) -> int:
   268	    """Record one seat's verdict.
   269	
   270	    role='reviewer' reads the diff and judges it.
   271	    role='tester'   drove the app (Playwright) and judges what it observed. Two guards
   272	                    apply: it must cite captured artifacts, and its family must differ
   273	                    from the builder's — Playwright stops a tester fabricating what
   274	                    happened; only a different mind stops it rationalizing it.
   275	
   276	    tier and family are snapshotted from the seat at write time, so re-tiering or
   277	    re-pointing a seat later cannot retroactively legitimize a job.
   278	    """
   279	    row = seat(conn, reviewer_seat)
   280	    if row is None:
   281	        raise ValueError(f"unknown seat: {reviewer_seat}")
   282	
   283	    cur = conn.execute(
   284	        """
   285	        INSERT INTO verdicts
   286	            (job_id, reviewer_seat, reviewer_tier, role, model_family,
   287	             verdict, severity, summary, detail)
   288	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
   289	        """,
   290	        (job_id, reviewer_seat, row["tier"], role, row["family"],
   291	         verdict, severity, summary, detail),
   292	    )
   293	    return int(cur.lastrowid)
   294	
   295	
   296	def resolve_escalation(conn: sqlite3.Connection, verdict_id: int, verdict: str) -> None:
   297	    """Answer a needs_human verdict so the job can proceed (§6 human review queue)."""
   298	    if verdict not in ("pass", "fail"):
   299	        raise ValueError("an escalation resolves to 'pass' or 'fail'")
   300	    conn.execute("UPDATE verdicts SET verdict = ? WHERE id = ?", (verdict, verdict_id))
   301	
   302	
   303	# --------------------------------------------------------------------------
   304	# Reporting — this is what the voice layer reads back
   305	# --------------------------------------------------------------------------
   306	def overnight_report(conn: sqlite3.Connection, since: str = "-1 day") -> list[sqlite3.Row]:
   307	    """Answers spec §7's 'what did the overnight run do?'"""
   308	    return conn.execute(
   309	        """
   310	        SELECT * FROM job_report
   311	         WHERE created_at >= datetime('now', ?)
   312	         ORDER BY id
   313	        """,
   314	        (since,),
   315	    ).fetchall()
   316	
