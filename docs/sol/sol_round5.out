    SELECT RAISE(ABORT, 'guard: a reviewer failed this
guard_an_approval_is_used_once|CREATE TRIGGER guard_an_approval_is_used_once
BEFORE UPDATE OF used_at ON approvals
WHEN OLD.used_at IS NOT NULL
BEGIN
    SELECT RAISE(ABORT, 'guard: that permission was already spent');
END
guard_build_cap_is_hard|CREATE TRIGGER guard_build_cap_is_hard
BEFORE INSERT ON usage
