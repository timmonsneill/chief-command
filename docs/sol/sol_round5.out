    53	    "edit":       "Changed the code",
    54	    "write":      "Wrote new code",
    55	    "command":    "Ran something",
    56	    "test_run":   "Ran the tests",
    57	    "browse":     "Clicked through it like a user",
    58	    "verdict":    "Gave a verdict",
    59	    "done":       "Finished",
    60	    "error":      "Hit a problem",
    61	}
    62	
    63	
    64	def _in_plain_english(e: dict) -> dict:
    65	    """Translate one line of machine activity into something a person can read.
    66	
    67	    NOTE the deliberate asymmetry: we keep the OUTCOME of a test run ("6 passed") but
    68	    drop the COMMAND that produced it ("pytest -q"). The outcome is a fact about the
    69	    work. The command is a fact about the tooling, and Neill doesn't use the tooling.
    70	    """
    71	    kind = e.get("kind", "")
    72	    what = _EVENT_ENGLISH.get(kind, "Worked on it")
    73	    out = {"what": what, "kind": kind}
    74	
    75	    detail = (e.get("detail") or "").strip()
    76	    # Keep a detail ONLY if it reads like a RESULT, not a machine artifact — and not if
    77	    # it's just restating the line it's attached to.
    78	    looks_technical = any(c in detail for c in ("/", "\\", ".py", ".ts", ".sql", "()", "--"))
    79	    is_redundant = detail.lower().strip(".") == what.lower().strip(".")
    80	    if detail and not looks_technical and not is_redundant:
    81	        out["note"] = detail
    82	    return out
    83	
    84	
    85	# ── Plain-English status. He should never see a machine word. ────────────────
    86	STATUS_WORDS = {
    87	    "todo":        ("Queued",      "waiting"),
    88	    "in_progress": ("Building",    "running"),
    89	    "review":      ("Being checked", "running"),
    90	    "done":        ("Checked, ready", "ok"),
    91	    "shipped":     ("Done",        "ok"),
    92	    "failed":      ("Broke",       "bad"),
    93	    "cancelled":   ("Stopped",     "waiting"),
    94	}
    95	
    96	
    97	@app.get("/api/state")
    98	def state():
    99	    """Everything the dashboard needs, in one call."""
   100	    c = db()
   101	
   102	    seats = [dict(r) for r in c.execute(
   103	        "SELECT id, model, family, tier, daily_cap_cents, build_cap_cents FROM seats WHERE enabled=1"
   104	    )]
   105	    for s in seats:
   106	        spent = c.execute(
   107	            "SELECT COALESCE(SUM(cost_cents),0) v FROM usage WHERE seat_id=? AND day=date('now')",
   108	            (s["id"],)
   109	        ).fetchone()["v"]
   110	        s["spent_today_cents"] = int(spent)
   111	        s["color"] = FAMILY_COLOR.get(s["family"], "#7E90A8")
   112	
   113	    jobs = []
   114	    for r in c.execute(
   115	        """SELECT j.*, s.model AS builder_model
   116	             FROM jobs j JOIN seats s ON s.id = j.builder_seat
   117	            ORDER BY j.id DESC LIMIT 40"""
   118	    ):
   119	        j = dict(r)
   120	        word, tone = STATUS_WORDS.get(j["status"], (j["status"], "waiting"))
   121	        j["status_word"] = word
   122	        j["tone"] = tone
   123	        j["color"] = FAMILY_COLOR.get(j["builder_family"], "#7E90A8")
   124	        j["verdicts"] = [dict(v) for v in c.execute(
   125	            "SELECT reviewer_seat, model_family, role, verdict, summary FROM verdicts "
   126	            "WHERE job_id=? ORDER BY id", (j["id"],)
   127	        )]
   128	        for v in j["verdicts"]:
   129	            v["color"] = FAMILY_COLOR.get(v["model_family"], "#7E90A8")
   130	        # ⚠️ Sol's review: "The web app explicitly leaks filenames, commands, model
   131	        # names, and jargon. The detailed work view displays raw event type, target,
   132	        # and detail. Those fields are DESIGNED to contain filenames, commands, web
   133	        # addresses, and machine output. The plain-English requirement is contradicted
   134	        # by the interface itself."
   135	        #
   136	        # He's right, and it broke the one promise that matters most. So the API now
   137	        # TRANSLATES events before they leave the server. The raw fields still exist in
   138	        # the database — they're what an engineer would need — but they never reach
   139	        # Neill's screen.
   140	        j["events"] = [_in_plain_english(dict(e)) for e in c.execute(
   141	            "SELECT kind, target, detail, lane, model FROM events WHERE job_id=? ORDER BY id",
   142	            (j["id"],)
   143	        )]
   144	        # Why is this stuck? In words he can act on.
   145	        j["blocked_because"] = _why_blocked(c, j)
   146	        jobs.append(j)
   147	
   148	    projects = [dict(r) for r in c.execute("SELECT * FROM projects WHERE archived=0")]
   149	    for p in projects:
   150	        p["memory"] = [dict(m) for m in c.execute(
   151	            "SELECT kind, fact FROM project_memory WHERE project_id=? ORDER BY id DESC LIMIT 30",
   152	            (p["id"],)
   153	        )]
   154	        p["plan"] = [dict(x) for x in c.execute(
   155	            "SELECT * FROM plan_items WHERE project_id=? ORDER BY position, id", (p["id"],)
   156	        )]
   157	        p["job_count"] = c.execute(
   158	            "SELECT COUNT(*) n FROM jobs WHERE project_id=?", (p["id"],)
   159	        ).fetchone()["n"]
   160	
   161	    return {"seats": seats, "jobs": jobs, "projects": projects}
   162	
   163	
   164	def _why_blocked(c, j) -> str | None:
   165	    """The single most useful string on the screen: what is this waiting for?"""
   166	    if j["status"] in ("shipped", "failed", "cancelled"):
   167	        return None
   168	
   169	    if any(v["verdict"] == "needs_human" for v in j["verdicts"]):
   170	        return "Someone needs to make a call on this — the reviewers disagreed."
   171	
   172	    if j["status"] == "done":
   173	        has_tester = any(v["role"] == "tester" and v["verdict"] == "pass" for v in j["verdicts"])
   174	        if not has_tester:
   175	            return "Nobody has actually opened it and used it yet."
   176	        return None
   177	
   178	    if j["status"] == "review":
   179	        if j["builder_tier"] == "local":
   180	            paid = any(v["reviewer_tier"] in ("subscription", "metered") and v["verdict"] == "pass"
   181	                       for v in j["verdicts"])
   182	            if not paid:
   183	                return "Coal wrote this. It can't go anywhere until a better model checks it."
   184	        need = j["required_reviews"] or 0
   185	        got = len({v["reviewer_seat"] for v in j["verdicts"] if v["verdict"] == "pass"})
   186	        if need and got < need:
   187	            return f"Waiting on the others — {got} of {need} have looked at it."
   188	    return None
   189	
   190	
   191	@app.get("/api/willthink")
   192	async def will_think(q: str = ""):
   193	    """Will this need thinking? Asked BEFORE we start, so the UI knows whether to show a
   194	    holding line at all.
   195	
   196	    Sol, round 2, #17: "The browser always says 'Let me think about that' before it knows
   197	    whether thinking is needed, including for 'stop', 'cancel', greetings, and status
   198	    checks. This makes instant commands feel delayed and falsely implies that
   199	    cancellation is being processed."
   200	
   201	    Dead right, and it's a nasty little bug — telling a man you're pondering his "stop"
   202	    is exactly the wrong impression to give.
   203	    """
   204	    from mouth import needs_the_brain, cover_the_gap
   205	    if needs_the_brain(q or ""):
   206	        return {"thinking": True, "holding": cover_the_gap()}
   207	    return {"thinking": False}
   208	
   209	
   210	@app.post("/api/say")
   211	async def say(request: Request):
   212	    """The text channel. Type at Chief; Chief decides what to do about it.
   213	
   214	    This is the SAME brain the voice will use — mouth.py. Text and voice are two
   215	    doors into one room, which is the whole point of building text first.
   216	    """
   217	    body = await request.json()
   218	    utterance = (body.get("text") or "").strip()
   219	    if not utterance:
   220	        return JSONResponse({"reply": "Say something."})
   221	
   222	    from mouth import needs_the_brain, is_pushback, cover_the_gap, dig_in, think, THINK_FAST, THINK_HARD
   223	
   224	    last = body.get("last_answer") or ""
   225	
   226	    if is_pushback(utterance) and last:
   227	        answer, secs = think(
   228	            body.get("last_question", utterance),
   229	            context=f"You already answered this and he pushed back. Your last answer was: {last}",
   230	            tier=THINK_HARD,
   231	        )
   232	        return {"reply": answer, "holding": dig_in(), "seconds": round(secs, 1), "tier": "deep"}
   233	
   234	    if needs_the_brain(utterance):
   235	        answer, secs = think(utterance, context=_project_context(), tier=THINK_FAST)
   236	        return {"reply": answer, "holding": cover_the_gap(), "seconds": round(secs, 1), "tier": "think"}
   237	
   238	    return {"reply": _handle_directly(utterance), "tier": "instant", "seconds": 0}
   239	
   240	
   241	def _project_context() -> str:
   242	    c = db()
   243	    rows = c.execute("SELECT fact FROM project_memory ORDER BY id DESC LIMIT 12").fetchall()
   244	    facts = " ".join(r["fact"] for r in rows)
   245	    return f"What we know about this project: {facts}" if facts else ""
   246	
   247	
   248	def _handle_directly(u: str) -> str:
   249	    """The six things the mouth may answer alone. Everything else already went upstairs."""
   250	    c = db()
   251	    low = u.lower()
   252	
   253	    if any(w in low for w in ("overnight", "last night", "what ran", "what shipped", "what happened")):
   254	        rows = c.execute(
   255	            "SELECT status, COUNT(*) n FROM jobs WHERE created_at >= datetime('now','-1 day') "
   256	            "GROUP BY status"
   257	        ).fetchall()
   258	        if not rows:
   259	            return "Nothing ran overnight."
   260	        counts = {r["status"]: r["n"] for r in rows}
   261	        bits = []
   262	        if counts.get("shipped"): bits.append(f"{counts['shipped']} finished")
   263	        if counts.get("review"):  bits.append(f"{counts['review']} waiting on the others")
   264	        if counts.get("failed"):  bits.append(f"{counts['failed']} broke")
   265	        return (", ".join(bits) + ".") if bits else "Nothing finished overnight."
   266	
   267	    if any(w in low for w in ("status", "going", "doing", "update")):
   268	        row = c.execute(
   269	            "SELECT j.task_name, j.status, j.builder_seat FROM jobs j "
   270	            "WHERE j.status IN ('in_progress','review') ORDER BY j.id DESC LIMIT 1"
   271	        ).fetchone()
   272	        if not row:
   273	            return "Nothing's running right now."
   274	        who = row["builder_seat"].title()
   275	        thing = row["task_name"] or "it"
   276	        return (f"{who} is on {thing}." if row["status"] == "in_progress"
   277	                else f"{who} finished {thing}. The others are checking it.")
   278	
   279	    return "Got it."
   280	
   281	
   282	# ═══════════════════════════════════════════════════════════════════════════════
   283	# VOICE
   284	# ═══════════════════════════════════════════════════════════════════════════════
   285	import os  # noqa: E402
   286	
   287	import httpx  # noqa: E402
   288	
   289	from chief import ASK_CHIEF_TOOL, MOUTH_INSTRUCTIONS, ask_chief  # noqa: E402
   290	
   291	VOICE_MODEL = "gpt-realtime-2.1"   # the FULL model, NOT mini.
   292	# Mini has an open, unresolved bug where it refuses to call function tools. For a
   293	# telephone whose entire job is placing one call, that is fatal — you'd speak into
   294	# the car and nothing would happen. ~$50/mo more to remove the single point of
   295	# failure from the whole system. Cheapest insurance on the board.
   296	
   297	
   298	@app.get("/api/voice/token")
   299	async def voice_token():
   300	    """Mint a SHORT-LIVED client token so the real API key never reaches the browser.
   301	
   302	    The browser talks straight to OpenAI (that's what keeps the audio fast — it doesn't
   303	    bounce through this Mac). But it must never hold the key that can spend money, so
   304	    it gets a token that expires in a minute and can do nothing but start one session.
   305	    """
   306	    key = os.environ.get("OPENAI_API_KEY")
   307	    if not key:
   308	        return JSONResponse({"error": "no OpenAI key configured"}, status_code=503)
   309	
   310	    # Refuse to start a session we can't afford. Sol: "a safe failure mode when Chief
   311	    # is unavailable" — same principle for the money. Better to not start than to be
   312	    # cut off mid-sentence by OpenAI's own cap.
   313	    m = month_spend(db())
   314	    if m["spent_cents"] >= m["cap_cents"]:
   315	        return JSONResponse(
   316	            {"error": f"You're at your ${m['cap_cents']/100:.0f} monthly limit. "
   317	                      "Voice is off until you raise it."},
   318	            status_code=402,
   319	        )
   320	
   321	    async with httpx.AsyncClient(timeout=20) as http:
   322	        r = await http.post(
   323	            "https://api.openai.com/v1/realtime/client_secrets",
   324	            headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
   325	            json={
   326	                "session": {
   327	                    "type": "realtime",
   328	                    "model": VOICE_MODEL,
   329	                    "instructions": MOUTH_INSTRUCTIONS,
   330	                    "tools": [ASK_CHIEF_TOOL],
   331	                    "tool_choice": "auto",
   332	                    "audio": {
   333	                        "input": {
   334	                            # SEMANTIC turn detection, not plain silence detection.
   335	                            # A driver pauses mid-sentence to merge; silence-based VAD
   336	                            # cuts him off. Semantic judges whether he SOUNDED finished.
   337	                            "turn_detection": {"type": "semantic_vad", "eagerness": "low",
   338	                                               "interrupt_response": True},
   339	                        },
   340	                        "output": {"voice": "cedar"},
   341	                    },
   342	                }
   343	            },
   344	        )
   345	    if r.status_code >= 400:
   346	        return JSONResponse({"error": r.text[:300]}, status_code=r.status_code)
   347	    return r.json()
   348	
   349	
   350	@app.post("/api/voice/ask")
   351	async def voice_ask(request: Request):
   352	    """The mouth's ONE tool. Everything Neill says arrives here and goes to Chief.
   353	
   354	    The mouth decides nothing. It doesn't even decide whether something is worth
   355	    sending — because "is this worth sending?" is a judgment, and judgments are where
   356	    this leaked twice.
   357	    """
   358	    body = await request.json()
   359	    said = (body.get("said") or "").strip()
   360	    if not said:
   361	        return {"spoken": "I didn't catch that."}
   362	
   363	    from mouth import is_pushback
   364	    out = ask_chief(
   365	        said,
   366	        context=body.get("context", ""),
   367	        pushed_back=is_pushback(said),
   368	    )
   369	
   370	    # Everything Chief says goes on the record, so the text channel always has the full
   371	    # version of anything he only half-heard in the car.
   372	    c = db()
   373	    c.execute(
   374	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   375	        "SELECT id, 'chief', 'chief', ?, 'gpt', 'thinking', ? FROM jobs ORDER BY id DESC LIMIT 1",
   376	        (out.get("model", CHIEF_MODEL), out["full"][:500]),
   377	    )
   378	    return out
   379	
