guard_a_failing_review_stops_it|CREATE TRIGGER guard_a_failing_review_stops_it
BEFORE UPDATE OF status ON jobs
WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
