   143	                "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   144	                "VALUES (?,?,?,?,?,?,?)",
   145	                (job_id, seat_id, seat_id, row["model"], row["family"], "skipped",
   146	                 f"not on the panel: {why}"),
   147	            )
