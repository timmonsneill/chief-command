   302	CREATE INDEX IF NOT EXISTS idx_jobs_status  ON jobs(status);
   303	CREATE INDEX IF NOT EXISTS idx_jobs_created ON jobs(created_at);
   304	CREATE INDEX IF NOT EXISTS idx_jobs_run     ON jobs(run_id);
   305	CREATE UNIQUE INDEX IF NOT EXISTS idx_jobs_dispatch_key ON jobs(dispatch_key)
   480	-- ---------------------------------------------------------------------------
   481	-- Events: the live activity stream. What an agent is doing RIGHT NOW.
   482	--
   483	-- This is what makes the text channel feel like the Claude Code terminal — you
   484	-- watch Riggs read auth.py, edit routes.py, run pytest, and come back green.
   485	-- Without it the harness can only tell you a job "happened," which is useless
   486	-- while you're waiting and only mildly interesting afterward.
   487	--
   488	-- ONE STREAM, TWO RENDERINGS (this is the key design decision):
   489	--   VOICE reads jobs.spoken_summary — a sentence. "Riggs is on it, two minutes."
   490	--   TEXT  reads THIS table in full   — every tool call, every file, every result.
   491	-- Same truth, different verbosity. The voice can escalate into this table on
   492	-- request ("what's it actually doing?") — see [voice] in seats.toml.
   493	--
   494	-- Note `lane` and `model` are BOTH recorded. The lane (Riggs) carries the memory
   495	-- and the conventions; the model is whoever is sitting in that chair today. You
   496	-- must always be able to see which — otherwise you can't tell whether your auth
   497	-- module was built by your best coder or your cheapest one.
   498	-- ---------------------------------------------------------------------------
   499	CREATE TABLE IF NOT EXISTS events (
   500	    id            INTEGER PRIMARY KEY,
   501	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
   502	    seat_id       TEXT NOT NULL REFERENCES seats(id),
   503	    lane          TEXT NOT NULL,             -- 'riggs' | 'finn' | 'nova' | 'forge' ...
   504	    model         TEXT NOT NULL,             -- who is actually in the chair right now
   505	    family        TEXT NOT NULL,
   506	    -- 'skipped' is load-bearing (task #10): the record needs a word for something that
   507	    -- did NOT happen. A reviewer that was capped out or couldn't run must leave a mark,
   508	    -- or a panel that quietly shrank looks identical to a full one. (Migration 006.)
   509	    kind          TEXT NOT NULL CHECK (kind IN (
   510	                      'dispatched', 'thinking', 'read', 'edit', 'write',
   511	                      'command', 'test_run', 'browse', 'verdict', 'done', 'error',
   512	                      'skipped'
   513	                  )),
   514	    target        TEXT,                      -- the file / command / URL it touched
   515	    detail        TEXT,                      -- one line, terminal-style
   516	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
   517	);
   518	
   519	CREATE INDEX IF NOT EXISTS idx_events_job ON events(job_id, id);
   520	
   521	-- ---------------------------------------------------------------------------
   522	-- Artifacts: GROUND TRUTH. Captured by the harness, not reported by a model.
   523	--
   524	-- This is the anti-fabrication layer, and it exists for a specific reason:
   525	-- GPT-5.6-sol's own system card admits it fabricates results, and METR measured a
   650	-- A job may never be BORN finished. (Sol, round 1, #1 — the worst one.)
   651	CREATE TRIGGER IF NOT EXISTS guard_no_job_is_born_done
   652	BEFORE INSERT ON jobs
   653	WHEN NEW.status IN ('done', 'shipped')
   654	BEGIN
   655	    SELECT RAISE(ABORT, 'guard: a job cannot be created already finished — it must earn it');
   656	END;
   657	
   658	-- A job may not LIE ABOUT WHO BUILT IT AT BIRTH. (Sol, round 2, #1 — critical.)
   659	--
   660	-- I froze the builder's identity AFTER creation, so it couldn't be rewritten. But I
   661	-- never checked it AT creation. Sol: "A direct database write can label local work as
   662	-- subscription work, then complete it without the required higher-quality review. The
   663	-- identity is frozen only after creation; the initial lie is never caught."
   664	--
   665	-- Freezing a lie just makes it a permanent lie.
   666	CREATE TRIGGER IF NOT EXISTS guard_builder_identity_must_be_real
   667	BEFORE INSERT ON jobs
   668	WHEN NEW.builder_tier   <> (SELECT tier   FROM seats WHERE id = NEW.builder_seat)
   669	  OR NEW.builder_family <> (SELECT family FROM seats WHERE id = NEW.builder_seat)
