   385	# TODOS — the checklist that lives in the command center, grouped by project and by
   386	# the owner's own sections ("Now", "Later", "Post-launch"). No more jumping windows.
   387	# ═══════════════════════════════════════════════════════════════════════════════
   388	@app.post("/api/projects/{project_id}/todos")
   389	async def add_todo_endpoint(project_id: str, request: Request):
   390	    from db.planning import add_todo
   391	    body = await request.json()
   392	    text = (body.get("text") or "").strip()
   393	    if not text:
   394	        return JSONResponse({"error": "Say what the todo is."}, status_code=400)
   395	    c = db()
   396	    if c.execute("SELECT 1 FROM projects WHERE id=?", (project_id,)).fetchone() is None:
   397	        return JSONResponse({"error": "No such project."}, status_code=404)
   398	    tid = add_todo(c, project_id, text,
   399	                   section=body.get("section"), owner_only=bool(body.get("owner_only")))
   400	    return {"id": tid}
