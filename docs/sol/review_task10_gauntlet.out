   164	
   165	# ---------------------------------------------------------------------------
   195	    A roster entry pointing at a seat that doesn't exist (the old `grinder_paid`) is a
   196	    silent trap: `over_budget` treats the unknown seat as uncapped, the pre-check says
   197	    "fine," then the verdict write rejects it. Catch it at startup instead.
   198	    """
   199	    seats = cfg.get("seats", {})
   200	    return [r for r in cfg.get("gauntlet", {}).get("reviewers", []) if r not in seats]
   201	
   202	
   203	def panel_roster(conn, cfg: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
   204	    """Who can actually sit on the panel right now — and who can't, and why.
   205	
   206	    A roster entry is only real if the seat exists, is switched on, and we have a way to
   207	    RUN it on this machine. Grok has no runner until the leaked key is rotated; the
   208	    codex seat needs its login. Counting those as panel members would produce a required
   209	    panel that can never report, which fails closed but useless — every job parked
   210	    forever. Counting them silently would be worse: a panel that shrank without saying
   211	    so reads exactly like a full one.
   212	
   213	    So: exclude them, name them, and let the FAMILY FLOOR (which cannot be lowered) be
   214	    the thing that decides whether what's left is enough.
   215	    """
   216	    import gauntlet
   217	
   218	    roster: list[str] = []
   219	    excluded: dict[str, str] = {}
   220	    for seat_id in cfg.get("gauntlet", {}).get("reviewers", []):
   221	        row = seat(conn, seat_id)
   222	        if row is None:
   223	            excluded[seat_id] = "that reviewer isn't set up on this machine"
   224	        elif not row["enabled"]:
   225	            excluded[seat_id] = "that reviewer is turned off"
   226	        elif not gauntlet.has_runner(row["provider"]):
   227	            excluded[seat_id] = "we have no way to run that reviewer yet"
   228	        else:
   229	            roster.append(seat_id)
   230	    return roster, excluded
   231	
   232	
   233	def _refuse_a_panel_that_cannot_hold(conn, roster: list[str], floor: int) -> None:
   234	    """Refuse to dispatch work the panel could never certify.
   235	
   236	    Fail CLOSED, but say so at DISPATCH — when it is one legible refusal — rather than
   237	    at review time, where it becomes a job that parks forever and looks like a bug.
   238	    """
   239	    if floor < 1:
   240	        raise DispatchRefused(
   241	            "the review panel isn't configured (it needs at least one model family) "
   242	            "— refusing to start work that nothing would check"
   243	        )
   244	    families = {seat(conn, s)["family"] for s in roster}
   245	    if len(families) < floor:
   246	        raise DispatchRefused(
   247	            f"only {len(families)} model family/families can review right now and "
   248	            f"{floor} are required — refusing to start work that could never be checked"
   249	        )
   250	
   251	
   252	def sync_seats(conn, cfg: dict[str, Any]) -> None:
   253	    """Push the config's seats into the store, so guards can reason about them.
   254	
   255	    Refuses a config whose gauntlet names a seat that doesn't exist, or a seat missing a
   256	    family — both would blow up later, mid-panel, where it's far harder to see.
   257	    """
   258	    missing = unresolved_reviewers(cfg)
   259	    if missing:
   260	        raise DispatchRefused(f"gauntlet names seats that don't exist: {missing}")
   261	    for seat_id, s in cfg.get("seats", {}).items():
   262	        if "family" not in s:
   263	            raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
   264	    for seat_id, s in cfg.get("seats", {}).items():
   265	        upsert_seat(conn, Seat(
   266	            id=seat_id,
   267	            provider=s["provider"],
   268	            model=s["model"],
   269	            family=s["family"],
   270	            tier=s["tier"],
   271	            daily_cap_cents=s.get("daily_cap_cents"),
   272	            enabled=not s.get("disabled", False),
   273	            notes=s.get("notes", ""),
   274	        ))
   275	
   276	
   277	# ---------------------------------------------------------------------------
   278	# Dispatch
   279	# ---------------------------------------------------------------------------
   280	@dataclass
   281	class Dispatch:
   282	    job_id: int
   283	    run_id: str | None
   284	    seat_id: str
   285	
   286	
   287	def dispatch(
   288	    conn,
   289	    request: str,
   290	    builder_seat: str,
   291	    cfg: dict[str, Any],
   292	    origin: str = "text",
   293	    blocking: bool = False,
   294	) -> Dispatch:
   295	    """Record the job, then spawn it on OpenClaw. In that order, always.
   296	
   297	    Non-blocking by default — this is what lets the mouth stay responsive. OpenClaw's
   298	    sessions_spawn returns a run id immediately, so the voice head can say "on it" and
   299	    keep talking while the work grinds. A blocking dispatch here would reintroduce
   300	    exactly the latency wound that killed v1.
   301	    """
   302	    row = seat(conn, builder_seat)
   303	    if row is None:
   304	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   305	    if not row["enabled"]:
   306	        raise DispatchRefused(f"seat '{builder_seat}' is disabled")
   307	
   308	    # OpenClaw core has NO per-agent budget of any kind. If we don't check here,
   309	    # nothing does.
   310	    if over_budget(conn, builder_seat):
   311	        raise DispatchRefused(
   312	            f"seat '{builder_seat}' is over its daily cap — refusing to dispatch"
   313	        )
   314	
   315	    gauntlet = cfg.get("gauntlet", {})
   316	    required = len(gauntlet.get("reviewers", []))          # full set, always (seats)
   317	    families = int(gauntlet.get("min_model_families", 0))  # the family floor (task #10)
   318	
   319	    # Fail CLOSED. A missing/empty gauntlet would set both requirements to 0 and silently
   320	    # disable the completion guards — a job would sail to done with no review at all. An
   321	    # unconfigured panel is a refusal to dispatch, never an open door. (Sol re-gate)
   322	    if required < 1 or families < 1:
   323	        raise DispatchRefused(
   324	            "gauntlet is not configured (needs reviewers and min_model_families >= 1) "
   325	            "— refusing to dispatch work nothing would review"
   326	        )
   327	
   328	    # One transaction: the job must never exist for even a moment without its review
   329	    # requirements stamped on (autocommit would otherwise leave a floor-0 gap).
   330	    # IMMEDIATE because this reads before it writes — see dispatch_local.
   331	    conn.execute("BEGIN IMMEDIATE")
   332	    try:
   333	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   334	        conn.execute(
   335	            "UPDATE jobs SET required_reviews = ?, required_review_families = ? WHERE id = ?",
   336	            (required, families, job_id),
   337	        )
   338	        conn.execute("COMMIT")
   339	    except Exception:
   340	        conn.execute("ROLLBACK")
   341	        raise
   342	
   343	    run_id = _spawn(row, request, blocking=blocking)
   344	    attach_run(conn, job_id, run_id=run_id or "", branch=f"job/{job_id}")
   345	    set_status(conn, job_id, "in_progress")
   346	
   347	    return Dispatch(job_id=job_id, run_id=run_id, seat_id=builder_seat)
   348	
   349	
   350	def _spawn(seat_row, request: str, blocking: bool) -> str | None:
