   276	    --      on scope.'"
   277	    required_reviews INTEGER NOT NULL DEFAULT 0,
   278	
   279	    -- How many DISTINCT model families must have a passing review before done. This is
   280	    -- the floor "full set, always" doesn't itself guarantee: a full panel could still be
   281	    -- one family wearing three hats. Set at dispatch from the gauntlet's
   282	    -- min_model_families. Snapshotted and un-lowerable, like required_reviews. (task #10)
   283	    required_review_families INTEGER NOT NULL DEFAULT 0,
   284	
   285	    result        TEXT,                      -- final summary / diff ref
   286	    error         TEXT,
   287	
   288	    -- Voice wants a spoken-length answer; the text log keeps the detail (§5.3).
   289	    spoken_summary TEXT,
   290	
   291	    attempts      INTEGER NOT NULL DEFAULT 0,
   292	    parent_job_id INTEGER REFERENCES jobs(id) ON DELETE SET NULL,
   293	
   294	    -- DUPLICATE PROTECTION. A retry — a double-tap, a dropped connection, the voice
   295	    -- re-sending — must not start the same work twice. The caller stamps a key; a
