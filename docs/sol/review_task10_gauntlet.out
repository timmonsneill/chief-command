   132	# ---------------------------------------------------------------------------
   133	# The run loop — everything above, in order, for one job.
   134	# ---------------------------------------------------------------------------
   135	def run_job(job_id: int, *, cfg: dict[str, Any] | None = None) -> dict[str, Any]:
   136	    """Take one recorded job and actually do it. Safe to call in a thread.
   137	
   138	    Opens its own database connection (sqlite + threads). WAL mode lets this write
   139	    while the web server reads. Never raises to the caller — a worker that dies must
   140	    leave a legible 'failed' row, not a stack trace nobody sees.
   141	    """
   142	    conn = connect(DB_PATH)
   143	    try:
   144	        job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   145	        if job is None:
   146	            return {"job_id": job_id, "status": "missing"}
   147	        seat_row = seat(conn, job["builder_seat"])
   148	        if seat_row is None:
   149	            set_status(conn, job_id, "failed", error=f"unknown seat {job['builder_seat']}")
   150	            return {"job_id": job_id, "status": "failed"}
   151	
   152	        builder = _BUILDERS.get(seat_row["provider"])
   153	        if builder is None:
   154	            # A provider we don't have a local runner for (codex/xai/claude-cli builds
   155	            # go through OpenClaw, not this in-process worker). Say so plainly.
   156	            set_status(conn, job_id, "failed",
   157	                       error=f"no in-process builder for provider '{seat_row['provider']}' "
   158	                             "— this seat dispatches through OpenClaw")
   159	            _event(conn, job_id, seat_row, "error",
   160	                   "This worker only runs the local model directly.")
   161	            return {"job_id": job_id, "status": "failed"}
   162	
   163	        # 1. Isolate.
   164	        wt, wt_note = _make_worktree(job_id, job["branch"] or f"job/{job_id}")
   165	        conn.execute("UPDATE jobs SET worktree = ? WHERE id = ?", (str(wt), job_id))
   166	        _event(conn, job_id, seat_row, "dispatched", f"Working in its own copy ({wt_note}).")
   167	
   168	        # 2. Build.
   169	        model = job["tier"] and _model_for(seat_row, job["tier"]) or seat_row["model"]
   170	        _event(conn, job_id, seat_row, "thinking", "Working out how to do it.")
   171	        try:
   172	            result = builder(seat_row, job["request"], model)
   173	        except Exception as exc:  # network, model, timeout — all land here
   174	            set_status(conn, job_id, "failed", error=f"builder error: {exc}")
   175	            _event(conn, job_id, seat_row, "error", "The worker hit a problem.")
   176	            return {"job_id": job_id, "status": "failed"}
   177	
   178	        # 3. Land the output in the isolated copy, and version it.
   179	        out_dir = wt / OUTPUT_DIRNAME
   180	        out_dir.mkdir(parents=True, exist_ok=True)
   181	        (out_dir / f"job_{job_id}.txt").write_text(result)
   182	        version = _version_of(result)
   183	        set_head_version(conn, job_id, version)
   184	        _event(conn, job_id, seat_row, "write",
   185	               f"Wrote {len(result)} characters of work.", target=str(out_dir))
   186	
   187	        # 4. Park for review. The guards will hold it here until a real reviewer passes
   188	        #    THIS version — we never force it past them.
   189	        set_status(conn, job_id, "review", result=result)
   190	
   191	        # 5. Hand the frozen bundle to the review panel — several families at once,
   192	        #    all bound to THIS version. The panel decides nothing the database wouldn't;
   193	        #    it produces the verdicts the guards ask for. Without a config there is no
   194	        #    panel, and the job simply stays parked (the safe outcome, not a shortcut).
   195	        if cfg is not None:
   196	            import gauntlet
   197	            gauntlet.run_panel(conn, job_id, job["request"], result, version, cfg,
   198	                               db_path=DB_PATH)
   199	
   200	        final = conn.execute("SELECT status FROM jobs WHERE id = ?", (job_id,)).fetchone()["status"]
   201	        return {"job_id": job_id, "status": final, "version": version}
   202	    finally:
   203	        conn.close()
   204	
   205	
   206	def _model_for(seat_row, tier: str) -> str:
   207	    try:
   208	        from tiering import resolve_model
   209	        return resolve_model(seat_row, tier)[0]
   210	    except Exception:
   211	        return seat_row["model"]
   212	
   213	
   214	# ---------------------------------------------------------------------------
   215	# Fire-and-forget: start a worker in the background so the app stays responsive.
   216	# ---------------------------------------------------------------------------
   217	def start_in_background(job_id: int, *, cfg: dict[str, Any] | None = None) -> threading.Thread:
   218	    t = threading.Thread(
   219	        target=run_job, args=(job_id,), kwargs={"cfg": cfg},
   220	        name=f"job-{job_id}", daemon=True,
   221	    )
   222	    t.start()
   223	    return t
    90	            return "pass", stripped[:280]
    91	        if stripped.upper().startswith("FAIL"):
    92	            return "fail", stripped[:280]
    93	    return "fail", ("the reviewer did not answer in the required form: "
    94	                    + out.strip()[:200]) if out.strip() else "the reviewer said nothing"
    95	
    96	
    97	class ReviewerBroke(RuntimeError):
    98	    """The reviewer never rendered a judgement — the TOOL failed, not the work.
    99	
   100	    This distinction is the whole reason the class exists. A CLI that exits non-zero
   101	    (expired login, rate limit, renamed model) still prints something to stdout, and
   102	    that something contains no verdict line — so treating output as an answer records a
   103	    FAIL against the build. Verdicts are permanent and bound to the version, so an
   104	    infrastructure hiccup would condemn good work forever, and tell Neill a reviewer
   105	    "found a problem" when nothing reviewed anything. A broken reviewer is a SKIP.
   106	    """
   107	
   108	
   109	def _run_cli(cmd: list[str]) -> tuple[str, str]:
   110	    proc = subprocess.run(
   111	        cmd, capture_output=True, text=True, timeout=REVIEW_TIMEOUT_S,
   112	        stdin=subprocess.DEVNULL,
   113	    )
   114	    if proc.returncode != 0:
   115	        raise ReviewerBroke(
   116	            f"{cmd[0]} exited {proc.returncode}: "
   117	            f"{(proc.stderr or proc.stdout).strip()[:200]}"
   118	        )
   119	    return _parse_verdict(proc.stdout)
   120	
   121	
   122	def _prompt(request: str, code: str) -> str:
   123	    if len(code) > MAX_CODE_CHARS:
   124	        # Say so in the prompt itself. A reviewer that silently judged 20% of the work
   125	        # would be worse than one that didn't run.
   126	        code = (code[:MAX_CODE_CHARS]
   127	                + f"\n\n[TRUNCATED — {len(code) - MAX_CODE_CHARS} more characters were "
   128	                  "not shown. If you cannot judge the whole thing, answer FAIL.]")
   129	    return REVIEW_PROMPT.format(request=request, code=code)
   130	
   131	
   132	def _claude_review(request: str, code: str, model: str) -> tuple[str, str]:
   133	    return _run_cli(["claude", "-p", "--model", model, _prompt(request, code)])
   134	
   135	
   136	def _codex_review(request: str, code: str, model: str) -> tuple[str, str]:
   137	    """The GPT-family reviewer, through the codex CLI.
   138	
   139	    `--skip-git-repo-check` because the reviewer reads the work it was handed; it is not
   140	    operating on a checkout, and requiring one would tie the panel to where it runs.
   141	    """
   142	    return _run_cli(["codex", "exec", "--skip-git-repo-check", "--model", model,
   143	                     _prompt(request, code)])
   144	
   145	
   146	REVIEWERS: dict[str, Callable[[str, str, str], tuple[str, str]]] = {
   147	    "claude-cli": _claude_review,
   148	    "codex": _codex_review,
   149	    # xai / xai-api land here once the key is rotated — see seats.toml.
   150	}
   151	
   152	
   153	def has_runner(provider: str) -> bool:
   154	    return provider in REVIEWERS
   155	
