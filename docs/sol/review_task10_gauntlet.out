   326	# ═══════════════════════════════════════════════════════════════════════════════
   327	# DISPATCH — where "putting someone on it" stops being a figure of speech.
   328	#
   329	# This starts a REAL worker. Today it runs the free local coder, so the whole loop
   330	# can be exercised with no money and no keys: you type a job, a real model builds it
   331	# in its own isolated copy of the code, and a stronger model checks it before it can
   332	# be called done. The paid coding seats will hang off this same path through OpenClaw.
   333	# ═══════════════════════════════════════════════════════════════════════════════
   334	def _pick_local_builder(c) -> str | None:
   335	    """The free local coder, whatever it's named in this database."""
   336	    row = c.execute(
   337	        "SELECT id FROM seats WHERE provider = 'ollama' AND enabled = 1 ORDER BY id LIMIT 1"
   338	    ).fetchone()
   339	    return row["id"] if row else None
