     1	"""Durable job store for the Chief Command v2 harness.
     2	
     3	OpenClaw dispatches the work; this records it. Its subagent sessions auto-archive
     4	after ~60 minutes, so anything we want to answer later ("what did the overnight run
     5	do?", spec §7) has to live here.
     6	
     7	The two rules that must never quietly stop holding are enforced in schema.sql as
     8	triggers, not here — see guard_local_output_needs_review and
     9	guard_unresolved_escalation. This module will simply raise if you try to violate them.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import sqlite3
    15	from dataclasses import dataclass
    16	from pathlib import Path
    17	from typing import Any, Iterable, Optional
    18	
    19	DB_PATH = Path(__file__).resolve().parent / "chief.db"
    20	SCHEMA_PATH = Path(__file__).resolve().parent / "schema.sql"
    21	
    22	# Raised by the schema triggers. We surface it as something catchable.
    23	class GuardViolation(RuntimeError):
    24	    """A structural rule was violated (e.g. shipping unreviewed local output)."""
    25	
    26	
    27	@dataclass(frozen=True)
    28	class Seat:
    29	    id: str
    30	    provider: str
    31	    model: str
    32	    family: str  # gpt | claude | grok | qwen — what determines shared blind spots
    33	    tier: str  # local | subscription | metered
    34	    daily_cap_cents: Optional[int] = None   # hard ceiling across everything
    35	    build_cap_cents: Optional[int] = None   # ration the EXPENSIVE work
    36	    review_cap_cents: Optional[int] = None  # reviewing is cheap — be generous
    37	    # Three models per seat. NOTHING gets `heavy` by default — it has to be earned.
    38	    # Rate limits, not money, are the binding constraint on autonomous work, and you
    39	    # cannot buy your way out of a weekly cap.
    40	    model_light: Optional[str] = None
    41	    model_standard: Optional[str] = None
    42	    model_heavy: Optional[str] = None
    43	    enabled: bool = True
    44	    notes: str = ""
    45	
    46	
    47	def connect(db_path: Path | str = DB_PATH) -> sqlite3.Connection:
    48	    conn = sqlite3.connect(db_path, isolation_level=None)  # autocommit; we manage txns
    49	    conn.row_factory = sqlite3.Row
    50	    conn.execute("PRAGMA foreign_keys = ON")
    51	    return conn
    52	
    53	
    54	def init_db(conn: sqlite3.Connection) -> None:
    55	    """Build the schema on a FRESH database only.
    56	
    57	    This used to run schema.sql on EVERY call — including server startup against the LIVE
    58	    DB. That made editing schema.sql a silent live deploy: a new `CREATE TRIGGER IF NOT
    59	    EXISTS` installs on the next restart while `CREATE TABLE IF NOT EXISTS` stays a no-op,
    60	    so a trigger can land WITHOUT the column it references and jam every status change (it
    61	    did, 2026-07-20). An existing DB now advances ONLY through the numbered migrations in
    62	    db/migrations/, applied deliberately — never as a side effect of a restart.
    63	    """
    64	    initialized = conn.execute(
    65	        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'jobs'"
    66	    ).fetchone()
    67	    if initialized:
    68	        return
    69	    conn.executescript(SCHEMA_PATH.read_text())
    70	
    71	
    72	def _guarded(fn):
    73	    """Translate the schema's RAISE(ABORT, 'guard: ...') into GuardViolation."""
    74	
    75	    def wrapper(*args, **kwargs):
    76	        try:
    77	            return fn(*args, **kwargs)
    78	        except sqlite3.IntegrityError as exc:
    79	            if "guard:" in str(exc):
    80	                raise GuardViolation(str(exc)) from exc
    81	            raise
    82	
    83	    return wrapper
    84	
    85	
    86	# --------------------------------------------------------------------------
    87	# Seats
    88	# --------------------------------------------------------------------------
    89	def upsert_seat(conn: sqlite3.Connection, seat: Seat) -> None:
    90	    conn.execute(
    91	        """
    92	        INSERT INTO seats (id, provider, model, family, tier, daily_cap_cents,
    93	                           build_cap_cents, review_cap_cents,
    94	                           model_light, model_standard, model_heavy, enabled, notes)
    95	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    96	        ON CONFLICT(id) DO UPDATE SET
    97	            provider = excluded.provider,
    98	            model = excluded.model,
    99	            family = excluded.family,
   100	            tier = excluded.tier,
   101	            daily_cap_cents = excluded.daily_cap_cents,
   102	            build_cap_cents = excluded.build_cap_cents,
   103	            review_cap_cents = excluded.review_cap_cents,
   104	            model_light = excluded.model_light,
   105	            model_standard = excluded.model_standard,
   106	            model_heavy = excluded.model_heavy,
   107	            enabled = excluded.enabled,
   108	            notes = excluded.notes
   109	        """,
   110	        (seat.id, seat.provider, seat.model, seat.family, seat.tier,
   111	         seat.daily_cap_cents, seat.build_cap_cents, seat.review_cap_cents,
   112	         seat.model_light, seat.model_standard, seat.model_heavy,
   113	         int(seat.enabled), seat.notes),
   114	    )
   115	
   116	
   117	def seat(conn: sqlite3.Connection, seat_id: str) -> sqlite3.Row | None:
   118	    return conn.execute("SELECT * FROM seats WHERE id = ?", (seat_id,)).fetchone()
   119	
   120	
   121	# --------------------------------------------------------------------------
   122	# Jobs
   123	# --------------------------------------------------------------------------
   124	def create_job(
   125	    conn: sqlite3.Connection,
   126	    request: str,
   127	    builder_seat: str,
   128	    origin: str = "text",
   129	    parent_job_id: Optional[int] = None,
   130	    task_name: Optional[str] = None,
   131	) -> int:
   132	    """task_name is the 2-4 word handle the voice will use ("the rate limiter").
   133	
   134	    The mouth coins it at dispatch. Without one the voice falls back to truncating
   135	    the request, which reads back the owner's own paragraph at him — exactly what a
   136	    colleague would never do.
   137	    """
   138	    row = seat(conn, builder_seat)
   139	    if row is None:
   140	        raise ValueError(f"unknown builder seat: {builder_seat}")
   141	
   142	    # Snapshot who built this, AT BUILD TIME. Sol's cross-family review found that
   143	    # reading the builder's tier live meant re-tiering a local seat retroactively
   144	    # legitimized its old unreviewed work. What a seat is today cannot change what
   145	    # it was. The schema then freezes these columns.
   146	    cur = conn.execute(
   147	        """
   148	        INSERT INTO jobs (request, builder_seat, builder_tier, builder_family,
   149	                          origin, parent_job_id, task_name)
   150	        VALUES (?, ?, ?, ?, ?, ?, ?)
   151	        """,
   152	        (request, builder_seat, row["tier"], row["family"],
   153	         origin, parent_job_id, task_name),
   154	    )
   155	    return int(cur.lastrowid)
   156	
   157	
   158	def claim_next_job(conn: sqlite3.Connection, builder_seat: str) -> sqlite3.Row | None:
   159	    """Atomically claim the oldest queued job for this seat.
   160	
   161	    Uses UPDATE...RETURNING against a subquery so two workers racing for the same
   162	    row cannot both win — SQLite serializes the write and only one claim lands.
   163	    Cribbed from clu's approach; it removes the need for any external lock.
   164	    """
   165	    row = conn.execute(
   166	        """
   167	        UPDATE jobs
   168	           SET status = 'in_progress',
   169	               started_at = datetime('now'),
   170	               attempts = attempts + 1
   171	         WHERE id = (
   172	             SELECT id FROM jobs
   173	              WHERE status = 'todo' AND builder_seat = ?
   174	              ORDER BY id
   175	              LIMIT 1
   176	         )
   177	        RETURNING *
   178	        """,
   179	        (builder_seat,),
   180	    ).fetchone()
   181	    return row
   182	
   183	
   184	def attach_run(
   185	    conn: sqlite3.Connection,
   186	    job_id: int,
   187	    run_id: str,
   188	    session_key: str | None = None,
   189	    branch: str | None = None,
   190	    worktree: str | None = None,
   191	) -> None:
   192	    """Record the OpenClaw spawn that is actually doing the work."""
   193	    conn.execute(
   194	        """
   195	        UPDATE jobs SET run_id = ?, session_key = ?, branch = ?, worktree = ?
   196	         WHERE id = ?
   197	        """,
   198	        (run_id, session_key, branch, worktree, job_id),
   199	    )
   200	
   201	
   202	@_guarded
   203	def set_head_version(conn: sqlite3.Connection, job_id: int, version: str) -> None:
   204	    """Record the exact version (git commit id) the builder is putting forward.
   205	
   206	    This is the pivot of the review-to-version chain: every completion guard only
   207	    counts verdicts whose reviewed_version matches this. Calling it again after the
   208	    builder iterates voids all earlier approvals by construction — nothing needs to
   209	    remember to revoke them. Frozen by the schema once the job is done.
   210	    """
   211	    if not version or not version.strip():
   212	        raise ValueError("a version must actually name a version")
   213	    conn.execute(
   214	        "UPDATE jobs SET head_version = ? WHERE id = ?", (version.strip(), job_id)
   215	    )
   216	
   217	
   218	@_guarded
   219	def set_status(
   220	    conn: sqlite3.Connection,
   221	    job_id: int,
   222	    status: str,
   223	    result: str | None = None,
   224	    error: str | None = None,
   225	    spoken_summary: str | None = None,
   226	) -> None:
   227	    """Move a job's status.
   228	
   229	    Moving to 'done' runs the schema guards. If the builder was a local seat and no
   230	    higher-tier reviewer has passed it, this raises GuardViolation — by design.
   231	    """
   232	    finished = status in ("done", "failed", "cancelled")
   233	    conn.execute(
   234	        """
   235	        UPDATE jobs
   236	           SET status = ?,
   237	               result = COALESCE(?, result),
   238	               error = COALESCE(?, error),
   239	               spoken_summary = COALESCE(?, spoken_summary),
   240	               finished_at = CASE WHEN ? THEN datetime('now') ELSE finished_at END
   241	         WHERE id = ?
   242	        """,
   243	        (status, result, error, spoken_summary, int(finished), job_id),
   244	    )
   245	
   246	
   247	def record_artifact(
   248	    conn: sqlite3.Connection,
   249	    job_id: int,
   250	    kind: str,
   251	    path: str | None = None,
   252	    value: str | None = None,
   253	    flow: str | None = None,
   254	    captured_by: str = "playwright",
   255	) -> int:
   256	    """Record GROUND TRUTH.
   257	
   258	    Two kinds, and they have different rules about who may write them:
   259	
   260	    EVIDENCE OF A BUILD (screenshot, trace, logs, exit codes) — only the harness or
   261	    Playwright. NEVER a model. A model cannot fabricate a screenshot, which is what
   262	    makes "I ran it and it worked" unsayable.
   263	
   264	    EVIDENCE OF A CLAIM (source, quote) — a model MAY write these, because a
   265	    researcher's whole job is to hand you a URL you can go and read yourself. The
   266	    check isn't "who wrote it down", it's "can someone else go and look?" — which is
   267	    why a different family has to read the sources cold (guard 8).
   268	    """
   269	    _MODEL_MAY_CITE = {"source", "quote"}
   270	    if captured_by == "model" and kind not in _MODEL_MAY_CITE:
   271	        raise ValueError(
   272	            f"a model may cite a source, but it may not produce a '{kind}' — "
   273	            "build evidence is captured by the harness, never claimed by a model"
   274	        )
   275	    if captured_by not in ("harness", "playwright", "model"):
   276	        raise ValueError(f"unknown artifact origin: {captured_by}")
   277	    cur = conn.execute(
   278	        """
   279	        INSERT INTO artifacts (job_id, kind, path, value, flow, captured_by)
   280	        VALUES (?, ?, ?, ?, ?, ?)
   281	        """,
   282	        (job_id, kind, path, value, flow, captured_by),
   283	    )
   284	    return int(cur.lastrowid)
   285	
   286	
   287	@_guarded
   288	def record_verdict(
   289	    conn: sqlite3.Connection,
   290	    job_id: int,
   291	    reviewer_seat: str,
   292	    verdict: str,
   293	    severity: str | None = None,
   294	    summary: str | None = None,
   295	    detail: str | None = None,
   296	    role: str = "reviewer",
   297	    reviewed_version: str | None = None,
   298	) -> int:
   299	    """Record one seat's verdict.
   300	
   301	    role='reviewer' reads the diff and judges it.
   302	    role='tester'   drove the app (Playwright) and judges what it observed. Two guards
   303	                    apply: it must cite captured artifacts, and its family must differ
   304	                    from the builder's — Playwright stops a tester fabricating what
   305	                    happened; only a different mind stops it rationalizing it.
   306	
   307	    reviewed_version is WHAT the reviewer looked at. The gauntlet runner pins the
   308	    version before handing work to a reviewer and must pass it explicitly. When
   309	    omitted, it defaults to the job's current head_version — correct only when
   310	    nothing moved between review and recording, which the runner must guarantee.
   311	    A verdict whose version stops matching the job simply stops counting.
   312	
   313	    tier and family are snapshotted from the seat at write time, so re-tiering or
   314	    re-pointing a seat later cannot retroactively legitimize a job.
   315	    """
   316	    row = seat(conn, reviewer_seat)
   317	    if row is None:
   318	        raise ValueError(f"unknown seat: {reviewer_seat}")
   319	
   320	    if reviewed_version is None:
   321	        job_row = conn.execute(
   322	            "SELECT head_version FROM jobs WHERE id = ?", (job_id,)
   323	        ).fetchone()
   324	        if job_row is not None:
   325	            reviewed_version = job_row["head_version"]
   326	
   327	    cur = conn.execute(
   328	        """
   329	        INSERT INTO verdicts
   330	            (job_id, reviewer_seat, reviewer_tier, role, model_family,
   331	             verdict, severity, summary, detail, reviewed_version)
   332	        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
   333	        """,
   334	        (job_id, reviewer_seat, row["tier"], role, row["family"],
   335	         verdict, severity, summary, detail, reviewed_version),
   336	    )
   337	    return int(cur.lastrowid)
   338	
   339	
   340	def resolve_escalation(conn: sqlite3.Connection, verdict_id: int, verdict: str) -> None:
   341	    """Answer a needs_human verdict so the job can proceed (§6 human review queue)."""
   342	    if verdict not in ("pass", "fail"):
   343	        raise ValueError("an escalation resolves to 'pass' or 'fail'")
   344	    conn.execute("UPDATE verdicts SET verdict = ? WHERE id = ?", (verdict, verdict_id))
   345	
   346	
   347	# --------------------------------------------------------------------------
   348	# Reporting — this is what the voice layer reads back
   349	# --------------------------------------------------------------------------
   350	def overnight_report(conn: sqlite3.Connection, since: str = "-1 day") -> list[sqlite3.Row]:
   351	    """Answers spec §7's 'what did the overnight run do?'"""
   352	    return conn.execute(
   353	        """
   354	        SELECT * FROM job_report
   355	         WHERE created_at >= datetime('now', ?)
   356	         ORDER BY id
   357	        """,
   358	        (since,),
   359	    ).fetchall()
   360	
   361	
   362	def spend_today(conn: sqlite3.Connection, seat_id: str) -> int:
   363	    row = conn.execute(
   364	        "SELECT COALESCE(SUM(cost_cents), 0) AS c FROM usage WHERE seat_id = ? AND day = date('now')",
   365	        (seat_id,),
   366	    ).fetchone()
   367	    return int(row["c"])
   368	
   369	
   370	def over_budget(conn: sqlite3.Connection, seat_id: str) -> bool:
   371	    """True if this seat has hit its daily cap.
   372	
   373	    OpenClaw has no per-agent budget of any kind, so the harness must check this
   374	    before dispatching. Uncapped seats (daily_cap_cents IS NULL) never block.
   375	    """
   376	    row = seat(conn, seat_id)
   377	    if row is None or row["daily_cap_cents"] is None:
   378	        return False
   379	    return spend_today(conn, seat_id) >= int(row["daily_cap_cents"])
   380	
   381	
   382	@_guarded
   383	def record_usage(
   384	    conn: sqlite3.Connection,
   385	    seat_id: str,
   386	    cost_cents: int,
   387	    job_id: int | None = None,
   388	    input_tokens: int = 0,
   389	    output_tokens: int = 0,
   390	    role: str = "build",
   391	) -> None:
   392	    """Record spend. The DATABASE refuses an entry that would breach the daily cap.
   393	
   394	    This used to be a Python check before dispatch — which Sol correctly called a
   395	    race (two dispatches both pass the check before either records spend) and easily
   396	    bypassed by any direct write. The ledger itself now says no.
   397	    """
   398	    conn.execute(
   399	        """
   400	        INSERT INTO usage (seat_id, job_id, role, input_tokens, output_tokens, cost_cents)
   401	        VALUES (?, ?, ?, ?, ?, ?)
   402	        """,
   403	        (seat_id, job_id, role, input_tokens, output_tokens, cost_cents),
   404	    )
   405	
   406	
   407	def can_build(conn: sqlite3.Connection, seat_id: str) -> bool:
   408	    """Has this seat used up its BUILDING budget? (It may still be able to review.)"""
   409	    row = seat(conn, seat_id)
   410	    if row is None or row["build_cap_cents"] is None:
   411	        return True
   412	    spent = conn.execute(
   413	        "SELECT COALESCE(SUM(cost_cents),0) c FROM usage "
   414	        "WHERE seat_id=? AND day=date('now') AND role='build'", (seat_id,)
   415	    ).fetchone()["c"]
   416	    return int(spent) < int(row["build_cap_cents"])
   417	
   418	
   419	# ---------------------------------------------------------------------------
   420	# The money
   421	# ---------------------------------------------------------------------------
   422	def month_spend(conn: sqlite3.Connection) -> dict[str, int]:
   423	    """What have we spent this month, and how close are we?"""
   424	    r = conn.execute("SELECT * FROM month_spend").fetchone()
   425	    spent, cap, warn = int(r["spent_cents"]), int(r["cap_cents"]), int(r["warn_cents"])
   426	    return {
   427	        "spent_cents": spent,
   428	        "cap_cents": cap,
   429	        "warn_cents": warn,
   430	        "remaining_cents": max(0, cap - spent),
     1	"""The review panel (spec §6, task #10) — several different minds check the same work,
     2	at the same time, against one frozen version.
     3	
     4	Before this file, dispatch ran ONE reviewer. That is enough to close the loop and it is
     5	not the design: the property this project exists to guarantee is that *a different mind*
     6	looked, because different model families miss different bugs. One reviewer cannot
     7	provide it, and a panel of three seats that all run on the same model provides it no
     8	better — which is why the floor counts FAMILIES, not seats.
     9	
    10	Four things are load-bearing here:
    11	
    12	  1. ONE FROZEN BUNDLE. Every reviewer is handed the identical version string and the
    13	     identical code. Nothing re-reads the job row mid-panel. Two verdicts must never
    14	     bind to two different versions of "the same" work.
    15	
    16	  2. NOTHING IS ASSUMED — only recorded. A family counts when a verdict from that
    17	     family is on the record for THIS version. A reviewer that was skipped, capped out,
    18	     or crashed contributes nothing, and the panel says so out loud (see `runs`).
    19	
    20	  3. FAIL CLOSED. Too few families, any failure, any unanswered escalation → the job
    21	     stays parked. The panel never lowers the bar to reach a conclusion, and it never
    22	     forces a status past the database guards. It feeds them.
    23	
    24	  4. THE DATABASE IS THE BOUNDARY, NOT THIS FILE. Everything below is also enforced in
    25	     schema.sql as triggers. If this module were wrong, or replaced by something
    26	     careless, the guards would still refuse. That is deliberate: Python decides what to
    27	     TRY; the schema decides what is ALLOWED.
    28	
    29	Threads, not async: each reviewer is a subprocess call that blocks for tens of seconds,
    30	and each thread opens its OWN sqlite connection (connections are not shareable across
    31	threads).
    32	"""
    33	
    34	from __future__ import annotations
    35	
    36	import subprocess
    37	import threading
    38	from dataclasses import dataclass, field
    39	from pathlib import Path
    40	from typing import Any, Callable
    41	
    42	from db.jobs import (
    43	    GuardViolation,
    44	    connect,
    45	    over_budget,
    46	    record_usage,
    47	    record_verdict,
    48	    seat,
    49	    set_status,
    50	)
    51	
    52	DB_PATH = Path(__file__).resolve().parent / "db" / "chief.db"
    53	
    54	REVIEW_TIMEOUT_S = 300          # a reviewer that hasn't answered by now has hung
    55	DEFAULT_ESTIMATE_CENTS = 5      # what we reserve for a metered review before calling
    56	
    57	
    58	# ---------------------------------------------------------------------------
    59	# The reviewers themselves. One function per provider — adding a family to the
    60	# panel is adding a function here and a seat in seats.toml. Nothing else.
    61	# ---------------------------------------------------------------------------
    62	REVIEW_PROMPT = (
    63	    "You are reviewing another model's work. Judge it on whether it actually does what "
    64	    "was asked, and whether it is correct.\n"
    65	    "Reply with EXACTLY one line, nothing else:\n"
    66	    "  PASS <one-line reason>   — it is correct and does what was asked\n"
    67	    "  FAIL <one-line reason>   — it is wrong, incomplete, or unsafe\n\n"
    68	    "The task was: {request}\n\nThe work:\n{code}"
    69	)
    70	
    71	
    72	MAX_CODE_CHARS = 200_000        # past this the CLI's argument list won't hold it
    73	
    74	
    75	def _parse_verdict(out: str) -> tuple[str, str]:
    76	    """Pull the verdict line out of a CLI's output.
    77	
    78	    Read from the END. The prompt we send contains the literal words "PASS <one-line
    79	    reason>" and "FAIL <one-line reason>", and CLIs echo their input — codex puts that
    80	    echo on stderr today, but taking the FIRST match would turn any release that moves
    81	    it to stdout into an automatic pass on every review. Reading backwards makes the
    82	    model's actual answer, which comes last, the one that counts.
    83	
    84	    Deliberately biased toward FAIL: a reviewer whose answer we cannot read has not
    85	    passed anything. Silence is not approval.
    86	    """
    87	    for line in reversed(out.splitlines()):
    88	        stripped = line.strip()
    89	        if stripped.upper().startswith("PASS"):
    90	            return "pass", stripped[:280]
    91	        if stripped.upper().startswith("FAIL"):
    92	            return "fail", stripped[:280]
    93	    return "fail", ("the reviewer did not answer in the required form: "
    94	                    + out.strip()[:200]) if out.strip() else "the reviewer said nothing"
    95	
    96	
    97	class ReviewerBroke(RuntimeError):
    98	    """The reviewer never rendered a judgement — the TOOL failed, not the work.
    99	
   100	    This distinction is the whole reason the class exists. A CLI that exits non-zero
   101	    (expired login, rate limit, renamed model) still prints something to stdout, and
   102	    that something contains no verdict line — so treating output as an answer records a
   103	    FAIL against the build. Verdicts are permanent and bound to the version, so an
   104	    infrastructure hiccup would condemn good work forever, and tell Neill a reviewer
   105	    "found a problem" when nothing reviewed anything. A broken reviewer is a SKIP.
   106	    """
   107	
   108	
   109	def _run_cli(cmd: list[str]) -> tuple[str, str]:
   110	    proc = subprocess.run(
   111	        cmd, capture_output=True, text=True, timeout=REVIEW_TIMEOUT_S,
   112	        stdin=subprocess.DEVNULL,
   113	    )
   114	    if proc.returncode != 0:
   115	        raise ReviewerBroke(
   116	            f"{cmd[0]} exited {proc.returncode}: "
   117	            f"{(proc.stderr or proc.stdout).strip()[:200]}"
   118	        )
   119	    return _parse_verdict(proc.stdout)
   120	
   121	
   122	def _prompt(request: str, code: str) -> str:
   123	    if len(code) > MAX_CODE_CHARS:
   124	        # Say so in the prompt itself. A reviewer that silently judged 20% of the work
   125	        # would be worse than one that didn't run.
   126	        code = (code[:MAX_CODE_CHARS]
   127	                + f"\n\n[TRUNCATED — {len(code) - MAX_CODE_CHARS} more characters were "
   128	                  "not shown. If you cannot judge the whole thing, answer FAIL.]")
   129	    return REVIEW_PROMPT.format(request=request, code=code)
   130	
   131	
   132	def _claude_review(request: str, code: str, model: str) -> tuple[str, str]:
   133	    return _run_cli(["claude", "-p", "--model", model, _prompt(request, code)])
   134	
   135	
   136	def _codex_review(request: str, code: str, model: str) -> tuple[str, str]:
   137	    """The GPT-family reviewer, through the codex CLI.
   138	
   139	    `--skip-git-repo-check` because the reviewer reads the work it was handed; it is not
   140	    operating on a checkout, and requiring one would tie the panel to where it runs.
   141	    """
   142	    return _run_cli(["codex", "exec", "--skip-git-repo-check", "--model", model,
   143	                     _prompt(request, code)])
   144	
   145	
   146	REVIEWERS: dict[str, Callable[[str, str, str], tuple[str, str]]] = {
   147	    "claude-cli": _claude_review,
   148	    "codex": _codex_review,
   149	    # xai / xai-api land here once the key is rotated — see seats.toml.
   150	}
   151	
   152	
   153	def has_runner(provider: str) -> bool:
   154	    return provider in REVIEWERS
   155	
   156	
   157	# ---------------------------------------------------------------------------
   158	# What came back
   159	# ---------------------------------------------------------------------------
   160	@dataclass
   161	class ReviewerRun:
   162	    """One seat's participation — including the ones that did NOT participate.
   163	
   164	    A skipped reviewer is part of the result, never an omission. "No silent caps": a
   165	    panel that quietly shrank reads as a full panel to anyone looking at the verdicts.
   166	    """
   167	    seat_id: str
   168	    family: str = ""
   169	    verdict: str | None = None      # pass | fail | needs_human | None if it never ran
   170	    summary: str = ""
   171	    skipped: str = ""               # why it didn't run, in plain words
   172	
   173	    @property
   174	    def ran(self) -> bool:
   175	        return self.verdict is not None
   176	
   177	
   178	@dataclass
   179	class PanelResult:
   180	    job_id: int
   181	    version: str
   182	    required_families: int
   183	    runs: list[ReviewerRun] = field(default_factory=list)
   184	    certified: bool = False         # did the job actually reach 'done'
   185	    parked_reason: str = ""         # if not, why — in plain words
   186	
   187	    @property
   188	    def families_passed(self) -> set[str]:
   189	        return {r.family for r in self.runs if r.verdict == "pass"}
   190	
   191	    @property
   192	    def failed(self) -> list[ReviewerRun]:
   193	        return [r for r in self.runs if r.verdict == "fail"]
   194	
   195	    def as_dict(self) -> dict[str, Any]:
   196	        return {
   197	            "job_id": self.job_id,
   198	            "version": self.version,
   199	            "required_families": self.required_families,
   200	            "families_passed": sorted(self.families_passed),
   201	            "certified": self.certified,
   202	            "parked_reason": self.parked_reason,
   203	            "runs": [
   204	                {"seat": r.seat_id, "family": r.family, "verdict": r.verdict,
   205	                 "summary": r.summary, "skipped": r.skipped}
   206	                for r in self.runs
   207	            ],
   208	        }
   209	
   210	    def spoken(self) -> str:
   211	        """One sentence for the voice. No seat names, no jargon."""
   212	        n = len([r for r in self.runs if r.ran])
   213	        minds = len(self.families_passed)
   214	        if self.certified:
   215	            return f"{n} different models checked it and it passed. Ready for you."
   216	        if self.failed:
   217	            return "It was checked and sent back — one of the reviewers found a problem."
   218	        return f"Only {minds} of the {self.required_families} required models could check it, so it's waiting."
   219	
   220	
   221	# ---------------------------------------------------------------------------
   222	# The panel
   223	# ---------------------------------------------------------------------------
   224	def _event(conn, job_id: int, seat_row, kind: str, detail: str) -> None:
   225	    conn.execute(
   226	        "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   227	        "VALUES (?, ?, ?, ?, ?, ?, ?)",
   228	        (job_id, seat_row["id"], seat_row["id"], seat_row["model"],
   229	         seat_row["family"], kind, detail),
   230	    )
   231	
   232	
   233	def _reserve_review_budget(conn, seat_id: str, job_id: int, cents: int) -> bool:
   234	    """Take the money BEFORE the call, not after.
   235	
   236	    Sol: "refusing to RECORD a charge doesn't unspend it." Two reviewers reserving at
   237	    once both hit the ledger, and the ledger's own cap trigger refuses the one that
   238	    would breach — so the race resolves in the database, not in a Python check that
   239	    both threads passed a moment earlier. Uncapped seats reserve nothing.
   240	    """
   241	    row = seat(conn, seat_id)
   242	    if row is None or row["daily_cap_cents"] is None:
   243	        return True
   244	    try:
   245	        record_usage(conn, seat_id, cents, job_id=job_id, role="review")
   246	        return True
   247	    except GuardViolation:
   248	        return False
   249	
   250	
   251	def _review_one(
   252	    job_id: int,
   253	    seat_id: str,
   254	    request: str,
   255	    code: str,
   256	    version: str,
   257	    cfg: dict[str, Any],
   258	    out: ReviewerRun,
   259	    db_path: Path,
   260	) -> None:
   261	    """One reviewer, in its own thread, on its own connection. Never raises."""
   262	    conn = connect(db_path)
   263	    try:
   264	        row = seat(conn, seat_id)
   265	        if row is None:
   266	            out.skipped = "that reviewer isn't set up"
   267	            return
   268	        out.family = row["family"]
   269	        if not row["enabled"]:
   270	            out.skipped = "that reviewer is turned off"
   271	            return
   272	        runner = REVIEWERS.get(row["provider"])
   273	        if runner is None:
   274	            out.skipped = "we can't run that reviewer on this machine yet"
   275	            _event(conn, job_id, row, "skipped", out.skipped)
   276	            return
   277	        if over_budget(conn, seat_id):
   278	            out.skipped = "that reviewer is out of budget for today"
   279	            _event(conn, job_id, row, "skipped", out.skipped)
   280	            return
   281	
   282	        estimate = int(
   283	            cfg.get("seats", {}).get(seat_id, {}).get(
   284	                "review_estimate_cents", DEFAULT_ESTIMATE_CENTS)
   285	        )
   286	        if not _reserve_review_budget(conn, seat_id, job_id, estimate):
   287	            out.skipped = "that reviewer is out of budget for today"
   288	            _event(conn, job_id, row, "skipped", out.skipped)
   289	            return
   290	
   291	        _event(conn, job_id, row, "thinking", "Checking the work.")
   292	        try:
   293	            verdict, summary = runner(request, code, row["model"])
   294	        except subprocess.TimeoutExpired:
   295	            out.skipped = "that reviewer took too long and was stopped"
   296	            _event(conn, job_id, row, "error", out.skipped)
   297	            return
   298	        except Exception as exc:                      # noqa: BLE001 — a dead reviewer
   299	            out.skipped = "that reviewer couldn't finish"   # is a skip, never a pass
   300	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:120]}")
   301	            return
   302	
   303	        # reviewed_version is passed EXPLICITLY, never defaulted. The default reads the
   304	        # job's current head — which is only correct if nothing moved, and the whole
   305	        # point of the frozen bundle is not to depend on that being true.
   306	        try:
   307	            record_verdict(conn, job_id, seat_id, verdict=verdict,
   308	                           summary=summary, role="reviewer", reviewed_version=version)
   309	        except GuardViolation as exc:
   310	            out.skipped = "the record refused that verdict"
   311	            _event(conn, job_id, row, "error", str(exc)[:160])
   312	            return
   313	
   314	        out.verdict, out.summary = verdict, summary
   315	        _event(conn, job_id, row, "verdict",
   316	               "Passed the check." if verdict == "pass" else "Sent it back with notes.")
   317	    finally:
   318	        conn.close()
   319	
   320	
   321	def run_panel(
   322	    conn,
   323	    job_id: int,
   324	    request: str,
   325	    code: str,
   326	    version: str,
   327	    cfg: dict[str, Any],
   328	    *,
   329	    roster: list[str] | None = None,
   330	    db_path: Path | None = None,
   331	) -> PanelResult:
   332	    """Run the whole panel in parallel against one frozen bundle, then decide.
   333	
   334	    `conn` is the caller's connection, used only for the final decision. Each reviewer
   335	    gets its own. Returns what actually happened — including who didn't run and why.
   336	    """
   337	    gauntlet = cfg.get("gauntlet", {})
   338	    roster = roster if roster is not None else list(gauntlet.get("reviewers", []))
   339	    floor = int(gauntlet.get("min_model_families", 0))
   340	    db_path = db_path or DB_PATH
   341	
   342	    result = PanelResult(job_id=job_id, version=version, required_families=floor)
   343	    result.runs = [ReviewerRun(seat_id=s) for s in roster]
   344	
   345	    threads = [
   346	        threading.Thread(
   347	            target=_review_one,
   348	            args=(job_id, run.seat_id, request, code, version, cfg, run, db_path),
   349	            name=f"review-{job_id}-{run.seat_id}", daemon=True,
   350	        )
   351	        for run in result.runs
   352	    ]
   353	    for t in threads:
   354	        t.start()
   355	    for t in threads:
   356	        t.join(timeout=REVIEW_TIMEOUT_S + 30)
   357	
   358	    # ── The decision. Every branch below ends in "leave it parked" except one. ──
   359	    if result.failed:
   360	        result.parked_reason = "a reviewer failed this version"
   361	        return result
   362	
   363	    families = result.families_passed
   364	    if len(families) < floor:
   365	        ran = len([r for r in result.runs if r.ran])
   366	        result.parked_reason = (
   367	            f"only {len(families)} model famil{'y' if len(families) == 1 else 'ies'} "
   368	            f"reviewed this ({ran} of {len(result.runs)} reviewers ran); "
   369	            f"{floor} are required"
   370	        )
   371	        return result
   372	
   373	    try:
   374	        set_status(conn, job_id, "done",
   375	                   spoken_summary=f"Checked by {len(families)} different models. Ready for you.")
   376	        result.certified = True
   377	    except GuardViolation as exc:
   378	        # Another gate still holds (panel size, an unanswered escalation, an old
   379	        # objection). Park honestly rather than argue with the boundary.
   380	        result.parked_reason = str(exc).replace("guard: ", "")
   381	    return result
   382	
   383	
   384	def run_gauntlet_for_job(conn, job_id: int, cfg: dict[str, Any], *,
   385	                         db_path: Path | None = None) -> PanelResult:
   386	    """Run the panel for a job that is already parked at review.
   387	
   388	    Reads the frozen bundle off the job row ONCE — the request, the output that was put
   389	    forward, and the version it was recorded under — and hands that same snapshot to
   390	    everyone.
   391	    """
   392	    job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   393	    if job is None:
   394	        raise ValueError(f"no such job: {job_id}")
   395	    if not job["head_version"]:
   396	        # Nothing was put forward, so there is nothing to bind a verdict to. A verdict
   397	        # with no version condemns or approves we-don't-know-what.
   398	        return PanelResult(job_id=job_id, version="", required_families=0,
   399	                           parked_reason="no finished version to review")
   400	    return run_panel(conn, job_id, job["request"], job["result"] or "",
   401	                     job["head_version"], cfg, db_path=db_path)
     1	"""The bridge: OpenClaw dispatches the work, the job store decides whether it may run.
     2	
     3	This is the piece that turns three separate things (a pinned OpenClaw, a job store,
     4	a seat config) into a system.
     5	
     6	Design decision worth stating, because it drives everything else:
     7	
     8	    THE JOB STORE IS THE SOURCE OF TRUTH, NOT A LISTENER.
     9	
    10	We record the job BEFORE we spawn it, and we refuse to spawn if the store says no
    11	(over budget, seat disabled). If we merely *observed* OpenClaw's events, work could
    12	run that was never recorded — and OpenClaw's subagent sessions auto-archive after
    13	~60 minutes and get soft-deleted, so anything we didn't write down is simply gone.
    14	Spec §7 wants "what did the overnight run do?" to be answerable. That only works if
    15	nothing can run without a row.
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	import json
    21	import subprocess
    22	import sys
    23	import tomllib
    24	from dataclasses import dataclass
    25	from pathlib import Path
    26	from typing import Any
    27	
    28	sys.path.insert(0, str(Path(__file__).resolve().parent))
    29	
    30	from db.jobs import (  # noqa: E402
    31	    Seat,
    32	    attach_run,
    33	    connect,
    34	    create_job,
    35	    init_db,
    36	    over_budget,
    37	    record_artifact,
    38	    record_verdict,
    39	    seat,
    40	    set_status,
    41	    upsert_seat,
    42	)
    43	
    44	CONFIG = Path(__file__).resolve().parent / "config" / "seats.toml"
    45	
    46	
    47	class DispatchRefused(RuntimeError):
    48	    """The harness declined to dispatch. Budget, disabled seat, or a guard."""
    49	
    50	
    51	# ---------------------------------------------------------------------------
    52	# The REAL, in-process dispatch path (task #9).
    53	#
    54	# dispatch()/_spawn() below hand work to OpenClaw — the production path, for the
    55	# paid coding seats. This one runs the free LOCAL model directly, in a background
    56	# worker, so the whole spine can be exercised end-to-end today with no money and no
    57	# exposed keys. Same recording, same guards, same worktree isolation.
    58	# ---------------------------------------------------------------------------
    59	@dataclass
    60	class LocalDispatch:
    61	    job_id: int
    62	    seat_id: str
    63	    reused: bool          # True = a duplicate key matched an existing job
    64	    tier: str
    65	    tier_reason: str
    66	
    67	
    68	def dispatch_local(
    69	    conn,
    70	    request: str,
    71	    builder_seat: str,
    72	    *,
    73	    cfg: dict[str, Any] | None = None,
    74	    origin: str = "text",
    75	    dispatch_key: str | None = None,
    76	    start: bool = True,
    77	) -> LocalDispatch:
    78	    """Record a job and start a real local worker on it. Non-blocking.
    79	
    80	    Order is load-bearing: we check the seat and the budget, dedupe, THEN write the
    81	    row, THEN start the worker — the store is the source of truth, nothing runs
    82	    without a row. Duplicate protection: a repeated dispatch_key returns the job that
    83	    already exists instead of starting the work twice.
    84	
    85	    The review requirements come from the GAUNTLET CONFIG, never from the caller
    86	    (task #10). A caller that could say "one reviewer is enough" is the single-reviewer
    87	    door this task exists to close.
    88	    """
    89	    from db.jobs import create_job, over_budget, seat
    90	    from tiering import tier_for_build
    91	    import executor
    92	
    93	    cfg = load_config() if cfg is None else cfg
    94	    roster, excluded = panel_roster(conn, cfg)
    95	    families = int(cfg.get("gauntlet", {}).get("min_model_families", 0))
    96	    _refuse_a_panel_that_cannot_hold(conn, roster, families)
    97	
    98	    # Duplicate protection — a retry must not start the same work twice.
    99	    if dispatch_key:
   100	        existing = conn.execute(
   101	            "SELECT id, builder_seat, tier, tier_reason FROM jobs WHERE dispatch_key = ?",
   102	            (dispatch_key,),
   103	        ).fetchone()
   104	        if existing is not None:
   105	            return LocalDispatch(
   106	                job_id=existing["id"], seat_id=existing["builder_seat"],
   107	                reused=True, tier=existing["tier"] or "standard",
   108	                tier_reason=existing["tier_reason"] or "",
   109	            )
   110	
   111	    row = seat(conn, builder_seat)
   112	    if row is None:
   113	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   114	    if not row["enabled"]:
   115	        raise DispatchRefused(f"seat '{builder_seat}' is turned off")
   116	    if over_budget(conn, builder_seat):
   117	        raise DispatchRefused(f"seat '{builder_seat}' is over its budget for today")
   118	
   119	    call = tier_for_build(request)
   120	
   121	    # One transaction: a job must never exist, even for an instant, without its review
   122	    # requirements stamped on. In autocommit that gap is a real row with a zero floor.
   123	    conn.execute("BEGIN")
   124	    try:
   125	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   126	        conn.execute(
   127	            "UPDATE jobs SET required_reviews = ?, required_review_families = ?, "
   128	            "tier = ?, tier_reason = ?, dispatch_key = ?, branch = ? WHERE id = ?",
   129	            (len(roster), families, call.tier, call.reason, dispatch_key,
   130	             f"job/{job_id}", job_id),
   131	        )
   132	        conn.execute("COMMIT")
   133	    except Exception:
   134	        conn.execute("ROLLBACK")
   135	        raise
   136	    set_status(conn, job_id, "in_progress")
   137	
   138	    # No silent caps: a reviewer left out of the panel is written down on the job, not
   139	    # quietly dropped. A shrunken panel must never read as a full one. (A roster name
   140	    # that isn't a seat at all has no row to hang an event on — sync_seats refuses that
   141	    # config outright, which is the earlier and louder place to catch it.)
   142	    for seat_id, why in excluded.items():
   143	        row = seat(conn, seat_id)
   144	        if row is None:
   145	            continue
   146	        conn.execute(
   147	            "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   148	            "VALUES (?,?,?,?,?,?,?)",
   149	            (job_id, seat_id, seat_id, row["model"], row["family"], "skipped",
   150	             f"not on the panel: {why}"),
   151	        )
   152	
   153	    if start:
   154	        executor.start_in_background(job_id, cfg=cfg)
   155	
   156	    return LocalDispatch(
   157	        job_id=job_id, seat_id=builder_seat, reused=False,
   158	        tier=call.tier, tier_reason=call.reason,
   159	    )
