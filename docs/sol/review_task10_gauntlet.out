   348	@app.post("/api/dispatch")
   349	async def dispatch_endpoint(request: Request):
   350	    """Give the team a real job. Non-blocking: returns as soon as it's recorded and
   351	    the worker has started, so the page stays live while the work grinds."""
   352	    import dispatch as dispatch_mod
   353	
   354	    body = await request.json()
   355	    text = (body.get("text") or "").strip()
   356	    if not text:
   357	        return JSONResponse({"error": "Say what to build."}, status_code=400)
   358	    # The client stamps a nonce so a double-tap or a re-send can't start it twice.
   359	    nonce = (body.get("nonce") or "").strip() or None
   360	
   361	    c = db()
   362	    builder = _pick_local_builder(c)
   363	    if not builder:
   364	        return JSONResponse(
   365	            {"error": "The free local coder isn't available on this machine right now."},
   366	            status_code=503,
   367	        )
   368	    try:
   369	        d = dispatch_mod.dispatch_local(
   370	            c, text, builder, origin="text", dispatch_key=nonce,
   371	        )
   372	    except dispatch_mod.DispatchRefused as exc:
   373	        return JSONResponse({"error": str(exc)}, status_code=409)
   374	
   375	    who = builder.title()
   376	    if d.reused:
   377	        reply = f"Already on it — {who} picked that up a moment ago."
   378	    else:
   379	        reply = (f"{who} is on it. A panel of different models will check the work "
   380	                 "before it's called done.")
   381	    return {"job_id": d.job_id, "reused": d.reused, "reply": reply, "builder": builder}
   382	
