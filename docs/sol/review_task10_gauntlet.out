   281	# ---------------------------------------------------------------------------
   282	# Dispatch
   283	# ---------------------------------------------------------------------------
   284	@dataclass
   285	class Dispatch:
   690	    SELECT RAISE(ABORT, 'guard: the panel cannot be shrunk after dispatch');
   691	END;
   692	
   693	-- A verdict, once written, is a fact. It cannot be edited into a pass.
   694	-- (Sol #2 — every verdict guard checked INSERT only, so you could rewrite the row.)
   695	CREATE TRIGGER IF NOT EXISTS guard_verdicts_are_append_only
   696	BEFORE UPDATE ON verdicts
   697	WHEN OLD.verdict <> NEW.verdict
   698	     AND NOT (OLD.verdict = 'needs_human' AND NEW.verdict IN ('pass','fail'))
   699	BEGIN
   700	    SELECT RAISE(ABORT, 'guard: a verdict cannot be rewritten — only an escalation may be answered');
   701	END;
   702	
   703	CREATE TRIGGER IF NOT EXISTS guard_verdict_identity_is_frozen
   704	BEFORE UPDATE ON verdicts
   705	WHEN OLD.role <> NEW.role OR OLD.model_family <> NEW.model_family
   706	  OR OLD.reviewer_seat <> NEW.reviewer_seat OR OLD.reviewer_tier <> NEW.reviewer_tier
   707	BEGIN
   708	    SELECT RAISE(ABORT, 'guard: who reviewed this cannot be rewritten after the fact');
   709	END;
   710	
   711	-- ═══════════════════════════════════════════════════════════════════════════
   712	-- THE REVIEW-TO-VERSION CHAIN (Sol build gate 3, 2026-07-20).
   713	--
   714	-- Sol's most dangerous flaw: "approve version A, builder changes it to B, the old
   715	-- approval still counts — believable green checks on code nobody reviewed."
   716	--
   717	-- The fix is not another approval ceremony; it is arithmetic. A verdict carries the
   718	-- version it reviewed. A job carries the version it is putting forward. Completion
   719	-- guards only count verdicts whose versions MATCH — so moving the code voids the
   720	-- approvals by construction, nothing needs to remember to revoke anything. And a
   721	-- FAIL condemns the version it saw, not the job forever: fix the code, the version
   722	-- changes, the old fail becomes history. (A fail with no recorded version blocks
   723	-- everything — fail-closed, because it condemned we-don't-know-what.)
   724	-- ═══════════════════════════════════════════════════════════════════════════
   725	
   726	-- A versioned job accepts no unversioned verdicts. (Unversioned legacy jobs keep
   727	-- their old semantics; the gatekeeper will not push anything unversioned anyway.)
   728	CREATE TRIGGER IF NOT EXISTS guard_verdict_must_cite_what_it_reviewed
   729	BEFORE INSERT ON verdicts
   730	WHEN (SELECT head_version FROM jobs WHERE id = NEW.job_id) IS NOT NULL
   731	     AND TRIM(COALESCE(NEW.reviewed_version, '')) = ''
   732	BEGIN
   733	    SELECT RAISE(ABORT, 'guard: this job is versioned — a verdict must say which version it reviewed');
   734	END;
   735	
   736	-- A build cannot finish without declaring WHICH code is finished.
   737	CREATE TRIGGER IF NOT EXISTS guard_a_build_finishes_a_version
   738	BEFORE UPDATE OF status ON jobs
   739	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   740	     AND NEW.kind = 'build'
   741	     AND TRIM(COALESCE(NEW.head_version, '')) = ''
   742	BEGIN
   743	    SELECT RAISE(ABORT, 'guard: a build cannot finish without naming the exact version that is finished');
   744	END;
   745	
   746	-- Once finished, WHAT finished is history. Rewriting head_version after done would
   747	-- let approved-hash-A ship as hash-B while every record still looks green.
   748	CREATE TRIGGER IF NOT EXISTS guard_finished_version_is_frozen
   749	BEFORE UPDATE OF head_version ON jobs
   750	WHEN OLD.status IN ('done', 'shipped') AND OLD.head_version IS NOT NEW.head_version
   751	BEGIN
   752	    SELECT RAISE(ABORT, 'guard: what version finished cannot be rewritten after the fact');
   753	END;
   754	
   755	-- A verdict cannot be DELETED. (Sol, round 3 — verified 2026-07-14.)
   756	--
   757	-- "Append-only" was enforced only against UPDATE, so a failing review that couldn't be
   758	-- EDITED into a pass could simply be DELETED — after which guard_a_failing_review_stops_it
   759	-- (which asks "does a fail EXIST?") saw nothing and let the job complete. Confirmed with a
   760	-- live exploit: fail deleted, then done. A verdict is a fact; facts are not retractable.
   940	               -- either side is unversioned)
   941	               OR (v.verdict = 'fail'
   942	                   AND (NEW.head_version IS NULL
   943	                        OR v.reviewed_version IS NULL
   944	                        OR v.reviewed_version = NEW.head_version)))
   945	    );
   946	END;
   947	
   948	-- Sol, round 2, #4: evidence could be an EMPTY STRING. A path of '' satisfied
   949	-- "COALESCE(path, value) IS NOT NULL" perfectly well.
   950	CREATE TRIGGER IF NOT EXISTS guard_evidence_cannot_be_empty
   951	BEFORE INSERT ON artifacts
   952	WHEN TRIM(COALESCE(NEW.path, NEW.value, '')) = ''
   953	BEGIN
   954	    SELECT RAISE(ABORT, 'guard: evidence with nothing in it is not evidence');
   955	END;
   956	
   957	-- ===========================================================================
   958	-- GUARD 6 — nothing ships without a passing cross-family tester.
   959	-- ===========================================================================
   960	CREATE TRIGGER IF NOT EXISTS guard_ship_requires_a_passing_tester
   961	BEFORE UPDATE OF status ON jobs
   962	WHEN NEW.status = 'shipped' AND OLD.status <> 'shipped'
   963	BEGIN
   964	    SELECT RAISE(ABORT, 'guard: nothing ships without a passing cross-family tester on the record')
   965	    WHERE OLD.status <> 'done'
   966	       OR NOT EXISTS (
   967	           SELECT 1 FROM verdicts v
   968	           WHERE v.job_id = NEW.id AND v.role = 'tester' AND v.verdict = 'pass'
   969	             -- gate 3: the tester must have driven THIS version of the app
   970	             AND v.reviewed_version IS NEW.head_version
   971	       );
   972	END;
   973	
   974	-- ===========================================================================
   975	-- GUARD 7 — a researcher must show you where it got that.
   976	-- ===========================================================================
   977	CREATE TRIGGER IF NOT EXISTS guard_research_must_cite_sources
   978	BEFORE UPDATE OF status ON jobs
   979	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   980	     AND NEW.kind = 'research'
   981	BEGIN
   982	    SELECT RAISE(ABORT, 'guard: a research answer must cite sources — no source, no answer')
   983	    WHERE NOT EXISTS (
   984	        SELECT 1 FROM artifacts a
   985	        WHERE a.job_id = NEW.id AND a.kind IN ('source', 'quote')
   986	          AND COALESCE(a.path, a.value) IS NOT NULL
   987	    );
   988	END;
   989	
   990	-- ===========================================================================
   991	-- GUARD 8 — a model family may not fact-check its own research.
   992	-- ===========================================================================
   993	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_verifying
   994	BEFORE INSERT ON verdicts
   995	WHEN NEW.role = 'verifier'
   996	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
   997	BEGIN
   998	    SELECT RAISE(ABORT, 'guard: a model family may not fact-check its own research');
   999	END;
  1000	
  1001	-- ===========================================================================
  1002	-- GUARD 9 — spend caps are enforced by the DATABASE, not by good manners.
  1003	--
  1004	-- ⚠️ Sol #8: "Spend caps do not structurally prevent runaway cost." They were a
  1005	-- Python check before dispatch — a classic race (two dispatches both pass the check
  1006	-- before either records spend), and a direct write skipped them entirely. Now the
  1007	-- ledger itself refuses the entry that would breach the cap.
  1008	-- ===========================================================================
  1009	CREATE TRIGGER IF NOT EXISTS guard_no_negative_spend
  1010	BEFORE INSERT ON usage
  1011	WHEN NEW.cost_cents < 0
  1012	BEGIN
  1013	    SELECT RAISE(ABORT, 'guard: spend cannot be negative — no unwinding the meter');
  1014	END;
  1015	
  1016	CREATE TRIGGER IF NOT EXISTS guard_daily_cap_is_hard
  1017	BEFORE INSERT ON usage
  1018	BEGIN
  1019	    SELECT RAISE(ABORT, 'guard: this seat is over its daily cap')
  1020	    WHERE (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1021	      AND (
  1022	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1023	         WHERE seat_id = NEW.seat_id AND day = date('now')
  1024	      ) + NEW.cost_cents
  1025	      > (SELECT daily_cap_cents FROM seats WHERE id = NEW.seat_id);
  1026	END;
  1027	
  1028	-- Ration the EXPENSIVE work separately. A seat can be generous on reviewing and
  1029	-- stingy on building — which is exactly how you want a metered seat to behave when
  1030	-- you already pay flat-rate for two better builders.
  1031	CREATE TRIGGER IF NOT EXISTS guard_build_cap_is_hard
  1032	BEFORE INSERT ON usage
  1033	WHEN NEW.role = 'build'
  1034	BEGIN
  1035	    SELECT RAISE(ABORT, 'guard: this seat has used up its building budget for today — it can still review')
     1	// Chief Command v2 — seat definitions (spec §4)
     2	//
     3	// Providers sit behind NAMED ROLES so any of them can be swapped without touching
     4	// orchestration logic. Nothing else in the harness may reference a provider by name —
     5	// only by seat id. Vendor policy drift is risk #1 on this project (§9).
     6	//
     7	// Hardware (Phase 0 RAM check, §2): M2 Pro, 16 GB. BELOW the spec's 36 GB threshold,
     8	// so the free grinder is a 7B coder, not the hoped-for 30B.
     9	//
    10	// ===========================================================================
    11	// THE ORGANIZING PRINCIPLE
    12	//
    13	// Every seat answers ONE of two questions: "how fast does it talk?" or "how well
    14	// does it think?" Nothing is good at both, because thinking well MEANS taking time.
    15	// So we don't fight the tension — we seat around it:
    16	//
    17	//   MOUTH   fast, dumb, never blocks. Dispatches and narrates.
    18	//   BRAIN   slow, deep. A dispatch target you are never waiting on.
    19	//   WORKHORSE  the best autonomous coder we can buy. Volume + quality.
    20	//   GRINDERS   cheap parallel attempts. Output NEVER ships unreviewed (DB-enforced).
    21	//   REVIEWER   escalation, highest judgment. Optional and droppable.
    22	// ===========================================================================
    23	
    24	// ---------------------------------------------------------------------------
    25	// MOUTH — the Talker. What Neill actually talks to.
    26	//
    27	// Speech-to-speech: audio in, audio out, ONE model, native tool calling. This is
    28	// what deletes the Whisper + Kokoro + Pipecat-plumbing stack that killed v1.
    29	//
    30	// DECISION DEFERRED ON PURPOSE. Both candidates are GA, sub-second, and speak the
    31	// SAME wire protocol (xAI is OpenAI-Realtime-compatible — you change the base URL).
    32	// So: build against the OpenAI Realtime event schema, keep base_url in config, and
    33	// the other becomes a ONE-LINE swap. Do not marry either one.
    34	//
    35	// Price is a WASH — do not choose on it:
    36	//   grok-voice-think-fast-1.0  $3.00/hr flat  (~$0.05/min)
    37	//   gpt-realtime-2.1-mini      ~$0.04/min real-world once prompt caching kicks in
    38	//                              (and it will — a voice head resends the same system
    39	//                              prompt + tool defs every single turn)
    40	// The "Grok is 6x cheaper" claim compares against the FLAGSHIP gpt-realtime, not mini.
    41	//
    42	// Choose on tool-calling reliability instead. Grok wins on native MCP + session
    43	// resumption; OpenAI wins on configurable reasoning effort + a longer tool-calling
    44	// track record. Settle it with Spike C (bake-off), not with a blog post.
    45	// ---------------------------------------------------------------------------
    46	[seats.mouth]
    47	provider = "xai-realtime"
    48	model = "grok-voice-think-fast-1.0"
    49	base_url = "wss://api.x.ai/v1/realtime"     // swap to OpenAI's and it still works
    50	family = "grok"
    51	tier = "metered"
    52	turn_detection = "semantic_vad"             // NOT push-to-talk. Owner override.
    53	eagerness = "low"                           // a driver pauses mid-sentence to merge
    54	interrupt_response = true                   // barge-in
    55	
    56	// VOICE HAS ITS OWN BUDGET, separate from Grok-the-builder. Owner: "we need to do
    57	// more than $30 cap. that was for when we go over with grok stuff."
    58	// $3/hr, so 300c/day = ~1 hour of talking a day = ~$90/mo worst case.
    59	// Start here and tune once we see real usage — the meter only runs while you talk.
    60	daily_cap_cents = 300
    61	notes = "Fast + dumb BY DESIGN. Never blocks. Separate budget from [seats.grok]."
    62	
    63	// ---------------------------------------------------------------------------
    64	// BRAIN — deep reasoning, planning, decomposition, judging the gauntlet.
    65	// SLOW BY DESIGN and that is fine: it is a dispatch target, never a conversation
    66	// partner. Its ~13s time-to-first-token is invisible because you are never waiting.
    67	//
    68	// Ultra mode is literally an orchestrator: it decomposes the task and spawns
    69	// parallel subagents trained to coordinate MID-task rather than merge at the end.
    70	// That is the reviewer-gauntlet shape (§6), native.
    71	//   Terminal-Bench 2.1: 88.8% single-agent / 91.9% Ultra — SOTA for agentic work.
    72	// ---------------------------------------------------------------------------
    73	// ═══════════════════════════════════════════════════════════════════════════
    74	// MODEL TIERS — nothing gets the top model by default. Owner (2026-07-14):
    75	//     "If we do highest model every time for every build, on autonomous work, Claude
    76	//      and ChatGPT are gonna bottom out."
    77	//
    78	// THE KEY FACT: the binding constraint on autonomous work is RATE LIMITS, not money.
    79	// Claude and OpenAI are both flat-rate — you already paid. But you CANNOT BUY YOUR WAY
    80	// OUT OF A WEEKLY CAP. Every top-tier call spent on boilerplate is one you don't have
    81	// left for the thing that actually needed it.
    82	//
    83	// So the top tier is EARNED: you ask for it, the work is dangerous (auth/money/data),
    84	// it already failed twice, a reviewer flagged p0/p1, or it's a decision that's
    85	// expensive to reverse. Everything else runs light or standard. See tiering.py — the
    86	// escalation is a RULE, not a vibe, and every job records which tier it got AND WHY.
    87	// ═══════════════════════════════════════════════════════════════════════════
    88	
    89	[seats.brain]
    90	provider = "codex"
    91	model = "gpt-5.6-sol"
    92	tier = "subscription"
    93	family = "gpt"
    94	
    95	// Owner: "Sol needs to be the brain, but prolly doesn't need to be ultra for most
    96	// convos. Maybe if it's managing a major spec and deciding builds and such, but
    97	// generally lower effort in convo."
    98	//
    99	// Measured, and he's right: Sol at FULL effort took over FIVE MINUTES on a real
   100	// question. In a conversation that isn't thorough — it's a hang. Claude at ~8s gave a
   101	// genuinely better answer. So Sol's heavy tier is reserved for what it's actually for:
   102	// specs, architecture, and pushback.
   103	model_light    = "gpt-5.6-luna"             // quick takes
   104	model_standard = "gpt-5.6-terra"            // most work
   105	model_heavy    = "gpt-5.6-sol"              // specs, decisions, pushback. EARNED.
   106	effort_light    = "low"
   107	effort_standard = "medium"
   108	effort_heavy    = "high"
   109	
   110	mode = "ultra"                              // ONLY at heavy. Coordinated subagents.
   111	max_threads = 6                             // spec said 8; the real default is 6
   112	max_depth = 1
   113	notes = "OAuth is TOLERATED, not sanctioned. Most likely seat to break. Keep API-key swap ready."
   114	
   115	// ---------------------------------------------------------------------------
   116	// WORKHORSE — volume autonomous coding. Migrations, refactors, test backfills.
   117	//
   118	// OWNER DECISION (2026-07-13): OpenAI, not Claude. Rationale below — and note the
   119	// reason is NOT the one in the spec.
   120	//
   121	// ⚠️ THE SPEC'S REASON IS WRONG. It says Claude headless draws from a metered credit
   122	// pool. It does NOT — Anthropic announced that, then PAUSED it before it took effect.
   123	// `claude -p` runs on normal subscription limits TODAY. Claude-as-workhorse would not
   124	// cost extra dollars.
   125	//
   126	// ✅ THE REAL REASON, which nobody had written down: RATE LIMITS, not cost. Running a
   127	// workhorse hard (unattended overnight builds, migrations, backfills) burns Max plan
   128	// usage caps — and it's the SAME bucket as interactive use. The failure mode is nasty:
   129	// your autonomous builder silently eats the model you were going to review its work
   130	// with. So Claude stays OUT of the high-volume seat, and stays IN as low-volume
   131	// escalation (see [seats.reviewer]).
   132	//
   133	// GPT-5.6-sol is not a consolation prize here: 88.8% Terminal-Bench 2.1 (91.9% Ultra),
   134	// SOTA for agentic coding. Flat subscription, predictable, bounded.
   135	//
   136	// For the record, since it may matter on the Studio later:
   137	//     Claude Opus  87.6% SWE-bench Verified   (best autonomous coder available)
   138	//     GPT-5.6-sol  64.6% SWE-bench Pro / 88.8% Terminal-Bench  (top-tier agentic)
   139	//     Grok Build   70.8% SWE-bench Verified   (weak model, great harness)
   140	// ---------------------------------------------------------------------------
   141	[seats.workhorse]
   142	provider = "codex"
   143	model = "gpt-5.6-sol"
   144	tier = "subscription"
   145	family = "gpt"
   146	worktree_isolated = true
   147	
   148	model_light    = "gpt-5.6-luna"             // scaffolding, boilerplate, first drafts
   149	model_standard = "gpt-5.6-terra"            // the bulk of real building
   150	model_heavy    = "gpt-5.6-sol"              // auth, money, data, or it failed twice
   151	notes = "OpenAI sub. Shares auth with [seats.brain] — see CONCENTRATION RISK below."
   152	
   153	// The Claude builders — Riggs (backend), Finn (frontend), Nova (glue). Same lanes,
   154	// same memory, tiered the same way. Opus is the best coder we own (87.6% SWE-bench);
   155	// it is also the one most likely to burn a weekly cap, so it is EARNED like the rest.
   156	[seats.riggs]
   157	provider = "claude-cli"
   158	model = "claude-opus-4-8"
   159	family = "claude"
   160	tier = "subscription"
   161	model_light    = "claude-haiku-4-5"
   162	model_standard = "claude-sonnet-5"
   163	model_heavy    = "claude-opus-4-8"          // the best coder we have. EARNED.
   164	notes = "Backend lane. Memory belongs to the LANE, not the model — swap the model, keep the scars."
   165	
   166	// ---------------------------------------------------------------------------
   167	// GROK — builder + cross-family reviewer.
   168	//
   169	// ⚠️ TWO EARLIER CLAIMS OF MINE WERE WRONG. Correcting both, on the record:
   170	//
   171	//   1. "Grok Build is weak (70.8% SWE-bench)." FALSE. That was grok-build-0.1, a
   172	//      legacy option nobody runs. Grok Build now DEFAULTS to grok-4.5. On a single
   173	//      consistent agentic-coding index: Grok 4.5 = 76, Codex = 76, Claude Code = 78.
   174	//      It is not the weak sibling. It matches Codex at ~half the cost/task ($2.49).
   175	//
   176	//   2. "The 403 is a Heavy-only tier gate." FALSE. It's an UNDISCLOSED MONTHLY QUOTA
   177	//      on standard SuperGrok. The 403 body lies — it says "you do not have an active
   178	//      Grok subscription" when you do and have merely run out. Users have been locked
   179	//      out after ~3 days of LIGHT cron use. Nobody publishes the quota.
   180	//
   181	// I also invented a workload ("throw 8 parallel attempts, let the gauntlet pick") to
   182	// compensate for a weakness that was my own measurement error. Dropped. Grok is just
   183	// a good, cheap builder. No exotic volume pattern needed.
   184	//
   185	// THE ANSWER TO THE HIDDEN QUOTA: don't choose between sub and API — run BOTH.
   186	// Subscription primary, metered API key as fallback on the same seat. When the
   187	// mystery quota dies at 2am mid-build, the seat fails over to the key and KEEPS
   188	// GOING instead of stalling the run. Subscription economics, metered reliability.
   189	//
   190	// HARD CEILING: $30 sub + $30/mo API cap = $60/mo maximum, no surprises.
   191	// (daily_cap_cents 100 x ~30 days = ~$30/mo of fallback.)
   192	// ---------------------------------------------------------------------------
   193	// GROK BUILDS LESS THAN THE OTHERS — deliberately. Owner (2026-07-13):
   194	//     "it can review as much as it wants more or less, but shouldn't build as much
   195	//      as claude and chat"
   196	//
   197	// He's right, and the economics agree. Claude and OpenAI are FLAT-RATE — a build on
   198	// those seats costs nothing marginal, it's already bought. Grok is METERED, so every
   199	// build is real money leaving the account. And builds are the EXPENSIVE kind of work
   200	// (token-heavy) while reviews are CHEAP (read-heavy, ~1/10 the tokens).
   201	//
   202	//     BUILD on the seats you already pay for.
   203	//     REVIEW on the metered one, because reviewing is cheap.
   204	//
   205	// Which lands Grok exactly where it's most valuable anyway. Its worth was never being
   206	// the strongest coder — it isn't. It's being a DIFFERENT MIND that catches what Claude
   207	// and GPT both miss. And that job costs pennies.
   208	[seats.grok]
   209	provider = "xai"
   210	model = "grok-4.5"                          // NOT grok-build-0.1 (legacy, weak)
   211	tier = "subscription"                       // $30 SuperGrok, primary
   212	family = "grok"
   213	
   214	// OFF UNTIL THE LEAKED xAI KEY IS ROTATED (owner task). Turned off rather than left on
   215	// and failing: an enabled seat with no working key is counted as a panel member that
   216	// can never report, which parks every job forever and looks like a bug. The panel is
   217	// claude + gpt today — two families, which meets the floor. Flip this back the day the
   218	// key is rotated and grok is a third mind again.
   219	//
   220	// Owner decision, 2026-07-21: GROK DOES NOT TOUCH THE ARCH MEDICAL-RECORDS REPO. That
   221	// repo is out of scope entirely (Decision C); this line records the standing rule.
   222	disabled = true
   223	worktree_isolated = true
   224	daily_cap_cents  = 100                      // $1/day = ~$30/mo HARD CEILING
   225	build_cap_cents  = 25                       // ~25c/day of building — a RATION
   226	review_cap_cents = 75                       // reviewing is cheap; let it look at everything
   227	notes = "Reviews freely. Builds sparingly. Sub primary, API fallback."
   228	
   229	  // Failover target. Same model, metered. This is what makes the hidden quota a
   230	  // speed bump instead of a dead stop.
   231	  [seats.grok.fallback]
   232	  provider = "xai-api"
   233	  auth = "XAI_API_KEY"
   234	  tier = "metered"
   235	  notes = "Engages when the sub 403s. Capped by daily_cap_cents above."
   236	
   237	// ---------------------------------------------------------------------------
   238	// FREE GRINDER — the local junior. Overnight scaffolding, boilerplate, first drafts.
   239	// Sized for 16 GB. A junior dev, and treated as one: guard 1 in schema.sql makes it
   240	// STRUCTURALLY IMPOSSIBLE for its output to reach `done` unreviewed.
   241	// ---------------------------------------------------------------------------
   242	[seats.grinder_local]
   243	provider = "ollama"
   244	model = "qwen2.5-coder:7b"
   245	tier = "local"
   246	family = "qwen"
   247	endpoint = "http://127.0.0.1:11434"
   248	notes = "Bump to qwen3-coder:30b on the Studio (§8 phase 5). One line."
   249	
   250	// ---------------------------------------------------------------------------
   251	// REVIEWER — escalation only. Highest judgment: architecture calls, contested
   252	// verdicts, the bug the local model looped on three times.
   253	//
   254	// Claude stays in the hierarchy HERE, deliberately. At escalation volume (a handful
   255	// of calls a day) it will not dent the Max rate limits that disqualify it from the
   256	// workhorse seat — and it is already paid for.
   257	//
   258	// It earns its seat twice over: it is the strongest model on the board (87.6%
