   117	    # ONE transaction for the whole record of this dispatch. A job must never exist,
   118	    # even for an instant, without its review requirements stamped on — in autocommit
   119	    # that gap is a real row with a zero floor. The excluded-reviewer notes go in here
   120	    # too: if writing them fails, the right outcome is no job at all, not a committed
   121	    # job whose panel quietly shrank without saying so.
   122	    #
   123	    # BEGIN IMMEDIATE, not BEGIN: this reads before it writes, and a deferred
   124	    # transaction that upgrades to a write after another connection has committed fails
   125	    # instantly with a snapshot error that the busy-timeout does NOT retry.
   126	    conn.execute("BEGIN IMMEDIATE")
   127	    try:
   128	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   129	        conn.execute(
   130	            "UPDATE jobs SET required_reviews = ?, required_review_families = ?, "
   131	            "tier = ?, tier_reason = ?, dispatch_key = ?, branch = ? WHERE id = ?",
   132	            (len(roster), families, call.tier, call.reason, dispatch_key,
   133	             f"job/{job_id}", job_id),
   134	        )
   135	        # No silent caps: a reviewer left out of the panel is written down on the job.
   136	        # (A roster name that isn't a seat at all has no row to hang an event on —
   137	        # sync_seats refuses that config outright, the earlier and louder place.)
   138	        for seat_id, why in excluded.items():
   139	            row = seat(conn, seat_id)
