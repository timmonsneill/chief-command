   158	# What came back
   159	# ---------------------------------------------------------------------------
   160	@dataclass
   161	class ReviewerRun:
   162	    """One seat's participation — including the ones that did NOT participate.
   163	
   164	    A skipped reviewer is part of the result, never an omission. "No silent caps": a
   165	    panel that quietly shrank reads as a full panel to anyone looking at the verdicts.
   166	    """
   167	    seat_id: str
   168	    family: str = ""
   169	    verdict: str | None = None      # pass | fail | needs_human | None if it never ran
   170	    summary: str = ""
   171	    skipped: str = ""               # why it didn't run, in plain words
   172	
   173	    @property
   174	    def ran(self) -> bool:
   175	        return self.verdict is not None
   176	
   177	
   178	@dataclass
   179	class PanelResult:
   180	    job_id: int
   195	
   196	def unresolved_reviewers(cfg: dict[str, Any]) -> list[str]:
   197	    """Gauntlet reviewers that don't name a real seat. Empty == all resolve.
   198	
   199	    A roster entry pointing at a seat that doesn't exist (the old `grinder_paid`) is a
   200	    silent trap: `over_budget` treats the unknown seat as uncapped, the pre-check says
   201	    "fine," then the verdict write rejects it. Catch it at startup instead.
   202	    """
   203	    seats = cfg.get("seats", {})
   204	    return [r for r in cfg.get("gauntlet", {}).get("reviewers", []) if r not in seats]
   205	
   206	
   207	def panel_roster(conn, cfg: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
   208	    """Who can actually sit on the panel right now — and who can't, and why.
   209	
   210	    A roster entry is only real if the seat exists, is switched on, and we have a way to
   211	    RUN it on this machine. Grok has no runner until the leaked key is rotated; the
   212	    codex seat needs its login. Counting those as panel members would produce a required
   213	    panel that can never report, which fails closed but useless — every job parked
   214	    forever. Counting them silently would be worse: a panel that shrank without saying
   215	    so reads exactly like a full one.
   216	
   217	    So: exclude them, name them, and let the FAMILY FLOOR (which cannot be lowered) be
   218	    the thing that decides whether what's left is enough.
   219	    """
   220	    import gauntlet
   221	
   222	    roster: list[str] = []
   223	    excluded: dict[str, str] = {}
   224	    for seat_id in cfg.get("gauntlet", {}).get("reviewers", []):
   225	        row = seat(conn, seat_id)
   226	        if row is None:
   227	            excluded[seat_id] = "that reviewer isn't set up on this machine"
   228	        elif not row["enabled"]:
   229	            excluded[seat_id] = "that reviewer is turned off"
   230	        elif not gauntlet.has_runner(row["provider"]):
   231	            excluded[seat_id] = "we have no way to run that reviewer yet"
   232	        else:
   233	            roster.append(seat_id)
   234	    return roster, excluded
   235	
   236	
   237	def _refuse_a_panel_that_cannot_hold(conn, roster: list[str], floor: int) -> None:
   238	    """Refuse to dispatch work the panel could never certify.
   239	
   240	    Fail CLOSED, but say so at DISPATCH — when it is one legible refusal — rather than
   241	    at review time, where it becomes a job that parks forever and looks like a bug.
   242	    """
   243	    if floor < 1:
   244	        raise DispatchRefused(
   245	            "the review panel isn't configured (it needs at least one model family) "
   246	            "— refusing to start work that nothing would check"
   247	        )
   248	    families = {seat(conn, s)["family"] for s in roster}
   249	    if len(families) < floor:
   250	        raise DispatchRefused(
   251	            f"only {len(families)} model family/families can review right now and "
   252	            f"{floor} are required — refusing to start work that could never be checked"
   253	        )
   254	
   255	
   256	def sync_seats(conn, cfg: dict[str, Any]) -> None:
   257	    """Push the config's seats into the store, so guards can reason about them.
   258	
   259	    Refuses a config whose gauntlet names a seat that doesn't exist, or a seat missing a
   260	    family — both would blow up later, mid-panel, where it's far harder to see.
   261	    """
   262	    missing = unresolved_reviewers(cfg)
   263	    if missing:
   264	        raise DispatchRefused(f"gauntlet names seats that don't exist: {missing}")
   265	    for seat_id, s in cfg.get("seats", {}).items():
   266	        if "family" not in s:
   267	            raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
   268	    for seat_id, s in cfg.get("seats", {}).items():
   269	        upsert_seat(conn, Seat(
   270	            id=seat_id,
   271	            provider=s["provider"],
   272	            model=s["model"],
   273	            family=s["family"],
   274	            tier=s["tier"],
   275	            daily_cap_cents=s.get("daily_cap_cents"),
   276	            enabled=not s.get("disabled", False),
   277	            notes=s.get("notes", ""),
   278	        ))
   279	
