    47	def connect(db_path: Path | str = DB_PATH) -> sqlite3.Connection:
    48	    # timeout is stated rather than inherited from the stdlib default: the review panel
    49	    # writes verdicts from several threads at once, and how long a writer waits for the
    50	    # lock before giving up is a real property of this system, not a detail to leave to
    51	    # whatever the standard library happens to pick.
    52	    conn = sqlite3.connect(db_path, isolation_level=None,  # autocommit; we manage txns
    53	                           timeout=15.0)
    54	    conn.row_factory = sqlite3.Row
    55	    conn.execute("PRAGMA foreign_keys = ON")
    56	    conn.execute("PRAGMA busy_timeout = 15000")
    57	    return conn
    58	
    59	
    60	def init_db(conn: sqlite3.Connection) -> None:
    61	    """Build the schema on a FRESH database only.
    62	
    63	    This used to run schema.sql on EVERY call — including server startup against the LIVE
    64	    DB. That made editing schema.sql a silent live deploy: a new `CREATE TRIGGER IF NOT
    65	    EXISTS` installs on the next restart while `CREATE TABLE IF NOT EXISTS` stays a no-op,
    66	    so a trigger can land WITHOUT the column it references and jam every status change (it
    67	    did, 2026-07-20). An existing DB now advances ONLY through the numbered migrations in
    68	    db/migrations/, applied deliberately — never as a side effect of a restart.
    69	    """
    70	    initialized = conn.execute(
    71	        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'jobs'"
    72	    ).fetchone()
    73	    if initialized:
    74	        return
    75	    conn.executescript(SCHEMA_PATH.read_text())
    76	
    77	
    78	def _guarded(fn):
    79	    """Translate the schema's RAISE(ABORT, 'guard: ...') into GuardViolation."""
    80	
    81	    def wrapper(*args, **kwargs):
    82	        try:
    83	            return fn(*args, **kwargs)
    84	        except sqlite3.IntegrityError as exc:
    85	            if "guard:" in str(exc):
    86	                raise GuardViolation(str(exc)) from exc
    87	            raise
    88	
    89	    return wrapper
    90	
