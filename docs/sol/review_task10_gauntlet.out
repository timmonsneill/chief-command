    68	# ── The plain-English layer. He must never see a machine word. ───────────────
    69	#
    70	# Sol caught the UI leaking filenames and shell commands straight into the detail view.
    71	# This is the translation layer that stops it. The rule from AGENTS.md:
    72	#
    73	#     "If you cannot explain what you did without jargon, you do not yet understand
    74	#      what you did."
    75	
    76	_EVENT_ENGLISH = {
    77	    "dispatched": "Picked it up",
    78	    "read":       "Read through the existing code",
    79	    "thinking":   "Worked out how to do it",
    80	    "edit":       "Changed the code",
    81	    "write":      "Wrote new code",
    82	    "command":    "Ran something",
    83	    "test_run":   "Ran the tests",
    84	    "browse":     "Clicked through it like a user",
    85	    "verdict":    "Gave a verdict",
    86	    "done":       "Finished",
    87	    "error":      "Hit a problem",
    88	}
    89	
    90	
    91	def _in_plain_english(e: dict) -> dict:
    92	    """Translate one line of machine activity into something a person can read.
    93	
    94	    NOTE the deliberate asymmetry: we keep the OUTCOME of a test run ("6 passed") but
    95	    drop the COMMAND that produced it ("pytest -q"). The outcome is a fact about the
    96	    work. The command is a fact about the tooling, and Neill doesn't use the tooling.
    97	    """
    98	    kind = e.get("kind", "")
    99	    what = _EVENT_ENGLISH.get(kind, "Worked on it")
   100	    out = {"what": what, "kind": kind}
   101	
   102	    detail = (e.get("detail") or "").strip()
   103	    # Keep a detail ONLY if it reads like a RESULT, not a machine artifact — and not if
   104	    # it's just restating the line it's attached to.
   105	    looks_technical = any(c in detail for c in ("/", "\\", ".py", ".ts", ".sql", "()", "--"))
   106	    is_redundant = detail.lower().strip(".") == what.lower().strip(".")
   107	    if detail and not looks_technical and not is_redundant:
   108	        out["note"] = detail
   109	    return out
   110	
