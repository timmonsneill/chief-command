   233	def _reserve_review_budget(conn, seat_id: str, job_id: int, cents: int) -> bool:
   234	    """Take the money BEFORE the call, not after.
   235	
   236	    Sol: "refusing to RECORD a charge doesn't unspend it." Two reviewers reserving at
   237	    once both hit the ledger, and the ledger's own cap trigger refuses the one that
   238	    would breach — so the race resolves in the database, not in a Python check that
   239	    both threads passed a moment earlier. Uncapped seats reserve nothing.
   240	    """
   241	    row = seat(conn, seat_id)
   242	    if row is None or row["daily_cap_cents"] is None:
   243	        return True
   244	    try:
   245	        record_usage(conn, seat_id, cents, job_id=job_id, role="review")
   246	        return True
   247	    except GuardViolation:
   248	        return False
   249	
   250	
   251	def _review_one(
   252	    job_id: int,
   253	    seat_id: str,
   254	    request: str,
   255	    code: str,
   256	    version: str,
   257	    cfg: dict[str, Any],
   258	    out: ReviewerRun,
   259	    db_path: Path,
   260	) -> None:
   261	    """One reviewer, in its own thread, on its own connection. Never raises."""
   262	    conn = connect(db_path)
   263	    try:
   264	        row = seat(conn, seat_id)
   265	        if row is None:
   266	            out.skipped = "that reviewer isn't set up"
   267	            return
   268	        out.family = row["family"]
   269	        if not row["enabled"]:
   270	            out.skipped = "that reviewer is turned off"
   271	            return
   272	        runner = REVIEWERS.get(row["provider"])
   273	        if runner is None:
   274	            out.skipped = "we can't run that reviewer on this machine yet"
   275	            _event(conn, job_id, row, "skipped", out.skipped)
   276	            return
   277	        if over_budget(conn, seat_id):
   278	            out.skipped = "that reviewer is out of budget for today"
   279	            _event(conn, job_id, row, "skipped", out.skipped)
   280	            return
   281	
   282	        estimate = int(
   283	            cfg.get("seats", {}).get(seat_id, {}).get(
   284	                "review_estimate_cents", DEFAULT_ESTIMATE_CENTS)
   285	        )
   286	        if not _reserve_review_budget(conn, seat_id, job_id, estimate):
   287	            out.skipped = "that reviewer is out of budget for today"
   288	            _event(conn, job_id, row, "skipped", out.skipped)
   289	            return
   290	
   291	        _event(conn, job_id, row, "thinking", "Checking the work.")
   292	        try:
   293	            verdict, summary = runner(request, code, row["model"])
   294	        except subprocess.TimeoutExpired:
   295	            out.skipped = "that reviewer took too long and was stopped"
   296	            _event(conn, job_id, row, "error", out.skipped)
   297	            return
   298	        except Exception as exc:                      # noqa: BLE001 — a dead reviewer
   299	            out.skipped = "that reviewer couldn't finish"   # is a skip, never a pass
   300	            _event(conn, job_id, row, "error", f"{out.skipped}: {str(exc)[:120]}")
   301	            return
   302	
   303	        # reviewed_version is passed EXPLICITLY, never defaulted. The default reads the
   304	        # job's current head — which is only correct if nothing moved, and the whole
   305	        # point of the frozen bundle is not to depend on that being true.
   306	        try:
   307	            record_verdict(conn, job_id, seat_id, verdict=verdict,
   308	                           summary=summary, role="reviewer", reviewed_version=version)
   309	        except GuardViolation as exc:
   310	            out.skipped = "the record refused that verdict"
   311	            _event(conn, job_id, row, "error", str(exc)[:160])
   312	            return
   313	
   314	        out.verdict, out.summary = verdict, summary
   315	        _event(conn, job_id, row, "verdict",
   316	               "Passed the check." if verdict == "pass" else "Sent it back with notes.")
   317	    finally:
   318	        conn.close()
   319	
   320	
   321	def run_panel(
   322	    conn,
   323	    job_id: int,
   324	    request: str,
   325	    code: str,
   326	    version: str,
   327	    cfg: dict[str, Any],
   328	    *,
   329	    roster: list[str] | None = None,
   330	    db_path: Path | None = None,
   331	) -> PanelResult:
   332	    """Run the whole panel in parallel against one frozen bundle, then decide.
   333	
   334	    `conn` is the caller's connection, used only for the final decision. Each reviewer
   335	    gets its own. Returns what actually happened — including who didn't run and why.
   336	    """
   337	    gauntlet = cfg.get("gauntlet", {})
   338	    roster = roster if roster is not None else list(gauntlet.get("reviewers", []))
   339	    floor = int(gauntlet.get("min_model_families", 0))
   340	    db_path = db_path or DB_PATH
   341	
   342	    result = PanelResult(job_id=job_id, version=version, required_families=floor)
   343	    result.runs = [ReviewerRun(seat_id=s) for s in roster]
   344	
   345	    threads = [
   346	        threading.Thread(
   347	            target=_review_one,
   348	            args=(job_id, run.seat_id, request, code, version, cfg, run, db_path),
   349	            name=f"review-{job_id}-{run.seat_id}", daemon=True,
   350	        )
   351	        for run in result.runs
   352	    ]
   353	    for t in threads:
   354	        t.start()
   355	    for t in threads:
   356	        t.join(timeout=REVIEW_TIMEOUT_S + 30)
   357	
   358	    # ── The decision. Every branch below ends in "leave it parked" except one. ──
   359	    if result.failed:
   360	        result.parked_reason = "a reviewer failed this version"
   361	        return result
   362	
   363	    families = result.families_passed
   364	    if len(families) < floor:
   365	        ran = len([r for r in result.runs if r.ran])
   366	        result.parked_reason = (
   367	            f"only {len(families)} model famil{'y' if len(families) == 1 else 'ies'} "
   368	            f"reviewed this ({ran} of {len(result.runs)} reviewers ran); "
   369	            f"{floor} are required"
   370	        )
   371	        return result
   372	
   373	    try:
   374	        set_status(conn, job_id, "done",
   375	                   spoken_summary=f"Checked by {len(families)} different models. Ready for you.")
   376	        result.certified = True
   377	    except GuardViolation as exc:
   378	        # Another gate still holds (panel size, an unanswered escalation, an old
   379	        # objection). Park honestly rather than argue with the boundary.
   380	        result.parked_reason = str(exc).replace("guard: ", "")
   381	    return result
   382	
   383	
   384	def run_gauntlet_for_job(conn, job_id: int, cfg: dict[str, Any], *,
   385	                         db_path: Path | None = None) -> PanelResult:
   386	    """Run the panel for a job that is already parked at review.
   387	
   388	    Reads the frozen bundle off the job row ONCE — the request, the output that was put
   389	    forward, and the version it was recorded under — and hands that same snapshot to
   390	    everyone.
   391	    """
   392	    job = conn.execute("SELECT * FROM jobs WHERE id = ?", (job_id,)).fetchone()
   393	    if job is None:
   394	        raise ValueError(f"no such job: {job_id}")
   395	    if not job["head_version"]:
   396	        # Nothing was put forward, so there is nothing to bind a verdict to. A verdict
   397	        # with no version condemns or approves we-don't-know-what.
   398	        return PanelResult(job_id=job_id, version="", required_families=0,
   399	                           parked_reason="no finished version to review")
   400	    return run_panel(conn, job_id, job["request"], job["result"] or "",
   401	                     job["head_version"], cfg, db_path=db_path)
     1	"""The bridge: OpenClaw dispatches the work, the job store decides whether it may run.
     2	
     3	This is the piece that turns three separate things (a pinned OpenClaw, a job store,
     4	a seat config) into a system.
     5	
     6	Design decision worth stating, because it drives everything else:
     7	
     8	    THE JOB STORE IS THE SOURCE OF TRUTH, NOT A LISTENER.
     9	
    10	We record the job BEFORE we spawn it, and we refuse to spawn if the store says no
    11	(over budget, seat disabled). If we merely *observed* OpenClaw's events, work could
    12	run that was never recorded — and OpenClaw's subagent sessions auto-archive after
    13	~60 minutes and get soft-deleted, so anything we didn't write down is simply gone.
    14	Spec §7 wants "what did the overnight run do?" to be answerable. That only works if
    15	nothing can run without a row.
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	import json
    21	import subprocess
    22	import sys
    23	import tomllib
    24	from dataclasses import dataclass
    25	from pathlib import Path
    26	from typing import Any
    27	
    28	sys.path.insert(0, str(Path(__file__).resolve().parent))
    29	
    30	from db.jobs import (  # noqa: E402
    31	    Seat,
    32	    attach_run,
    33	    connect,
    34	    create_job,
    35	    init_db,
    36	    over_budget,
    37	    record_artifact,
    38	    record_verdict,
    39	    seat,
    40	    set_status,
    41	    upsert_seat,
    42	)
    43	
    44	CONFIG = Path(__file__).resolve().parent / "config" / "seats.toml"
    45	
    46	
    47	class DispatchRefused(RuntimeError):
    48	    """The harness declined to dispatch. Budget, disabled seat, or a guard."""
    49	
    50	
    51	# ---------------------------------------------------------------------------
    52	# The REAL, in-process dispatch path (task #9).
    53	#
    54	# dispatch()/_spawn() below hand work to OpenClaw — the production path, for the
    55	# paid coding seats. This one runs the free LOCAL model directly, in a background
    56	# worker, so the whole spine can be exercised end-to-end today with no money and no
    57	# exposed keys. Same recording, same guards, same worktree isolation.
    58	# ---------------------------------------------------------------------------
    59	@dataclass
    60	class LocalDispatch:
    61	    job_id: int
    62	    seat_id: str
    63	    reused: bool          # True = a duplicate key matched an existing job
    64	    tier: str
    65	    tier_reason: str
    66	
    67	
    68	def dispatch_local(
    69	    conn,
    70	    request: str,
    71	    builder_seat: str,
    72	    *,
    73	    cfg: dict[str, Any] | None = None,
    74	    origin: str = "text",
    75	    dispatch_key: str | None = None,
    76	    start: bool = True,
    77	) -> LocalDispatch:
    78	    """Record a job and start a real local worker on it. Non-blocking.
    79	
    80	    Order is load-bearing: we check the seat and the budget, dedupe, THEN write the
    81	    row, THEN start the worker — the store is the source of truth, nothing runs
    82	    without a row. Duplicate protection: a repeated dispatch_key returns the job that
    83	    already exists instead of starting the work twice.
    84	
    85	    The review requirements come from the GAUNTLET CONFIG, never from the caller
    86	    (task #10). A caller that could say "one reviewer is enough" is the single-reviewer
    87	    door this task exists to close.
    88	    """
    89	    from db.jobs import create_job, over_budget, seat
    90	    from tiering import tier_for_build
    91	    import executor
    92	
    93	    cfg = load_config() if cfg is None else cfg
    94	    roster, excluded = panel_roster(conn, cfg)
    95	    families = int(cfg.get("gauntlet", {}).get("min_model_families", 0))
    96	    _refuse_a_panel_that_cannot_hold(conn, roster, families)
    97	
    98	    # Duplicate protection — a retry must not start the same work twice.
    99	    if dispatch_key:
   100	        existing = conn.execute(
   101	            "SELECT id, builder_seat, tier, tier_reason FROM jobs WHERE dispatch_key = ?",
   102	            (dispatch_key,),
   103	        ).fetchone()
   104	        if existing is not None:
   105	            return LocalDispatch(
   106	                job_id=existing["id"], seat_id=existing["builder_seat"],
   107	                reused=True, tier=existing["tier"] or "standard",
   108	                tier_reason=existing["tier_reason"] or "",
   109	            )
   110	
   111	    row = seat(conn, builder_seat)
   112	    if row is None:
   113	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   114	    if not row["enabled"]:
   115	        raise DispatchRefused(f"seat '{builder_seat}' is turned off")
   116	    if over_budget(conn, builder_seat):
   117	        raise DispatchRefused(f"seat '{builder_seat}' is over its budget for today")
   118	
   119	    call = tier_for_build(request)
   120	
   121	    # One transaction: a job must never exist, even for an instant, without its review
   122	    # requirements stamped on. In autocommit that gap is a real row with a zero floor.
   123	    conn.execute("BEGIN")
   124	    try:
   125	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   126	        conn.execute(
   127	            "UPDATE jobs SET required_reviews = ?, required_review_families = ?, "
   128	            "tier = ?, tier_reason = ?, dispatch_key = ?, branch = ? WHERE id = ?",
   129	            (len(roster), families, call.tier, call.reason, dispatch_key,
   130	             f"job/{job_id}", job_id),
   131	        )
   132	        conn.execute("COMMIT")
   133	    except Exception:
   134	        conn.execute("ROLLBACK")
   135	        raise
   136	    set_status(conn, job_id, "in_progress")
   137	
   138	    # No silent caps: a reviewer left out of the panel is written down on the job, not
   139	    # quietly dropped. A shrunken panel must never read as a full one. (A roster name
   140	    # that isn't a seat at all has no row to hang an event on — sync_seats refuses that
   141	    # config outright, which is the earlier and louder place to catch it.)
   142	    for seat_id, why in excluded.items():
   143	        row = seat(conn, seat_id)
   144	        if row is None:
   145	            continue
   146	        conn.execute(
   147	            "INSERT INTO events (job_id, seat_id, lane, model, family, kind, detail) "
   148	            "VALUES (?,?,?,?,?,?,?)",
   149	            (job_id, seat_id, seat_id, row["model"], row["family"], "skipped",
   150	             f"not on the panel: {why}"),
   151	        )
   152	
   153	    if start:
   154	        executor.start_in_background(job_id, cfg=cfg)
   155	
   156	    return LocalDispatch(
   157	        job_id=job_id, seat_id=builder_seat, reused=False,
   158	        tier=call.tier, tier_reason=call.reason,
   159	    )
   160	
   161	
   162	# ---------------------------------------------------------------------------
   163	# Config
   164	# ---------------------------------------------------------------------------
   165	def load_config(path: Path = CONFIG) -> dict[str, Any]:
   166	    # seats.toml uses // comments for readability; TOML has no //, so strip them before
   167	    # parsing. Must be string-aware: value strings hold `https://…` and `base_url` lines
   168	    # end in `"…"  // note` — cutting at the first // blindly would eat the URL. So we
   169	    # only strip a // that sits OUTSIDE a quoted string.
   170	    raw = "\n".join(_strip_slash_comment(line) for line in path.read_text().splitlines())
   171	    return tomllib.loads(raw)
   172	
   173	
   174	def _strip_slash_comment(line: str) -> str:
   175	    """Drop an inline/full-line `//` comment, ignoring `//` inside quotes."""
   176	    quote = ""
   177	    for i in range(len(line) - 1):
   178	        ch = line[i]
   179	        if quote:
   180	            if ch == quote:
   181	                quote = ""
   182	        elif ch in "\"'":
   183	            quote = ch
   184	        elif ch == "/" and line[i + 1] == "/":
   185	            return line[:i].rstrip()
   186	    return line
   187	
   188	
   189	def unresolved_reviewers(cfg: dict[str, Any]) -> list[str]:
   190	    """Gauntlet reviewers that don't name a real seat. Empty == all resolve.
   191	
   192	    A roster entry pointing at a seat that doesn't exist (the old `grinder_paid`) is a
   193	    silent trap: `over_budget` treats the unknown seat as uncapped, the pre-check says
   194	    "fine," then the verdict write rejects it. Catch it at startup instead.
   195	    """
   196	    seats = cfg.get("seats", {})
   197	    return [r for r in cfg.get("gauntlet", {}).get("reviewers", []) if r not in seats]
   198	
   199	
   200	def panel_roster(conn, cfg: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
   201	    """Who can actually sit on the panel right now — and who can't, and why.
   202	
   203	    A roster entry is only real if the seat exists, is switched on, and we have a way to
   204	    RUN it on this machine. Grok has no runner until the leaked key is rotated; the
   205	    codex seat needs its login. Counting those as panel members would produce a required
   206	    panel that can never report, which fails closed but useless — every job parked
   207	    forever. Counting them silently would be worse: a panel that shrank without saying
   208	    so reads exactly like a full one.
   209	
   210	    So: exclude them, name them, and let the FAMILY FLOOR (which cannot be lowered) be
   211	    the thing that decides whether what's left is enough.
   212	    """
   213	    import gauntlet
   214	
   215	    roster: list[str] = []
   216	    excluded: dict[str, str] = {}
   217	    for seat_id in cfg.get("gauntlet", {}).get("reviewers", []):
   218	        row = seat(conn, seat_id)
   219	        if row is None:
   220	            excluded[seat_id] = "that reviewer isn't set up on this machine"
   221	        elif not row["enabled"]:
   222	            excluded[seat_id] = "that reviewer is turned off"
   223	        elif not gauntlet.has_runner(row["provider"]):
   224	            excluded[seat_id] = "we have no way to run that reviewer yet"
   225	        else:
   226	            roster.append(seat_id)
   227	    return roster, excluded
   228	
   229	
   230	def _refuse_a_panel_that_cannot_hold(conn, roster: list[str], floor: int) -> None:
   231	    """Refuse to dispatch work the panel could never certify.
   232	
   233	    Fail CLOSED, but say so at DISPATCH — when it is one legible refusal — rather than
   234	    at review time, where it becomes a job that parks forever and looks like a bug.
   235	    """
   236	    if floor < 1:
   237	        raise DispatchRefused(
   238	            "the review panel isn't configured (it needs at least one model family) "
   239	            "— refusing to start work that nothing would check"
   240	        )
   241	    families = {seat(conn, s)["family"] for s in roster}
   242	    if len(families) < floor:
   243	        raise DispatchRefused(
   244	            f"only {len(families)} model family/families can review right now and "
   245	            f"{floor} are required — refusing to start work that could never be checked"
   246	        )
   247	
   248	
   249	def sync_seats(conn, cfg: dict[str, Any]) -> None:
   250	    """Push the config's seats into the store, so guards can reason about them.
   251	
   252	    Refuses a config whose gauntlet names a seat that doesn't exist, or a seat missing a
   253	    family — both would blow up later, mid-panel, where it's far harder to see.
   254	    """
   255	    missing = unresolved_reviewers(cfg)
   256	    if missing:
   257	        raise DispatchRefused(f"gauntlet names seats that don't exist: {missing}")
   258	    for seat_id, s in cfg.get("seats", {}).items():
   259	        if "family" not in s:
   260	            raise DispatchRefused(f"seat '{seat_id}' has no family — the gauntlet can't count it")
   261	    for seat_id, s in cfg.get("seats", {}).items():
   262	        upsert_seat(conn, Seat(
   263	            id=seat_id,
   264	            provider=s["provider"],
   265	            model=s["model"],
   266	            family=s["family"],
   267	            tier=s["tier"],
   268	            daily_cap_cents=s.get("daily_cap_cents"),
   269	            enabled=not s.get("disabled", False),
   270	            notes=s.get("notes", ""),
   271	        ))
   272	
   273	
   274	# ---------------------------------------------------------------------------
   275	# Dispatch
   276	# ---------------------------------------------------------------------------
   277	@dataclass
   278	class Dispatch:
   279	    job_id: int
   280	    run_id: str | None
   281	    seat_id: str
   282	
   283	
   284	def dispatch(
   285	    conn,
   284	def dispatch(
   285	    conn,
   286	    request: str,
   287	    builder_seat: str,
   288	    cfg: dict[str, Any],
   289	    origin: str = "text",
   290	    blocking: bool = False,
   291	) -> Dispatch:
   292	    """Record the job, then spawn it on OpenClaw. In that order, always.
   293	
   294	    Non-blocking by default — this is what lets the mouth stay responsive. OpenClaw's
   295	    sessions_spawn returns a run id immediately, so the voice head can say "on it" and
   296	    keep talking while the work grinds. A blocking dispatch here would reintroduce
   297	    exactly the latency wound that killed v1.
   298	    """
   299	    row = seat(conn, builder_seat)
   300	    if row is None:
   301	        raise DispatchRefused(f"unknown seat: {builder_seat}")
   302	    if not row["enabled"]:
   303	        raise DispatchRefused(f"seat '{builder_seat}' is disabled")
   304	
   305	    # OpenClaw core has NO per-agent budget of any kind. If we don't check here,
   306	    # nothing does.
   307	    if over_budget(conn, builder_seat):
   308	        raise DispatchRefused(
   309	            f"seat '{builder_seat}' is over its daily cap — refusing to dispatch"
   310	        )
   311	
   312	    gauntlet = cfg.get("gauntlet", {})
   313	    required = len(gauntlet.get("reviewers", []))          # full set, always (seats)
   314	    families = int(gauntlet.get("min_model_families", 0))  # the family floor (task #10)
   315	
   316	    # Fail CLOSED. A missing/empty gauntlet would set both requirements to 0 and silently
   317	    # disable the completion guards — a job would sail to done with no review at all. An
   318	    # unconfigured panel is a refusal to dispatch, never an open door. (Sol re-gate)
   319	    if required < 1 or families < 1:
   320	        raise DispatchRefused(
   321	            "gauntlet is not configured (needs reviewers and min_model_families >= 1) "
   322	            "— refusing to dispatch work nothing would review"
   323	        )
   324	
   325	    # One transaction: the job must never exist for even a moment without its review
   326	    # requirements stamped on (autocommit would otherwise leave a floor-0 gap).
   327	    conn.execute("BEGIN")
   328	    try:
   329	        job_id = create_job(conn, request, builder_seat=builder_seat, origin=origin)
   330	        conn.execute(
   331	            "UPDATE jobs SET required_reviews = ?, required_review_families = ? WHERE id = ?",
   332	            (required, families, job_id),
   333	        )
   334	        conn.execute("COMMIT")
   335	    except Exception:
   336	        conn.execute("ROLLBACK")
   337	        raise
   338	
   339	    run_id = _spawn(row, request, blocking=blocking)
   340	    attach_run(conn, job_id, run_id=run_id or "", branch=f"job/{job_id}")
   341	    set_status(conn, job_id, "in_progress")
   342	
   343	    return Dispatch(job_id=job_id, run_id=run_id, seat_id=builder_seat)
   344	
   345	
   346	def _spawn(seat_row, request: str, blocking: bool) -> str | None:
   347	    """Hand the work to OpenClaw.
   348	
   349	    `openclaw agent` runs one turn via the Gateway. The model is chosen per-spawn,
   350	    which is what lets a single orchestrator turn fan out across several families.
   351	    """
   352	    cmd = [
   353	        "openclaw", "agent",
   354	        "--model", f"{seat_row['provider']}/{seat_row['model']}",
   355	        "--message", request,
   356	    ]
   357	    if not blocking:
   358	        cmd.append("--detach")
   359	
   360	    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
   361	    if proc.returncode != 0:
   362	        raise DispatchRefused(f"openclaw refused the spawn: {proc.stderr.strip()[:300]}")
   363	
   364	    # The gateway echoes a run id; fall back to the raw stdout if the shape changes.
   365	    try:
   366	        return json.loads(proc.stdout).get("runId")
   367	    except (json.JSONDecodeError, AttributeError):
   368	        return proc.stdout.strip()[:80] or None
   369	
   370	
   371	# ---------------------------------------------------------------------------
   372	# The gauntlet (spec §6)
   373	# ---------------------------------------------------------------------------
   374	def run_gauntlet(conn, job_id: int, cfg: dict[str, Any]) -> dict[str, Any]:
   375	    """Fan the finished work out to the reviewer panel, in parallel, same bundle.
   376	
   377	    This used to return a list of reviewer NAMES and launch nobody — the gauntlet was a
   378	    plan, not a thing that ran (task #10). It now runs the panel and returns what
   379	    actually happened: who reviewed, which families, what they said, and — if the job
   380	    stayed parked — why, in plain words.
   381	
   382	    The model-diversity rule (§6) still isn't asserted here; it's RECORDED. Every
   383	    verdict snapshots the reviewing seat's family, and the schema refuses to complete a
   384	    job without enough distinct families passing THIS version. So "two different minds
   385	    looked at this" is a fact you can query, not a promise this function made.
   386	    """
   387	    import gauntlet as gauntlet_mod
   388	
   389	    return gauntlet_mod.run_gauntlet_for_job(conn, job_id, cfg).as_dict()
   390	
   391	
   392	def ship(conn, job_id: int, owner_confirmed: bool = False) -> None:
   393	    """Ship a job. The GATES decide, not a human and not an agent's confidence.
   394	
   395	    Owner override (2026-07-13): Neill is out of the critical path. A job that cleared
   760	-- live exploit: fail deleted, then done. A verdict is a fact; facts are not retractable.
   761	CREATE TRIGGER IF NOT EXISTS guard_verdicts_cannot_be_deleted
   762	BEFORE DELETE ON verdicts
   763	BEGIN
   764	    SELECT RAISE(ABORT, 'guard: a verdict is a fact on the record — it cannot be deleted');
   765	END;
   766	
   767	-- A reviewer cannot LIE about who it is. (Sol #4 — the DB took the row's word for it.)
   768	CREATE TRIGGER IF NOT EXISTS guard_reviewer_identity_must_be_real
   769	BEFORE INSERT ON verdicts
   770	WHEN NEW.reviewer_tier <> (SELECT tier FROM seats WHERE id = NEW.reviewer_seat)
   771	  OR NEW.model_family  <> (SELECT family FROM seats WHERE id = NEW.reviewer_seat)
   772	BEGIN
   773	    SELECT RAISE(ABORT, 'guard: a reviewer cannot misrepresent its own tier or family');
   774	END;
   775	
   776	-- Build evidence can only come from the harness. (Sol #9 — the DB accepted a
   777	-- model-captured screenshot; only the Python helper refused.)
   778	CREATE TRIGGER IF NOT EXISTS guard_models_cannot_forge_evidence
   779	BEFORE INSERT ON artifacts
   780	WHEN NEW.captured_by = 'model' AND NEW.kind NOT IN ('source', 'quote')
   781	BEGIN
   782	    SELECT RAISE(ABORT, 'guard: a model may cite a source but may not produce build evidence');
   783	END;
   784	
   785	-- ===========================================================================
   786	-- GUARD 1 — local output never ships unreviewed (§4.3, §9)
   787	-- Now reads the SNAPSHOT (builder_tier), not the live seat.
   788	-- ===========================================================================
   789	CREATE TRIGGER IF NOT EXISTS guard_local_output_needs_review
   790	BEFORE UPDATE OF status ON jobs
   791	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   792	     AND NEW.builder_tier = 'local'
   793	BEGIN
   794	    SELECT RAISE(ABORT, 'guard: local-built job requires a passing subscription-tier review before done')
   795	    WHERE NOT EXISTS (
   796	        SELECT 1 FROM verdicts v
   797	        WHERE v.job_id = NEW.id
   798	          AND v.reviewer_tier IN ('subscription', 'metered')
   799	          AND v.verdict = 'pass'
   800	          -- gate 3: a pass only counts for the version it actually reviewed
   801	          AND v.reviewed_version IS NEW.head_version
   802	    );
   803	END;
   804	
   805	-- ===========================================================================
   806	-- GUARD 2 — escalations must be answered, not outrun (§6)
   807	-- ===========================================================================
   808	CREATE TRIGGER IF NOT EXISTS guard_unresolved_escalation
   809	BEFORE UPDATE OF status ON jobs
   810	WHEN NEW.status IN ('done','shipped') AND OLD.status NOT IN ('done','shipped')
   811	BEGIN
   812	    SELECT RAISE(ABORT, 'guard: job has an unresolved needs_human verdict')
   813	    WHERE EXISTS (
   814	        SELECT 1 FROM verdicts v WHERE v.job_id = NEW.id AND v.verdict = 'needs_human'
   815	    );
   816	END;
   817	
   818	-- ===========================================================================
   819	-- GUARD 3 — a tester's verdict must cite REAL BUILD EVIDENCE.
   820	--
   821	-- ⚠️ Sol #3: "The 'no screenshot, no verdict' claim is false." My original guard
   822	-- accepted ANY artifact — including a research source, or an empty row. So a tester
   823	-- could "pass" a job on the strength of a URL somebody pasted. Now it must be
   824	-- evidence the HARNESS captured by actually driving the app.
   825	-- ===========================================================================
   826	CREATE TRIGGER IF NOT EXISTS guard_tester_must_cite_artifacts
   827	BEFORE INSERT ON verdicts
   828	WHEN NEW.role = 'tester'
   829	BEGIN
   830	    SELECT RAISE(ABORT, 'guard: a tester verdict requires real captured evidence — no screenshot, no verdict')
   831	    WHERE NOT EXISTS (
   832	        SELECT 1 FROM artifacts a
   833	        WHERE a.job_id = NEW.job_id
   834	          AND a.kind IN ('screenshot', 'trace', 'video', 'dom_snapshot')
   835	          AND a.captured_by IN ('harness', 'playwright')
   836	          AND COALESCE(a.path, a.value) IS NOT NULL
   837	    );
   838	END;
   839	
   840	-- ===========================================================================
   841	-- GUARD 4 — a model family may not test its own work.
   842	-- Reads the snapshot, so re-pointing a seat later changes nothing.
   843	-- ===========================================================================
   844	CREATE TRIGGER IF NOT EXISTS guard_no_self_family_testing
   845	BEFORE INSERT ON verdicts
   846	WHEN NEW.role = 'tester'
   847	     AND NEW.model_family = (SELECT builder_family FROM jobs WHERE id = NEW.job_id)
   848	BEGIN
   849	    SELECT RAISE(ABORT, 'guard: a model family may not test its own build');
   850	END;
   851	
   852	-- ===========================================================================
   853	-- GUARD 5 — the full panel, always. DISTINCT reviewers.
   854	--
   855	-- ⚠️ Sol #7: "The full panel can be faked with duplicate passes." It counted ROWS.
   856	-- One reviewer could pass the same job six times. Now it counts distinct seats.
   857	-- ===========================================================================
   858	CREATE TRIGGER IF NOT EXISTS guard_full_panel
   859	BEFORE UPDATE OF status ON jobs
   860	WHEN NEW.status = 'done' AND OLD.status <> 'done' AND NEW.required_reviews > 0
   861	BEGIN
   862	    SELECT RAISE(ABORT, 'guard: the full review panel has not reported')
   863	    WHERE (
   864	        -- Sol, round 2, #5: this counted testers and fact-checkers as reviewers, so
   865	        -- the panel could be "filled" by the wrong kinds of check entirely.
   866	        SELECT COUNT(DISTINCT v.reviewer_seat) FROM verdicts v
   867	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   868	          -- gate 3: the panel must have reviewed THIS version, not an earlier one
   869	          AND v.reviewed_version IS NEW.head_version
   870	    ) < NEW.required_reviews;
   871	END;
   872	
   873	-- ===========================================================================
   874	-- GUARD 5b — the family floor (task #10). "Full set, always" counts SEATS; it does
   875	-- not guarantee more than one MIND looked. Sol's #10 gate: min_model_families was
   876	-- enforced nowhere in the DB — the gauntlet's core property rested on Python. Now
   877	-- the DB refuses ->done without >= required_review_families DISTINCT passing families
   878	-- on this version. Fails closed: too few families -> parked (never lowers the bar).
   879	-- Snapshotted un-lowerable at dispatch (guard_family_floor_is_fixed).
   880	-- ===========================================================================
   881	CREATE TRIGGER IF NOT EXISTS guard_family_floor_is_fixed
   882	BEFORE UPDATE OF required_review_families ON jobs
   883	WHEN OLD.required_review_families > 0 AND NEW.required_review_families < OLD.required_review_families
   884	BEGIN
   885	    SELECT RAISE(ABORT, 'guard: the family floor cannot be lowered after dispatch');
   886	END;
   887	
   888	CREATE TRIGGER IF NOT EXISTS guard_family_floor
   889	BEFORE UPDATE OF status ON jobs
   890	WHEN NEW.status = 'done' AND OLD.status <> 'done' AND NEW.required_review_families > 0
   891	BEGIN
   892	    SELECT RAISE(ABORT, 'guard: fewer model families reviewed this than required')
   893	    WHERE (
   894	        SELECT COUNT(DISTINCT v.model_family) FROM verdicts v
   895	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
   896	          AND v.reviewed_version IS NEW.head_version
   897	    ) < NEW.required_review_families;
   898	END;
   899	
   900	-- ═══════════════════════════════════════════════════════════════════════════
   901	-- GUARD 10 — A FAILING REVIEW STOPS THE JOB. (Sol, round 2, #5 — and this one is bad.)
   902	--
   903	-- My panel guard counted PASSES and never looked at FAILS. So three passes and one
   904	-- serious failure satisfied it. A reviewer could scream that the thing was broken and
   905	-- be outvoted by colleagues who hadn't noticed.
   906	--
   907	-- That is the opposite of what a gauntlet is FOR. One reviewer finding a real bug is
   908	-- the whole point — it isn't a democracy, it's a set of independent smoke detectors.
   909	-- Any one of them going off stops the job.
   910	-- ═══════════════════════════════════════════════════════════════════════════
   911	CREATE TRIGGER IF NOT EXISTS guard_a_failing_review_stops_it
   912	BEFORE UPDATE OF status ON jobs
   913	WHEN NEW.status IN ('done', 'shipped') AND OLD.status NOT IN ('done', 'shipped')
   914	BEGIN
   915	    SELECT RAISE(ABORT, 'guard: a reviewer failed this — it does not get outvoted')
   916	    WHERE EXISTS (
   917	        SELECT 1 FROM verdicts v
   918	        WHERE v.job_id = NEW.id AND v.verdict = 'fail'
   919	          -- gate 3: a fail condemns the VERSION it reviewed, not the job forever.
   920	          -- A fail with no version condemned we-don't-know-what: it blocks
   921	          -- everything. Same if the job itself is unversioned. Fail-closed.
   922	          AND (NEW.head_version IS NULL
   923	               OR v.reviewed_version IS NULL
   924	               OR v.reviewed_version = NEW.head_version)
   925	    );
   926	END;
   927	
   928	-- Sol, round 2, #6: an objection raised AFTER 'done' could still be outrun, because
   929	-- the escalation guard only fired on the transition INTO done — not on done -> shipped.
   930	CREATE TRIGGER IF NOT EXISTS guard_late_escalation_still_blocks_shipping
  1030	-- you already pay flat-rate for two better builders.
  1031	CREATE TRIGGER IF NOT EXISTS guard_build_cap_is_hard
  1032	BEFORE INSERT ON usage
  1033	WHEN NEW.role = 'build'
  1034	BEGIN
  1035	    SELECT RAISE(ABORT, 'guard: this seat has used up its building budget for today — it can still review')
  1036	    WHERE (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1037	      AND (
  1038	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1039	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role = 'build'
  1040	      ) + NEW.cost_cents
  1041	      > (SELECT build_cap_cents FROM seats WHERE id = NEW.seat_id);
  1042	END;
  1043	
  1044	CREATE TRIGGER IF NOT EXISTS guard_review_cap_is_hard
  1045	BEFORE INSERT ON usage
  1046	WHEN NEW.role IN ('review', 'test')
  1047	BEGIN
  1048	    SELECT RAISE(ABORT, 'guard: this seat is over its reviewing budget for today')
  1049	    WHERE (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id) IS NOT NULL
  1050	      AND (
  1051	        SELECT COALESCE(SUM(cost_cents), 0) FROM usage
  1052	         WHERE seat_id = NEW.seat_id AND day = date('now') AND role IN ('review','test')
  1053	      ) + NEW.cost_cents
  1054	      > (SELECT review_cap_cents FROM seats WHERE id = NEW.seat_id);
  1055	END;
  1056	
  1057	-- Keep updated_at honest.
  1058	CREATE TRIGGER IF NOT EXISTS jobs_touch_updated_at
  1059	AFTER UPDATE ON jobs
  1060	FOR EACH ROW
  1061	BEGIN
  1062	    UPDATE jobs SET updated_at = datetime('now') WHERE id = NEW.id;
  1063	END;
  1064	
  1065	-- ---------------------------------------------------------------------------
  1066	-- The §7 voice query: "what did the overnight run do?"
  1067	-- ---------------------------------------------------------------------------
  1068	CREATE VIEW IF NOT EXISTS job_report AS
  1069	SELECT
  1070	    j.id,
  1071	    j.created_at,
  1072	    j.finished_at,
  1073	    j.request,
  1074	    j.origin,
  1075	    j.builder_seat,
  1076	    s.provider   AS builder_provider,
  1077	    s.tier       AS builder_tier,
  1078	    j.status,
  1079	    j.branch,
  1080	    j.spoken_summary,
  1081	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id)                        AS review_count,
  1082	    (SELECT COUNT(DISTINCT v.model_family) FROM verdicts v WHERE v.job_id = j.id)  AS families_reviewed,
  1083	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id AND v.verdict = 'fail') AS fail_count,
  1084	    (SELECT COUNT(*) FROM verdicts v WHERE v.job_id = j.id AND v.verdict = 'needs_human') AS escalations
  1085	FROM jobs j
  1086	JOIN seats s ON s.id = j.builder_seat;
     1	-- Migration 005 — the family floor becomes a GUARD, not a comment (task #10).
     2	--
     3	-- Sol's #10 design gate found the gauntlet's single most important property —
     4	-- that a DIFFERENT model family reviewed the work — was enforced NOWHERE in the
     5	-- database. `min_model_families = 2` lived in a config file and a comment; the
     6	-- schema counted distinct SEATS (guard_full_panel) and required a higher TIER
     7	-- (guard_local_output_needs_review), but never counted FAMILIES. So the property
     8	-- this whole project exists to guarantee rested on Python being correct.
     9	--
    10	-- Now the DB refuses ->done unless at least `required_review_families` DISTINCT
    11	-- families have a PASSING reviewer verdict on the CURRENT version. The floor is
    12	-- snapshotted per job at dispatch (like required_reviews) and cannot be lowered.
    13	--
    14	-- RECOVERY-SAFE (Sol re-gate, 2026-07-20): an earlier edit to schema.sql, re-run by
    15	-- init_db() on server restart, installed these two triggers WITHOUT the column they
    16	-- reference — jamming every status change on the live DB. So this migration DROPs the
    17	-- triggers first, adds the column, backfills in-flight jobs to the real floor, then
    18	-- recreates the triggers — all in one transaction. Runs once, on a pre-005 DB.
    19	
    20	BEGIN;
    21	
    22	DROP TRIGGER IF EXISTS guard_family_floor;
    23	DROP TRIGGER IF EXISTS guard_family_floor_is_fixed;
    24	
    25	ALTER TABLE jobs ADD COLUMN required_review_families INTEGER NOT NULL DEFAULT 0;
    26	
    27	-- Terminal rows stay 0 (history is history). Jobs still IN FLIGHT get the real floor so
    28	-- they can't slip to done under the old one-family rule (Sol: don't grandfather active
    29	-- work). They park until a real cross-family panel can satisfy the floor — the safe wait.
    30	UPDATE jobs SET required_review_families = 2
    31	 WHERE status NOT IN ('shipped', 'failed', 'cancelled', 'done');
    32	
    33	-- The floor cannot be lowered after dispatch (mirrors guard_panel_size_is_fixed).
    34	CREATE TRIGGER guard_family_floor_is_fixed
    35	BEFORE UPDATE OF required_review_families ON jobs
    36	WHEN OLD.required_review_families > 0 AND NEW.required_review_families < OLD.required_review_families
    37	BEGIN
    38	    SELECT RAISE(ABORT, 'guard: the family floor cannot be lowered after dispatch');
    39	END;
    40	
    41	-- The floor itself: >= N distinct families with a PASSING reviewer verdict on THIS
    42	-- version. Counts families (not seats, not roles other than reviewer), version-matched
    43	-- so moving the code voids old passes. Fails closed: too few families -> parked.
    44	CREATE TRIGGER guard_family_floor
    45	BEFORE UPDATE OF status ON jobs
    46	WHEN NEW.status = 'done' AND OLD.status <> 'done' AND NEW.required_review_families > 0
    47	BEGIN
    48	    SELECT RAISE(ABORT, 'guard: fewer model families reviewed this than required')
    49	    WHERE (
    50	        SELECT COUNT(DISTINCT v.model_family) FROM verdicts v
    51	        WHERE v.job_id = NEW.id AND v.verdict = 'pass' AND v.role = 'reviewer'
    52	          AND v.reviewed_version IS NEW.head_version
    53	    ) < NEW.required_review_families;
    54	END;
    55	
    56	COMMIT;
     1	-- Migration 006 — 'skipped' becomes a thing the record can say (task #10).
     2	--
     3	-- The panel's honesty rule is "no silent caps": a reviewer that was capped out, turned
     4	-- off, or has no runner on this machine must be WRITTEN DOWN, because a panel that
     5	-- quietly shrank reads exactly like a full one to anyone reading the verdicts later.
     6	--
     7	-- The events table had no word for it. Every allowed kind described something a model
     8	-- DID; there was no way to record something that did not happen. So the skip note threw
     9	-- a CHECK violation inside the reviewer thread and vanished — the exact silent shrink
    10	-- the rule exists to prevent. (Caught by test_gauntlet_panel, not in production.)
    11	--
    12	-- SQLite can't alter a CHECK constraint, so this rebuilds the table. Only one index
    13	-- depends on it and no triggers do.
    14	
    15	BEGIN;
    16	
    17	CREATE TABLE events_new (
    18	    id            INTEGER PRIMARY KEY,
    19	    job_id        INTEGER NOT NULL REFERENCES jobs(id) ON DELETE CASCADE,
    20	    seat_id       TEXT NOT NULL REFERENCES seats(id),
    21	    lane          TEXT NOT NULL,
    22	    model         TEXT NOT NULL,
    23	    family        TEXT NOT NULL,
    24	    kind          TEXT NOT NULL CHECK (kind IN (
    25	                      'dispatched', 'thinking', 'read', 'edit', 'write',
    26	                      'command', 'test_run', 'browse', 'verdict', 'done', 'error',
    27	                      'skipped'
    28	                  )),
    29	    target        TEXT,
    30	    detail        TEXT,
    31	    created_at    TEXT NOT NULL DEFAULT (datetime('now'))
    32	);
    33	
    34	INSERT INTO events_new (id, job_id, seat_id, lane, model, family, kind, target,
    35	                        detail, created_at)
    36	     SELECT id, job_id, seat_id, lane, model, family, kind, target, detail, created_at
    37	       FROM events;
    38	
    39	DROP TABLE events;
    40	ALTER TABLE events_new RENAME TO events;
    41	
    42	CREATE INDEX IF NOT EXISTS idx_events_job ON events(job_id, id);
    43	
    44	COMMIT;
