 succeeded in 0ms:
// Chief Command v2 — seat definitions (spec §4)
//
// Providers sit behind NAMED ROLES so any of them can be swapped without touching
// orchestration logic. Nothing else in the harness may reference a provider by name —
// only by seat id. Vendor policy drift is risk #1 on this project (§9).
//
// Hardware (Phase 0 RAM check, §2): M2 Pro, 16 GB. BELOW the spec's 36 GB threshold,
// so the free grinder is a 7B coder, not the hoped-for 30B.
//
// ===========================================================================
// THE ORGANIZING PRINCIPLE
//
// Every seat answers ONE of two questions: "how fast does it talk?" or "how well
// does it think?" Nothing is good at both, because thinking well MEANS taking time.
// So we don't fight the tension — we seat around it:
//
//   MOUTH   fast, dumb, never blocks. Dispatches and narrates.
//   BRAIN   slow, deep. A dispatch target you are never waiting on.
//   WORKHORSE  the best autonomous coder we can buy. Volume + quality.
//   GRINDERS   cheap parallel attempts. Output NEVER ships unreviewed (DB-enforced).
//   REVIEWER   escalation, highest judgment. Optional and droppable.
// ===========================================================================

// ---------------------------------------------------------------------------
// MOUTH — the Talker. What Neill actually talks to.
//
// Speech-to-speech: audio in, audio out, ONE model, native tool calling. This is
// what deletes the Whisper + Kokoro + Pipecat-plumbing stack that killed v1.
//
// DECISION DEFERRED ON PURPOSE. Both candidates are GA, sub-second, and speak the
// SAME wire protocol (xAI is OpenAI-Realtime-compatible — you change the base URL).
// So: build against the OpenAI Realtime event schema, keep base_url in config, and
// the other becomes a ONE-LINE swap. Do not marry either one.
//
// Price is a WASH — do not choose on it:
//   grok-voice-think-fast-1.0  $3.00/hr flat  (~$0.05/min)
//   gpt-realtime-2.1-mini      ~$0.04/min real-world once prompt caching kicks in
//                              (and it will — a voice head resends the same system
//                              prompt + tool defs every single turn)
// The "Grok is 6x cheaper" claim compares against the FLAGSHIP gpt-realtime, not mini.
//
// Choose on tool-calling reliability instead. Grok wins on native MCP + session
// resumption; OpenAI wins on configurable reasoning effort + a longer tool-calling
// track record. Settle it with Spike C (bake-off), not with a blog post.
// ---------------------------------------------------------------------------
[seats.mouth]
provider = "xai-realtime"
model = "grok-voice-think-fast-1.0"
base_url = "wss://api.x.ai/v1/realtime"     // swap to OpenAI's and it still works
family = "grok"
tier = "metered"
turn_detection = "semantic_vad"             // NOT push-to-talk. Owner override.
eagerness = "low"                           // a driver pauses mid-sentence to merge
interrupt_response = true                   // barge-in

// VOICE HAS ITS OWN BUDGET, separate from Grok-the-builder. Owner: "we need to do
// more than $30 cap. that was for when we go over with grok stuff."
// $3/hr, so 300c/day = ~1 hour of talking a day = ~$90/mo worst case.
// Start here and tune once we see real usage — the meter only runs while you talk.
daily_cap_cents = 300
notes = "Fast + dumb BY DESIGN. Never blocks. Separate budget from [seats.grok]."

// ---------------------------------------------------------------------------
// BRAIN — deep reasoning, planning, decomposition, judging the gauntlet.
// SLOW BY DESIGN and that is fine: it is a dispatch target, never a conversation
// partner. Its ~13s time-to-first-token is invisible because you are never waiting.
//
// Ultra mode is literally an orchestrator: it decomposes the task and spawns
// parallel subagents trained to coordinate MID-task rather than merge at the end.
// That is the reviewer-gauntlet shape (§6), native.
//   Terminal-Bench 2.1: 88.8% single-agent / 91.9% Ultra — SOTA for agentic work.
// ---------------------------------------------------------------------------
// ═══════════════════════════════════════════════════════════════════════════
// MODEL TIERS — nothing gets the top model by default. Owner (2026-07-14):
//     "If we do highest model every time for every build, on autonomous work, Claude
//      and ChatGPT are gonna bottom out."
//
// THE KEY FACT: the binding constraint on autonomous work is RATE LIMITS, not money.
// Claude and OpenAI are both flat-rate — you already paid. But you CANNOT BUY YOUR WAY
// OUT OF A WEEKLY CAP. Every top-tier call spent on boilerplate is one you don't have
// left for the thing that actually needed it.
//
// So the top tier is EARNED: you ask for it, the work is dangerous (auth/money/data),
// it already failed twice, a reviewer flagged p0/p1, or it's a decision that's
// expensive to reverse. Everything else runs light or standard. See tiering.py — the
// escalation is a RULE, not a vibe, and every job records which tier it got AND WHY.
// ═══════════════════════════════════════════════════════════════════════════

[seats.brain]
provider = "codex"
model = "gpt-5.6-sol"
tier = "subscription"

// Owner: "Sol needs to be the brain, but prolly doesn't need to be ultra for most
// convos. Maybe if it's managing a major spec and deciding builds and such, but
// generally lower effort in convo."
//
// Measured, and he's right: Sol at FULL effort took over FIVE MINUTES on a real
// question. In a conversation that isn't thorough — it's a hang. Claude at ~8s gave a
// genuinely better answer. So Sol's heavy tier is reserved for what it's actually for:
// specs, architecture, and pushback.
model_light    = "gpt-5.6-luna"             // quick takes
model_standard = "gpt-5.6-terra"            // most work
model_heavy    = "gpt-5.6-sol"              // specs, decisions, pushback. EARNED.
effort_light    = "low"
effort_standard = "medium"
effort_heavy    = "high"

mode = "ultra"                              // ONLY at heavy. Coordinated subagents.
max_threads = 6                             // spec said 8; the real default is 6
max_depth = 1
notes = "OAuth is TOLERATED, not sanctioned. Most likely seat to break. Keep API-key swap ready."

// ---------------------------------------------------------------------------
// WORKHORSE — volume autonomous coding. Migrations, refactors, test backfills.
//
// OWNER DECISION (2026-07-13): OpenAI, not Claude. Rationale below — and note the
// reason is NOT the one in the spec.
//
// ⚠️ THE SPEC'S REASON IS WRONG. It says Claude headless draws from a metered credit
// pool. It does NOT — Anthropic announced that, then PAUSED it before it took effect.
// `claude -p` runs on normal subscription limits TODAY. Claude-as-workhorse would not
// cost extra dollars.
//
// ✅ THE REAL REASON, which nobody had written down: RATE LIMITS, not cost. Running a
// workhorse hard (unattended overnight builds, migrations, backfills) burns Max plan
// usage caps — and it's the SAME bucket as interactive use. The failure mode is nasty:
// your autonomous builder silently eats the model you were going to review its work
// with. So Claude stays OUT of the high-volume seat, and stays IN as low-volume
// escalation (see [seats.reviewer]).
//
// GPT-5.6-sol is not a consolation prize here: 88.8% Terminal-Bench 2.1 (91.9% Ultra),
// SOTA for agentic coding. Flat subscription, predictable, bounded.
//
// For the record, since it may matter on the Studio later:
//     Claude Opus  87.6% SWE-bench Verified   (best autonomous coder available)
//     GPT-5.6-sol  64.6% SWE-bench Pro / 88.8% Terminal-Bench  (top-tier agentic)
//     Grok Build   70.8% SWE-bench Verified   (weak model, great harness)
// ---------------------------------------------------------------------------
[seats.workhorse]
provider = "codex"
model = "gpt-5.6-sol"
tier = "subscription"
worktree_isolated = true

model_light    = "gpt-5.6-luna"             // scaffolding, boilerplate, first drafts
model_standard = "gpt-5.6-terra"            // the bulk of real building
model_heavy    = "gpt-5.6-sol"              // auth, money, data, or it failed twice
notes = "OpenAI sub. Shares auth with [seats.brain] — see CONCENTRATION RISK below."

// The Claude builders — Riggs (backend), Finn (frontend), Nova (glue). Same lanes,
// same memory, tiered the same way. Opus is the best coder we own (87.6% SWE-bench);
// it is also the one most likely to burn a weekly cap, so it is EARNED like the rest.
[seats.riggs]
provider = "claude-cli"
model = "claude-opus-4-8"
family = "claude"
tier = "subscription"
model_light    = "claude-haiku-4-5"
model_standard = "claude-sonnet-5"
model_heavy    = "claude-opus-4-8"          // the best coder we have. EARNED.
notes = "Backend lane. Memory belongs to the LANE, not the model — swap the model, keep the scars."

// ---------------------------------------------------------------------------
// GROK — builder + cross-family reviewer.
//
// ⚠️ TWO EARLIER CLAIMS OF MINE WERE WRONG. Correcting both, on the record:
//
//   1. "Grok Build is weak (70.8% SWE-bench)." FALSE. That was grok-build-0.1, a
//      legacy option nobody runs. Grok Build now DEFAULTS to grok-4.5. On a single
//      consistent agentic-coding index: Grok 4.5 = 76, Codex = 76, Claude Code = 78.
//      It is not the weak sibling. It matches Codex at ~half the cost/task ($2.49).
//
//   2. "The 403 is a Heavy-only tier gate." FALSE. It's an UNDISCLOSED MONTHLY QUOTA
//      on standard SuperGrok. The 403 body lies — it says "you do not have an active
//      Grok subscription" when you do and have merely run out. Users have been locked
//      out after ~3 days of LIGHT cron use. Nobody publishes the quota.
//
// I also invented a workload ("throw 8 parallel attempts, let the gauntlet pick") to
// compensate for a weakness that was my own measurement error. Dropped. Grok is just
// a good, cheap builder. No exotic volume pattern needed.
//
// THE ANSWER TO THE HIDDEN QUOTA: don't choose between sub and API — run BOTH.
// Subscription primary, metered API key as fallback on the same seat. When the
// mystery quota dies at 2am mid-build, the seat fails over to the key and KEEPS
// GOING instead of stalling the run. Subscription economics, metered reliability.
//
// HARD CEILING: $30 sub + $30/mo API cap = $60/mo maximum, no surprises.
// (daily_cap_cents 100 x ~30 days = ~$30/mo of fallback.)
// ---------------------------------------------------------------------------
// GROK BUILDS LESS THAN THE OTHERS — deliberately. Owner (2026-07-13):
//     "it can review as much as it wants more or less, but shouldn't build as much
//      as claude and chat"
//
// He's right, and the economics agree. Claude and OpenAI are FLAT-RATE — a build on
// those seats costs nothing marginal, it's already bought. Grok is METERED, so every
// build is real money leaving the account. And builds are the EXPENSIVE kind of work
// (token-heavy) while reviews are CHEAP (read-heavy, ~1/10 the tokens).
//
//     BUILD on the seats you already pay for.
//     REVIEW on the metered one, because reviewing is cheap.
//
// Which lands Grok exactly where it's most valuable anyway. Its worth was never being
// the strongest coder — it isn't. It's being a DIFFERENT MIND that catches what Claude
// and GPT both miss. And that job costs pennies.
[seats.grok]
provider = "xai"
model = "grok-4.5"                          // NOT grok-build-0.1 (legacy, weak)
tier = "subscription"                       // $30 SuperGrok, primary
family = "grok"
worktree_isolated = true
daily_cap_cents  = 100                      // $1/day = ~$30/mo HARD CEILING
build_cap_cents  = 25                       // ~25c/day of building — a RATION
review_cap_cents = 75                       // reviewing is cheap; let it look at everything
notes = "Reviews freely. Builds sparingly. Sub primary, API fallback."

  // Failover target. Same model, metered. This is what makes the hidden quota a
  // speed bump instead of a dead stop.
  [seats.grok.fallback]
  provider = "xai-api"
  auth = "XAI_API_KEY"
  tier = "metered"
  notes = "Engages when the sub 403s. Capped by daily_cap_cents above."

// ---------------------------------------------------------------------------
// FREE GRINDER — the local junior. Overnight scaffolding, boilerplate, first drafts.
// Sized for 16 GB. A junior dev, and treated as one: guard 1 in schema.sql makes it
// STRUCTURALLY IMPOSSIBLE for its output to reach `done` unreviewed.
// ---------------------------------------------------------------------------
[seats.grinder_local]
provider = "ollama"
model = "qwen2.5-coder:7b"
tier = "local"
endpoint = "http://127.0.0.1:11434"
notes = "Bump to qwen3-coder:30b on the Studio (§8 phase 5). One line."

// ---------------------------------------------------------------------------
// REVIEWER — escalation only. Highest judgment: architecture calls, contested
// verdicts, the bug the local model looped on three times.
//
// Claude stays in the hierarchy HERE, deliberately. At escalation volume (a handful
// of calls a day) it will not dent the Max rate limits that disqualify it from the
// workhorse seat — and it is already paid for.
//
// It earns its seat twice over: it is the strongest model on the board (87.6%
// SWE-bench Verified), AND it is a FOURTH model family in the gauntlet. §6 exists
// because different models miss different bugs. Claude catching what GPT and Grok
// both missed is the entire point of keeping it.
//
// Per spec §4.4 this seat is optional and droppable — the system must run without it.
// Never at the mouth: claude-cli spawns a subprocess per call (3-5s).
// ---------------------------------------------------------------------------
[seats.reviewer]
provider = "claude-cli"                     // sanctioned path; subscription OAuth is NOT
model = "claude-opus-4-8"
tier = "subscription"                       // NOT credits — the pool was paused, never shipped
optional = true
max_calls_per_day = 25                      // keeps escalation from eating interactive headroom

// Owner: "Reviewers prolly need to be opus and one model down for ChatGPT, unless we
// say to go high review or we have a good trigger to do higher reviews."
//
// THE RULE: A REVIEWER IS NEVER WEAKER THAN THE BUILDER. A junior checking a senior's
// work is theatre — it produces a green tick and no safety. So review tier FLOORS at
// whatever tier built the thing. And reviews are cheap anyway (read-heavy, ~1/10th the
// tokens of a build), so generosity here costs far less than generosity on the build.
model_standard = "claude-sonnet-5"          // ordinary reviews
model_heavy    = "claude-opus-4-8"          // dangerous areas, heavy builds, or you asked
notes = "Low-volume escalation. Strongest model + 4th model family. Droppable by design."

// ===========================================================================
// ⚠️ CONCENTRATION RISK — read before changing anything above
//
// [seats.brain] and [seats.workhorse] BOTH run on the Codex OAuth path. That path is
// TOLERATED, NOT SANCTIONED: no OpenAI doc blesses third-party OAuth, and their ToS
// forbids sharing account credentials. Anthropic closed this exact door in Feb/Apr
// 2026; Google closed it in Feb–June 2026 WITH ACCOUNT BANS. OpenAI is the last
// vendor standing, and that is a TIMING position, not a policy position.
//
// If it closes, we lose the brain AND the builder in the same morning.
//
// Mitigation (cheap, and worth having ready rather than improvised under pressure):
// both seats must swap to a paid API key by changing `provider`/`tier` here and
// NOTHING else. That is what the seat abstraction is for. Test the swap before we
// need it.
// ===========================================================================

// ===========================================================================
// VOICE — how much it tells you, and when.
//
// THE RULE: one event stream, two renderings. The voice and the text are not two
// systems — they read the SAME job records at different verbosity. Anything the
// voice says, you could have read. Anything you can read, the voice can summarize.
//
//   VOICE  → a sentence.  "Riggs is on it."
//   TEXT   → the terminal. Every tool call, every file, every result.
//
// Voice escalates on request. That's the interaction model: fast by default, deep
// on demand — the same principle that put a quick model at the mouth and a slow one
// at the brain.
//
// SHORT IS NOT A STYLE PREFERENCE — IT'S THE BILL. Audio output is 55-70% of the
// realtime cost and runs ~16x the price of the same content as text. A chatty voice
// is an expensive voice. §5.3 already asked for short spoken summaries with full
// detail in the log; it was written for latency and it pays off twice.
// ===========================================================================
[voice]
default_depth = "brief"                     // brief | normal | detailed

// What each depth actually says:
//   brief    "Riggs is on it."
//   normal   "Riggs, on Claude — editing routes.py."
//   detailed "Riggs on Claude: read auth.py, then edited routes.py, then ran tests.
//             Panel: 5 of 6 passed, 3 different models."
//
// ALWAYS name the model at 'normal' and above. "Riggs" alone doesn't tell you
// whether your auth module was built by your best coder or your cheapest one.
speak_the_model = true

// Phrases that pull the voice deeper into the same stream the text channel shows.
escalate_on = [
  "what's it doing", "tell me more", "details", "go deeper",
  "what happened", "walk me through it", "why",
]

// Volunteer bad news; stay quiet about good news unless asked. Nobody wants a
// running commentary on a build that's going fine.
interrupt_me_on = ["failed", "needs_human", "over_budget", "guard_blocked"]
stay_quiet_on   = ["thinking", "read", "edit"]

// Spoken replies get truncated to this. The full text is always in the log.
max_spoken_seconds = 12

// ---------------------------------------------------------------------------
// GAUNTLET (§6) — reviewers run in PARALLEL against one frozen bundle.
// The model-family rule is recorded per-verdict in the DB, so it is AUDITABLE
// rather than merely asserted. Different models miss different bugs.
//
// Four families available: gpt (brain/workhorse), claude (reviewer),
// grok (grinder_paid), qwen (grinder_local).
// ---------------------------------------------------------------------------
[gauntlet]
reviewers = ["brain", "grinder_paid", "grinder_local"]
min_model_families = 2                      // §6 floor; we can reach 4
escalate_to = "reviewer"                    // contested verdicts → Claude...
escalate_to_human_on = ["needs_human"]      // ...or Neill's queue
docs/ARCHITECTURE_v2_2026-07-14.md:36:   threat, because the agent is *authorized* to read the repo, so no sandbox stops it
